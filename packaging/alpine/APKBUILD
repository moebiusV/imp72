# Maintainer: David Walther <tederific@gmail.com>
pkgname=imp72
pkgver=0.1.0
pkgrel=0
pkgdesc="IMP72 systems programming language compiler (Bilofsky's PDP-10 compiler, ported)"
url="https://github.com/moebiusV/imp72"
# 64 bit little endian machines that pcc has a back end for: the language's
# word is 64 bits and strings are packed little endian.  pcc's code generator
# is used on x86_64; on aarch64 the program is turned into C for gcc.
arch="x86_64 aarch64"
license="ISC AND BSD-2-Clause AND BSD-3-Clause"
# a C compiler and linker are used to assemble and link the programs it makes
depends="gcc musl-dev"
makedepends=""
subpackages="$pkgname-doc"
# The compiler uses pcc's pass 2 compiler (cc1), built from this pcc revision
# (the submodule third_party/pcc of the release, which GitHub's tarball leaves
# empty).
_pccrev=9db636ff7e67a8f8e9003aea6282d12c6e618539
source="$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz
	pcc-$_pccrev.tar.gz::https://github.com/moebiusV/pcc/archive/$_pccrev.tar.gz
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	# put pcc where the build expects it
	rm -rf "$builddir"/third_party/pcc
	mv "$srcdir"/pcc-$_pccrev "$builddir"/third_party/pcc
}

build() {
	make CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

check() {
	make CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" check
}

package() {
	make CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" install DESTDIR="$pkgdir" PREFIX=/usr
	install -d "$pkgdir"/usr/share/doc/$pkgname
	install -m 644 README.md docs/FFI.md docs/BUILDING.md \
		"$pkgdir"/usr/share/doc/$pkgname/
	cp -r docs/internals docs/porting "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 third_party/pcc/LICENSE.md \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE.pcc.md
	install -Dm644 decus/PROVENANCE.md \
		"$pkgdir"/usr/share/licenses/$pkgname/PROVENANCE.decus.md
}

# The sha512 of the release tarball is for abuild to fill in once the tag v$pkgver
# exists (run `abuild checksum`); that of pcc is the archive of the revision above.
sha512sums="
0  imp72-0.1.0.tar.gz
6e0796e960fe76900003981a419a876fc733ec19b4302d702b12e9d90ac20932925beec5a5fc20731ea86f8d70b00c841c6e0fa0901353ed35b18035bc54aed9  pcc-9db636ff7e67a8f8e9003aea6282d12c6e618539.tar.gz
"
