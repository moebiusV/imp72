^^<PG>	::= <STL,A> '%'\\
^^<SPI>	::= <SPI,A> + <SPI,B>\\
^^<SPT>	::= <SPT,A> '<' <NAM,B> >\\
^^<SPT>	::= '<'<NAM,A>>':' ':'='<'<NAM,B>>\\
