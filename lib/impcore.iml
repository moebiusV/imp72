#IMPCORE: THE ARENA OF THE IMP COMPILER'S FREE STORAGE (SRC/FREE.IMC, CORE) FROM THE SYSTEM, ON A SYSTEM WITH MMAP; THE ARENA'S ADDRESS SPACE IS RESERVED ONCE, WITHOUT ACCESS, AND CORE MAKES MORE OF IT USABLE.  IT WAS IN LIB/IMPSYS.IML, WHICH HAS WHAT THE PROGRAMS OF THE LIBRARY ASK OF EVERY SYSTEM; A SYSTEM WITHOUT MMAP HAS ITS OWN (LIB/IMPCORE-WIN.IML), AND TOOLS/MKLIB.SH AND TOOLS/MKRT.SH NAME THE RIGHT ONE.
THE ARENA IS ASKED FOR AT THE SAME ADDRESS EVERY TIME (SCHINT), EXACTLY WHERE THE SYSTEM HAS A FLAG FOR THAT (SCEXACT), SO THAT AN IMAGE (U AND V) FINDS THE ARENA WHERE IT WAS SAVED; WHEN THE SYSTEM GIVES ANOTHER ADDRESS (A RANDOMISING KERNEL, A FULL ADDRESS SPACE) THE IMAGE IS MOVED (SRC/IMAGE.IMC).  IMPCOREBASE=ADDR IN THE ENVIRONMENT (DECIMAL OR 0X HEX) REPLACES THE HINT, FOR THE TESTS OF THAT.#

DBUF IS 4 LONG;

# A MESSAGE FOR THE ARENA'S TROUBLES, WHEN IMPCOREDEBUG IS IN THE ENVIRONMENT: A STRING, AND A NUMBER IN DECIMAL #
SUBR DBGON(Z) IS (CCALL getenv(LOC('IMPCOREDEBUG')) NE 0 => 1 ELSE 0);

SUBR DBGS(S) IS (CCALL write(2,S,CCALL strlen(S)); 0);

SUBR DBGN(N) IS (
 V,I,D,DP ARE LOCAL;
 DP:=LOC(DBUF);                                                  # (IN A VARIABLE: THE SEED TAKES LOC(X)+N FOR N WORDS) #
 V:=N; I:=31;
 V<0 => (DBGS(LOC('-')); V:=0-V);
 D:=48+(V-((V/10)*10)); CCALL memcpy(DP+I,LOC(D)+(SCBE(0)*7),1); V:=V/10;
 DN1: V NE 0 => (I:=I-1; D:=48+(V-((V/10)*10)); CCALL memcpy(DP+I,LOC(D)+(SCBE(0)*7),1); V:=V/10; GO TO DN1);
 CCALL write(2,DP+I,32-I); 0);

# THE ARENA: ITS BASE (RESERVED ON THE FIRST CALL), OR 0 #
SUBR IMPCOREBASE(Z) IS (
 R,P,EX,F,H ARE LOCAL;
 CBASE NE 0 => RETURN CBASE;
 R:=SCRESV(0);
 CB1: R GE 16777216 => (
    EX:=(SCEXACT(0) NE 0 => 1 ELSE 0);
    H:=SCHINT(0);
    CCALL getenv(LOC('IMPCOREBASE')) NE 0 => H:=CCALL strtoul(CCALL getenv(LOC('IMPCOREBASE')),0,0) AND SCMASK(0);
    CB2: EX GE 0 => (
        F:=2 OR SCANON(0) OR SCNORES(0);                                                  # MAP_PRIVATE | MAP_ANON | MAP_NORESERVE #
        EX NE 0 => F:=F OR SCEXACT(0);
        P:=CCALL mmap(H,R,SCPROT0(0),F,0-1,0,0,0);       # (THE OFFSET IS 0: A 64 BIT OFF_T IS TWO WORDS OF ARGUMENTS ON A 32 BIT SYSTEM, ALIGNED ON ARM, AND THE EXTRA ONES ARE IGNORED ELSEWHERE) #
        P NE (0-1) => (CBASE:=P AND SCMASK(0); CRESV:=R;
                       DBGON(0) NE 0 => (DBGS(LOC('core: asked for ')); DBGN(R); DBGS(LOC(' bytes at ')); DBGN(H);
                                         EX NE 0 => DBGS(LOC(' (exactly)'));
                                         DBGS(LOC(', got them at ')); DBGN(CBASE); DBGS(LOC('
')));
                       RETURN CBASE);
        EX:=EX-1; GO TO CB2);
    R:=R RS 1; GO TO CB1);
 0);

# MAKE THE FIRST NBYTES OF THE ARENA USABLE (ZERO TO BEGIN WITH); 1 FOR SUCCESS #
SUBR IMPCORESET(NBYTES) IS (
 WANT ARE LOCAL;
 WANT:=(NBYTES+65535) AND (0-65536);
 CBASE=0 => RETURN 0;
 WANT>CRESV => RETURN 0;
 WANT>CUSED => (CCALL mprotect(CBASE+CUSED,WANT-CUSED,3)=0 => CUSED:=WANT ELSE RETURN 0);
 1);

# THE ARENA, FOR THE IMAGE (SRC/IMAGE.IMC): HOW MUCH OF IT IS USABLE; AND, TO LOAD AN IMAGE, THE ARENA AT ITS OLD PLACE WITH AT LEAST NBYTES USABLE #
SUBR IMPCOREUSED(Z) IS CUSED;

# THE ARENA'S BASE, WITH AT LEAST NBYTES USABLE (0 IF THERE IS NO ARENA OR NOT SO MUCH OF IT).  BASE IS WHERE THE IMAGE HAD IT: THE CALLER MOVES WHAT POINTS INTO IT IF THIS IS ANOTHER ADDRESS #
SUBR IMPCOREAT(BASE,NBYTES) IS (
 IMPCOREBASE(0)=0 => RETURN 0;
 CBASE NE BASE => (DBGON(0) NE 0 => (DBGS(LOC('core: the image has the arena at ')); DBGN(BASE); DBGS(LOC(', it is at ')); DBGN(CBASE); DBGS(LOC('
'))));
 IMPCORESET(NBYTES)=0 => (DBGON(0) NE 0 => (DBGN(NBYTES); DBGS(LOC(' bytes of the arena could not be made usable (reserved ')); DBGN(CRESV); DBGS(LOC(')
')));
                          RETURN 0);
 CBASE)
%%
