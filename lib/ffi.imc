# IMP72 EXTENSION: CALL A C FUNCTION WITH ARGUMENTS BY VALUE.
  CCALL F(A,B) PASSES THE VALUES OF A AND B, NOT THEIR ADDRESSES, AND
  RETURNS THE RESULT OF THE C FUNCTION.  LOC(X) GIVES AN ADDRESS TO PASS. #

 <ION>  ::= CCALL <NAM,A> ( )  ::= CCALL0(CVAL(A));
 <ION>  ::= CCALL <NAM,A> ( <ELIST,B> ) ::= CSUBCALL(CVAL(A),B);

# EXTERNAL TYPE NAME(TYPES); DECLARES THE TYPES OF A C FUNCTION, FOR CCALL: THE TYPES OF C (CHAR UCHAR SHORT USHORT INT UINT LONG ULONG LLONG ULLONG SIZE PTR DOUBLE FLOAT, AND VOID FOR A RESULT),
  AND THREE DOTS AFTER THE LAST TYPE FOR A FUNCTION OF A VARIABLE NUMBER OF ARGUMENTS.  EXTERNAL INT puts(PTR);  EXTERNAL DOUBLE sqrt(DOUBLE);  EXTERNAL INT printf(PTR, ...); #
 <ST>   ::= EXTERNAL <NAM,T> <NAM,F> ( )                      ::= CDECL(T,F,0,0);
 <ST>   ::= EXTERNAL <NAM,T> <NAM,F> ( <NLIST,L> )            ::= CDECL(T,F,L,0);
 <ST>   ::= EXTERNAL <NAM,T> <NAM,F> ( <NLIST,L> , . . . )    ::= CDECL(T,F,L,1);
 <ST>   ::= EXTERNAL <NAM,T> <NAM,F> ( . . . )                ::= CDECL(T,F,0,1);

# CALLBACK TYPE NAME(TYPES); GIVES THE SUBR NAME THE C SIGNATURE TYPE (TYPES) FOR C TO CALL, AND CALLBACK(NAME) IS THE ADDRESS OF A C FUNCTION THAT CALLS THE SUBR: THE ARGUMENTS ARE CONVERTED TO WORDS, PASSED BY REFERENCE, AND THE RESULT CONVERTED BACK.
  CALLBACK INT CMP(PTR, PTR);  SUBR CMP(A,B) IS ...;  CCALL QSORT(LOC(V),N,8,CALLBACK(CMP)) #
 <ST>   ::= CALLBACK <NAM,T> <NAM,F> ( )                      ::= CDECL(T,F,0,2);
 <ST>   ::= CALLBACK <NAM,T> <NAM,F> ( <NLIST,L> )            ::= CDECL(T,F,L,2);
 <ATOM> ::= CALLBACK ( <NAM,A> )                              ::= CBADDR(A);

# FNPTR TYPE NAME(TYPES); DECLARES THE CALL OF A C FUNCTION THROUGH A POINTER: CCALL NAME(F, A, B) CALLS THE C FUNCTION AT THE ADDRESS F WITH THE ARGUMENTS A, B CONVERTED TO TYPES, AS FOR EXTERNAL.  FNPTR INT CMPF(PTR, PTR);  R:=CCALL CMPF(F, LOC(X), LOC(Y)) #
 <ST>   ::= FNPTR <NAM,T> <NAM,F> ( )                         ::= CDECL(T,F,0,4);
 <ST>   ::= FNPTR <NAM,T> <NAM,F> ( <NLIST,L> )               ::= CDECL(T,F,L,4);
 <ST>   ::= FNPTR <NAM,T> <NAM,F> ( <NLIST,L> , . . . )       ::= CDECL(T,F,L,5);
 <ST>   ::= FNPTR <NAM,T> <NAM,F> ( . . . )                   ::= CDECL(T,F,0,5);

# X IS EXTERNAL; DECLARES A VARIABLE THAT IS DEFINED ELSEWHERE, IN THE C LIBRARY SAY (!STDOUT!): NOTHING IS DEFINED HERE, AND LOC(X) IS ITS ADDRESS #
 <PROP> ::= EXTERNAL ::= DECL(12,0)%%
