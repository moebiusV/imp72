#IMPHOST: WHAT THE LINK NEEDS TO KNOW OF THE MACHINE IT RUNS ON: THE SYSTEM (IMPHOSTOS) AND THE ARCHITECTURE (IMPHOSTARCH), IN SYSGEN; WHERE THIS VERY PROGRAM FOUND ITS DYNAMIC LINKER (IMPHOSTINTERP) AND ITS C LIBRARY
(IMPHOSTLIBC), THE DIRECTORY OF THE C LIBRARY'S CRT FILES THAT GOES WITH IT (IMPHOSTCRTDIR), THE NEWEST VERSION OF A LIBRARY THAT IS ONLY THERE WITH ITS VERSION (IMPFINDLIB), AND LLD RUN AS A PROGRAM (IMPRUNLD).  THE
COMPILER RUNS ON THE SYSTEM IT MAKES PROGRAMS FOR, SO WHAT ITS OWN LOADER DID IS WHAT THE PROGRAMS IT MAKES NEED.  SRC/DRIVER.IMP CALLS THEM; THE TRANSLATION OF LIB/IMPHOST.C, WHICH THE SEED KEEPS (STAGE0/IMPHOST.C)
FOR ITS OWN DRIVER.  THE PARAMETERS ARE BY REFERENCE: THE CALLERS DO NOT USE CCALL.  A PATH IS IN A BUFFER OF 4096 BYTES.#

DLI IS 4 LONG;
BESTB IS 40 LONG;
PATHA IS 520 LONG;
PATHB IS 520 LONG;
PATHC IS 520 LONG;
ENDP IS 1 LONG;
ST IS 1 LONG;

# THE NEWEST VERSION OF A SHARED LIBRARY IN A DIRECTORY: PREFIX FOLLOWED BY MAJOR.MINOR, AS OPENBSD NAMES ITS LIBRARIES (LIBC.SO.97.1, WITH NO LIBC.SO FOR THE LINKER TO FIND BY -LC); THE PATH GOES TO THE BUFFER OUT, 4096
  BYTES; 1 IF THERE IS ONE.  THE LINKER IS NOT GIVEN -LC BUT THIS FILE #
SUBR IMPFINDLIB(OUT,DIRP,PREFIX) IS (
 D,E,N,Q,NM,MAJ,MINV,BMAJ,BMIN,R ARE LOCAL;
 D:=CCALL opendir(DIRP);
 D=0 => RETURN 0;
 N:=CCALL strlen(PREFIX); BMAJ:=0-1; BMIN:=0-1;
 CCALL memset(LOC(BESTB),0,320);
 FL1: E:=(CCALL readdir(D)) AND SCMASK(0);                      # (A 32 BIT POINTER THAT CCALL RETURNS IS SIGN EXTENDED, AND THE ONES READ FROM MEMORY ARE NOT: THEY ARE COMPARED) #
 E=0 => GO TO FL9;
 NM:=E+SCDNAME(0);
 CCALL strncmp(NM,PREFIX,N) NE 0 => GO TO FL1;
 ENDP:=0;
 MAJ:=CCALL strtol(NM+N,LOC(ENDP),10);
 Q:=ENDP AND SCMASK(0);
 Q=(NM+N) => GO TO FL1;
 MINV:=0;
 IMPPEEK(Q,1)=46 => (ENDP:=0;                                    # . #
                     MINV:=CCALL strtol(Q+1,LOC(ENDP),10);
                     R:=ENDP AND SCMASK(0);
                     R=(Q+1) => GO TO FL1;
                     IMPPEEK(R,1) NE 0 => GO TO FL1)
  ELSE (IMPPEEK(Q,1) NE 0 => GO TO FL1);
 MAJ>BMAJ => GO TO FL2;
 MAJ=BMAJ => (MINV>BMIN => GO TO FL2);
 GO TO FL1;
 FL2: BMAJ:=MAJ; BMIN:=MINV; CCALL strncpy(LOC(BESTB),NM,300);
 GO TO FL1;
 FL9: CCALL closedir(D);
 BMAJ<0 => RETURN 0;
 CCALL strcpy(OUT,DIRP); CCALL strcat(OUT,LOC('/')); CCALL strcat(OUT,LOC(BESTB));
 1);

# (IMPHOSTINTERP, the dynamic linker of the program, is in IMPHOSTX-ELF.IMP or IMPHOSTX-MACHO.IMP: dl_iterate_phdr is the ELF systems') #

# THE FILE OF THE C LIBRARY THIS PROGRAM USES (THE SHARED OBJECT THAT HAS GETENV), INTO THE BUFFER OUT; 1 IF IT IS A FILE: LIBC.SO.6, LIBC.SO.97.1, LD-MUSL-X86_64.SO.1 #
SUBR IMPHOSTLIBC(OUT) IS (
 FN,F ARE LOCAL;
 CCALL memset(OUT,0,1);
 SCDL(0)=0 => RETURN 0;
 FN:=CCALL dlsym(SCRTLD(0),LOC('getenv'));
 FN=0 => RETURN 0;
 CCALL dladdr(FN,LOC(DLI))=0 => RETURN 0;
 F:=IMPPEEKPTR(LOC(DLI));                                       # DLI_FNAME #
 F=0 => RETURN 0;
 IMPPEEK(F,1) NE 47 => RETURN 0;
 CCALL strcpy(OUT,F);
 1);

# DOES THE DIRECTORY D HAVE CRT1.O (CRT0.O) #
SUBR HASCRT(D) IS (
 CCALL strcpy(LOC(PATHC),D); CCALL strcat(LOC(PATHC),LOC('/crt1.o'));
 CCALL access(LOC(PATHC),4)=0 => RETURN 1;
 CCALL strcpy(LOC(PATHC),D); CCALL strcat(LOC(PATHC),LOC('/crt0.o'));
 CCALL access(LOC(PATHC),4)=0 => 1 ELSE 0);

# THE DIRECTORY OF CRT1.O (CRT0.O) THAT GOES WITH THE C LIBRARY IN USE: WHERE THE LIBRARY IS, OR THE SAME UNDER /USR (/LIB/X86_64-LINUX-GNU HAS THE LIBRARY, AND /USR/LIB/X86_64-LINUX-GNU THE CRT FILES; /LIB64 AND
  /USR/LIB64; /LIB AND /USR/LIB), ELSE /USR/LIB; INTO THE BUFFER OUT; 1 IF ONE HAS THEM #
SUBR IMPHOSTCRTDIR(OUT) IS (
 SL,L ARE LOCAL;
 CCALL memset(OUT,0,1);
 IMPHOSTLIBC(LOC(PATHA))=0 => RETURN 0;
 SL:=(CCALL strrchr(LOC(PATHA),47)) AND SCMASK(0);
 SL=0 => RETURN 0;
 L:=SL-LOC(PATHA);
 CCALL memcpy(LOC(PATHB),LOC(PATHA),L); CCALL memset(LOC(PATHB)+L,0,1);          # PATHB: THE DIRECTORY OF THE LIBRARY #
 CCALL strcpy(LOC(PATHA),LOC('/usr')); CCALL strcat(LOC(PATHA),LOC(PATHB));       # PATHA: THE SAME UNDER /USR #
 HASCRT(LOC(PATHB)) NE 0 => (CCALL strcpy(OUT,LOC(PATHB)); RETURN 1);
 HASCRT(LOC(PATHA)) NE 0 => (CCALL strcpy(OUT,LOC(PATHA)); RETURN 1);
 HASCRT(LOC('/usr/lib')) NE 0 => (CCALL strcpy(OUT,LOC('/usr/lib')); RETURN 1);
 0);

# RUN LLD AS A PROGRAM, FOUND BY THE PATH UNDER THE NAME IN ARGV[0] (LD.LLD, LD64.LLD), WITH THE ARGUMENT VECTOR ARGV (NULL ENDED); WAIT FOR IT; 0 IF IT LINKED.  FOR A COMPILER BUILT WITHOUT THE LLD LIBRARY, AS OPENBSD'S
  IS (ITS OWN LINKER IS LLD, AND IT HAS NO LIBRARY OF IT).  IF IT IS NOT IN THE PATH: WHERE THE LLVM THIS WAS BUILT WITH HAS ITS PROGRAMS #
SUBR IMPRUNLD(ARGC,ARGV) IS (
 PID,R,A0 ARE LOCAL;
 CCALL fflush(0);
 PID:=CCALL fork();
 PID<0 => RETURN 1;
 PID=0 => (A0:=IMPPEEKPTR(ARGV);
           CCALL execvp(A0,ARGV);
           SCBINDIR(0) NE 0 => (CCALL strcpy(LOC(PATHA),SCBINDIR(0)); CCALL strcat(LOC(PATHA),LOC('/')); CCALL strcat(LOC(PATHA),A0);
                                CCALL execv(LOC(PATHA),ARGV));
           CCALL perror(A0);
           CCALL _exit(127));
 ST:=0;
 WL1: R:=CCALL waitpid(PID,LOC(ST),0);
 R<0 => GO TO WL1;
 (ST AND 127)=0 => ((ST RS 8) AND 255)=0 => RETURN 0;
 1)
%%
