#IMPHOST: WHAT THE LINK NEEDS TO KNOW OF THE MACHINE IT RUNS ON: THE SYSTEM (IMPHOSTOS) AND THE ARCHITECTURE (IMPHOSTARCH), IN SYSGEN; WHERE THIS VERY PROGRAM FOUND ITS DYNAMIC LINKER (IMPHOSTINTERP) AND ITS C LIBRARY
(IMPHOSTLIBC), THE DIRECTORY OF THE C LIBRARY'S CRT FILES THAT GOES WITH IT (IMPHOSTCRTDIR), THE NEWEST VERSION OF A LIBRARY THAT IS ONLY THERE WITH ITS VERSION (IMPFINDLIB), AND LLD RUN AS A PROGRAM (IMPRUNLD).  THE
COMPILER RUNS ON THE SYSTEM IT MAKES PROGRAMS FOR, SO WHAT ITS OWN LOADER DID IS WHAT THE PROGRAMS IT MAKES NEED.  SRC/DRIVER.IMP CALLS THEM; THE TRANSLATION OF LIB/IMPHOST.C, WHICH THE SEED KEEPS (STAGE0/IMPHOST.C)
FOR ITS OWN DRIVER.  THE PARAMETERS ARE BY REFERENCE: THE CALLERS DO NOT USE CCALL.  A PATH IS IN A BUFFER OF 4096 BYTES.#

DLI IS 4 LONG;
BESTB IS 40 LONG;
PATHA IS 520 LONG;
PATHB IS 520 LONG;
PATHC IS 520 LONG;
ENDP IS 1 LONG;
TDTRY,TDDF ARE 520 LONG;                                 # THE PRIVATE DIRECTORY; THE DEFAULT BASE OF IT #
TDLST IS 8192 LONG;                                      # THE FILES MADE IN IT: C STRINGS ONE AFTER THE OTHER, TDLEN BYTES #
ST IS 1 LONG;

# THE NEWEST VERSION OF A SHARED LIBRARY IN A DIRECTORY: PREFIX FOLLOWED BY MAJOR.MINOR, AS OPENBSD NAMES ITS LIBRARIES (LIBC.SO.97.1, WITH NO LIBC.SO FOR THE LINKER TO FIND BY -LC); THE PATH GOES TO THE BUFFER OUT, 4096
  BYTES; 1 IF THERE IS ONE.  THE LINKER IS NOT GIVEN -LC BUT THIS FILE #
SUBR IMPFINDLIB(OUT,DIRP,PREFIX) IS (
 D,E,N,Q,NM,MAJ,MINV,BMAJ,BMIN,R ARE LOCAL;
 D:=CCALL opendir(DIRP);
 D=0 => RETURN 0;
 N:=CCALL strlen(PREFIX); BMAJ:=0-1; BMIN:=0-1;
 CCALL memset(LOC(BESTB),0,320);
 FL1: E:=(CCALL readdir(D)) AND SCMASK(0);                      # (A 32 BIT POINTER THAT CCALL RETURNS IS SIGN EXTENDED, AND THE ONES READ FROM MEMORY ARE NOT: THEY ARE COMPARED) #
 E=0 => GO TO FL9;
 NM:=E+SCDNAME(0);
 CCALL strncmp(NM,PREFIX,N) NE 0 => GO TO FL1;
 ENDP:=0;
 MAJ:=CCALL strtol(NM+N,LOC(ENDP),10);
 Q:=ENDP AND SCMASK(0);
 Q=(NM+N) => GO TO FL1;
 MINV:=0;
 IMPPEEK(Q,1)=46 => (ENDP:=0;                                    # . #
                     MINV:=CCALL strtol(Q+1,LOC(ENDP),10);
                     R:=ENDP AND SCMASK(0);
                     R=(Q+1) => GO TO FL1;
                     IMPPEEK(R,1) NE 0 => GO TO FL1)
  ELSE (IMPPEEK(Q,1) NE 0 => GO TO FL1);
 MAJ>BMAJ => GO TO FL2;
 MAJ=BMAJ => (MINV>BMIN => GO TO FL2);
 GO TO FL1;
 FL2: BMAJ:=MAJ; BMIN:=MINV; CCALL strncpy(LOC(BESTB),NM,300);
 GO TO FL1;
 FL9: CCALL closedir(D);
 BMAJ<0 => RETURN 0;
 CCALL snprintf(OUT,4096,LOC('%s/%s'),DIRP,LOC(BESTB));
 1);

# (IMPHOSTINTERP, the dynamic linker of the program, is in IMPHOSTX-ELF.IMP or IMPHOSTX-MACHO.IMP: dl_iterate_phdr is the ELF systems') #

# THE FILE OF THE C LIBRARY THIS PROGRAM USES (THE SHARED OBJECT THAT HAS GETENV), INTO THE BUFFER OUT; 1 IF IT IS A FILE: LIBC.SO.6, LIBC.SO.97.1, LD-MUSL-X86_64.SO.1 #
SUBR IMPHOSTLIBC(OUT) IS (
 FN,F ARE LOCAL;
 CCALL memset(OUT,0,1);
 SCDL(0)=0 => RETURN 0;
 FN:=CCALL dlsym(SCRTLD(0),LOC('getenv'));
 FN=0 => RETURN 0;
 CCALL dladdr(FN,LOC(DLI))=0 => RETURN 0;
 F:=IMPPEEKPTR(LOC(DLI));                                       # DLI_FNAME #
 F=0 => RETURN 0;
 IMPPEEK(F,1) NE 47 => RETURN 0;
 CCALL snprintf(OUT,4096,LOC('%s'),F);
 1);

# DOES THE DIRECTORY D HAVE CRT1.O (CRT0.O) #
SUBR HASCRT(D) IS (
 CCALL snprintf(LOC(PATHC),4096,LOC('%s/crt1.o'),D);
 CCALL access(LOC(PATHC),4)=0 => RETURN 1;
 CCALL snprintf(LOC(PATHC),4096,LOC('%s/crt0.o'),D);
 CCALL access(LOC(PATHC),4)=0 => 1 ELSE 0);

# THE DIRECTORY OF CRT1.O (CRT0.O) THAT GOES WITH THE C LIBRARY IN USE: WHERE THE LIBRARY IS, OR THE SAME UNDER /USR (/LIB/X86_64-LINUX-GNU HAS THE LIBRARY, AND /USR/LIB/X86_64-LINUX-GNU THE CRT FILES; /LIB64 AND
  /USR/LIB64; /LIB AND /USR/LIB), ELSE /USR/LIB; INTO THE BUFFER OUT; 1 IF ONE HAS THEM #
SUBR IMPHOSTCRTDIR(OUT) IS (
 SL,L,QA,QB ARE LOCAL;
 CCALL memset(OUT,0,1);
 IMPHOSTLIBC(LOC(PATHA))=0 => RETURN 0;
 SL:=(CCALL strrchr(LOC(PATHA),47)) AND SCMASK(0);
 SL=0 => RETURN 0;
 QA:=LOC(PATHA); QB:=LOC(PATHB);                                 # (IN VARIABLES: THE SEED TAKES LOC(X)+N FOR N WORDS) #
 L:=SL-QA;
 CCALL memcpy(QB,QA,L); CCALL memset(QB+L,0,1);          # PATHB: THE DIRECTORY OF THE LIBRARY #
 CCALL snprintf(LOC(PATHA),4096,LOC('/usr%s'),LOC(PATHB));       # PATHA: THE SAME UNDER /USR #
 HASCRT(LOC(PATHB)) NE 0 => (CCALL snprintf(OUT,4096,LOC('%s'),LOC(PATHB)); RETURN 1);
 HASCRT(LOC(PATHA)) NE 0 => (CCALL snprintf(OUT,4096,LOC('%s'),LOC(PATHA)); RETURN 1);
 HASCRT(LOC('/usr/lib')) NE 0 => (CCALL snprintf(OUT,4096,LOC('%s'),LOC('/usr/lib')); RETURN 1);
 0);

# RUN LLD AS A PROGRAM, FOUND BY THE PATH UNDER THE NAME IN ARGV[0] (LD.LLD, LD64.LLD), WITH THE ARGUMENT VECTOR ARGV (NULL ENDED); WAIT FOR IT; 0 IF IT LINKED.  FOR A COMPILER BUILT WITHOUT THE LLD LIBRARY, AS OPENBSD'S
  IS (ITS OWN LINKER IS LLD, AND IT HAS NO LIBRARY OF IT).  IF IT IS NOT IN THE PATH: WHERE THE LLVM THIS WAS BUILT WITH HAS ITS PROGRAMS #
SUBR IMPRUNLD(ARGC,ARGV) IS (
 PID,R,A0 ARE LOCAL;
 CCALL fflush(0);
 PID:=CCALL fork();
 PID<0 => RETURN 1;
 PID=0 => (A0:=IMPPEEKPTR(ARGV);
           CCALL execvp(A0,ARGV);
           SCBINDIR(0) NE 0 => (CCALL snprintf(LOC(PATHA),4096,LOC('%s/%s'),SCBINDIR(0),A0);
                                CCALL execv(LOC(PATHA),ARGV));
           CCALL perror(A0);
           CCALL _exit(127));
 ST:=0;
 WL1: R:=CCALL waitpid(PID,LOC(ST),0);
 R<0 => GO TO WL1;
 (ST AND 127)=0 => ((ST RS 8) AND 255)=0 => RETURN 0;
 1);

# THE TEMPORARY FILES OF THE COMPILER (IMPTMP...): NONE UNLESS THE LINK NEEDS A FILE FOR THE OBJECT.  THE OBJECT OF A PROGRAM TO BE LINKED GOES TO AN UNNAMED MEMORY FILE ON LINUX (MEMFD_CREATE, FOUND AT RUN TIME, AND THE
  LINKER IS GIVEN /PROC/SELF/FD/N), ELSE TO A FILE IN A PRIVATE DIRECTORY: MADE WHEN IT IS FIRST NEEDED, BY MKDTEMP IN TMPDIR (AN ABSOLUTE PATH NAMING A DIRECTORY) OR ELSE IN THE DEFAULT (IMPTMPBASE), MADE PRIVATE (MODE
  0700; ONLY ITS OWNER CAN DO THAT), AND REMOVED, WITH THE FILES MADE IN IT, AT EXIT AND BY A HANDLER OF SIGHUP, SIGINT, SIGQUIT AND SIGTERM, WITH UNLINK AND RMDIR AND NO SHELL.  STAGE0/IMPHOST.C IS THE C TWIN OF THIS (IT ALSO
  CHECKS WITH LSTAT THE OWNER AND THE MODE, WHICH NEED THE LAYOUT OF STRUCT STAT, A THING OF THE HEADERS) #

# REMOVE THE FILES AND THE DIRECTORY; WHAT A HANDLER MAY DO (UNLINK, RMDIR, KILL, WAITPID, GETPID, STATIC DATA); NOTHING IF THERE IS NONE OR IT WAS MADE BY ANOTHER PROCESS (A CHILD OF THE COMPILER) #
SUBR TDCLEAN(Z) IS (
 P,E,K,W ARE LOCAL;
 TDARM=0 => RETURN 0;
 (CCALL getpid() AND 4294967295) NE TDPID => RETURN 0;
 TDKID>0 => CCALL kill(TDKID,15);
 K:=0;
 TDC1: TDKID LE 0 => GO TO TDC3;
       K>2 => GO TO TDC3;
       W:=CCALL waitpid(TDKID,0,0) AND 4294967295;
       K:=K+1;
       W=4294967295 => GO TO TDC1;
 TDC3: TDKID:=0;
 P:=LOC(TDLST); E:=P+TDLEN;
 TDC2: P<E => (CCALL unlink(P); K:=CCALL strlen(P); P:=P+K+1; GO TO TDC2);
 CCALL rmdir(LOC(TDTRY));
 TDARM:=0;
 0);

# THE HANDLER OF A SIGNAL S: CLEAN, THEN LET THE SIGNAL DO WHAT IT DOES (THE EXIT STATUS IS THE SIGNAL'S).  THE C LIBRARY CALLS THEM WITH THE NUMBER OF THE SIGNAL IN A REGISTER, WHICH IS NOT A REFERENCE: ONE EACH #
SUBR TDSIGX(S) IS (
 TDCLEAN(0);
 CCALL signal(S,0);
 CCALL raise(S);
 0);
SUBR TDSIG1(Z) IS TDSIGX(1);
SUBR TDSIG2(Z) IS TDSIGX(2);
SUBR TDSIG3(Z) IS TDSIGX(3);
SUBR TDSIG15(Z) IS TDSIGX(15);

# THE HANDLER H FOR THE SIGNAL S, UNLESS THE SIGNAL IS IGNORED (NOHUP, A JOB IN THE BACKGROUND): THEN IT STAYS SO #
SUBR TDINST(S,H) IS (
 O ARE LOCAL;
 O:=CCALL signal(S,H);
 O=1 => CCALL signal(S,1);
 0);

SUBR TDHOOK(Z) IS (
 TDHOOKED NE 0 => RETURN 0;
 TDHOOKED:=1;
 TDINST(1,LOC(TDSIG1)); TDINST(2,LOC(TDSIG2)); TDINST(3,LOC(TDSIG3)); TDINST(15,LOC(TDSIG15));
 CCALL atexit(LOC(TDCLEAN));
 0);

# THE DEFAULT BASE OF THE PRIVATE DIRECTORY (A C STRING), WHICH IS MADE IF IT IS NOT THERE (THE SOURCE TREE'S TMP/) #
SUBR IMPTMPBASE(P) IS (CCALL snprintf(LOC(TDDF),4096,LOC('%s'),P); 0);

# A PRIVATE DIRECTORY IN THE DIRECTORY BASE: 1 IF IT WAS MADE.  IT IS ARMED BEFORE MKDTEMP MAKES IT, SO THAT A SIGNAL IN BETWEEN FINDS IT #
SUBR TDTRYMK(BASE) IS (
 TDARM:=0;
 CCALL snprintf(LOC(TDTRY),4096,LOC('%s/imp72stage0.XXXXXX'),BASE);
 TDPID:=CCALL getpid() AND 4294967295; TDLEN:=0; TDKID:=0;
 TDARM:=1;
 CCALL mkdtemp(LOC(TDTRY))=0 => (TDARM:=0; RETURN 0);
 (CCALL chmod(LOC(TDTRY),448) AND 4294967295) NE 0 => (CCALL rmdir(LOC(TDTRY)); TDARM:=0; RETURN 0);
 1);

# THE PRIVATE DIRECTORY EXISTS: 1 IF IT DOES NOW.  TMPDIR IF IT IS AN ABSOLUTE PATH NAMING A DIRECTORY AND A DIRECTORY CAN BE MADE IN IT, ELSE THE DEFAULT #
SUBR TDMAKE(Z) IS (
 V,D ARE LOCAL;
 TDARM NE 0 => RETURN 1;
 TDHOOK(0);
 V:=CCALL getenv(LOC('TMPDIR'));
 V NE 0 => IMPPEEK(V,1)=57B => (D:=CCALL opendir(V);
                                  D NE 0 => (CCALL closedir(D); TDTRYMK(V)=1 => RETURN 1));
 CCALL mkdir(LOC(TDDF),511);
 TDTRYMK(LOC(TDDF)));

# THE PATH OF THE FILE NAME IN THE PRIVATE DIRECTORY, WHICH IS MADE IF NEED BE, INTO OUT (4096 BYTES); THE FILE IS REMOVED WITH THE DIRECTORY.  0 IF IT WORKED #
SUBR IMPTMPPATH(NAME,OUT) IS (
 L,Q ARE LOCAL;
 TDMAKE(0)=0 => (CCALL dprintf(2,LOC('%s%c'),LOC('imp72: cannot make a temporary directory'),10); RETURN 1);
 CCALL snprintf(OUT,4096,LOC('%s/%s'),LOC(TDTRY),NAME);
 L:=CCALL strlen(OUT);
 L:=L+1;
 (TDLEN+L)>65536 => (CCALL dprintf(2,LOC('%s%c'),LOC('imp72: too many temporary files'),10); RETURN 1);
 Q:=LOC(TDLST)+TDLEN;
 CCALL memcpy(Q,OUT,L);
 TDLEN:=TDLEN+L;
 0);

# A CHILD PROCESS THAT THE HANDLER STOPS AND WAITS FOR BEFORE IT REMOVES THE FILES (0: NONE) #
SUBR IMPTMPKID(PID) IS (TDKID:=PID; 0);

SUBR IMPTMPCLEAN(Z) IS (TDCLEAN(0); 0);

# IMP72NOMEMFD SET, AND NOT 0: NO MEMORY FILE #
SUBR TDNOMEMFD(Z) IS (
 V ARE LOCAL;
 V:=CCALL getenv(LOC('IMP72NOMEMFD'));
 V=0 => RETURN 0;
 IMPPEEK(V,1)=0 => RETURN 0;
 IMPPEEK(V,1)=60B => IMPPEEK(V+1,1)=0 => RETURN 0;
 1);

# A MEMORY FILE (MEMFD_CREATE, NOT CLOSED BY AN EXEC: A LINKER RUN AS A PROGRAM HAS IT), ITS DESCRIPTOR; 0-1 IF THERE IS NONE.  THE SYSTEM CALL BY ITS NUMBER, FOUND NOWHERE BUT HERE AT BUILD TIME NOR IN THE C LIBRARY BEFORE GLIBC 2.27 #
SUBR TDMEMFD(Z) IS (
 A,N,R ARE LOCAL;
 (CCALL strcmp(IMPHOSTOS(0),LOC('linux')) AND 4294967295) NE 0 => RETURN 0-1;
 A:=IMPHOSTARCH(0);
 N:=0;
 (CCALL strcmp(A,LOC('x86_64')) AND 4294967295)=0 => N:=319;
 (CCALL strcmp(A,LOC('i386')) AND 4294967295)=0 => N:=356;
 (CCALL strcmp(A,LOC('arm')) AND 4294967295)=0 => N:=385;
 (CCALL strcmp(A,LOC('aarch64')) AND 4294967295)=0 => N:=279;
 (CCALL strcmp(A,LOC('riscv64')) AND 4294967295)=0 => N:=279;
 (CCALL strcmp(A,LOC('loongarch64')) AND 4294967295)=0 => N:=279;
 (CCALL strcmp(A,LOC('ppc64le')) AND 4294967295)=0 => N:=360;
 (CCALL strcmp(A,LOC('s390x')) AND 4294967295)=0 => N:=350;
 N=0 => RETURN 0-1;
 R:=CCALL syscall(N,LOC('imp72'),0) AND 4294967295;
 R=4294967295 => RETURN 0-1;
 R);

# WRITE THE N BYTES AT BUF TO THE FILE DESCRIPTOR FD; 0 IF ALL WERE WRITTEN #
SUBR TDWRITE(FD,BUF,N) IS (
 P,K,R ARE LOCAL;
 P:=BUF; K:=N;
 TDW1: K LE 0 => RETURN 0;
       R:=CCALL write(FD,P,K);
       R LE 0 => RETURN 1;
       P:=P+R; K:=K-R; GO TO TDW1);

# THE N BYTES OF THE OBJECT AT BUF IN A FILE FOR THE LINKER, WHOSE PATH GOES TO OUT (4096 BYTES): /PROC/SELF/FD/N OF A MEMORY FILE WHERE THERE IS ONE, ELSE A FILE OF THE PRIVATE DIRECTORY MADE FOR THE PURPOSE
  (EXCLUSIVELY, MODE 0600).  0 IF IT WORKED #
SUBR IMPTMPOBJ(BUF,N,OUT) IS (
 FD,T,F ARE LOCAL;
 TDNOMEMFD(0)=0 => (FD:=TDMEMFD(0);
                    FD GE 0 => (TDWRITE(FD,BUF,N)=0 => (CCALL snprintf(OUT,4096,LOC('/proc/self/fd/%d'),FD);
                                                         T:=CCALL open(OUT,0) AND 4294967295;
                                                         T NE 4294967295 => (CCALL close(T); RETURN 0));
                                CCALL close(FD)));
 IMPTMPPATH(LOC('p.o'),OUT) NE 0 => RETURN 1;
 F:=CCALL fopen(OUT,LOC('wbx'));
 F=0 => (CCALL perror(OUT); RETURN 1);
 CCALL chmod(OUT,384);
 (CCALL fwrite(BUF,1,N,F)) NE N => (CCALL perror(OUT); CCALL fclose(F); RETURN 1);
 (CCALL fclose(F) AND 4294967295) NE 0 => (CCALL perror(OUT); RETURN 1);
 0);

# RUN THE PROGRAM IN ARGV[0] (A PATH) WITH THE ARGUMENT VECTOR ARGV (NULL ENDED), NO SHELL; WAIT FOR IT; 0 IF IT SUCCEEDED.  THE HANDLER OF THE SIGNALS STOPS IT BEFORE THE TEMPORARY FILES ARE REMOVED #
SUBR IMPRUNKID(ARGC,ARGV) IS (
 PID,R,A0 ARE LOCAL;
 CCALL fflush(0);
 PID:=CCALL fork();
 PID<0 => RETURN 1;
 PID=0 => (A0:=IMPPEEKPTR(ARGV);
           CCALL execv(A0,ARGV);
           CCALL perror(A0);
           CCALL _exit(127));
 TDKID:=PID AND 4294967295;
 ST:=0;
 TDR1: R:=CCALL waitpid(PID,LOC(ST),0) AND 4294967295;
 R=4294967295 => GO TO TDR1;
 TDKID:=0;
 (ST AND 127)=0 => ((ST RS 8) AND 255)=0 => RETURN 0;
 1)
%%
