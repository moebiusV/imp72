#IMPHOST-WIN: WHAT IMPHOST HAS (LIB/IMPHOST.IML) FOR WINDOWS, WHERE THERE IS NO FORK, NO PROGRAM INTERPRETER IN THE PROGRAM HEADERS AND NO MKDTEMP: THE PRIVATE DIRECTORY OF THE TEMPORARY FILES, THE LINKER RUN AS A PROGRAM
(CREATEPROCESS), THE PATH OF THE RUNNING PROGRAM, AND THE QUESTIONS ABOUT AN ELF SYSTEM THAT A WINDOWS PROGRAM ANSWERS NONE TO (THE LOADER, THE C LIBRARY, THE START FILES: ITS FILES ARE MINGW-W64 S, UNDER A ROOT THE DRIVER
FINDS BESIDE ITSELF).  THE SAME ROUTINES AS IMPHOST, WITH THE SAME PARAMETERS (BY REFERENCE, A PATH IN A BUFFER OF 4096 BYTES); STAGE0/IMPHOST-WIN.C IS THE SEED S.  A PROGRAM FOR WINDOWS LINKS THIS FILE IN PLACE OF IMPHOST
(TOOLS/MKRT.SH).#

TDTRY,TDDF ARE 520 LONG;                                 # THE PRIVATE DIRECTORY; THE DEFAULT BASE OF IT #
TDLST IS 8192 LONG;                                      # THE FILES MADE IN IT: C STRINGS ONE AFTER THE OTHER, TDLEN BYTES #
TDLEN,TDARM,TDHOOKED,TDN ARE 1 LONG;
SI IS 16 LONG;                                           # STARTUPINFO: 104 BYTES #
PI IS 4 LONG;                                            # PROCESS_INFORMATION: 24 BYTES #
CMDB IS 8200 LONG;                                       # A COMMAND LINE: 64 KILOBYTES #

EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL INT GetModuleFileNameA(PTR, PTR, INT);
EXTERNAL PTR _fullpath(PTR, PTR, SIZE);
EXTERNAL INT _mkdir(PTR);
EXTERNAL INT _rmdir(PTR);
EXTERNAL INT _unlink(PTR);
EXTERNAL INT _getpid();
EXTERNAL INT CreateProcessA(PTR, PTR, PTR, PTR, INT, INT, PTR, PTR, PTR, PTR);
EXTERNAL INT WaitForSingleObject(PTR, INT);
EXTERNAL INT GetExitCodeProcess(PTR, PTR);
EXTERNAL INT CloseHandle(PTR);
EXTERNAL INT GetTempPathA(INT, PTR);
EXTERNAL INT GetTempFileNameA(PTR, PTR, INT, PTR);
EXTERNAL PTR CreateFileA(PTR, INT, INT, PTR, INT, INT, PTR);
EXTERNAL INT _open_osfhandle(PTR, INT);
EXTERNAL PTR _fdopen(INT, PTR);
EXTERNAL INT _close(INT);
EXTERNAL INT fseek(PTR, LONG, INT);
EXTERNAL LONG ftell(PTR);
EXTERNAL VOID rewind(PTR);

MSF,MSB,MSL IS 32 LONG;                                  # THE STREAMS OF IMPMEMOPEN: THE FILE, THE ADDRESS OF THE POINTER TO ITS TEXT, THE ADDRESS OF ITS LENGTH #
MSD,MSN IS 520 LONG;                                     # THE TEMP DIRECTORY AND THE NAME OF A FILE IN IT #


# AN ANONYMOUS FILE FOR READING AND WRITING, GONE WHEN IT IS CLOSED (THE C LIBRARY HAS NO OPEN_MEMSTREAM AND NO FMEMOPEN HERE): A TEMPORARY FILE OF THE SYSTEM THAT IS DELETED ON CLOSE; 0 IF NONE #
SUBR MEMFILE(Z) IS (
 H,FD ARE LOCAL;
 CCALL GetTempPathA(4096,LOC(MSD))=0 => RETURN 0;
 CCALL GetTempFileNameA(LOC(MSD),LOC('imp'),0,LOC(MSN))=0 => RETURN 0;
 H:=CCALL CreateFileA(LOC(MSN),3221225472,7,0,2,67109120,0);             # GENERIC_READ OR GENERIC_WRITE, SHARE ALL, CREATE_ALWAYS, TEMPORARY AND DELETE ON CLOSE #
 H=0-1 => RETURN 0;
 FD:=CCALL _open_osfhandle(H,32770) AND 4294967295;                       # O_BINARY OR O_RDWR #
 FD=4294967295 => (CCALL CloseHandle(H); RETURN 0);
 CCALL _fdopen(FD,LOC('w+b')));

SUBR IMPMEMOPEN(PB,PL) IS (
 F,K,PBA,PLA ARE LOCAL;
 PBA:=PB; PLA:=PL;
 F:=MEMFILE(0);
 F=0 => RETURN 0;
 K:=0;
 MO1: K<32 => (MSF[K]=0 => (MSF[K]:=F; MSB[K]:=PBA; MSL[K]:=PLA; [PBA]:=0; [PLA]:=0; RETURN F);
               K:=K+1; GO TO MO1);
 CCALL fclose(F);
 0);

# THE STREAM CLOSED, AND WHAT WAS WRITTEN TO IT AT ITS POINTER AND LENGTH (A MALLOC S BUFFER, A ZERO BYTE AFTER IT): 0 FOR SUCCESS #
SUBR IMPMEMCLOSE(F) IS (
 K,N,B,FA,R ARE LOCAL;
 FA:=F; R:=0;
 K:=0;
 MC1: K<32 => (MSF[K]=FA => (CCALL fflush(FA);
                             CCALL fseek(FA,0,2); N:=CCALL ftell(FA); CCALL fseek(FA,0,0);
                             B:=CCALL malloc(N+1);
                             B=0 => R:=1 ELSE (N>0 => (CCALL fread(B,1,N,FA) NE N => R:=1);
                                               CCALL memset(B+N,0,1);
                                               [MSB[K]]:=B; [MSL[K]]:=N);
                             MSF[K]:=0; GO TO MC2);
               K:=K+1; GO TO MC1);
 MC2: (CCALL fclose(FA) AND 4294967295) NE 0 => RETURN 1;
 R);

# A STREAM TO READ THE N BYTES AT BUF #
SUBR IMPMEMFROM(BUF,N) IS (
 F,NA,BA ARE LOCAL;
 NA:=N; BA:=BUF;
 F:=MEMFILE(0);
 F=0 => RETURN 0;
 NA>0 => (CCALL fwrite(BA,1,NA,F) NE NA => (CCALL fclose(F); RETURN 0));
 CCALL fflush(F);
 CCALL rewind(F);
 F);

# THE PATH OF THIS PROGRAM INTO OUT (N BYTES), WITH / FOR THE BACKSLASH; ITS LENGTH, OR 0-1 #
# EVERY BACKSLASH OF THE C STRING S A SLASH #
SUBR SLASHES(S) IS (
 P ARE LOCAL;
 SL1: P:=CCALL strchr(S,92);
      P=0 => RETURN 0;
      CCALL memset(P,47,1); GO TO SL1);

SUBR IMPEXEPATH(OUT,N) IS (
 K ARE LOCAL;
 K:=CCALL GetModuleFileNameA(0,OUT,N) AND 4294967295;
 K=0 => RETURN 0-1;
 K GE N => RETURN 0-1;
 I:=0;
 SLASHES(OUT);
 K);

# THE FULL PATH OF IN INTO OUT (4096 BYTES), WITH / FOR THE BACKSLASH; OUT, OR 0 IF THERE IS NONE #
SUBR IMPFULLPATH(IN,OUT) IS (
 R ARE LOCAL;
 R:=CCALL _fullpath(OUT,IN,4096);
 R=0 => RETURN 0;
 SLASHES(OUT);
 OUT);

# WHAT AN ELF SYSTEM HAS AND A WINDOWS PROGRAM DOES NOT: THE LIBRARY OF A VERSION, THE C LIBRARY OF THE LOADER, THE DIRECTORY OF THE START FILES, THE FILES OF A MACHINE WITH NO LOADER OF ITS OWN #
SUBR IMPFINDLIB(OUT,DIRP,PREFIX) IS 0;
SUBR IMPHOSTLIBC(OUT) IS 0;
SUBR IMPHOSTCRTDIR(OUT) IS 0;
SUBR IMPHOSTPROBE(CRT,INTERP) IS 0;

# THE TEMPORARY FILES: THE FILES IN THE PRIVATE DIRECTORY ARE REMOVED, AND THE DIRECTORY, AT THE END OF THE PROGRAM #
SUBR TDCLEAN(Z) IS (
 P,E,K ARE LOCAL;
 TDARM=0 => RETURN 0;
 P:=LOC(TDLST); E:=P+TDLEN;
 TDC1: P<E => (CCALL _unlink(P); K:=CCALL strlen(P); P:=P+K+1; GO TO TDC1);
 CCALL _rmdir(LOC(TDTRY));
 TDARM:=0;
 0);

SUBR IMPTMPBASE(P) IS (CCALL snprintf(LOC(TDDF),4096,LOC('%s'),P); 0);

# THE PRIVATE DIRECTORY IN THE TEMP DIRECTORY (TEMP, TMP, THE BASE THE DRIVER GAVE, C:/WINDOWS/TEMP), NAMED FOR THE PROCESS: 1 IF IT WAS MADE #
SUBR TDMAKE(Z) IS (
 B,K,R ARE LOCAL;
 TDARM NE 0 => RETURN 1;
 B:=CCALL getenv(LOC('TEMP'));
 B=0 => B:=CCALL getenv(LOC('TMP'));
 B=0 => (CCALL strlen(LOC(TDDF)) NE 0 => B:=LOC(TDDF));
 B=0 => B:=LOC('C:/Windows/Temp');
 K:=0;
 TDM1: K<1000 => (CCALL snprintf(LOC(TDTRY),4096,LOC('%s/imp%d_%d'),B,CCALL _getpid() AND 4294967295,K);
                  R:=CCALL _mkdir(LOC(TDTRY)) AND 4294967295;
                  R=0 => (TDARM:=1; TDLEN:=0;
                          TDHOOKED=0 => (TDHOOKED:=1; CCALL atexit(LOC(TDCLEAN)));
                          RETURN 1);
                  K:=K+1; GO TO TDM1);
 0);

SUBR IMPTMPPATH(NAME,OUT) IS (
 L,Q ARE LOCAL;
 TDMAKE(0)=0 => (CCALL write(2,LOC('imp: cannot make a temporary directory'),38); RETURN 1);
 CCALL snprintf(OUT,4096,LOC('%s/%s'),LOC(TDTRY),NAME);
 L:=CCALL strlen(OUT);
 L:=L+1;
 (TDLEN+L)>65536 => (CCALL write(2,LOC('imp: too many temporary files'),29); RETURN 1);
 Q:=LOC(TDLST)+TDLEN;
 CCALL memcpy(Q,OUT,L);
 TDLEN:=TDLEN+L;
 0);

SUBR IMPTMPKID(PID) IS 0;

SUBR IMPTMPCLEAN(Z) IS (TDCLEAN(0); 0);

# THE OBJECT OF N BYTES AT BUF INTO A FILE OF THE PRIVATE DIRECTORY, ITS PATH INTO OUT: THE LINKER READS IT FROM THERE #
SUBR IMPTMPOBJ(BUF,N,OUT) IS (
 F ARE LOCAL;
 IMPTMPPATH(LOC('p.o'),OUT) NE 0 => RETURN 1;
 F:=CCALL fopen(OUT,LOC('wb'));
 F=0 => (CCALL perror(OUT); RETURN 1);
 (CCALL fwrite(BUF,1,N,F)) NE N => (CCALL perror(OUT); CCALL fclose(F); RETURN 1);
 (CCALL fclose(F) AND 4294967295) NE 0 => (CCALL perror(OUT); RETURN 1);
 0);

# S IN QUOTES AT P, A QUOTE IN IT AFTER A BACKSLASH; THE END OF WHAT WAS WRITTEN #
SUBR QCPY(P,A) IS (
 Q,S,N,L ARE LOCAL;
 Q:=P; S:=A;
 CCALL memset(Q,34,1); Q:=Q+1;
 QC1: N:=CCALL strchr(S,34);
      N=0 => (L:=CCALL strlen(S); CCALL memcpy(Q,S,L); Q:=Q+L; GO TO QC2);
      L:=N-S; CCALL memcpy(Q,S,L); Q:=Q+L;
      CCALL memset(Q,92,1); Q:=Q+1;
      CCALL memset(Q,34,1); Q:=Q+1;
      S:=N+1; GO TO QC1;
 QC2: CCALL memset(Q,34,1); Q:=Q+1;
 Q);

# RUN THE PROGRAM IN ARGV[0] WITH THE ARGUMENT VECTOR ARGV (NULL ENDED), EACH ARGUMENT IN QUOTES FOR THE COMMAND LINE; WAIT FOR IT; 0 IF IT RAN AND SUCCEEDED #
SUBR IMPRUNKID(ARGC,ARGV) IS (
 AC,I,P,A,EC,R ARE LOCAL;
 AC:=ARGC;
 CCALL fflush(0);
 P:=LOC(CMDB);
 I:=0;
 RK1: I<AC => (A:=IMPPEEKPTR(ARGV+(I*SCPTR(0)));
               I>0 => (CCALL memset(P,32,1); P:=P+1);
               P:=QCPY(P,A);
               I:=I+1; GO TO RK1);
 CCALL memset(P,0,1);
 CCALL memset(LOC(SI),0,128); CCALL memset(LOC(PI),0,32);
 SI[0]:=104;                                            # (THE SIZE, THE FIRST FOUR BYTES; THE REST IS ZERO) #
 R:=CCALL CreateProcessA(0,LOC(CMDB),0,0,1,0,0,0,LOC(SI),LOC(PI)) AND 4294967295;
 R=0 => (CCALL write(2,LOC('imp: cannot run the program'),27); RETURN 1);
 CCALL WaitForSingleObject(PI[0],4294967295);
 EC:=1;
 CCALL GetExitCodeProcess(PI[0],LOC(EC));
 CCALL CloseHandle(PI[1]);
 CCALL CloseHandle(PI[0]);
 (EC AND 4294967295)=0 => 0 ELSE 1);

# THE LINKER AS A PROGRAM, WHERE THERE IS NO LLD LIBRARY IN THE PROCESS: THE SAME #
SUBR IMPRUNLD(ARGC,ARGV) IS (IMPRUNKID(ARGC,ARGV))
%%
