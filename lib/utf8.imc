#THIS IS FILE UTF8, THE SYMBOLS OF UTF-8 FOR THE OPERATORS: A SYNTAX EXTENSION READ AFTER THE LANGUAGE'S OWN (SRC/SYNTAX.IMC) AND THE C INTERFACE (LIB/FFI.IMC).  EACH IS A SPELLING OF AN OPERATOR THAT THE LANGUAGE HAS, NOT A NEW OPERATOR: THE LEXER (SRC/LEX.IMC SYMLEN) MAKES A SYMBOL OF THE ARROWS AND THE MATHEMATICAL OPERATORS, U+2190 TO U+22FF, AND OF THE NOT
 SIGN, ONE TOKEN EACH AND NEVER PART OF A NAME, AND THESE RULES SAY WHICH OPERATOR IT IS: LE, GE AND NE ARE THE RELATIONS WRITTEN AS THEIR RULES ARE IN SYNTAX.IMC, AND THE OTHERS ARE MACROS OF THE OPERATOR AND ITS OPERANDS.  A NAME THAT HAS ONE OF THE SYMBOLS IN IT IS TWO NAMES AND THE SYMBOL, WHICH IS WHAT IT WAS NOT IN A LANGUAGE WITHOUT THEM; ANY OTHER TEXT OF UTF-8 IS STILL A NAME.#

# U+2264, LE: THE RULES OF SYNTAX.IMC THAT TAKE A RELATION, ONE FOR EACH, WITH THE SYMBOL WHERE THE RULE HAS <RELOP> AND LE IN THE MACRO (A RELATION IS NOT A WORD THAT THE TABLE OF RELATIONS COULD JUST GET: THE PATTERNS OF THE CONDITIONAL STATEMENTS NAME THE ASCII WORDS) #
 <ST>   ::= <EXP,A> ≤ <EXP,B> ::= "A LE B";
 <ST>   ::= <EXP,A> ≤ <EXP,B> => <ST,C> ::= "A LE B => C";
 <ST>   ::= <EXP,A> ≤ <EXP,B> => <ST,C> ELSE <ST,D> ::= "A LE B => C ELSE D";
 <ST>   ::= WHILE <EXP,A> ≤ <EXP,B> DO <ST,C> ::= "WHILE A LE B DO C";
 <ST>   ::= <EXP,A> UNTIL <B> ≤ <C> ::= "A UNTIL B LE C";
 <COND> ::= (<A> ≤ <B>) ::= LOCAL CND IN "A LE B=>GO TO CND[1]; CND:0";
 <COND> ::= (<A> ≤ <B>) OR <COND,C> ::= LOCAL OR IN "A LE B=>GO TO OR[1];C;OR:0";
 <COND> ::= (<A> ≤ <B>) AND <COND,C> ::= LOCAL AND IN "NOT(A LE B)=>GO TO AND;C;AND:0";

# U+2265, GE: THE RULES OF SYNTAX.IMC THAT TAKE A RELATION, ONE FOR EACH, WITH THE SYMBOL WHERE THE RULE HAS <RELOP> AND GE IN THE MACRO (A RELATION IS NOT A WORD THAT THE TABLE OF RELATIONS COULD JUST GET: THE PATTERNS OF THE CONDITIONAL STATEMENTS NAME THE ASCII WORDS) #
 <ST>   ::= <EXP,A> ≥ <EXP,B> ::= "A GE B";
 <ST>   ::= <EXP,A> ≥ <EXP,B> => <ST,C> ::= "A GE B => C";
 <ST>   ::= <EXP,A> ≥ <EXP,B> => <ST,C> ELSE <ST,D> ::= "A GE B => C ELSE D";
 <ST>   ::= WHILE <EXP,A> ≥ <EXP,B> DO <ST,C> ::= "WHILE A GE B DO C";
 <ST>   ::= <EXP,A> UNTIL <B> ≥ <C> ::= "A UNTIL B GE C";
 <COND> ::= (<A> ≥ <B>) ::= LOCAL CND IN "A GE B=>GO TO CND[1]; CND:0";
 <COND> ::= (<A> ≥ <B>) OR <COND,C> ::= LOCAL OR IN "A GE B=>GO TO OR[1];C;OR:0";
 <COND> ::= (<A> ≥ <B>) AND <COND,C> ::= LOCAL AND IN "NOT(A GE B)=>GO TO AND;C;AND:0";

# U+2260, NE: THE RULES OF SYNTAX.IMC THAT TAKE A RELATION, ONE FOR EACH, WITH THE SYMBOL WHERE THE RULE HAS <RELOP> AND NE IN THE MACRO (A RELATION IS NOT A WORD THAT THE TABLE OF RELATIONS COULD JUST GET: THE PATTERNS OF THE CONDITIONAL STATEMENTS NAME THE ASCII WORDS) #
 <ST>   ::= <EXP,A> ≠ <EXP,B> ::= "A NE B";
 <ST>   ::= <EXP,A> ≠ <EXP,B> => <ST,C> ::= "A NE B => C";
 <ST>   ::= <EXP,A> ≠ <EXP,B> => <ST,C> ELSE <ST,D> ::= "A NE B => C ELSE D";
 <ST>   ::= WHILE <EXP,A> ≠ <EXP,B> DO <ST,C> ::= "WHILE A NE B DO C";
 <ST>   ::= <EXP,A> UNTIL <B> ≠ <C> ::= "A UNTIL B NE C";
 <COND> ::= (<A> ≠ <B>) ::= LOCAL CND IN "A NE B=>GO TO CND[1]; CND:0";
 <COND> ::= (<A> ≠ <B>) OR <COND,C> ::= LOCAL OR IN "A NE B=>GO TO OR[1];C;OR:0";
 <COND> ::= (<A> ≠ <B>) AND <COND,C> ::= LOCAL AND IN "NOT(A NE B)=>GO TO AND;C;AND:0";

<EXP> ::= <ATOM,A> ∨ <EXP,B> ::= "A OR B";                     # U+2228, OR #
<EXP> ::= <ATOM,A> ∧ <EXP,B> ::= "A AND B";                    # U+2227, AND #
<ATOM> ::= ¬ <ATOM,A> ::= "NOT A";                             # U+00AC, NOT #
<EXP> ::= <VBL,A> ← <EXP,B> ::= "A:=B"%%                       # U+2190, := #
