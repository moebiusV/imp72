#THIS IS FILE IMPSIX, THE ORIGINAL'S FUNCTIONS THAT CONVERT BETWEEN ASCII, SIXBIT AND RADIX 50 (SIXBIT, ASCII, RAD50, RADX50, ASCI50, SIX50), WRITTEN FOR A WORD OF 64 BITS AND A STRING OF BYTES.  A SIXBIT WORD IS SIX CHARACTERS OF 6 BITS, THE FIRST IN THE HIGH END OF THE LOW 36 BITS: THE VALUE THE PDP-10 HAD, IN THE LOW 36 BITS OF THE WORD.  A SIXBIT
 CHARACTER IS THE ASCII CODE MINUS 40B (THE CHARACTERS 40B TO 137B; A LOWER CASE LETTER IS TAKEN FOR ITS CAPITAL, ANOTHER CHARACTER FOR A BLANK).  A RADIX 50 SYMBOL IS SIX CHARACTERS OF THE 40 BLANK, 0-9, A-Z, ., $ AND %, THE FIRST THE MOST SIGNIFICANT, IN A NUMBER OF 32 BITS, AND FOUR CODE BITS ABOVE IT (BITS 32 TO 35, WHERE THE PDP-10 HAD THEM AT THE LEFT END
 OF THE WORD).  A STRING IS A WORD OF AT MOST EIGHT BYTES, THE FIRST IN THE LEAST SIGNIFICANT BYTE (A STRING CONSTANT OF AT MOST EIGHT CHARACTERS IS THAT WORD), SO THAT ASCII, WHICH GIVES THE ORIGINAL'S TWO WORDS OF FIVE CHARACTERS (THE SECOND IN REGISTER 1R), GIVES ONE WORD OF SIX BYTES.  THE SECOND ARGUMENT OF RAD50, RADX50, ASCI50 AND SIX50, THE CODE BITS, IS NOT
 OPTIONAL HERE (A MISSING ARGUMENT CANNOT BE TOLD FROM ONE THAT IS THERE): GIVE 0 TO RAD50 AND RADX50 FOR NONE, AND A VARIABLE TO ASCI50 AND SIX50, WHICH SET IT.#

# THE SIXBIT CODE OF THE CHARACTER C #
SUBR SXCODE(CH) IS (
 C ARE LOCAL;
 C:=CH;
 C GE 141B => (C LE 172B => C:=C-40B);
 C LT 40B => RETURN 0;
 C GT 137B => RETURN 0;
 C-40B);

# THE ASCII CODE OF THE SIXBIT CODE S #
SUBR SXASC(S) IS (S+40B);

SUBR SIXBIT(STG) IS (
 W,V,I,C ARE LOCAL;
 W:=STG;
 V:=0; I:=0;
 SB1: I<6 => (C:=(W RS (8*I)) AND 377B;
              C=0 => GO TO SB2;
              V:=V OR (SXCODE(C) LS (30-(6*I)));
              I:=I+1; GO TO SB1);
 SB2: V);

SUBR ASCII(SIXB) IS (
 W,V,I ARE LOCAL;
 W:=SIXB;
 V:=0; I:=0;
 AS1: I<6 => (V:=V OR (SXASC((W RS (30-(6*I))) AND 77B) LS (8*I)); I:=I+1; GO TO AS1);
 V);

# THE RADIX 50 DIGIT OF THE ASCII CHARACTER C: BLANK 0, 0-9 1-10, A-Z 11-36, . 37, $ 38, % 39 (A LOWER CASE LETTER IS TAKEN FOR ITS CAPITAL, ANOTHER CHARACTER FOR A BLANK) #
SUBR R50DIG(CH) IS (
 C ARE LOCAL;
 C:=CH;
 C GE 141B => (C LE 172B => C:=C-40B);
 C=56B => RETURN 37;
 C=44B => RETURN 38;
 C=45B => RETURN 39;
 C GE 60B => (C LE 71B => RETURN (C-60B)+1);
 C GE 101B => (C LE 132B => RETURN (C-101B)+11);
 0);

# THE ASCII CHARACTER OF THE RADIX 50 DIGIT D #
SUBR R50CHR(D) IS (
 X ARE LOCAL;
 X:=D;
 X=0 => RETURN 40B;
 X LE 10 => RETURN (X-1)+60B;
 X LE 36 => RETURN (X-11)+101B;
 X=37 => RETURN 56B;
 X=38 => RETURN 44B;
 45B);

SUBR RAD50(STG,BITS) IS (
 W,B,V,I,C ARE LOCAL;
 W:=STG; B:=BITS;
 V:=0; I:=0;
 R51: I<6 => (C:=(W RS (8*I)) AND 377B;
              C=0 => GO TO R52;
              V:=(V*40)+R50DIG(C); I:=I+1; GO TO R51);
 R52: I<6 => (V:=V*40; I:=I+1; GO TO R52);
 V OR ((B AND 17B) LS 32));

SUBR RADX50(SIXB,BITS) IS (
 W,B,V,I ARE LOCAL;
 W:=SIXB; B:=BITS;
 V:=0; I:=0;
 RX1: I<6 => (V:=(V*40)+R50DIG(SXASC((W RS (30-(6*I))) AND 77B)); I:=I+1; GO TO RX1);
 V OR ((B AND 17B) LS 32));

# THE ASCII STRING OF THE RADIX 50 SYMBOL R50 (THE CODE BITS GO TO BITS), AND THE SAME AS A SIXBIT WORD #
SUBR ASCI50(R50,BITS) IS (
 R,I,V,D,P ARE LOCAL;
 R:=R50 AND 4294967295;
 BITS:=(R50 RS 32) AND 17B;
 V:=0; I:=5;
 A51: I GE 0 => (D:=R-((R/40)*40); R:=R/40; V:=V OR (R50CHR(D) LS (8*I)); I:=I-1; GO TO A51);
 V);

SUBR SIX50(R50,BITS) IS (
 R,I,V,D ARE LOCAL;
 R:=R50 AND 4294967295;
 BITS:=(R50 RS 32) AND 17B;
 V:=0; I:=5;
 S51: I GE 0 => (D:=R-((R/40)*40); R:=R/40; V:=V OR (SXCODE(R50CHR(D)) LS (30-(6*I))); I:=I-1; GO TO S51);
 V)
%%
