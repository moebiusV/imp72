TWOSEG;
#THIS IS FILE IMP72RT, THE REST OF THE RUNTIME OF THE PROGRAMS IMP72 COMPILES, IN IMP (IT WAS C, LIB/IMP72RT.C): THE MONITOR CALLS THE COMPILER'S OWN SOURCES MAKE (CALLI), BLT, IFIX, THE SHIFTS AND ROTATION OF A WORD BY A
 VARIABLE COUNT, THE BYTE POINTERS, AND EXECUTE.  THE ROUTINES HAVE THE NAMES THE COMPILERS GIVE THEIR CALLS (IMP_CALLI AND THE REST: AN IMP NAME HAS NO UNDERSCORE, SO THEY ARE IMPCALLI ... HERE, AND TOOLS/MKLIB.SH GIVES
 THEM THEIR NAMES).  A CALL IS BY REFERENCE, AS FOR ANY IMP ROUTINE: THE COMPILERS STORE THE ARGUMENTS IN THE CELLS IMP_CA AND PASS THEIR ADDRESSES.  THE DATA THE CALLS SHARE WITH THE COMPILED CODE (IMP_AC, IMP_XW, IMP_BPP
 AND IMP_BPV) ARE HERE AS WELL.  THIS FILE IS COMPILED BY THE SEED (STAGE0/IMP72STAGE0), WHICH TRANSLATES THE SHIFTS BY A COUNT OF THE VARIABLES INLINE, SO THE ROUTINES MAY USE THEM.#

IMPAC IS COMMON,16 LONG;                           # IMP_AC: THE ACCUMULATORS OF EXECUTE #
IMPXW,IMPBPP,IMPBPV ARE COMMON;                    # IMP_XW: THE WORD EXECUTE RUNS; IMP_BPP AND IMP_BPV: THE BYTE POINTER AND THE BYTE OF IBP, LDB AND DPB #
IMPCA IS COMMON,4 LONG;                            # IMP_CA: THE ARGUMENTS OF A CALL #
TMB IS 8 LONG;
TT IS 2 LONG;

# THE FIELDS OF THE LOCAL TIME BY STRFTIME: 'Y M D H M S' IN TMB #
SUBR RTLNOW(Z) IS (
 T ARE LOCAL;
 TT[0]_CCALL TIME(0);
 T_CCALL LOCALTIME(LOC(TT));
 T=0 => RETURN 0;
 CCALL STRFTIME(LOC(TMB),60,LOC('%Y %m %d %H %M %S'),T);
 1);

# THE FIELD I (0 TO 5) OF THE TEXT IN TMB #
SUBR RTLTFLD(I) IS (
 K,Q,C,SK,V ARE LOCAL;
 Q_BYTEP TMB<7,36>; SK_0; V_0;
 RF1: C_<+Q>; C=0 => RETURN V;
      C=32 => (SK=I => RETURN V; SK_SK+1; V_0; GO TO RF1);
      V_(V*10)+(C-60B);
      GO TO RF1);

# CALLI(CODE,AC): THE TOPS-10 MONITOR CALLS THE COMPILER'S SOURCES MAKE.  0 RESET, 012 EXIT, 014 DATE, 023 TIME OF DAY IN MS, 024 AND 030 JOB IDENTIFICATION, 027 RUN TIME IN MS; THE OTHERS DO NOTHING #
SUBR IMPCALLI(CODE,AC) IS (
 CODE=10 => (CCALL FFLUSH(CCALL IMPSTDOUT(0)); CCALL EXIT(0));
 CODE=12 => (RTLNOW(0)=0 => RETURN 0;                          # THE DATE, AS THE MONITOR GIVES IT: ((YEAR-1964)*12 + MONTH-1)*31 + DAY-1 #
             RETURN (((RTLTFLD(0)-1964)*12)+(RTLTFLD(1)-1))*31+(RTLTFLD(2)-1));
 CODE=19 => (RTLNOW(0)=0 => RETURN 0;
             RETURN ((((RTLTFLD(3)*60)+RTLTFLD(4))*60)+RTLTFLD(5))*1000);
 CODE=23 => RETURN CCALL CLOCK(0)/1000;
 CODE=24 => RETURN 1;
 0);

# BLT: COPY BYTES BYTES FROM SRC TO DST, A WORD AT A TIME UPWARD AS THE PDP-10 DOES: WHEN THE RANGES OVERLAP WITH DST ABOVE SRC THE WORDS COPIED ARE THE WORDS ALREADY COPIED (A WORD STORED AND BLT'D THROUGH AN
  ARRAY FILLS IT; MEMMOVE WOULD NOT) #
SUBR IMPBLT(DST,SRC,BYTES) IS (
 I ARE LOCAL;
 I_0;
 BL1: I GE BYTES => RETURN 0;
      [DST+I]_[SRC+I]; I_I+8; GO TO BL1);

# IFIX(X): A REAL TO AN INTEGER, TRUNCATING (THE LIBRARY ROUTINE THE ORIGINAL REACHES AS MALAMUD).  THE ARGUMENT IS THE ADDRESS OF THE REAL, WHICH IS THE BITS OF AN IEEE DOUBLE.  A VALUE TOO BIG IS THE
  LEAST INTEGER, AS THE MACHINE GIVES IT; THE ROUTINE CANNOT USE FIX #
SUBR IFIX(X) IS (
 B,E,M,NG,U,V ARE LOCAL;
 B_X; NG_(B<0 => 1 ELSE 0);
 E_(B RS 52) AND 2047;
 E<1023 => RETURN 0;                                           # LESS THAN 1 #
 U_E-1023;
 U>62 => RETURN 0-9223372036854775807-1;
 M_(B AND 4503599627370495) OR 4503599627370496;
 U<52 => V_M RS (52-U) ELSE V_M LS (U-52);
 NG NE 0 => 0-V ELSE V);

# THE SHIFTS AND THE ROTATION OF A WORD BY A VARIABLE COUNT (THE CODE GENERATOR OF SRC/PCCIR CALLS THEM): A POSITIVE COUNT IS TO THE LEFT, A NEGATIVE ONE TO THE RIGHT; A LOGICAL SHIFT OF 64 PLACES OR MORE GIVES 0.  THE
  ARGUMENTS AND THE RESULT ARE THE ADDRESSES OF 64 BIT WORDS #
SUBR IMPLSH(PX,PN,PR) IS (
 X,N,NEG64 ARE LOCAL;
 X_PX; N_PN; NEG64_0-64;
 N GE 64 => (PR_0; RETURN 0);
 N LE NEG64 => (PR_0; RETURN 0);
 N GE 0 => PR_X LS N ELSE PR_X RS (0-N);
 0);

SUBR IMPASH(PX,PN,PR) IS (
 X,N,NEG64 ARE LOCAL;
 X_PX; N_PN; NEG64_0-64;
 N GE 64 => (PR_0; RETURN 0);
 N GE 0 => (PR_X LS N; RETURN 0);
 N LE NEG64 => N_0-63;
 PR_X ARS (0-N);
 0);

SUBR IMPROT(PX,PN,PR) IS (
 X,N ARE LOCAL;
 X_PX; N_PN AND 63;
 N=0 => (PR_X; RETURN 0);
 PR_(X LS N) OR (X RS (64-N));
 0);

# BYTE POINTERS.  A POINTER TO CHARACTERS (THE TAPE'S BYTEP A<7,36>) IS A BYTE ADDRESS: IBP ADDS 1, LDB READS THE BYTE THERE, DPB WRITES THE LOW 8 BITS OF THE VALUE TO IT (A CHARACTER IS A BYTE, UTF-8).  ANY OTHER POINTER
  NAMES A BIT FIELD AND KEEPS THE LAYOUT OF THE PDP-10'S, IN ONE WORD: BITS 63-58 THE SIZE, 57-52 THE POSITION (THE LOW BIT OF THE FIELD, COUNTED FROM THE RIGHT), THE REST THE BYTE ADDRESS OF THE WORD; IBP MOVES TO THE NEXT
  LOWER FIELD OF THE SAME SIZE, OR TO THE NEXT WORD.  A BYTE ADDRESS IS BELOW 2**47, SO THE SIZE BITS TELL THE TWO APART.  THE POINTER IS IN IMP_BPP AND THE BYTE IN IMP_BPV #
SUBR IMPIBP(Z) IS (
 P,SZ,POS,NP ARE LOCAL;
 P_IMPBPP; (P RS 32)=4294967295 => P_P AND 4294967295;       # A 32 BIT ADDRESS THAT A CCALL SIGN EXTENDED IS THE ADDRESS, NOT A FIELD #
 SZ_P RS 58; POS_(P RS 52) AND 63;
 SZ=0 => (IMPBPP_P+1; RETURN 0);
 NP_POS-SZ;
 NP<0 => (NP_64-SZ; P_P+8);
 IMPBPP_(P AND (NOT (63 LS 52))) OR (NP LS 52);
 0);

SUBR IMPLDB(Z) IS (
 P,SZ,POS,MK ARE LOCAL;
 P_IMPBPP; (P RS 32)=4294967295 => P_P AND 4294967295;       # A 32 BIT ADDRESS THAT A CCALL SIGN EXTENDED IS THE ADDRESS, NOT A FIELD #
 SZ_P RS 58; POS_(P RS 52) AND 63;
 SZ=0 => (IMPBPV_RTLRB(P,0); RETURN 0);
 SZ GE 64 => MK_0-1 ELSE MK_(1 LS SZ)-1;
 IMPBPV_([P AND 4503599627370495] RS POS) AND MK;
 0);

SUBR IMPDPB(Z) IS (
 P,SZ,POS,MK,AD,V ARE LOCAL;
 P_IMPBPP; (P RS 32)=4294967295 => P_P AND 4294967295;       # A 32 BIT ADDRESS THAT A CCALL SIGN EXTENDED IS THE ADDRESS, NOT A FIELD #
 SZ_P RS 58; POS_(P RS 52) AND 63;
 SZ=0 => (RTLWB(P,0,IMPBPV AND 255); RETURN 0);
 SZ GE 64 => MK_0-1 ELSE MK_(1 LS SZ)-1;
 MK_MK LS POS;
 AD_P AND 4503599627370495;
 V_[AD];
 [AD]_(V AND (NOT MK)) OR ((IMPBPV LS POS) AND MK);
 0);

# MOVE B THROUGH N TO A: N+1 WORDS FROM B TO A, ASCENDING, AS BLT DOES (THE ARGUMENTS ARE POINTERS) #
SUBR IMPBLK(A,B,N) IS (
 I,AD,BD ARE LOCAL;
 AD_LOC(A); BD_LOC(B);
 I_0;
 BK1: I GE (N+1) => RETURN 0;
      [AD+(8*I)]_[BD+(8*I)]; I_I+1; GO TO BK1);

# EXECUTE: IMP_XCT() DOES THE ONE INSTRUCTION OF THE PCC IR MACHINE (DOCS/PORTING/PCCIR-MACHINE.MD) THAT THE WORD IMP_XW HOLDS, THE WAY THE COMPILED PROGRAM WOULD HAVE DONE IT WHERE IT STANDS.  AN INSTRUCTION WORD HAS THE
  OPERATION IN BITS 56-63 (THE NUMBERS OF THE MACHINE: 1 LOAD, 2 NEG, 3 COMPL, 4 ADDR, 5 STORE, 6 ADD ... 20 EQV, 21 LSH, 22 ASH, 23 ROT, 28 ADDX, 64 CALLI), THE ACCUMULATOR IN BITS 52-55, THE INDEX REGISTER IN BITS 48-51, BIT
  47 SET FOR AN IMMEDIATE OPERAND, AND IN BITS 0-46 THE ADDRESS OR THE NUMBER (SIGNED).  THE ACCUMULATORS ARE THE WORDS OF IMP_AC, WHICH THE COMPILED CODE FILLS FROM ITS REGISTERS 0R TO 15R BEFORE THE CALL AND READS BACK
  AFTER.  AS IN COMPILED CODE AN ADDRESS IS A BYTE ADDRESS: WITH AN INDEX REGISTER IT IS THAT REGISTER PLUS 8 TIMES THE ADDRESS FIELD (A WORD INDEX), WITHOUT ONE IT IS THE FIELD ITSELF; AN IMMEDIATE OPERAND IS THE FIELD PLUS
  THE INDEX REGISTER.  THE FLOATING POINT OPERATIONS AND THE JUMPS ARE NOT DONE: THEY NEED THE PROGRAM'S OWN REGISTERS AND TAGS #
SUBR IMPXCT(Z) IS (
 W,OP,A,X,F,V,R,M,IM,AA,NEG64 ARE LOCAL;
 W_IMPXW;
 OP_(W RS 56) AND 255; A_(W RS 52) AND 15; X_(W RS 48) AND 15;
 F_W AND 140737488355327;                         # BITS 0-46 #
 IM_(W RS 47) AND 1;
 F GE 70368744177664 => F_F-140737488355328;
 X NE 0 => M_IMPAC[X]+(8*F) ELSE M_F;
 IM NE 0 => (X NE 0 => V_F+IMPAC[X] ELSE V_F) ELSE (OP=4 => V_0 ELSE (OP=5 => V_0 ELSE V_[M]));
 AA_IMPAC[A];
 GO TO (XC0,XC1,XC2,XC3,XC4,XC5,XC6,XC7,XC8,XC9,XC10,XC11,XC12,XC13,XC14,XC15,XC16,XC17,XC18,XC19,XC20,XC21,XC22,XC23,XC0,XC0,XC0,XC0,XC28) OP;
 OP=64 => (IMPAC[A]_IMPCALLI(V,AA); RETURN 0);
 XC0: RTLERRS(LOC('EXECUTE: THE OPERATION OF THE MACHINE CANNOT BE DONE FROM A WORD')); RTLERRNL(0); CCALL EXIT(1);
 XC1: IMPAC[A]_V; RETURN 0;
 XC2: IMPAC[A]_0-V; RETURN 0;
 XC3: IMPAC[A]_NOT V; RETURN 0;
 XC4: IMPAC[A]_M; RETURN 0;
 XC5: [M]_AA; RETURN 0;
 XC6: IMPAC[A]_AA+V; RETURN 0;
 XC7: IMPAC[A]_AA-V; RETURN 0;
 XC8: IMPAC[A]_AA*V; RETURN 0;
 XC9: V NE 0 => IMPAC[A]_AA/V ELSE IMPAC[A]_0; RETURN 0;
 XC10: V NE 0 => IMPAC[A]_AA-((AA/V)*V) ELSE IMPAC[A]_0; RETURN 0;
 XC11: IMPAC[A]_AA AND V; RETURN 0;
 XC12: IMPAC[A]_(NOT AA) AND V; RETURN 0;
 XC13: IMPAC[A]_AA AND (NOT V); RETURN 0;
 XC14: IMPAC[A]_(NOT AA) AND (NOT V); RETURN 0;
 XC15: IMPAC[A]_AA OR V; RETURN 0;
 XC16: IMPAC[A]_(NOT AA) OR V; RETURN 0;
 XC17: IMPAC[A]_AA OR (NOT V); RETURN 0;
 XC18: IMPAC[A]_(NOT AA) OR (NOT V); RETURN 0;
 XC19: IMPAC[A]_AA XOR V; RETURN 0;
 XC20: IMPAC[A]_NOT (AA XOR V); RETURN 0;
 XC21: R_V; GO TO XSH;
 XC22: R_V; GO TO XSH;
 XSH: NEG64_0-64;
      R GE 64 => GO TO XSH0;
      R LE NEG64 => GO TO XSH0;
      R GE 0 => (IMPAC[A]_AA LS R; RETURN 0);
      OP=22 => (IMPAC[A]_AA ARS (0-R); RETURN 0);
      IMPAC[A]_AA RS (0-R); RETURN 0;
 XSH0: IMPAC[A]_0;
       OP=22 => R<0 => AA<0 => IMPAC[A]_0-1;
       RETURN 0;
 XC23: R_V-((V/64)*64); R<0 => R_R+64;
       R=0 => RETURN 0;
       IMPAC[A]_(AA LS R) OR (AA RS (64-R)); RETURN 0;
 XC28: IMPAC[A]_AA+(8*V); RETURN 0);

%%
