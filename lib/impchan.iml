TWOSEG;
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
#THIS IS FILE IMPCHAN, THE CHANNEL INPUT AND OUTPUT OF TOPS-10 THAT THE ORIGINAL'S PROGRAMS CALL AS ROUTINES (INIT, LOOKUP, ENTER, INPUT, OUTPUT, CLOSE, RENAME, RELEAS), OVER THE C LIBRARY'S FILES.  THE ORIGINAL'S ARE THE MONITOR'S OWN CALLS: A CHANNEL IS
 A NUMBER, THE PROGRAM GIVES THE MONITOR A RING OF BUFFERS AND A HEADER (A RING POINTER, A BYTE POINTER AND A COUNT), THE MONITOR FILLS OR EMPTIES A BUFFER AT INPUT OR OUTPUT, AND THE PROGRAM READS OR WRITES THE BYTES ITSELF THROUGH THE POINTER, COUNTING.
 HERE A CHANNEL IS 0 TO 15 AND HAS ONE BUFFER OF 1024 BYTES OF THE LIBRARY'S, WHATEVER RING THE PROGRAM BUILT (THE ORIGINAL'S RING LINKS ARE 18 BIT ADDRESSES).  THE HEADER IS THREE WORDS: THE ADDRESS OF THE BUFFER, THE BYTE POINTER (THE ADDRESS OF THE BYTE BEFORE THE NEXT ONE, FOR A BYTE IS TAKEN WITH THE POINTER ADVANCED FIRST, <+P>, AS THE PDP-10'S ILDB AND IDPB DO), AND THE
 COUNT, THE BYTES LEFT TO READ OR THE ROOM LEFT TO WRITE.  A PROGRAM READS WITH THE COUNT DECREMENTED BEFORE EACH BYTE, CALLING INPUT WHEN IT IS 0 OR LESS (AS THE LEXER OF THE ORIGINAL DOES), AND WRITES BYTES WITH THE POINTER ADVANCED AND THE COUNT
 DECREMENTED, CALLING OUTPUT WHEN IT IS FULL.  NAMES ARE STRINGS (THE EXTENSION IS ADDED AFTER A DOT), AND THE DEVICES ARE DSK (THE FILE SYSTEM) AND TTY (THE STANDARD FILES).  A ROUTINE RETURNS 0 FOR SUCCESS, AS THE ORIGINAL'S LOOKUP, ENTER AND INPUT ARE TRUE
 FOR A FAILURE OR THE END OF THE FILE.  NOT PROVIDED: DUMP MODE (A COMMAND LIST), BINARY MODE, THE OTHER DEVICES, USETI AND USETO, AND THE STATUS BITS.  THE MODE IS KEPT AND NOT USED: A TEXT IS BYTES (UTF-8) IN EVERY MODE.#

CHF,CHM,CHO,CHI,CHD,CHB,CHT,CHN ARE 16 LONG;    # PER CHANNEL: THE FILE (0 IF NONE), THE MODE, THE OUTPUT AND THE INPUT HEADER, THE DIRECTION (1 INPUT, 2 OUTPUT), THE BUFFER, THE DEVICE (1 DSK, 2 TTY, 0 NO INIT), THE NAME #
CHP IS 548 LONG;                                  # A FILE NAME: NAME.EXT, 4384 BYTES #

# CHPATH(NM,EX): THE FILE NAME NAME.EXT IN CHP (NAME ALONE IF THE EXTENSION IS EMPTY) #
SUBR CHPATH(NM,EX) IS (
 CCALL strlen(LOC(EX))=0 => CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC(NM))
   ELSE CCALL snprintf(LOC(CHP),4384,LOC('%s.%s'),LOC(NM),LOC(EX));
 0);

# CHFREE(CH): THE FILE OF CHANNEL CH IS CLOSED (THE STANDARD FILES ARE NOT) AND ITS BUFFER AND NAME ARE FREED #
SUBR CHFREE(CH) IS (
 CHF[CH] NE 0 => CHT[CH]=1 => CCALL fclose(CHF[CH]);
 CHF[CH]:=0; CHD[CH]:=0;
 CHB[CH] NE 0 => (CCALL free(CHB[CH]); CHB[CH]:=0);
 CHN[CH] NE 0 => (CCALL free(CHN[CH]); CHN[CH]:=0);
 0);

# CHHEAD(CH,K,V): WORD K OF THE HEADER OF THE DIRECTION THE CHANNEL IS OPEN FOR (0 THE BUFFER, 1 THE BYTE POINTER, 2 THE COUNT) IS V #
SUBR CHHEAD(CH,K,V) IS (
 H,KK ARE LOCAL;
 CHD[CH]=1 => H:=CHI[CH] ELSE H:=CHO[CH];
 KK:=K;
 [H+(8*KK)]:=V;
 0);

# CHOPEN(CH,D,F): THE FILE F, OPENED IN THE DIRECTION D (1 INPUT, 2 OUTPUT) ON CHANNEL CH, WITH ITS BUFFER AND ITS HEADER MADE: THE BYTE POINTER BEFORE THE START, THE COUNT 0 FOR INPUT AND THE WHOLE BUFFER FOR OUTPUT #
SUBR CHOPEN(CH,D,F) IS (
 DD ARE LOCAL;
 DD:=D;
 CHF[CH]:=F; CHD[CH]:=DD;
 CHB[CH]:=CCALL malloc(1024);
 CHB[CH]=0 => (CHFREE(CH); RETURN 1);
 CHN[CH]:=CCALL strdup(LOC(CHP));
 CHHEAD(CH,0,CHB[CH]); CHHEAD(CH,1,CHB[CH]-1);
 DD=1 => CHHEAD(CH,2,0) ELSE CHHEAD(CH,2,1024);
 0);

# INIT(CH,MODE,DEV,OHDR,IHDR): THE CHANNEL CH FOR THE DEVICE DEV WITH THE HEADERS OHDR (OUTPUT) AND IHDR (INPUT); THE ORIGINAL PASSES '0' FOR THE ONE IT DOES NOT USE.  1 FOR A DEVICE THAT IS NOT HERE #
SUBR INIT(CH,MODE,DEV,OHDR,IHDR) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]:=0;
 (CCALL strncmp(LOC(DEV),LOC('DSK'),3) AND 4294967295)=0 => CHT[CHA]:=1;
 (CCALL strncmp(LOC(DEV),LOC('TTY'),3) AND 4294967295)=0 => CHT[CHA]:=2;
 CHT[CHA]=0 => RETURN 1;
 CHM[CHA]:=MODE; CHO[CHA]:=LOC(OHDR); CHI[CHA]:=LOC(IHDR);
 0);

# LOOKUP(CH,NAME,EXT,X,Y): THE FILE NAME.EXT OPENED FOR INPUT ON CH; 1 IF IT IS NOT THERE (THE ORIGINAL'S X AND Y ARE ITS DATE, PROTECTION AND PROJECT-PROGRAMMER NUMBER: NOT USED) #
SUBR LOOKUP(CH,NM,EX,X,Y) IS (
 CHA,F ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHT[CHA]=0 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]=2 => (F:=IMPSTDIN(0); CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC('TTY'))) ELSE (CHPATH(NM,EX); F:=CCALL fopen(LOC(CHP),LOC('r')); F=0 => RETURN 1);
 CHOPEN(CHA,1,F));

# ENTER(CH,NAME,EXT,X,Y): THE FILE NAME.EXT MADE FOR OUTPUT ON CH (AN OLD ONE OF THE NAME IS REPLACED); 1 IF IT CANNOT BE #
SUBR ENTER(CH,NM,EX,X,Y) IS (
 CHA,F ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHT[CHA]=0 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]=2 => (F:=IMPSTDOUT(0); CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC('TTY'))) ELSE (CHPATH(NM,EX); F:=CCALL fopen(LOC(CHP),LOC('w')); F=0 => RETURN 1);
 CHOPEN(CHA,2,F));

# INPUT(CH,LIST): THE NEXT BUFFER OF THE FILE OF CH IS READ (A LINE FROM THE TERMINAL), THE BYTE POINTER BACK BEFORE THE START OF THE BUFFER AND THE COUNT THE BYTES READ; 1 AT THE END OF THE FILE OR IF THE CHANNEL IS NOT OPEN FOR INPUT (A LIST IS THE ORIGINAL'S DUMP MODE: NOT USED) #
SUBR INPUT(CH,LS) IS (
 CHA,N ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHD[CHA] NE 1 => RETURN 1;
 CHT[CHA]=2 => (CCALL fgets(CHB[CHA],1024,CHF[CHA])=0 => RETURN 1;
                N:=CCALL strlen(CHB[CHA]))
   ELSE N:=CCALL fread(CHB[CHA],1,1024,CHF[CHA]);
 CHHEAD(CHA,1,CHB[CHA]-1); CHHEAD(CHA,2,N);
 N=0 => RETURN 1;
 0);

# OUTPUT(CH,LIST): THE BYTES THE PROGRAM HAS STORED IN THE BUFFER OF CH, FROM THE BUFFER TO THE BYTE POINTER, ARE WRITTEN, AND THE BUFFER IS EMPTY; 1 IF THE CHANNEL IS NOT OPEN FOR OUTPUT OR THE WRITE FAILED #
SUBR OUTPUT(CH,LS) IS (
 CHA,H,N ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHD[CHA] NE 2 => RETURN 1;
 H:=CHO[CHA]; N:=[H+1]-(CHB[CHA]-1);                  # (THE SECOND WORD OF THE HEADER: A CONSTANT OFFSET IN BRACKETS IS WORDS) #
 N>0 => CCALL fwrite(CHB[CHA],1,N,CHF[CHA]) NE N => RETURN 1;
 CHT[CHA]=2 => CCALL fflush(CHF[CHA]);
 CHHEAD(CHA,1,CHB[CHA]-1); CHHEAD(CHA,2,1024);
 0);

# CLOSE(CH,BITS): WHAT THE PROGRAM STORED FOR OUTPUT IS WRITTEN AND THE FILE IS CLOSED, THE CHANNEL STAYS INITIALISED (THE ORIGINAL'S BITS ARE NOT USED) #
SUBR CLOSE(CH,BITS) IS (
 CHA,R ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 R:=0;
 CHD[CHA]=2 => R:=OUTPUT(CHA,0);
 CHFREE(CHA);
 R);

# RELEAS(CH): THE CHANNEL IS RELEASED: THE FILE IS CLOSED WITHOUT WRITING WHAT THE PROGRAM STORED, AND THE CHANNEL IS TO BE INITIALISED AGAIN #
SUBR RELEAS(CH) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHFREE(CHA);
 CHT[CHA]:=0;
 0);

# RENAME(CH,NAME,EXT,X,Y): THE FILE OF CH GETS THE NAME NAME.EXT; AN EMPTY NAME (THE ORIGINAL'S 0) DELETES IT; 1 IF IT CANNOT BE DONE #
SUBR RENAME(CH,NM,EX,X,Y) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHN[CHA]=0 => RETURN 1;
 CCALL strlen(LOC(NM))=0 => RETURN ((CCALL remove(CHN[CHA]) AND 4294967295) NE 0 => 1 ELSE 0);
 CHPATH(NM,EX);
 (CCALL rename(CHN[CHA],LOC(CHP)) AND 4294967295) NE 0 => RETURN 1;
 CCALL free(CHN[CHA]); CHN[CHA]:=CCALL strdup(LOC(CHP));
 0)
%%
