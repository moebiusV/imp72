TWOSEG;
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL PTR fopen(PTR, PTR);
EXTERNAL INT fclose(PTR);
EXTERNAL INT fflush(PTR);
EXTERNAL PTR fgets(PTR, INT, PTR);
EXTERNAL SIZE fread(PTR, SIZE, SIZE, PTR);
EXTERNAL SIZE fwrite(PTR, SIZE, SIZE, PTR);
EXTERNAL PTR malloc(SIZE);
EXTERNAL VOID free(PTR);
EXTERNAL PTR strdup(PTR);
EXTERNAL SIZE strlen(PTR);
EXTERNAL INT strncmp(PTR, PTR, SIZE);
EXTERNAL INT remove(PTR);
EXTERNAL INT rename(PTR, PTR);
EXTERNAL INT fseek(PTR, LONG, INT);
#THIS IS FILE IMPCHAN, THE CHANNEL INPUT AND OUTPUT OF TOPS-10 THAT THE ORIGINAL'S PROGRAMS CALL AS ROUTINES (INIT, LOOKUP, ENTER, INPUT, OUTPUT, CLOSE, RENAME, RELEAS), OVER THE C LIBRARY'S FILES.  THE ORIGINAL'S ARE THE MONITOR'S OWN CALLS: A CHANNEL IS
 A NUMBER, THE PROGRAM GIVES THE MONITOR A RING OF BUFFERS AND A HEADER (A RING POINTER, A BYTE POINTER AND A COUNT), THE MONITOR FILLS OR EMPTIES A BUFFER AT INPUT OR OUTPUT, AND THE PROGRAM READS OR WRITES THE BYTES ITSELF THROUGH THE POINTER, COUNTING.
 HERE A CHANNEL IS 0 TO 15 AND HAS ONE BUFFER OF 1024 BYTES OF THE LIBRARY'S, WHATEVER RING THE PROGRAM BUILT (THE ORIGINAL'S RING LINKS ARE 18 BIT ADDRESSES).  THE HEADER IS THREE WORDS: THE ADDRESS OF THE BUFFER, THE BYTE POINTER (THE ADDRESS OF THE BYTE BEFORE THE NEXT ONE, FOR A BYTE IS TAKEN WITH THE POINTER ADVANCED FIRST, <+P>, AS THE PDP-10'S ILDB AND IDPB DO), AND THE
 COUNT, THE BYTES LEFT TO READ OR THE ROOM LEFT TO WRITE.  A PROGRAM READS WITH THE COUNT DECREMENTED BEFORE EACH BYTE, CALLING INPUT WHEN IT IS 0 OR LESS (AS THE LEXER OF THE ORIGINAL DOES), AND WRITES BYTES WITH THE POINTER ADVANCED AND THE COUNT
 DECREMENTED, CALLING OUTPUT WHEN IT IS FULL.  NAMES ARE STRINGS (THE EXTENSION IS ADDED AFTER A DOT), AND THE DEVICES ARE DSK (THE FILE SYSTEM) AND TTY (THE STANDARD FILES).  A ROUTINE RETURNS 0 FOR SUCCESS, AS THE ORIGINAL'S LOOKUP, ENTER AND INPUT ARE TRUE
 FOR A FAILURE OR THE END OF THE FILE.  ALSO PROVIDED: USETI AND USETO (A BLOCK IS THE 1024 BYTES OF THE BUFFER), THE STATUS OF A CHANNEL (GETSTS, SETSTS, STATZ, STATO; THE BITS ARE THOSE OF TOPS-10: IO.EOF 20000B AT THE END OF THE FILE, IO.DER 200000B FOR A FAILED TRANSFER), AND DUMP MODE (MODE 17B: INPUT AND OUTPUT TAKE A COMMAND LIST OF PAIRS COUNT, ADDRESS, ENDED BY A COUNT OF 0, AND MOVE THAT MANY WORDS OF 8 BYTES BETWEEN THE FILE AND MEMORY, WHERE THE ORIGINAL'S LIST HAS IOWD WORDS, WHOSE ADDRESS AND COUNT ARE 18 BITS).  NOT PROVIDED: BINARY MODE AND ITS CHECKSUMS, THE RING OF BUFFERS, THE OTHER DEVICES, AND THE DATE, PROTECTION AND PROJECT-PROGRAMMER WORDS OF LOOKUP, ENTER AND RENAME (A UNIX FILE HAS NONE OF THEM THAT A PROGRAM COULD SET).  THE MODE IS KEPT, AND USED FOR DUMP MODE ONLY: A TEXT IS BYTES (UTF-8) IN EVERY OTHER MODE.#

CHF,CHM,CHO,CHI,CHD,CHB,CHT,CHN,CHS ARE 16 LONG;    # PER CHANNEL: THE FILE (0 IF NONE), THE MODE, THE OUTPUT AND THE INPUT HEADER, THE DIRECTION (1 INPUT, 2 OUTPUT), THE BUFFER, THE DEVICE (1 DSK, 2 TTY, 0 NO INIT), THE NAME, THE STATUS #
CHP IS 548 LONG;                                  # A FILE NAME: NAME.EXT, 4384 BYTES #

# CHPATH(NM,EX): THE FILE NAME NAME.EXT IN CHP (NAME ALONE IF THE EXTENSION IS EMPTY) #
SUBR CHPATH(NM,EX) IS (
 CCALL strlen(LOC(EX))=0 => CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC(NM))
   ELSE CCALL snprintf(LOC(CHP),4384,LOC('%s.%s'),LOC(NM),LOC(EX));
 0);

# CHFREE(CH): THE FILE OF CHANNEL CH IS CLOSED (THE STANDARD FILES ARE NOT) AND ITS BUFFER AND NAME ARE FREED #
SUBR CHFREE(CH) IS (
 CHF[CH] NE 0 => CHT[CH]=1 => CCALL fclose(CHF[CH]);
 CHF[CH]:=0; CHD[CH]:=0; CHS[CH]:=0;
 CHB[CH] NE 0 => (CCALL free(CHB[CH]); CHB[CH]:=0);
 CHN[CH] NE 0 => (CCALL free(CHN[CH]); CHN[CH]:=0);
 0);

# CHHEAD(CH,K,V): WORD K OF THE HEADER OF THE DIRECTION THE CHANNEL IS OPEN FOR (0 THE BUFFER, 1 THE BYTE POINTER, 2 THE COUNT) IS V #
SUBR CHHEAD(CH,K,V) IS (
 H,KK ARE LOCAL;
 CHD[CH]=1 => H:=CHI[CH] ELSE H:=CHO[CH];
 KK:=K;
 [H+(8*KK)]:=V;
 0);

# CHOPEN(CH,D,F): THE FILE F, OPENED IN THE DIRECTION D (1 INPUT, 2 OUTPUT) ON CHANNEL CH, WITH ITS BUFFER AND ITS HEADER MADE: THE BYTE POINTER BEFORE THE START, THE COUNT 0 FOR INPUT AND THE WHOLE BUFFER FOR OUTPUT #
SUBR CHOPEN(CH,D,F) IS (
 DD ARE LOCAL;
 DD:=D;
 CHF[CH]:=F; CHD[CH]:=DD;
 CHB[CH]:=CCALL malloc(1024);
 CHB[CH]=0 => (CHFREE(CH); RETURN 1);
 CHN[CH]:=CCALL strdup(LOC(CHP));
 CHHEAD(CH,0,CHB[CH]); CHHEAD(CH,1,CHB[CH]-1);
 DD=1 => CHHEAD(CH,2,0) ELSE CHHEAD(CH,2,1024);
 0);

# INIT(CH,MODE,DEV,OHDR,IHDR): THE CHANNEL CH FOR THE DEVICE DEV WITH THE HEADERS OHDR (OUTPUT) AND IHDR (INPUT); THE ORIGINAL PASSES '0' FOR THE ONE IT DOES NOT USE.  1 FOR A DEVICE THAT IS NOT HERE #
SUBR INIT(CH,MODE,DEV,OHDR,IHDR) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]:=0;
 CCALL strncmp(LOC(DEV),LOC('DSK'),3)=0 => CHT[CHA]:=1;
 CCALL strncmp(LOC(DEV),LOC('TTY'),3)=0 => CHT[CHA]:=2;
 CHT[CHA]=0 => RETURN 1;
 CHM[CHA]:=MODE; CHO[CHA]:=LOC(OHDR); CHI[CHA]:=LOC(IHDR);
 0);

# LOOKUP(CH,NAME,EXT,X,Y): THE FILE NAME.EXT OPENED FOR INPUT ON CH; 1 IF IT IS NOT THERE (THE ORIGINAL'S X AND Y ARE ITS DATE, PROTECTION AND PROJECT-PROGRAMMER NUMBER: NOT USED) #
SUBR LOOKUP(CH,NM,EX,X,Y) IS (
 CHA,F ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHT[CHA]=0 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]=2 => (F:=IMPSTDIN(0); CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC('TTY'))) ELSE (CHPATH(NM,EX); F:=CCALL fopen(LOC(CHP),LOC('rb')); F=0 => RETURN 1);
 CHOPEN(CHA,1,F));

# ENTER(CH,NAME,EXT,X,Y): THE FILE NAME.EXT MADE FOR OUTPUT ON CH (AN OLD ONE OF THE NAME IS REPLACED); 1 IF IT CANNOT BE #
SUBR ENTER(CH,NM,EX,X,Y) IS (
 CHA,F ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHT[CHA]=0 => RETURN 1;
 CHF[CHA] NE 0 => CHFREE(CHA);
 CHT[CHA]=2 => (F:=IMPSTDOUT(0); CCALL snprintf(LOC(CHP),4384,LOC('%s'),LOC('TTY'))) ELSE (CHPATH(NM,EX); F:=CCALL fopen(LOC(CHP),LOC('wb')); F=0 => RETURN 1);
 CHOPEN(CHA,2,F));

# CHDUMP(CH,L,D): DUMP MODE: THE COMMAND LIST AT L, PAIRS (COUNT, ADDRESS) ENDED BY A COUNT OF 0, IS CARRIED OUT: COUNT WORDS OF 8 BYTES READ (D 1) INTO MEMORY AT THE ADDRESS OR WRITTEN (D 2) FROM IT; 1, AND THE STATUS SET, IF THE FILE ENDS OR THE TRANSFER FAILS #
SUBR CHDUMP(CH,L,D) IS (
 P,K,N,A,R ARE LOCAL;
 P:=L; K:=8;
 DU1: N:=[P]; N=0 => RETURN 0;
      A:=[P+K]; P:=P+16;
      D=1 => R:=CCALL fread(A,8,N,CHF[CH]) ELSE R:=CCALL fwrite(A,8,N,CHF[CH]);
      R NE N => (D=1 => CHS[CH]:=CHS[CH] OR 20000B ELSE CHS[CH]:=CHS[CH] OR 200000B; RETURN 1);
      GO TO DU1);

# USETI(CH,N) AND USETO(CH,N): THE NEXT INPUT (OUTPUT) IS BLOCK N OF THE FILE, A BLOCK BEING THE 1024 BYTES OF THE BUFFER AND THE FIRST BLOCK 1 (THE ORIGINAL'S 128 WORDS OF 36 BITS); WHAT THE PROGRAM HAS STORED FOR OUTPUT IS WRITTEN FIRST; 1 FOR A TERMINAL OR A CHANNEL NOT OPEN IN THAT DIRECTION #
SUBR CHUSET(CH,N,D) IS (
 B ARE LOCAL;
 CH<0 => RETURN 1;
 CH>15 => RETURN 1;
 CHD[CH] NE D => RETURN 1;
 CHT[CH] NE 1 => RETURN 1;
 N<1 => RETURN 1;
 D=2 => (CHM[CH] NE 17B => OUTPUT(CH,0));
 B:=N-1;
 CCALL fseek(CHF[CH],B*1024,0) NE 0 => RETURN 1;
 CHS[CH]:=CHS[CH] AND NOT 20000B;
 CHHEAD(CH,1,CHB[CH]-1);
 D=1 => CHHEAD(CH,2,0);
 0);
SUBR USETI(CH,N) IS (CA,NA ARE LOCAL; CA:=CH; NA:=N; CHUSET(CA,NA,1));
SUBR USETO(CH,N) IS (CA,NA ARE LOCAL; CA:=CH; NA:=N; CHUSET(CA,NA,2));

# THE STATUS OF A CHANNEL: GETSTS(CH) IS ITS BITS, SETSTS(CH,BITS) PUTS THEM THERE, STATZ(CH,MASK) IS 1 IF NONE OF THE BITS OF MASK IS SET AND STATO(CH,MASK) 1 IF SOME ARE (THE ORIGINAL'S INSTRUCTIONS SKIP; THESE RETURN THE TEST) #
SUBR GETSTS(CH) IS (CA ARE LOCAL; CA:=CH; CA<0 => RETURN 0; CA>15 => RETURN 0; CHS[CA]);
SUBR SETSTS(CH,BITS) IS (CA,BA ARE LOCAL; CA:=CH; BA:=BITS; CA<0 => RETURN 1; CA>15 => RETURN 1; CHS[CA]:=BA; 0);
SUBR STATZ(CH,M) IS (CA,MA ARE LOCAL; CA:=CH; MA:=M; CA<0 => RETURN 1; CA>15 => RETURN 1; (CHS[CA] AND MA)=0 => 1 ELSE 0);
SUBR STATO(CH,M) IS (CA,MA ARE LOCAL; CA:=CH; MA:=M; CA<0 => RETURN 0; CA>15 => RETURN 0; (CHS[CA] AND MA) NE 0 => 1 ELSE 0);

# INPUT(CH,LIST): THE NEXT BUFFER OF THE FILE OF CH IS READ (A LINE FROM THE TERMINAL), THE BYTE POINTER BACK BEFORE THE START OF THE BUFFER AND THE COUNT THE BYTES READ; 1 AT THE END OF THE FILE OR IF THE CHANNEL IS NOT OPEN FOR INPUT (A LIST IS THE ORIGINAL'S DUMP MODE: NOT USED) #
SUBR INPUT(CH,LS) IS (
 CHA,N ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHD[CHA] NE 1 => RETURN 1;
 CHF[CHA]=0 => RETURN 1;
 CHM[CHA]=17B => RETURN CHDUMP(CHA,LOC(LS),1);
 CHT[CHA]=2 => (CCALL fgets(CHB[CHA],1024,CHF[CHA])=0 => RETURN 1;
                N:=CCALL strlen(CHB[CHA]))
   ELSE N:=CCALL fread(CHB[CHA],1,1024,CHF[CHA]);
 CHHEAD(CHA,1,CHB[CHA]-1); CHHEAD(CHA,2,N);
 N=0 => (CHS[CHA]:=CHS[CHA] OR 20000B; RETURN 1);
 0);

# OUTPUT(CH,LIST): THE BYTES THE PROGRAM HAS STORED IN THE BUFFER OF CH, FROM THE BUFFER TO THE BYTE POINTER, ARE WRITTEN, AND THE BUFFER IS EMPTY; 1 IF THE CHANNEL IS NOT OPEN FOR OUTPUT OR THE WRITE FAILED #
SUBR OUTPUT(CH,LS) IS (
 CHA,H,N ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHD[CHA] NE 2 => RETURN 1;
 CHF[CHA]=0 => RETURN 1;
 CHM[CHA]=17B => RETURN CHDUMP(CHA,LOC(LS),2);
 H:=CHO[CHA]; N:=[H+1]-(CHB[CHA]-1);                  # (THE SECOND WORD OF THE HEADER: A CONSTANT OFFSET IN BRACKETS IS WORDS) #
 N>0 => CCALL fwrite(CHB[CHA],1,N,CHF[CHA]) NE N => (CHS[CHA]:=CHS[CHA] OR 200000B; RETURN 1);
 CHT[CHA]=2 => CCALL fflush(CHF[CHA]);
 CHHEAD(CHA,1,CHB[CHA]-1); CHHEAD(CHA,2,1024);
 0);

# CLOSE(CH,BITS): WHAT THE PROGRAM STORED FOR OUTPUT IS WRITTEN AND THE FILE IS CLOSED, THE CHANNEL STAYS INITIALISED (THE ORIGINAL'S BITS ARE NOT USED) #
SUBR CLOSE(CH,BITS) IS (
 CHA,R ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 R:=0;
 CHD[CHA]=2 => (CHM[CHA] NE 17B => R:=OUTPUT(CHA,0));
 CHFREE(CHA);
 R);

# RELEAS(CH): THE CHANNEL IS RELEASED: THE FILE IS CLOSED WITHOUT WRITING WHAT THE PROGRAM STORED, AND THE CHANNEL IS TO BE INITIALISED AGAIN #
SUBR RELEAS(CH) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHFREE(CHA);
 CHT[CHA]:=0;
 0);

# RENAME(CH,NAME,EXT,X,Y): THE FILE OF CH GETS THE NAME NAME.EXT; AN EMPTY NAME (THE ORIGINAL'S 0) DELETES IT; 1 IF IT CANNOT BE DONE #
SUBR RENAME(CH,NM,EX,X,Y) IS (
 CHA ARE LOCAL;
 CHA:=CH;
 CHA<0 => RETURN 1;
 CHA>15 => RETURN 1;
 CHN[CHA]=0 => RETURN 1;
 CHF[CHA] NE 0 => (CHT[CHA]=1 => CCALL fclose(CHF[CHA]); CHF[CHA]:=0);              # (A FILE THAT IS OPEN CANNOT BE DELETED OR RENAMED ON WINDOWS: IT IS CLOSED FIRST, AND THE CHANNEL IS DONE WITH) #
 CCALL strlen(LOC(NM))=0 => RETURN (CCALL remove(CHN[CHA]) NE 0 => 1 ELSE 0);
 CHPATH(NM,EX);
 CCALL rename(CHN[CHA],LOC(CHP)) NE 0 => RETURN 1;
 CCALL free(CHN[CHA]); CHN[CHA]:=CCALL strdup(LOC(CHP));
 0)
%%
