EXTERNAL PTR malloc(SIZE);
EXTERNAL PTR realloc(PTR, SIZE);
EXTERNAL VOID free(PTR);
EXTERNAL PTR memcpy(PTR, PTR, SIZE);
EXTERNAL INT memcmp(PTR, PTR, SIZE);
EXTERNAL PTR memset(PTR, INT, SIZE);
EXTERNAL SIZE strlen(PTR);
#THIS IS FILE IMPSTR, COUNTED STRINGS (ROADMAP 6): A STRING THAT CARRIES ITS LENGTH, BESIDE THE STRING OF THE LANGUAGE, WHICH IS ASCIZ AND STAYS SO.  A COUNTED STRING IS A RECORD IN MEMORY FROM THE C LIBRARY'S MALLOC: A WORD OF ITS LENGTH IN BYTES (THE ZERO NOT COUNTED), THE BYTES, AND A ZERO BYTE AFTER THEM, SO THAT THE ADDRESS OF ITS BYTES (CSBYTES)
 CAN BE GIVEN TO C, AND TO STG OF PRINT.  THE VALUE OF A COUNTED STRING IS THE ADDRESS OF ITS RECORD, A WORD LIKE ANY OTHER; IT IS MADE AND HANDLED ONLY BY THESE ROUTINES, AND ONE THAT TAKES A COUNTED STRING IS NOT ONE THAT TAKES AN ASCIZ STRING (THE ARGUMENT OF CSNEW IS ONE).  A BYTE IS A BYTE: THE TEXT IS UTF-8 AND
 THE ROUTINES COUNT AND COMPARE BYTES, WHICH IS WHAT CSCMP DOES, NOT CHARACTERS; A COUNTED STRING MAY HOLD A ZERO BYTE, WHICH AN ASCIZ STRING CANNOT.  CSFREE GIVES ONE BACK; ONE THAT CSAPP HAS MOVED IS THE ONE IT RETURNS.#

# CSMAKE(A,N): THE COUNTED STRING OF THE N BYTES AT THE ADDRESS A (A POINTER, FOR BYTES THAT C MADE OR A BUFFER); 0 IF THERE IS NO MEMORY #
SUBR CSMAKE(A,N) IS (
 AA,NN,P ARE LOCAL;
 AA:=A; NN:=N;
 NN<0 => NN:=0;
 P:=CCALL malloc(NN+9);
 P=0 => RETURN 0;
 [P]:=NN;
 NN>0 => CCALL memcpy(P+8,AA,NN);
 CCALL memset((P+8)+NN,0,1);
 P);

# CSNEW(STG): THE COUNTED STRING OF THE ASCIZ STRING STG (A STRING CONSTANT, OR A VARIABLE THAT HOLDS ONE) #
SUBR CSNEW(STG) IS (
 A ARE LOCAL;
 A:=LOC(STG);
 CSMAKE(A,CCALL strlen(A)));

# CSLEN(P): THE LENGTH IN BYTES; CSBYTES(P): THE ADDRESS OF THE BYTES, FOR C (A ZERO FOLLOWS THEM) #
SUBR CSLEN(P) IS (PA ARE LOCAL; PA:=P; [PA]);
SUBR CSBYTES(P) IS (PA ARE LOCAL; PA:=P; PA+8);

# CSCOPY(P): A COUNTED STRING OF THE SAME BYTES #
SUBR CSCOPY(P) IS (PA ARE LOCAL; PA:=P; CSMAKE(PA+8,[PA]));

# CSCAT(P,Q): A NEW COUNTED STRING, THE BYTES OF P AND THEN THOSE OF Q #
SUBR CSCAT(P,Q) IS (
 PA,QA,LP,LQ,R ARE LOCAL;
 PA:=P; QA:=Q; LP:=[PA]; LQ:=[QA];
 R:=CSMAKE(PA+8,LP+LQ);
 R=0 => RETURN 0;
 LQ>0 => CCALL memcpy((R+8)+LP,QA+8,LQ);
 [R]:=LP+LQ;
 R);

# CSAPP(P,Q): THE BYTES OF Q ADDED TO P, WHICH MAY MOVE: THE VALUE IS THE COUNTED STRING TO USE FROM NOW ON; 0 (P IS NOT TOUCHED) IF THERE IS NO MEMORY #
SUBR CSAPP(P,Q) IS (
 PA,QA,LP,LQ,R ARE LOCAL;
 PA:=P; QA:=Q; LP:=[PA]; LQ:=[QA];
 R:=CCALL realloc(PA,(LP+LQ)+9);
 R=0 => RETURN 0;
 LQ>0 => CCALL memcpy((R+8)+LP,QA+8,LQ);
 [R]:=LP+LQ;
 CCALL memset((R+8)+(LP+LQ),0,1);
 R);

# CSCMP(P,Q): -1, 0 OR 1 AS THE BYTES OF P, COMPARED AS UNSIGNED BYTES, COME BEFORE, ARE, OR COME AFTER THOSE OF Q (THE SHORTER IS BEFORE THE LONGER IF ALL ITS BYTES ARE THE LONGER'S FIRST) #
SUBR CSCMP(P,Q) IS (
 PA,QA,LP,LQ,N,C ARE LOCAL;
 PA:=P; QA:=Q; LP:=[PA]; LQ:=[QA];
 LP<LQ => N:=LP ELSE N:=LQ;
 N>0 => (C:=CCALL memcmp(PA+8,QA+8,N) AND 4294967295;
         C GE 2147483648 => RETURN 0-1;
         C NE 0 => RETURN 1);
 LP<LQ => RETURN 0-1;
 LP>LQ => RETURN 1;
 0);

# CSSUB(P,I,N): A NEW COUNTED STRING OF THE N BYTES FROM BYTE I (THE FIRST IS 0) OF P, AS MANY AS THERE ARE IF THERE ARE FEWER #
SUBR CSSUB(P,I,N) IS (
 PA,II,NN,LP ARE LOCAL;
 PA:=P; II:=I; NN:=N; LP:=[PA];
 II<0 => II:=0;
 II>LP => II:=LP;
 NN<0 => NN:=0;
 (II+NN)>LP => NN:=LP-II;
 CSMAKE((PA+8)+II,NN));

# CSFIND(P,Q): THE INDEX OF THE FIRST PLACE IN P WHERE THE BYTES OF Q ARE, -1 IF THERE IS NONE (AN EMPTY Q IS AT 0) #
SUBR CSFIND(P,Q) IS (
 PA,QA,LP,LQ,K,C ARE LOCAL;
 PA:=P; QA:=Q; LP:=[PA]; LQ:=[QA];
 LQ=0 => RETURN 0;
 K:=0;
 FD1: (K+LQ)>LP => RETURN 0-1;
      C:=CCALL memcmp((PA+8)+K,QA+8,LQ) AND 4294967295;
      C=0 => RETURN K;
      K:=K+1; GO TO FD1);

# CSPRINT(P): THE BYTES PRINTED, AS STG 0 PRINTS A STRING, UP TO THE FIRST ZERO BYTE IF THERE IS ONE IN THEM #
SUBR CSPRINT(P) IS (
 PA,K ARE LOCAL;
 PA:=P; K:=8;
 PRINT STG 0,[PA+K];
 0);

# CSFREE(P): THE RECORD IS GIVEN BACK #
SUBR CSFREE(P) IS (PA ARE LOCAL; PA:=P; CCALL free(PA); 0)
%%
