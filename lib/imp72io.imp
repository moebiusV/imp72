TWOSEG;
#THIS IS FILE IMP72IO, PRINT AND READ, THE FORMATTED INPUT/OUTPUT OF THE MANUAL (SECTION 2.2.7), AND FINI: THE RUNTIME OF THE PROGRAMS IMP72 COMPILES, WRITTEN IN IMP (IT WAS C, LIB/IMP72IO.C, UNTIL THE COMPILER WAS
 ITS OWN).  THE COMPILER TURNS A PRINT STATEMENT INTO A CALL IMP_PR(N,P) FOR EACH ITEM OF ITS LIST, AND A READ STATEMENT INTO IMP_RD(N,P): IMPPR AND IMPRD HERE, WHICH GET THOSE NAMES WHEN THE LIBRARY IS MADE
 (TOOLS/MKLIB.SH; AN IMP NAME HAS NO UNDERSCORE).  THE ARGUMENTS ARE BY REFERENCE, AS FOR ANY IMP ROUTINE: THE CALL STORES N AND P IN THE CELLS IMP_CA AND PASSES THEIR ADDRESSES.  N IS THE KIND OF ITEM AND P THE ADDRESS OF
 ITS OPERAND (0 IF IT HAS NONE):

   0  A VALUE (PRINT) OR A VARIABLE TO READ INTO (READ), IN THE CURRENT FORMAT
   1  OCT W    OCTAL, ZERO FILLED
   2  IGR W    DECIMAL
   3  STG W    A STRING OF AT MOST W CHARACTERS (W = 0: ALL)
   5  /        END OF LINE
   6  FILE     FOUR ITEMS IN A ROW: NAME, EXTENSION, PROJECT, PROGRAMMER
   7  IMAGE MODE   WORDS TRANSFERRED AS THEY ARE
   8  DEVICE D     'TTY:' MAKES THE NEXT FILE THE TERMINAL
   9  TAB N    PRINT ONLY: NEXT CHARACTER IN COLUMN N
  10  FILL C   PRINT ONLY: THE CHARACTER THAT FILLS LEADING POSITIONS
  11  FLT M.N  A REAL IN M COLUMNS WITH N DIGITS AFTER THE POINT; THE OPERAND PACKS M (LOW 32 BITS) AND N (HIGH 32 BITS)

 A FORMAT STAYS UNTIL ANOTHER IS GIVEN, SEPARATELY FOR PRINT AND READ.  A WIDTH IS A NUMBER OF COLUMNS; WHEN THE VALUE DOES NOT FIT, THE FIELD IS AS WIDE AS IT NEEDS.  THE VALUE OF PRINT IS THE COLUMN PRINTED TO; OF READ -1 AT
 THE END OF THE FILE, 1 PAST THE END OF A LINE, 0 OTHERWISE.  STANDARD OUTPUT IS THE FILE PO AND STANDARD INPUT PI.  AT MOST FOUR FILES ARE OPEN; FINI(-1) CLOSES THEM ALL, FINI(0) CLOSES THEM AND EXITS.  DIFFERENCES FROM THE
 PDP-10 LIBRARY: WORDS ARE 64 BITS, SO IMAGE MODE MOVES 8 BYTES; A PROJECT AND PROGRAMMER NUMBER SELECT NOTHING; A NAME IS A STRING OF UP TO 7 CHARACTERS.  THE DIGITS OF A REAL ARE THOSE OF THE IEEE 754 DOUBLE, EXACT, FROM ITS
 BITS BY ARITHMETIC ON LARGE INTEGERS (NO CALL TAKES A DOUBLE).  THE STANDARD FILES AND THE END OF FILE ARE THE C LIBRARY'S, ASKED OF LIB/IMP72SYS.C.  IMP IS TYPED ONLY BY ITS PROGRAMMER: THE STATE IS THE VARIABLES BELOW, ONE
 DIRECTION TO A COLUMN (0 PRINT, 1 READ).#

RTLDEFOUT IS COMMON;
                       # THE FUNCTION THAT SAYS WHERE PRINT GOES WHEN IT HAS NO FILE: SET BY THE COMPILER'S DRIVER (IMPSETDEFOUT OF THE SYSTEM FILE); 0 FOR THE STANDARD OUTPUT #
FMT,WID,FLM,FLN,IMG,DFP,COL,LEN,EOFF,TTY,NPT ARE 2 LONG;
LNB IS 256 LONG;                        # THE TWO LINES, 1024 BYTES EACH #
PRT IS 64 LONG;                         # THE FILE ITEMS: 2 DIRECTIONS, 4 OF 64 BYTES #
FNM IS 128 LONG;                        # THE NAMES OF THE FOUR OPEN FILES, 256 BYTES EACH #
FFP,FOUT ARE 4 LONG;
FILLCH IS 1 LONG;
NBUF IS 40 LONG;
FBUF IS 24 LONG;                        # A FIELD READ #
BODY IS 120 LONG;                       # A REAL, AS WRITTEN #
CD IS 420 LONG;                         # THE DIGITS OF A REAL, ONE TO A WORD #
DG IS 340 LONG;
FR IS 8 LONG;
LA,LF IS 44 LONG;                       # LARGE INTEGERS: 32 BITS TO A WORD, THE LEAST SIGNIFICANT FIRST #
NA,FL,FKB,NI,NCD,CIL,CEX ARE 1 LONG;

SUBR RTLERRS(S) IS CCALL WRITE(2,S,CCALL STRLEN(S));

SUBR RTLERRNL(Z) IS CCALL WRITE(2,LOC('
'),1);

SUBR RTLFILLC(Z) IS (FILLCH[0]=0 => 32 ELSE FILLCH[0]);

SUBR RTLRB(A,I) IS (Q ARE LOCAL; Q_BYTEP [A]<7,36>; Q_Q+I; <+Q>);

SUBR RTLWB(A,I,C) IS (Q ARE LOCAL; Q_BYTEP [A]<7,36>; Q_Q+I; <+Q>_C; 0);

SUBR RTLDEFAULTOUT(Z) IS (
 F ARE LOCAL;
 F_0;
 RTLDEFOUT NE 0 => F_CCALL IMPCALLOUT(RTLDEFOUT);
 F=0 => RETURN CCALL IMPSTDOUT(0);
 F);

SUBR RTLLINEADDR(D) IS LOC(LNB)+(1024*D);

# PUT N BYTES AT S IN THE PRINT LINE #
SUBR RTLPUT(S,N) IS (
 K,Q,P,C ARE LOCAL;
 K_N;
 Q_BYTEP [S]<7,36>;
 P_BYTEP [RTLLINEADDR(0)]<7,36>; P_P+COL[0];
 PT1: K>0 => (K_K-1; COL[0]<1023 => (C_<+Q>; <+P>_C; COL[0]_COL[0]+1; GO TO PT1));
 0);

SUBR RTLPAD(N,CH) IS (
 K,P ARE LOCAL;
 K_N;
 P_BYTEP [RTLLINEADDR(0)]<7,36>; P_P+COL[0];
 PD1: K>0 => (K_K-1; COL[0]<1023 => (<+P>_CH; COL[0]_COL[0]+1; GO TO PD1));
 0);

# THE DIGITS OF V IN BASE B (10 OR 8), UNSIGNED IF U, AS A C STRING IN NBUF; ITS LENGTH #
SUBR RTLNUMSTR(V,B,U) IS (
 W,K,R,NG,J,P ARE LOCAL;
 K_0; NG_0; W_V;
 B=8 => GO TO NS8;
 W<0 => NG_1;
 R_W-((W/10)*10); R<0 => R_0-R;
 NS1: DG[K]_R; K_K+1; W_W/10; W=0 => GO TO NS2;
      R_W-((W/10)*10); R<0 => R_0-R;
      GO TO NS1;
 NS8: DG[K]_W AND 7; W_W RS 3; K_K+1; W NE 0 => GO TO NS8;      # OCTAL: THE 64 BITS, 3 AT A TIME, LOGICAL SHIFTS #
 NS2: P_BYTEP NBUF<7,36>;
 NG NE 0 => <+P>_55B;
 J_K-1;
 NS4: J GE 0 => (<+P>_60B+DG[J]; J_J-1; GO TO NS4);
 <+P>_0;
 K+NG);

# A FIELD OF W COLUMNS: THE STRING S RIGHT JUSTIFIED, FILLED ON THE LEFT WITH ZEROS IF ZERO, ELSE WITH THE FILL CHARACTER #
SUBR RTLFIELD(S,W,ZERO) IS (
 N ARE LOCAL;
 N_CCALL STRLEN(S);
 W>N => RTLPAD(W-N,(ZERO NE 0 => 60B ELSE RTLFILLC(0)));
 RTLPUT(S,N);
 0);

SUBR RTLOPENFILE(NM,OUT) IS (
 I,FS ARE LOCAL;
 FS_0-1;
 I_0;
 OF1: I<4 => (FFP[I] NE 0 => FOUT[I]=OUT => CCALL STRCMP(LOC(FNM)+(256*I),NM)=0 => RETURN FFP[I];
              FFP[I]=0 => FS<0 => FS_I;
              I_I+1; GO TO OF1);
 FS<0 => (RTLERRS(LOC('imp72: more than 4 files open')); RTLERRNL(0); CCALL EXIT(1));
 FFP[FS]_CCALL FOPEN(NM,(OUT NE 0 => LOC('w') ELSE LOC('r')));
 FFP[FS]=0 => (RTLERRS(LOC('imp72: cannot open ')); RTLERRS(NM); RTLERRNL(0); CCALL EXIT(1));
 CCALL SNPRINTF(LOC(FNM)+(256*FS),256,LOC('%s'),NM);
 FOUT[FS]_OUT;
 FFP[FS]);

# THE FOURTH ITEM OF FILE: OPEN THE FILE #
SUBR RTLFILESPEC(D,OUT) IS (
 PA,PB ARE LOCAL;
 PA_LOC(PRT)+(512*D);
 PB_PA+64;
 RTLRB(PB,0) NE 0 => CCALL SNPRINTF(LOC(NBUF),256,LOC('%s.%s'),PA,PB) ELSE CCALL SNPRINTF(LOC(NBUF),256,LOC('%s'),PA);
 TTY[D]_0;
 RTLRB(LOC(NBUF),0) NE 0 => DFP[D]_RTLOPENFILE(LOC(NBUF),OUT) ELSE DFP[D]_0;
 NPT[D]_0; COL[D]_0; LEN[D]_0; EOFF[D]_0;
 0);

# THE ITEMS THAT MEAN THE SAME IN BOTH DIRECTIONS: 1 IF IT WAS ONE #
SUBR RTLCOMMON(D,OUT,N,P) IS (
 PP ARE LOCAL;
 N=1 => GO TO CM1;
 N=2 => GO TO CM1;
 N=3 => GO TO CM1;
 N=6 => GO TO CM6;
 N=7 => (IMG[D]_1; RETURN 1);
 N=8 => GO TO CM8;
 N=11 => GO TO CM11;
 RETURN 0;
 CM1: FMT[D]_(N=2 => 0 ELSE N); WID[D]_0; P NE 0 => WID[D]_[P]; IMG[D]_0; RETURN 1;
 CM11: FMT[D]_11; FLM[D]_0; FLN[D]_0;
       P NE 0 => (FLM[D]_[P] AND 4294967295; FLM[D] GE 2147483648 => FLM[D]_FLM[D]-4294967296;
                  FLN[D]_([P] RS 32) AND 4294967295);
       IMG[D]_0; RETURN 1;
 CM6: NPT[D]<4 => (PP_LOC(PRT)+((512*D)+(64*NPT[D]));
                   NPT[D]<2 => (P NE 0 => CCALL SNPRINTF(PP,64,LOC('%.7s'),P) ELSE CCALL MEMSET(PP,0,1))
                     ELSE CCALL MEMSET(PP,0,1);
                   NPT[D]_NPT[D]+1);
      NPT[D]=4 => RTLFILESPEC(D,OUT);
      RETURN 1;
 CM8: P NE 0 => CCALL STRNCMP(P,LOC('TTY:'),4)=0 => (TTY[D]_1; DFP[D]_0; COL[D]_0; LEN[D]_0);
      RETURN 1);

# THE EXACT DIGITS OF A DOUBLE #
# THE LIMBS AT AD (N OF THEM): TIMES M PLUS C; THE CARRY OUT #
SUBR RTLBMUL(AD,N,M,C) IS (
 I,T,CY ARE LOCAL;
 CY_C; I_0;
 BM1: I<N => (T_([AD+(8*I)]*M)+CY; [AD+(8*I)]_T AND 4294967295; CY_T RS 32; I_I+1; GO TO BM1);
 CY);

# DIVIDE BY 10; THE REMAINDER #
SUBR RTLBDIV10(AD,N) IS (
 I,T,R ARE LOCAL;
 R_0; I_N-1;
 BD1: I GE 0 => (T_(R*4294967296)+[AD+(8*I)]; [AD+(8*I)]_T/10; R_T-((T/10)*10); I_I-1; GO TO BD1);
 R);

SUBR RTLBTRIM(AD,N) IS (K ARE LOCAL; K_N; BT1: K>1 => [AD+(8*(K-1))]=0 => (K_K-1; GO TO BT1); K);

SUBR RTLBZERO(AD,N) IS (I ARE LOCAL; I_0; BZ1: I<N => ([AD+(8*I)]=0 => (I_I+1; GO TO BZ1); RETURN 0); 1);

# SHIFT RIGHT BY K BITS: THE NEW LENGTH #
SUBR RTLBSHR(AD,N,K) IS (
 SH,R,I,V,NN,SI,SJ ARE LOCAL;
 SH_K/32; R_K-(32*SH);
 SH GE N => ([AD]_0; RETURN 1);
 NN_N-SH;
 I_0;
 BR1: I<NN => (SI_I+SH; V_[AD+(8*SI)] RS R;
               SJ_SI+1;
               R NE 0 => SJ<N => V_V OR (([AD+(8*SJ)] LS (32-R)) AND 4294967295);
               [AD+(8*I)]_V; I_I+1; GO TO BR1);
 I_NN; BR2: I<N => ([AD+(8*I)]_0; I_I+1; GO TO BR2);
 RTLBTRIM(AD,NN));

# SHIFT LEFT BY K BITS: THE NEW LENGTH (THE ARRAY IS BIG ENOUGH) #
SUBR RTLBSHL(AD,N,K) IS (
 SH,R,I,V,NN,SI,SJ ARE LOCAL;
 SH_K/32; R_K-(32*SH);
 NN_(N+SH)+1;
 I_NN-1;
 BL1: I GE 0 => (V_0;
                 SI_I-SH; SJ_SI-1;
                 SI GE 0 => SI<N => V_([AD+(8*SI)] LS R) AND 4294967295;
                 R NE 0 => SJ GE 0 => SJ<N => V_V OR ([AD+(8*SJ)] RS (32-R));
                 [AD+(8*I)]_V; I_I-1; GO TO BL1);
 RTLBTRIM(AD,NN));

# KEEP THE LOW K BITS OF THE FL LIMBS AT AD #
SUBR RTLBMASK(AD,K) IS (
 I,R,J ARE LOCAL;
 I_K/32; R_K-(32*I);
 I<FL[0] => ([AD+(8*I)]_[AD+(8*I)] AND ((1 LS R)-1); J_I+1; BK1: J<FL[0] => ([AD+(8*J)]_0; J_J+1; GO TO BK1));
 0);

# THE NON-NEGATIVE FINITE DOUBLE WITH THE BITS X (NOT 0): ITS INTEGER PART'S DIGITS ARE IN DG, NI OF THEM, MOST SIGNIFICANT FIRST (NONE IF THE INTEGER PART IS 0), AND THE FRACTION IS IN THE LIMBS LF, TO BE READ OUT BY
  FRACDIGIT AS THE NUMERATOR OVER 2 TO THE POWER FKB #
SUBR RTLEXPAND(X) IS (
 E,M,K,R,I,J ARE LOCAL;
 E_(X RS 52) AND 2047;
 M_X AND 4503599627370495;
 E=0 => E_1 ELSE M_M OR 4503599627370496;
 E_E-1075;                                       # THE VALUE IS M TIMES 2 TO THE POWER E #
 I_0; EX1: I<44 => (LA[I]_0; LF[I]_0; I_I+1; GO TO EX1);
 LA[0]_M AND 4294967295; LA[1]_M RS 32; NA[0]_2;
 E GE 0 => (NA[0]_RTLBSHL(LOC(LA),NA[0],E); FKB[0]_0; FL[0]_1; GO TO EXI);
 FKB[0]_0-E;
 FL[0]_(FKB[0]/32)+2;
 LF[0]_LA[0]; LF[1]_LA[1];
 RTLBMASK(LOC(LF),FKB[0]);
 NA[0]_RTLBSHR(LOC(LA),NA[0],FKB[0]);
 EXI: K_0;
 EX2: RTLBZERO(LOC(LA),NA[0])=0 => (DG[K]_RTLBDIV10(LOC(LA),NA[0]); K_K+1; NA[0]_RTLBTRIM(LOC(LA),NA[0]); GO TO EX2);
 NI[0]_K;
 I_0; EX3: I<(K/2) => (J_(K-1)-I; R_DG[I]; DG[I]_DG[J]; DG[J]_R; I_I+1; GO TO EX3);
 0);

# THE NEXT DIGIT OF THE FRACTION #
SUBR RTLFRACDIGIT(Z) IS (
 I,R,DGT,J,JJ ARE LOCAL;
 FKB[0]=0 => RETURN 0;
 RTLBMUL(LOC(LF),FL[0],10,0);
 I_FKB[0]/32; R_FKB[0]-(32*I);
 DGT_LF[I] RS R;
 JJ_I+1;
 R>28 => JJ<FL[0] => DGT_DGT OR (LF[JJ] LS (32-R));
 DGT_DGT AND 15;
 LF[I]_LF[I] AND ((1 LS R)-1);
 J_I+1; FD1: J<FL[0] => (LF[J]_0; J_J+1; GO TO FD1);
 DGT);

# ADD ONE IN THE LAST PLACE OF THE DIGITS CD[0..LN-1]; 1 IF IT GREW A DIGIT (THE DIGITS MOVE UP) #
SUBR RTLINCDEC(LN) IS (
 K,KM ARE LOCAL;
 K_LN-1;
 ID1: K GE 0 => (CD[K]=9 => (CD[K]_0; K_K-1; GO TO ID1) ELSE (CD[K]_CD[K]+1; RETURN 0));
 K_LN; ID2: K>0 => (KM_K-1; CD[K]_CD[KM]; K_KM; GO TO ID2);
 CD[0]_1;
 1);

# THE DOUBLE WITH BITS X WRITTEN WITH D DIGITS AFTER THE POINT, ROUNDED HALF AWAY FROM ZERO ON ITS EXACT DECIMAL VALUE (PRINTF ROUNDS A TIE TO EVEN; PMOD AND FORTRAN ROUND IT UP): THE DIGITS IN CD, CIL OF THEM BEFORE
  THE POINT (AT LEAST ONE: 0), THEN THE D AFTER IT; THE TOTAL IN NCD #
SUBR RTLFIXEDDIGITS(X,D) IS (
 K,NX,IL ARE LOCAL;
 RTLEXPAND(X);
 NI[0]=0 => (CD[0]_0; IL_1) ELSE (K_0; FX1: K<NI[0] => (CD[K]_DG[K]; K_K+1; GO TO FX1); IL_NI[0]);
 K_0; FX2: K<D => (CD[IL+K]_RTLFRACDIGIT(0); K_K+1; GO TO FX2);
 NX_RTLFRACDIGIT(0);
 NX GE 5 => IL_IL+RTLINCDEC(IL+D);
 CIL[0]_IL; NCD[0]_IL+D;
 0);

# THE FIRST D SIGNIFICANT DIGITS OF THE DOUBLE WITH BITS X IN CD, ROUNDED THE SAME WAY; CEX IS THE POWER OF TEN OF THE NUMBER WRITTEN 0.DDD #
SUBR RTLSCIDIGITS(X,D) IS (
 K,N,LEAD,V ARE LOCAL;
 RTLEXPAND(X);
 N_0;
 NI[0]=0 => GO TO SC2;
 CEX[0]_NI[0];
 K_0; SC1: K<NI[0] => (N<D+1 => (CD[N]_DG[K]; N_N+1); K_K+1; GO TO SC1);
 GO TO SC3;
 SC2: LEAD_0;                                    # THE FIRST SIGNIFICANT DIGIT IS IN THE FRACTION #
 SC4: V_RTLFRACDIGIT(0); V=0 => (LEAD_LEAD+1; GO TO SC4);
 CEX[0]_0-LEAD;
 CD[0]_V; N_1;
 SC3: N<D+1 => (CD[N]_RTLFRACDIGIT(0); N_N+1; GO TO SC3);
 CD[D] GE 5 => RTLINCDEC(D)=1 => CEX[0]_CEX[0]+1;
 0);

# A REAL, AS PRINT FLT M.N WRITES IT.  THE LAYOUT IS THAT OF THE ORIGINAL'S PMOD (DOCS/INTERNALS/PMOD.MD); THE DIGITS ARE THOSE OF THE IEEE 754 DOUBLE, CORRECTLY ROUNDED (THE ORIGINAL COMPUTED THEM IN 27 BIT FLOATING POINT,
  WITH INEXACT CONSTANTS, SO THAT 0.001 PRINTED AS .99999"-3):

   - NO 0 BEFORE THE POINT; ZERO IS A BARE 0;
   - FIXED NOTATION (N DIGITS AFTER THE POINT) UNLESS THE DIGITS AND THE POINT DO NOT FIT THE FIELD (M WIDE: THEY MUST BE FEWER THAN M-1), THEN .DDD"E WITH M-7 DIGITS (TWO, UNPADDED, WHEN THE FIELD IS NARROWER THAN 9),
     WHERE E IS THE POWER OF TEN OF THE NUMBER WRITTEN AS 0.DDD;
   - A NEGATIVE M IS THE SCIENTIFIC FORM ALWAYS, IN -M COLUMNS, WITH N+1 DIGITS;
   - A NUMBER THAT IS NOT FINITE IS INF OR NAN #
SUBR RTLBADD(C) IS (BP ARE LOCAL; BP_BYTEP BODY<7,36>; BP_BP+BL[0]; <+BP>_C; BL[0]_BL[0]+1; 0);
BL IS 1 LONG;

SUBR RTLBADDS(S) IS (K,C,Q ARE LOCAL; Q_BYTEP [S]<7,36>; BS1: C_<+Q>; C NE 0 => (RTLBADD(C); GO TO BS1); 0);

SUBR RTLPRINTFLT(X,M,N) IS (
 NEG,ZB,D,G,FIXED,EX,J,K,IL,ND,W ARE LOCAL;
 NEG_(X<0 => 1 ELSE 0); ZB_X AND 9223372036854775807;
 D_N; G_(M>0 => M-1 ELSE (M<0 => (0-M)-1 ELSE 0-1));
 FIXED_(M GE 0 => 1 ELSE 0);
 D>60 => D_60;
 M<0 => D_N+1;
 BL[0]_0;
 (ZB RS 52)=2047 => (ZB AND 4503599627370495 NE 0 => RTLBADDS(LOC('NAN')) ELSE (NEG NE 0 => RTLBADDS(LOC('-INF')) ELSE RTLBADDS(LOC('INF'))); GO TO TX);
 ZB=0 => (RTLBADD(60B); GO TO TX);
 FIXED=0 => GO TO SCI;
 RTLFIXEDDIGITS(ZB,D);
 IL_CIL[0];
 J_IL;                                                    # THE DIGITS BEFORE THE POINT THAT ARE WRITTEN (NONE FOR 0.DDD) #
 CD[0]=0 => IL=1 => D>0 => J_0;
 W_0; D NE 0 => W_D+1;
 G GE 0 => (W+J) GE G => GO TO SCIN;
 NEG NE 0 => RTLBADD(55B);
 K_IL-J; ND_0;
 PF1: K<IL => (RTLBADD(60B+CD[K]); K_K+1; GO TO PF1);
 D>0 => (RTLBADD(56B); K_IL; PF2: K<IL+D => (RTLBADD(60B+CD[K]); K_K+1; GO TO PF2));
 GO TO TX;
 SCIN: FIXED_0; D_G-6;
 D GE 2 => GO TO SCI;                                    # THE FIELD IS TOO NARROW TO PUT THE DIGITS BEHIND A POINT: TWO DIGITS, UNPADDED #
 D_2; G_0-1;
 SCI: D<1 => D_1;
 RTLSCIDIGITS(ZB,D);
 BL[0]_0;
 NEG NE 0 => RTLBADD(55B);
 RTLBADD(56B);
 K_0; PS1: K<D => (RTLBADD(60B+CD[K]); K_K+1; GO TO PS1);
 RTLBADD(42B);
 EX_CEX[0];
 EX<0 => (RTLBADD(55B); EX_0-EX);
 K_0; ND_0; DG[ND]_EX-((EX/10)*10); EX_EX/10; ND_ND+1;
 PS2: EX NE 0 => (DG[ND]_EX-((EX/10)*10); EX_EX/10; ND_ND+1; GO TO PS2);
 PS3: ND>0 => (ND_ND-1; RTLBADD(60B+DG[ND]); GO TO PS3);
 TX: G GE 0 => G+1>BL[0] => RTLPAD((G+1)-BL[0],RTLFILLC(0));
 RTLPUT(LOC(BODY),BL[0]);
 0);

# PRINT #
SUBR IMPPR(N,P) IS (
 F,L,V ARE LOCAL;
 TTY[0] NE 0 => DFP[0]_0;
 N=10 => (FILLCH[0]_32; P NE 0 => ([P] AND 255) NE 0 => FILLCH[0]_[P] AND 255; RETURN COL[0]);
 N=5 => (F_DFP[0]; F=0 => F_RTLDEFAULTOUT(0);
         IMG[0] NE 0 => (COL[0]_0; RETURN 0);
         CCALL MEMSET(RTLLINEADDR(0)+COL[0],0,1);
         CCALL FPUTS(RTLLINEADDR(0),F); CCALL FPUTC(10,F);
         COL[0]_0; RETURN 0);
 N=9 => (P NE 0 => ([P]-1)>COL[0] => RTLPAD(([P]-1)-COL[0],32); RETURN COL[0]);
 RTLCOMMON(0,1,N,P)=1 => RETURN COL[0];
 N NE 0 => RETURN COL[0];
 P=0 => RETURN COL[0];
 IMG[0] NE 0 => (F_DFP[0]; F=0 => F_RTLDEFAULTOUT(0); CCALL FWRITE(P,8,1,F); RETURN COL[0]);
 FMT[0]=3 => (L_CCALL STRLEN(P);
              WID[0]>0 => L>WID[0] => L_WID[0];
              WID[0]>L => RTLPAD(WID[0]-L,RTLFILLC(0));
              RTLPUT(P,L); RETURN COL[0]);
 FMT[0]=1 => (RTLNUMSTR([P],8,1);
              L_CCALL STRLEN(LOC(NBUF));
              WID[0]>12 => L<13 => (RTLPAD(WID[0]-12,32); RTLFIELD(LOC(NBUF),12,1); RETURN COL[0]);
              RTLFIELD(LOC(NBUF),WID[0],1); RETURN COL[0]);
 FMT[0]=11 => (RTLPRINTFLT([P],FLM[0],FLN[0]); RETURN COL[0]);
 RTLNUMSTR([P],10,0);
 RTLFIELD(LOC(NBUF),WID[0],0);
 COL[0]);

# READ #
# MAKE SURE A LINE IS THERE; 0 AT THE END OF THE FILE #
SUBR RTLGETLINE(D) IS (
 F,C,N,P ARE LOCAL;
 COL[D]<LEN[D] => RETURN 1;
 EOFF[D] NE 0 => RETURN 0;
 F_DFP[D]; F=0 => F_CCALL IMPSTDIN(0);
 N_0; P_BYTEP [RTLLINEADDR(D)]<7,36>;
 GL1: C_CCALL FGETC(F);
      C=4294967295 => C_0-1;                     # AN INT: ITS -1 IS 32 BITS #
      C<0 => GO TO GL2;
      C=12B => GO TO GL2;
      C=11B => C_32;
      N<1023 => (<+P>_C; N_N+1);
      GO TO GL1;
 GL2: C<0 => N=0 => (EOFF[D]_1; RETURN 0);
 <+P>_0;
 LEN[D]_N; COL[D]_0;
 1);

PASTF IS 1 LONG;

# THE NEXT INPUT FIELD: UP TO THE TERMINATOR, THE END OF THE LINE OR 128 CHARACTERS; BLANKS ARE IGNORED UNLESS KEEP IS SET; PASTF IS 1 PAST THE END OF THE LINE.  THE FIELD IS A C STRING AT OUT; ITS LENGTH #
SUBR RTLNEXTFIELD(D,TERM,FIXED,KEEP,OUT) IS (
 N,START,C,Q,P ARE LOCAL;
 N_0; START_COL[D];
 PASTF[0]_0;
 COL[D] GE LEN[D] => (PASTF[0]_1; CCALL MEMSET(OUT,0,1); RETURN 0);
 Q_BYTEP [RTLLINEADDR(D)]<7,36>; Q_Q+COL[D];
 P_BYTEP [OUT]<7,36>;
 NF1: COL[D]<LEN[D] => N<128 => (
        C_<+Q>;
        FIXED NE 0 => (COL[D]-START) GE FIXED => (Q_Q-1; GO TO NF2);
        FIXED=0 => C=TERM => (COL[D]_COL[D]+1; GO TO NF2);
        COL[D]_COL[D]+1;
        C=32 => KEEP=0 => TERM NE 32 => GO TO NF1;
        <+P>_C; N_N+1; GO TO NF1);
 NF2: CCALL MEMSET(OUT+N,0,1);
 N);

# THE INTEGER AT THE START OF THE STRING S IN BASE B (WHITE SPACE AND A SIGN FIRST, AS STRTOLL TAKES IT) #
SUBR RTLPARSEINT(S,B) IS (
 Q,C,NG,V,DV ARE LOCAL;
 Q_BYTEP [S]<7,36>;
 V_0; NG_0;
 PI1: C_<+Q>; C=32 => GO TO PI1;
 C=11B => GO TO PI1;
 C=55B => (NG_1; C_<+Q>) ELSE (C=53B => C_<+Q>);
 PI2: DV_100;
 C GE 60B => C<(60B+B) => DV_C-60B;
 DV GE B => GO TO PI3;
 V_(V*B)+DV; C_<+Q>; GO TO PI2;
 PI3: NG NE 0 => 0-V ELSE V);

SUBR IMPRD(N,P) IS (
 F,TERM,FIXED,K,PAST ARE LOCAL;
 TERM_54B; FIXED_0;
 TTY[1] NE 0 => DFP[1]_0;
 N=5 => (COL[1]_LEN[1]; RETURN 0);
 N=9 => RETURN 0;
 N=10 => RETURN 0;
 RTLCOMMON(1,0,N,P)=1 => RETURN 0;
 N NE 0 => RETURN 0;
 P=0 => RETURN 0;
 IMG[1] NE 0 => (F_DFP[1]; F=0 => F_CCALL IMPSTDIN(0);
                 CCALL FREAD(P,8,1,F) NE 1 => RETURN 0-1;
                 RETURN 0);
 RTLGETLINE(1)=0 => RETURN 0-1;
 WID[1] GE 32 => WID[1]<127 => TERM_WID[1];              # THE WIDTH OF A FIELD READ IS ITS TERMINATOR WHEN IT IS A ONE CHARACTER STRING (A PRINTABLE CODE); A SMALL NUMBER IS A WIDTH #
 WID[1]>0 => WID[1]<32 => FIXED_WID[1];
 FMT[1]=3 => (K_RTLNEXTFIELD(1,TERM,FIXED,1,LOC(FBUF)); CCALL MEMCPY(P,LOC(FBUF),K+1); RETURN PASTF[0]);
 FMT[1]=1 => (RTLNEXTFIELD(1,TERM,FIXED,0,LOC(FBUF)); [P]_RTLPARSEINT(LOC(FBUF),8); RETURN PASTF[0]);
 RTLNEXTFIELD(1,TERM,FIXED,0,LOC(FBUF));                    # ON INPUT, FLT M.N IS IGR M #
 [P]_RTLPARSEINT(LOC(FBUF),10);
 PASTF[0]);

# FINI #
# FINI(I): CLOSE THE FILES; I = 0 EXITS #
SUBR FINI(I) IS (
 K ARE LOCAL;
 K_0;
 FN1: K<4 => (FFP[K] NE 0 => (CCALL IMPFCLOSE(FFP[K]); FFP[K]_0); K_K+1; GO TO FN1);
 DFP[0]_0; DFP[1]_0;
 CCALL FFLUSH(CCALL IMPSTDOUT(0));
 I=0 => CCALL EXIT(0);
 0)
%%
