#IMPVARS: THE VARIABLES OF THE COMPILER'S OWN MODULES, FOR THE IMAGES (SRC/IMAGE.IMP).  THE TRANSLATION OF IMPVARLIST OF LIB/IMP72SYS.C.  SRC/PCCIR/IX.IMP IRVARREC (AND TOOLS/IR2LL.C) PUT A RECORD OF THE ADDRESS, THE SIZE AND THE NAME,
MODULE:SYMBOL, OF EACH VARIABLE IN A SECTION OF THE OBJECT, impvars; THE SECTION IS FOUND BY THE FORMAT OF THE OBJECT (LIB/IMPVARSX-ELF.IMP OR IMPVARSX-MACHO.IMP: VSTART, VSTOP, WRITABLE).  ONLY WHAT LIES IN THE WRITABLE
PART OF THE PROGRAM IS A VARIABLE (A NAME THAT A MODULE USES AND DOES NOT DEFINE IS A VARIABLE OF THE MODULE TO THE COMPILER, WHATEVER IT IS, A ROUTINE OF ANOTHER MODULE, SAY); EACH VARIABLE ONCE, WITH ITS BIGGEST SIZE.
IMPVARLIST(OUT,MX) WRITES UP TO MX RECORDS OF THREE WORDS (ADDRESS, SIZE, POINTER TO THE NAME) AND RETURNS HOW MANY THERE ARE, OR -1 IF THERE IS NO TABLE; WITH OUT 0 IT ONLY COUNTS.#

SUBR IMPVARLIST(OUT,MX) IS (
 R,Q,LO,HI,RS,N,I,A,S,NM,QA,QS,DUP ARE LOCAL;
 LO:=VSTART(0); HI:=VSTOP(0);
 LO=0 => RETURN 0-1;
 LO=HI => RETURN 0-1;
 RS:=3*SCPTR(0); N:=0; R:=LO;
 VL1: R<HI => (
    A:=IMPPEEKPTR(R); S:=IMPPEEKPTR(R+SCPTR(0)); NM:=IMPPEEKPTR(R+(2*SCPTR(0)));
    WRITABLE(A,S)=0 => (R:=R+RS; GO TO VL1);
    OUT=0 => (                                                  # COUNTING: THE SAME TEST, ON THE RECORDS SEEN SO FAR #
        DUP:=0; Q:=LO;
        VL2: Q<R => (QA:=IMPPEEKPTR(Q); QA=A => (WRITABLE(QA,IMPPEEKPTR(Q+SCPTR(0))) NE 0 => (DUP:=1; GO TO VL3));
                     Q:=Q+RS; GO TO VL2);
        VL3: DUP=0 => N:=N+1;
        R:=R+RS; GO TO VL1);
    I:=0;
    VL4: I<N => ([OUT+(24*I)]=A => (S>[OUT+((24*I)+8)] => [OUT+((24*I)+8)]:=S; GO TO VL5);
                 I:=I+1; GO TO VL4);
    VL5: I=N => (N<MX => ([OUT+(24*N)]:=A; [OUT+((24*N)+8)]:=S; [OUT+((24*N)+16)]:=NM; N:=N+1));
    R:=R+RS; GO TO VL1);
 N)
%%
