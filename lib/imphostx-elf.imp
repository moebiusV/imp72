#IMPHOSTX-ELF: THE DYNAMIC LINKER THIS PROGRAM WAS STARTED WITH (ITS PT_INTERP), FOR AN ELF SYSTEM; IMPHOSTX-MACHO.IMP IS THE ONE FOR A SYSTEM WITHOUT DL_ITERATE_PHDR.#

# THE CALLBACK OF DL_ITERATE_PHDR(INFO,SIZE,DATA) THAT FINDS THE PT_INTERP OF THE PROGRAM: COPIES ITS STRING TO DATA.  ITS PARAMETERS ARE THE C LIBRARY'S POINTERS (SEE VPHDR IN IMPVARSX-ELF) #
SUBR HINTERP(INFO,SIZE,DATA) IS (
 P,I,N,PH,BASE,PS,Q,VA ARE LOCAL;
 P:=LOC(INFO);
 BASE:=IMPPEEKPTR(P); PH:=IMPPEEKPTR(P+(2*SCPTR(0))); N:=IMPPEEK(P+(3*SCPTR(0)),2);
 PS:=(SCPTR(0)=8 => 56 ELSE 32);
 I:=0;
 HI1: I<N => (
    Q:=PH+(I*PS);
    IMPPEEK(Q,4)=3 => (                                         # PT_INTERP #
        VA:=(SCPTR(0)=8 => IMPPEEK(Q+16,8) ELSE IMPPEEK(Q+8,4));
        CCALL strcpy(LOC(DATA),BASE+VA);
        RETURN 1);
    I:=I+1; GO TO HI1);
 1);

# THE DYNAMIC LINKER THIS PROGRAM WAS STARTED WITH (ITS PT_INTERP) INTO THE BUFFER OUT, 4096 BYTES; 1 IF IT HAS ONE (A STATIC PROGRAM, AND MACOS, HAVE NONE) #
SUBR IMPHOSTINTERP(OUT) IS (
 CCALL memset(OUT,0,1);
 SCDL(0) NE 0 => CCALL dl_iterate_phdr(LOC(HINTERP),OUT);
 IMPPEEK(OUT,1) NE 0 => 1 ELSE 0)
%%
