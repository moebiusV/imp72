TWOSEG;
#LEX: LEXICAL ANALYZER MODULE FOR IMP COMPILER, FOR THE 64 BIT PORT.
 SEE DECUS/LEX.IMC FOR THE ORIGINAL AND DOCS/PORTING/LEX.MD FOR THE DIFFERENCES.
 A TOKEN IS A RUN OF LETTERS AND DIGITS; A TEXT IN APOSTROPHES (THE TOKEN KEEPS ITS OPENING
 APOSTROPHE AND LOSES THE CLOSING ONE; TWO APOSTROPHES ARE ONE); A TEXT BETWEEN EXCLAMATION MARKS (THE
 MARKS ARE DROPPED); OR ONE OTHER NON-BLANK CHARACTER.  BLANKS AND CONTROL CHARACTERS SEPARATE TOKENS;
 A TEXT BETWEEN NUMBER SIGNS IS A COMMENT.
 THE LINE AND THE TOKEN ARE FREE ARRAYS WITH ONE CHARACTER IN A WORD.  THE FILE IS READ BY C
 (STAGE0/LEX_IMP.C, WHICH HAS LEXIN): IMPSRCGETC GIVES THE NEXT BYTE OR -1.  THE C ROUTINES
 THAT THIS CALLS ARE CALLED THROUGH STAGE0/IMPGLUE.C, BY REFERENCE: IMPSRCGETC, IMPDIRW,
 IMPPLINEW, IMPPLINELW. #

SUBR LEXRESET(NIL) IS (
 LINIT=0=>(LINIT_1; FRELOT(LINE,'LEXL',20,0); FRELOT(TOK,'LEXT',20,0));
 LINELEN_0; FREES(LINE,0);
 PC_0; PCT_0; SKIP_0;
 0);

SUBR LEX(S) IS (
 C_CSV; TOKLEN_0;
 T0: SKIP=0 => NEXTCHAR(0); SKIP_0;
     ISANM=0 => GO TO T2;
 T1: FADD(TOK,TOKLEN,C); NEXTCHAR(0);
     ISANM => GO TO T1;
     SKIP_-1; GO TO LX;
 T2: C LE 40B=>GO TO T0;
     C=43B => (T3: NEXTCHAR(0);
                C NE 43B => GO TO T3;
                GO TO T0);
     C=47B => (T4: FADD(TOK,TOKLEN,C); NEXTCHAR(0);
                C NE 47B => GO TO T4;
                NEXTCHAR(0); C=47B=>GO TO T4;
                SKIP_-1;
                GO TO LX);
     C=41B => (T5: NEXTCHAR(0);
                C NE 41B => (FADD(TOK,TOKLEN,C); GO TO T5);
                GO TO LX);
     FADD(TOK,TOKLEN,C);
 LX: FADD(TOK,TOKLEN,0);
     CSV_C;
     S_IMPDIRW(TOK); IC);

SUBR NEXTCHAR(NIL) IS (
 PC<LINELEN=>C_FREE(LINE+PC) ELSE C_0;
 PC_PC+1; IC_IC+1;
 C=0 => (OPCT_PCT; LINELEN_0;
         GCHRS: CS_IMPSRCGETC(0);
         CHV<0=>(ERROR(0,'PREMATURE END OF INPUT FILE'); GO TO GDONE);
         C_CS;
         C=12B=>GO TO GDONE;
         C NE 0=>(FADD(LINE,LINELEN,C);
                  C=50B=>PCT_PCT+1;
                  C=51B=>PCT_PCT-1);
         GO TO GCHRS;
         GDONE: FADD(LINE,LINELEN,0); LINELEN_LINELEN-1;
         PC_0; IC_0; TFL_0;
         IMPPLINEW(LINE,OPCT);
         C_12B);
 # ISANM IS MADE NON-ZERO FOR ALPHA-NUMERIC CHARS #
 ISANM_0;
 C GE 60B=>C LE 71B=>ISANM_1;
 C GE 101B=>C LE 132B=>ISANM_1;
 C GE 141B=>C LE 172B=>ISANM_1;
 0);

SUBR PLINE1(OL) IS (TFL=0=>(TFL_-1; IMPPLINELW(LINE,OL)); 0)%%
