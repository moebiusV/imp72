TWOSEG;
#LEX: LEXICAL ANALYZER MODULE FOR IMP COMPILER, FOR THE 64 BIT PORT.
 SEE DECUS/LEX.IMC FOR THE ORIGINAL AND DOCS/PORTING/MODULES.MD FOR THE DIFFERENCES.
 A TOKEN IS A RUN OF LETTERS AND DIGITS; A TEXT IN APOSTROPHES (THE TOKEN KEEPS ITS OPENING
 APOSTROPHE AND LOSES THE CLOSING ONE; TWO APOSTROPHES ARE ONE); A TEXT BETWEEN EXCLAMATION MARKS (THE
 MARKS ARE DROPPED); OR ONE OTHER NON-BLANK CHARACTER.  BLANKS AND CONTROL CHARACTERS SEPARATE TOKENS;
 A TEXT BETWEEN NUMBER SIGNS IS A COMMENT.
 THE LINE AND THE TOKEN ARE PACKED, A CHARACTER (A BYTE, UTF-8) TO A BYTE, EIGHT TO A WORD, AND ARE STEPPED THROUGH
 WITH BYTE POINTERS AS IN THE ORIGINAL; THE TOKEN IS A NAME OF THE DIRECTORY AS IT IS.  THE FILE IS READ WITH THE C
 LIBRARY'S FOPEN AND IMPGETC WHERE THE ORIGINAL READS BUFFERS OF A CHANNEL (OPENIN, INPUT, BHEAD); BYTES OF 128 AND UP
 ARE LETTERS, SO THAT A NAME MAY BE IN UTF-8.  THE ARRAYS ARE FILLED THROUGH POINTERS INTO FREE STORAGE, WHICH DOES NOT MOVE
 (SEE CORE IN FREE).  C IS AN ORDINARY VARIABLE OF THE MODULE, WHERE THE ORIGINAL KEEPS IT IN A RESERVED REGISTER. #

FINAM IS COMMON;


SUBR LEXIN(NAME) IS (
 SRCFP NE 0 => CCALL IMPFCLOSE(SRCFP);
 SRCFP_CCALL FOPEN(NAME,LOC('r'));
 SRCFP=0 => RETURN -1;
 LINIT=0=>(LINIT_1;
	LINE_FNEW('LEXL',20); LLINE_90;
	TOKE_FNEW('LEXT',20); LTOKE_90;
	PC_QC_BYTEP FREE(LINE)<7,36>;
	K0_BYTEP FREE(TOKE)<7,36>);
 FREES(LINE,0);
 PC_QC; SKIP_0;
 PCT_0);

SUBR LEX(S) IS (
     C_CSV; K_K0; ITOKE_0;
 T0: SKIP=0 => NEXTCHAR(); SKIP_0;
     ISANM=0 => GO TO T2;
 T1: <+K>_C; NEXTCHAR();
     ISANM => GO TO T1;
     SKIP_-1; GO TO LX;
 T2: C LE 040B=>GO TO T0;
     C=043B => (T3: NEXTCHAR();
                C NE 043B => GO TO T3;
                GO TO T0);
     C=047B => (T4: <+K>_C; NEXTCHAR();
                C NE 047B => GO TO T4;
		NEXTCHAR(); C=047B=>GO TO T4;
		SKIP_-1;
                GO TO LX);
     C=041B => (T5: NEXTCHAR();
                C NE 041B => (<+K>_C; GO TO T5);
                GO TO LX);
     <+K>_C;
 LX: <+K>_0 FOR I FROM 7;
     CSV_C;
     S_DIR(FREE(TOKE)); IC);

SUBR NEXTCHAR() IS (
 (ITOKE_ITOKE+1) GE LTOKE=>(
	TOKE_FALLOT(OTOKE_TOKE,(17+LTOKE_LTOKE+50)/8);
	K_K-8*(OTOKE_OTOKE-TOKE); K0_K0-8*OTOKE);
 NEXT: C_<+PC>; IC_IC+1;
 C=0 => (PC_QC; OPCT_PCT;
	 ILINE_0;
         GCHRS: (ILINE_ILINE+1) GE LLINE=>(
		LINE_FALLOT(OTOKE_LINE,(17+LLINE_LLINE+50)/8);
		PC_PC-8*(OTOKE_OTOKE-LINE); QC_QC-8*OTOKE);
         C_CCALL IMPGETC(SRCFP);
         C<0 => ERROR(0,'PREMATURE END OF INPUT FILE');
	 C NE 12B=>(C=><+PC>_C;
	         C='(' => PCT_PCT+1;
	         C=')' => PCT_PCT-1;
		GO TO GCHRS);
         <+PC>_0; PC_QC; IC_TFL_0;
         PLINE(FREE(LINE),OPCT); C_12B);
 #ISANM IS MADE NON-ZERO FOR ALPHA-NUMERIC CHARS#
 ISANM_(1 LS 31) AND ISTAB[C RS 5] LS 37B AND C);

#ISTAB IS THE ORIGINAL'S TABLE OF A BIT FOR EACH CHARACTER, A WORD OF 32 BITS FOR 32 CHARACTERS, THE FIRST AT THE TOP BIT OF THE 32 (THE ORIGINAL HAS 36): THE DIGITS, @ AND THE
 LETTERS, ` AND THE LOWER CASE LETTERS, AND, TO TAKE UTF-8, ALL OF 128 AND UP#
ISTAB: DATA(0,177700B,37777777740B,37777777740B,37777777777B,37777777777B,37777777777B,37777777777B);

SUBR PLINE1(OL) IS (TFL=0=>(TFL_-1; RC_QC; J_0;
 WHILE (I_<+RC>) DO (
	(J_J+1)=OL=>OUTCHR(12B); OUTCHR(I));
 OUTCHR(12B)));

SUBR PLINE(BF,PCT) IS (
 FINAM[5] AND 4000B => PRINT IGR 3,PCT,STG 0,' ',BF,/;
 FINAM[5] AND 100000000B => MSG(BF))%%
