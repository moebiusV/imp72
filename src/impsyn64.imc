# THIS IS FILE IMPSYN, CONTAINING THE SYNTAX TO BE USED IN COMPILING EACH SUBROUTINE OF THE IMP COMPILER.  FREE STORAGE IS AN ARENA AT FB, ADDRESSED BY
 WORD INDEX.  THE FIELDS <L> AND <R> ARE THE LEFT AND RIGHT HALVES OF A WORD, 32 BITS EACH. #

 FB IS COMMON;

 <VBL>  ::= FREE(<A>)         ::= "[FB+8*(A)]";
 <ATOM> ::= FREES(<A>,<B>)    ::= "[FB+8*(A)]_B";
 <ATOM> ::= FLEN(<A>)         ::= "[FB+8*(A-2)]<R>";
 <ATOM> ::= FADD(<A>,<B>,<C>) ::= "FLEN(A) LE B=>IMPFADDEX(A,B);
                                   FREES(A+B,C);
                                   B_B+1; A";
 <ATOM> ::= FALLOT(<A>,<B>)       ::= "IMPFALLOT(A,B)";
 <ATOM> ::= FRELOT(<A>,<B>,<C>,<D>) ::= "IMPFRELOT(A,B,C,D)";
 <ATOM> ::= FADDEX(<A>,<B>)       ::= "IMPFADDEX(A,B)";
 <ATOM> ::= FINCSET(<A>,<B>)      ::= "IMPFINCSET(A,B)";
<ATOM> ::= ERROR(<A>,<B>)        ::= "IMPERROR(A,B)";
 <ATOM> ::= DSEM(<A>,<B>)         ::= "CCALL DSEMI(LOC(A),LOC(B))";    # THE TABLE OF SEMANTIC ROUTINES IS A TABLE OF ADDRESSES (STAGE0/SEMTAB.C) #

 # THE HALVES OF A WORD ARE 32 BITS. #
 <ATOM> ::= HSH   ::= "32";                 # THE WIDTH OF A HALF #
 <ATOM> ::= HMASK ::= "37777777777B";       # THE MASK OF THE RIGHT HALF #
 <ATOM> ::= GTSH  ::= "48";                 # GRAPH NODE: THE TYPE FIELD, 3 BITS #
 <ATOM> ::= NBMASK ::= "177777B";           # GRAPH NODE: THE ROW FIELD, 16 BITS AT HSH #
 <ATOM> ::= HL(<A>) ::= "((A) RS HSH)";              # LEFT HALF, UNSIGNED #
 <ATOM> ::= HLS(<A>) ::= "((A) ARS HSH)";            # LEFT HALF, SIGNED #
 <ATOM> ::= HR(<A>) ::= "((A) AND HMASK)";           # RIGHT HALF #
 <ATOM> ::= HW(<A>,<B>) ::= "(((A) LS HSH) OR ((B) AND HMASK))";   # A WORD FROM TWO HALVES #

 PRP,ALF,GA,CT ARE COMMON;

 <ATOM> ::= DPROP('NAME',<A>)  ::= "ALF+(FREE(PRP+(A)) AND HMASK)";
 <ATOM> ::= DPROP('ENTRY',<A>) ::= "(FREE(PRP+(A)+1) RS HSH)";
 <ATOM> ::= DPROP('NODE',<A>)  ::= "(FREE(PRP+(A)+1) AND HMASK)";
 <ATOM> ::= DPROP('SEM',<A>)   ::= "(FREE(PRP+(A)+2) AND HMASK)";
 <ATOM> ::= DPROP('ATYPE',<A>) ::= "((FREE(PRP+(A)+2) RS HSH) AND 7)";
 <ATOM> ::= DPROP('COM',<A>)   ::= "((FREE(PRP+(A)+2) RS 35) AND 3)";
 <ATOM> ::= DPROP('ISNM',<A>)  ::= "((FREE(PRP+(A)+2) RS 37) AND 3)";
 <ATOM> ::= DPROP('LXTY',<A>)  ::= "((FREE(PRP+(A)+2) RS 39) AND 3)";
 <ATOM> ::= DPROP('USE',<A>)   ::= "((FREE(PRP+(A)+2) RS 41) AND 7)";

 <ATOM> ::= DPROPS('ENTRY',<A>,<B>) ::=
     "FREES(PRP+(A)+1,(FREE(PRP+(A)+1) AND HMASK) OR ((B) LS HSH))";
 <ATOM> ::= DPROPS('NODE',<A>,<B>)  ::=
     "FREES(PRP+(A)+1,(FREE(PRP+(A)+1) AND NOT HMASK) OR ((B) AND HMASK))";
 <ATOM> ::= DPROPS('SEM',<A>,<B>)   ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT HMASK) OR ((B) AND HMASK))";

 <ATOM> ::= DPROPS('ATYPE',<A>,<B>) ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT (7 LS HSH)) OR (((B) AND 7) LS HSH))";
 <ATOM> ::= DPROPS('COM',<A>,<B>)   ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT (3 LS 35)) OR (((B) AND 3) LS 35))";
 <ATOM> ::= DPROPS('ISNM',<A>,<B>)  ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT (3 LS 37)) OR (((B) AND 3) LS 37))";
 <ATOM> ::= DPROPS('LXTY',<A>,<B>)  ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT (3 LS 39)) OR (((B) AND 3) LS 39))";
 <ATOM> ::= DPROPS('USE',<A>,<B>)   ::=
     "FREES(PRP+(A)+2,(FREE(PRP+(A)+2) AND NOT (7 LS 41)) OR (((B) AND 7) LS 41))";


 # THE CODE TREE: THE LINKS WORD HAS THREE FIELDS OF 20 BITS (SEE ENTREE.IMP) #
 <ATOM> ::= TMASK ::= "3777777B";
 <ATOM> ::= TSCR(<A>)   ::= "(FREE(CT+(A)) AND TMASK)";
 <ATOM> ::= TALT(<A>)   ::= "((FREE(CT+(A)) RS 20) AND TMASK)";
 <ATOM> ::= TNODEN(<A>) ::= "((FREE(CT+(A)) RS 40) AND TMASK)";
 <ATOM> ::= STSCR(<A>,<B>)   ::=
     "FREES(CT+(A),(FREE(CT+(A)) AND NOT TMASK) OR ((B) AND TMASK))";
 <ATOM> ::= STALT(<A>,<B>)   ::=
     "FREES(CT+(A),(FREE(CT+(A)) AND NOT (TMASK LS 20)) OR (((B) AND TMASK) LS 20))";
 <ATOM> ::= STNODEN(<A>,<B>) ::=
     "FREES(CT+(A),(FREE(CT+(A)) AND NOT (TMASK LS 40)) OR (((B) AND TMASK) LS 40))";

 <ATOM> ::= SCR(<A>)   ::= "(FREE(GA+(A)) AND HMASK)";
 <ATOM> ::= ALT(<A>)   ::= "(FREE(GA+(A)) RS HSH)";
 <ATOM> ::= GTYPE(<A>) ::= "((FREE(GA+(A)+1) RS GTSH) AND 7)";
 <ATOM> ::= GVAL(<A>)  ::= "(FREE(GA+(A)+1) AND HMASK)";
 <ATOM> ::= GNB(<A>)   ::= "((FREE(GA+(A)+1) RS HSH) AND NBMASK)";

 # THE WORDS OF THE CODE TREE (SEE ENTREE.IMP): THE TYPE OF A NODE IS THE TOP THREE BITS, AND THE BITS OF THE PRODUCTION NODES AND OF THE CONSTANT NODES BELOW THE ID #
 <ATOM> ::= NT1  ::= "(1 LS 61)";
 <ATOM> ::= NT2  ::= "(2 LS 61)";
 <ATOM> ::= NT3  ::= "(3 LS 61)";
 <ATOM> ::= NCLS ::= "(1 LS 32)";
 <ATOM> ::= NTRM ::= "(2 LS 32)";
 <ATOM> ::= PLIM ::= "((1 LS 29)+2)";
 <ATOM> ::= NMARK ::= "(1 LS 63)";
 <ATOM> ::= MASK52 ::= "177777777777777777B";

 # THE WORDS OF THE SEMANTICS ARRAY (SEE DOSEM.IMP): THE TYPE IS BITS 44-49, ABOVE A VALUE FIELD OF 44 BITS (N IN BITS 32-43, V IN 0-31) THAT IS SIGNED #
 <ATOM> ::= SVMASK ::= "377777777777777B";
 <ATOM> ::= SVSIGN ::= "200000000000000B";

 <EXP> ::= FORG+<A>::="FB+8*(A)";
 <EXP> ::= <A>+FORG ::= "FB+8*(A)";

 <EXP> ::= BIT(<M>,<ROW>,<COL>) ::=
        "(FREE(M+ROW+M[1]*(COL/64)) RS (COL-64*(COL/64))) AND 1"%%
