TWOSEG;
FSIZE,RELP,NRELOC,SYMC,NSYMC,FORGN,FEND ARE COMMON;
#THIS IS FILE IMAGE, THE SWITCHES U AND V OF THE TAPE'S DRIVER: SAVE THE COMPILER, WITH THE SYNTAX AND THE DECLARATIONS IT HAS COMPILED, SO THAT A LATER RUN STARTS FROM THERE.  NOT IN THE TAPE AS A PROGRAM: ON TOPS-10 THE
 MONITOR'S SSAVE WRITES THE CORE IMAGE OF THE COMPILER; HERE THE LANGUAGE THE COMPILER HAS LEARNED IS WRITTEN TO A FILE: THE FREE STORAGE (THE DIRECTORY, THE SYNTAX GRAPH, THE CODE TREE, THE SEMANTICS ARRAY: ALL THE TABLES),
 THE VARIABLES OF THE MODULES OF THE COMPILER (THEY ARE LISTED IN THE SECTION IMPVARS, A RECORD FOR EACH, BY THE COMPILER THAT COMPILED THE MODULES: IRVARREC IN SRC/LLVM-IR/IX.IMC; THE LIBRARY'S IMPVARLIST READS THEM) AND THE
 TABLE OF THE SEMANTIC ROUTINES BY NAME.  THE IMAGE IS FOR THE COMPILER THAT MADE IT: THE VARIABLES ARE MATCHED BY NAME AND THE FILE SAYS IF THE LIST IS NOT THE SAME.  THE DRIVER MODULE (IMPM) IS NOT IN THE IMAGE, NOR THE FILE THAT
 THE LEXER HAS OPEN.  THE ARENA IS ASKED FOR WHERE IT WAS SAVED (THE DEFAULT HINT IS ALWAYS THE SAME), BUT THE IMAGE DOES NOT NEED IT THERE: ALMOST EVERYTHING IN THE ARENA IS A WORD INDEX FROM FB, WHICH IS THE SAME WHEREVER THE ARENA
 LIES, AND THE FEW ABSOLUTE ADDRESSES OF IT ARE MOVED BY THE DIFFERENCE OF THE BASES WHEN THE IMAGE IS LOADED.  THE CENSUS OF THE ABSOLUTE ADDRESSES (IMPIMGCENSUS=1 AT THE SAVING PRINTS IT; TESTS/IMAGE/RUN.SH CHECKS IT):
   - THE WORDS OF THE ARENA (THE DIRECTORY, THE SYNTAX GRAPH, THE CODE TREE, THE SEMANTICS ARRAY, THE STACKS, THE HEADERS OF THE BLOCKS): NONE.  THEY HOLD INDICES, NAMES, FLAGS AND PACKED FIELDS.  A WORD THAT HAPPENS TO HAVE THE VALUE OF
     THE BASE (A PACKED FIELD OF 42 IN BITS 40 AND UP IS 2A0000000000 HEX) IS NOT AN ADDRESS: NO WORD OF THE ARENA IS SCANNED OR CHANGED BY THE LOAD.
   - THE VARIABLES OF THE MODULES THAT THE IMAGE SAVES, FIVE: THE BYTE POINTERS OF THE LEXER INTO ITS LINE AND ITS TOKEN, LEX:PC, LEX:QC, LEX:K0, LEX:K AND LEX:PC0 (THE LINE AND THE TOKEN ARE ARRAYS OF THE ARENA, STEPPED THROUGH BY BYTE
     POINTERS AS ON THE TAPE: THEY STAY POINTERS).  THE LIST IS IMGPTRNAME; THE LOAD ADDS THE DIFFERENCE OF THE BASES TO EACH ONE THAT HOLDS A VALUE OF THE OLD ARENA, ONCE, BEFORE THE LEXER IS USED.  FB ITSELF (IMPSEM:FB, THE SAME
     VARIABLE FOR ALL THE MODULES) IS SET TO THE BASE OF THE NEW ARENA.
   - THE PARAMETERS AND LOCAL VARIABLES OF ROUTINES (THEIR NAMES START WITH _25PAR OR _25 AND A NAME; THEY ARE STATIC): THE ONES OF FREE AND DIR AND LEX HOLD STALE ADDRESSES OF THE ARENA OR OF THE PROGRAM FROM THE LAST CALL.  THEY ARE
     ALWAYS ASSIGNED BEFORE THEY ARE READ, AND ARE NOT MOVED.
   - ADDRESSES OF THE PROGRAM (STATIC DATA, CODE, HEAP): NONE IN THE SAVED VARIABLES BUT THE STALE ONES JUST SAID.  THE ROUTINES OF THE SEMANTICS ARE SAVED BY NAME (SEMREMAP), THE REGISTRY BY THE NAME OF THE VARIABLE AND ITS OFFSET, THE CACHE
     OF THE ASSEMBLER NAMES (IX:SYMC, A HEAP ARRAY) IS NOT SAVED AND IS EMPTIED, THE FILE THE LEXER HAS OPEN IS NOT SAVED.
 THE FILE IS WORDS OF 8 BYTES AND BYTES: THE MAGIC, THE VERSION (6; THE EARLIER ONES NEEDED THE ARENA AT THE SAME ADDRESS AND ARE REFUSED), THE SIZE OF A POINTER, THE
 BUILD (A HASH OF THE LIST OF VARIABLES), THE ADDRESS OF THE ARENA, HOW MUCH OF IT, THE NUMBER OF VARIABLES AND OF ENTRIES OF THE REGISTRY OF THE ARRAYS THAT MOVE; THE VARIABLES (A LENGTH, THE NAME, THE SIZE, THE BYTES); THE
 ARENA; THE NAMES OF THE SEMANTIC ROUTINES IN THE ORDER OF THEIR IDS; THE REGISTRY (A LENGTH, THE NAME OF THE VARIABLE THAT POINTS AT THE ARRAY AND THE OFFSET IN IT, THE SECOND WORD OF THE ENTRY).#

VT,VN,IBUF,IBN,WV ARE COMMON;         # THE LIST OF THE VARIABLES (THREE WORDS EACH: ADDRESS, SIZE, NAME), HOW MANY; A BUFFER; A WORD #
NMB IS 40 LONG;
MB IS 24 LONG;
ONM IS 2 LONG;
CN1,CN2,CN3,CN4 ARE COMMON;                  # THE COUNTS OF THE CENSUS #

EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
# THE LIST OF THE VARIABLES OF THE MODULES THAT CAN BE WRITTEN, FROM THE LIBRARY; 0 IF THERE IS NONE #
SUBR IMGLIST(Z) IS (
 N ARE LOCAL;
 N:=IMPVARLIST(0,0);
 N<0 => RETURN 0;
 VT:=CCALL calloc(N+1,24);
 IMPVARLIST(VT,N);
 VN:=N;
 1);

SUBR IMGADDR(I) IS [VT+(24*I)];

SUBR IMGSIZE(I) IS [VT+((24*I)+8)];

SUBR IMGNAME(I) IS [VT+((24*I)+16)];

# NOT KEPT IN THE IMAGE #
SUBR IMGSKIP(NP) IS (
 CCALL strncmp(NP,LOC('impm:'),5)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('ix:'),3)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('image:'),6)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('driver:'),7)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('llvm:'),5)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('llvmgen:'),8)=0 => RETURN 1;
 CCALL strncmp(NP,LOC('ir2ll'),5)=0 => RETURN 1;                  # THE LLVM IR WRITER (IR2LL AND IR2LLX): ITS STATE IS A RUN'S, AND ITS COMMON VARIABLES ARE MEGABYTES #
 CCALL strcmp(NP,LOC('demit:USEDFS'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('dir:TGTSWAP'))=0 => RETURN 1;                  # THE BYTE ORDER OF THE TARGET IS A RUN'S #
 CCALL strcmp(NP,LOC('ix:TGTSWAP'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('dir:RTN'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('dir:NRTN'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('dir:CRTN'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('lex:SRCFP'))=0 => RETURN 1;
 CCALL strcmp(NP,LOC('free:RELP'))=0 => RETURN 1;
 0);

SUBR IMGFIND(NP) IS (
 I ARE LOCAL;
 I:=0;
 IF1: I<VN => (CCALL strcmp(IMGNAME(I),NP)=0 => RETURN I; I:=I+1; GO TO IF1);
 0-1);

# WHAT SAYS THE LISTS OF VARIABLES ARE THE SAME: A HASH OF THEIR NAMES AND SIZES #
SUBR IMGBUILD(Z) IS (
 H,I,Q,C,PP ARE LOCAL;
 H:=1469598103934665603;
 I:=0;
 IB1: I<VN => (PP:=IMGNAME(I); Q:=BYTEP [PP]<7,36>;
               IB2: C:=<+Q>; C NE 0 => (H:=(H XOR C)*1099511628211; GO TO IB2);
               H:=(H XOR IMGSIZE(I))*1099511628211;
               I:=I+1; GO TO IB1);
 H);

# THE VARIABLE THAT HAS THE ADDRESS A INSIDE IT: ITS INDEX, AND THE OFFSET IN IWV; 0-1 IF NONE #
SUBR IMGOWNER(A) IS (
 I ARE LOCAL;
 I:=0;
 IO1: I<VN => (A GE IMGADDR(I) => A<(IMGADDR(I)+IMGSIZE(I)) => (WV:=A-IMGADDR(I); RETURN I); I:=I+1; GO TO IO1);
 0-1);

SUBR IMGPUT(F,V) IS (WV:=V; CCALL fwrite(LOC(WV),8,1,F));

# THE NEXT WORD OF THE FILE F IN WV: 1 IF THERE WAS ONE #
SUBR IMGGET(F) IS (CCALL fread(LOC(WV),8,1,F)=1);

# THE CENSUS OF THE ABSOLUTE POINTERS (IMPIMGCENSUS IN THE ENVIRONMENT, AT THE SAVING): EVERY WORD OF EVERY VARIABLE OF THE LIST, AND EVERY WORD OF THE ARENA, WHOSE VALUE LIES IN THE ARENA [BASE,BASE+USED), AND THE
  VARIABLE WORDS WHOSE VALUE LIES NEAR THE PROGRAM'S OWN DATA (WITHIN 4 GB OF THE FIRST VARIABLE: THE STATIC DATA, THE HEAP, THE CODE) OR NEAR THE ARENA BUT OUTSIDE IT; A LINE FOR EACH, ON THE STANDARD ERROR #
SUBR IMGOWNERARR(J) IS (
 K,E ARE LOCAL;
 K:=FORGN;
 IA1: K NE FEND => (E:=FFWD(K);
                    J GE K => J<(K+4+FLENX(K)) => (ONM:=FREE(K+1); ONM[1]:=0; RETURN K);
                    K:=E; GO TO IA1);
 ONM:=0; ONM[1]:=0;
 0-1);

# THE VARIABLES THAT HOLD AN ADDRESS OF THE ARENA (THE CENSUS IN THE HEADER): THE LEXER'S BYTE POINTERS INTO ITS LINE AND ITS TOKEN.  THE IMAGE MOVES THEM WITH THE ARENA.  FB, THE BASE ITSELF, IS SET FROM THE ARENA #
SUBR IMGPTRNAME(K) IS (
 K=0 => RETURN LOC('lex:PC');
 K=1 => RETURN LOC('lex:QC');
 K=2 => RETURN LOC('lex:K0');
 K=3 => RETURN LOC('lex:K');
 K=4 => RETURN LOC('lex:PC0');
 0);

# 1 IF THE VARIABLE I OF THE LIST IS ONE THAT THE IMAGE MOVES WITH THE ARENA (OR IS FB) #
SUBR IMGISPTR(I) IS (
 K ARE LOCAL;
 IMGADDR(I)=LOC(FB) => RETURN 1;
 K:=0;
 IP1: IMGPTRNAME(K) NE 0 => (CCALL strcmp(IMGNAME(I),IMGPTRNAME(K))=0 => RETURN 1; K:=K+1; GO TO IP1);
 0);

# 1 IF V IS WITHIN 4 GB OF THE ARENA BUT OUTSIDE IT (A MAPPING), 2 IF WITHIN 4 GB OF A0 (THE PROGRAM'S DATA, HEAP, CODE), ELSE 0 #
SUBR IMGNEAR(V,BASE,USED,A0) IS (
 D ARE LOCAL;
 V<65536 => RETURN 0;
 D:=V-BASE;
 D<0 => D:=0-D;
 D<4294967296 => RETURN 1;
 D:=V-A0;
 D<0 => D:=0-D;
 D<4294967296 => RETURN 2;
 0);

SUBR IMGSKS(I) IS (IMGSKIP(IMGNAME(I)) NE 0 => RETURN LOC(' (not saved)'); IMGISPTR(I) NE 0 => RETURN LOC(' (moved)'); LOC(' '));

SUBR IMGCENSUS(BASE,USED) IS (
 I,J,V,N,A,D,K,A0 ARE LOCAL;
 A0:=IMGADDR(0);
 CCALL snprintf(LOC(MB),160,LOC('census: arena %ld..%ld, %ld variables'),BASE,BASE+USED,VN); OUTCS(LOC(MB)); OUTCHR(12B);
 I:=0;
 CV1: I<VN => (A:=IMGADDR(I); N:=IMGSIZE(I)/8; J:=0;
               CV2: J<N => (V:=[A+(8*J)];
                            V GE BASE => V<(BASE+USED) => (CCALL snprintf(LOC(MB),180,LOC('census: ARENA %s%s word %ld = base+%ld'),IMGNAME(I),IMGSKS(I),J,V-BASE);
                                                          OUTCS(LOC(MB)); OUTCHR(12B));
                            D:=IMGNEAR(V,BASE,USED,A0);
                            D NE 0 => (V GE BASE => V<(BASE+USED) => D:=0);
                            D NE 0 => (CCALL snprintf(LOC(MB),180,LOC('census: NEAR%ld %s%s word %ld = %ld'),D,IMGNAME(I),IMGSKS(I),J,V);
                                       OUTCS(LOC(MB)); OUTCHR(12B));
                            J:=J+1; GO TO CV2);
               I:=I+1; GO TO CV1);
 N:=USED/8; J:=0; K:=0;
 CA1: J<N => (V:=[BASE+(8*J)];
              V GE BASE => V<(BASE+USED) => (K:=K+1;
                                             IMGOWNERARR(J);
                                             CCALL snprintf(LOC(MB),180,LOC('census: IN-ARENA word %ld (array %s) = base+%ld'),J,LOC(ONM),V-BASE);
                                             OUTCS(LOC(MB)); OUTCHR(12B));
              J:=J+1; GO TO CA1);
 CCALL snprintf(LOC(MB),160,LOC('census: %ld words of the arena hold an address of the arena'),K); OUTCS(LOC(MB)); OUTCHR(12B);
 0);

SUBR IMGVERSION(Z) IS 6;

# IMPIMGSAVE(PATH): THE SWITCH U OR V: WRITE THE IMAGE; 1 IF ALL WENT WELL #
SUBR IMPIMGSAVE(P) IS (
 BASE,USABLE,USED,F,I,NK,K,L,A,O,S,NR ARE LOCAL;
 IMGLIST(0)=0 => GO TO NOTAB;
 BASE:=IMPCOREBASE(0);
 BASE NE 0 => GO TO HAVE;
 NOTAB: OUTSTR('imp: this compiler has no table of its variables to save (the modules were not compiled for it)'); OUTCHR(12B);
 RETURN 0;
 HAVE: USABLE:=IMPCOREUSED(0);
 USED:=FSIZE*8;
 USED>USABLE => USED:=USABLE;
 CCALL getenv(LOC('IMPIMGCENSUS')) NE 0 => IMGCENSUS(BASE,USED);
 NK:=0;
 (IMGSKIP(IMGNAME(I))=0 => NK:=NK+1) FOR I FROM VN-1;
 F:=CCALL fopen(P,LOC('wb'));
 F=0 => (CCALL perror(P); RETURN 0);
 CCALL fwrite(LOC('IMPIMG'),8,1,F);
 IMGPUT(F,IMGVERSION(0)); IMGPUT(F,IMPPTRSIZE(0)); IMGPUT(F,IMGBUILD(0)); IMGPUT(F,BASE); IMGPUT(F,USED); IMGPUT(F,NK); IMGPUT(F,NRELOC);
 I:=0;
 SV1: I<VN => (IMGSKIP(IMGNAME(I))=0 => (L:=CCALL strlen(IMGNAME(I))+1;
                                          IMGPUT(F,L); CCALL fwrite(IMGNAME(I),1,L,F);
                                          IMGPUT(F,IMGSIZE(I)); CCALL fwrite(IMGADDR(I),1,IMGSIZE(I),F));
               I:=I+1; GO TO SV1);
 CCALL fwrite(BASE,1,USED,F);
 NK:=SEMCOUNT(0);                                 # THE ROUTINES IN THE ORDER OF THEIR IDS, WHICH THE TABLES CARRY #
 IMGPUT(F,NK);
 K:=0;
 SV2: K<NK => (L:=CCALL strlen(SEMNAME(K))+1; IMGPUT(F,L); CCALL fwrite(SEMNAME(K),1,L,F); K:=K+1; GO TO SV2);
 I:=0;                                            # THE REGISTRY OF THE ARRAYS THAT MOVE: THE VARIABLE THAT POINTS AT EACH, AS A NAME AND AN OFFSET #
 SV3: I<NRELOC => (A:=[RELP+(16*I)]; S:=[RELP+((16*I)+8)];
                   O:=0-1;
                   A NE 0 => O:=IMGOWNER(A);
                   A NE 0 => O<0 => (CCALL snprintf(LOC(MB),160,LOC('imp: a pointer variable of the free storage (slot %ld) is not one the image knows'),I);
                                      OUTCS(LOC(MB)); OUTCHR(12B));
                   O<0 => IMGPUT(F,0)
                     ELSE (L:=CCALL strlen(IMGNAME(O))+1; NR:=WV; IMGPUT(F,L); CCALL fwrite(IMGNAME(O),1,L,F); IMGPUT(F,NR));
                   IMGPUT(F,S);
                   I:=I+1; GO TO SV3);
 CCALL impfclose(F)=0 => RETURN 1;
 CCALL perror(P);
 0);

# IMPIMGLOAD(PATH): THE OPTION -I: PUT THE IMAGE BACK; 1 IF ALL WENT WELL #
SUBR IMPIMGLOAD(P) IS (
 F,I,K,L,N,SZ,V,NMN,RN,A,OFF,S,VERS,PS,BLD,BASE,USED,NV,NR,NQ,NAMES,T,NEWB,DELTA,W ARE LOCAL;
 IMGLIST(0)=0 => (OUTSTR('imp: this compiler cannot load an image'); OUTCHR(12B); RETURN 0);
 F:=CCALL fopen(P,LOC('rb'));
 F=0 => (CCALL perror(P); RETURN 0);
 CCALL fread(LOC(NMB),8,1,F)=1 => CCALL memcmp(LOC(NMB),LOC('IMPIMG'),8)=0 => GO TO LD1;
 GO TO NOTIMG;
 LD1: IMGGET(F)=0 => GO TO BAD; VERS:=WV;
 IMGGET(F)=0 => GO TO BAD; PS:=WV;
 IMGGET(F)=0 => GO TO BAD; BLD:=WV;
 IMGGET(F)=0 => GO TO BAD; BASE:=WV;
 IMGGET(F)=0 => GO TO BAD; USED:=WV;
 IMGGET(F)=0 => GO TO BAD; NV:=WV;
 IMGGET(F)=0 => GO TO BAD; NR:=WV;
 VERS NE IMGVERSION(0) => GO TO NOTIMG;
 PS NE IMPPTRSIZE(0) => GO TO NOTIMG;
 BLD NE IMGBUILD(0) => (OUTSTR('imp: '); OUTCS(P); OUTSTR(' was saved by another build of the compiler'); OUTCHR(12B);
                        CCALL impfclose(F); RETURN 0);
 NEWB:=IMPCOREAT(BASE,USED);                                          # THE ARENA, WHERE IT WAS SAVED IF THE SYSTEM GIVES THAT ADDRESS, ELSE ANYWHERE #
 NEWB=0 => (OUTSTR('imp: cannot make the free storage of '); OUTCS(P); OUTSTR(' usable'); OUTCHR(12B);
            CCALL impfclose(F); RETURN 0);
 I:=0;
 LD2: I<NV => (IMGGET(F)=0 => GO TO BAD; L:=WV;                      # THE VARIABLES #
               L>300 => GO TO BAD;
               CCALL fread(LOC(NMB),1,L,F) NE L => GO TO BAD;
               IMGGET(F)=0 => GO TO BAD; SZ:=WV;
               SZ+1 > IBN => (IBN:=SZ+64; IBUF:=CCALL realloc(IBUF,IBN));
               CCALL fread(IBUF,1,SZ,F) NE SZ => GO TO BAD;
               V:=IMGFIND(LOC(NMB));
               V GE 0 => IMGSIZE(V)=SZ => CCALL memcpy(IMGADDR(V),IBUF,SZ);
               I:=I+1; GO TO LD2);
 CCALL fread(NEWB,1,USED,F) NE USED => GO TO BAD;                      # THE ARENA #
 DELTA:=NEWB-BASE;                                                     # THE ARENA IS ELSEWHERE: THE ADDRESSES OF IT THAT THE VARIABLES HOLD MOVE WITH IT #
 FB:=NEWB;
 DELTA NE 0 => (K:=0;
                LD5: IMGPTRNAME(K) NE 0 => (V:=IMGFIND(IMGPTRNAME(K));
                                            V GE 0 => IMGSIZE(V) GE 8 => (W:=[IMGADDR(V)];
                                                                          W GE BASE => W<(BASE+USED) => [IMGADDR(V)]:=W+DELTA);
                                            K:=K+1; GO TO LD5));
 SYMC NE 0 => CCALL memset(SYMC,0,8*NSYMC);                           # THE DIRECTORY IS ANOTHER: THE NAMES ARE MADE AGAIN #
 IMGGET(F)=0 => GO TO BAD; N:=WV;                                      # THE SEMANTIC ROUTINES #
 N>100000 => GO TO BAD;
 NAMES:=CCALL calloc(N+1,8);
 K:=0;
 LD3: K<N => (IMGGET(F)=0 => GO TO BAD; L:=WV; L>300 => GO TO BAD;
              T:=CCALL malloc(L);
              [NAMES+(8*K)]:=T;
              CCALL fread(T,1,L,F) NE L => GO TO BAD;
              K:=K+1; GO TO LD3);
 SEMREMAP(NAMES,N)=0 => (CCALL impfclose(F); RETURN 0);
 RELP:=CCALL calloc(NR+1,16);                                          # THE REGISTRY #
 I:=0;
 LD4: I<NR => (IMGGET(F)=0 => GO TO BAD; L:=WV;
               A:=0;
               L>0 => (L>300 => GO TO BAD;
                       CCALL fread(LOC(NMB),1,L,F) NE L => GO TO BAD;
                       IMGGET(F)=0 => GO TO BAD; OFF:=WV;
                       V:=IMGFIND(LOC(NMB));
                       V GE 0 => A:=IMGADDR(V)+OFF);
               IMGGET(F)=0 => GO TO BAD; S:=WV;
               [RELP+(16*I)]:=A; [RELP+((16*I)+8)]:=S;
               I:=I+1; GO TO LD4);
 NRELOC:=NR;
 CCALL impfclose(F);
 RETURN 1;
 NOTIMG: OUTSTR('imp: '); OUTCS(P); OUTSTR(' is not an image of this kind of compiler'); OUTCHR(12B);
         CCALL impfclose(F); RETURN 0;
 BAD: OUTSTR('imp: '); OUTCS(P); OUTSTR(' is damaged'); OUTCHR(12B);
      CCALL impfclose(F);
      0)
%%
