TWOSEG;
# PARSE:  THE IRONS FAST MULTI-TRACK PARSER WITH MODIFICATIONS,
    ERROR CORRECTION AND DISAMBIGUATION BY BILOFSKY, FOR THE 64 BIT PORT.
    SEE DECUS/PARSE.IMC FOR THE ORIGINAL AND ITS COMMENTS, DOCS/PORTING/PARSE.MD FOR
    THE DIFFERENCES.

   PARSES ARE COPIED FROM FREE STORAGE ARRAY P TO ARRAY PP.
   OUTPUT IS STORED IN A FORWARD LINKED LIST,
   FIRST-IN-LAST-OUT, IN FREE STORAGE ARRAY O.
   WHEN A UNIQUE PARSE IS ENCOUNTERED, THE OUTPUT IS
   EXTRACTED AND REVERSED, AND O IS CLEANED OUT.

  THE FORMAT FOR PARSE ENTRIES IS (HALVES ARE 32 BITS):
      WD 0   LEFT: OUTPUT CHAIN POINTER   RIGHT: OFFSET OF LAST PAIR
      WD 1                                CURRENT NODE
      WD 2 ON   LEFT: NODE INVOKING GOAL  RIGHT: NT NR OF GOAL

  AND FOR OUTPUT ENTRIES:
      LEFT HALF: PRODUCTION NR. OR -DIR INDEX OF NAME (A 32 BIT NUMBER)
      RIGHT HALF: INDEX OF NEXT WORD IN CHAIN
  (THE ORIGINAL'S COMMENT HAS THE HALVES THE OTHER WAY ROUND; ITS CODE IS AS HERE.)

  THE NEXT WORD OF P,PP,O IS NP,NPP,NO.
  THE NUMBER OF PARSES IN P,PP IS PN,PPN.

  THE SYNTAX GRAPH MUST REFER TO NODES MATCHING ANY NAME BY THE FUNNY
      TERMINAL SYMBOL "NAM"+NUMBER-SIGN, SYMBOLS BY "SYM"+NUMBER-SIGN.
  THE PARSER USUALLY GETS SYMBOLS FROM SUBR LEX, BUT SYMBOLS MAY BE
      INSERTED IN THE STREAM BY CALLING PFORCE(DIR INDEX) FOR EACH
      SYMBOL TO BE INSERTED, ON A LAST-IN-FIRST-OUT BASIS.

  THE C ROUTINES THAT THIS CALLS ARE CALLED THROUGH STAGE0/IMPGLUE.C, BY REFERENCE:
  IMPGGOAL, IMPGNEXT, IMPGNT2TX, IMPGMADE, IMPGPOUT1, IMPGPOUT2, IMPISNAME, IMPERCOR,
  IMPAMBIG, IMPCOTREE, IMPLEX, IMPPARTR1, IMPMSG, IMPOUTSTR, IMPPLINE1.  THE STATISTICS
  ARE COMMON FOR STAGE0/PARSE_IMP.C, WHICH PRINTS THEM (PSTATS). #

PSTS,PSPN,PSPNT,PSPS,PSPST,PSOS,AMTIME,PSTT,SRTT ARE COMMON;

SUBR PARSE(GOAL) IS (
FINAM IS COMMON; TR_FINAM[5] AND 100B;
 PSTS_PSPN_PSPNT_PSPS_PSPST_PSOS_AMTIME_0;
 PSTT_-IMPMSEC(0); SRTT_0;
 PINIT=0=>(PINIT_1;
          P_FALLOT('P/P',400);
          PP_FALLOT('P/PP',150);
          FRELOT(O,'P/OUT',100,0));
 NO_1; PN_OPN_1; GOTIT_0;
 GOL_GOAL; GOLE_DPROP('NODE',GOL); J_IMPGGOAL(GOL);
 FREES(P,2); FREES(P+1,J); FREES(P+2,GOLE OR J LS HSH); NP_3;
 S IS 3 LONG; S[1]_DIR('SYM#'); S[2]_DIR('NAM#');

 NEXTS: SYMBOL(S);  PSTS_PSTS+1;
        (NAME_DPROP('ISNM',S)-1)<0=>DPROPS('ISNM',S,(IMPISNAME(S))+1);
        NAME_IMPISNAME(S);
        TR=>(PRINT /,STG 0,'NEXT INPUT SYMBOL: '; IMPPNAME(S);
             PRINT STG 0,', ',IGR 0,PN,STG 0,' POSSIBLE PARSES.',/);
        PPN_IP_IPP_NPP_PI_0;
 NEXTP: L_P+IP;
        COFF_FREE(L) AND HMASK;
        NXIP_IP+COFF+1;
        TR=>(PRINT STG 0,'  PARSE #', IGR 0, PI+1);
        CGOAL_FREE(L+COFF) AND HMASK;
        CNODE_FREE(L+1);
 NEXTN: CVAL_GVAL(CNODE);
        TR=>IMPPARTR1(CNODE,GTYPE(CNODE),CVAL,P,IP,O,IP+COFF);
        GO TO (NTWANTED,TWANTED,NTMADE,OUTPUT) GTYPE(CNODE);

 TWANTED: (CVAL=S[I] => (J_COPY(PP,NPP,PPN);
                         K_IMPGNEXT(SCR(CNODE),CGOAL);
                         FREES(J+1,K);
                         TR=>(PRINT STG  0,'      MATCH FOR '; IMPPNAME(CVAL);
                              PRINT STG 0,' SO NEW PARSE #',IGR 0,PPN,STG 0,
                                  ' IS MADE.',/);
                         I=>POUT(J,-S);
                         GO TO TAKEALT)) FOR I FROM NAME;
          GO TO TAKEALT;

 OUTPUT: J_CNODE;
     L1: (J_IMPGNEXT(ALT(J),CGOAL))=>(K_COPY(P,NP,PN);
                                   TR=>(PRINT STG 0,'      PARSE #',IGR 0,PN,
                                           STG  0,' SPAWNED FOR ALT NODE.',/);
                                   FREES(K+1,J);
                                   GO TO L1);
         POUT(P+IP,CVAL);
         CNODE_SCR(CNODE);
         GO TO NEXTN;

 NTWANTED: NGOAL_DPROP('NODE',CVAL);
           (ENT_DPROP('ENTRY',S[I]);
            J_IMPGNEXT(SCR(ENT),NGOAL);
            J=>(K_COPY(PP,NPP,PPN);
                TR=>(PRINT STG 0,'      '; IMPPNAME(S[I]);
                     PRINT STG 0,' -> '; IMPPNAME(CVAL);
                     PRINT STG 0,' AT NODE #',IGR 0,ENT,STG 0,
                       ' SO NEW PARSE #',IGR 0,PPN,STG 0,' IS FORMED.',/);
                FREES(K,FREE(K)+1);
                FREES(K+1,J);
                I=>POUT(K,-S);
                FADD(PP,NPP,NGOAL OR CNODE LS HSH))) FOR I FROM NAME;
           GO TO TAKEALT;

 NTMADE: NTN_DPROP('NODE',CVAL);
         (TNODE_DPROP('NODE',S[I]);
          L2: TNODE => IMPGNT2TX(NTN,TNODE,CGOAL,NNODE) =>
                   (K_COPY(P,NP,PN);
                    TR=>(PRINT STG 0,'      "'; IMPPNAME(S[I]);
                         PRINT STG 0,'" MAY CONTINUE SO PARSE #',
                            IGR 0,PN,STG 0,' IS SPAWNED.',/);
                    FREES(K+1,NNODE);
                    IMPGPOUT1(CNODE,NNODE,K);
                    GO TO L2)) FOR I FROM NAME;
         NTN=CGOAL => GO TO L3;
         IMPGMADE(CNODE,CGOAL)=>(IMPGPOUT2(CNODE,CGOAL,P+IP);
                              L3: CGOAL=GOLE=>(COPY(PP,NPP,PPN);
                                               GOTIT_1;
                                               GO TO TAKEALT);
                              K_COPY(P,NP,PN);
                              L_K;
                              FREES(L,FREE(L)-1);
                              NP_NP-1; LL_P+NP;
                              J_FREE(LL) RS HSH;
                              NGOAL_FREE(LL-1) AND HMASK;
                              J_IMPGNEXT(SCR(J),NGOAL);
                              FREES(L+1,J);
                              TR=>(PRINT STG 0,'      GOAL REACHED SO PARSE #',
                                         IGR 0,PN,STG 0,' IS SPAWNED.',/));

 TAKEALT: (CNODE_IMPGNEXT(ALT(CNODE),CGOAL))=>
                (TR=>PRINT STG 0,'   ALT NODE TAKEN.'; GO TO NEXTN);
          IP_NXIP; (PI_PI+1)<PN => GO TO NEXTP;

 CKNP: PPN>1=> (FINAM[5] AND 200000000B=>AMTIME_AMTIME-1+IMPMSEC(0);
		IMPAMBIG(PP,NPP,PPN,O,TR);
		FINAM[5] AND 200000000B=>AMTIME_AMTIME+IMPMSEC(0));
       PPN>1=>(GOTIT=>ERROR(1,'SYNTACTIC AMBIGUITY; UNRESOLVED AT % **');
               GO TO END1SYM);
       PPN=0=>(#PARSE TREE DIED - DO ERROR CORRECTION#
               FINAM[5]_FINAM[5] OR 4000B; #LIST#
	       IMPPLINE1(OL);
               IMPOUTSTR('** SYNTAX ERROR ');
               PRINT STG OL+4,'^',/,
                     STG 0,'** SYNTAX ERROR ','- "';
               L_J_IMPERCOR(P,OPN,S);
               IMPMSG('**');
               ERROR(1,0);
               PRINT STG 0,'" IS REPLACED BY "';
               L4: (K_FREE(J))=>(IMPPNAME(K); J_J+1;
                                  PRINT STG 0,' '; GO TO L4);
               PRINT STG 0,'"',/;
               PFORCE(FREE(I)) FOR I IN J-1,-1,L;
               FALLOT(L,0);
               NP_NOP; PN_OPN; GO TO NEXTS);

 #THERE IS JUST 1 PARSE; FEED OUT OUTPUT.#
 (J_FREE(PP) RS HSH) => (IMPPUSHMI(0);
                        L5: J => (J_FREE(O+J); K_J ARS HSH;
                                  IMPPUSHMI(K);
                                  J_J AND HMASK; GO TO L5);
                        FINAM[5] AND 243130160B=>(
			   K_IMPMSEC(0); PSTT_PSTT+K; SRTT_SRTT-1+K);
                        L6: (K_IMPPULLYU(0)) => (IMPCOTREE(K); GO TO L6);
                        FINAM[5] AND 243130160B=>(
			   K_IMPMSEC(0); PSTT_PSTT-1+K; SRTT_SRTT+K));
 NO>PSOS=>PSOS_NO; NO_1;
 FREES(PP,FREE(PP) AND HMASK);

 END1SYM: NPP>PSPS=>PSPS_NPP;    PPN>PSPN=>PSPN_PPN;
          NP>PSPST=>PSPST_NP;    PN>PSPNT=>PSPNT_PN;
 GOTIT=0=>(J_P; P_PP; PP_J;
          PN_OPN_PPN;
          NOP_NP_NPP; GO TO NEXTS);
 PSTT_PSTT+IMPMSEC(0));

SUBR SYMBOL(SS) IS (
 NSYMBS=>(NSYMBS_NSYMBS-1; SS_FREE(SYMBS+NSYMBS))
     ELSE  OL_IMPLEX(SS);  0);

SUBR PFORCE(SY) IS (
 KNIT=0=>(KNIT_1; NSYMBS_0; FRELOT(SYMBS,'P/SYM',20,0));
 FADD(SYMBS,NSYMBS,SY));

SUBR COPY(QQ,NQQ,QQN) IS (
 # COPIES OLD PARSE FROM P+IP INTO QQ+NQQ AND
  RETURNS FREE STORAGE POINTER TO FIRST WORD OF NEW PARSE.#
 QQN_QQN+1;
 COPYV_NQQ;
 NQQ_NQQ+COFF+1;
 FLEN(QQ)<NQQ => FADDEX(QQ,NQQ);
 COPYV_COPYV+QQ;
 FREES(COPYV+K,FREE(P+IP+K)) FOR K TO COFF;
 COPYV);

SUBR POUT(QQ,VV) IS (#PUTS OUTPUT VV ON PARSE CHAIN AT QQ#
 TR=>(PRINT STG 0,'      '; VV<0=>IMPPNAME(-VV) ELSE (PRINT '[',OCT 0,VV,
         STG 0,']'); PRINT STG 0,' ADDED TO OUTPUT.',/);
 Q_FREE(QQ) RS HSH; FREES(QQ,(FREE(QQ) AND HMASK) OR (NO LS HSH));
 FADD(O,NO,Q OR (VV LS HSH)));

SUBR PARSEF() IS (
 FALLOT(PP,0); FALLOT(P,0); FALLOT(O,0); PINIT_0) %%%
