TWOSEG;
FORGN,FEND,NRELOC,FALLN ARE COMMON;        # THE C SIDE READS THEM (SRC/SHARED.TXT); FB IS DECLARED BY IMPSYN64 #
FINAM IS COMMON;
#THIS IS FILE FREE, THE FREE STORAGE MODULE OF THE 64 BIT PORT: THE ALLOCATION ROUTINES OF DECUS/FREE.IMC.
 THE ARENA IS A BLOCK OF 64 BIT WORDS AT THE ADDRESS FB (ADDRESS SPACE RESERVED ONCE AND MADE USABLE BY CORE, WHERE THE
 ORIGINAL GREW THE LOW SEGMENT WITH CORE; IT NEVER MOVES); AN ARRAY IS NAMED BY THE INDEX OF ITS FIRST DATA WORD, AND HAS
 A FOUR WORD HEADER:

        WORD 0  LEFT   INDEX OF THE HEADER BEFORE      RIGHT  INDEX OF THE HEADER AFTER   (32 BIT HALVES)
        WORD 1  THE NAME, UP TO EIGHT CHARACTERS, THE FIRST IN THE TOP BYTE
        WORD 2  LEFT   THE INCREMENT FOR FADD         RIGHT  THE LENGTH
        WORD 3  0 FOR A FIXED ARRAY; -1 WHILE IT IS BEING PACKED; ELSE 1 + A SLOT OF THE REGISTRY OF
                RELOCATABLE ARRAYS, WHICH HOLDS THE ADDRESS OF THE C VARIABLE THAT POINTS AT THE ARRAY
                AND THE ADDRESS OF A C ROUTINE TO CALL AFTER IT MOVES (THE ORIGINAL HAD LOC(A),,S)

 THE HEADERS ARE A DOUBLY LINKED LIST FROM A DUMMY HEADER AT FORGN TO ONE AT FEND.  FALLOT, FRELOT AND THE REST HAVE THE
 NAMES AND THE MEANING OF THE ORIGINAL'S.  WHAT DIFFERS, AND WHY (SEE ALSO DOCS/PORTING/MODULES.MD):
   - CORE MAKES MORE OF A RESERVED ADDRESS SPACE USABLE (STAGE0/SYS.C) WHERE THE ORIGINAL ASKS THE MONITOR FOR MORE LOW SEGMENT: THE ARENA GROWS IN PLACE, AS
     THE LOW SEGMENT DOES, SO A BYTE POINTER INTO AN ARRAY STAYS GOOD UNTIL THE ARRAY ITSELF IS MOVED.  AN ARRAY IS NAMED BY AN INDEX, NOT
     A WORD ADDRESS.  A POINTER VARIABLE REGISTERED WITH FRELOT IS
     STILL UPDATED AFTER A MOVE OF ITS ARRAY (FFIXER); THE ROUTINE TO CALL AFTER A MOVE (THE ORIGINAL'S S) IS NOT NEEDED.
   - THE ORIGINAL TELLS A NAME FROM AN ARRAY IN FALLOT(A,N) BY A RS 18; A NAME OF EIGHT CHARACTERS IN A 64 BIT WORD CANNOT BE
     TOLD FROM AN INDEX, SO A NEW NAMED ARRAY IS FNEW(NAME,N) (FRELOT CALLS IT).  THE PLACING OF THE NEW ARRAY, THE COUNT AND THE TRACE ARE IN LINE IN FNEW AND FALLOT, AS ON THE TAPE.
   - FBACK, FFWD, FLENX, FSETB, FSETF AND FSETL ARE THE ORIGINAL'S [X]<L>, [X]<R>, [X+2]<R> AND THEIR ASSIGNMENTS: THE IR MACHINE
     HAS NO HALFWORD OPERATIONS, SO THE HALVES ARE TAKEN APART WITH HL AND HR.
   - THE BLT THAT SLIDES AN ARRAY IS MEMMOVE.  FMAP AND FSTATS PRINT WITH PRINT AS THE ORIGINAL.#

SUBR FBACK(X) IS HL(FREE(X));
SUBR FFWD(X) IS HR(FREE(X));
SUBR FSETB(X,V) IS FREES(X,HW(V,HR(FREE(X))));
SUBR FSETF(X,V) IS FREES(X,HW(HL(FREE(X)),V));
SUBR FLENX(X) IS HR(FREE(X+2));
SUBR FSETL(X,N) IS FREES(X+2,HW(HL(FREE(X+2)),N));

# CORE(K): MAKE THE ARENA K+1 WORDS (INDICES 0..K).  RETURNS 1 FOR SUCCESS.  THE ARENA GROWS IN PLACE, AS THE LOW SEGMENT DOES: ITS ADDRESS SPACE IS RESERVED WHEN
  IT IS FIRST ASKED FOR (STAGE0/SYS.C), SO THE ADDRESSES OF THE ARRAYS, AND THE BYTE POINTERS INTO THEM, NEVER CHANGE #
SUBR CORE(K) IS (
 K+1 LE FSIZE => RETURN 1;
 FB=0 => (FB_CCALL IMPCOREBASE(0); FB=0 => RETURN 0);
 CCALL IMPCORESET(8*(K+1))=0 => RETURN 0;
 FSIZE_K+1;
 1);

SUBR FINIT(NIL) IS (
 FORGN=0 => FORGN_8;                       # NOT 0: HEADER INDEX 0 MEANS NO ARRAY TO FGAP #
 K_1777B OR (FORGN+7);
 CORE(K)=0 => (ERROR(0,'CANNOT GET CORE TO INITIALIZE FREE STORAGE. '); RETURN 0);
 FEND_K-3;
 FREES(FORGN,HW(0,FEND)); FREES(FEND,HW(FORGN,0));
 FREES(FORGN+1,'FORGN');
 FREES(FORGN+2,0); FREES(FORGN+3,0);
 FREES(FEND+1,0); FREES(FEND+2,0); FREES(FEND+3,0);
 INCNOM_8; INITD_1;
 0);

# FALLOT(NAME,N): A NEW ARRAY OF N WORDS.  NM IS THE PACKED NAME.  RETURNS THE INDEX OF THE FIRST DATA WORD. #
SUBR FNEW(NM,N) IS (
 FNB IS 2 LONG;
 Y,X,PACKED,PW,PX ARE LOCAL;
 INITD=0 => FINIT(0);
 (TRACE OR (FINAM[5] AND 200000000B)) NE 0 => FALLN_FALLN+1;
 TR_6;
 N LE 0 => RETURN 0;
 PACKED_0;
 NL1: Y_FGAP(N+4);
 Y=0 => (FTOP(N+4) NE 0 => Y_FBACK(FEND));
 Y NE 0 => GO TO NL2;
 PACKED NE 0 => (FNB_NM; FNB[1]_0;       # NO HEADER YET: THE NAME IS PRINTED AS FALOTR DOES #
                 PRINT STG 0,'FALLOT ',STG 0,FNB,STG 0,' ',IGR 0,N,/; FMAP(0);
                 ERROR(0,'FREE STORAGE EXHAUSTED. '); RETURN 0);
 FPACK(0); PACKED_1; GO TO NL1;
 NL2: PW_FFWD(Y); PX_Y+4+FLENX(Y);                          # PLACE THE ARRAY AFTER Y, ZEROED #
 FREES(PX,HW(Y,PW)); FREES(PX+1,NM); FREES(PX+2,HW(0,N)); FREES(PX+3,0);
 CCALL MEMSET(FB+8*(PX+4),0,8*N);
 FSETF(Y,PX); FSETB(PW,PX);
 X_PX;
 TRACE NE 0 => (FALOTR(X,N);
                (TRACE AND 6) NE 0 => FMAP(0));
 X+4);

# FALLOT(A,N): SET THE LENGTH OF ARRAY A TO N, MOVING IT IF NEED BE, AND RETURN ITS POINTER; N LE 0 DELETES IT. #
SUBR FALLOT(A,N) IS (
 X,V,W,LX,Y,K,MM,X3SV,I,S ARE LOCAL;
 INITD=0 => FINIT(0);
 (TRACE OR (FINAM[5] AND 200000000B)) NE 0 => FALLN_FALLN+1;
 TR_4; X_A-4; V_FBACK(X); W_FFWD(X); LX_FLENX(X);
 N LE 0 => (FSETF(V,W); FSETB(W,V);
            S_FREE(X+3); S>0 => S LE NRELOC => [RELP+16*(S-1)]_0;       # FREE ITS SLOT IN THE REGISTRY #
            TRACE NE 0 => FALOTR(X,N);
            RETURN 0);
 N+4 LE W-X => GO TO FA1;
 TR_6;
 Y_V+4+FLENX(V);
 N+4 LE W-Y => GO TO FA2;
 Y_FGAP(N+4);
 Y NE 0 => GO TO FA4;
 MM_N+4; FFWD(X)=FEND => MM_N-LX;
 FTOP(MM) NE 0 => (Y_FBACK(FEND); Y=X => GO TO FA1; GO TO FA4);
 X3SV_FREE(X+3); FREES(X+3,0-1); XFIX_X;     # PACK, REMEMBERING WHERE X ENDS UP #
 FPACK(0); X_XFIX; FREES(X+3,X3SV);
 Y_FGAP(N+4);
 Y NE 0 => (Y=X => GO TO FA1; GO TO FA4);
 MM_N+4; FFWD(X)=FEND => MM_N-LX;
 FTOP(MM) NE 0 => (Y_FBACK(FEND); Y=X => GO TO FA1; GO TO FA4);
 FALOTR(X,N); FMAP(0);
 ERROR(0,'FREE STORAGE EXHAUSTED. ');
 RETURN 0;
FA4: V_FBACK(X); W_FFWD(X);                   # MOVE X TO JUST AFTER ARRAY Y #
 FSETF(V,W); FSETB(W,V);
 V_Y; W_FFWD(Y);
 FREES(X,HW(V,W));
 Y_V+4+FLENX(V);
FA2: CCALL MEMMOVE(FB+8*Y,FB+8*X,8*(LX+4));  # MOVE X DOWN TO Y #
 FSETF(V,Y); FSETB(W,Y);
 X_Y;
FA1: FSETL(X,N);                              # X HAS ROOM: SET ITS LENGTH AND CLEAR THE NEW WORDS #
 Y_X+4+LX; K_(N-1)-LX;
 K GE 0 => (FREES(Y+I,0) FOR I FROM K);
 FFIXER(X);
 TRACE NE 0 => (FALOTR(X,N);
                (TRACE AND TR AND 2) NE 0 => FMAP(0)
                  ELSE ((TRACE AND 4) NE 0 => FMAP(0)));
 X+4);

# FRELOT(A,NM,N,S): A RELOCATABLE ARRAY: A IS THE ADDRESS OF THE C VARIABLE THAT POINTS AT IT, S THE ADDRESS OF THE
  C ROUTINE TO CALL AFTER IT MOVES (OR 0).  RETURNS THE POINTER. #
SUBR FRELOT(A,NM,N,S) IS (
 X,SL,P,QQ ARE LOCAL;
 X_FNEW(NM,N)-4;
 SL_0;
 RL1: SL<NRELOC => ([RELP+16*SL]=0 => GO TO RL2;
                    SL_SL+1; GO TO RL1);
 P_CCALL REALLOC(RELP,16*(NRELOC+16));
 P=0 => (ERROR(0,'OUT OF MEMORY FOR RELOCATION TABLE. '); RETURN 0);
 RELP_P;
 CCALL MEMSET(RELP+16*NRELOC,0,16*16);
 NRELOC_NRELOC+16;
RL2: [RELP+16*SL]_LOC(A);
 QQ_RELP+16*SL; QQ_QQ+8; [QQ]_S;                     # THE SECOND WORD OF THE ENTRY: A POINTER VARIABLE, FOR [X+8] IS 8 BYTES OR 8 WORDS DEPENDING ON THE FORM OF X #
 FREES(X+3,SL+1);
 FFIXER(X);
 A);

# FFIXER(X): THE ARRAY AT HEADER X HAS (MAYBE) MOVED; TELL ITS OWNER #
SUBR FFIXER(X) IS (
 Y ARE LOCAL;
 Y_FREE(X+3);
 Y=0 => RETURN 0;
 Y=(0-1) => (XFIX_X; RETURN 0);
 [[RELP+16*(Y-1)]]_X+4;
 0);                                          # THE ROUTINE TO CALL AFTER A MOVE (THE ORIGINAL'S S OF FRELOT) IS NOT NEEDED: THE MODULES KEEP INDICES #

# FGAP(N): THE HEADER OF THE ARRAY AFTER WHICH THERE IS THE SMALLEST GAP OF AT LEAST N WORDS, OR 0.  THE GAP BEFORE
  FEND IS NOT COUNTED (FTOP'S JOB). #
SUBR FGAP(N) IS (
 K,K0,K1,K2,K3 ARE LOCAL;
 K_FORGN; K0_0; K1_1 LS 62;
 WHILE K NE FEND DO (K2_FFWD(K);
                     K NE FBACK(K2) => (FMAP(0);
                                        ERROR(0,'FREE STORAGE UNLINKED. '); RETURN 0);
                     K2 NE FEND => (K3_K2-(K+4+FLENX(K));
                                    N LE K3 => K3<K1 => (K0_K; K1_K3));
                     K_K2);
 K0);

# FPACK: SLIDE RELOCATABLE ARRAYS DOWN OVER THE GAPS, FILLING A GAP THAT A FIXED ARRAY LEAVES WITH THE LARGEST
  RELOCATABLE ARRAY THAT FITS. #
SUBR FPACK(NIL) IS (
 I,J,J1,K,K0,K1,K2,KB,KF ARE LOCAL;
 I_FORGN;
FP0: J_FFWD(I);
 J=FEND => RETURN 0;
 J1_I+4+FLENX(I);
 J1=J => (I_J; GO TO FP0);
 FREE(J+3) NE 0 => (FSETF(I,J1); K_FFWD(J); FSETB(K,J1);          # J CAN MOVE DOWN TO J1 #
                    CCALL MEMMOVE(FB+8*J1,FB+8*J,8*(FLENX(J)+4));
                    FFIXER(J1);
                    I_J1; GO TO FP0);
 K_FFWD(J); K0_0; K1_0;                                           # J IS FIXED: THE LARGEST THAT FITS THE GAP #
 WHILE K NE FEND DO (FREE(K+3) NE 0 => (K2_J1+3+FLENX(K);
                                        K2<J => K2>K1 => (K0_K; K1_K2));
                     K_FFWD(K));
 K0=0 => (I_J; GO TO FP0);
 CCALL MEMMOVE(FB+8*J1,FB+8*K0,8*(FLENX(K0)+4));
 FSETF(I,J1); FSETB(J,J1);
 KB_FBACK(J1); KF_FFWD(J1);                                       # THE OLD NEIGHBOURS OF THE MOVED ARRAY #
 FREES(J1,HW(I,J));
 FSETF(KB,KF); FSETB(KF,KB);
 FFIXER(J1);
 I_J1; GO TO FP0);

# FTOP(N): MAKE SURE N WORDS ARE FREE BEFORE FEND, GROWING THE ARENA IF NEED BE.  RETURNS -1 FOR SUCCESS, 0 NOT. #
SUBR FTOP(N) IS (
 K,TOP,Y ARE LOCAL;
 K_FBACK(FEND);
 K_FEND-(K+4+FLENX(K));
 N LE K => RETURN (0-1);
 TOP_1777B OR (FEND+3+(N-K));
 CORE(TOP)=0 => RETURN 0;
 K_TOP-3;
 FREES(K,FREE(FEND)); FREES(K+1,0); FREES(K+2,0); FREES(K+3,0);
 Y_FBACK(K); FSETF(Y,K);
 FEND_K;
 0-1);

SUBR FADDEX(A,N) IS (
 K_HL(FREE(A-2));
 K=0 => K_INCNOM;
 K LE 0 => K_1;
 A_FALLOT(A,N+K));

SUBR FINCSET(A,N) IS (
 A=0 => INCNOM_N
   ELSE (N GE 0 => FREES(A-2,HW(N,FLENX(A-4))));
 0);

SUBR FTRACE(V) IS TRACE_V;

SUBR FCLOSE(NIL) IS (
 X,Y,I ARE LOCAL;
 FPACK(0);
 X_FBACK(FEND);
 Y_X+4+FLENX(X);
 FREES(Y+I,FREE(FEND+I)) FOR I FROM 3;
 FSETF(X,Y); FEND_Y;
 FORGN_Y+4;                                 # A LATER FINIT OPENS A NEW AREA ABOVE THE OLD #
 INITD_0;
 0);

SUBR FNAME(A) IS FREE(A-3);

# THE TRACE OF A CALL ON FALLOT #
SUBR FALOTR(X,N) IS (
 FNB IS 2 LONG; FNB_FREE(X+1); FNB[1]_0;
 PRINT STG 0,'FALLOT ',STG 0,FNB,STG 0,' ',IGR 0,N,/;
 0);

SUBR FMAP(NIL) IS (
 FMB IS 2 LONG; FMB[1]_0;
 PRINT STG 0,' ARRAY  ORG  LENGTH GAP',/;
 K_FORGN;
 FM0: K NE FEND => (FMB_FREE(K+1); PRINT STG 6,FMB,STG 0,' ';
                    FREE(K+3) NE 0 => PRINT STG 0,' ' ELSE PRINT STG 0,'.';
                    K1_HR(FREE(K)); L_FLENX(K);
                    PRINT STG 0,' ',OCT 5,K,IGR 5,L,IGR 4,K1-(K+4+L),/;
                    K_K1; GO TO FM0);
 FSTATS(0));

SUBR FSTATS(NIL) IS (
 PRINT STG 0,'FREE STORAGE ',IGR 0,FEND+4,STG 0,' WORDS: ',OCT 0,FORGN,STG 0,' - ',OCT 0,FEND+3,/;
 FALLN=>(PRINT IGR 6,FALLN,STG 0,' REALLOTS',/; FALLN_0);
 0)%%
