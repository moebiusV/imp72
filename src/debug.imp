TWOSEG;
SBITM ARE COMMON,3 LONG;
GRBITM,GRNBITM ARE COMMON,3 LONG;
NG,NPRODS,GRNODES,GRNTGENT,GRNBITN,CT,NCT,NODEN,SEMS,NSEMS,PROSEM ARE COMMON;
FINAM IS COMMON;
#THIS IS FILE DEBUG, THE DIAGNOSTIC PRINT-OUTS OF THE IMP COMPILER FOR THE 64 BIT PORT: TPRIN1, SEMPR1, GPRIN1,
 PSTAC1 AND PARTR1 OF DECUS/DEBUG.IMC, WITH THE PRINT STATEMENTS OF THE ORIGINAL, SO THAT THEY GO THROUGH THE
 SAME LINE BUFFER AS THE OTHER MODULES' (THE C VERSION IN DEBUG.C WRITES TO THE FILE ITSELF).  HELPD AND THE
 LISTING OF PDP-10 CODE (PCODE1) STAY IN C.  THE TABLES KEEP THE 36 BIT FORMATS OF THE ORIGINAL WHERE THEY HAD
 THEM (U36 TAKES THE BITS OF A WORD), THE NODES OF THE GRAPH THE 32 BIT HALVES OF THIS PORT.  THE C SIDE
 (DEBUG_IMP.C) CALLS THESE WITH THE ARGUMENTS OF THE ORIGINAL; THE GLOBAL TABLES ARE SHARED (SRC/SHARED.TXT).
 PLEASE REMEMBER THAT NO OPERATOR HAS PRECEDENCE IN IMP: THE EXPRESSIONS ARE FULLY PARENTHESISED. #

# PRINT OUT TREE.  EACH NODE: ITS INDEX, SCR, ALT, THE SPECIAL FIELD, THE TYPE OF THE STUFF WORD, THE NODE NUMBER, THE STUFF
  WORD IN OCTAL, AND A GLOSS OF IT; THEN THE BIT MATRIX 75 COLUMNS AT A TIME. #
SUBR TPRIN1(NIL) IS (
 J,KVV,KT,KV,N,T,I,K,COLS ARE LOCAL;
 PRINT STG 0,'** CODE GENERATION TREE:',/,'NODE SCR ALT PDN TY NR',/;
 J_0;
 TL1: J_J+1;
 J GE NCT => GO TO TREEX;
 KVV_FREE(CT+J+1);
 PRINT IGR 4,J,TSCR(J),TALT(J),FREE((CT+J)-1),IGR 3,(U36(KVV) RS 33),TNODEN(J),OCT 15,U36(KVV);
 KT_(U36(KVV) RS 33);
 J_J+2;
 KT=1=>(
   (U36(KVV) AND 17600000000B)=0=>(
        (U36(KVV) AND 2000000B)=0=>(PRINT STG 0,'  [',OCT 0,R18(KVV),STG 0,']',/; GO TO TL1);
        PRINT STG 0,'  <',OCT 0,R18(KVV),STG 0,'>',/; GO TO TL1);
   (U36(KVV) AND 20000000000B)=0=>PRINT STG 0,' FLT ';
   (U36(KVV) AND 40000000000B)=0=>PRINT STG 0,' IGR ';
   (3 AND (U36(KVV) RS 31))=3=>PRINT STG 0,'     ';
   (U36(KVV) AND 10000000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'W';
   (U36(KVV) AND  4000000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'S';
   (U36(KVV) AND  2000000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'V';
   (U36(KVV) AND  1000000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'C';
   (U36(KVV) AND   400000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'R';
   (U36(KVV) AND   200000000B)=0 => PRINT STG 0,' ' ELSE PRINT STG 0,'N';
   PRINT STG 0,'  ',OCT 2,(37B AND (U36(KVV) RS 20)),STG 1,' ',OCT 2,(37B AND (U36(KVV) RS 15)),STG 1,' ',
         OCT 3,(177B AND (U36(KVV) RS 8)),STG 1,' ',OCT 3,(377B AND KVV),/;
   GO TO TL1);
 KT=3=>(KV_R18(KVV); PRINT STG 1,' ';
        PNAME(KV);
        (U36(KVV) AND 1000000B)=0 => GO TO NOKV;
        KV_FREE(CT+J); J_J+1;
        PRINT OCT 13,U36(KV);
   NOKV: PRINT /; GO TO TL1);
 PRINT STG 2,' ',OCT 5,R18(KVV),/; GO TO TL1;
TREEX: PRINT STG 0,'CODE TREE BIT MATRIX:',/,/;
 COLS_(((64*(SBITM[2]+1))+35)/36);
 COLS<5=>COLS_5;
 N_36*COLS;
 J_0;
MX: T_J+74; T>N=>T_N;
 PRINT STG 5,' ',IGR 6,0;
 (PRINT IGR 6,K) FOR K IN J+4,5,T;
 PRINT /;
 (PRINT IGR 3,I,STG 2,' ',IGR 1;
  ((K//5)=0=>PRINT STG 1,' ',IGR 1;
   PRINT (K<(64*(SBITM[2]+1)) => (BIT(SBITM,I,K) NE 0 => 1 ELSE 0) ELSE 0)) FOR K IN J,1,T;
  PRINT /) FOR I IN 0,1,NODEN;
 PRINT /;
 J_J+75; T NE N=>GO TO MX;
 0);

# PRINT THE SEMANTICS ARRAY: EACH PRODUCTION'S HEADER WITH ITS PLIES, SNODE NUMBER AND THE LIST OF TERMINAL NODES IT MATCHES, THEN
  THE WORDS OF SEMS IN OCTAL, FIVE TO A LINE. #
SUBR SEMPR1(NIL) IS (
 NN,K,J,L,LLN,K1,N ARE LOCAL;
 PRINT /,STG 0,'*** SEMANTICS ***',/;
 NN_0; K_1;
SL1: J_FREE(SEMS+K);
 (U36(J) RS 30)=0=>(NN NE 0=>PRINT /; NN_0;
                    PRINT STG 1,'[',OCT 4,K,STG 1,']  ';
                    (L_R18(J)) NE 0=>(
                       PRINT STG 0,' PLIES:',OCT 0,U36(FREE(PROSEM+L));
                       PRINT STG 0,',#',IGR 0,FREE((PROSEM+L)+2);
                       L_FREE((PROSEM+L)+1); LLN_0;
                       SL3: L NE 0=>(LLN_LLN+1; LLN>5=>(LLN_1; PRINT /,STG 12,' ');
                                     K1_FREE(PROSEM+L); PRINT STG 0,' <',OCT 0,U36(L18(K1)),STG 0,'/';
                                     N_FREE((PROSEM+L)+1);
                                     (L18(N)) NE 0=>PRINT OCT 0,U36(L18(N)),STG 0,'_';
                                     PRINT OCT 0,R18(N),STG 0,'>';
                                     L_R18(K1); GO TO SL3);
                       NN_5));
 NN_NN+1; NN=6=>(NN_1; PRINT /,STG 6,' ');
 PRINT STG 2,' ',OCT 12,U36(J);
 K_K+1; K LE (NSEMS-1)=>GO TO SL1;
 PRINT /;
 0);

# PRINT THE SYNTAX GRAPH FOLLOWING ENTRY OF A PRODUCTION, AND, WITH THE N SWITCH, THE CONNECTIVITY MATRICES.  NS IS THE SIZE OF
  A NODE.  THE MATRIX NBITM IS PRINTED AS THE MASKS THE BIT MACRO GIVES IN THE ORIGINAL: BIT J OF A WORD IS 1 LS (J MOD 36) THERE. #
SUBR GPRIN1(NIL) IS (
 I,K,J,N,NNO,NS,W1,TY,ID ARE LOCAL;
 NS_2;
 PRINT STG 0,'HERE IS THE GRAPH FOLLOWING ENTRY OF PRODUCTION NR. ',IGR 0,NPRODS,/,
       STG 8,'INDEX','SCR','ALT','TYPE','NB','NAME','NT#','ENTRY',/;
 (W1_FREE(GA+I); TY_GTYPE(I); ID_GVAL(I);
  PRINT IGR 8,I,HR(W1),HL(W1),TY,(GNB(I) AND 7777B);
  TY=3=>(PRINT STG 2,'[',OCT 0,U36(ID),STG 1,']')
   ELSE (PRINT STG 4,' ';
         PNAME(ID); PRINT IGR 5,DPROP('NODE',ID),DPROP('ENTRY',ID));
  PRINT /) FOR I IN 1,NS,NG;
 PRINT /;
 N_0-1;
L5: DSEQ(N);
 N GE 0=>((DNAME(N,0) AND 377B)=43B=>GO TO L5;
          J_DPROP('NODE',N); J=0=>GO TO L5;
          PRINT STG 0,'TERMINAL '; PNAME(N);
 L4:      J_FREE(GRNODES+J); PRINT IGR 4,HR(J);
          J_HL(J); J NE 0=>GO TO L4;
          PRINT /; GO TO L5);
 (FINAM[5] AND 20000B)=0=>GO TO L6;
 PRINT STG 0,'CONNECTIVITY MATRICES BITM AND NBITM.',/,/;
 NNO_((2+(NG/NS))/2);
 ((PRINT STG 0,'NODE#',IGR 4,(I+I)-1,STG 2,' ',IGR 1;
   (PRINT (BIT(GRBITM,I,J) NE 0 => 1 ELSE 0);
    ((5*(J/5))=J=>PRINT STG 1,' ',IGR 1)) FOR J IN 1,1,GRNTGENT-1;
   PRINT STG 5,' ',IGR 1) FOR I IN K,NNO,K+NNO;
  PRINT /) FOR K IN 1,1,NNO;
 PRINT /;
 NNO_(GRNBITN/2);
 ((PRINT STG 0,'NBIT#',IGR 4,I,STG 2,' ',IGR 1;
   (PRINT (BIT(GRNBITM,I,J) NE 0 => (1 LS (J-(36*(J/36)))) ELSE 0);
    ((5*(J/5))=J=>PRINT STG 1,' ',IGR 1)) FOR J IN 1,1,GRNTGENT-1;
   PRINT STG 5,' ',IGR 1) FOR I IN K,NNO,K+NNO;
  PRINT /) FOR K IN 1,1,NNO;
L6: PRINT /;
 NPRODS);

# PRINT THE STACK ENTRY AT OFFSET N OF THE STACK AT S #
SUBR PSTAC1(S,N) IS (
 SS,T ARE LOCAL;
 SS_FREE(S+N);
 PRINT STG 0,'STACK NODE ',IGR 0,N,STG 0,', TYPE ',OCT 2,(77B AND SS);
 (77B AND SS)=0=>PRINT STG 0,' [',OCT 0,U36(L18(SS)),STG 0,']'
  ELSE ((T_L18(SS)) NE 0=>(PRINT STG 0,', NAME '; PNAME(T));
        (SS AND 100B) NE 0=>PRINT STG 0,', IGR';
        (SS AND 200B) NE 0=>PRINT STG 0,', REAL');
 (T_FREE((S+N)+1)) NE 0=>PRINT STG 0,', VALUE ',OCT 12,U36(T);
 PRINT /;
 0);

# TRACE ONE STEP OF THE PARSER: THE CURRENT NODE, ITS TYPE AND VALUE, THE OUTPUT SO FAR, AND THE GOALS BEING PARSED.  (THE ORIGINAL
  LISTS THE OUTPUT BY INDEXING FREE STORAGE WITH THE ENTRY IT HAS JUST LOADED; THE ENTRY ITSELF IS MEANT, AND IS WHAT IS PRINTED.) #
SUBR PARTR1(CNODE,CTYP,CVAL,P,IP,O,CW) IS (
 J,K,N ARE LOCAL;
 PRINT STG 0,'   CURRENT NODE #',IGR 0,CNODE,STG 0,', TYPE ',IGR 0,CTYP,STG 0,', ';
 CTYP=3=>(PRINT STG 0,'[',OCT 0,U36(CVAL),STG 1,']') ELSE PNAME(CVAL);
 J_HL(FREE(P+IP));
 J NE 0=>(PRINT STG 0,', OUTPUT: ';
  P5: J NE 0=>(J_FREE(O+J); K_HLS(J);
               K>0=>PRINT OCT 0,U36(K) ELSE PNAME(0-K);
               PRINT STG 0,' '; J_HR(J); GO TO P5));
 PRINT /;
 CW>(IP+3)=>((N_HR(FREE(P+K)); J_HL(FREE(P+K));
              PRINT STG 0,'    ';
              K=CW=>PRINT STG 0,'CURRENT ' ELSE PRINT STG 0,'        ';
              PRINT STG 0,'GOAL: '; PNAME(GVAL(J));
              PRINT STG 0,'=NT NR. ',IGR 0,N,STG 0,' AT NODE #',IGR 0,J,/) FOR K IN CW,0-1,IP+4);
 0) %%
