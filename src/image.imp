TWOSEG;
FSIZE,RELP,NRELOC,SYMC,NSYMC ARE COMMON;
#THIS IS FILE IMAGE, THE SWITCHES U AND V OF THE TAPE'S DRIVER: SAVE THE COMPILER, WITH THE SYNTAX AND THE DECLARATIONS IT HAS COMPILED, SO THAT A LATER RUN STARTS FROM THERE.  NOT IN THE TAPE AS A PROGRAM: ON TOPS-10 THE
 MONITOR'S SSAVE WRITES THE CORE IMAGE OF THE COMPILER; HERE THE LANGUAGE THE COMPILER HAS LEARNED IS WRITTEN TO A FILE: THE FREE STORAGE (THE DIRECTORY, THE SYNTAX GRAPH, THE CODE TREE, THE SEMANTICS ARRAY: ALL THE TABLES),
 THE VARIABLES OF THE MODULES OF THE COMPILER (THEY ARE LISTED IN THE SECTION IMPVARS, A RECORD FOR EACH, BY THE COMPILER THAT COMPILED THE MODULES: IRVARREC IN SRC/PCCIR/IX.IMP; THE LIBRARY'S IMPVARLIST READS THEM) AND THE
 TABLE OF THE SEMANTIC ROUTINES BY NAME.  THE IMAGE IS FOR THE COMPILER THAT MADE IT: THE VARIABLES ARE MATCHED BY NAME AND THE FILE SAYS IF THE LIST IS NOT THE SAME.  THE DRIVER MODULE (IMPM) IS NOT IN THE IMAGE, NOR THE FILE THAT
 THE LEXER HAS OPEN, AND THE ARENA IS PUT BACK AT THE ADDRESS IT HAD, SO THE POINTERS INTO IT THAT THE MODULES KEEP (THE LEXER'S) ARE GOOD.  THE FILE IS WORDS OF 8 BYTES AND BYTES: THE MAGIC, THE VERSION, THE SIZE OF A POINTER, THE
 BUILD (A HASH OF THE LIST OF VARIABLES), THE ADDRESS OF THE ARENA, HOW MUCH OF IT, THE NUMBER OF VARIABLES AND OF ENTRIES OF THE REGISTRY OF THE ARRAYS THAT MOVE; THE VARIABLES (A LENGTH, THE NAME, THE SIZE, THE BYTES); THE
 ARENA; THE NAMES OF THE SEMANTIC ROUTINES IN THE ORDER OF THEIR IDS; THE REGISTRY (A LENGTH, THE NAME OF THE VARIABLE THAT POINTS AT THE ARRAY AND THE OFFSET IN IT, THE SECOND WORD OF THE ENTRY).#

VT,VN,IBUF,IBN,WV ARE COMMON;         # THE LIST OF THE VARIABLES (THREE WORDS EACH: ADDRESS, SIZE, NAME), HOW MANY; A BUFFER; A WORD #
NMB IS 40 LONG;
MB IS 24 LONG;

# THE LIST OF THE VARIABLES OF THE MODULES THAT CAN BE WRITTEN, FROM THE LIBRARY; 0 IF THERE IS NONE #
SUBR IMGLIST(Z) IS (
 N ARE LOCAL;
 N_CCALL IMPVARLIST(0,0);
 N<0 => RETURN 0;
 VT_CCALL CALLOC(N+1,24);
 CCALL IMPVARLIST(VT,N);
 VN_N;
 1);

SUBR IMGADDR(I) IS [VT+(24*I)];

SUBR IMGSIZE(I) IS [VT+((24*I)+8)];

SUBR IMGNAME(I) IS [VT+((24*I)+16)];

# NOT KEPT IN THE IMAGE #
SUBR IMGSKIP(NP) IS (
 CCALL STRNCMP(NP,LOC('impm:'),5)=0 => RETURN 1;
 CCALL STRNCMP(NP,LOC('ix:'),3)=0 => RETURN 1;
 CCALL STRNCMP(NP,LOC('image:'),6)=0 => RETURN 1;
 CCALL STRNCMP(NP,LOC('driver:'),7)=0 => RETURN 1;
 CCALL STRNCMP(NP,LOC('llvm:'),5)=0 => RETURN 1;
 CCALL STRNCMP(NP,LOC('llvmgen:'),8)=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('demit:usedfs'))=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('dir:rtn'))=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('dir:nrtn'))=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('dir:crtn'))=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('lex:srcfp'))=0 => RETURN 1;
 CCALL STRCMP(NP,LOC('free:relp'))=0 => RETURN 1;
 0);

SUBR IMGFIND(NP) IS (
 I ARE LOCAL;
 I_0;
 IF1: I<VN => (CCALL STRCMP(IMGNAME(I),NP)=0 => RETURN I; I_I+1; GO TO IF1);
 0-1);

# WHAT SAYS THE LISTS OF VARIABLES ARE THE SAME: A HASH OF THEIR NAMES AND SIZES #
SUBR IMGBUILD(Z) IS (
 H,I,Q,C,PP ARE LOCAL;
 H_1469598103934665603;
 I_0;
 IB1: I<VN => (PP_IMGNAME(I); Q_BYTEP [PP]<7,36>;
               IB2: C_<+Q>; C NE 0 => (H_(H XOR C)*1099511628211; GO TO IB2);
               H_(H XOR IMGSIZE(I))*1099511628211;
               I_I+1; GO TO IB1);
 H);

# THE VARIABLE THAT HAS THE ADDRESS A INSIDE IT: ITS INDEX, AND THE OFFSET IN IWV; 0-1 IF NONE #
SUBR IMGOWNER(A) IS (
 I ARE LOCAL;
 I_0;
 IO1: I<VN => (A GE IMGADDR(I) => A<(IMGADDR(I)+IMGSIZE(I)) => (WV_A-IMGADDR(I); RETURN I); I_I+1; GO TO IO1);
 0-1);

SUBR IMGPUT(F,V) IS (WV_V; CCALL FWRITE(LOC(WV),8,1,F));

# THE NEXT WORD OF THE FILE F IN WV: 1 IF THERE WAS ONE #
SUBR IMGGET(F) IS (CCALL FREAD(LOC(WV),8,1,F)=1);

SUBR IMGVERSION(Z) IS 5;

# IMPIMGSAVE(PATH): THE SWITCH U OR V: WRITE THE IMAGE; 1 IF ALL WENT WELL #
SUBR IMPIMGSAVE(P) IS (
 BASE,USABLE,USED,F,I,NK,K,L,A,O,S,NR ARE LOCAL;
 IMGLIST(0)=0 => GO TO NOTAB;
 BASE_CCALL IMPCOREBASE(0);
 BASE NE 0 => GO TO HAVE;
 NOTAB: OUTSTR('imp72: this compiler has no table of its variables to save (the modules were not compiled for it)'); OUTCHR(12B);
 RETURN 0;
 HAVE: USABLE_CCALL IMPCOREUSED(0);
 USED_FSIZE*8;
 USED>USABLE => USED_USABLE;
 NK_0;
 (IMGSKIP(IMGNAME(I))=0 => NK_NK+1) FOR I FROM VN-1;
 F_CCALL FOPEN(P,LOC('wb'));
 F=0 => (CCALL PERROR(P); RETURN 0);
 CCALL FWRITE(LOC('IMP72IMG'),8,1,F);
 IMGPUT(F,IMGVERSION(0)); IMGPUT(F,CCALL IMPPTRSIZE(0)); IMGPUT(F,IMGBUILD(0)); IMGPUT(F,BASE); IMGPUT(F,USED); IMGPUT(F,NK); IMGPUT(F,NRELOC);
 I_0;
 SV1: I<VN => (IMGSKIP(IMGNAME(I))=0 => (L_CCALL STRLEN(IMGNAME(I))+1;
                                          IMGPUT(F,L); CCALL FWRITE(IMGNAME(I),1,L,F);
                                          IMGPUT(F,IMGSIZE(I)); CCALL FWRITE(IMGADDR(I),1,IMGSIZE(I),F));
               I_I+1; GO TO SV1);
 CCALL FWRITE(BASE,1,USED,F);
 NK_SEMCOUNT(0);                                 # THE ROUTINES IN THE ORDER OF THEIR IDS, WHICH THE TABLES CARRY #
 IMGPUT(F,NK);
 K_0;
 SV2: K<NK => (L_CCALL STRLEN(SEMNAME(K))+1; IMGPUT(F,L); CCALL FWRITE(SEMNAME(K),1,L,F); K_K+1; GO TO SV2);
 I_0;                                            # THE REGISTRY OF THE ARRAYS THAT MOVE: THE VARIABLE THAT POINTS AT EACH, AS A NAME AND AN OFFSET #
 SV3: I<NRELOC => (A_[RELP+(16*I)]; S_[RELP+((16*I)+8)];
                   O_0-1;
                   A NE 0 => O_IMGOWNER(A);
                   A NE 0 => O<0 => (CCALL SNPRINTF(LOC(MB),160,LOC('imp72: a pointer variable of the free storage (slot %ld) is not one the image knows'),I);
                                      OUTCS(LOC(MB)); OUTCHR(12B));
                   O<0 => IMGPUT(F,0)
                     ELSE (L_CCALL STRLEN(IMGNAME(O))+1; NR_WV; IMGPUT(F,L); CCALL FWRITE(IMGNAME(O),1,L,F); IMGPUT(F,NR));
                   IMGPUT(F,S);
                   I_I+1; GO TO SV3);
 CCALL IMPFCLOSE(F)=0 => RETURN 1;
 CCALL PERROR(P);
 0);

# IMPIMGLOAD(PATH): THE OPTION -I: PUT THE IMAGE BACK; 1 IF ALL WENT WELL #
SUBR IMPIMGLOAD(P) IS (
 F,I,K,L,N,SZ,V,NMN,RN,A,OFF,S,VERS,PS,BLD,BASE,USED,NV,NR,NQ,NAMES,T ARE LOCAL;
 IMGLIST(0)=0 => (OUTSTR('imp72: this compiler cannot load an image'); OUTCHR(12B); RETURN 0);
 F_CCALL FOPEN(P,LOC('rb'));
 F=0 => (CCALL PERROR(P); RETURN 0);
 CCALL FREAD(LOC(NMB),8,1,F)=1 => CCALL MEMCMP(LOC(NMB),LOC('IMP72IMG'),8)=0 => GO TO LD1;
 GO TO NOTIMG;
 LD1: IMGGET(F)=0 => GO TO BAD; VERS_WV;
 IMGGET(F)=0 => GO TO BAD; PS_WV;
 IMGGET(F)=0 => GO TO BAD; BLD_WV;
 IMGGET(F)=0 => GO TO BAD; BASE_WV;
 IMGGET(F)=0 => GO TO BAD; USED_WV;
 IMGGET(F)=0 => GO TO BAD; NV_WV;
 IMGGET(F)=0 => GO TO BAD; NR_WV;
 VERS NE IMGVERSION(0) => GO TO NOTIMG;
 PS NE CCALL IMPPTRSIZE(0) => GO TO NOTIMG;
 BLD NE IMGBUILD(0) => (OUTSTR('imp72: '); OUTCS(P); OUTSTR(' was saved by another build of the compiler'); OUTCHR(12B);
                        CCALL IMPFCLOSE(F); RETURN 0);
 CCALL IMPCOREAT(BASE,USED)=0 => (OUTSTR('imp72: cannot put the free storage of '); OUTCS(P); OUTSTR(' where it was saved'); OUTCHR(12B);
                                   CCALL IMPFCLOSE(F); RETURN 0);
 I_0;
 LD2: I<NV => (IMGGET(F)=0 => GO TO BAD; L_WV;                      # THE VARIABLES #
               L>300 => GO TO BAD;
               CCALL FREAD(LOC(NMB),1,L,F) NE L => GO TO BAD;
               IMGGET(F)=0 => GO TO BAD; SZ_WV;
               SZ+1 > IBN => (IBN_SZ+64; IBUF_CCALL REALLOC(IBUF,IBN));
               CCALL FREAD(IBUF,1,SZ,F) NE SZ => GO TO BAD;
               V_IMGFIND(LOC(NMB));
               V GE 0 => IMGSIZE(V)=SZ => CCALL MEMCPY(IMGADDR(V),IBUF,SZ);
               I_I+1; GO TO LD2);
 CCALL FREAD(BASE,1,USED,F) NE USED => GO TO BAD;                      # THE ARENA #
 SYMC NE 0 => CCALL MEMSET(SYMC,0,8*NSYMC);                           # THE DIRECTORY IS ANOTHER: THE NAMES ARE MADE AGAIN #
 IMGGET(F)=0 => GO TO BAD; N_WV;                                      # THE SEMANTIC ROUTINES #
 N>100000 => GO TO BAD;
 NAMES_CCALL CALLOC(N+1,8);
 K_0;
 LD3: K<N => (IMGGET(F)=0 => GO TO BAD; L_WV; L>300 => GO TO BAD;
              T_CCALL MALLOC(L);
              [NAMES+(8*K)]_T;
              CCALL FREAD(T,1,L,F) NE L => GO TO BAD;
              K_K+1; GO TO LD3);
 SEMREMAP(NAMES,N)=0 => (CCALL IMPFCLOSE(F); RETURN 0);
 RELP_CCALL CALLOC(NR+1,16);                                          # THE REGISTRY #
 I_0;
 LD4: I<NR => (IMGGET(F)=0 => GO TO BAD; L_WV;
               A_0;
               L>0 => (L>300 => GO TO BAD;
                       CCALL FREAD(LOC(NMB),1,L,F) NE L => GO TO BAD;
                       IMGGET(F)=0 => GO TO BAD; OFF_WV;
                       V_IMGFIND(LOC(NMB));
                       V GE 0 => A_IMGADDR(V)+OFF);
               IMGGET(F)=0 => GO TO BAD; S_WV;
               [RELP+(16*I)]_A; [RELP+((16*I)+8)]_S;
               I_I+1; GO TO LD4);
 NRELOC_NR;
 CCALL IMPFCLOSE(F);
 RETURN 1;
 NOTIMG: OUTSTR('imp72: '); OUTCS(P); OUTSTR(' is not an image of this kind of compiler'); OUTCHR(12B);
         CCALL IMPFCLOSE(F); RETURN 0;
 BAD: OUTSTR('imp72: '); OUTCS(P); OUTSTR(' is damaged'); OUTCHR(12B);
      CCALL IMPFCLOSE(F);
      0)
%%
