TWOSEG;
ARR,NARR,REGN ARE COMMON;                  # THE C SIDE READS THEM (SRC/SHARED.TXT) #
FINAM IS COMMON;
#THIS IS FILE IMPSEM, THE MACHINE-INDEPENDENT SEMANTIC ROUTINES OF DECUS/IMPSEM.IMC FOR THE 64 BIT PORT: NAME, AREG,
 AREG1, REG2, TSTRN, VAL, SVAL, STACKUP, SWITCH, DECL, DECLARE, THE REGISTER TESTS OF THE CODE GENERATOR (HISREG, PAIRFIRST,
 SUBREG, TMPREG, SAMEREG, REGEQ, REGSIM, REG0, RMATCH), THE SUBROUTINE ROUTINES (SUBPR0, SUBPRM, SUBTMPF, SUBBEG, SUBEND, NSUBP),
 REMOT, CALLME AND REG2S.  FCON (WHICH NEEDS THE C LIBRARY'S STRTOD), LETSYN AND THE TABLE OF THE NAMES CALLED WITH VALUES
 (CCALL) STAY IN C (IMPSEM_IMP.C), WHICH ALSO REGISTERS THE ROUTINES BY NAME, FOR THE TABLE OF SEMANTIC ROUTINES IS A TABLE OF
 C FUNCTION POINTERS.  THE ROUTINES OF THE CODE GENERATOR AND OF RSYN ARE CALLED THROUGH STAGE0/IMPGLUE.C, BY REFERENCE:
 IMPENSTACK, IMPGETLIST, IMPNEWNAMEG, IMPDNAME, IMPCONVC, IMPADDCODE, IMPHOOK, IMPFREEZE, IMPANYCO, IMPDEWFUN, IMPNEWPAR,
 IMPSUBTAG, IMPERROR.

 THE REGISTERS ARE DESCRIBED BY WORDS OF THE ARRAY RG, IN THE LAYOUT OF THE ORIGINAL (THE COMMENT AT AREG1 IN IMPSEM.IMC): BIT 35
 A HARDWARE REGISTER HAS BEEN ASSIGNED, BITS 29-18 THE REFERENCE COUNT, 17-13 THE HARDWARE REGISTER, BIT 12 NOT A TEMPORARY, BIT 11
 A SUBROUTINE CALL, BITS 10-6 THE LOWER LIMIT, BIT 5 TWO SUCCESSIVE REGISTERS, BITS 4-0 THE UPPER LIMIT.  THE WORDS OF THE
 STACK AND OF THESE ARRAYS KEEP THEIR 36 BIT FORMATS (SX36, U36, L18 AND R18 OF IMPSYN64).  NO OPERATOR HAS PRECEDENCE IN IMP:
 THE EXPRESSIONS ARE FULLY PARENTHESISED. #

SUBR IINIT(NIL) IS (
 GINIT NE 0 => RETURN 0;
 GINIT_1;
 FRELOT(SUBPAR,'SUBRP',5,0); NSUBPAR_0;
 FRELOT(REGDEC,'RGDEC',5,0); NREGDEC_0;
 FRELOT(LOCV,'LOCV',5,0); NLOCV_0;
 FRELOT(ARR,'ARRYS',5,0); NARR_0;
 FRELOT(RG,'REGS',300,0); REGN_65;
 FREES((RG+I)+1,((10000B AND (I LS 7)) OR (101B*(I AND 37B)))) FOR I IN 0,1,63;
 IMPIMPM(0);
 SUBTMPN_0;
 SUBTMP_IMPNEWPAR(0);
 0);

# AREG(I) IS THE REGISTER INDEX OF HARDWARE REGISTER I (NOT A NEW ONE); WITH THE 40B BIT SET IT IS A REGISTER DEFINED BY THE USER #
SUBR AREG(I) IS I+1;
SUBR REG2(N) IS N+1;

# AREG1(I,J): ASSIGN A REGISTER BETWEEN I AND J, GIVING ITS INDEX #
SUBR AREG1(I,J) IS (
 S,II,JJ ARE LOCAL;
 IINIT(0);
 II_I; JJ_J;
 ((II OR JJ) AND (NOT 177B)) NE 0 => (ERROR(1,'IN AREG1 - I OR J OUT OF RANGE.'); II_0; JJ_37B);
 S_REGN;
 FADD(RG,REGN,(JJ OR (II LS 6)));
 (JJ AND 40B) NE 0 => FADD(RG,REGN,((JJ AND 37B) OR (II LS 6)));
 S);

# TSTRN(DI): THE REGISTER NUMBER IF THE NAME IS ONE OF 0R ... 15R, ELSE -1.  THE NAME IS FIVE 7 BIT CHARACTERS IN THE FIRST WORD #
SUBR TSTRN(DI) IS (
 W,C1,C2,C3,C4 ARE LOCAL;
 W_IMPDNAME(DI,0);
 C1_((W RS 29) AND 177B); C2_((W RS 22) AND 177B); C3_((W RS 15) AND 177B); C4_((W RS 8) AND 177B);
 C1 GE 60B => C1 LE 71B => C2=122B => C3=0 => RETURN (C1-60B);
 C1=61B => C2 GE 60B => C2 LE 65B => C3=122B => C4=0 => RETURN ((C2-60B)+10);
 0-1);

SUBR NAME(S) IS (
 D,J,ATY,K,I,R16 ARE LOCAL;
 IINIT(0);
 (FREE(S) AND 77B) NE 1 => RETURN S;
 D_HL(FREE(S));
 ATY_(DPROP('ATYPE',D) LS 6);
 ATY=0 => (DPROPS('ATYPE',D,1); ATY_(1 LS 6));
 (K_TSTRN(D)) GE 0 => (FREES(S,(2 OR ATY));
                       K_AREG(K+40B);
                       FREES(S+1,(K LS 32));
                       RETURN S);
 IMPCONVC(D,KONV) NE 0 => (FREES(S,((ATY OR 4) OR (D LS 32)));
                           FREES(S+1,KONV);
                           RETURN S);
 NLOCV NE 0 => (I_NLOCV-1;
  NL1: I GE 0 => (J_FREE(LOCV+I);
                  D=HL(J) => (D_HR(J);
                               ATY_(DPROP('ATYPE',D) LS 6);
                               NSUBPAR NE 0 => (I_NSUBPAR-1;
                                NL2: I GE 0 => (J_FREE(SUBPAR+I);
                                                D=J => (FREES(S,(ATY OR 20B));
                                                        R16_AREG(16B);
                                                        FREES(S+1,((0400000000000B OR I) OR (R16 LS 32)));
                                                        RETURN S);
                                                I_I-1; GO TO NL2));
                               GO TO NL3);
                  I_I-1; GO TO NL1));
 NL3: NREGDEC NE 0 => (I_NREGDEC-1;
  NL4: I GE 0 => (J_FREE(REGDEC+I);
                  D=HR(J) => (FREES(S,(ATY OR 2));
                               FREES(S+1,(J XOR HR(J)));          # THE LEFT PART OF J: NOT 'J AND NOT 777777B', WHICH THE TRANSLATOR MAKES A HALFWORD MOVE #
                               RETURN S);
                  I_I-1; GO TO NL4));
 FREES(S,(((10B OR ATY)) OR (D LS 32)));
 FREES(S+1,0);
 S);

SUBR VAL(S) IS HR(FREE(S+1));

SUBR SVAL(N) IS (J_IMPENSTACK(0); FREES(J+1,N); J);

SUBR STACKUP(V) IS (T_IMPENSTACK(0); FREES(T,4); FREES(T+1,V); T);

# SWITCH 18 (TWOSEG) PUTS THE CODE OF THE SUBROUTINES IN THE HIGH SEGMENT BEHIND A JUMP IN THE LOW ONE; THERE IS ONE SEGMENT HERE #
# THE C KEYWORD SWITCH IS NOT A NAME THE C BACK END ACCEPTS #
SUBR SWTCH(N) IS (
 N NE 18 => FINAM[5]_(FINAM[5] OR (1 LS (N-1)));
 IMPENSTACK(0));

SUBR NSUBP(NIL) IS NSUBPAR;

# THE TESTS OF THE REGISTERS #
SUBR HISREG(I) IS (IINIT(0); 10000B AND FREE(RG+I));
SUBR PAIRFIRST(J) IS (IINIT(0); 40B AND FREE(RG+J));
SUBR SUBREG(J) IS (IINIT(0); 4000B AND FREE(RG+J));

# TMPREG(J): IS REGISTER J A TEMPORARY THAT CAN BE OPTIMISED OUT? #
SUBR TMPREG(J) IS (
 IINIT(0);
 J LE 64 => RETURN 0;
 (FREE(RG+J) AND 14040B) NE 0 => RETURN 0;
 1);

# SAMEREG(J): A NEW REGISTER WITH THE LIMITS OF REGISTER J #
SUBR SAMEREG(J) IS (
 K ARE LOCAL;
 TMPREG(J)=0 => RETURN J;
 K_FREE(RG+J);
 AREG1((77B AND (K RS 6)),(77B AND K)));

SUBR REGEQ(I,J) IS (
 II,JJ ARE LOCAL;
 IINIT(0);
 I=J => RETURN 1;
 I=0 => RETURN 0;
 J=0 => RETURN 0;
 II_FREE(RG+I); JJ_FREE(RG+J);
 (37B AND II)=(37B AND (II RS 6)) => (II=JJ => RETURN 1);
 0);

SUBR REGSIM(I,J) IS (
 IINIT(0);
 I=J => RETURN 1;
 I=0 => RETURN 0;
 J=0 => RETURN 0;
 FREE(RG+I)=FREE(RG+J) => 1 ELSE 0);

SUBR REG0(I) IS (
 IINIT(0);
 I=0 => RETURN 0;
 (FREE(RG+I) AND 3700B)=0 => 1 ELSE 0);

# RMATCH(I,J,RN): IS REGISTER RN WITHIN THE LIMITS I..J? #
SUBR RMATCH(I,J,RN) IS (
 K ARE LOCAL;
 IINIT(0);
 K_FREE(RG+RN);
 J LT (37B AND K) => RETURN 0;
 I GT (37B AND (K RS 6)) => RETURN 0;
 1);

# SUBPR0(I): 0 AT SUBROUTINE CALLS, 1 AT THE END OF A PARAMETER LIST; KEEPS TRACK OF WHEN THE CALL TEMPORARIES CAN BE REUSED #
SUBR SUBPR0(I) IS (
 I NE 0 => (SUBCNT_SUBCNT-1; SUBCNT=0 => SUBTMPK_0)
  ELSE SUBCNT_SUBCNT+1;
 0);

SUBR SUBPRM(I) IS (
 J ARE LOCAL;
 IINIT(0);
 J_IMPENSTACK(0);
 FREES(J,(10B OR (SUBTMP LS 32)));
 FREES(J+1,SUBTMPK);
 SUBTMPK_SUBTMPK+1;
 SUBTMPK>SUBTMPN => SUBTMPN_SUBTMPK;
 J);

SUBR SUBTMPF(NIL) IS (
 IINIT(0);
 SUBTMPN NE 0 => (FADD(ARR,NARR,(SUBTMP OR (SUBTMPN LS 32)));
                  SUBTMP_IMPNEWPAR(0);
                  SUBTMPN_0; SUBTMPK_0);
 0);

# SUBBEG(A): BEGIN A SUBROUTINE NAMED AT STACK ENTRY A, WHOSE FORMAL ARGUMENTS ARE THE CURRENT LIST #
SUBR SUBBEG(A) IS (
 J,K,I,RNTRNT ARE LOCAL;
 IINIT(0);
 SUBRTN NE 0 => ERROR(1,'NESTED SUBROUTINES.');
 SUBRTN_1;
 J_HL(FREE(A));
 DPROPS('COM',J,2);
 IMPANYCO(0)=0 => IMPM_0;
 (FINAM[5] AND 400000B) NE 0 => RNTRNT_1 ELSE RNTRNT_0;
 RNTRNT NE 0 => (K_IMPENSTACK(0);
                 IMPADDCODE(K,(200000000000B OR J),0);
                 IMPADDCODE(K,0,J);
                 J_IMPSUBTAG(J);
                 IMPADDCODE(K,(254B LS 24),J);
                 IMPADDCODE(A,(200000000000B OR J),0);
                 REMOT(IMPFREEZE(K)))
  ELSE (IMPADDCODE(A,(200000000000B OR J),0);
        IMPADDCODE(A,0,J));
 K_IMPENSTACK(0);
 SB1: IMPGETLIST(K) NE 0 => (I_HL(FREE(K));
                             J_IMPNEWNAMEG(I);
                             FADD(LOCV,NLOCV,(J OR (I LS 32)));
                             FADD(SUBPAR,NSUBPAR,J);
                             GO TO SB1);
 SUBTMPF(0);
 A);

SUBR SUBEND(NIL) IS (SUBRTN_0; NLOCV_0; NSUBPAR_0; 0);

# REMOT(A): CODE FOR THE REMOTE (HIGH) SEGMENT #
SUBR REMOT(A) IS (
 IINIT(0);
 REMO=0 => (REMO_IMPENSTACK(0); FREES(REMO+2,0));
 IMPHOOK(REMO,REMO,A);
 FREES(A+2,0);
 A);

SUBR CALLME(A) IS (RELNM_HL(FREE(A)); A);

SUBR REG2S(S) IS (
 J,F,R ARE LOCAL;
 J_FREE(S+1);
 F_(3777B AND HL(J));                      # THE REGISTER FIELD, BITS 18-28 #
 R_REG2(F);
 FREES(S+1,((J XOR (F LS 32)) OR (R LS 32)));    # CLEAR THE FIELD WITH XOR, NOT AND NOT #
 S);

# DECL(I,S): NOTE ONE PROPERTY OF A DECLARATION: 0 A SYNONYM FOR THE REGISTER NAMED AT S, 1 A LENGTH (S IS A CONSTANT), 2 AND OVER A
  FLAG (BIT I OF PROPS) #
SUBR DECL(I,S) IS (
 J,K ARE LOCAL;
 IINIT(0);
 I>1 => (PROPS_(PROPS OR (1 LS I)); RETURN 0);
 I=0 => (PREGSYN NE 0 => ERROR(1,'TWO REGISTERS IN SAME DECLARATION.');
         J_HL(FREE(S));
         (K_TSTRN(J)) GE 0 => PREGSYN_AREG(K+40B)
          ELSE ERROR(1,'ANTECEDENT NOT A HARDWARE REGISTER IN SYNONYM DECLARATION.');
         RETURN 0);
 PLONG NE 0 => ERROR(1,'TWO LENGTHS IN SAME DECLARATION. ');
 (FREE(S) AND 77B)=4 => PLONG_FREE(S+1)
  ELSE ERROR(1,'N NOT A CONSTANT IN N LONG.');
 0);

# DECLARE(S): APPLY THE DECLARED PROPERTIES TO THE NAMES OF THE CURRENT LIST (THEIR ENTRIES ARE PUT IN THE STACK AT S ONE AT A TIME) #
SUBR DECLARE(S) IS (
 T,J,JJ,K,I,OLD ARE LOCAL;
 IINIT(0);
 T_IMPENSTACK(0);
 DL1: IMPGETLIST(S)=0 => GO TO DLX;
 J_HL(FREE(S));
 JJ_0;
 NLOCV NE 0 => (I_NLOCV-1;
  DL2: I GE 0 => (K_FREE(LOCV+I);
                  J=HL(K) => (J_HR(K); GO TO DL3);
                  I_I-1; GO TO DL2));
 DL3: (PROPS AND 2048) NE 0 => (OLD_J;                   # LOCAL #
                                J_IMPNEWNAMEG(J);
                                FADD(LOCV,NLOCV,(J OR (OLD LS 32))));
 NREGDEC NE 0 => (I_NREGDEC-1;
  DL4: I GE 0 => (K_FREE(REGDEC+I);
                  J=HR(K) => (JJ_HL(K); GO TO DL5);
                  I_I-1; GO TO DL4));
 DL5: (K_TSTRN(J)) GE 0 => JJ_AREG(K+40B);
 PREGSYN NE 0 => (JJ_PREGSYN;
                  FADD(REGDEC,NREGDEC,(J OR (JJ LS 32))));
 (PROPS AND 4) NE 0 => JJ=0 => DPROPS('COM',J,1);
 (PROPS AND 8) NE 0 => DPROPS('ATYPE',J,2);
 (PROPS AND 16) NE 0 => DPROPS('ATYPE',J,1);
 (PROPS AND 32) NE 0 => (JJ=0 => (JJ_AREG1(101B,15B);               # REGISTER #
                                  FADD(REGDEC,NREGDEC,(J OR (JJ LS 32))));
                         IMPDEWFUN(T,5,JJ));
 (PROPS AND 64) NE 0 => JJ NE 0 => IMPDEWFUN(T,6,JJ);               # RESERVED #
 (PROPS AND 128) NE 0 => JJ NE 0 => IMPDEWFUN(T,9,JJ);              # SCRATCH #
 (PROPS AND 256) NE 0 => JJ NE 0 => IMPDEWFUN(T,10,JJ);             # PROTECTED #
 (PROPS AND 512) NE 0 => JJ NE 0 => IMPDEWFUN(T,8,JJ);              # AVAILABLE #
 (PROPS AND 1024) NE 0 => JJ NE 0 => (I_NREGDEC-1;                  # RELEASED #
   DL6: I GE 0 => (J=HR(FREE(REGDEC+I)) => FREES(REGDEC+I,0);
                   I_I-1; GO TO DL6);
   IMPDEWFUN(T,8,JJ));
 PLONG NE 0 => JJ=0 => FADD(ARR,NARR,(J OR (PLONG LS 32)));
 JJ NE 0 => (PLONG OR (PROPS AND 28)) NE 0 => ERROR(1,'PROPERTY DECLARED IS NOT APPLICABLE TO REGISTER.');
 JJ=0 => (PROPS AND 1984) NE 0 => ERROR(1,'PROPERTY MAY ONLY BE DECLARED FOR REGISTERS.');
 GO TO DL1;
 DLX: PROPS_PLONG_PREGSYN_0;
 T) %%
