TWOSEG;
CO,NCO,ANCO ARE COMMON;
SE,TSE,DSE,SE1,RSE,CSE ARE COMMON;          # THE UNPACKED STACK ENTRY, AS IN THE ORIGINAL #
#THIS IS FILE CODE, THE TRANSLATION OF DECUS/CODE.IMC FOR THE 64 BIT PORT, WHICH COMPILES TO PCC IR (DOCS/PORTING/IR-MACHINE.MD) WHERE THE
 ORIGINAL COMPILED TO THE PDP-10.  CODE2 HAS THE REST.  THE ROUTINES ARE THE ORIGINAL'S WITH THE INSTRUCTIONS THEY MAKE CHANGED: NO IMMEDIATE,
 SELF OR BOTH MODES, NO HALFWORD OPERATIONS, NO REGISTER PAIRS, NO CHECKING WHETHER A REGISTER IS THE USER'S WHEN AN OPERATION CLOBBERS IT (A
 REGISTER IS A TEMPORARY OF THE IR; PCC ALLOCATES THEM), AND NO LOOKING IN THE CODE FOR WHERE A REGISTER IS USED (RCOCHK).#

SUBR UNPCK(S) IS (
 SE_FREE(S); TSE_SE AND 77B; DSE_HL(SE);
 SE1_FREE(S+1); RSE_3777B AND HL(SE1); CSE_HR(SE1);
 0);

SUBR REGOF(S) IS (3777B AND HL(FREE(S+1)));

SUBR FETCH(S) IS ((FREE(S) AND 77B) NE 2 => DEWOP(OLOAD,AREG1(1,15B),S); S);

SUBR ADDOP(OP,S,T) IS HOOK(S,T,DEWOP(OP,REGOF(FETCH(T)),S));

# DEWOP(OPP,RR,S): ADD TO THE CODE OF S AN OPERATION OP WITH ACCUMULATOR RR (0: NONE) AND THE OPERAND S.  S BECOMES TYPE 2 (REGISTER RR) UNLESS RR=0.
  A NEGATIVE RR IS ITS ABSOLUTE VALUE: THE ORIGINAL USES IT TO MEAN "DO NOT PROTECT A USER REGISTER" #
SUBR DEWOP(OPP,RR,S) IS (
 R,OP ARE LOCAL;
 R_RR; R LT 0 => R_0-RR;
 OP_OPP;
 OP GE 256 => ERROR(1,'AN OPERATION OF THE PDP-10 THAT THE IR MACHINE DOES NOT HAVE.');
 UNPCK(S);
 ADDREC(S,KOP,OP,R,SE,SE1,0);
 R NE 0 => (FREES(S,((2 OR (SE AND 777700B))));
            FREES(S+1,(R LS 32)));
 S);

SUBR TAG(S) IS (ADDREC(S,KTAG,0,0,0,0,HL(FREE(S))); S);

# STORE(S,T): GET T INTO S (WHICH IS NOT OF TYPE 4), HOOKING THE CODE FOR T BEFORE THAT OF S.  THE ORIGINAL TURNS AN ADD, SUBTRACT, ETC. OF A
  REGISTER JUST STORED INTO THE INSTRUCTION'S "TO MEMORY" FORM, AND STORES 0 AND -1 WITH ONE INSTRUCTION; PCC DOES THAT #
SUBR STORE(S,T) IS (
 S1 ARE LOCAL;
 UNPCK(S);
 TSE=2 => (S1_RSE; HOOK(S,DEWOP(OLOAD,0-S1,T),S); RETURN S);
 FETCH(T); HOOK(S,T,S);
 DEWOP(OSTORE,REGOF(T),S);
 S);

# THE REGISTERS OF A CODE THAT IS COPIED OR COMPARED: COPYS HAS PAIRS (OLD REGISTER LEFT, NEW REGISTER RIGHT) #
SUBR COPYC1(J) IS (
 K,I ARE LOCAL;
 NCOP NE 0 => ((K_FREE(COPYS+I);
                HL(K)=J => RETURN HR(K)) FOR I FROM NCOP-1);
 I_SAMEREG(J);
 FADD(COPYS,NCOP,HW(J,I));
 I);

# THE ENTRY WORD 1 WITH THE REGISTER FIELD (BITS 28-18, 0 FOR NONE) CHANGED FROM R TO RN #
SUBR REGFIELD(W,R,RN) IS ((W XOR (R LS 32)) OR (RN LS 32));

# COPYCO(S): A FRESH COPY (WITH NEW REGISTERS) OF THE CODE OF STACK ENTRY S #
SUBR COPYCO(S) IS (
 CJ,J,W0,W1,RD,R,CT,K ARE LOCAL;
 NCOP_0; COPYS=0 => COPYS_FALLOT('CPYCO',20);
 CJ_HL(FREE(S+2)); FREES(S+2,0);
 CP1: CJ NE 0 => (
     RD_RRD(CJ); W0_RV0(CJ); W1_RV1(CJ);
     RD NE 0 => RD_COPYC1(RD);
     (W0 AND 77B) NE 4 => (R_3777B AND HL(W1); R NE 0 => W1_REGFIELD(W1,R,COPYC1(R)));
     ADDREC(S,RKIND(CJ),ROP(CJ),RD,W0,W1,RX(CJ));
     CJ_RNEXT(CJ);
     GO TO CP1);
 W1_FREE(S+1); CT_FREE(S) AND 77B;
 CT=2 => (R_3777B AND HL(W1); R NE 0 => FREES(S+1,REGFIELD(W1,R,COPYC1(R))));
 CT=20B => (R_3777B AND HL(W1); R NE 0 => FREES(S+1,REGFIELD(W1,R,COPYC1(R))));
 0);

SUBR NEXCO(I) IS (0);

# MCODE1(I,J): IS REGISTER I OF ONE CODE THE REGISTER J OF THE OTHER?  (A CORRESPONDENCE IS KEPT IN COPYS) #
SUBR MCODE1(I,J) IS (
 B,A,T,K ARE LOCAL;
 I=J => RETURN 1;
 B_HW(I,J);
 NCOP NE 0 => ((A_FREE(COPYS+K); A=B => RETURN 1;
                T_HL(A); (T=I) OR (T=J) => RETURN 0;
                T_HR(A); (T=I) OR (T=J) => RETURN 0) FOR K FROM NCOP-1);
 REGSIM(I,J)=0 => RETURN 0;
 FADD(COPYS,NCOP,B);
 1);

# MCODE(S,T): 1 IF THE CODE FOR S AND FOR T IS THE SAME, UP TO A CORRESPONDENCE BETWEEN THE REGISTERS #
SUBR MCODE(S,T) IS (
 JS,JT,RS,RT,W0S,W0T,W1S,W1T ARE LOCAL;
 COPYS=0 => COPYS_FALLOT('CPYCO',20);
 NCOP_0;
 MCODE1(3777B AND HL(FREE(S+1)),3777B AND HL(FREE(T+1)))=0 => RETURN 0;
 JS_HL(FREE(S+2)); JT_HL(FREE(T+2));
 MC1: (JS OR JT)=0 => RETURN 1;
 JS=0 => RETURN 0;
 JT=0 => RETURN 0;
 RKIND(JS) NE RKIND(JT) => RETURN 0;
 ROP(JS) NE ROP(JT) => RETURN 0;
 RX(JS) NE RX(JT) => RETURN 0;
 RV0(JS) NE RV0(JT) => RETURN 0;
 RS_RRD(JS); RT_RRD(JT);
 (RS=0) NE (RT=0) => RETURN 0;
 RS NE 0 => MCODE1(RS,RT)=0 => RETURN 0;
 W0S_RV0(JS);
 (W0S AND 77B)=4 => (RV1(JS) NE RV1(JT) => RETURN 0)
  ELSE (RS_3777B AND HL(RV1(JS)); RT_3777B AND HL(RV1(JT));
        (RS=0) NE (RT=0) => RETURN 0;
        RS NE 0 => MCODE1(RS,RT)=0 => RETURN 0;
        HR(RV1(JS)) NE HR(RV1(JT)) => RETURN 0;
        (RV1(JS) LT 0) NE (RV1(JT) LT 0) => RETURN 0);
 JS_RNEXT(JS); JT_RNEXT(JT); GO TO MC1);

# SUBARG(S,PP): FORCE THE ARGUMENT PP INTO SOMETHING WITH AN ADDRESS FOR A SUBROUTINE CALL, STORING IT IF NECESSARY.  A VARIABLE AND A SUBSCRIPTED
  VARIABLE HAVE ONE; A REGISTER IS STORED IN A TEMPORARY WORD; A CONSTANT IS GIVEN A NAME #
SUBR SUBARG(S,PP) IS (
 P,TM,S1,S2,J ARE LOCAL;
 P_PP;
 UNPCK(P);
 TSE=10B => RETURN P;
 TSE=2 => (TM_SUBPRM(0);
           S1_FREE(TM); S2_FREE(TM+1);
           STORE(TM,P);
           FREES(TM,S1); FREES(TM+1,S2);
           RETURN TM);
 TSE=4 => (DSE=0 => (J_STCON(FREE(P+1));
                     FREES(P,((HR(SE) OR (J LS 32)))));
           FREES(P+1,0);
           RETURN P);
 P);

SUBR CODEI(NIL) IS (
  DSEM('STORE',STORE);
  DSEM('FETCH',FETCH);
  DSEM('REGOF',REGOF);
  DSEM('DEWOP',DEWOP);
  DSEM('ADDOP',ADDOP);
  DSEM('TAG',TAG);
  CODE2I(0);
  0)%%
