TWOSEG;
CO,NCO,ANCO,CONST ARE COMMON;
#THIS IS FILE CODE2, HOLDING OVERFLOW FROM FILE CODE, THE TRANSLATION OF DECUS/CODE2.IMC FOR THE 64 BIT PORT, WHICH COMPILES TO PCC IR
 (DOCS/PORTING/PCCIR-MACHINE.MD) WHERE THE ORIGINAL COMPILED TO THE PDP-10.  THE CODE IS A CHAIN OF RECORDS IN FREE ARRAY CO; THE CODE OF
 A STACK ENTRY IS THE PAIR (FIRST,LAST) IN ITS THIRD WORD (LEFT AND RIGHT 32 BIT HALVES; 0: NO CODE).  ADDCODE OF THE ORIGINAL IS
 ADDREC: IT ADDS ONE RECORD.  THE ROUTINES OF THE TABLE OF SEMANTIC ROUTINES ARE REGISTERED BY STAGE0/SEMTAB.C (THE TABLE HOLDS C
 FUNCTION POINTERS).  OPCODE, THE ASSEMBLER'S TABLE OF MNEMONICS, IS NOT TRANSLATED.#

# SETNEXT(R,N): MAKE RECORD N THE ONE AFTER RECORD R #
SUBR SETNEXT(R,N) IS FREES(CO+R,HW(N,HR(FREE(CO+R))));

# ADDREC(S,KIND,OP,RD,V0,V1,X): ADD A RECORD TO THE CODE OF STACK ENTRY S #
SUBR ADDREC(S,KIND,OP,RD,V0,V1,X) IS (
 Z,R,KK,OO,RR,W0,W1,XX ARE LOCAL;
 # THE ARGUMENTS ARE COPIED FIRST: AN ARGUMENT LIKE FREE(R) IS PASSED BY REFERENCE, AND THE ARENA MOVES WHEN FADDEX GROWS IT #
 KK:=KIND; OO:=OP; RR:=RD; W0:=V0; W1:=V1; XX:=X;
 CO=0 => (NCO:=1; FRELOT(CO,'CODE',200,0); FINCSET(CO,200));
 ANCO=-1 => ANCO:=0 ELSE ANCO:=1;
 FLEN(CO) LE (NCO+RECW) => FADDEX(CO,(NCO+RECW)+3);
 R:=NCO; NCO:=NCO+RECW;
 FREES(CO+R,HW(0,(KK OR (OO LS 8))));
 FREES((CO+R)+1,RR); FREES((CO+R)+2,W0); FREES((CO+R)+3,W1); FREES((CO+R)+4,XX);
 Z:=FREE(S+2);
 Z=0 => FREES(S+2,HW(R,R))
  ELSE (SETNEXT(HR(Z),R); FREES(S+2,HW(HL(Z),R)));
 S);

# HOOK(D,A,B): HOOKS CODE FOR A TO CODE FOR B, PUTS CODE IN D.  VALUE OF D IS SET TO VALUE OF B #
SUBR HOOK(D,A,B) IS (
 J,K ARE LOCAL;
 FREES(D,FREE(B)); FREES(D+1,FREE(B+1));
 J:=FREE(B+2);
 J=0 => (FREES(D+2,FREE(A+2)); RETURN D);
 K:=FREE(A+2);
 K=0 => (FREES(D+2,J); RETURN D);
 SETNEXT(HR(K),HL(J));
 FREES(D+2,HW(HL(K),HR(J)));
 D);

SUBR ANYCODE(NIL) IS ANCO;

# DEWFUN(S,I,J): SPECIAL FUNCTION I.  2 ENDS A CALL (THE VALUE IS IN REGISTER J); THE OTHERS (SAVING AND RESTORING THE PDP-10'S REGISTERS, DECLARING
  THEM) DO NOTHING IN A MACHINE WITH AS MANY REGISTERS AS WE LIKE, BUT STILL COUNT AS CODE FOR ANYCODE #
SUBR DEWFUN(S,I,J) IS (
 ANCO=0 => ANCO:=-1;
 I=2 => RETURN ADDREC(S,KOP,OCALLE,J,0,0,0);
 ANCO=-1 => ANCO:=0 ELSE ANCO:=1;
 S);

# CONOP(S,T,I,V,W): AN OPERATION ON ONE OR TWO CONSTANTS S AND T, BY THE INDEX I (THE LOW 18 BITS) AND, IF THE REST OF I IS 1 OR 2, A CONDITIONAL:
  THE VALUE OF THE COMPARISON CHOOSES THE ENTRY V (OR W) FOR THE WHOLE RESULT.  THE ARITHMETIC IS THAT OF 64 BIT WORDS; AN OPERATION ON REAL CONSTANTS
  IS NOT FOLDED (ONLY THE NEGATION, WHICH FLIPS THE SIGN) #
SUBR CONOP(S,T,I,V,W) IS (
 CO1,CO2,II,C,J,N ARE LOCAL;
 CO1:=FREE(S+1); T NE 0 => CO2:=FREE(T+1);
 II:=HR(I);
 (FREE(S) AND 300B)=200B => (II=0 => (CO1:=CO1 XOR (1 LS 63); GO TO CXC)
                              ELSE (ERROR(1,'OPERATION ON A REAL CONSTANT. '); GO TO CXC));
 GO TO (C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16,C17,C18,C19) II;
 C0: CO1:=0-CO1; GO TO CX;
 C1: CO1:=CO1+CO2; GO TO CX;
 C2: CO1:=CO1-CO2; GO TO CX;
 C3: CO1:=CO1*CO2; GO TO CX;
 C4: CO2=0 => CO1:=0 ELSE CO1:=CO1/CO2; GO TO CX;      # DIVISION BY ZERO TRAPS HERE, AND THE COMPILER WOULD DIE #
 C5: CO1:=CO1 LS CO2; GO TO CX;
 C6: CO1:=NOT CO1; GO TO CX;
 C7: CO1:=CO1 AND CO2; GO TO CX;
 C8: CO1:=CO1 OR CO2; GO TO CX;
 C9: CO1:=(CO1<CO2); GO TO CX;
 C10:CO1:=(CO1=CO2); GO TO CX;
 C11:CO1:=(CO1 LE CO2); GO TO CX;
 C12: # THIS SPACE AVAILABLE - CALL (314) 159-2656 #
 C13:CO1:=(CO1 GE CO2); GO TO CX;
 C14:CO1:=(CO1 NE CO2); GO TO CX;
 C15:CO1:=(CO1>CO2); GO TO CX;
 C16:CO1:=CO1 ALS CO2; GO TO CX;
 C17:CO1:=CO1 LROT CO2; GO TO CX;
 C18:CO1:=CO1 XOR CO2; GO TO CX;
 C19:CO1:=CO1 EQV CO2; GO TO CX;
CX: (C:=I RS 32)=>(                      # SPECIAL DEALIE FOR CONDITIONALS #
                   C=1=>(CO1=0=>GO TO CXC;
                         FREES(S+J,FREE(V+J)) FOR J FROM 2;
                         GO TO CXT);
                   C=2=>(CO1=0=>(FREES(S+J,FREE(W+J)) FOR J FROM 2)
                            ELSE(FREES(S+J,FREE(V+J)) FOR J FROM 2);
                         GO TO CXT));
 CXC: FREES(S+1,CO1);
 J:=FREE(S); FREES(S,HR(J));
 T=>HOOK(S,T,S);
 CXT: S);

# JOP(C): THE JUMP OPERATION FOR THE RELATION WITH CODE C OF THE RELATIONAL OPERATORS (1 <, 2 =, 3 LE, 5 GE, 6 NE, 7 >); ON REALS THE
  ONE 10 MORE.  CJUMP(OP,P,R,S): JUMP TO THE TAG S IF P RELATES TO R BY OP #
SUBR JOP(C) IS (
 C=1 => RETURN 42;
 C=2 => RETURN 41;
 C=3 => RETURN 43;
 C=5 => RETURN 44;
 C=6 => RETURN 46;
 45);

SUBR CJUMP(OP,P,R,S) IS (
 O,F ARE LOCAL;
 O:=OP; F:=0;
 (FREE(P) AND 300B)=200B => F:=1;
 (FREE(R) AND 300B)=200B => F:=1;
 F NE 0 => (O:=OP+OFJ; FLOAT(P); FLOAT(R));
 FETCH(P);
 ADDREC(R,KOP,O,REGOF(P),FREE(R),FREE(R+1),HL(FREE(S)));
 HOOK(P,P,R));

# MOVE B THROUGH N TO A: N+1 WORDS FROM B TO A, ASCENDING (THE LIBRARY ROUTINE IMP_BLK, CALLED LIKE ANY SUBROUTINE: THE ARGUMENTS ARE POINTERS) #
SUBR MOVEBLK(B,N,A) IS (
 T ARE LOCAL;
 T:=NAME(ENSTACK(DIR('impblk')));
 SUBRCALL(T);
 SUBRPAR(T,A); SUBRPAR(T,B); SUBRPAR(T,N);
 DEWFUN(T,2,REGOF(T));
 SUBPR0(1);
 T);

# FREEZE(S): THE ORIGINAL FLAGS THE CODE SO THAT THE ASSEMBLER DOES NOT DELETE INSTRUCTIONS FROM IT; PCC DOES ITS OWN ARITHMETIC, SO NOTHING #
SUBR FREEZE(S) IS S;

# ONEWORD(S): 1 IF THE CODE OF STACK ENTRY S IS EXACTLY ONE OPERATION #
SUBR ONEWORD(S) IS (
 J ARE LOCAL;
 J:=FREE(S+2);
 J=0 => RETURN 0;
 HL(J)=HR(J) => (RKIND(HL(J))=KOP => RETURN 1);
 0);

# COPPY(S): A COPY OF THE ENTRY S, WITH A COPY OF ITS CODE #
SUBR COPPY(S) IS (
 W ARE LOCAL;
 W:=ENSTACK(0);
 FREES(W,FREE(S)); FREES(W+1,FREE(S+1));
 FREES(W+2,FREE(S+2));
 FREE(W+2)=>COPYCO(W); W);

# SUBRCALL(T): BEGIN A CALL OF THE FUNCTION NAMED AT STACK ENTRY T; ITS VALUE WILL BE IN A NEW REGISTER #
SUBR SUBRCALL(T) IS (
 TT,DD,J ARE LOCAL;
 SUBPR0(0);
 TT:=FREE(T); DD:=HL(TT);
 DPROP('COM',DD)<2 => DPROPS('COM',DD,1);
 ADDREC(T,KOP,OCALLB,0,FREE(T),FREE(T+1),0);
 J:=AREG1(140B,0);
 FREES(T,(2 OR (TT AND (NOT 77B))));
 FREES(T+1,(J LS 32));
 T);

# RETURN(S): RETURN THE VALUE OF S FROM THE CURRENT SUBROUTINE #
SUBR RETURN(S) IS (
 DEWOP(OLOAD,0-AREG1(100B,0),S);
 ADDREC(S,KOP,ORET,REGOF(S),0,0,0);
 S);

# FLOAT(S): INSURE THAT S IS REAL #
SUBR FLOAT(S) IS (
 X IS REAL;
 SF,J,B ARE LOCAL;
 SF:=FREE(S);
 (SF AND 300B) NE 200B => (
     (SF AND 77B)=4 => (X:=FLT(FREE(S+1));          # A CONSTANT: THE DOUBLE'S BITS #
                        CCALL memcpy(LOC(B),LOC(X),8); FREES(S+1,B);       # (A REAL PASSED AS AN ARGUMENT IS FIXED: THE BITS GO THROUGH B) #
                        FREES(S,((204B OR (SF AND 777000B))));
                        RETURN S);
     FETCH(S);
     J:=REGOF(S);
     ADDREC(S,KOP,OFLOAT,J,FREE(S),FREE(S+1),0);
     FREES(S,((202B OR (SF AND (NOT 377B))))));
 S);

# FIX(S): INSURE THAT S IS AN INTEGER #
SUBR FIX(S) IS (
 X IS REAL;
 SF,J,B ARE LOCAL;
 SF:=FREE(S);
 (SF AND 300B)=0 => (FREES(S,(SF OR 100B)); RETURN S);       # NO TYPE (A PARAMETER): AN INTEGER #
 (SF AND 300B) NE 100B => (
     (SF AND 77B)=4 => (B:=FREE(S+1); CCALL memcpy(LOC(X),LOC(B),8); FREES(S+1,FIX(X));
                        FREES(S,((104B OR (SF AND 777000B))));
                        RETURN S);
     FETCH(S);
     J:=REGOF(S);
     ADDREC(S,KOP,OFIX,J,FREE(S),FREE(S+1),0);
     FREES(S,((102B OR (SF AND (NOT 377B))))));
 S);

# DATAST(B): CONSTANT WORDS FOR A DATA STATEMENT #
SUBR DATAST(B) IS (
 A,I,J,K ARE LOCAL;
 A:=ENSTACK(DIR('0'));
 FREES(A,((4 OR (FREE(A) AND (NOT 77B)))));
 DS1: GETLIST(B) => (
        FREE(B+2) => (ERROR(1,'NON-CONSTANT EXPRESSION IN DATA STATEMENT.'); GO TO DS1);
        I:=FREE(B);
        I<6,0>=4 => HL(I)=0 => (ADDREC(A,KWORD,0,0,0,FREE(B+1),0); GO TO DS1);
        I:=HL(I);
        (J:=CONVC(I)) NE 0 => (J<0 => (ADDREC(A,KWORD,0,0,0,CONST,0); GO TO DS1);
                              I:=FREE(J);
                              ADDREC(A,KWORD,0,0,0,FREE(J+K),0) FOR K IN 1,1,I;
                              GO TO DS1);
        # A NAME: ITS ADDRESS #
        HOOK(A,A,DEWOP(OADDR,AREG1(1,15B),B));
        GO TO DS1);
 A);

# SUBRPAR(S,PP): ADD THE ARGUMENT PP TO THE CALL S #
SUBR SUBRPAR(S,PP) IS (
 P ARE LOCAL;
 P:=SUBARG(S,PP);
 ADDREC(S,KOP,OARG,0,FREE(P),FREE(P+1),0);
 HOOK(S,P,S));

# PRINPAR(N,A,B,C,D): A PRINT LIST ITEM; THE ENTRY IT MAKES HAS THE CODE THAT COMPUTES THE ITEM IN WORD 2 AND, IN WORD 1, THE RECORDS THAT
  ENTER IT IN THE PRINT LIST.  N IS 0 AN EXPRESSION, 1 OCT, 2 IGR, 3 STG, 5 / (NEW LINE), 6 FILE, 7 IMAGE MODE, 8 DEVICE, 9 TAB, 10 FILL, 11 FLT #
SUBR PRINPAR(N,AA,B,C,D) IS (
 A,T,I,J,KK,SH,SA,SV,K ARE LOCAL;
 PPS IS 3 LONG;
 A:=AA;
 T:=ENSTACK(0);
 N=5 => (ADDREC(T,KOP,OPITEM,0,0,0,N); GO TO PP9);
 N=11 => (
    (FREE(A) AND 77B)=4 => (FREE(B) AND 77B)=4 => (
        FREES(A+1,((FREE(A+1) AND HMASK) OR (FREE(B+1) LS HSH)));
        FREES(A,HR(FREE(A)));
        GO TO PP1);
    I:=REGOF(DEWOP(OLOAD,AREG1(1,13B),A));
    J:=REGOF(DEWOP(OLOAD,AREG1(1,13B),B));
    HOOK(B,B,DEWOP(OLSH,J,STACKUP(HSH)));
    HOOK(A,A,B);
    DEWOP(OIOR,I,A);
    PP1: 0);
 A:=SUBARG(T,A);
 ADDREC(T,KOP,OPITEM,0,FREE(A),FREE(A+1),N);
 N NE 6 => GO TO PP9;
 PPS[0]:=B; PPS[1]:=C; PPS[2]:=D;
 (PPS[K]=0 => (ADDREC(T,KOP,OPITEM,0,0,0,N); GO TO PP10);
  SA:=SUBARG(T,PPS[K]);
  (FREE(SA) AND 77B)=4 => (
     K>0 => (                                # PROJECT AND PROGRAMMER: A DECIMAL CONSTANT READ AS OCTAL #
        CONVC(HL(FREE(SA))); J:=CONST;
        SH:=0; SV:=0;
        PP11: J NE 0 => (KK:=J/10;
                         (KK:=J-(10*KK))>7 => ERROR(1,'NON-OCTAL PJ OR PN **');
                         SV:=SV OR (KK:=J-(10*KK)) LS SH; SH:=SH+3;
                         J:=J/10; GO TO PP11);
        FREES(SA,(4 OR (STCON(SV) LS 32)));
        FREES(SA+1,0)));
  ADDREC(T,KOP,OPITEM,0,FREE(SA),FREE(SA+1),N);
  PP10: PPS[K]=0 => 0 ELSE HOOK(A,SA,A)) FOR K IN 0,1,2;
 PP9: FREES(A+1,FREE(T+2));
 FREES(A,4);                                 # SO THE MATCHER DOES NOT READ WORD 2 #
 A);

# PRINCAL(A,B): ADD THE PRINT LIST ITEM B TO THE PRINT CALL A #
SUBR PRINCAL(A,B) IS (
 C ARE LOCAL;
 C:=ENSTACK(0); FREES(C+2,FREE(B+1));
 HOOK(B,B,HOOK(C,A,C));
 FREES(B,FREE(A)); FREES(B+1,FREE(A+1));
 SUBPR0(1);
 B);

SUBR OJUMPOP(I) IS (
 VAL ARE LOCAL;
 VAL:=7 AND (I+4);
 I GE 8 => (1 AND I) NE 0 => VAL:=((2 AND (I+2)) OR (5 AND I));
 VAL);

# ADDR(S): THE ORIGINAL MAKES S OF TYPE 20B, SO THAT WHAT WAS THE VALUE WINDS UP IN THE ADDRESS FIELD OF THE INSTRUCTION (AN IMMEDIATE OPERAND, A SHIFT
  BY A CONSTANT).  AN OPERAND OF THE IR MACHINE CAN BE A CONSTANT, SO NOTHING #
SUBR ADDR(S) IS S;

SUBR CODE2I(NIL) IS (
  DSEM('DEWFUN',DEWFUN);
  DSEM('HOOK',HOOK);
  DSEM('FREEZE',FREEZE);
  DSEM('SUBRCALL',SUBRCALL);
  DSEM('RETURN',RETURN);
  DSEM('SUBRPAR',SUBRPAR);
  DSEM('CONOP',CONOP);
  DSEM('FLOAT',FLOAT);
  DSEM('FIX',FIX);
  DSEM('PRINCAL',PRINCAL);
  DSEM('PRINPAR',PRINPAR);
  DSEM('OJUMPOP',OJUMPOP);
  DSEM('DATAST',DATAST);
  DSEM('ADDR',ADDR);
  DSEM('COPY',COPPY);
  DSEM('JOP',JOP);
  DSEM('CJUMP',CJUMP);
  DSEM('MOVEBLK',MOVEBLK);
  CODE3I(0);
  0)%%
