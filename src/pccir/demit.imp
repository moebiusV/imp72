TWOSEG;
CO,NCO,ANCO ARE COMMON;
ARR,NARR,REGN,REMO ARE COMMON;
BDESC,NBD ARE COMMON;
ARGS IS 16 LONG;
PARGS IS 2 LONG;
#THIS IS FILE DEMIT, WHICH TAKES THE PLACE OF THE ASSEMBLER, THE REGISTER ALLOCATOR AND THE OUTPUT MODULE OF THE ORIGINAL (AMOD, RMOD, OMOD): IT READS THE
 CHAINS OF RECORDS THE CODE GENERATOR MADE (DOCS/PORTING/IR-MACHINE.MD) AND WRITES THEM AS PCC IR, THROUGH THE ROUTINES OF STAGE0/IR.C (CCALL).
 PCC DOES THE REGISTER ALLOCATION, THE INSTRUCTION SELECTION AND THE OBJECT FILE.  A REGISTER INDEX IS A TEMPORARY OF THE IR; A PROGRAM IS THE
 FUNCTION IMP_MAIN AND EACH SUBROUTINE ONE FUNCTION; THE ARGUMENTS OF A CALL ARE POINTERS TO THE VALUES (IMP PASSES BY REFERENCE).  THE ROUTINES ARE NOT
 RE-ENTERED (THE VARIABLES OF A ROUTINE ARE ITS OWN).  THE NAMES IRSYMNAME, IRKIND, IRSTRVAL, IRLABNAME, IRPOOLEMIT, IRFNKIND, IRCVAL AND IRRESET ARE
 STAGE0/IRSEM.C'S.#

SUBR RV(R) IS (
 T ARE LOCAL;
 FLEN(RTMP) LE R => (FADDEX(RTMP,R+64));
 T_FREE(RTMP+R);
 T=0 => (T_CCALL IXNEWTEMP(0); FREES(RTMP+R,T));
 CCALL IXTEMP(T,TLONG));

SUBR ICN(V) IS CCALL IXICON(HR(V),HL(V),TLONG);       # A 64 BIT VALUE CROSSES A CCALL AS TWO HALVES: A 32 BIT MACHINE PASSES A LONG AS 32 BITS #

SUBR ASG(L,R) IS CCALL IXSTMT(CCALL IXASSIGN(L,R));

# THE OFFSET FIELD OF AN ENTRY'S WORD 1: 18 BITS, SIGNED #
SUBR OFF18(W) IS ((R18(W) XOR 400000B) - 400000B);

SUBR TAGLABEL(D) IS (
 I,L ARE LOCAL;
 NTAGS>0 => ((FREE(TAGS+I)=D => RETURN FREE((TAGS+I)+1)) FOR I IN 0,2,NTAGS-2);
 L_CCALL IXNEWLABEL(0);
 FADD(TAGS,NTAGS,D); FADD(TAGS,NTAGS,L);
 L);

# NOTE THAT VARIABLE D IS USED BY THE UNIT #
SUBR USEVAR(D) IS (
 I ARE LOCAL;
 NUSED>0 => ((FREE(USEDV+I)=D => RETURN 0) FOR I IN 0,1,NUSED-1);
 FADD(USEDV,NUSED,D);
 0);

# THE LABEL OF THE POOLED CONSTANT NAMED D (A TEXT OR A NUMBER USED AS AN ADDRESS) #
SUBR POOLOF(D) IS (
 I,L ARE LOCAL;
 NPOOL>0 => ((FREE(POOLS+I)=D => RETURN FREE((POOLS+I)+1)) FOR I IN 0,2,NPOOL-2);
 L_CCALL IXNEWLABEL(0);
 FADD(POOLS,NPOOL,D); FADD(POOLS,NPOOL,L);
 L);

# THE ADDRESS OF A DIRECTORY ENTRY D, PLUS O WORDS, AS A POINTER #
SUBR SYMADDR(D,O) IS (
 K ARE LOCAL;
 K_CCALL IRKIND(D);
 K=0 => (USEVAR(D); RETURN CCALL IXSYM(CCALL IRSYMNAME(D),8*O,TPLONG));
 CCALL IXSYM(CCALL IRLABNAME(POOLOF(D)),8*O,TPLONG));

# THE ADDRESS OF THE OPERAND (V0,V1) AS A POINTER EXPRESSION.  A VARIABLE IS ITS BYTE ADDRESS; THE OFFSET AND THE INDEX REGISTER COUNT WORDS WHEN THERE IS A
  VARIABLE (V[I] IS AT &V+8*I); A WORD WITH NO VARIABLE IS A POINTER IN THE REGISTER, PLUS THE OFFSET IN WORDS, OR AN ABSOLUTE ADDRESS #
SUBR EADDR(V0,V1) IS (
 D,R,O,E,X1,X2,X3 ARE LOCAL;
 D_L18(V0);
 (V0 AND 77B)=4 => (D=0 => ERROR(1,'THE ADDRESS OF A COMPUTED CONSTANT.');       # A NAMED CONSTANT: THE ADDRESS OF ITS WORD #
                    RETURN SYMADDR(D,0));
 R_3777B AND L18(V1); O_OFF18(V1);
 D NE 0 => (E_SYMADDR(D,O);
            R NE 0 => (X1_RV(R); X2_CCALL IXICON(3,0,TINT); X3_CCALL IXBIN(IRLS,TLONG,X1,X2);
                       E_CCALL IXBIN(IRPLUS,TPLONG,E,X3)))
  ELSE (R NE 0 => (X1_CCALL IXICON(HR(8*O),HL(8*O),TPLONG); X2_RV(R); E_CCALL IXBIN(IRPLUS,TPLONG,X1,X2))
         ELSE E_CCALL IXICON(HR(O),HL(O),TPLONG));
 V1 LT 0 => (X1_CCALL IXDEREF(E,TLONG); E_CCALL IXUN(IRPCONV,TPLONG,X1));       # INDIRECT: THE WORD IS A POINTER #
 E);

# THE VALUE OF THE OPERAND (V0,V1) #
SUBR VEXPR(V0,V1) IS (
 K,D,R,O,X1,X2 ARE LOCAL;
 K_V0 AND 77B; D_L18(V0);
 K=2 => RETURN RV(3777B AND L18(V1));
 K=4 => (D NE 0 => (CCALL IRKIND(D)=1 => (X1_CCALL IRSTRVAL(D); X2_CCALL DIRHIGH(0); RETURN CCALL IXICON(HR(X1),HR(X2),TLONG)));
         RETURN ICN(V1));
 D NE 0 => K=10B => (BDFIND(D)) GE 0 => RETURN BPVALUE(BDFIND(D));
 R_3777B AND L18(V1); O_OFF18(V1);
 D NE 0 => R=0 => V1 GE 0 => CCALL IRKIND(D)=0 => (USEVAR(D);
                                                  RETURN CCALL IXNAME(CCALL IRSYMNAME(D),8*O,TLONG));
 CCALL IXDEREF(EADDR(V0,V1),TLONG));

SUBR BOOLOP(OP,A,B) IS (
 OP=OAND => RETURN CCALL IXBIN(IRAND,TLONG,A,B);
 OP=OANDCA => RETURN CCALL IXBIN(IRAND,TLONG,CCALL IXUN(IRCOMPL,TLONG,A),B);
 OP=OANDCM => RETURN CCALL IXBIN(IRAND,TLONG,A,CCALL IXUN(IRCOMPL,TLONG,B));
 OP=OANDCB => RETURN CCALL IXBIN(IRAND,TLONG,CCALL IXUN(IRCOMPL,TLONG,A),CCALL IXUN(IRCOMPL,TLONG,B));
 OP=OIOR => RETURN CCALL IXBIN(IROR,TLONG,A,B);
 OP=OORCA => RETURN CCALL IXBIN(IROR,TLONG,CCALL IXUN(IRCOMPL,TLONG,A),B);
 OP=OORCM => RETURN CCALL IXBIN(IROR,TLONG,A,CCALL IXUN(IRCOMPL,TLONG,B));
 OP=OORCB => RETURN CCALL IXBIN(IROR,TLONG,CCALL IXUN(IRCOMPL,TLONG,A),CCALL IXUN(IRCOMPL,TLONG,B));
 OP=OXOR => RETURN CCALL IXBIN(IRER,TLONG,A,B);
 CCALL IXUN(IRCOMPL,TLONG,CCALL IXBIN(IRER,TLONG,A,B)));

# THE COMPARISON OPERATOR OF THE JUMP OPERATION OP (41 TO 46, 51 TO 56) #
SUBR CMPOF(OP) IS (
 K ARE LOCAL;
 K_OP; K>50 => K_K-10;
 K=OJEQ => RETURN IREQ;
 K=OJLT => RETURN IRLT;
 K=OJLE => RETURN IRLE;
 K=OJGE => RETURN IRGE;
 K=OJGT => RETURN IRGT;
 IRNE);

# A SHIFT BY A COUNT: ARITHMETIC (OP=OASH), LOGICAL (OLSH) OR A ROTATION.  A CONSTANT COUNT IS DONE IN LINE; THE RUNTIME ROUTINES IMP_LSH, IMP_ASH AND IMP_ROT DO THE REST:
  THEY TAKE THE ADDRESSES OF THE WORDS IMP_SA, IMP_SB (THE OPERANDS) AND IMP_SR (THE RESULT), FOR A CALL CANNOT CARRY A 64 BIT WORD ON A 32 BIT MACHINE #
SUBR ESHIFT(OP,RD,V0,V1) IS (
 N,X1,X2,X3 ARE LOCAL;
 (V0 AND 77B)=4 => OP NE OROT => (
     N_V1;
     N=0 => RETURN 0;
     N GE 64 => RETURN ASG(RV(RD),ICN(0));
     N LE -64 => (OP=OASH => N_-63 ELSE RETURN ASG(RV(RD),ICN(0)));
     N>0 => RETURN ASG(RV(RD),CCALL IXSHIFT(0,RV(RD),ICN(N)));
     OP=OASH => RETURN ASG(RV(RD),CCALL IXSHIFT(2,RV(RD),ICN(0-N)));
     RETURN ASG(RV(RD),CCALL IXSHIFT(1,RV(RD),ICN(0-N))));
 SHUSED_1;
 X1_CCALL IXNAME(LOC('imp_sa'),0,TLONG); X2_RV(RD); ASG(X1,X2);
 X1_CCALL IXNAME(LOC('imp_sb'),0,TLONG); X2_VEXPR(V0,V1); ASG(X1,X2);
 ARGS[0]_CCALL IXSYM(LOC('imp_sa'),0,TPLONG);
 ARGS[1]_CCALL IXSYM(LOC('imp_sb'),0,TPLONG);
 ARGS[2]_CCALL IXSYM(LOC('imp_sr'),0,TPLONG);
 OP=OLSH => X3_CCALL IXSYM(LOC('imp_lsh'),0,TPFTN)
  ELSE (OP=OASH => X3_CCALL IXSYM(LOC('imp_ash'),0,TPFTN) ELSE X3_CCALL IXSYM(LOC('imp_rot'),0,TPFTN));
 CCALL IXSTMT(CCALL IXCALL(X3,LOC(ARGS),3,1));
 X1_CCALL IXNAME(LOC('imp_sr'),0,TLONG);
 ASG(RV(RD),X1));

# END A CALL (CALLE): THE CALL OF THE FUNCTION CALLFN WITH THE ARGUMENTS ARGS; RD IS WHERE THE VALUE GOES #
SUBR ECALL(RD) IS (
 TREE,K,CVAL,CRET ARE LOCAL;
 CALLMODE NE 0 => (PLAST NE 0 => (RD NE 0 => ASG(RV(RD),PLAST) ELSE CCALL IXSTMT(PLAST));
                   PLAST_0; CALLMODE_0; RETURN 0);
 CVAL_CCALL IRCVAL(CALLFN);
 CRET_CVAL;
 CRET=0 => CRET_CCALL IRRUNTIME(CALLFN);
 NFN<60 => FADD(FNAMES,NFN,CALLFN);
 CVAL NE 0 => (ARGS[K]_CCALL IXDEREF(ARGS[K],TLONG)) FOR K IN 0,1,NARGS-1;
 CVAL NE 0 => CCALL IXPASS(LOC('# cfunc %s'),CCALL IRSYMNAME(CALLFN));
 TREE_CCALL IXCALL(CCALL IXSYM(CCALL IRSYMNAME(CALLFN),0,TPFTN),LOC(ARGS),NARGS,CRET);
 RD NE 0 => ASG(RV(RD),TREE) ELSE CCALL IXSTMT(TREE);
 0);

# A PRINT LIST ITEM: A CALL OF IMP_PR (OR IMP_RD) FOR THE ITEM, WITH THE FORMAT CODE N AND THE ADDRESS OF THE OPERAND (0 FOR NONE) #
SUBR EPITEM(N,V0,V1) IS (
 TREE ARE LOCAL;
 PARGS[0]_ICN(N);
 V0=0 => PARGS[1]_CCALL IXICON(0,0,TPLONG) ELSE PARGS[1]_EADDR(V0,V1);
 CALLMODE=2 => TREE_CCALL IXCALL(CCALL IXSYM(LOC('imp_rd'),0,TPFTN),LOC(PARGS),2,1)
  ELSE TREE_CCALL IXCALL(CCALL IXSYM(LOC('imp_pr'),0,TPFTN),LOC(PARGS),2,1);
 PLAST NE 0 => CCALL IXSTMT(PLAST);
 PLAST_TREE;
 0);

# GO TO GO[B] (A COMPUTED GO TO): THE JUMPS AFTER THE TAG GO ARE THE TABLE; THE INDEX IS THE REGISTER PLUS THE OFFSET.  A COMPARISON FOR EACH JUMP #
SUBR ETABJUMP(V0,V1) IS (
 D,R,O,I,J,K,T,E,RR ARE LOCAL;
 D_L18(V0); R_3777B AND L18(V1); O_OFF18(V1);
 J_-1;
 (RR_FREE(RLIST+I); RKIND(RR)=KTAG => RX(RR)=D => J_I) FOR I IN 0,1,NRL-1;
 J<0 => RETURN ERROR(1,'COMPUTED GO TO WITHOUT ITS TABLE.');
 R NE 0 => (E_RV(R); O NE 0 => E_CCALL IXBIN(IRPLUS,TLONG,E,ICN(O)))
  ELSE E_ICN(O);
 T_CCALL IXNEWTEMP(0);
 ASG(CCALL IXTEMP(T,TLONG),E);
 K_0; I_J+1;
 TJ1: I<NRL => (RR_FREE(RLIST+I);
                RKIND(RR)=KOP => ROP(RR)=OJUMP => (
                    CCALL IXCBRANCH(IREQ,CCALL IXTEMP(T,TLONG),ICN(K),TAGLABEL(L18(RV0(RR))));
                    K_K+1; I_I+1; GO TO TJ1));
 CCALL IXGOTO(TAGLABEL(D)));

# BYTES: THE DESCRIPTORS (BYTEP) AND THE BYTE POINTERS.  A BYTE POINTER KEPT IN A VARIABLE OR REGISTER IS ONE WORD: BITS 63-58 THE SIZE, 57-52 THE POSITION (BITS
  FROM THE RIGHT, AS IN A<S,P>), AND THE LOW 52 BITS THE BYTE ADDRESS OF THE WORD THAT HOLDS THE FIELD.  STEPPING IT MOVES TO THE NEXT LOWER FIELD OF THE SAME SIZE, OR
  TO THE NEXT WORD (ADDRESS+8) WHEN THERE IS NO ROOM. #

SUBR BDFIND(D) IS (
 I ARE LOCAL;
 NBD>0 => ((FREE(BDESC+I)=D => RETURN I) FOR I IN 0,7,NBD-7);
 0-1);

# A VALUE KEPT IN A TEMPORARY (PCC CANNOT HAVE TWO VARIABLE SHIFTS IN ONE TREE, AND A NODE IS USED ONCE) #
SUBR TMPV(E) IS (
 T ARE LOCAL;
 T_CCALL IXNEWTEMP(0);
 ASG(CCALL IXTEMP(T,TLONG),E);
 T);

SUBR TV(T) IS CCALL IXTEMP(T,TLONG);
SUBR SHL(X,C) IS CCALL IXSHIFT(0,X,C);
SUBR SHR(X,C) IS CCALL IXSHIFT(1,X,C);

# THE MASK OF A FIELD OF SIZE (V0,V1) #
SUBR FMASK(V0,V1) IS (
 M ARE LOCAL;
 (V0 AND 77B)=4 => (V1 GE 63 => M_-1 ELSE M_((1 LS V1)-1);
                    RETURN ICN(M));
 CCALL IXBIN(IRMINUS,TLONG,SHL(ICN(1),VEXPR(V0,V1)),ICN(1)));

# THE POINTER IN TEMPORARY PT: ITS SIZE, ITS POSITION, THE WORD IT ADDRESSES, THE MASK (ONE STEP AT A TIME: NESTED CALLS OF ROUTINES THAT CALL ROUTINES ARE NOT SAFE HERE) #
SUBR BPSIZE(PT) IS (
 X1,X2 ARE LOCAL;
 X1_SHR(TV(PT),ICN(58));
 X2_ICN(63);
 CCALL IXBIN(IRAND,TLONG,X1,X2));

SUBR BPPOS(PT) IS (
 X1,X2 ARE LOCAL;
 X1_SHR(TV(PT),ICN(52));
 X2_ICN(63);
 CCALL IXBIN(IRAND,TLONG,X1,X2));

SUBR BPWORD(PT) IS (
 X1,X2,X3,X4 ARE LOCAL;
 X4_1 LS 52; X4_X4-1;                       # THE MASK OF THE ADDRESS: COMPUTED AS THE PROGRAM RUNS, FOR THE COMPILER THAT COMPILES THIS FOLDS CONSTANTS IN 36 BITS #
 X1_ICN(X4);
 X2_CCALL IXBIN(IRAND,TLONG,TV(PT),X1);
 X3_CCALL IXUN(IRPCONV,TPLONG,X2);
 CCALL IXDEREF(X3,TLONG));

SUBR BPMASK(PT) IS (
 X1,X2,X3 ARE LOCAL;
 X1_BPSIZE(PT);
 X2_SHL(ICN(1),X1);
 X3_ICN(1);
 CCALL IXBIN(IRMINUS,TLONG,X2,X3));

# THE VALUE OF THE DESCRIPTOR AT BDESC+J AS A BYTE POINTER (BYTEP A<S,P>) #
SUBR BPVALUE(J) IS (
 E,X1,X2,X3,X4,A0,A1 ARE LOCAL;
 A0_FREE((BDESC+J)+1); A1_FREE((BDESC+J)+2);
 X1_EADDR(A0,A1);
 E_CCALL IXUN(IRPCONV,TLONG,X1);
 A0_FREE((BDESC+J)+3); A1_FREE((BDESC+J)+4);
 X2_VEXPR(A0,A1);
 X3_SHL(X2,ICN(58));
 E_CCALL IXBIN(IROR,TLONG,E,X3);
 A0_FREE((BDESC+J)+5); A1_FREE((BDESC+J)+6);
 X2_VEXPR(A0,A1);
 X4_SHL(X2,ICN(52));
 CCALL IXBIN(IROR,TLONG,E,X4));

# IBP: STEP THE POINTER IN THE OPERAND (V0,V1) TO THE NEXT FIELD; THE TEMPORARY HAS THE NEW POINTER #
SUBR BPSTEP(V0,V1) IS (
 PT,NP,LOK,X1,X2,X3,X4 ARE LOCAL;
 PT_CCALL IXNEWTEMP(0); NP_CCALL IXNEWTEMP(0); LOK_CCALL IXNEWLABEL(0);
 X1_VEXPR(V0,V1);
 ASG(TV(PT),X1);
 X1_BPPOS(PT); X2_BPSIZE(PT);
 X3_CCALL IXBIN(IRMINUS,TLONG,X1,X2);
 ASG(TV(NP),X3);
 CCALL IXCBRANCH(IRGE,TV(NP),ICN(0),LOK);
 X1_BPSIZE(PT);
 X2_CCALL IXBIN(IRMINUS,TLONG,ICN(64),X1);
 ASG(TV(NP),X2);
 X3_CCALL IXBIN(IRPLUS,TLONG,TV(PT),ICN(8));
 ASG(TV(PT),X3);
 CCALL IXLABEL(LOK);
 X4_63 LS 52; X4_NOT X4;
 X1_CCALL IXBIN(IRAND,TLONG,TV(PT),ICN(X4));
 X2_SHL(TV(NP),ICN(52));
 X3_CCALL IXBIN(IROR,TLONG,X1,X2);
 ASG(TV(PT),X3);
 X1_VEXPR(V0,V1);
 ASG(X1,TV(PT));
 PT);

# RD GETS (W SHIFTED RIGHT BY P) AND M, THE TEMPORARIES; ONE STEP AT A TIME, FOR A ROUTINE'S ARGUMENTS ARE NOT RE-ENTERED #
SUBR EFIELD(RD,W,P,M) IS (
 X1,X2,X3,X4 ARE LOCAL;
 X1_SHR(TV(W),TV(P));
 X2_TV(M);
 X3_CCALL IXBIN(IRAND,TLONG,X1,X2);
 X4_RV(RD);
 ASG(X4,X3));

# THE WORD OF A FIELD: ITS OLD VALUE WITH THE BITS OF THE MASK (TEMPORARY M) CLEARED AND THE BITS OF THE VALUE (TEMPORARY V) PUT IN #
SUBR ENEWWORD(OLD,M,V) IS (
 X1,X2,X3,X4 ARE LOCAL;
 X1_CCALL IXUN(IRCOMPL,TLONG,TV(M));
 X2_CCALL IXBIN(IRAND,TLONG,OLD,X1);
 X3_CCALL IXBIN(IRAND,TLONG,TV(V),TV(M));
 CCALL IXBIN(IROR,TLONG,X2,X3));

# ASSIGN THE NODE R TO THE PLACE L #
SUBR EWRITE(L,R) IS ASG(L,R);

# LOAD BYTE: RD GETS THE FIELD, RIGHT JUSTIFIED.  THE OPERAND IS A DESCRIPTOR (A<S,P>) OR A VARIABLE HOLDING A BYTE POINTER; STEP: ILDB #
SUBR ELDB(RD,V0,V1,STEP) IS (
 J,W,P,M,PT,X1,A0,A1 ARE LOCAL;
 J_-1;
 (V0 AND 77B)=10B => STEP=0 => J_BDFIND(L18(V0));
 J GE 0 => (A0_FREE((BDESC+J)+1); A1_FREE((BDESC+J)+2);
            X1_VEXPR(A0,A1); W_TMPV(X1);
            A0_FREE((BDESC+J)+5); A1_FREE((BDESC+J)+6);
            X1_VEXPR(A0,A1); P_TMPV(X1);
            A0_FREE((BDESC+J)+3); A1_FREE((BDESC+J)+4);
            X1_FMASK(A0,A1); M_TMPV(X1);
            RETURN EFIELD(RD,W,P,M));
 STEP NE 0 => PT_BPSTEP(V0,V1)
  ELSE (PT_CCALL IXNEWTEMP(0); X1_VEXPR(V0,V1); ASG(TV(PT),X1));
 X1_BPWORD(PT); W_TMPV(X1);
 X1_BPPOS(PT); P_TMPV(X1);
 X1_BPMASK(PT); M_TMPV(X1);
 EFIELD(RD,W,P,M));

# DEPOSIT BYTE: THE LOW BITS OF RD INTO THE FIELD; STEP: IDPB #
SUBR EDPB(RD,V0,V1,STEP) IS (
 J,P,K,M,V,PT,X1,X2,X3,A0,A1,B0,B1 ARE LOCAL;
 J_-1;
 (V0 AND 77B)=10B => STEP=0 => J_BDFIND(L18(V0));
 J GE 0 => (A0_FREE((BDESC+J)+5); A1_FREE((BDESC+J)+6);
            X1_VEXPR(A0,A1); P_TMPV(X1);
            A0_FREE((BDESC+J)+3); A1_FREE((BDESC+J)+4);
            X1_FMASK(A0,A1); K_TMPV(X1);
            X1_SHL(TV(K),TV(P)); M_TMPV(X1);
            X1_RV(RD); X2_SHL(X1,TV(P)); V_TMPV(X2);
            B0_FREE((BDESC+J)+1); B1_FREE((BDESC+J)+2);
            X1_VEXPR(B0,B1);
            X2_ENEWWORD(X1,M,V);
            X3_VEXPR(B0,B1);
            RETURN EWRITE(X3,X2));
 STEP NE 0 => PT_BPSTEP(V0,V1)
  ELSE (PT_CCALL IXNEWTEMP(0); X1_VEXPR(V0,V1); ASG(TV(PT),X1));
 X1_BPPOS(PT); P_TMPV(X1);
 X1_BPMASK(PT); K_TMPV(X1);
 X1_SHL(TV(K),TV(P)); M_TMPV(X1);
 X1_RV(RD); X2_SHL(X1,TV(P)); V_TMPV(X2);
 X1_BPWORD(PT);
 X2_ENEWWORD(X1,M,V);
 X3_BPWORD(PT);
 EWRITE(X3,X2));

# HRLM, HRRM: THE RIGHT HALF OF RD INTO THE LEFT (POS=32) OR THE RIGHT (POS=0) HALF OF THE OPERAND; THE HALVES ARE 32 BITS #
SUBR EHALF(RD,V0,V1,POS) IS (
 M,V,X1,X2,X3,X4 ARE LOCAL;
 X4_1 LS 32; X4_X4-1;                          # THE MASK OF A HALF, COMPUTED AS THE PROGRAM RUNS (SEE BPWORD) #
 X1_ICN(X4);
 POS NE 0 => (X2_ICN(POS); X3_CCALL IXBIN(IRLS,TLONG,X1,X2)) ELSE X3_X1;
 M_TMPV(X3);
 X1_RV(RD); X2_ICN(POS); X3_SHL(X1,X2);
 V_TMPV(X3);
 X1_VEXPR(V0,V1);
 X2_ENEWWORD(X1,M,V);
 X1_VEXPR(V0,V1);
 EWRITE(X1,X2));

# CALLI: RD GETS THE VALUE OF IMP_CALLI(THE CODE, THE AC); THE LIBRARY ROUTINE TAKES THE TWO WORDS AS C LONGS #
SUBR ECALLI(RD,V0,V1) IS (
 X1,X2 ARE LOCAL;
 ARGS[0]_VEXPR(V0,V1);
 ARGS[1]_RV(RD);
 X1_CCALL IXSYM(LOC('imp_calli'),0,TPFTN);
 X2_CCALL IXCALL(X1,LOC(ARGS),2,1);
 ASG(RV(RD),X2));

# ONE RECORD OF THE CODE #
SUBR EREC(R) IS (
 OP,RD,V0,V1,TREE,K,X1,X2,X3 ARE LOCAL;
 OP_ROP(R); RD_RRD(R); V0_RV0(R); V1_RV1(R);
 RKIND(R)=KTAG => RETURN CCALL IXLABEL(TAGLABEL(RX(R)));
 RKIND(R) NE KOP => RETURN 0;
 OP=OENTRY => RETURN 0;
 OP=OPARAM => RETURN 0;
 OP=OLOAD => RETURN ASG(RV(RD),VEXPR(V0,V1));
 OP=ONEG => RETURN ASG(RV(RD),CCALL IXUN(IRUMINUS,TLONG,VEXPR(V0,V1)));
 OP=OCOMPL => RETURN ASG(RV(RD),CCALL IXUN(IRCOMPL,TLONG,VEXPR(V0,V1)));
 OP=OADDR => RETURN ASG(RV(RD),CCALL IXUN(IRPCONV,TLONG,EADDR(V0,V1)));
 OP=OSTORE => RETURN ASG(VEXPR(V0,V1),RV(RD));
 OP=OADD => RETURN ASG(RV(RD),CCALL IXBIN(IRPLUS,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OADDX => RETURN ASG(RV(RD),CCALL IXBIN(IRPLUS,TLONG,RV(RD),CCALL IXBIN(IRMUL,TLONG,VEXPR(V0,V1),ICN(8))));
 OP=OSUB => RETURN ASG(RV(RD),CCALL IXBIN(IRMINUS,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OMUL => RETURN ASG(RV(RD),CCALL IXBIN(IRMUL,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=ODIV => RETURN ASG(RV(RD),CCALL IXBIN(IRDIV,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OMOD => RETURN ASG(RV(RD),CCALL IXBIN(IRMOD,TLONG,RV(RD),VEXPR(V0,V1)));
 OP GE OAND => OP LE OEQV => RETURN ASG(RV(RD),BOOLOP(OP,RV(RD),VEXPR(V0,V1)));
 OP GE OLSH => OP LE OROT => RETURN ESHIFT(OP,RD,V0,V1);
 OP GE OFADD => OP LE OFDIV => (
     OP=OFADD => K_IRPLUS;
     OP=OFSUB => K_IRMINUS;
     OP=OFMUL => K_IRMUL;
     OP=OFDIV => K_IRDIV;
     X1_RV(RD); X2_CCALL IXTODOUBLE(X1,0);
     X1_VEXPR(V0,V1); X3_CCALL IXTODOUBLE(X1,1);
     TREE_CCALL IXBIN(K,TDOUBLE,X2,X3);
     X1_CCALL IXFROMDOUBLE(TREE);
     RETURN ASG(RV(RD),X1));
 OP=ONEGF => RETURN ASG(RV(RD),CCALL IXBIN(IRER,TLONG,VEXPR(V0,V1),ICN(1 LS 63)));
 OP=OLDB => RETURN ELDB(RD,V0,V1,0);
 OP=OILDB => RETURN ELDB(RD,V0,V1,1);
 OP=ODPB => RETURN EDPB(RD,V0,V1,0);
 OP=OIDPB => RETURN EDPB(RD,V0,V1,1);
 OP=OFLOAT => (X1_VEXPR(V0,V1); X2_CCALL IXUN(IRSCONV,TDOUBLE,X1); X1_CCALL IXFROMDOUBLE(X2); RETURN ASG(RV(RD),X1));
 OP=OFIX => (X1_VEXPR(V0,V1); X2_CCALL IXTODOUBLE(X1,0); X1_CCALL IXUN(IRSCONV,TLONG,X2); RETURN ASG(RV(RD),X1));
 OP=OJUMP => ((V0 AND 77B)=20B => RETURN ETABJUMP(V0,V1); RETURN CCALL IXGOTO(TAGLABEL(L18(V0))));
 OP GE OJEQ => OP LE OJNE => RETURN CCALL IXCBRANCH(CMPOF(OP),RV(RD),VEXPR(V0,V1),TAGLABEL(RX(R)));
 OP GE 51 => OP LE 56 => (X1_RV(RD); X2_CCALL IXTODOUBLE(X1,0);              # THE JUMPS ON REALS #
                           X1_VEXPR(V0,V1); X3_CCALL IXTODOUBLE(X1,1);
                           RETURN CCALL IXCBRANCH(CMPOF(OP),X2,X3,TAGLABEL(RX(R))));
 OP=OCALLB => (CALLFN_L18(V0); NARGS_0; PLAST_0; CALLMODE_CCALL IRFNKIND(CALLFN); RETURN 0);
 OP=OARG => (NARGS<16 => (ARGS[NARGS]_EADDR(V0,V1); NARGS_NARGS+1); RETURN 0);
 OP=OCALLE => RETURN ECALL(RD);
 OP=OCALLI => RETURN ECALLI(RD,V0,V1);
 OP=OHRLM => RETURN EHALF(RD,V0,V1,32);
 OP=OHRRM => RETURN EHALF(RD,V0,V1,0);
 OP=OAPPLY => (X1_VEXPR(V0,V1); X2_CCALL IXUN(IRPCONV,TPFTN,X1); CCALL IXSTMT(CCALL IXCALL(X2,LOC(ARGS),0,0)); RETURN 0);
 OP=OPITEM => RETURN EPITEM(RX(R),V0,V1);
 OP=ORET => (ASG(CCALL IXTEMP(RETTMP,TLONG),RV(RD)); RETURN CCALL IXGOTO(RETLAB));
 ERROR(1,'UNKNOWN OPERATION IN THE CODE.');
 0);

# A JUMP TO A TAG THAT IS NOT IN THE FUNCTION (A GO TO ACROSS SUBROUTINES) IS AN ERROR; THE TAG IS DEFINED AT THE END, FOR PASS 2 OF PCC STOPS AT A LABEL NOT DEFINED #
SUBR ECHKTAGS(I0,I1) IS (
 I,J,Q ARE LOCAL;
 NTAGS>0 => ((Q_0;
              (RKIND(FREE(RLIST+J))=KTAG => RX(FREE(RLIST+J))=FREE(TAGS+I) => Q_1) FOR J IN I0,1,I1-1;
              NRL2>0 => ((RKIND(FREE(RLIST2+J))=KTAG => RX(FREE(RLIST2+J))=FREE(TAGS+I) => Q_1) FOR J IN 0,1,NRL2-1);
              Q=0 => (CCALL IRTAGERR(FREE(TAGS+I));
                      CCALL IXLABEL(FREE((TAGS+I)+1)))) FOR I IN 0,2,NTAGS-2);
 0);

# THE RECORDS B[I0] TO B[I1-1] OF A FUNCTION.  F=1: THE REMOTE CODE (REMOT), OF WHICH ONLY THE SEGMENTS MARKED WITH NN, THE NAME OF THE ROUTINE (0: THE MAIN PROGRAM) ARE ITS #
SUBR EBODY(B,I0,I1,F,NN) IS (
 I,R,CNT,ACT ARE LOCAL;
 I_I0; ACT_1; F NE 0 => ACT_0;
 EB1: I<I1 => (R_FREE(B+I);
               F NE 0 => RKIND(R)=KOP => ROP(R)=OREMOTE => (RX(R)=NN => ACT_1 ELSE ACT_0; I_I+1; GO TO EB1);
               ACT=0 => (I_I+1; GO TO EB1);
               # DATA: A TAG FOLLOWED BY WORDS #
               RKIND(R)=KTAG => (I+1<I1 => RKIND(FREE((B+I)+1))=KWORD => (
                   FADD(DDL,NDDL,RX(R)); FADD(DDL,NDDL,NDDW);
                   CNT_0; I_I+1;
                   EB2: I<I1 => RKIND(FREE(B+I))=KWORD => (FADD(DDW,NDDW,RV1(FREE(B+I))); CNT_CNT+1; I_I+1; GO TO EB2);
                   FADD(DDL,NDDL,CNT);
                   GO TO EB1));
               EREC(R);
               I_I+1; GO TO EB1);
 0);

# A FUNCTION: THE RECORDS RLIST[I0] TO RLIST[I1-1]; THE MAIN PROGRAM (ISMAIN) OR A SUBROUTINE, WHICH BEGINS WITH THE ENTRY RECORD AND ITS PARAMETERS #
SUBR EFUNC(I0,I1,ISMAIN) IS (
 I,R,K,J,NM,NN ARE LOCAL;
 ISMAIN NE 0 => NM_LOC('imp_main')
  ELSE (NM_CCALL IRSYMNAME(L18(RV0(FREE(RLIST+I0)))); FADD(FNAMES,NFN,L18(RV0(FREE(RLIST+I0)))));
 CCALL IXFUNCBEGIN(NM,1);
 (FREES(RTMP+J,0)) FOR J IN 0,1,FLEN(RTMP)-1;
 NTAGS_0;
 RETLAB_CCALL IXNEWLABEL(0);
 RETTMP_CCALL IXNEWTEMP(0);
 K_0;
 ISMAIN=0 => ((R_FREE(RLIST+I)) => (RKIND(R)=KOP => ROP(R)=OPARAM => (
                  ASG(RV(RRD(R)),CCALL IXUN(IRPCONV,TLONG,CCALL IXPARAM(K))); K_K+1))) FOR I IN I0,1,I1-1;
 CCALL IXLABEL(CCALL IXNEWLABEL(0));            # PCC'S OPTIMIZER WANTS A LABEL BETWEEN THE ARGUMENT MOVES AND THE CODE (DELJUMPS: PROLOG, LABEL, MOVES, LABEL, CODE) #
 EBODY(RLIST,I0,I1,0,0);
 ISMAIN NE 0 => NN_0 ELSE NN_L18(RV0(FREE(RLIST+I0)));
 EBODY(RLIST2,0,NRL2,1,NN);                    # THE REMOTE CODE OF THIS ROUTINE (REMOT) #
 ECHKTAGS(I0,I1);
 CCALL IXFUNCEND(RETLAB,RETTMP);
 0);

# THE DATA OF THE UNIT: THE VARIABLES USED (COMMON SYMBOLS, SIZED BY THEIR DECLARATIONS), DATA STATEMENTS AND THE POOLED CONSTANTS #
SUBR EDATA(NIL) IS (
 I,D,J,SZ,W,Q ARE LOCAL;
 CCALL IRFSUSED(0) NE 0 => (CCALL IXPASS(LOC(' .comm imp_fs0,8,8')); CCALL IXPASS(LOC(' .comm imp_fs1,8,8')); CCALL IXPASS(LOC(' .comm imp_fsr,8,8')));
 SHUSED NE 0 => (CCALL IXPASS(LOC(' .comm imp_sa,8,8')); CCALL IXPASS(LOC(' .comm imp_sb,8,8')); CCALL IXPASS(LOC(' .comm imp_sr,8,8')); SHUSED_0);
 NUSED>0 => (
  D_FREE(USEDV+I);
  Q_0;
  NDDL>0 => ((FREE(DDL+J)=D => Q_1) FOR J IN 0,3,NDDL-3);
  NFN>0 => ((FREE(FNAMES+J)=D => Q_1) FOR J IN 0,1,NFN-1);
  Q=0 => (SZ_8;
          NARR>0 => ((W_FREE(ARR+J); R18(W)=D => SZ_8*L18(W)) FOR J IN 0,1,NARR-1);
          DPROP('COM',D)=0 => CCALL IXPASS(LOC(' .local %s'),CCALL IRSYMNAME(D));
          CCALL IXPASS(LOC(' .comm %s,%ld,8'),CCALL IRSYMNAME(D),SZ))) FOR I IN 0,1,NUSED-1;
 NDDL>0 => (
  CCALL IXPASS(LOC(' .data'));
  CCALL IXPASS(LOC(' .balign 8'));
  CCALL IXPASS(LOC('%s:'),CCALL IRSYMNAME(FREE(DDL+I)));
  CCALL IXQUAD(HR(FREE(DDW+(FREE((DDL+I)+1)+J))),HL(FREE(DDW+(FREE((DDL+I)+1)+J)))) FOR J IN 0,1,FREE((DDL+I)+2)-1) FOR I IN 0,3,NDDL-3;
 NPOOL>0 => (
  CCALL IXPASS(LOC(' .data'));
  CCALL IXPASS(LOC(' .balign 8'));
  CCALL IXPASS(LOC('.L%d:'),FREE((POOLS+I)+1));
  CCALL IRPOOLEMIT(FREE(POOLS+I))) FOR I IN 0,2,NPOOL-2;
 0);

# DEMIT(A): THE UNIT WHOSE CODE IS THE CHAIN OF STACK ENTRY A #
SUBR DEMIT(A) IS (
 R,I,START ARE LOCAL;
 DINIT=0 => (DINIT_1;
             FRELOT(RTMP,'RTMP',300,0); FINCSET(RTMP,300);
             FRELOT(TAGS,'TAGS',20,0); FRELOT(USEDV,'USEDV',20,0); FRELOT(POOLS,'POOLS',20,0);
             FRELOT(FNAMES,'FNAMS',20,0); FRELOT(RLIST,'RLIST',100,0); FRELOT(RLIST2,'RLIS2',20,0); FRELOT(DDL,'DDL',20,0); FRELOT(DDW,'DDW',20,0));
 NRL_0; NTAGS_0; NUSED_0; NPOOL_0; NFN_0; NDDL_0; NDDW_0;
 CCALL IRRESET(0);
 R_HL(FREE(A+2));
 EM1: R NE 0 => (FADD(RLIST,NRL,R); R_RNEXT(R); GO TO EM1);
 NRL2_0;
 REMO NE 0 => (R_HL(FREE(REMO+2));                    # THE REMOTE CODE: THE ORIGINAL PUTS IT IN THE HIGH SEGMENT #
               EM3: R NE 0 => (FADD(RLIST2,NRL2,R); R_RNEXT(R); GO TO EM3);
               FREES(REMO+2,0));
 START_-1;
 (R_FREE(RLIST+I);
  RKIND(R)=KOP => ROP(R)=OENTRY => (START GE 0 => EFUNC(START,I,0) ELSE (I>0 => EFUNC(0,I,1));
                                    START_I)) FOR I IN 0,1,NRL-1;
 START GE 0 => EFUNC(START,NRL,0) ELSE (NRL>0 => EFUNC(0,NRL,1));
 EDATA(0);
 CCALL IRFLUSH(0);
 0) %%
