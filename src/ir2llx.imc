#THIS IS FILE IR2LLX, THE EXPRESSIONS AND STATEMENTS OF THE LLVM IR WRITER (SRC/IR2LL.IMC IS THE REST): THE CODE GENERATOR OF THIS COMPILER CAN NAME ONLY 2047 REGISTERS IN A COMPILATION (A FIELD OF 11 BITS, SEE
 AREG1 IN SRC/LLVM-IR/IMPSEM.IMC), SO THE WRITER IS IN TWO FILES.  WHAT THEY SHARE IS COMMON; THE DECLARATIONS ARE THE SAME IN BOTH.#

IRLIN,IRLOUTP,IRLP32,IRLSP,IRLCH,IRLTOP,IRLEND,IRLNVR,IRLNCM,IRLNDQ,IRLDLABEL,IRLDSTRING,IRLUSEJ,IRLNVAL,IRLTERM,IRLNDEAD,IRLNT,IRLMAXARG,IRLPOS,IRLV,IRLLEN ARE COMMON;
IRLBB,IRLBL,IRLBC ARE COMMON,6 LONG;
IRLSETV IS COMMON,32768 LONG;
IRLSETN IS COMMON,8 LONG;
IRLTT IS COMMON,8192 LONG;
IRLSTM IS COMMON,100000 LONG;
IRLLAB IS COMMON,100000 LONG;
IRLSTK IS COMMON,200000 LONG;
IRLDQ,IRLDS ARE COMMON,4096 LONG;
IRLVRS,IRLVRN,IRLVRZ ARE COMMON,4096 LONG;
IRLCMN,IRLCMZ,IRLCML ARE COMMON,4096 LONG;
IRLLINE IS COMMON,80 LONG;
IRLHDR IS COMMON,90 LONG;
IRLFNM IS COMMON,33 LONG;
IRLTOKB IS COMMON,70 LONG;
IRLSYMB IS COMMON,33 LONG;
IRLNMB IS COMMON,38 LONG;
IRLDG IS COMMON,24 LONG;
IRLZERO IS COMMON,2 LONG;
IRLSTP IS COMMON,260 LONG;

# V OF THE TYPE FRM AS THE TYPE TYT #
SUBR IRLCONV(V,FRM,TYT) IS (
 LF,LT2,R,F,T2,OPN,VV ARE LOCAL;
 VV:=V; F:=FRM; T2:=TYT;
 LF:=IRLLTYPE(F); LT2:=IRLLTYPE(T2);
 CCALL strcmp(LF,LT2)=0 => RETURN VV;
 R:=IRLNEWVAL(0);
 IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = '));
 ((F=12) AND (T2=13)) => (IRLPS(0,LOC('fpext float ')); IRLPS(0,VV); IRLPS(0,LOC(' to double')); IRLE(0); RETURN R);
 ((F=13) AND (T2=12)) => (IRLPS(0,LOC('fptrunc double ')); IRLPS(0,VV); IRLPS(0,LOC(' to float')); IRLE(0); RETURN R);
 F=13 => (OPN:=LOC('fptosi'); IRLISU(T2) NE 0 => OPN:=LOC('fptoui');
          IRLPS(0,OPN); IRLPC(0,32); IRLPS(0,LF); IRLPC(0,32); IRLPS(0,VV); IRLPS(0,LOC(' to ')); IRLPS(0,LT2); IRLE(0); RETURN R);
 T2=13 => (OPN:=LOC('sitofp'); IRLISU(F) NE 0 => OPN:=LOC('uitofp');
           IRLPS(0,OPN); IRLPC(0,32); IRLPS(0,LF); IRLPC(0,32); IRLPS(0,VV); IRLPS(0,LOC(' to double')); IRLE(0); RETURN R);
 IRLBITS(T2)>IRLBITS(F) => (OPN:=LOC('sext'); IRLISU(F) NE 0 => OPN:=LOC('zext');
                            IRLPS(0,OPN); IRLPC(0,32); IRLPS(0,LF); IRLPC(0,32); IRLPS(0,VV); IRLPS(0,LOC(' to ')); IRLPS(0,LT2); IRLE(0); RETURN R);
 IRLPS(0,LOC('trunc ')); IRLPS(0,LF); IRLPC(0,32); IRLPS(0,VV); IRLPS(0,LOC(' to ')); IRLPS(0,LT2); IRLE(0);
 R);

# AN ADDRESS CONSTANT: SYMBOL + OFFSET, AS AN I64 #
SUBR IRLSYMADDR(NAME,OFF) IS (
 P,Q,Z,NM,OF ARE LOCAL;
 NM:=NAME; OF:=OFF;
 P:=IRLNEWVAL(0); Q:=IRLNEWVAL(0);
 IRLI(0); IRLPS(0,P); IRLPS(0,LOC(' = getelementptr i8, ptr ')); IRLGN(0,NM); IRLPS(0,LOC(', i64 ')); IRLPN(0,OF); IRLE(0);
 IRLP32 NE 0 => (Z:=IRLNEWVAL(0);
                 IRLI(0); IRLPS(0,Q); IRLPS(0,LOC(' = ptrtoint ptr ')); IRLPS(0,P); IRLPS(0,LOC(' to i32')); IRLE(0);
                 IRLI(0); IRLPS(0,Z); IRLPS(0,LOC(' = zext i32 ')); IRLPS(0,Q); IRLPS(0,LOC(' to i64')); IRLE(0);
                 RETURN Z);
 IRLI(0); IRLPS(0,Q); IRLPS(0,LOC(' = ptrtoint ptr ')); IRLPS(0,P); IRLPS(0,LOC(' to i64')); IRLE(0);
 Q);

# THE ARGUMENT SLOT OF A REGISTER, OR -1 #
SUBR IRLARGSLOT(REG) IS (
 R ARE LOCAL;
 R:=REG;
 R=5 => RETURN 0;
 R=4 => RETURN 1;
 R=1 => RETURN 2;
 R=2 => RETURN 3;
 R=8 => RETURN 4;
 R=9 => RETURN 5;
 0-1);

# AN ARGUMENT SLOT ABOVE THE SIXTH: *(RBP + 16 + 8K); K + 6, ELSE -1 #
SUBR IRLSTACKP(NN) IS (
 N,P,Q ARE LOCAL;
 N:=NN;
 [N] NE 23 => RETURN 0-1;
 P:=[N+5];
 [P] NE 10 => RETURN 0-1;
 Q:=[P+5];
 [Q] NE 6 => RETURN 0-1;
 [Q+3] NE 6 => RETURN 0-1;
 Q:=[P+6];
 [Q] NE 4 => RETURN 0-1;
 ((([Q+2]-16)/8)+6));

# THE ARGUMENT K OF THE FUNCTION, AS AN I64 (AN ADDRESS: ZERO EXTENDED) #
SUBR IRLPARAM(KK) IS (
 K,R ARE LOCAL;
 K:=KK;
 K>IRLMAXARG => IRLMAXARG:=K;
 IRLP32=0 => RETURN IRLVN(97,K);
 R:=IRLNEWVAL(0);
 IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = zext i32 %a')); IRLPN(0,K); IRLPS(0,LOC(' to i64')); IRLE(0);
 R);

# A POINTER FOR THE ADDRESS (AN I64) #
SUBR IRLTOPTR(A) IS (
 P,AA ARE LOCAL;
 AA:=A;
 P:=IRLNEWVAL(0);
 IRLI(0); IRLPS(0,P); IRLPS(0,LOC(' = inttoptr i64 ')); IRLPS(0,AA); IRLPS(0,LOC(' to ptr')); IRLE(0);
 P);

# THE VALUE OF A CONSTANT NODE #
SUBR IRLXICON(NN) IS (
 N,T,NM ARE LOCAL;
 N:=NN; T:=[N+1]; NM:=[N+4];
 NM NE 0 => ((CCALL strchr(NM,64)) NE 0 => IRLTHUNK(NM) ELSE (IRLINSET(0,NM)=0 => IRLADD(1,NM));
             RETURN IRLCONV(IRLSYMADDR(NM,[N+2]),8,T));
 IRLRST(3);
 T=13 => (IRLPN(3,[N+2]); IRLPS(3,LOC('.0')); RETURN IRLSVE(0));
 T=6 => (IRLPN(3,IRLSX32([N+2])); RETURN IRLSVE(0));
 T=3 => (IRLPN(3,[N+2] AND 255); RETURN IRLSVE(0));
 IRLPN(3,[N+2]);
 IRLSVE(0));

# ---- THE EXPRESSIONS ---- #
# THE POINTER TO THE PLACE A NAME, TEMP OR UMUL NODE NAMES #
SUBR IRLPLACE(NN) IS (
 N,OP,P,A ARE LOCAL;
 N:=NN; OP:=[N];
 OP=2 => (IRLADD(1,[N+4]);
          P:=IRLNEWVAL(0);
          IRLI(0); IRLPS(0,P); IRLPS(0,LOC(' = getelementptr i8, ptr ')); IRLGN(0,[N+4]); IRLPS(0,LOC(', i64 ')); IRLPN(0,[N+2]); IRLE(0);
          RETURN P);
 OP=8 => RETURN IRLVN(116,[N+3]);
 OP=23 => (A:=IRLEXPR([N+5]);
           RETURN IRLTOPTR(A));
 IRLDIE(LOC('not an lvalue'),LOC(IRLZERO));
 0);

# THE VALUE OF A NAME, TEMP OR UMUL NODE: A LOAD #
SUBR IRLLOAD(NN) IS (
 N,P,R,T,TT ARE LOCAL;
 N:=NN;
 IRLPUSH(N);
 P:=IRLPLACE(N);
 N:=IRLPOP(0);
 R:=IRLNEWVAL(0); T:=[N+1];
 [N]=8 => (TT:=[N+3]-100; TT:=IRLTT[TT];
           IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = load'));
           IRLUSEJ NE 0 => IRLPS(0,LOC(' volatile'));
           IRLPC(0,32); IRLPS(0,IRLLTYPE(TT)); IRLPS(0,LOC(', ptr ')); IRLPS(0,P); IRLPS(0,LOC(', align ')); IRLPS(0,IRLLALIGN(TT)); IRLE(0);
           RETURN IRLCONV(R,TT,T));
 IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = load ')); IRLPS(0,IRLLTYPE(T)); IRLPS(0,LOC(', ptr ')); IRLPS(0,P); IRLPS(0,LOC(', align ')); IRLPS(0,IRLLALIGN(T)); IRLE(0);
 R);

# STORE THE VALUE V OF THE TYPE VT IN THE PLACE D NAMES #
SUBR IRLSTORE(DD,VV,VVT) IS (
 D,V,VT,P,TT,DT ARE LOCAL;
 D:=DD; V:=VV; VT:=VVT;
 IRLPUSH(D); IRLPUSH(V); IRLPUSH(VT);
 P:=IRLPLACE(D);
 VT:=IRLPOP(0); V:=IRLPOP(0); D:=IRLPOP(0);
 [D]=8 => (TT:=[D+3]-100; TT:=IRLTT[TT]; DT:=[D+1];
           V:=IRLCONV(IRLCONV(V,VT,DT),DT,TT);
           IRLI(0); IRLPS(0,LOC('store'));
           IRLUSEJ NE 0 => IRLPS(0,LOC(' volatile'));
           IRLPC(0,32); IRLPS(0,IRLLTYPE(TT)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(', ptr ')); IRLPS(0,P); IRLPS(0,LOC(', align ')); IRLPS(0,IRLLALIGN(TT)); IRLE(0);
           RETURN 0);
 DT:=[D+1];
 V:=IRLCONV(V,VT,DT);
 IRLI(0); IRLPS(0,LOC('store ')); IRLPS(0,IRLLTYPE(DT)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(', ptr ')); IRLPS(0,P); IRLPS(0,LOC(', align ')); IRLPS(0,IRLLALIGN(DT)); IRLE(0);
 0);

# THE VALUE OF THE EXPRESSION NN AS THE TYPE TT: CONV(EXPR(N), N->TYPE, TT) #
SUBR IRLEXC(NN,TT) IS (
 N,TY,V,T2 ARE LOCAL;
 N:=NN; TY:=[N+1]; T2:=TT;
 IRLPUSH(TY); IRLPUSH(T2);
 V:=IRLEXPR(N);
 T2:=IRLPOP(0); TY:=IRLPOP(0);
 IRLCONV(V,TY,T2));

# A COMPARISON: AN I1 #
SUBR IRLCOMPARE(NN) IS (
 N,LTY,CT,OP,L,R,C,X ARE LOCAL;
 N:=NN; OP:=[N]; X:=[N+5]; LTY:=[X+1];
 OP GE 31 => (IRLPUSH(N);
              L:=IRLEXC([N+5],9);
              N:=IRLPOP(0);
              IRLPUSH(N); IRLPUSH(L);
              R:=IRLEXC([N+6],9);
              L:=IRLPOP(0); N:=IRLPOP(0);
              OP:=[N];
              C:=IRLNEWVAL(0);
              IRLI(0); IRLPS(0,C); IRLPS(0,LOC(' = icmp '));
              OP=31 => IRLPS(0,LOC('ule'));
              OP=32 => IRLPS(0,LOC('ult'));
              OP=33 => IRLPS(0,LOC('uge'));
              OP=34 => IRLPS(0,LOC('ugt'));
              IRLPS(0,LOC(' i64 ')); IRLPS(0,L); IRLPS(0,LOC(', ')); IRLPS(0,R); IRLE(0);
              RETURN C);
 CT:=8;
 LTY=6 => CT:=6;
 IRLISU(LTY) NE 0 => CT:=9;
 LTY=13 => CT:=13;
 IRLPUSH(N); IRLPUSH(CT);
 L:=IRLEXC([N+5],CT);
 CT:=IRLPOP(0); N:=IRLPOP(0);
 IRLPUSH(N); IRLPUSH(CT); IRLPUSH(L);
 R:=IRLEXC([N+6],CT);
 L:=IRLPOP(0); CT:=IRLPOP(0); N:=IRLPOP(0);
 OP:=[N];
 C:=IRLNEWVAL(0);
 IRLI(0); IRLPS(0,C);
 CT=13 => (IRLPS(0,LOC(' = fcmp '));
           OP=25 => IRLPS(0,LOC('oeq'));
           OP=26 => IRLPS(0,LOC('une'));
           OP=27 => IRLPS(0,LOC('ole'));
           OP=28 => IRLPS(0,LOC('olt'));
           OP=29 => IRLPS(0,LOC('oge'));
           OP=30 => IRLPS(0,LOC('ogt'));
           IRLPS(0,LOC(' double ')); IRLPS(0,L); IRLPS(0,LOC(', ')); IRLPS(0,R); IRLE(0);
           RETURN C);
 IRLPS(0,LOC(' = icmp '));
 OP=25 => IRLPS(0,LOC('eq'));
 OP=26 => IRLPS(0,LOC('ne'));
 IRLISU(CT) NE 0 => (OP=27 => IRLPS(0,LOC('ule'));
                     OP=28 => IRLPS(0,LOC('ult'));
                     OP=29 => IRLPS(0,LOC('uge'));
                     OP=30 => IRLPS(0,LOC('ugt')))
   ELSE (OP=27 => IRLPS(0,LOC('sle'));
         OP=28 => IRLPS(0,LOC('slt'));
         OP=29 => IRLPS(0,LOC('sge'));
         OP=30 => IRLPS(0,LOC('sgt')));
 IRLPC(0,32); IRLPS(0,IRLLTYPE(CT)); IRLPC(0,32); IRLPS(0,L); IRLPS(0,LOC(', ')); IRLPS(0,R); IRLE(0);
 C);

# THE TYPES OF THE FIXED PARAMETERS OF A CALL, "(I64, I64" AND THE REST: ", ...)" IF DOTS, ELSE ")" #
SUBR IRLFT(NN,DOTS) IS (
 J,N,DT ARE LOCAL;
 N:=NN; DT:=DOTS;
 IRLPC(0,40);
 J:=0;
 FT1: J<N => (J>0 => IRLPS(0,LOC(', ')); IRLPS(0,IRLIPT(0)); J:=J+1; GO TO FT1);
 DT NE 0 => IRLPS(0,LOC(', ...)')) ELSE IRLPC(0,41);
 0);

# ---- THE CALLS OF DECLARED C FUNCTIONS (TYPEDCALL IN TOOLS/IR2LL.C).  THE CODE GENERATOR NAMES SUCH A FUNCTION NAME@SIG IN THE CALL: SIG IS THE LETTER OF THE TYPE OF THE RESULT (c C s S i I l L q Q z p d f v:
  CHAR UCHAR SHORT USHORT INT UINT LONG ULONG LLONG ULLONG SIZE PTR DOUBLE FLOAT VOID), THEN THE LETTERS OF THE ARGUMENTS, WITH A DOT BEFORE THOSE OF A VARIADIC CALL THAT HAVE NO PARAMETER.  THE ARGUMENTS ARE
  WORDS (POINTER SIZED); A DOUBLE, A FLOAT AND A LONG LONG ARE THE ADDRESS OF A WORD OF 64 BITS ---- #

# THE LLVM TYPE OF THE C TYPE WITH THE LETTER C #
SUBR IRLTYTEXT(CC) IS (
 K ARE LOCAL;
 K:=CC;
 ((K=99) OR (K=67)) => RETURN LOC('i8');
 ((K=115) OR (K=83)) => RETURN LOC('i16');
 ((K=105) OR (K=73)) => RETURN LOC('i32');
 ((K=108) OR (K=76) OR (K=122)) => RETURN IRLIPT(0);
 ((K=113) OR (K=81)) => RETURN LOC('i64');
 K=112 => RETURN LOC('ptr');
 K=100 => RETURN LOC('double');
 K=102 => RETURN LOC('float');
 K=118 => RETURN LOC('void');
 IRLDIE(LOC('unknown C type in a call'),LOC(IRLZERO));
 LOC('i64'));

# THE ATTRIBUTE OF A PARAMETER OF THE C TYPE WITH THE LETTER C #
SUBR IRLTYATTR(CC) IS (
 K ARE LOCAL;
 K:=CC;
 ((K=99) OR (K=115) OR (K=105)) => RETURN LOC(' signext');
 ((K=67) OR (K=83) OR (K=73)) => RETURN LOC(' zeroext');
 LOC(IRLZERO));

# THE LINE OF THE DECLARATION OF THE TYPED FUNCTION NM (SET 6 HOLDS THE NAME, A NEW LINE AND THE LINE), OR 0 #
SUBR IRLTFIND(NN) IS (
 I,L,NM ARE LOCAL;
 NM:=NN;
 L:=CCALL strlen(NM);
 I:=0;
 TF1: I<IRLSETN[6] => (CCALL strncmp(IRLSETV[(6*4096)+I],NM,L)=0 => IRLGETB(IRLSETV[(6*4096)+I],L)=10 => RETURN IRLSETV[(6*4096)+I]+L+1;
                       I:=I+1; GO TO TF1);
 0);

# THE VALUE %CK (CH THE LETTER OF THE KIND, K THE NUMBER) ONTO THE BUFFER 2 #
SUBR IRLTN(CH,K) IS (
 IRLPC(2,37); IRLPC(2,CH); IRLPN(2,K);
 0);

# A LINE OF THE ENTRY OF A CALLBACK, %DK = OP TYPE %SK TAIL, WITH D AND S THE LETTERS OF THE KINDS #
SUBR IRLTL(DST,OP,TY,SRC,K,TAIL) IS (
 D,S,O,Y,KK,Z ARE LOCAL;
 D:=DST; O:=OP; Y:=TY; S:=SRC; KK:=K; Z:=TAIL;
 IRLPS(2,LOC('  ')); IRLTN(D,KK); IRLPS(2,LOC(' = ')); IRLPS(2,O); IRLPC(2,32); IRLPS(2,Y); IRLPC(2,32); IRLTN(S,KK); IRLPS(2,Z); IRLPC(2,10);
 0);

# CALLBACK(NAME): THE SYMBOL NAME@SIG THAT THE CODE GENERATOR USES FOR THE ADDRESS OF THE C ENTRY OF THE SUBR NAME (SIG: THE LETTER OF THE TYPE OF THE RESULT, THEN ONE FOR EACH PARAMETER, AS IN A TYPED CALL).  AT ITS FIRST USE THE MODULE
  DEFINES IT AS AN INTERNAL FUNCTION WITH THE C TYPES OF SIG: EACH PARAMETER IS CONVERTED TO A WORD, STORED IN A WORD OF ITS OWN, AND THE SUBR NAME IS CALLED WITH THE ADDRESSES OF THE WORDS (THE IMP CONVENTION: REFERENCES,
  A WORD AS THE RESULT); THE WORD IT RETURNS IS CONVERTED TO THE C TYPE OF THE RESULT.  THE TEXT GOES ONTO THE BUFFER OF THE FUNCTIONS (IN FRONT OF THE FUNCTION BEING WRITTEN), AS IN TOOLS/IR2LL.C (THUNKDEF) #
SUBR IRLTHUNK(NM0) IS (
 NM,B,SG,RS,NP,K,C ARE LOCAL;
 NM:=NM0;
 IRLINSET(7,NM) NE 0 => RETURN 0;
 IRLADD(7,NM);
 B:=CCALL strdup(NM);
 SG:=CCALL strchr(B,64);
 IRLPUTB(SG,0,0); SG:=SG+1;
 IRLADD(0,B);
 RS:=IRLGETB(SG,0);
 NP:=CCALL strlen(SG)-1;
 IRLPS(2,LOC('define internal')); IRLPS(2,IRLTYATTR(RS)); IRLPC(2,32); IRLPS(2,IRLTYTEXT(RS)); IRLPC(2,32); IRLGN(2,NM); IRLPC(2,40);
 K:=0;
 TH1: K<NP => (C:=IRLGETB(SG,K+1); K>0 => IRLPS(2,LOC(', ')); IRLPS(2,IRLTYTEXT(C)); IRLPS(2,IRLTYATTR(C)); IRLPS(2,LOC(' %p')); IRLPN(2,K); K:=K+1; GO TO TH1);
 IRLPS(2,LOC(') {')); IRLPC(2,10); IRLPS(2,LOC('entry:')); IRLPC(2,10);
 K:=0;
 TH2: K GE NP => GO TO TH9;
 C:=IRLGETB(SG,K+1);
 IRLPS(2,LOC('  ')); IRLTN(119,K); IRLPS(2,LOC(' = alloca i64, align 8')); IRLPC(2,10);
 ((C=99) OR (C=115) OR (C=105)) => (IRLTL(99,LOC('sext'),IRLTYTEXT(C),112,K,LOC(' to i64')); GO TO TH3);
 ((C=67) OR (C=83) OR (C=73)) => (IRLTL(99,LOC('zext'),IRLTYTEXT(C),112,K,LOC(' to i64')); GO TO TH3);
 C=108 => IRLP32 NE 0 => (IRLTL(99,LOC('sext'),LOC('i32'),112,K,LOC(' to i64')); GO TO TH3);
 ((C=76) OR (C=122)) => IRLP32 NE 0 => (IRLTL(99,LOC('zext'),LOC('i32'),112,K,LOC(' to i64')); GO TO TH3);
 C=112 => (IRLPS(2,LOC('  ')); IRLTN(117,K); IRLPS(2,LOC(' = ptrtoint ptr ')); IRLTN(112,K); IRLPS(2,LOC(' to ')); IRLPS(2,IRLIPT(0)); IRLPC(2,10);
           IRLP32 NE 0 => (IRLTL(99,LOC('zext'),LOC('i32'),117,K,LOC(' to i64')); GO TO TH3);
           IRLTL(99,LOC('add'),LOC('i64'),117,K,LOC(', 0')); GO TO TH3);
 C=100 => (IRLTL(99,LOC('bitcast'),LOC('double'),112,K,LOC(' to i64')); GO TO TH3);
 C=102 => (IRLTL(117,LOC('fpext'),LOC('float'),112,K,LOC(' to double'));
           IRLTL(99,LOC('bitcast'),LOC('double'),117,K,LOC(' to i64')); GO TO TH3);
 IRLTL(99,LOC('add'),LOC('i64'),112,K,LOC(', 0'));
 TH3: IRLPS(2,LOC('  store i64 ')); IRLTN(99,K); IRLPS(2,LOC(', ptr ')); IRLTN(119,K); IRLPS(2,LOC(', align 8')); IRLPC(2,10);
 IRLPS(2,LOC('  ')); IRLTN(97,K); IRLPS(2,LOC(' = ptrtoint ptr ')); IRLTN(119,K); IRLPS(2,LOC(' to ')); IRLPS(2,IRLIPT(0)); IRLPC(2,10);
 K:=K+1; GO TO TH2;
 TH9: IRLPS(2,LOC('  %r = call i64 ')); IRLPC(2,40);
 K:=0;
 TH4: K<NP => (K>0 => IRLPS(2,LOC(', ')); IRLPS(2,IRLIPT(0)); K:=K+1; GO TO TH4);
 IRLPS(2,LOC(') ')); IRLGN(2,B); IRLPC(2,40);
 K:=0;
 TH5: K<NP => (K>0 => IRLPS(2,LOC(', ')); IRLPS(2,IRLIPT(0)); IRLPC(2,32); IRLTN(97,K); K:=K+1; GO TO TH5);
 IRLPC(2,41); IRLPC(2,10);
 RS=118 => (IRLPS(2,LOC('  ret void')); IRLPC(2,10); GO TO TH8);
 ((RS=99) OR (RS=115) OR (RS=105) OR (RS=67) OR (RS=83) OR (RS=73)) => (
     IRLPS(2,LOC('  %x = trunc i64 %r to ')); IRLPS(2,IRLTYTEXT(RS)); IRLPC(2,10);
     IRLPS(2,LOC('  ret ')); IRLPS(2,IRLTYTEXT(RS)); IRLPS(2,LOC(' %x')); IRLPC(2,10); GO TO TH8);
 ((RS=108) OR (RS=76) OR (RS=122)) => (
     IRLP32 NE 0 => (IRLPS(2,LOC('  %x = trunc i64 %r to i32')); IRLPC(2,10); IRLPS(2,LOC('  ret i32 %x')); IRLPC(2,10); GO TO TH8);
     IRLPS(2,LOC('  ret i64 %r')); IRLPC(2,10); GO TO TH8);
 RS=112 => (IRLP32 NE 0 => (IRLPS(2,LOC('  %t = trunc i64 %r to i32')); IRLPC(2,10); IRLPS(2,LOC('  %x = inttoptr i32 %t to ptr')); IRLPC(2,10))
              ELSE (IRLPS(2,LOC('  %x = inttoptr i64 %r to ptr')); IRLPC(2,10));
            IRLPS(2,LOC('  ret ptr %x')); IRLPC(2,10); GO TO TH8);
 RS=100 => (IRLPS(2,LOC('  %x = bitcast i64 %r to double')); IRLPC(2,10); IRLPS(2,LOC('  ret double %x')); IRLPC(2,10); GO TO TH8);
 RS=102 => (IRLPS(2,LOC('  %t = bitcast i64 %r to double')); IRLPC(2,10); IRLPS(2,LOC('  %x = fptrunc double %t to float')); IRLPC(2,10);
            IRLPS(2,LOC('  ret float %x')); IRLPC(2,10); GO TO TH8);
 IRLPS(2,LOC('  ret i64 %r')); IRLPC(2,10);
 TH8: IRLPC(2,125); IRLPC(2,10); IRLPC(2,10);
 CCALL free(B);
 0);

# THE VALUE OF THE ARGUMENT WITH THE C TYPE OF THE LETTER C, FROM V: A POINTER SIZED INTEGER #
SUBR IRLTARG(CC,VV) IS (
 C,V,T,P,U ARE LOCAL;
 C:=CC; V:=VV;
 ((C=99) OR (C=67)) => (T:=IRLNEWVAL(0);
                        IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = trunc ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(' to i8')); IRLE(0);
                        RETURN T);
 ((C=115) OR (C=83)) => (T:=IRLNEWVAL(0);
                         IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = trunc ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(' to i16')); IRLE(0);
                         RETURN T);
 ((C=105) OR (C=73)) => (IRLP32 NE 0 => RETURN V;
                         T:=IRLNEWVAL(0);
                         IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = trunc i64 ')); IRLPS(0,V); IRLPS(0,LOC(' to i32')); IRLE(0);
                         RETURN T);
 C=112 => (T:=IRLNEWVAL(0);
           IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = inttoptr ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(' to ptr')); IRLE(0);
           RETURN T);
 ((C=113) OR (C=81) OR (C=100) OR (C=102)) => (
     P:=IRLNEWVAL(0);
     IRLI(0); IRLPS(0,P); IRLPS(0,LOC(' = inttoptr ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,V); IRLPS(0,LOC(' to ptr')); IRLE(0);
     T:=IRLNEWVAL(0);
     IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = load '));
     ((C=100) OR (C=102)) => IRLPS(0,LOC('double')) ELSE IRLPS(0,LOC('i64'));
     IRLPS(0,LOC(', ptr ')); IRLPS(0,P); IRLPS(0,LOC(', align 8')); IRLE(0);
     C=102 => (U:=IRLNEWVAL(0);
               IRLI(0); IRLPS(0,U); IRLPS(0,LOC(' = fptrunc double ')); IRLPS(0,T); IRLPS(0,LOC(' to float')); IRLE(0);
               RETURN U);
     RETURN T);
 V);

# A TYPED CALL OF THE FUNCTION NM WITH THE SIGNATURE SG: THE ARGUMENTS ARE THE N VALUES AT IRLSTK[A+128]; THE VALUE IS AN I64 #
SUBR IRLTCALL(NM0,SG0,A0,N0) IS (
 NM,SG,A,N,RS,K,NF,J,C,T,R,U,Z,FT,TG ARE LOCAL;
 NM:=NM0; SG:=SG0; A:=A0; N:=N0;
 TG:=0;
 CCALL strcmp(NM,LOC('impcallt'))=0 => (                      # A CALL THROUGH A POINTER (FNPTR): THE SIGNATURE HAS A P, THE FUNCTION, AFTER THE LETTER OF THE RESULT #
     N<1 => IRLDIE(LOC('call through a pointer without the pointer'),NM);
     IRLGETB(SG,1) NE 112 => IRLDIE(LOC('call through a pointer without the pointer'),NM);
     TG:=IRLTARG(112,IRLSTK[A+128]);
     CCALL memmove(SG+1,SG+2,CCALL strlen(SG+2)+1);
     K:=0;
     TI1: K<(N-1) => (IRLSTK[(A+128)+K]:=IRLSTK[(A+129)+K]; K:=K+1; GO TO TI1);
     N:=N-1);
 RS:=IRLGETB(SG,0);
 K:=0; NF:=0-1; J:=1;
 TC1: C:=IRLGETB(SG,J);
 C=0 => GO TO TC2;
 C=46 => (NF:=K; J:=J+1; GO TO TC1);
 K GE N => IRLDIE(LOC('call with fewer arguments than its signature'),NM);
 K:=K+1; J:=J+1; GO TO TC1;
 TC2: K NE N => IRLDIE(LOC('call with more arguments than its signature'),NM);
 TG=0 => IRLTFIND(NM)=0 => IRLSETN[6]<4096 => (
     IRLRST(3);
     IRLPS(3,NM); IRLPC(3,10); IRLPS(3,LOC('declare ')); IRLPS(3,IRLTYTEXT(RS)); IRLPC(3,32); IRLGN(3,NM); IRLPC(3,40);
     K:=0; J:=1;
     TC3: C:=IRLGETB(SG,J);
     C=0 => GO TO TC4;
     C=46 => (J:=J+1; GO TO TC3);
     (NF<0) OR (K<NF) => (K>0 => IRLPS(3,LOC(', ')); IRLPS(3,IRLTYTEXT(C)); IRLPS(3,IRLTYATTR(C)));
     K:=K+1; J:=J+1; GO TO TC3;
     TC4: NF GE 0 => (NF>0 => IRLPS(3,LOC(', ...')) ELSE IRLPS(3,LOC('...')));
     IRLPC(3,41);
     IRLADD(6,IRLBB[3]));
 K:=0; J:=1;
 TC5: C:=IRLGETB(SG,J);
 C=0 => GO TO TC6;
 C=46 => (J:=J+1; GO TO TC5);
 IRLSTK[(A+128)+K]:=IRLTARG(C,IRLSTK[(A+128)+K]);
 K:=K+1; J:=J+1; GO TO TC5;
 TC6: RS=118 => GO TO TC6V;
 R:=IRLNEWVAL(0); IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = call ')); IRLPS(0,IRLTYTEXT(RS)); IRLPC(0,32);
 GO TO TC6W;
 TC6V: IRLI(0); IRLPS(0,LOC('call void '));
 TC6W: NF GE 0 => (IRLPC(0,40);
 K:=0; J:=1;
             TC7: K<NF => (C:=IRLGETB(SG,J); K>0 => IRLPS(0,LOC(', ')); IRLPS(0,IRLTYTEXT(C)); K:=K+1; J:=J+1; GO TO TC7);
             NF>0 => IRLPS(0,LOC(', ...')) ELSE IRLPS(0,LOC('...'));
             IRLPC(0,41); IRLPC(0,32));
 TG NE 0 => IRLPS(0,TG) ELSE IRLGN(0,NM);
 IRLPC(0,40);
 K:=0; J:=1;
 TC8: C:=IRLGETB(SG,J);
 C=0 => GO TO TC9;
 C=46 => (J:=J+1; GO TO TC8);
 K>0 => IRLPS(0,LOC(', '));
 IRLPS(0,IRLTYTEXT(C));
 (NF<0) OR (K<NF) => IRLPS(0,IRLTYATTR(C));
 IRLPC(0,32); IRLPS(0,IRLSTK[(A+128)+K]);
 K:=K+1; J:=J+1; GO TO TC8;
 TC9: IRLPC(0,41); IRLE(0);
 RS=118 => RETURN LOC('0');
 ((RS=99) OR (RS=115) OR (RS=105)) => (T:=IRLNEWVAL(0);
     IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = sext ')); IRLPS(0,IRLTYTEXT(RS)); IRLPC(0,32); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
     RETURN T);
 ((RS=67) OR (RS=83) OR (RS=73)) => (T:=IRLNEWVAL(0);
     IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = zext ')); IRLPS(0,IRLTYTEXT(RS)); IRLPC(0,32); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
     RETURN T);
 RS=108 => (IRLP32 NE 0 => (T:=IRLNEWVAL(0);
                            IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = sext i32 ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
                            RETURN T);
            RETURN R);
 ((RS=76) OR (RS=122)) => (IRLP32 NE 0 => (T:=IRLNEWVAL(0);
                                            IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = zext i32 ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
                                            RETURN T);
                           RETURN R);
 RS=112 => (U:=IRLNEWVAL(0);
            IRLI(0); IRLPS(0,U); IRLPS(0,LOC(' = ptrtoint ptr ')); IRLPS(0,R); IRLPS(0,LOC(' to ')); IRLPS(0,IRLIPT(0)); IRLE(0);
            IRLP32 NE 0 => (T:=IRLNEWVAL(0);
                            IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = zext i32 ')); IRLPS(0,U); IRLPS(0,LOC(' to i64')); IRLE(0);
                            RETURN T);
            RETURN U);
 RS=100 => (T:=IRLNEWVAL(0);
            IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = bitcast double ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
            RETURN T);
 RS=102 => (U:=IRLNEWVAL(0);
            IRLI(0); IRLPS(0,U); IRLPS(0,LOC(' = fpext float ')); IRLPS(0,R); IRLPS(0,LOC(' to double')); IRLE(0);
            T:=IRLNEWVAL(0);
            IRLI(0); IRLPS(0,T); IRLPS(0,LOC(' = bitcast double ')); IRLPS(0,U); IRLPS(0,LOC(' to i64')); IRLE(0);
            RETURN T);
 R);

# A CALL: THE VALUE IS AN I64.  THE FRAME ON THE STACK HAS THE ARGUMENT NODES (0..63), THE LIST OF THEM (64..127) AND THEIR VALUES (128..191) #
SUBR IRLCALLEXPR(NN) IS (
 N,FN,A,C,K,NL,TOP,SL,D,X,NARGS,V,NM,R,Z,NF,CF,P,Q,Y,IND,F,SG ARE LOCAL;
 N:=NN; FN:=[N+5];
 [FN]=4 => ([FN+4] NE 0 => GO TO CE1);
 IRLDIE(LOC('call of a computed function'),LOC(IRLZERO));
 CE1: NM:=[FN+4];
 SG:=CCALL strchr(NM,64);                       # A DECLARED C FUNCTION: NAME@SIGNATURE #
 SG NE 0 => (IRLPUTB(SG,0,0); SG:=SG+1);
 # A CALL THROUGH AN ADDRESS: CCALL impcallp(F,A,...) (THE RESULT A C LONG) OR IMPCALLW(F,A,...) (THE RESULT AN IMP WORD, 64 BITS) CALLS THE FUNCTION AT F WITH THE ARGUMENTS A,... BY VALUE #
 IND:=0;
 CCALL strcmp(NM,LOC('impcallp'))=0 => IND:=1;
 CCALL strcmp(NM,LOC('impcallw'))=0 => IND:=2;
 CCALL strcmp(NM,LOC('impcallt'))=0 => IND:=3;
 IND=0 => IRLADD(0,NM);
 CCALL strcmp(NM,LOC('_setjmp'))=0 => IRLUSEJ:=1;
 CCALL strcmp(NM,LOC('setjmp'))=0 => IRLUSEJ:=1;
 A:=IRLSP; IRLSP:=IRLSP+192;
 IRLSP GE 199000 => IRLDIE(LOC('tree too deep'),LOC(IRLZERO));
 Q:=LOC(IRLSTK); Q:=Q+(8*A);
 CCALL memset(Q,0,1536);
 TOP:=0-1; NL:=0;
 [N]=41 => (C:=[N+6];
            CE2: [C]=48 => (X:=[C+6]; IRLSTK[(A+64)+NL]:=X; NL:=NL+1; C:=[C+5]; GO TO CE2);
            IRLSTK[(A+64)+NL]:=C; NL:=NL+1;
            K:=NL-1;
            CE3: K<0 => GO TO CE5;
            X:=IRLSTK[(A+64)+K];
            [X] NE 49 => IRLDIE(LOC('argument is not an assignment'),NM);
            D:=[X+5];
            [D]=6 => ([D+3]=0 => GO TO CE4;
                      SL:=IRLARGSLOT([D+3]);
                      SL<0 => IRLDIE(LOC('argument register'),NM);
                      GO TO CE6);
            [D]=23 => (P:=[D+5];
                       [P]=10 => (Q:=[P+5];
                                  [Q]=6 => ([Q+3]=7 => (Y:=[P+6]; SL:=6+([Y+2]/8); GO TO CE6))));
            IRLDIE(LOC('argument destination'),NM);
            CE6: IRLSTK[A+SL]:=[X+6];
            SL>TOP => TOP:=SL;
            CE4: K:=K-1; GO TO CE3;
            CE5: 0);
 NARGS:=TOP+1;
 K:=0;
 CE7: K<NARGS => (X:=IRLSTK[A+K];
                  X=0 => IRLDIE(LOC('missing argument'),NM);
                  IRLPUSH(A); IRLPUSH(K); IRLPUSH(NARGS); IRLPUSH(NM); IRLPUSH(SG);
                  V:=IRLEXC(X,8);
                  SG:=IRLPOP(0); NM:=IRLPOP(0); NARGS:=IRLPOP(0); K:=IRLPOP(0); A:=IRLPOP(0);
                  IRLP32 NE 0 => (Z:=IRLNEWVAL(0);
                                  IRLI(0); IRLPS(0,Z); IRLPS(0,LOC(' = trunc i64 ')); IRLPS(0,V); IRLPS(0,LOC(' to i32')); IRLE(0);
                                  V:=Z);
                  IRLSTK[(A+128)+K]:=V;
                  K:=K+1; GO TO CE7);
 SG NE 0 => (R:=IRLTCALL(NM,SG,A,NARGS); IRLSP:=A; RETURN R);
 IND NE 0 => (NARGS<1 => IRLDIE(LOC('call through an address without the address'),NM);
              F:=IRLNEWVAL(0);
              IRLI(0); IRLPS(0,F); IRLPS(0,LOC(' = inttoptr ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,IRLSTK[A+128]); IRLPS(0,LOC(' to ptr')); IRLE(0);
              R:=IRLNEWVAL(0);
              IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = call '));
              IND=2 => IRLPS(0,LOC('i64')) ELSE IRLPS(0,IRLIPT(0));
              IRLPC(0,32); IRLFT(NARGS-1,0); IRLPC(0,32); IRLPS(0,F); IRLPC(0,40);
              K:=1;
              CEA: K<NARGS => (K>1 => IRLPS(0,LOC(', ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,IRLSTK[(A+128)+K]); K:=K+1; GO TO CEA);
              IRLPC(0,41); IRLE(0);
              IND=1 => (IRLP32 NE 0 => (Z:=IRLNEWVAL(0);
                                          IRLI(0); IRLPS(0,Z); IRLPS(0,LOC(' = sext i32 ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
                                          IRLSP:=A;
                                          RETURN Z));
              IRLSP:=A;
              RETURN R);
 CF:=IRLISC(NM);
 NF:=IRLVARF(NM);
 R:=IRLNEWVAL(0);
 NF>0 => (IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = call i32 ')); IRLFT(NF,1); IRLPC(0,32); IRLGN(0,NM); IRLPC(0,40);
          K:=0;
          CE8: K<NARGS => (K>0 => IRLPS(0,LOC(', ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,IRLSTK[(A+128)+K]); K:=K+1; GO TO CE8);
          IRLPC(0,41); IRLE(0);
          Z:=IRLNEWVAL(0);
          IRLI(0); IRLPS(0,Z); IRLPS(0,LOC(' = sext i32 ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
          IRLSP:=A;
          RETURN Z);
 CF NE 0 => (Z:=IRLNEWVAL(0);
             IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = call ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLFT(NARGS,0); IRLPC(0,32); IRLGN(0,NM); IRLPC(0,40);
             K:=0;
             CE9: K<NARGS => (K>0 => IRLPS(0,LOC(', ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,IRLSTK[(A+128)+K]); K:=K+1; GO TO CE9);
             IRLPC(0,41);
             ((CCALL strcmp(NM,LOC('_setjmp'))=0) OR (CCALL strcmp(NM,LOC('setjmp'))=0)) => IRLPS(0,LOC(' returns_twice'));
             IRLE(0);
             IRLP32 NE 0 => (IRLI(0); IRLPS(0,Z); IRLPS(0,LOC(' = sext i32 ')); IRLPS(0,R); IRLPS(0,LOC(' to i64')); IRLE(0);
                             IRLSP:=A;
                             RETURN Z);
             IRLSP:=A;
             RETURN R);
 IRLI(0); IRLPS(0,R); IRLPS(0,LOC(' = call i64 ')); IRLFT(NARGS,0); IRLPC(0,32); IRLGN(0,NM); IRLPC(0,40);
 K:=0;
 CE10: K<NARGS => (K>0 => IRLPS(0,LOC(', ')); IRLPS(0,IRLIPT(0)); IRLPC(0,32); IRLPS(0,IRLSTK[(A+128)+K]); K:=K+1; GO TO CE10);
 IRLPC(0,41); IRLE(0);
 IRLSP:=A;
 R);

# THE VALUE OF AN EXPRESSION, AS ITS OWN TYPE #
SUBR IRLEXPR(NN) IS (
 N,T,L,R,V,OP,S,C,OPN,LT3 ARE LOCAL;
 N:=NN; T:=[N+1]; OP:=[N];
 OP=4 => RETURN IRLXICON(N);
 OP=2 => RETURN IRLLOAD(N);
 OP=8 => RETURN IRLLOAD(N);
 OP=6 => (S:=IRLARGSLOT([N+3]);
          S<0 => IRLDIE(LOC('register not translated'),LOC(IRLZERO));
          RETURN IRLCONV(IRLPARAM(S),8,T));
 OP=23 => (S:=IRLSTACKP(N);
           S GE 0 => RETURN IRLCONV(IRLPARAM(S),8,T);
           RETURN IRLLOAD(N));
 ((OP=41) OR (OP=42)) => (IRLPUSH(T);
                        V:=IRLCALLEXPR(N);
                        T:=IRLPOP(0);
                        RETURN IRLCONV(V,8,T));
 ((OP=37) OR (OP=38)) => RETURN IRLEXC([N+5],T);
 OP=24 => (IRLPUSH(T);
           L:=IRLEXC([N+5],T);
           T:=IRLPOP(0);
           V:=IRLNEWVAL(0);
           IRLI(0); IRLPS(0,V);
           T=13 => (IRLPS(0,LOC(' = fneg double ')); IRLPS(0,L); IRLE(0); RETURN V);
           IRLPS(0,LOC(' = sub ')); IRLPS(0,IRLLTYPE(T)); IRLPS(0,LOC(' 0, ')); IRLPS(0,L); IRLE(0);
           RETURN V);
 OP=20 => (IRLPUSH(T);
           L:=IRLEXC([N+5],T);
           T:=IRLPOP(0);
           V:=IRLNEWVAL(0);
           IRLI(0); IRLPS(0,V); IRLPS(0,LOC(' = xor ')); IRLPS(0,IRLLTYPE(T)); IRLPC(0,32); IRLPS(0,L); IRLPS(0,LOC(', -1')); IRLE(0);
           RETURN V);
 ((OP GE 25) AND (OP LE 34)) => (IRLPUSH(T);
                               C:=IRLCOMPARE(N);
                               T:=IRLPOP(0);
                               V:=IRLNEWVAL(0);
                               IRLI(0); IRLPS(0,V); IRLPS(0,LOC(' = zext i1 ')); IRLPS(0,C); IRLPS(0,LOC(' to ')); IRLPS(0,IRLLTYPE(T)); IRLE(0);
                               RETURN V);
 IRLPUSH(N); IRLPUSH(T);
 L:=IRLEXC([N+5],T);
 T:=IRLPOP(0); N:=IRLPOP(0);
 IRLPUSH(N); IRLPUSH(T); IRLPUSH(L);
 R:=IRLEXC([N+6],T);
 L:=IRLPOP(0); T:=IRLPOP(0); N:=IRLPOP(0);
 OP:=[N];
 V:=IRLNEWVAL(0);
 OP=10 => (OPN:=LOC('add'); T=13 => OPN:=LOC('fadd'); GO TO EXBIN);
 OP=11 => (OPN:=LOC('sub'); T=13 => OPN:=LOC('fsub'); GO TO EXBIN);
 OP=14 => (OPN:=LOC('mul'); T=13 => OPN:=LOC('fmul'); GO TO EXBIN);
 OP=12 => (OPN:=LOC('sdiv'); IRLISU(T) NE 0 => OPN:=LOC('udiv'); T=13 => OPN:=LOC('fdiv'); GO TO EXBIN);
 OP=13 => (T=13 => IRLDIE(LOC('integer operator on a real'),LOC(IRLZERO));
           OPN:=LOC('srem'); IRLISU(T) NE 0 => OPN:=LOC('urem'); GO TO EXBIN);
 ((OP=15) OR (OP=16) OR (OP=17)) => (T=13 => IRLDIE(LOC('integer operator on a real'),LOC(IRLZERO));
                                   OPN:=LOC('xor'); OP=15 => OPN:=LOC('and'); OP=16 => OPN:=LOC('or'); GO TO EXBIN);
 ((OP=18) OR (OP=19)) => (S:=IRLNEWVAL(0);
                        IRLI(0); IRLPS(0,S); IRLPS(0,LOC(' = and ')); IRLPS(0,IRLLTYPE(T)); IRLPC(0,32); IRLPS(0,R); IRLPS(0,LOC(', ')); IRLPN(0,IRLBITS(T)-1); IRLE(0);
                        OPN:=LOC('ashr'); IRLISU(T) NE 0 => OPN:=LOC('lshr'); OP=18 => OPN:=LOC('shl');
                        IRLI(0); IRLPS(0,V); IRLPS(0,LOC(' = ')); IRLPS(0,OPN); IRLPC(0,32); IRLPS(0,IRLLTYPE(T)); IRLPC(0,32); IRLPS(0,L); IRLPS(0,LOC(', ')); IRLPS(0,S); IRLE(0);
                        RETURN V);
 IRLERRN(LOC('ir2ll: operator '),OP);
 RETURN 0;
 EXBIN: IRLI(0); IRLPS(0,V); IRLPS(0,LOC(' = ')); IRLPS(0,OPN); IRLPC(0,32); IRLPS(0,IRLLTYPE(T)); IRLPC(0,32); IRLPS(0,L); IRLPS(0,LOC(', ')); IRLPS(0,R); IRLE(0);
 V);

# ---- THE STATEMENTS ---- #
SUBR IRLSTMT(NN) IS (
 N,OP,D,V,C,X,Y,NX,VT ARE LOCAL;
 N:=NN; OP:=[N];
 OP=49 => (D:=[N+5]; X:=[N+6];
           (([D]=6) AND ([D+3]=0)) => (V:=IRLEXC(X,8);
                                     IRLI(0); IRLPS(0,LOC('ret i64 ')); IRLPS(0,V); IRLTE(0);
                                     RETURN 0);
           V:=IRLEXPR(X); VT:=[X+1];
           IRLSTORE(D,V,VT);
           RETURN 0);
 OP=35 => (NX:=IRLVN(110,IRLNVAL); IRLNVAL:=IRLNVAL+1;
           X:=[N+5];
           (([X] GE 25) AND ([X] LE 34)) => (C:=IRLCOMPARE(X); GO TO CB1);
           V:=IRLEXC(X,8); C:=IRLNEWVAL(0);
           IRLI(0); IRLPS(0,C); IRLPS(0,LOC(' = icmp ne i64 ')); IRLPS(0,V); IRLPS(0,LOC(', 0')); IRLE(0);
           CB1: Y:=[N+6];
           IRLI(0); IRLPS(0,LOC('br i1 ')); IRLPS(0,C); IRLPS(0,LOC(', label %L')); IRLPN(0,[Y+2]); IRLPS(0,LOC(', label ')); IRLPS(0,NX); IRLTE(0);
           Y:=NX+1; IRLPS(0,Y); IRLPC(0,58); IRLPC(0,10); IRLTERM:=0;
           RETURN 0);
 OP=54 => (Y:=[N+5];
           IRLI(0); IRLPS(0,LOC('br label %L')); IRLPN(0,[Y+2]); IRLTE(0);
           RETURN 0);
 ((OP=41) OR (OP=42)) => (V:=IRLCALLEXPR(N); RETURN 0);
 IRLERRN(LOC('ir2ll: statement '),OP);
 0)
%%
