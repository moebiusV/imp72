TWOSEG;
CONST IS COMMON;
IMPSVD,IMPSVN ARE COMMON;                 # THE DATE (AS CALLI 14B GIVES IT) AND THE NUMBER OF THE LAST /U OR /V THAT SAVED THIS COMPILER: THE BANNER OF A SAVED COMPILER, WHICH THE IMAGE CARRIES (SRC/IMPM.IMP) #
#THIS IS FILE RSYN, THE BOOTSTRAP READER FOR INITIAL IMP SYNTAX, FOR THE 64 BIT PORT.
 SEE DECUS/RSYN.IMC FOR THE ORIGINAL (AND ITS APOLOGY), DOCS/PORTING/MODULES.MD FOR THE
 DIFFERENCES.

     SEMN = THE INDEX OF THE FIRST SEMANTICS TO COME FROM THIS PRODUCTION.
            IT IS THE PRODUCTION NUMBER IN THE SYNTAX GRAPH AND ITS ENTRY
            IN SEMS HOLDS THE NUMBER OF ARGUMENTS FOR THE PRODUCTION (NNA
            IN RSYN).
     SEMK = THE INDEX OF THE SEMANTICS CURRENTLY BEING GENERATED.
     PRODN= THE PRODUCTION NUMBER UNDER WHICH THE CURRENT SEMANTICS IS TO
            BE ENTERED IN THE CODE GENERATION TREE BY ENTREE.  PRODN=SEMN
            EXCEPT WHEN DEFINING A "CASE OF" SEMANTICS, WHERE PRODN IS SET
            TO SOME UNIQUE SEMS INDEX TO IDENTIFY THE CASE.

 THE SEMANTIC ROUTINES OF THIS MODULE ARE ENTERED IN THE TABLE OF DSEM (STAGE0/SEMTAB.C: THE TABLE HOLDS ADDRESSES).
 A NAME IS TAKEN APART WITH DNAME AND
 MADE WITH DIR, EIGHT CHARACTERS TO A WORD, THE FIRST IN THE LOW BYTE. #

# RSYNI: THE HEAD OF RSYN, WHICH SETS UP ITS TABLES AND ENTERS THE SEMANTIC ROUTINES OF THIS MODULE IN THE TABLE.  A RUN THAT STARTS FROM AN IMAGE (-I) DOES NOT READ THE SYNTAX, BUT THE TABLE OF ROUTINES MUST BE MADE #
SUBR RSYNI(NIL) IS (
 STINIT(0);
 FRELOT(RST,'RSYN',23,0); NRST:=NSPARS:=0;
 FRELOT(NA,'RSYN2',12,0);
 SEMI:=DIR(';'); LBR:=DIR('<'); RBR:=DIR('>'); PCT:=DIR('%');
 EQS:=DIR('=');  COMMA:=DIR(','); QUO:=DIR('"');
 LPAR:=DIR('('); RPAR:=DIR(')'); COLON:=DIR(':');
 SEMK:=SETSEM(0,0);
 NAM:=DIR('NAM'); NAMM:=DIR('NAM#');
 SYM:=DIR('SYM'); SYMM:=DIR('SYM#');
 DSEM('CASE',CASE);
 DSEM('DEFCASE',DEFCASE);
 DSEM('QUOSEM',QUOSEM);
 DSEM('EQUOSE',EQUOSE);
 DSEM('SEMBIT',SEMBIT);
 DSEM('SYTRM',SYTRM);
 DSEM('SYNTS',SYNTS);
 DSEM('SEMANTICS',SEMANTICS);
 DSEM('SYNTAX',SYNTAX);
 DSEM('SEMR',SEMR);
 DSEM('SEMP',SEMP);
 DSEM('SYNT',SYNT);
 DSEM('ENSTACK',ENSTACK);
 DSEM('VALU',VALU);
 DSEM('REPVAL',REPVAL);
 0);

SUBR RSYN(TR) IS (
 RSYNI(0);
 NEXT: NL:=NP:=0;
 STINIT(0);
 CL:=LEX(J);
 J NE LBR => RSERR(1);
 SYNT(STX(J),0);
 CL:=LEX(J); J NE RBR => RSERR(2);
 CL:=LEX(J); J NE COLON => RSERR(3);
 CL:=LEX(J); J NE COLON => RSERR(4);
 CL:=LEX(J); J NE EQS => RSERR(5);
 NSYMB:
 CL:=LEX(J);
 GNSYMB: J=LBR=>(CL:=LEX(J); K:=SETSTK(2,(1 OR (J LS 32)),0,0);
                 CL:=LEX(J); J NE COMMA => RSERR(6);
                 SYNT(K,STX(J));
                 CL:=LEX(J); J=RBR=>GO TO NSYMB; RSERR(7));
 J=SEMI=>(SYNTAX(0); GO TO NEXT);
 J=PCT=>(SYNTAX(0); GO TO QUIT);
 J NE COLON => (
    CL:=LEX(JJ); JJ=QUO=>(J NE NAM=>(J NE SYM=>GO TO L11);
                      SYNTS(-J);
                      GO TO NSYMB);
    L11: SYTRM(SETSTK(1,(1 OR (J LS 32)),0,0));
    J:=JJ; GO TO GNSYMB);
#HAVE THE SYNTAX - DO THE SEMANTICS. #
 SYNTAX(1);
 CL:=LEX(J); J NE COLON=>RSERR(8);
 CL:=LEX(J); J NE EQS=>RSERR(9);
 CL:=LEX(J); JJ:=SETSTK(1,(1 OR (J LS 32)),0,0);
 CL:=LEX(J); J NE LPAR=>RSERR(10);
 CL:=LEX(J); J=RPAR=>(SEMR(JJ,0); GO TO L10);
 SEMR(JJ,1);
 L14: SEMP(SETSTK(1,(1 OR (J LS 32)),0,0),0);
      CL:=LEX(J); J=COMMA=>(CL:=LEX(J); GO TO L14);
 J NE RPAR=>RSERR(11);
 SEMP(0,1);
 L10: CL:=LEX(J); J NE SEMI=>(J NE PCT=>RSERR(12));
 SEMANTICS(0);
 J=SEMI=>GO TO NEXT;
 QUIT: CL:=LEX(J); J NE PCT=>RSERR(13);
 0);

SUBR RSERR(N) IS (
 PLINE1(CL);
 MSG('?ERROR IN INITIAL SYNTAX');
 ERROR(0,0));
SUBR STX(J) IS (CL:=LEX(J); SETSTK(1,(1 OR (J LS 32)),0,0));
SUBR ADDCHAR(S,C) IS (
 CC:=C;
 FOO IS 11 LONG; NF:=0;
 L6: CCC:=DNAME(S,NF); FOO[NF]:=PREP(CCC,CC);
     (CC:=LASTC(CCC))=>((NF:=NF+1)>9=>
                           ERROR(1,'IN ADDCHAR - NAME > 80 CHARACTERS **');
                         GO TO L6);
 FOO[NF+1]:=0;
 DIR(FOO));
SUBR SYTRM(A) IS SYNT(SYTERM(A),-1);
SUBR SYTERM(S) IS ( #IF S IS A SINGLE QUOTED CHARACTER, REMOVES QUOTE. #
 R:=FREE(S); Q:=HL(R);
 Q:=DNAME(Q,0);
 CHR0(Q)=47B=>(REST(REST(Q))=0=>(CHR(Q,1)=>(
                       Q:=DIR(REST(Q));
                       FREES(S,(HR(R) OR (Q LS 32)))));
               REST(REST(REST(Q)))=0=>(CHR(Q,1)=072B=>(CHR(Q,2)=075B=>(      # ':=' IS ONE TOKEN #
                       Q:=DIR(REST(Q));
                       FREES(S,(HR(R) OR (Q LS 32)))))));
 S);
SUBR SYNT(A,B) IS (
 # SEMANTIC ROUTINE TO ADD A SYNTAX ELEMENT TO DEFINITION BEING BUILT. #
 SNIT=0=>(FRELOT(SN,'SYNTX',25,0);
          SNIT:=1;
          SNITT:=0);
 (Q:=B)>0=>(Q:=FREE(SYTERM(B)); Q:=HL(Q));
 R:=FREE(A); R:=HL(R);
 B<0=>GO TO L17;  # SKIP ALL THIS IF TERMINAL SYMBOL #
 SNITT=0=>(#INITIALIZE FOR ONE PRODUCTION#
           NSN:=SEMN:=SMIT:=0; NNA:=-1;
           SNITT:=1);
 R:=ADDCHAR(R,43B);
 NNA GE 0=>FADD(NA,NNA,Q) ELSE NNA:=0;
 L17: FADD(SN,NSN,R);
 A);
SUBR SYNTS(N) IS (
 ND:=CHAT(43B,3) OR DNAME(-N,0);
 FADD(SN,NSN,DIR(ND));
 FADD(NA,NNA,-1);
 0);
SUBR SEMANTICS(NIL) IS (
 # JUST IN CASE WE HAVE VAL/"STUFF", CALL SEMFX1 WHICH PATCHES IT #
 SEMFX1(SEMK,NA,NNA);
 # ENTER PRODUCTION IN CODE TREE #
 FLEN(RST) LE NNA+1 => FADDEX(RST,NNA+1);
 NNA=>(FREES(RST+I,-FREE(NA+I)) FOR I TO NNA-1);
 FREES(RST+NNA,SEMN);
 FREES(RST+NNA+1,0);
 ENTREE(RST,SEMN,SEMK,PRODN);
 SEMK:=SETSEM(0,NNA LS 32);
 0);
SUBR FORMARG(I) IS ( # TESTS IF I IS DIR INDEX OF A FORMAL ARG OF SYNTAX #
 VAL,J,K ARE LOCAL;
 VAL:=0;
 NNA=>((J:=FREE(NA+K); J=I=>VAL:=1) FOR K FROM NNA-1);
 VAL);
SUBR SYNARG(I) IS # RETURNS NAME OF I-TH FORMAL ARG. OF SYNTAX # FREE(NA+I);
SUBR DEFCASE(N) IS (
 CAS=>ERROR(1,'NESTED CASE DEFINITIONS ILLEGAL **');
 CAS:=HL(FREE(N));
 SEMK=SEMN=>SEMK:=SETSEM(0,NNA LS 32);
 PRODN:=SEMK;
 DPROP('SEM',CAS)=>
     ERROR(1,'CASE DEFINED TWICE OR SAME NAME AS SEMANTIC ROUTINE **');
 DPROPS('SEM',CAS,PRODN);
 0);
SUBR CASE(A,F) IS (
 F=>(CAS:=0; PRODN:=SEMN; SEMK:=SETSEM(0,NNA LS 32));
 S:=ENSTACK(0);
 L27: GETLIST(S)=>(K:=GETARG(S);
                   TY=2=>ERROR(1,'CANT USE NONTERMINALS IN CASE ARG LIST');
                   SETSEM(10B,K);
                   GO TO L27);
 J:=FREE(A);
 DOCASE(HL(J),SEMK,SEMN);
 ENTRCA(SEMN);
 SEMK:=SETSEM(0,NNA LS 32);
 A);
SUBR QUOSEM(A) IS (
 # ENTER CONDITIONAL PRODUCTION IN CODE TREE, THEN REINITIALIZE SOME
   THINGS FOR NEXT PRODUCTION TO FOLLOW IN SAME SEMANTICS. #
 TB:=ENTREE(FREE(A+1),SEMN,SEMK,PRODN);
 SEMFIX(SEMK,TB);
 SEMK:=SETSEM(0,NNA LS 32);
 FALLOT(FREE(A+1),0);
 A);
SUBR EQUOSE(A) IS (
 # ENTER SEMANTICS FOR QUOTED SEMANTICS IN SEMS. #
 # FIRST CHECK FOR LOCAL VARIABLES - THEY GET FUNNY NEG. ENTRIES :
      -(VAR. NR. LS 18 OR DIR INDEX) FIRST TIME; AFTER, LEAVE OFF DIR. INDEX #
 T:=ENSTACK(0); I:=0;
 L19: GETLIST(T)=>(I:=I+1;
   N:=FREE(T); N:=-HL(N);
   J:=FREE(A+1); NN:=0;
   L20: K:=FREE(J); K=>(K=N=>(NN=0=>(NN:=1; FREES(J,-((-N) OR (I LS 32))))
                              ELSE FREES(J,-(I LS 32)));
                       J:=J+1; GO TO L20);
   GO TO L19);
 J:=FREE(A+1); J:=J-1;
 L18: J:=J+1; K:=FREE(J);
 K=>(K<0=>NNA=>((JJ:=FREE(NA+I);
                 JJ=K=>(SETSEM(7,I); GO TO L18);
                 JJ=-K=>(SETSEM(6,I); FREES(NA+I,K); GO TO L18))
                                                        FOR I TO NNA-1);
     SETSEM(5,SVMASK AND -K);
     GO TO L18);
 NNA=>((JJ:=FREE(NA+I);
        JJ<0=>FREES(NA+I,-JJ)) FOR I TO NNA-1);
 FALLOT(FREE(A+1),0);
 A);
SUBR SEMP(A,B) IS (
 B=>(NRST:=NRST-1;
     J:=FREE(RST+NRST);
     SETSEM(3,HR(J) OR (NSARGS LS 32));
     NSARGS:=1+HL(J);
     GO TO SEMPX);
 NSARGS:=NSARGS+1;
 Q:=GETARG(SYTERM(A));
 SETSEM(TY,Q);
 SEMPX: 0);
SUBR GETARG(A) IS ( # MAKE SEMS ENTRY FOR IDENTIFIER, CONSTANT OR ARGUMENT. #
 Q:=HL(FREE(A));
 TY:=4;
 J:=CONVC(Q);
 J=>(Q:=SVMASK AND -CONST; GO TO L13);
 NNA=>((J:=FREE(NA+R);
        J=Q=>(Q:=R; TY:=2; GO TO L13)) FOR R TO NNA-1);
 L13: Q);
SUBR SEMR(A,B) IS (
 A=0=>(SETSEM(B,0); NSARGS:=NSARGS-1; GO TO SEMRX);
 Q:=DPROP('SEM',HL(FREE(A)));
 Q=0=>(J:=FREE(A); PNAME(HL(J)); PRINT STG 0,' ';
       ERROR(1,'UNDEFINED SEMANTIC ROUTINE'));
 B=>(FADD(RST,NRST,Q OR (NSARGS LS 32)); NSARGS:=0) ELSE(SETSEM(3,Q);
                                                      NSARGS:=NSARGS+1);
 SEMRX: A);
SUBR SYNTAX(N) IS (N=2=>(SEMK=SEMN=>SEMK:=SETSEM(0,NNA LS 32);
                         GO TO SYNXX);
                   SEMN:=0;
                   (N OR NNA-1)=>(SEMN:=PRODN:=SEMK;
                                  RESETSEM(NNA,SEMK);
                                  N=0=>SEMANTICS(0));
                   PRODN:=SEMN:=GRAPH(SN,NSN-1,SEMN);
                   GMATR(0);
                   SNITT:=0;
                   SYNXX: 0);
SUBR SEMBIT(A) IS (
 # SETS PRIORITY BITS FOR A PRODUCTION #
 J:=FREE(A); CONVC(HL(J));
 SEMOR(CONST LS 41,SEMN);
 0);

SUBR REPVAL(S,A) IS (
 J:=FREE(S); J:=DPROP('SEM',HL(J));
 K:=FREE(A+1);
 L44: I:=FREE(K);
      I>0=>CKSVAL(HR(I),J)=>FREES(K,(J OR (I LS 32)));
      K:=K+1;
      I=>GO TO L44;
 A);
SUBR VALU(N,S) IS (
 K:=HL(FREE(S));
 JJ:=J:=DPROP('SEM',K);
 JJ=0=>(J:=SEMK+2; DPROPS('SEM',K,J));
 K:=HL(FREE(N));
 CONVC(K)=0=>ERROR(1,'VALUE NOT A CONSTANT **');
 SETSEM(12B,SVMASK AND (J OR (CONST LS 32)));
 JJ=0=>SETSEM(0,NNA LS 32);
 0);

# THE SAVE COUNT AND DATE OF THIS COMPILER, FOR THE BANNER (SRC/IMPM.IMP): KEPT HERE, NOT THERE, BECAUSE THE IMAGE LEAVES THE VARIABLES OF IMPM OUT #
SUBR IMPSVNUM(Z) IS IMPSVN;
SUBR IMPSVDAT(Z) IS IMPSVD;
SUBR IMPSVSET(N,D) IS (IMPSVN:=N; IMPSVD:=D; 0)
%%
