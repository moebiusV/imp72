TWOSEG;
#THIS IS FILE RSYN, THE BOOTSTRAP READER FOR INITIAL IMP SYNTAX, FOR THE 64 BIT PORT.
 SEE DECUS/RSYN.IMC FOR THE ORIGINAL (AND ITS APOLOGY), DOCS/PORTING/RSYN.MD FOR THE
 DIFFERENCES.

     SEMN = THE INDEX OF THE FIRST SEMANTICS TO COME FROM THIS PRODUCTION.
            IT IS THE PRODUCTION NUMBER IN THE SYNTAX GRAPH AND ITS ENTRY
            IN SEMS HOLDS THE NUMBER OF ARGUMENTS FOR THE PRODUCTION (NNA
            IN RSYN).
     SEMK = THE INDEX OF THE SEMANTICS CURRENTLY BEING GENERATED.
     PRODN= THE PRODUCTION NUMBER UNDER WHICH THE CURRENT SEMANTICS IS TO
            BE ENTERED IN THE CODE GENERATION TREE BY ENTREE.  PRODN=SEMN
            EXCEPT WHEN DEFINING A "CASE OF" SEMANTICS, WHERE PRODN IS SET
            TO SOME UNIQUE SEMS INDEX TO IDENTIFY THE CASE.

 THE SEMANTIC ROUTINES OF THIS MODULE ARE ENTERED IN THE TABLE OF DSEM BY C THUNKS
 (STAGE0/RSYN_IMP.C: THE TABLE HOLDS C FUNCTIONS), THROUGH IMPDSEMSR.  THE ROUTINE CASE
 OF THE ORIGINAL IS CALLED RCASE (CASE IS A C KEYWORD).  THE C ROUTINES THAT THIS CALLS ARE
 CALLED THROUGH STAGE0/IMPGLUE.C, BY REFERENCE.  A NAME IS TAKEN APART WITH DNAME AND
 MADE WITH IMPDIRP, FIVE CHARACTERS TO A WORD AS BEFORE; THE NUMBER SIGN IS 43B LS 29
 (A STRING CONSTANT IS BYTES HERE). #

SUBR RSYN(TR) IS (
 IMPSTINIT(0);
 FRELOT(RST,'RSYN',23,0); NRST_NSPARS_0;
 FRELOT(NA,'RSYN2',12,0);
 SEMI_DIR(';'); LBR_DIR('<'); RBR_DIR('>'); PCT_DIR('%');
 EQS_DIR('=');  COMMA_DIR(','); QUO_DIR('"');
 LPAR_DIR('('); RPAR_DIR(')'); COLON_DIR(':');
 SEMK_IMPSETSEM(0,0);
 NAM_DIR('NAM'); NAMM_DIR('NAM#');
 SYM_DIR('SYM'); SYMM_DIR('SYM#');
 IMPDSEMSR(0);
 NEXT: NL_NP_0;
 IMPSTINIT(0);
 CL_IMPLEX(J);
 J NE LBR => RSERR(1);
 SYNT(STX(J),0);
 CL_IMPLEX(J); J NE RBR => RSERR(2);
 CL_IMPLEX(J); J NE COLON => RSERR(3);
 CL_IMPLEX(J); J NE COLON => RSERR(4);
 CL_IMPLEX(J); J NE EQS => RSERR(5);
 NSYMB:
 CL_IMPLEX(J);
 GNSYMB: J=LBR=>(CL_IMPLEX(J); K_IMPSETSTK(2,SX36(1 OR ((J LS 9) LS 9)),0,0);
                 CL_IMPLEX(J); J NE COMMA => RSERR(6);
                 SYNT(K,STX(J));
                 CL_IMPLEX(J); J=RBR=>GO TO NSYMB; RSERR(7));
 J=SEMI=>(SYNTAX(0); GO TO NEXT);
 J=PCT=>(SYNTAX(0); GO TO QUIT);
 J NE COLON => (
    CL_IMPLEX(JJ); JJ=QUO=>(J NE NAM=>(J NE SYM=>GO TO L11);
                      SYNTS(-J);
                      GO TO NSYMB);
    L11: SYTRM(IMPSETSTK(1,SX36(1 OR ((J LS 9) LS 9)),0,0));
    J_JJ; GO TO GNSYMB);
#HAVE THE SYNTAX - DO THE SEMANTICS. #
 SYNTAX(1);
 CL_IMPLEX(J); J NE COLON=>RSERR(8);
 CL_IMPLEX(J); J NE EQS=>RSERR(9);
 CL_IMPLEX(J); JJ_IMPSETSTK(1,SX36(1 OR ((J LS 9) LS 9)),0,0);
 CL_IMPLEX(J); J NE LPAR=>RSERR(10);
 CL_IMPLEX(J); J=RPAR=>(SEMR(JJ,0); GO TO L10);
 SEMR(JJ,1);
 L14: SEMP(IMPSETSTK(1,SX36(1 OR ((J LS 9) LS 9)),0,0),0);
      CL_IMPLEX(J); J=COMMA=>(CL_IMPLEX(J); GO TO L14);
 J NE RPAR=>RSERR(11);
 SEMP(0,1);
 L10: CL_IMPLEX(J); J NE SEMI=>(J NE PCT=>RSERR(12));
 SEMANTICS(0);
 J=SEMI=>GO TO NEXT;
 QUIT: CL_IMPLEX(J); J NE PCT=>RSERR(13);
 0);

SUBR RSERR(N) IS (
 IMPPLINE1(CL);
 IMPMSG('?ERROR IN INITIAL SYNTAX');
 ERROR(0,0));
SUBR STX(J) IS (CL_IMPLEX(J); IMPSETSTK(1,SX36(1 OR ((J LS 9) LS 9)),0,0));
SUBR ADDCHAR(S,C) IS (
 CC_C;
 FOO IS 11 LONG; NF_0;
 L6: FOO[NF]_CC OR ((CCC_IMPDNAME(S,NF)) RS 7);
     (CC_CCC AND 377B)=>((NF_NF+1)>9=>
                           ERROR(1,'IN ADDCHAR - NAME > 50 CHARACTERS **');
                         CC_CC LS 28; GO TO L6);
 FOO[NF+1]_0;
 IMPDIRP(FOO));
SUBR SYTRM(A) IS SYNT(SYTERM(A),-1);
SUBR SYTERM(S) IS ( #IF S IS A SINGLE QUOTED CHARACTER, REMOVES QUOTE. #
 R_FREE(S); Q_L18(R);
 Q_IMPDNAME(Q,0);
 (Q RS 29)=47B=>((Q AND 17777777B)=0=>(((Q RS 22) AND 177B)=>(
                       Q_IMPDIRP(Q LS 7);
                       FREES(S,SX36(R18(R) OR ((Q LS 9) LS 9))))));
 S);
SUBR SYNT(A,B) IS (
 # SEMANTIC ROUTINE TO ADD A SYNTAX ELEMENT TO DEFINITION BEING BUILT. #
 SNIT=0=>(FRELOT(SN,'SYNTX',25,0);
          SNIT_1;
          SNITT_0);
 (Q_B)>0=>(Q_FREE(SYTERM(B)); Q_L18(Q));
 R_FREE(A); R_L18(R);
 B<0=>GO TO L17;  # SKIP ALL THIS IF TERMINAL SYMBOL #
 SNITT=0=>(#INITIALIZE FOR ONE PRODUCTION#
           NSN_SEMN_SMIT_0; NNA_-1;
           SNITT_1);
 R_ADDCHAR(R,43B LS 29);
 NNA GE 0=>FADD(NA,NNA,Q) ELSE NNA_0;
 L17: FADD(SN,NSN,R);
 A);
SUBR SYNTS(N) IS (
 ND_21400B OR IMPDNAME(-N,0);
 FADD(SN,NSN,IMPDIRP(ND));
 FADD(NA,NNA,-1);
 0);
SUBR SEMANTICS() IS (
 # JUST IN CASE WE HAVE VAL/"STUFF", CALL SEMFX1 WHICH PATCHES IT #
 IMPSEMFX1(SEMK,NA,NNA);
 # ENTER PRODUCTION IN CODE TREE #
 FLEN(RST) LE NNA+1 => FADDEX(RST,NNA+1);
 NNA=>(FREES(RST+I,-FREE(NA+I)) FOR I TO NNA-1);
 FREES(RST+NNA,SEMN);
 FREES(RST+NNA+1,0);
 IMPENTREE(RST,SEMN,SEMK,PRODN);
 SEMK_IMPSETSEM(0,(NNA LS 9) LS 9);
 0);
SUBR SYNARG(I) IS # RETURNS NAME OF I-TH FORMAL ARG. OF SYNTAX # FREE(NA+I);
SUBR DEFCASE(N) IS (
 CAS=>ERROR(1,'NESTED CASE DEFINITIONS ILLEGAL **');
 CAS_L18(FREE(N));
 SEMK=SEMN=>SEMK_IMPSETSEM(0,(NNA LS 9) LS 9);
 PRODN_SEMK;
 DPROP('SEM',CAS)=>
     ERROR(1,'CASE DEFINED TWICE OR SAME NAME AS SEMANTIC ROUTINE **');
 DPROPS('SEM',CAS,PRODN);
 0);
SUBR RCASE(A,F) IS (
 F=>(CAS_0; PRODN_SEMN; SEMK_IMPSETSEM(0,(NNA LS 9) LS 9));
 S_IMPENSTACK(0);
 L27: IMPGETLIST(S)=>(K_GETARG(S);
                   TY=2=>ERROR(1,'CANT USE NONTERMINALS IN CASE ARG LIST');
                   IMPSETSEM(10B,K);
                   GO TO L27);
 J_FREE(A);
 IMPDOCASE(L18(J),SEMK,SEMN);
 IMPENTRCA(SEMN);
 SEMK_IMPSETSEM(0,(NNA LS 9) LS 9);
 A);
SUBR QUOSEM(A) IS (
 # ENTER CONDITIONAL PRODUCTION IN CODE TREE, THEN REINITIALIZE SOME
   THINGS FOR NEXT PRODUCTION TO FOLLOW IN SAME SEMANTICS. #
 TB_IMPENTREE(FREE(A+1),SEMN,SEMK,PRODN);
 IMPSEMFIX(SEMK,TB);
 SEMK_IMPSETSEM(0,(NNA LS 9) LS 9);
 FALLOT(FREE(A+1),0);
 A);
SUBR EQUOSE(A) IS (
 # ENTER SEMANTICS FOR QUOTED SEMANTICS IN SEMS. #
 # FIRST CHECK FOR LOCAL VARIABLES - THEY GET FUNNY NEG. ENTRIES :
      -(VAR. NR. LS 18 OR DIR INDEX) FIRST TIME; AFTER, LEAVE OFF DIR. INDEX #
 T_IMPENSTACK(0); I_0;
 L19: IMPGETLIST(T)=>(I_I+1;
   N_FREE(T); N_-L18(N);
   J_FREE(A+1); NN_0;
   L20: K_FREE(J); K=>(K=N=>(NN=0=>(NN_1; FREES(J,-((-N) OR ((I LS 9) LS 9))))
                              ELSE FREES(J,-((I LS 9) LS 9)));
                       J_J+1; GO TO L20);
   GO TO L19);
 J_FREE(A+1); J_J-1;
 L18: J_J+1; K_FREE(J);
 K=>(K<0=>NNA=>((JJ_FREE(NA+I);
                 JJ=K=>(IMPSETSEM(7,I); GO TO L18);
                 JJ=-K=>(IMPSETSEM(6,I); FREES(NA+I,K); GO TO L18))
                                                        FOR I TO NNA-1);
     IMPSETSEM(5,007777777777B AND -K);
     GO TO L18);
 NNA=>((JJ_FREE(NA+I);
        JJ<0=>FREES(NA+I,-JJ)) FOR I TO NNA-1);
 FALLOT(FREE(A+1),0);
 A);
SUBR SEMP(A,B) IS (
 B=>(NRST_NRST-1;
     J_FREE(RST+NRST);
     IMPSETSEM(3,R18(J) OR ((NSARGS LS 9) LS 9));
     NSARGS_1+L18(J);
     GO TO SEMPX);
 NSARGS_NSARGS+1;
 Q_GETARG(SYTERM(A));
 IMPSETSEM(TY,Q);
 SEMPX: 0);
SUBR GETARG(A) IS ( # MAKE SEMS ENTRY FOR IDENTIFIER, CONSTANT OR ARGUMENT. #
 Q_L18(FREE(A));
 TY_4;
 J_IMPCONVC(Q,KONV);
 J=>(Q_007777777777B AND -KONV; GO TO L13);
 NNA=>((J_FREE(NA+R);
        J=Q=>(Q_R; TY_2; GO TO L13)) FOR R TO NNA-1);
 L13: Q);
SUBR SEMR(A,B) IS (
 A=0=>(IMPSETSEM(B,0); NSARGS_NSARGS-1; GO TO SEMRX);
 Q_DPROP('SEM',L18(FREE(A)));
 Q=0=>(J_FREE(A); IMPPNAME(L18(J)); PRINT STG 0,' ';
       ERROR(1,'UNDEFINED SEMANTIC ROUTINE'));
 B=>(FADD(RST,NRST,Q OR ((NSARGS LS 9) LS 9)); NSARGS_0) ELSE(IMPSETSEM(3,Q);
                                                      NSARGS_NSARGS+1);
 SEMRX: A);
SUBR SYNTAX(N) IS (N=2=>(SEMK=SEMN=>SEMK_IMPSETSEM(0,(NNA LS 9) LS 9);
                         GO TO SYNXX);
                   SEMN_0;
                   (N OR NNA-1)=>(SEMN_PRODN_SEMK;
                                  IMPRESETSEM(NNA,SEMK);
                                  N=0=>SEMANTICS(0));
                   PRODN_SEMN_IMPGRAPH(SN,NSN-1,SEMN);
                   IMPGMATR(0);
                   SNITT_0;
                   SYNXX: 0);
SUBR SEMBIT(A) IS (
 # SETS PRIORITY BITS FOR A PRODUCTION #
 J_FREE(A); IMPCONVC(L18(J),KONV);
 IMPSEMOR(LS36(KONV,27),SEMN);
 0);

SUBR REPVAL(S,A) IS (
 J_FREE(S); J_DPROP('SEM',L18(J));
 K_FREE(A+1);
 L44: I_FREE(K);
      I>0=>IMPCKSVAL(R18(I),J)=>FREES(K,SX36(J OR ((I LS 9) LS 9)));
      K_K+1;
      I=>GO TO L44;
 A);
SUBR VALU(N,S) IS (
 K_L18(FREE(S));
 JJ_J_DPROP('SEM',K);
 JJ=0=>(J_SEMK+2; DPROPS('SEM',K,J));
 K_L18(FREE(N));
 IMPCONVC(K,KONV)=0=>ERROR(1,'VALUE NOT A CONSTANT **');
 IMPSETSEM(12B,7777777777B AND (J OR ((KONV LS 9) LS 9)));
 JJ=0=>IMPSETSEM(0,(NNA LS 9) LS 9);
 0)%%%
