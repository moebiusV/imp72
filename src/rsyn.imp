TWOSEG;
CONST IS COMMON;
#THIS IS FILE RSYN, THE BOOTSTRAP READER FOR INITIAL IMP SYNTAX, FOR THE 64 BIT PORT.
 SEE DECUS/RSYN.IMC FOR THE ORIGINAL (AND ITS APOLOGY), DOCS/PORTING/RSYN.MD FOR THE
 DIFFERENCES.

     SEMN = THE INDEX OF THE FIRST SEMANTICS TO COME FROM THIS PRODUCTION.
            IT IS THE PRODUCTION NUMBER IN THE SYNTAX GRAPH AND ITS ENTRY
            IN SEMS HOLDS THE NUMBER OF ARGUMENTS FOR THE PRODUCTION (NNA
            IN RSYN).
     SEMK = THE INDEX OF THE SEMANTICS CURRENTLY BEING GENERATED.
     PRODN= THE PRODUCTION NUMBER UNDER WHICH THE CURRENT SEMANTICS IS TO
            BE ENTERED IN THE CODE GENERATION TREE BY ENTREE.  PRODN=SEMN
            EXCEPT WHEN DEFINING A "CASE OF" SEMANTICS, WHERE PRODN IS SET
            TO SOME UNIQUE SEMS INDEX TO IDENTIFY THE CASE.

 THE SEMANTIC ROUTINES OF THIS MODULE ARE ENTERED IN THE TABLE OF DSEM (STAGE0/SEMTAB.C: THE TABLE HOLDS ADDRESSES).
 A NAME IS TAKEN APART WITH DNAME AND
 MADE WITH DIR, EIGHT CHARACTERS TO A WORD, THE FIRST IN THE LOW BYTE. #

SUBR RSYN(TR) IS (
 STINIT(0);
 FRELOT(RST,'RSYN',23,0); NRST_NSPARS_0;
 FRELOT(NA,'RSYN2',12,0);
 SEMI_DIR(';'); LBR_DIR('<'); RBR_DIR('>'); PCT_DIR('%');
 EQS_DIR('=');  COMMA_DIR(','); QUO_DIR('"');
 LPAR_DIR('('); RPAR_DIR(')'); COLON_DIR(':');
 SEMK_SETSEM(0,0);
 NAM_DIR('NAM'); NAMM_DIR('NAM#');
 SYM_DIR('SYM'); SYMM_DIR('SYM#');
 DSEM('CASE',CASE);
 DSEM('DEFCASE',DEFCASE);
 DSEM('QUOSEM',QUOSEM);
 DSEM('EQUOSE',EQUOSE);
 DSEM('SEMBIT',SEMBIT);
 DSEM('SYTRM',SYTRM);
 DSEM('SYNTS',SYNTS);
 DSEM('SEMANTICS',SEMANTICS);
 DSEM('SYNTAX',SYNTAX);
 DSEM('SEMR',SEMR);
 DSEM('SEMP',SEMP);
 DSEM('SYNT',SYNT);
 DSEM('ENSTACK',ENSTACK);
 DSEM('VALU',VALU);
 DSEM('REPVAL',REPVAL);
 NEXT: NL_NP_0;
 STINIT(0);
 CL_LEX(J);
 J NE LBR => RSERR(1);
 SYNT(STX(J),0);
 CL_LEX(J); J NE RBR => RSERR(2);
 CL_LEX(J); J NE COLON => RSERR(3);
 CL_LEX(J); J NE COLON => RSERR(4);
 CL_LEX(J); J NE EQS => RSERR(5);
 NSYMB:
 CL_LEX(J);
 GNSYMB: J=LBR=>(CL_LEX(J); K_SETSTK(2,(1 OR (J LS 32)),0,0);
                 CL_LEX(J); J NE COMMA => RSERR(6);
                 SYNT(K,STX(J));
                 CL_LEX(J); J=RBR=>GO TO NSYMB; RSERR(7));
 J=SEMI=>(SYNTAX(0); GO TO NEXT);
 J=PCT=>(SYNTAX(0); GO TO QUIT);
 J NE COLON => (
    CL_LEX(JJ); JJ=QUO=>(J NE NAM=>(J NE SYM=>GO TO L11);
                      SYNTS(-J);
                      GO TO NSYMB);
    L11: SYTRM(SETSTK(1,(1 OR (J LS 32)),0,0));
    J_JJ; GO TO GNSYMB);
#HAVE THE SYNTAX - DO THE SEMANTICS. #
 SYNTAX(1);
 CL_LEX(J); J NE COLON=>RSERR(8);
 CL_LEX(J); J NE EQS=>RSERR(9);
 CL_LEX(J); JJ_SETSTK(1,(1 OR (J LS 32)),0,0);
 CL_LEX(J); J NE LPAR=>RSERR(10);
 CL_LEX(J); J=RPAR=>(SEMR(JJ,0); GO TO L10);
 SEMR(JJ,1);
 L14: SEMP(SETSTK(1,(1 OR (J LS 32)),0,0),0);
      CL_LEX(J); J=COMMA=>(CL_LEX(J); GO TO L14);
 J NE RPAR=>RSERR(11);
 SEMP(0,1);
 L10: CL_LEX(J); J NE SEMI=>(J NE PCT=>RSERR(12));
 SEMANTICS(0);
 J=SEMI=>GO TO NEXT;
 QUIT: CL_LEX(J); J NE PCT=>RSERR(13);
 0);

SUBR RSERR(N) IS (
 PLINE1(CL);
 MSG('?ERROR IN INITIAL SYNTAX');
 ERROR(0,0));
SUBR STX(J) IS (CL_LEX(J); SETSTK(1,(1 OR (J LS 32)),0,0));
SUBR ADDCHAR(S,C) IS (
 CC_C;
 FOO IS 11 LONG; NF_0;
 L6: CCC_DNAME(S,NF); FOO[NF]_(CCC LS 8) OR CC;
     (CC_CCC RS 56)=>((NF_NF+1)>9=>
                           ERROR(1,'IN ADDCHAR - NAME > 80 CHARACTERS **');
                         GO TO L6);
 FOO[NF+1]_0;
 DIR(FOO));
SUBR SYTRM(A) IS SYNT(SYTERM(A),-1);
SUBR SYTERM(S) IS ( #IF S IS A SINGLE QUOTED CHARACTER, REMOVES QUOTE. #
 R_FREE(S); Q_HL(R);
 Q_DNAME(Q,0);
 (Q AND 377B)=47B=>((Q RS 16)=0=>(((Q RS 8) AND 377B)=>(
                       Q_DIR(Q RS 8);
                       FREES(S,(HR(R) OR (Q LS 32))))));
 S);
SUBR SYNT(A,B) IS (
 # SEMANTIC ROUTINE TO ADD A SYNTAX ELEMENT TO DEFINITION BEING BUILT. #
 SNIT=0=>(FRELOT(SN,'SYNTX',25,0);
          SNIT_1;
          SNITT_0);
 (Q_B)>0=>(Q_FREE(SYTERM(B)); Q_HL(Q));
 R_FREE(A); R_HL(R);
 B<0=>GO TO L17;  # SKIP ALL THIS IF TERMINAL SYMBOL #
 SNITT=0=>(#INITIALIZE FOR ONE PRODUCTION#
           NSN_SEMN_SMIT_0; NNA_-1;
           SNITT_1);
 R_ADDCHAR(R,43B);
 NNA GE 0=>FADD(NA,NNA,Q) ELSE NNA_0;
 L17: FADD(SN,NSN,R);
 A);
SUBR SYNTS(N) IS (
 ND_(43B LS 24) OR DNAME(-N,0);
 FADD(SN,NSN,DIR(ND));
 FADD(NA,NNA,-1);
 0);
SUBR SEMANTICS(NIL) IS (
 # JUST IN CASE WE HAVE VAL/"STUFF", CALL SEMFX1 WHICH PATCHES IT #
 SEMFX1(SEMK,NA,NNA);
 # ENTER PRODUCTION IN CODE TREE #
 FLEN(RST) LE NNA+1 => FADDEX(RST,NNA+1);
 NNA=>(FREES(RST+I,-FREE(NA+I)) FOR I TO NNA-1);
 FREES(RST+NNA,SEMN);
 FREES(RST+NNA+1,0);
 ENTREE(RST,SEMN,SEMK,PRODN);
 SEMK_SETSEM(0,NNA LS 32);
 0);
SUBR SYNARG(I) IS # RETURNS NAME OF I-TH FORMAL ARG. OF SYNTAX # FREE(NA+I);
SUBR DEFCASE(N) IS (
 CAS=>ERROR(1,'NESTED CASE DEFINITIONS ILLEGAL **');
 CAS_HL(FREE(N));
 SEMK=SEMN=>SEMK_SETSEM(0,NNA LS 32);
 PRODN_SEMK;
 DPROP('SEM',CAS)=>
     ERROR(1,'CASE DEFINED TWICE OR SAME NAME AS SEMANTIC ROUTINE **');
 DPROPS('SEM',CAS,PRODN);
 0);
SUBR CASE(A,F) IS (
 F=>(CAS_0; PRODN_SEMN; SEMK_SETSEM(0,NNA LS 32));
 S_ENSTACK(0);
 L27: GETLIST(S)=>(K_GETARG(S);
                   TY=2=>ERROR(1,'CANT USE NONTERMINALS IN CASE ARG LIST');
                   SETSEM(10B,K);
                   GO TO L27);
 J_FREE(A);
 DOCASE(HL(J),SEMK,SEMN);
 ENTRCA(SEMN);
 SEMK_SETSEM(0,NNA LS 32);
 A);
SUBR QUOSEM(A) IS (
 # ENTER CONDITIONAL PRODUCTION IN CODE TREE, THEN REINITIALIZE SOME
   THINGS FOR NEXT PRODUCTION TO FOLLOW IN SAME SEMANTICS. #
 TB_ENTREE(FREE(A+1),SEMN,SEMK,PRODN);
 SEMFIX(SEMK,TB);
 SEMK_SETSEM(0,NNA LS 32);
 FALLOT(FREE(A+1),0);
 A);
SUBR EQUOSE(A) IS (
 # ENTER SEMANTICS FOR QUOTED SEMANTICS IN SEMS. #
 # FIRST CHECK FOR LOCAL VARIABLES - THEY GET FUNNY NEG. ENTRIES :
      -(VAR. NR. LS 18 OR DIR INDEX) FIRST TIME; AFTER, LEAVE OFF DIR. INDEX #
 T_ENSTACK(0); I_0;
 L19: GETLIST(T)=>(I_I+1;
   N_FREE(T); N_-HL(N);
   J_FREE(A+1); NN_0;
   L20: K_FREE(J); K=>(K=N=>(NN=0=>(NN_1; FREES(J,-((-N) OR (I LS 32))))
                              ELSE FREES(J,-(I LS 32)));
                       J_J+1; GO TO L20);
   GO TO L19);
 J_FREE(A+1); J_J-1;
 L18: J_J+1; K_FREE(J);
 K=>(K<0=>NNA=>((JJ_FREE(NA+I);
                 JJ=K=>(SETSEM(7,I); GO TO L18);
                 JJ=-K=>(SETSEM(6,I); FREES(NA+I,K); GO TO L18))
                                                        FOR I TO NNA-1);
     SETSEM(5,SVMASK AND -K);
     GO TO L18);
 NNA=>((JJ_FREE(NA+I);
        JJ<0=>FREES(NA+I,-JJ)) FOR I TO NNA-1);
 FALLOT(FREE(A+1),0);
 A);
SUBR SEMP(A,B) IS (
 B=>(NRST_NRST-1;
     J_FREE(RST+NRST);
     SETSEM(3,HR(J) OR (NSARGS LS 32));
     NSARGS_1+HL(J);
     GO TO SEMPX);
 NSARGS_NSARGS+1;
 Q_GETARG(SYTERM(A));
 SETSEM(TY,Q);
 SEMPX: 0);
SUBR GETARG(A) IS ( # MAKE SEMS ENTRY FOR IDENTIFIER, CONSTANT OR ARGUMENT. #
 Q_HL(FREE(A));
 TY_4;
 J_CONVC(Q);
 J=>(Q_SVMASK AND -CONST; GO TO L13);
 NNA=>((J_FREE(NA+R);
        J=Q=>(Q_R; TY_2; GO TO L13)) FOR R TO NNA-1);
 L13: Q);
SUBR SEMR(A,B) IS (
 A=0=>(SETSEM(B,0); NSARGS_NSARGS-1; GO TO SEMRX);
 Q_DPROP('SEM',HL(FREE(A)));
 Q=0=>(J_FREE(A); PNAME(HL(J)); PRINT STG 0,' ';
       ERROR(1,'UNDEFINED SEMANTIC ROUTINE'));
 B=>(FADD(RST,NRST,Q OR (NSARGS LS 32)); NSARGS_0) ELSE(SETSEM(3,Q);
                                                      NSARGS_NSARGS+1);
 SEMRX: A);
SUBR SYNTAX(N) IS (N=2=>(SEMK=SEMN=>SEMK_SETSEM(0,NNA LS 32);
                         GO TO SYNXX);
                   SEMN_0;
                   (N OR NNA-1)=>(SEMN_PRODN_SEMK;
                                  RESETSEM(NNA,SEMK);
                                  N=0=>SEMANTICS(0));
                   PRODN_SEMN_GRAPH(SN,NSN-1,SEMN);
                   GMATR(0);
                   SNITT_0;
                   SYNXX: 0);
SUBR SEMBIT(A) IS (
 # SETS PRIORITY BITS FOR A PRODUCTION #
 J_FREE(A); CONVC(HL(J));
 SEMOR(CONST LS 41,SEMN);
 0);

SUBR REPVAL(S,A) IS (
 J_FREE(S); J_DPROP('SEM',HL(J));
 K_FREE(A+1);
 L44: I_FREE(K);
      I>0=>CKSVAL(HR(I),J)=>FREES(K,(J OR (I LS 32)));
      K_K+1;
      I=>GO TO L44;
 A);
SUBR VALU(N,S) IS (
 K_HL(FREE(S));
 JJ_J_DPROP('SEM',K);
 JJ=0=>(J_SEMK+2; DPROPS('SEM',K,J));
 K_HL(FREE(N));
 CONVC(K)=0=>ERROR(1,'VALUE NOT A CONSTANT **');
 SETSEM(12B,SVMASK AND (J OR (CONST LS 32)));
 JJ=0=>SETSEM(0,NNA LS 32);
 0)%%%
