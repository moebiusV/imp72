QUIET,ARGVP ARE COMMON;
#THIS IS FILE DRIVER, THE FRONT OF THE COMPILER: THE MAIN PROGRAM OF IMP72, WHICH THE LIBRARY'S MAIN CALLS.  NOT IN THE TAPE, WHICH HAS ONE PROGRAM THAT READS ITS COMMANDS FROM THE TERMINAL (SRC/IMPM.IMP IS THAT,
 IMPK); THIS TURNS A COMMAND LINE LIKE THE C COMPILER'S INTO A COMPILATION AND AN EXECUTABLE:

    IMP72 [-S | -c] [-o OUT] [-s LETTERS] [-I IMAGE] [--run] FILE.imp ...
    IMP72 -i [-s LETTERS] [FILE.imp ...]        THE COMMANDS OF THE ORIGINAL, FROM THE TERMINAL

 (-S STOP AT THE LLVM IR, -c AT THE OBJECT, -o THE OUTPUT, -s THE SWITCHES, -I AN IMAGE SAVED BY U OR V.)  IT FINDS ITS PARTS RELATIVE TO ITSELF (THE SOURCE TREE, OR PREFIX/BIN, PREFIX/LIB/IMP72 AND PREFIX/SHARE/IMP72),
 RUNS THE KERNEL (IMPK) IN THIS PROCESS TO WRITE THE IR OF THE PROGRAM, AND THEN THE BACK END, LLVM IN THE PROCESS (STAGE0/LLVMORC.C); THE LINK IS THE SYSTEM'S CC.  CALLED
 BY ANOTHER NAME THAN IMP72 OR IMP72STAGE... (IMP72D IS ONE) IT IS THE KERNEL ALONE: IMPK, WITH THE ARGUMENTS OF STAGE0/IMP72S0.C.  STAGE0/IMP72S0.C IS THE SEED'S DRIVER, WHICH THIS REPLACES FOR IMP72.#

DIRB,ROOT,TMP,TMPB,IRF2,OFILE,BASEN,SYNP,FFIP,LIBP,OUTB ARE 520 LONG;
CMD IS 4096 LONG;
EXEB IS 520 LONG;
QR,QK,AV0,NA0,KA,KNN,OUTN ARE COMMON;

IMPD(0);

# EXISTS(P): CAN THE FILE BE RUN OR READ #
SUBR EXISTS(P) IS (
 (CCALL ACCESS(P,1) AND 37777777777B)=0 => RETURN 1;
 (CCALL ACCESS(P,4) AND 37777777777B)=0 => RETURN 1;
 0);

# ENVOR(NAME,DFLT): THE ENVIRONMENT VARIABLE NAME, OR DFLT IF IT IS NOT SET OR EMPTY #
SUBR ENVOR(NM,DF) IS (
 V ARE LOCAL;
 V_CCALL GETENV(NM);
 V=0 => RETURN DF;
 IMPBYTE(V,0)=0 => RETURN DF;
 V);

# OVERRIDE(DEST,NAME): THE PATH IN DEST (A BUFFER) REPLACED BY THE ENVIRONMENT VARIABLE'S VALUE, IF IT IS SET #
SUBR OVERRIDE(DS,NM) IS (
 V ARE LOCAL;
 V_CCALL GETENV(NM);
 V=0 => RETURN 0;
 IMPBYTE(V,0)=0 => RETURN 0;
 CCALL SNPRINTF(DS,4096,LOC('%s'),V);
 0);

# QS(S): THE C STRING AT S IN SINGLE QUOTES, FOR THE SHELL, IN ONE OF EIGHT BUFFERS #
SUBR QS(S) IS (
 O,P,Q,C ARE LOCAL;
 QR=0 => QR_CCALL CALLOC(8,8192);
 QK_(QK+1)-(8*((QK+1)/8));
 O_QR+(8192*QK);
 P_BYTEP [O]<7,36>; Q_BYTEP [S]<7,36>;
 <+P>_47B;
 QS1: C_<+Q>; C=0 => GO TO QS2;
      C=47B => (<+P>_47B; <+P>_134B; <+P>_47B; <+P>_47B; GO TO QS1);
      <+P>_C; GO TO QS1;
 QS2: <+P>_47B; <+P>_0;
 O);

# RUN THE COMMAND IN CMD: 0 IF IT WORKED #
SUBR RUNCMD(Z) IS ((CCALL SYSTEM(LOC(CMD)) AND 37777777777B)=0 => 0 ELSE 1);

# THE DIRECTORY OF THE RUNNING PROGRAM, IN DIRB; 0-1 IF IT IS NOT FOUND #
SUBR EXEDIR(A0) IS (
 K,S,P,L,E,EB ARE LOCAL;
 EB_LOC(EXEB);
 K_CCALL READLINK(LOC('/proc/self/exe'),EB,4095);
 K>0 => (CCALL MEMSET(EB+K,0,1); GO TO XD3);
 IMPBYTE(A0,0)=0 => RETURN 0-1;
 CCALL STRCHR(A0,57B) NE 0 => (CCALL REALPATH(A0,EB)=0 => RETURN 0-1; GO TO XD3);
 P_CCALL GETENV(LOC('PATH'));                         # FOUND THROUGH THE PATH #
 XD1: P=0 => RETURN 0-1;
      IMPBYTE(P,0)=0 => RETURN 0-1;
      E_CCALL STRCHR(P,72B);
      E NE 0 => L_E-P ELSE L_CCALL STRLEN(P);
      CCALL SNPRINTF(LOC(CMD),4096,LOC('%.*s/%s'),L,P,A0);
      (CCALL ACCESS(LOC(CMD),1) AND 37777777777B)=0 => CCALL REALPATH(LOC(CMD),EB) NE 0 => GO TO XD3;
      E NE 0 => (P_E+1; GO TO XD1);
      RETURN 0-1;
 XD3: S_CCALL STRRCHR(EB,57B);
 S=0 => RETURN 0-1;
 CCALL MEMSET(S,0,1);
 CCALL SNPRINTF(LOC(DIRB),4096,LOC('%s'),EB);
 0);

SUBR DARG(I) IS [AV0+(8*I)];

# THE COMMAND LINE OF THE KERNEL, IN C MEMORY: KA, K WORDS SO FAR #
SUBR KADD(V) IS ([KA+(8*KNN)]_V; KNN_KNN+1; 0);

# THE NAME OF THE OUTPUT: OUT IF -O NAMED ONE, ELSE THE BASEN OF THE FIRST FILE AND EXT #
SUBR OUTNAME(EXT) IS (
 OUTN NE 0 => RETURN OUTN;
 EXT=0 => CCALL SNPRINTF(LOC(OUTB),4096,LOC('%s'),LOC(BASEN)) ELSE CCALL SNPRINTF(LOC(OUTB),4096,LOC('%s%s'),LOC(BASEN),EXT);
 LOC(OUTB));

# THE REMOVAL OF THE TEMPORARY DIRECTORY, AT THE END OF THE PROGRAM (ERROR(0) EXITS) #
SUBR IMPCLEAN(Z) IS (
 CCALL SNPRINTF(LOC(CMD),4096,LOC('rm -rf %s'),QS(LOC(TMP)));
 CCALL SYSTEM(LOC(CMD));
 0);

SUBR IMPD(Z) IS (
 I,A,K,NF,SW,IMG,JIT,STOP,INTER,BL,BB,P ARE LOCAL;
 NA0_CCALL IMPARGC(0); AV0_CCALL IMPARGVP(0);
 P_CCALL STRRCHR(DARG(0),57B);
 P=0 => P_DARG(0) ELSE P_P+1;
 CCALL STRNCMP(P,LOC('imp72stage'),10)=0 => GO TO DRV;
 CCALL STRCMP(P,LOC('imp72'))=0 => GO TO DRV;
 ARGVP_AV0;                                       # ANOTHER NAME (IMP72D): THE KERNEL ALONE #
 CCALL EXIT(IMPK(NA0,AV0));
 DRV: I_1; JIT_0; STOP_170B; INTER_0; OUTN_0; SW_0; IMG_0;
 OPT: I GE NA0 => GO TO OPTX;
      A_DARG(I);
      IMPBYTE(A,0) NE 55B => GO TO OPTX;
      IMPBYTE(A,1)=0 => GO TO OPTX;
      CCALL STRCMP(A,LOC('-i'))=0 => (INTER_1; I_I+1; GO TO OPT);
      CCALL STRCMP(A,LOC('-S'))=0 => (STOP_123B; I_I+1; GO TO OPT);
      CCALL STRCMP(A,LOC('-c'))=0 => (STOP_157B; I_I+1; GO TO OPT);
      I+1<NA0 => (CCALL STRCMP(A,LOC('-o'))=0 => (OUTN_DARG(I+1); I_I+2; GO TO OPT);
                  CCALL STRCMP(A,LOC('-s'))=0 => (SW_DARG(I+1); I_I+2; GO TO OPT);
                  CCALL STRCMP(A,LOC('-I'))=0 => (IMG_DARG(I+1); I_I+2; GO TO OPT));
      CCALL STRCMP(A,LOC('--run'))=0 => (JIT_1; I_I+1; GO TO OPT);
      OUTSTR('imp72stage0: unknown option '); OUTCS(A); OUTCHR(12B); CCALL EXIT(2);
 OPTX: JIT NE 0 => CCALL LLVMHAVE(0)=0 => (OUTSTR('imp72: --run needs the LLVM libraries (this compiler was built without them)'); OUTCHR(12B); CCALL EXIT(2));
 I GE NA0 => INTER=0 => (OUTSTR('usage: imp72 [-S | -c] [--run] [-o OUT] [-s LETTERS] FILE.imp ...'); OUTCHR(12B);
                          OUTSTR('       imp72 -i [-s LETTERS] [FILE.imp ...]     the commands of the original, from the terminal'); OUTCHR(12B);
                          CCALL EXIT(2));
 NF_NA0-I;
 EXEDIR(DARG(0))<0 => (OUTSTR('imp72stage0: cannot find myself'); OUTCHR(12B); CCALL EXIT(1));
 CCALL SNPRINTF(LOC(ROOT),4096,LOC('%s/..'),LOC(DIRB));         # WHERE THE PARTS ARE: THE SOURCE TREE (BUILD/DIR/IMP72D) OR INSTALLED #
 CCALL SNPRINTF(LOC(SYNP),4096,LOC('%s/share/imp72/syntax64.imc'),LOC(ROOT));
 EXISTS(LOC(SYNP)) NE 0 => (CCALL SNPRINTF(LOC(FFIP),4096,LOC('%s/share/imp72/ffi.imc'),LOC(ROOT));
                            CCALL SNPRINTF(LOC(LIBP),4096,LOC('%s/lib/imp72/libimp72.a'),LOC(ROOT));
                            CCALL SNPRINTF(LOC(TMPB),4096,LOC('.')))                  # INSTALLED: WHERE THE COMPILER IS RUN #
   ELSE (CCALL SNPRINTF(LOC(SYNP),4096,LOC('%s/../src/pccir/syntax64.imc'),LOC(ROOT));
         CCALL SNPRINTF(LOC(FFIP),4096,LOC('%s/../lib/ffi.imc'),LOC(ROOT));
         CCALL SNPRINTF(LOC(LIBP),4096,LOC('%s/lib/libimp72.a'),LOC(ROOT));
         CCALL SNPRINTF(LOC(TMPB),4096,LOC('%s/../tmp'),LOC(ROOT)));       # THE TREE'S OWN (GITIGNORED) TMP/ #
 OVERRIDE(LOC(SYNP),LOC('IMP72SYNTAX')); OVERRIDE(LOC(FFIP),LOC('IMP72FFI')); OVERRIDE(LOC(LIBP),LOC('IMP72LIB'));
 INTER=0 => GO TO NOTI;
 KA_CCALL CALLOC((NF+12),8); KNN_0;                  # THE TAPE'S DRIVER: THE SYNTAX, THE FILES NAMED, THEN THE COMMANDS FROM THE TERMINAL #
 QUIET_1;
 KADD(LOC('imp72s0')); KADD(LOC('-i'));
 SW NE 0 => (KADD(LOC('-s')); KADD(SW));
 IMG NE 0 => (KADD(LOC('-I')); KADD(IMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)));
  K_I; KLP: K<NA0 => (KADD(DARG(K)); K_K+1; GO TO KLP);
 ARGVP_KA;
 CCALL EXIT(IMPK(KNN,KA));
 NOTI: CCALL LLVMHAVE(0)=0 => (OUTSTR('imp72: this compiler was built without the LLVM libraries, which it needs'); OUTCHR(12B); CCALL EXIT(2));
 CCALL SNPRINTF(LOC(BASEN),4096,LOC('%s'),DARG(I));
 BL_CCALL STRLEN(LOC(BASEN));
 BB_LOC(BASEN);
 BL>4 => CCALL STRCMP(BB+(BL-4),LOC('.imp'))=0 => CCALL MEMSET(BB+(BL-4),0,1);
 CCALL MKDIR(LOC(TMPB),511);                         # TMPDIR, ELSE TMP/ OF THE TREE OR THE CURRENT DIRECTORY: NEVER /TMP #
 CCALL SNPRINTF(LOC(TMP),4096,LOC('%s/imp72stage0.XXXXXX'),ENVOR(LOC('TMPDIR'),LOC(TMPB)));
 CCALL MKDTEMP(LOC(TMP))=0 => (CCALL PERROR(LOC('mkdtemp')); CCALL EXIT(1));
 CCALL ATEXIT(LOC(IMPCLEAN));
 CCALL SNPRINTF(LOC(IRF2),4096,LOC('%s/p.ir'),LOC(TMP));
 CCALL SNPRINTF(LOC(OFILE),4096,LOC('%s/p.o'),LOC(TMP));
 KA_CCALL CALLOC((NF+12),8); KNN_0;                  # THE KERNEL, IN THIS PROCESS #
 KADD(LOC('imp72s0'));
 SW NE 0 => (KADD(LOC('-s')); KADD(SW); CCALL DUP2(2,1)) ELSE QUIET_1;        # THE DUMPS GO WITH THE MESSAGES #
 KADD(LOC('-c')); KADD(LOC(IRF2));
 IMG NE 0 => (KADD(LOC('-I')); KADD(IMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)));
 K_I; KL2: K<NA0 => (KADD(DARG(K)); K_K+1; GO TO KL2);
 ARGVP_KA;
 IMPK(KNN,KA) NE 0 => CCALL EXIT(1);
 CCALL FFLUSH(0);
 JIT NE 0 => (CCALL LLVMRUN(LOC(IRF2))NE 0 => CCALL EXIT(1);           # LLVM IN THE PROCESS; --RUN COMPILES AND RUNS: THE MAIN PROGRAM IS IMP_MAIN #
                   CCALL FFLUSH(0); CCALL EXIT(0));
 STOP=123B => CCALL EXIT((CCALL LLVMSAVE(LOC(IRF2),OUTNAME(LOC('.ll'))) NE 0 => 1 ELSE 0));
 STOP=157B => CCALL EXIT((CCALL LLVMOBJ(LOC(IRF2),OUTNAME(LOC('.o'))) NE 0 => 1 ELSE 0));
 CCALL LLVMOBJ(LOC(IRF2),LOC(OFILE)) NE 0 => CCALL EXIT(1);
 CCALL SNPRINTF(LOC(CMD),4096,LOC('cc -o %s %s %s'),QS(OUTNAME(0)),QS(LOC(OFILE)),QS(LOC(LIBP)));
 CCALL EXIT(RUNCMD(0)))
%%
