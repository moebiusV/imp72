QUIET,ARGVP,IMPHOOK ARE COMMON;
#THIS IS FILE DRIVER, THE FRONT OF THE COMPILER: THE MAIN PROGRAM OF IMP72, WHICH THE LIBRARY'S MAIN CALLS.  NOT IN THE TAPE, WHICH HAS ONE PROGRAM THAT READS ITS COMMANDS FROM THE TERMINAL (SRC/IMPM.IMP IS THAT,
 IMPK); THIS TURNS A COMMAND LINE LIKE THE C COMPILER'S INTO A COMPILATION AND AN EXECUTABLE:

    IMP72 [-c | -S | -Sir] [-o OUT] [--target=TRIPLE] [-s LETTERS] [-I IMAGE] [--run] FILE.imp ...
    IMP72 -i [-s LETTERS] [FILE.imp ...]        THE COMMANDS OF THE ORIGINAL, FROM THE TERMINAL

 (-c STOP AT THE OBJECT, NAME.O, WHICH IS WHAT A REL FILE IS ON TOPS-10; -S AT THE ASSEMBLY OF THE TARGET, NAME.S; -SIR AT LLVM IR, NAME.LL; NOTHING: A PROGRAM, A.OUT; -o THE OUTPUT; --TARGET=TRIPLE FOR ANOTHER SYSTEM; -s THE SWITCHES; -I AN IMAGE SAVED BY U OR V.)  IT FINDS ITS PARTS RELATIVE TO ITSELF (THE SOURCE TREE, OR PREFIX/BIN, PREFIX/LIB/IMP72 AND PREFIX/SHARE/IMP72),
 RUNS THE KERNEL (IMPK) IN THIS PROCESS TO WRITE THE IR OF THE PROGRAM, AND THEN THE BACK END, LLVM IN THE PROCESS (SRC/LLVM.IMP); THE LINK IS THE SYSTEM'S CC.  CALLED
 BY ANOTHER NAME THAN IMP72 OR IMP72STAGE... (IMP72D IS ONE) IT IS THE KERNEL ALONE: IMPK, WITH THE ARGUMENTS OF STAGE0/IMP72S0.C.  STAGE0/IMP72S0.C IS THE SEED'S DRIVER, WHICH THIS REPLACES FOR IMP72.#

DIRB,ROOT,TMP,TMPB,IRF2,OFILE,BASEN,SYNP,FFIP,LIBP,OUTB,C1P,C2P,C3P,LIBD,DLP,MAD,CBP,CEP,LCP,RTP ARE 520 LONG;
CMD IS 4096 LONG;
EXEB IS 520 LONG;
QR,QK,AV0,NA0,KA,KNN,OUTN,TRI,DLG,DLM,WH,DW,FC0 ARE COMMON;
DSTOP,DSW,DIMG,DJIT,DINTER,DTGT,DSIR,DNSRC,DSRCV,DNOBJI,DOBJI,DOBJL,DNOBJL,DEMP,DKV,DNK,DSYV,DNSY,DSYSROOT,DRUNTIME ARE COMMON;      # THE OPTIONS, THE SOURCES AND THE OBJECTS NAMED, THE OBJECTS TO LINK #
DSELFB,DB1,DB2,DB3,DB4,DB5,DB6 ARE 520 LONG;
DTA,DTV,DTO,DTE ARE 8 LONG;                                              # THE FIELDS OF THE TARGET'S TRIPLE: ARCHITECTURE, VENDOR, SYSTEM, ENVIRONMENT #

IMPD(0);

# EXISTS(P): CAN THE FILE BE RUN OR READ #
SUBR EXISTS(P) IS (
 (CCALL ACCESS(P,1) AND 37777777777B)=0 => RETURN 1;
 (CCALL ACCESS(P,4) AND 37777777777B)=0 => RETURN 1;
 0);

# ENVOR(NAME,DFLT): THE ENVIRONMENT VARIABLE NAME, OR DFLT IF IT IS NOT SET OR EMPTY #
SUBR ENVOR(NM,DF) IS (
 V ARE LOCAL;
 V_CCALL GETENV(NM);
 V=0 => RETURN DF;
 IMPBYTE(V,0)=0 => RETURN DF;
 V);

# OVERRIDE(DEST,NAME): THE PATH IN DEST (A BUFFER) REPLACED BY THE ENVIRONMENT VARIABLE'S VALUE, IF IT IS SET #
SUBR OVERRIDE(DS,NM) IS (
 V ARE LOCAL;
 V_CCALL GETENV(NM);
 V=0 => RETURN 0;
 IMPBYTE(V,0)=0 => RETURN 0;
 CCALL SNPRINTF(DS,4096,LOC('%s'),V);
 0);

# QS(S): THE C STRING AT S IN SINGLE QUOTES, FOR THE SHELL, IN ONE OF EIGHT BUFFERS #
SUBR QS(S) IS (
 O,P,Q,C ARE LOCAL;
 QR=0 => QR_CCALL CALLOC(8,8192);
 QK_(QK+1)-(8*((QK+1)/8));
 O_QR+(8192*QK);
 P_BYTEP [O]<7,36>; Q_BYTEP [S]<7,36>;
 <+P>_47B;
 QS1: C_<+Q>; C=0 => GO TO QS2;
      C=47B => (<+P>_47B; <+P>_134B; <+P>_47B; <+P>_47B; GO TO QS1);
      <+P>_C; GO TO QS1;
 QS2: <+P>_47B; <+P>_0;
 O);

# RUN THE COMMAND IN CMD: 0 IF IT WORKED #
SUBR RUNCMD(Z) IS ((CCALL SYSTEM(LOC(CMD)) AND 37777777777B)=0 => 0 ELSE 1);

# THE DIRECTORY OF THE RUNNING PROGRAM, IN DIRB; 0-1 IF IT IS NOT FOUND #
SUBR EXEDIR(A0) IS (
 K,S,P,L,E,EB ARE LOCAL;
 EB_LOC(EXEB);
 K_CCALL READLINK(LOC('/proc/self/exe'),EB,4095);
 K>0 => (CCALL MEMSET(EB+K,0,1); GO TO XD3);
 IMPBYTE(A0,0)=0 => RETURN 0-1;
 CCALL STRCHR(A0,57B) NE 0 => (CCALL REALPATH(A0,EB)=0 => RETURN 0-1; GO TO XD3);
 P_CCALL GETENV(LOC('PATH'));                         # FOUND THROUGH THE PATH #
 XD1: P=0 => RETURN 0-1;
      IMPBYTE(P,0)=0 => RETURN 0-1;
      E_CCALL STRCHR(P,72B);
      E NE 0 => L_E-P ELSE L_CCALL STRLEN(P);
      CCALL SNPRINTF(LOC(CMD),4096,LOC('%.*s/%s'),L,P,A0);
      (CCALL ACCESS(LOC(CMD),1) AND 37777777777B)=0 => CCALL REALPATH(LOC(CMD),EB) NE 0 => GO TO XD3;
      E NE 0 => (P_E+1; GO TO XD1);
      RETURN 0-1;
 XD3: S_CCALL STRRCHR(EB,57B);
 S=0 => RETURN 0-1;
 CCALL MEMSET(S,0,1);
 CCALL SNPRINTF(LOC(DIRB),4096,LOC('%s'),EB);
 0);

SUBR DARG(I) IS (CCALL IMPARGET(LOC(DW),AV0,I); DW);

# THE COMMAND LINE OF THE KERNEL, IN C MEMORY: KA, K WORDS SO FAR #
SUBR KADD(V) IS (CCALL IMPARGSET(KA,KNN,V); KNN_KNN+1; 0);

# THE NAME OF THE OUTPUT: OUT IF -O NAMED ONE, ELSE THE BASEN OF THE FIRST FILE AND EXT #
SUBR OUTNAME(EXT) IS (
 OUTN NE 0 => RETURN OUTN;
 EXT=0 => RETURN LOC('a.out');                       # AS THE C COMPILER'S #
 CCALL SNPRINTF(LOC(OUTB),4096,LOC('%s%s'),LOC(BASEN),EXT);
 LOC(OUTB));

# THE BASE OF THE FILE NAME P, WITHOUT ITS DIRECTORY AND A .IMP, IN THE BUFFER B (THE C COMPILER WRITES NAME.O IN THE CURRENT DIRECTORY) #
SUBR BASEOF(P,B) IS (
 S,L ARE LOCAL;
 S_CCALL STRRCHR(P,57B); S=0 => S_P ELSE S_S+1;
 CCALL SNPRINTF(B,4096,LOC('%s'),S);
 L_CCALL STRLEN(B);
 L>4 => (CCALL STRCMP(B+(L-4),LOC('.imp'))=0 => CCALL MEMSET(B+(L-4),0,1));
 0);

# THE OBJECTS TO LINK, AFTER THE ARGUMENTS KADD HAS COLLECTED SO FAR #
SUBR ADDOBJS(Z) IS (
 K ARE LOCAL;
 K_0;
 AO1: K<DNOBJL => (CCALL IMPARGET(LOC(DW),DOBJL,K); KADD(DW); K_K+1; GO TO AO1);
 0);

# TRYDIR(D): THE FILES OF THE C LIBRARY (CRT1.O, CRTI.O, CRTN.O) ARE IN THE DIRECTORY D; SETS C1P, C2P, C3P AND LIBD #
SUBR TRYDIR(D) IS (
 CCALL SNPRINTF(LOC(C1P),4096,LOC('%s/crt1.o'),D);
 EXISTS(LOC(C1P))=0 => RETURN 0;
 CCALL SNPRINTF(LOC(C2P),4096,LOC('%s/crti.o'),D);
 CCALL SNPRINTF(LOC(C3P),4096,LOC('%s/crtn.o'),D);
 CCALL SNPRINTF(LOC(LIBD),4096,LOC('%s'),D);
 1);

# TRYDL(P): THE DYNAMIC LINKER P EXISTS; SETS DLP #
SUBR TRYDL(P) IS (
 EXISTS(P)=0 => RETURN 0;
 CCALL SNPRINTF(LOC(DLP),4096,LOC('%s'),P);
 1);

# SETARCH(A): THE ARCHITECTURE A (IMPHOSTARCH) IS ONE WHOSE PLACES OF THE C LIBRARY ARE KNOWN: SETS TRI (THE NAME OF ITS DIRECTORY IN /USR/LIB ON DEBIAN), DLG (THE DYNAMIC
  LINKER OF GLIBC) AND DLM (OF MUSL); 0 IF IT IS NOT KNOWN (THE 32 BIT ONES GET THE DIVISION OF 64 BITS FROM COMPILER-RT, WHICH LIBIMP72.A HOLDS) #
SUBR SETARCH(A) IS (
 CCALL STRCMP(A,LOC('x86_64'))=0 => (TRI_LOC('x86_64-linux-gnu'); DLG_LOC('/lib64/ld-linux-x86-64.so.2'); DLM_LOC('/lib/ld-musl-x86_64.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('i386'))=0 => (TRI_LOC('i386-linux-gnu'); DLG_LOC('/lib/ld-linux.so.2'); DLM_LOC('/lib/ld-musl-i386.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('arm'))=0 => (TRI_LOC('arm-linux-gnueabihf'); DLG_LOC('/lib/ld-linux-armhf.so.3'); DLM_LOC('/lib/ld-musl-armhf.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('aarch64'))=0 => (TRI_LOC('aarch64-linux-gnu'); DLG_LOC('/lib/ld-linux-aarch64.so.1'); DLM_LOC('/lib/ld-musl-aarch64.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('ppc64le'))=0 => (TRI_LOC('powerpc64le-linux-gnu'); DLG_LOC('/lib64/ld64.so.2'); DLM_LOC('/lib/ld-musl-powerpc64le.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('s390x'))=0 => (TRI_LOC('s390x-linux-gnu'); DLG_LOC('/lib/ld64.so.1'); DLM_LOC('/lib/ld-musl-s390x.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('riscv64'))=0 => (TRI_LOC('riscv64-linux-gnu'); DLG_LOC('/lib/ld-linux-riscv64-lp64d.so.1'); DLM_LOC('/lib/ld-musl-riscv64.so.1'); RETURN 1);
 CCALL STRCMP(A,LOC('loongarch64'))=0 => (TRI_LOC('loongarch64-linux-gnu'); DLG_LOC('/lib64/ld-linux-loongarch-lp64d.so.1'); DLM_LOC('/lib/ld-musl-loongarch64.so.1'); RETURN 1);
 0);

# HAVEF(B,D,N): THE FILE N IN THE DIRECTORY D EXISTS; ITS PATH IS IN THE BUFFER B #
SUBR HAVEF(B,D,N) IS (
 CCALL SNPRINTF(B,4096,LOC('%s/%s'),D,N);
 EXISTS(B));

# THE ARGUMENTS OF LD, WHEN IMP72LDSHOW IS SET, ON THE STANDARD ERROR (THE SEED'S DRIVER, STAGE0/IMP72S0.C, DOES THE SAME: A TEST REQUIRES THE TWO TO WRITE THE SAME) #
SUBR SHOWLD(Z) IS (
 K ARE LOCAL;
 CCALL GETENV(LOC('IMP72LDSHOW'))=0 => RETURN 0;
 K_0;
 SH1: K<KNN => (CCALL IMPARGET(LOC(DW),KA,K); OUTCS(DW); OUTCHR(40B); K_K+1; GO TO SH1);
 OUTCHR(12B);
 0);

# RUN LLD WITH THE ARGUMENTS KADD HAS COLLECTED; 0 IF IT LINKED.  THE LIBRARY OF LLD IN THIS PROCESS WHERE THERE IS ONE; A COMPILER BUILT WITHOUT IT RUNS LLD AS A PROGRAM, BY THE NAME THE
  TABLES GIVE IT (LD.LLD, LD64.LLD: OPENBSD'S OWN LINKER IS LLD, AND IT HAS NO LIBRARY OF IT).  NO OTHER LINKER, NEVER CC #
SUBR RUNLD(Z) IS (
 OK ARE LOCAL;
 SHOWLD(0);
 CCALL IMPLDHAVE(0) NE 0 => OK_(CCALL IMPLD(KNN,KA) NE 0 => 1 ELSE 0) ELSE OK_(CCALL IMPRUNLD(KNN,KA) NE 0 => 1 ELSE 0);
 OK);

# THE LINK ON LINUX, WITH THE C LIBRARY OF GLIBC OR MUSL: 9 IF THE ARCHITECTURE IS NOT KNOWN #
SUBR LNKLIN(HA) IS (
 OK ARE LOCAL;
 OK_0;
 CCALL IMPHOSTCRTDIR(LOC(MAD)) NE 0 => CCALL IMPHOSTINTERP(LOC(DLP)) NE 0 => OK_TRYDIR(LOC(MAD));       # WHAT THIS PROGRAM'S OWN LOADER FOUND #
 OK NE 0 => GO TO LL1;
 SETARCH(HA)=0 => RETURN 9;                          # ELSE THE TABLE OF THE ARCHITECTURES (A PROGRAM WITH NO LOADER OF ITS OWN) #
 CCALL SNPRINTF(LOC(MAD),4096,LOC('/usr/lib/%s'),TRI);
 WH_1; OK_TRYDIR(LOC(MAD));
 OK=0 => OK_TRYDIR(LOC('/usr/lib64'));
 OK=0 => (WH_2; OK_TRYDIR(LOC('/usr/lib')));
 OK=0 => RETURN 9;
 WH=1 => (OK_TRYDL(DLG); OK=0 => OK_TRYDL(DLM)) ELSE (OK_TRYDL(DLM); OK=0 => OK_TRYDL(DLG));
 OK=0 => RETURN 9;
 LL1: KA_CCALL CALLOC(40+DNOBJL,8); KNN_0;
 KADD(LOC('ld.lld')); KADD(LOC('-o')); KADD(OUTNAME(0)); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP));
 KADD(LOC(C1P)); KADD(LOC(C2P)); ADDOBJS(0); KADD(LOC(LIBP)); KADD(LOC('-L')); KADD(LOC(LIBD)); KADD(LOC('-lc')); KADD(LOC(C3P));
 RUNLD(0));

# THE LINK ON FREEBSD, NETBSD AND OPENBSD (AMD64 AND AARCH64): THEIR FILES ARE IN /USR/LIB, THE FIRST CRT FILE IS CRT1.O ON FREEBSD AND CRT0.O ON THE OTHERS, OPENBSD HAS
  NO CRTI.O AND CRTN.O AND NO LIBC.SO TO FIND BY -LC (ONLY LIBC.SO.MAJOR.MINOR, WHICH IMPFINDLIB LOOKS FOR); 9 IF THE SYSTEM OR THE ARCHITECTURE IS NOT ONE OF THESE #
SUBR LNKBSD(OS,HA) IS (
 OBSD ARE LOCAL;
 DLG_0; OBSD_0;
 CCALL STRCMP(OS,LOC('freebsd'))=0 => (DLG_LOC('/libexec/ld-elf.so.1'); FC0_LOC('crt1.o'); WH_1);
 CCALL STRCMP(OS,LOC('netbsd'))=0 => (DLG_LOC('/usr/libexec/ld.elf_so'); FC0_LOC('crt0.o'); WH_1);
 CCALL STRCMP(OS,LOC('openbsd'))=0 => (DLG_LOC('/usr/libexec/ld.so'); FC0_LOC('crt0.o'); WH_0; OBSD_1);
 DLG=0 => RETURN 9;
 CCALL STRCMP(HA,LOC('x86_64')) NE 0 => CCALL STRCMP(HA,LOC('aarch64')) NE 0 => RETURN 9;
 HAVEF(LOC(C1P),LOC('/usr/lib'),FC0)=0 => RETURN 9;
 HAVEF(LOC(CBP),LOC('/usr/lib'),LOC('crtbegin.o'))=0 => RETURN 9;
 HAVEF(LOC(CEP),LOC('/usr/lib'),LOC('crtend.o'))=0 => RETURN 9;
 WH NE 0 => (HAVEF(LOC(C2P),LOC('/usr/lib'),LOC('crti.o'))=0 => RETURN 9; HAVEF(LOC(C3P),LOC('/usr/lib'),LOC('crtn.o'))=0 => RETURN 9);
 OBSD NE 0 => CCALL IMPHOSTLIBC(LOC(LCP))=0 => CCALL IMPFINDLIB(LOC(LCP),LOC('/usr/lib'),LOC('libc.so.'))=0 => RETURN 9;
 CCALL IMPHOSTINTERP(LOC(DLP))=0 => CCALL SNPRINTF(LOC(DLP),4096,LOC('%s'),DLG);                  # THE LOADER THIS PROGRAM HAS, ELSE THE SYSTEM'S #
 HAVEF(LOC(RTP),LOC('/usr/lib'),LOC('libcompiler_rt.a'));
 KA_CCALL CALLOC(48+DNOBJL,8); KNN_0;
 KADD(LOC('ld.lld')); KADD(LOC('--eh-frame-hdr')); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP)); KADD(LOC('-o')); KADD(OUTNAME(0));
 KADD(LOC(C1P)); WH NE 0 => KADD(LOC(C2P)); KADD(LOC(CBP)); ADDOBJS(0); KADD(LOC(LIBP));
 OBSD NE 0 => KADD(LOC(LCP)) ELSE (KADD(LOC('-L')); KADD(LOC('/usr/lib')); KADD(LOC('-lc')));
 EXISTS(LOC(RTP)) NE 0 => KADD(LOC(RTP));
 KADD(LOC(CEP)); WH NE 0 => KADD(LOC(C3P));
 RUNLD(0));

# THE LINK ON MACOS (ARM64 AND X86-64): LLD'S MACH-O DRIVER, WITH THE SDK (SDKROOT, ELSE THE COMMAND LINE TOOLS, ELSE XCODE) AND -LSYSTEM; 9 IF THERE IS NO SDK #
SUBR LNKMAC(HA) IS (
 SDK,AR,MV ARE LOCAL;
 AR_0;
 CCALL STRCMP(HA,LOC('aarch64'))=0 => (AR_LOC('arm64'); MV_LOC('11.0'));
 CCALL STRCMP(HA,LOC('x86_64'))=0 => (AR_LOC('x86_64'); MV_LOC('10.13'));
 AR=0 => RETURN 9;
 SDK_ENVOR(LOC('SDKROOT'),0);
 SDK=0 => (CCALL SNPRINTF(LOC(LIBD),4096,LOC('/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk')); EXISTS(LOC(LIBD)) NE 0 => SDK_LOC(LIBD));
 SDK=0 => (CCALL SNPRINTF(LOC(LIBD),4096,LOC('/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk'));
           EXISTS(LOC(LIBD)) NE 0 => SDK_LOC(LIBD));
 SDK=0 => RETURN 9;
 KA_CCALL CALLOC(40+DNOBJL,8); KNN_0;
 KADD(LOC('ld64.lld')); KADD(LOC('-arch')); KADD(AR); KADD(LOC('-platform_version')); KADD(LOC('macos')); KADD(MV); KADD(MV);
 KADD(LOC('-syslibroot')); KADD(SDK); KADD(LOC('-o')); KADD(OUTNAME(0)); ADDOBJS(0); KADD(LOC(LIBP)); KADD(LOC('-lSystem'));
 RUNLD(0));

# THE LINK OF OFILE WITH THE RUNTIME LIBRARY INTO THE EXECUTABLE: LLD IN THIS PROCESS (STAGE0/IMPLD.CPP), OR LLD AS A PROGRAM WHERE THERE IS NO LLD LIBRARY, FOR THE SYSTEM AND THE ARCHITECTURE THIS IS; NEVER CC.
  RETURNS 0 IF IT WORKED #
SUBR LNK(Z) IS (
 HA,OS,OK ARE LOCAL;
 LLVMNATIVE(0)=0 => RETURN LNKCROSS(0);                    # ANOTHER SYSTEM #
 OS_CCALL IMPHOSTOS(0); HA_CCALL IMPHOSTARCH(0);
 CCALL STRCMP(OS,LOC('linux'))=0 => OK_LNKLIN(HA)
 ELSE (CCALL STRCMP(OS,LOC('darwin'))=0 => OK_LNKMAC(HA) ELSE OK_LNKBSD(OS,HA));
 OK=9 => (OUTSTR('imp72: no way to link on this system and architecture: '); OUTCS(OS); OUTCHR(40B); OUTCS(HA); OUTCHR(12B); RETURN 1);
 OK);

# THE ARCHITECTURE OF A TRIPLE AS SETARCH NAMES IT (X86_64, I386, ARM, AARCH64, PPC64LE, S390X, RISCV64, LOONGARCH64), OR 0 #
SUBR CROSSARCH(A) IS (
 (CCALL STRCMP(A,LOC('x86_64')) AND 4294967295)=0 => RETURN LOC('x86_64');
 ((STARTS(A,LOC('aarch64'))=1) OR (STARTS(A,LOC('arm64'))=1)) => RETURN LOC('aarch64');
 ((IMPBYTE(A,0)=151B) AND (IMPBYTE(A,2)=70B) AND (IMPBYTE(A,3)=66B) AND (IMPBYTE(A,4)=0)) => RETURN LOC('i386');          # I386 TO I686 #
 STARTS(A,LOC('arm'))=1 => RETURN LOC('arm');
 ((STARTS(A,LOC('powerpc64le'))=1) OR (STARTS(A,LOC('ppc64le'))=1)) => RETURN LOC('ppc64le');
 STARTS(A,LOC('s390x'))=1 => RETURN LOC('s390x');
 STARTS(A,LOC('riscv64'))=1 => RETURN LOC('riscv64');
 STARTS(A,LOC('loongarch64'))=1 => RETURN LOC('loongarch64');
 0);

# WHAT A LINK FOR ANOTHER SYSTEM NEEDS AND DOES NOT HAVE, AND HOW TO SAY WHERE IT IS.  WHY IS 0 FOR NO SYSROOT NAMED, 1 FOR NO START FILES (CRT1.O) IN IT, 2 FOR NO LIBIMP72.A #
SUBR CROSSMSG(WHY) IS (
 OUTSTR('imp72: cannot link for '); OUTCS(DTGT); OUTSTR(': the files of that system that the link needs are not here.'); OUTCHR(12B);
 OUTSTR('  It needs, from that system: the start files of its C library (crt1.o, crti.o, crtn.o), the C library (-lc), and libimp72.a, the runtime of imp72, built for it.'); OUTCHR(12B);
 OUTSTR('  (The dynamic linker is only named, as '); OUTCS(LOC(DLP)); OUTSTR('.)'); OUTCHR(12B);
 WHY=1 => (OUTSTR('  Looked for crt1.o in '); OUTCS(DSYSROOT); OUTSTR('/usr/lib/'); OUTCS(TRI); OUTSTR(', /usr/lib, /usr/lib64, /lib/'); OUTCS(TRI); OUTSTR(' and /lib, and did not find it.'); OUTCHR(12B));
 WHY=2 => (OUTSTR('  The runtime library libimp72.a for it was not given, nor found next to the C library ('); OUTCS(LOC(LIBD)); OUTSTR(').'); OUTCHR(12B));
 OUTSTR('  Say where they are:'); OUTCHR(12B);
 OUTSTR('    --sysroot=DIR    the root of that system (DIR/usr/lib/'); OUTCS(TRI); OUTSTR('/crt1.o, ...), or set IMP72SYSROOT'); OUTCHR(12B);
 OUTSTR('    --runtime=FILE   its libimp72.a (or put it with the C library), or set IMP72RUNTIME'); OUTCHR(12B);
 OUTSTR('  Or compile with -c (an object file) and link on that system.'); OUTCHR(12B);
 1);

# THE LINK FOR ANOTHER SYSTEM (LINUX ONLY SO FAR): LLD LINKS FOR ANY TARGET, SO WHAT IT NEEDS IS THE FILES OF THE TARGET, FROM --SYSROOT AND --RUNTIME.  RETURNS 0 IF IT LINKED #
SUBR LNKCROSS(Z) IS (
 AR,TT,OK ARE LOCAL;
 TT_LLVMTRIPLE(0);
 DTA[0]_DTV[0]_DTO[0]_DTE[0]_0;
 CCALL SSCANF(TT,LOC('%[^-]-%[^-]-%[^-]-%s'),LOC(DTA),LOC(DTV),LOC(DTO),LOC(DTE));
 STARTS(LOC(DTO),LOC('linux'))=0 => (OUTSTR('imp72: cannot link for '); OUTCS(DTGT); OUTSTR(': linking for another system is done for Linux targets so far; use -c and link there'); OUTCHR(12B); RETURN 1);
 AR_CROSSARCH(LOC(DTA));
 AR=0 => (OUTSTR('imp72: cannot link for '); OUTCS(DTGT); OUTSTR(': the architecture is not one whose C library files are known'); OUTCHR(12B); RETURN 1);
 SETARCH(AR)=0 => RETURN 1;
 STARTS(LOC(DTE),LOC('musl'))=1 => CCALL SNPRINTF(LOC(DLP),4096,LOC('%s'),DLM) ELSE CCALL SNPRINTF(LOC(DLP),4096,LOC('%s'),DLG);
 CCALL SNPRINTF(LOC(LIBD),4096,LOC('(no sysroot)'));
 DSYSROOT=0 => RETURN CROSSMSG(0);
 CCALL SNPRINTF(LOC(MAD),4096,LOC('%s/usr/lib/%s'),DSYSROOT,TRI); OK_TRYDIR(LOC(MAD));
 OK=0 => (CCALL SNPRINTF(LOC(MAD),4096,LOC('%s/usr/lib'),DSYSROOT); OK_TRYDIR(LOC(MAD)));
 OK=0 => (CCALL SNPRINTF(LOC(MAD),4096,LOC('%s/usr/lib64'),DSYSROOT); OK_TRYDIR(LOC(MAD)));
 OK=0 => (CCALL SNPRINTF(LOC(MAD),4096,LOC('%s/lib/%s'),DSYSROOT,TRI); OK_TRYDIR(LOC(MAD)));
 OK=0 => (CCALL SNPRINTF(LOC(MAD),4096,LOC('%s/lib'),DSYSROOT); OK_TRYDIR(LOC(MAD)));
 OK=0 => RETURN CROSSMSG(1);
 DRUNTIME NE 0 => CCALL SNPRINTF(LOC(LCP),4096,LOC('%s'),DRUNTIME) ELSE CCALL SNPRINTF(LOC(LCP),4096,LOC('%s/libimp72.a'),LOC(LIBD));
 EXISTS(LOC(LCP))=0 => RETURN CROSSMSG(2);
 CCALL SNPRINTF(LOC(CBP),4096,LOC('--sysroot=%s'),DSYSROOT);
 KA_CCALL CALLOC(48+DNOBJL,8); KNN_0;
 KADD(LOC('ld.lld')); KADD(LOC(CBP)); KADD(LOC('-o')); KADD(OUTNAME(0)); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP));
 KADD(LOC(C1P)); KADD(LOC(C2P)); ADDOBJS(0); KADD(LOC(LCP)); KADD(LOC('-L')); KADD(LOC(LIBD)); KADD(LOC('-lc')); KADD(LOC(C3P));
 RUNLD(0));

# THE REMOVAL OF THE TEMPORARY DIRECTORY, AT THE END OF THE PROGRAM (ERROR(0) EXITS) #
SUBR IMPCLEAN(Z) IS (
 CCALL SNPRINTF(LOC(CMD),4096,LOC('rm -rf %s'),QS(LOC(TMP)));
 CCALL SYSTEM(LOC(CMD));
 0);

# WHETHER THE C STRING A BEGINS WITH THE C STRING P #
SUBR STARTS(A,P) IS ((CCALL STRNCMP(A,P,CCALL STRLEN(P)) AND 4294967295)=0 => 1 ELSE 0);

# WHETHER THE FILE NAME A ENDS IN THE C STRING E #
SUBR ENDS(A,E) IS (
 LA,LE ARE LOCAL;
 LA_CCALL STRLEN(A); LE_CCALL STRLEN(E);
 LA<LE => RETURN 0;
 (CCALL STRCMP(A+(LA-LE),E) AND 4294967295)=0 => 1 ELSE 0);

SUBR DRVHELP(Z) IS (
 CCALL PUTS(LOC('usage: imp72 [options] file.imp ...'));
 CCALL PUTS(LOC('  -c                 compile to an object file, file.o, and do not link'));
 CCALL PUTS(LOC('  -S                 compile to the assembly of the target, file.s'));
 CCALL PUTS(LOC('  -Sir               compile to LLVM IR text, file.ll'));
 CCALL PUTS(LOC('  -o FILE            name the output (a.out for a program)'));
 CCALL PUTS(LOC('  --target=TRIPLE    for another system (with -c, -S, -Sir), say aarch64-linux-gnu or riscv64-unknown-linux-musl'));
CCALL PUTS(LOC('  --sysroot=DIR      with --target and no -c: the root of that system, for its C library (DIR/usr/lib/crt1.o ...); or IMP72SYSROOT'));
 CCALL PUTS(LOC('  --runtime=FILE     with --target and no -c: the libimp72.a built for that system; or IMP72RUNTIME'));
 CCALL PUTS(LOC('  -s LETTERS         the switches of the original compiler (A listing, T tree, ...)'));
 CCALL PUTS(LOC('  -I IMAGE           start from the compiler saved by /U or /V'));
 CCALL PUTS(LOC('  -i                 the commands of the original compiler, from the terminal: OBJ,LIST_FILE/switches'));
 CCALL PUTS(LOC('  --run              compile and run in this process'));
 CCALL PUTS(LOC('  --version, --help'));
 0);

# THE OPTIONS AND THE FILES OF THE COMMAND LINE, IN ANY ORDER AS THE C COMPILER'S: A NAME THAT ENDS IN .O, .A OR .SO IS TO BE LINKED, ANY OTHER IS A SOURCE.  A MISTAKE ENDS THE PROGRAM (2) #
SUBR OPTS(Z) IS (
 I,A,V ARE LOCAL;
 DSRCV_CCALL CALLOC(NA0+1,8); DOBJI_CCALL CALLOC(NA0+1,8); DKV_CCALL CALLOC(NA0+1,8); DSYV_CCALL CALLOC(NA0+1,8); DNSRC_0; DNOBJI_0; DNK_0; DNSY_0;
 DSTOP_170B; DJIT_0; DINTER_0; OUTN_0; DSW_0; DIMG_0; DTGT_0; DSIR_0; DEMP_0; DSYSROOT_ENVOR(LOC('IMP72SYSROOT'),0); DRUNTIME_ENVOR(LOC('IMP72RUNTIME'),0);
 I_1;
 OP1: I GE NA0 => RETURN 0;
      A_DARG(I); I_I+1;
      ((IMPBYTE(A,0) NE 55B) OR (IMPBYTE(A,1)=0)) => GO TO OPF;                   # A FILE (AND - ALONE IS NOT AN OPTION) #
      CCALL STRCMP(A,LOC('-i'))=0 => (DINTER_1; GO TO OP1);
      CCALL STRCMP(A,LOC('-c'))=0 => (DSTOP_157B; GO TO OP1);
      CCALL STRCMP(A,LOC('-S'))=0 => (DSTOP_123B; DSIR_0; GO TO OP1);
      CCALL STRCMP(A,LOC('-Sir'))=0 => (DSTOP_123B; DSIR_1; GO TO OP1);
      CCALL STRCMP(A,LOC('--run'))=0 => (DJIT_1; GO TO OP1);
      CCALL STRCMP(A,LOC('--version'))=0 => (CCALL PUTS(LOC('imp72 0.9.0')); CCALL EXIT(0));
      ((CCALL STRCMP(A,LOC('--help'))=0) OR (CCALL STRCMP(A,LOC('-h'))=0)) => (DRVHELP(0); CCALL EXIT(0));
      STARTS(A,LOC('--target='))=1 => (DTGT_A+9; GO TO OP1);
      STARTS(A,LOC('--sysroot='))=1 => (DSYSROOT_A+10; GO TO OP1);
      STARTS(A,LOC('--runtime='))=1 => (DRUNTIME_A+10; GO TO OP1);
      ((CCALL STRCMP(A,LOC('--sysroot'))=0) OR (CCALL STRCMP(A,LOC('--runtime'))=0)) => (
          I GE NA0 => GO TO OPM;
          CCALL STRCMP(A,LOC('--sysroot'))=0 => DSYSROOT_DARG(I) ELSE DRUNTIME_DARG(I);
          I_I+1; GO TO OP1);
      ((CCALL STRCMP(A,LOC('--target'))=0) OR (CCALL STRCMP(A,LOC('-target'))=0)) => (
          I GE NA0 => GO TO OPM;
          DTGT_DARG(I); I_I+1; GO TO OP1);
      STARTS(A,LOC('-o'))=1 => (IMPBYTE(A,2) NE 0 => (OUTN_A+2; GO TO OP1);              # -OFILE #
                                I GE NA0 => GO TO OPM;
                                OUTN_DARG(I); I_I+1; GO TO OP1);                       # -O FILE #
      ((CCALL STRCMP(A,LOC('-s'))=0) OR (CCALL STRCMP(A,LOC('-I'))=0)) => (
          I GE NA0 => GO TO OPM;
          CCALL STRCMP(A,LOC('-s'))=0 => DSW_DARG(I) ELSE DIMG_DARG(I);
          I_I+1; GO TO OP1);
      OUTSTR('imp72: unknown option '); OUTCS(A); OUTCHR(12B); CCALL EXIT(2);
 OPM: OUTSTR('imp72: missing argument to '); OUTCS(A); OUTCHR(12B); CCALL EXIT(2);
 OPF: ((ENDS(A,LOC('.o'))=1) OR (ENDS(A,LOC('.a'))=1) OR (ENDS(A,LOC('.so'))=1)) => (CCALL IMPARGSET(DOBJI,DNOBJI,A); DNOBJI_DNOBJI+1; GO TO OP1);
      CCALL IMPARGSET(DKV,DNK,A); DNK_DNK+1;                                                  # SYNTAX AND SOURCES, IN THE ORDER GIVEN: THE KERNEL READS THEM SO #
      ENDS(A,LOC('.imc'))=1 => (CCALL IMPARGSET(DSYV,DNSY,A); DNSY_DNSY+1; GO TO OP1);         # A FILE OF SYNTAX AND DECLARATIONS (THE TAPE'S /C) #
      CCALL IMPARGSET(DSRCV,DNSRC,A); DNSRC_DNSRC+1;
      GO TO OP1);

# WHERE THE PARTS ARE: THE SOURCE TREE (BUILD/DIR/IMP72D) OR INSTALLED (DIRB, SYNP, FFIP, LIBP, TMPB) #
SUBR SETPATHS(Z) IS (
 EXEDIR(DARG(0))<0 => (OUTSTR('imp72: cannot find myself'); OUTCHR(12B); CCALL EXIT(1));
 CCALL SNPRINTF(LOC(ROOT),4096,LOC('%s/..'),LOC(DIRB));
 CCALL SNPRINTF(LOC(SYNP),4096,LOC('%s/share/imp72/syntax64.imc'),LOC(ROOT));
 EXISTS(LOC(SYNP)) NE 0 => (CCALL SNPRINTF(LOC(FFIP),4096,LOC('%s/share/imp72/ffi.imc'),LOC(ROOT));
                            CCALL SNPRINTF(LOC(LIBP),4096,LOC('%s/lib/imp72/libimp72.a'),LOC(ROOT));
                            CCALL SNPRINTF(LOC(TMPB),4096,LOC('.')))                  # INSTALLED: WHERE THE COMPILER IS RUN #
   ELSE (CCALL SNPRINTF(LOC(SYNP),4096,LOC('%s/../src/pccir/syntax64.imc'),LOC(ROOT));
         CCALL SNPRINTF(LOC(FFIP),4096,LOC('%s/../lib/ffi.imc'),LOC(ROOT));
         CCALL SNPRINTF(LOC(LIBP),4096,LOC('%s/lib/libimp72.a'),LOC(ROOT));
         CCALL SNPRINTF(LOC(TMPB),4096,LOC('%s/../tmp'),LOC(ROOT)));       # THE TREE'S OWN (GITIGNORED) TMP/ #
 OVERRIDE(LOC(SYNP),LOC('IMP72SYNTAX')); OVERRIDE(LOC(FFIP),LOC('IMP72FFI')); OVERRIDE(LOC(LIBP),LOC('IMP72LIB'));
 0);

# THE TEMPORARY DIRECTORY (TMPDIR, ELSE TMP/ OF THE TREE OR THE CURRENT DIRECTORY: NEVER /TMP), REMOVED AT THE END OF THE PROGRAM #
SUBR MKTMP(Z) IS (
 CCALL MKDIR(LOC(TMPB),511);
 CCALL SNPRINTF(LOC(TMP),4096,LOC('%s/imp72stage0.XXXXXX'),ENVOR(LOC('TMPDIR'),LOC(TMPB)));
 CCALL MKDTEMP(LOC(TMP))=0 => (CCALL PERROR(LOC('mkdtemp')); CCALL EXIT(1));
 CCALL ATEXIT(LOC(IMPCLEAN));
 0);

# THE COMMANDS OF THE ORIGINAL, FROM THE TERMINAL: THE KERNEL ALONE, WITH THE SYNTAX, THE FILES NAMED, THEN THE TERMINAL.  NEVER RETURNS #
SUBR RUNINTER(Z) IS (
 K ARE LOCAL;
 KA_CCALL CALLOC((DNK+12),8); KNN_0;
 QUIET_1; IMPHOOK_1;                                 # EACH COMPILATION WRITES ITS OBJECT, THE REL FILE #
 KADD(LOC('imp72s0')); KADD(LOC('-i'));
 DSW NE 0 => (KADD(LOC('-s')); KADD(DSW));
 DIMG NE 0 => (KADD(LOC('-I')); KADD(DIMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)));
 K_0; RI1: K<DNK => (CCALL IMPARGET(LOC(DW),DKV,K); KADD(DW); K_K+1; GO TO RI1);
 ARGVP_KA;
 CCALL EXIT(IMPK(KNN,KA)));

# ONE SOURCE, COMPILED IN THIS PROCESS: THE KERNEL WRITES THE IR, THE BACK END MAKES WHAT -c, -S, -SIR OR NOTHING (A PROGRAM) ASKS FOR.  NEVER RETURNS #
SUBR ONEFILE(SRC) IS (
 R,K ARE LOCAL;
 BASEOF(SRC,LOC(BASEN));
 MKTMP(0);
 CCALL SNPRINTF(LOC(IRF2),4096,LOC('%s/p.ir'),LOC(TMP));
 CCALL SNPRINTF(LOC(OFILE),4096,LOC('%s/p.o'),LOC(TMP));
 KA_CCALL CALLOC(DNK+16,8); KNN_0;                           # THE KERNEL, IN THIS PROCESS #
 KADD(LOC('imp72s0'));
 DSW NE 0 => (KADD(LOC('-s')); KADD(DSW); CCALL DUP2(2,1)) ELSE QUIET_1;        # THE DUMPS GO WITH THE MESSAGES #
 KADD(LOC('-c')); KADD(LOC(IRF2));
 DIMG NE 0 => (KADD(LOC('-I')); KADD(DIMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)));
 K_0; OK1: K<DNK => (CCALL IMPARGET(LOC(DW),DKV,K); KADD(DW); K_K+1; GO TO OK1);
 ARGVP_KA;
 IMPK(KNN,KA) NE 0 => CCALL EXIT(1);
 CCALL FFLUSH(0);
 DJIT NE 0 => (LLVMRUN(LOC(IRF2))NE 0 => CCALL EXIT(1);           # LLVM IN THE PROCESS; --RUN COMPILES AND RUNS: THE MAIN PROGRAM IS IMPMAIN #
                   CCALL FFLUSH(0); CCALL EXIT(0));
 DSTOP=123B => (DSIR NE 0 => R_LLVMSAVE(LOC(IRF2),OUTNAME(LOC('.ll'))) ELSE R_LLVMASM(LOC(IRF2),OUTNAME(LOC('.s')));
               CCALL EXIT((R NE 0 => 1 ELSE 0)));
 DSTOP=157B => CCALL EXIT((LLVMOBJ(LOC(IRF2),OUTNAME(LOC('.o'))) NE 0 => 1 ELSE 0));
 LLVMOBJ(LOC(IRF2),LOC(OFILE)) NE 0 => CCALL EXIT(1);
 DOBJL_CCALL CALLOC(DNOBJI+2,8); CCALL IMPARGSET(DOBJL,0,LOC(OFILE)); DNOBJL_1;
 K_0;
 OF1: K<DNOBJI => (CCALL IMPARGET(LOC(DW),DOBJI,K); CCALL IMPARGSET(DOBJL,DNOBJL,DW); DNOBJL_DNOBJL+1; K_K+1; GO TO OF1);
 CCALL EXIT(LNK(0)));

# MORE THAN ONE SOURCE: EACH IS COMPILED BY A PROGRAM OF ITS OWN, AS THE C COMPILER DOES, TO NAME.O (-c), NAME.S (-S), NAME.LL (-SIR) OR AN OBJECT IN THE TEMPORARY DIRECTORY TO BE LINKED WITH THE OTHERS.
  NEVER RETURNS #
SUBR MULTI(Z) IS (
 K,S,BAD,FL ARE LOCAL;
 MKTMP(0);
 DOBJL_CCALL CALLOC(DNSRC+DNOBJI+2,8); DNOBJL_0; BAD_0;
 CCALL SNPRINTF(LOC(DB6),4096,LOC('%s'),LOC(DEMP));
 K_0; MS1: K<DNSY => (CCALL IMPARGET(LOC(DW),DSYV,K); CCALL STRCAT(LOC(DB6),LOC(' ')); CCALL STRCAT(LOC(DB6),QS(DW)); K_K+1; GO TO MS1);

 DSTOP=157B => FL_LOC('-c');
 DSTOP=170B => FL_LOC('-c');
 DSTOP=123B => (DSIR NE 0 => FL_LOC('-Sir') ELSE FL_LOC('-S'));
 K_0;
 ML1: K<DNSRC => (
     CCALL IMPARGET(LOC(DW),DSRCV,K); S_DW;
     DSTOP=170B => (CCALL SNPRINTF(LOC(DB1),4096,LOC('-o %s/o%d.o'),LOC(TMP),K); CCALL SNPRINTF(LOC(DB3),4096,LOC('%s/o%d.o'),LOC(TMP),K))
        ELSE CCALL SNPRINTF(LOC(DB1),4096,LOC('%s'),LOC(DEMP));
     DSW NE 0 => CCALL SNPRINTF(LOC(DB2),4096,LOC('-s %s'),QS(DSW)) ELSE CCALL SNPRINTF(LOC(DB2),4096,LOC('%s'),LOC(DEMP));
     DIMG NE 0 => CCALL SNPRINTF(LOC(DB4),4096,LOC('-I %s'),QS(DIMG)) ELSE CCALL SNPRINTF(LOC(DB4),4096,LOC('%s'),LOC(DEMP));
     DTGT NE 0 => CCALL SNPRINTF(LOC(DB5),4096,LOC('--target=%s'),QS(DTGT)) ELSE CCALL SNPRINTF(LOC(DB5),4096,LOC('%s'),LOC(DEMP));
     CCALL SNPRINTF(LOC(CMD),32768,LOC('%s %s %s %s %s %s %s %s'),QS(LOC(DSELFB)),FL,LOC(DB1),LOC(DB2),LOC(DB4),LOC(DB5),LOC(DB6),QS(S));
     RUNCMD(0) NE 0 => BAD_1;
     DSTOP=170B => (CCALL IMPARGSET(DOBJL,DNOBJL,CCALL STRDUP(LOC(DB3))); DNOBJL_DNOBJL+1);        # A COPY: DB3 IS WRITTEN AGAIN FOR THE NEXT FILE #
     K_K+1; GO TO ML1);
 BAD NE 0 => CCALL EXIT(1);
 DSTOP NE 170B => CCALL EXIT(0);
 K_0; ML2: K<DNOBJI => (CCALL IMPARGET(LOC(DW),DOBJI,K); CCALL IMPARGSET(DOBJL,DNOBJL,DW); DNOBJL_DNOBJL+1; K_K+1; GO TO ML2);
 CCALL EXIT(LNK(0)));

SUBR IMPD(Z) IS (
 P ARE LOCAL;
 NA0_CCALL IMPARGC(0); AV0_CCALL IMPARGVP(0);
 P_CCALL STRRCHR(DARG(0),57B);
 P=0 => P_DARG(0) ELSE P_P+1;
 CCALL STRNCMP(P,LOC('imp72stage'),10)=0 => GO TO DRV;
 CCALL STRCMP(P,LOC('imp72'))=0 => GO TO DRV;
 ARGVP_AV0;                                       # ANOTHER NAME (IMP72D): THE KERNEL ALONE #
 CCALL EXIT(IMPK(NA0,AV0));
 DRV: OPTS(0);
 ((DINTER=0) AND (DNSRC=0) AND (DNOBJI=0)) => (DRVHELP(0); CCALL EXIT(2));
 ((OUTN NE 0) AND (DSTOP NE 170B) AND (DNSRC>1)) => (OUTSTR('imp72: cannot name the output with more than one source to compile'); OUTCHR(12B); CCALL EXIT(1));
 SETPATHS(0);
 CCALL SNPRINTF(LOC(DSELFB),4096,LOC('%s/%s'),LOC(DIRB),P);        # THIS PROGRAM, FOR THE ONES IT STARTS #
 DTGT NE 0 => (LLVMTARGET(DTGT);
              DJIT NE 0 => (OUTSTR('imp72: --run is for this machine, not for '); OUTCS(DTGT); OUTCHR(12B); CCALL EXIT(1)));
 DINTER NE 0 => RUNINTER(0);
 DNSRC=0 => (DOBJL_DOBJI; DNOBJL_DNOBJI; CCALL EXIT(LNK(0)));       # ONLY OBJECTS: LINK THEM #
 DNSRC>1 => MULTI(0);
 CCALL IMPARGET(LOC(DW),DSRCV,0);
 ONEFILE(DW))
%%
