TWOSEG;
CO,NCO,ANCO ARE COMMON;
#THIS IS FILE CODE2, HOLDING OVERFLOW FROM FILE CODE, THE TRANSLATION OF DECUS/CODE2.IMC FOR THE 64 BIT PORT, WHICH COMPILES TO PCC IR
 (DOCS/PORTING/IR-MACHINE.MD) WHERE THE ORIGINAL COMPILED TO THE PDP-10.  THE CODE IS A CHAIN OF RECORDS IN FREE ARRAY CO; THE CODE OF
 A STACK ENTRY IS THE PAIR (FIRST,LAST) IN ITS THIRD WORD (LEFT AND RIGHT 32 BIT HALVES; 0: NO CODE).  ADDCODE OF THE ORIGINAL IS
 ADDREC: IT ADDS ONE RECORD.  THE ROUTINES OF THE TABLE OF SEMANTIC ROUTINES ARE REGISTERED BY STAGE0/IRSEM.C (THE TABLE HOLDS C
 FUNCTION POINTERS).  OPCODE, THE ASSEMBLER'S TABLE OF MNEMONICS, IS NOT TRANSLATED.#

# SETNEXT(R,N): MAKE RECORD N THE ONE AFTER RECORD R #
SUBR SETNEXT(R,N) IS FREES(CO+R,HW(N,HR(FREE(CO+R))));

# ADDREC(S,KIND,OP,RD,V0,V1,X): ADD A RECORD TO THE CODE OF STACK ENTRY S #
SUBR ADDREC(S,KIND,OP,RD,V0,V1,X) IS (
 Z,R ARE LOCAL;
 CO=0 => (NCO_1; FRELOT(CO,'CODE',200,0); FINCSET(CO,200));
 ANCO=-1 => ANCO_0 ELSE ANCO_1;
 FLEN(CO) LE (NCO+RECW) => FADDEX(CO,(NCO+RECW)+3);
 R_NCO; NCO_NCO+RECW;
 FREES(CO+R,HW(0,(KIND OR (OP LS 8))));
 FREES((CO+R)+1,RD); FREES((CO+R)+2,V0); FREES((CO+R)+3,V1); FREES((CO+R)+4,X);
 Z_FREE(S+2);
 Z=0 => FREES(S+2,HW(R,R))
  ELSE (SETNEXT(HR(Z),R); FREES(S+2,HW(HL(Z),R)));
 S);

# HOOK(D,A,B): HOOKS CODE FOR A TO CODE FOR B, PUTS CODE IN D.  VALUE OF D IS SET TO VALUE OF B #
SUBR HOOK(D,A,B) IS (
 J,K ARE LOCAL;
 FREES(D,FREE(B)); FREES(D+1,FREE(B+1));
 J_FREE(B+2);
 J=0 => (FREES(D+2,FREE(A+2)); RETURN D);
 K_FREE(A+2);
 K=0 => (FREES(D+2,J); RETURN D);
 SETNEXT(HR(K),HL(J));
 FREES(D+2,HW(HL(K),HR(J)));
 D);

SUBR ANYCODE(NIL) IS ANCO;

# DEWFUN(S,I,J): SPECIAL FUNCTION I.  2 ENDS A CALL (THE VALUE IS IN REGISTER J); THE OTHERS (SAVING AND RESTORING THE PDP-10'S REGISTERS, DECLARING
  THEM) DO NOTHING IN A MACHINE WITH AS MANY REGISTERS AS WE LIKE, BUT STILL COUNT AS CODE FOR ANYCODE #
SUBR DEWFUN(S,I,J) IS (
 ANCO=0 => ANCO_-1;
 I=2 => RETURN ADDREC(S,KOP,OCALLE,J,0,0,0);
 ANCO=-1 => ANCO_0 ELSE ANCO_1;
 S);

# CONOP(S,T,I,V,W): AN OPERATION ON ONE OR TWO CONSTANTS S AND T, BY THE INDEX I (THE LOW 18 BITS) AND, IF THE REST OF I IS 1 OR 2, A CONDITIONAL:
  THE VALUE OF THE COMPARISON CHOOSES THE ENTRY V (OR W) FOR THE WHOLE RESULT.  THE ARITHMETIC IS THAT OF 64 BIT WORDS; AN OPERATION ON REAL CONSTANTS
  IS NOT FOLDED (ONLY THE NEGATION, WHICH FLIPS THE SIGN) #
SUBR CONOP(S,T,I,V,W) IS (
 CO1,CO2,II,C,J,N ARE LOCAL;
 CO1_FREE(S+1); T NE 0 => CO2_FREE(T+1);
 II_R18(I);
 (FREE(S) AND 300B)=200B => (II=0 => (CO1_CO1 XOR (1 LS 63); GO TO CXC)
                              ELSE (ERROR(1,'OPERATION ON A REAL CONSTANT. '); GO TO CXC));
 GO TO (C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16,C17,C18,C19) II;
 C0: CO1_0-CO1; GO TO CX;
 C1: CO1_CO1+CO2; GO TO CX;
 C2: CO1_CO1-CO2; GO TO CX;
 C3: CO1_CO1*CO2; GO TO CX;
 C4: CO2=0 => CO1_0 ELSE CO1_CO1/CO2; GO TO CX;
 C5: N_CO2; GO TO SHL;
 C6: CO1_NOT CO1; GO TO CX;
 C7: CO1_CO1 AND CO2; GO TO CX;
 C8: CO1_CO1 OR CO2; GO TO CX;
 C9: CO1_(CO1<CO2); GO TO CX;
 C10:CO1_(CO1=CO2); GO TO CX;
 C11:CO1_(CO1 LE CO2); GO TO CX;
 C12: GO TO CX;
 C13:CO1_(CO1 GE CO2); GO TO CX;
 C14:CO1_(CO1 NE CO2); GO TO CX;
 C15:CO1_(CO1>CO2); GO TO CX;
 C16: N_CO2; CO2<0 => (N_0-CO2; N GE 63 => N_63; CO1_CO1 ARS N; GO TO CX); GO TO SHL;
 C17: N_CO2 AND 63; N=0 => GO TO CX;
      CO1_(CO1 LS N) OR (CO1 RS (64-N)); GO TO CX;
 C18: CO1_CO1 XOR CO2; GO TO CX;
 C19: CO1_CO1 EQV CO2; GO TO CX;
 # A LOGICAL SHIFT BY N: LEFT IF POSITIVE, 0 IF 64 OR MORE PLACES #
 SHL: N GE 64 => (CO1_0; GO TO CX);
      N GE 0 => (CO1_CO1 LS N; GO TO CX);
      N LE -64 => (CO1_0; GO TO CX);
      CO1_CO1 RS (0-N); GO TO CX;
 CX: (C_(I RS 9) RS 9)=>(                      # SPECIAL DEALIE FOR CONDITIONALS #
                   C=1=>(CO1=0=>GO TO CXC;
                         FREES(S+J,FREE(V+J)) FOR J FROM 2;
                         GO TO CXT);
                   C=2=>(CO1=0=>(FREES(S+J,FREE(W+J)) FOR J FROM 2)
                            ELSE(FREES(S+J,FREE(V+J)) FOR J FROM 2);
                         GO TO CXT));
 CXC: FREES(S+1,CO1);
 J_FREE(S); FREES(S,R18(J));
 T=>HOOK(S,T,S);
 CXT: S);

# JOP(C): THE JUMP OPERATION FOR THE RELATION WITH CODE C OF THE RELATIONAL OPERATORS (1 <, 2 =, 3 LE, 5 GE, 6 NE, 7 >); ON REALS THE
  ONE 10 MORE.  CJUMP(OP,P,R,S): JUMP TO THE TAG S IF P RELATES TO R BY OP #
SUBR JOP(C) IS (
 C=1 => RETURN 42;
 C=2 => RETURN 41;
 C=3 => RETURN 43;
 C=5 => RETURN 44;
 C=6 => RETURN 46;
 45);

SUBR CJUMP(OP,P,R,S) IS (
 O,F ARE LOCAL;
 O_OP; F_0;
 (FREE(P) AND 300B)=200B => F_1;
 (FREE(R) AND 300B)=200B => F_1;
 F NE 0 => (O_OP+OFJ; FLOAT(P); FLOAT(R));
 FETCH(P);
 ADDREC(R,KOP,O,REGOF(P),FREE(R),FREE(R+1),L18(FREE(S)));
 HOOK(P,P,R));

# MOVE B THROUGH N TO A: A BLOCK MOVE, NOT YET IN THE IR PATH #
SUBR MOVEBLK(B,N,A) IS (
 ERROR(1,'MOVE ... THROUGH IS NOT YET IN THE IR PATH.');
 A);

# FREEZE(S): THE ORIGINAL FLAGS THE CODE SO THAT THE ASSEMBLER DOES NOT DELETE INSTRUCTIONS FROM IT; PCC DOES ITS OWN ARITHMETIC, SO NOTHING #
SUBR FREEZE(S) IS S;

# ONEWORD(S): 1 IF THE CODE OF STACK ENTRY S IS EXACTLY ONE OPERATION #
SUBR ONEWORD(S) IS (
 J ARE LOCAL;
 J_FREE(S+2);
 J=0 => RETURN 0;
 HL(J)=HR(J) => (RKIND(HL(J))=KOP => RETURN 1);
 0);

# COPPY(S): A COPY OF THE ENTRY S, WITH A COPY OF ITS CODE #
SUBR COPPY(S) IS (
 W ARE LOCAL;
 W_ENSTACK(0);
 FREES(W,FREE(S)); FREES(W+1,FREE(S+1));
 FREES(W+2,FREE(S+2));
 FREE(W+2)=>COPYCO(W); W);

# SUBRCALL(T): BEGIN A CALL OF THE FUNCTION NAMED AT STACK ENTRY T; ITS VALUE WILL BE IN A NEW REGISTER #
SUBR SUBRCALL(T) IS (
 TT,DD,J ARE LOCAL;
 SUBPR0(0);
 TT_FREE(T); DD_L18(TT);
 DPROP('COM',DD) NE 2 => DPROPS('COM',DD,1);
 ADDREC(T,KOP,OCALLB,0,FREE(T),FREE(T+1),0);
 J_AREG1(140B,0);
 FREES(T,SX36(2 OR (TT AND (NOT 77B))));
 FREES(T+1,SX36((J LS 9) LS 9));
 T);

# RETURN(S): RETURN THE VALUE OF S FROM THE CURRENT SUBROUTINE #
SUBR RETURN(S) IS (
 DEWOP(OLOAD,0-AREG1(100B,0),S);
 ADDREC(S,KOP,ORET,REGOF(S),0,0,0);
 S);

# FLOAT(S): INSURE THAT S IS REAL #
SUBR FLOAT(S) IS (
 SF,J ARE LOCAL;
 SF_FREE(S);
 (SF AND 300B) NE 200B => (
     (SF AND 77B)=4 => (FREES(S+1,CCALL DIRI2D(FREE(S+1)));          # A CONSTANT: THE DOUBLE'S BITS #
                        FREES(S,SX36((204B OR (SF AND 777000B))));
                        RETURN S);
     FETCH(S);
     J_REGOF(S);
     ADDREC(S,KOP,OFLOAT,J,FREE(S),FREE(S+1),0);
     FREES(S,SX36((202B OR (SF AND (NOT 377B))))));
 S);

# FIX(S): INSURE THAT S IS AN INTEGER #
SUBR FIX(S) IS (
 SF,J ARE LOCAL;
 SF_FREE(S);
 (SF AND 300B)=0 => (FREES(S,SX36(SF OR 100B)); RETURN S);       # NO TYPE (A PARAMETER): AN INTEGER #
 (SF AND 300B) NE 100B => (
     (SF AND 77B)=4 => (FREES(S+1,CCALL DIRD2I(FREE(S+1)));
                        FREES(S,SX36((104B OR (SF AND 777000B))));
                        RETURN S);
     FETCH(S);
     J_REGOF(S);
     ADDREC(S,KOP,OFIX,J,FREE(S),FREE(S+1),0);
     FREES(S,SX36((102B OR (SF AND (NOT 377B))))));
 S);

# DATAST(B): CONSTANT WORDS FOR A DATA STATEMENT #
SUBR DATAST(B) IS (
 A,I,J,K ARE LOCAL;
 A_ENSTACK(IRDIR0(0));
 FREES(A,SX36((4 OR (FREE(A) AND (NOT 77B)))));
 DS1: GETLIST(B) => (
        FREE(B+2) => (ERROR(1,'NON-CONSTANT EXPRESSION IN DATA STATEMENT.'); GO TO DS1);
        I_FREE(B);
        (I AND 77B)=4 => L18(I)=0 => (ADDREC(A,KWORD,0,0,0,FREE(B+1),0); GO TO DS1);
        I_L18(I);
        (J_CONVC(I)) NE 0 => (J<0 => (ADDREC(A,KWORD,0,0,0,CONST,0); GO TO DS1);
                              I_FREE(J);
                              ADDREC(A,KWORD,0,0,0,FREE(J+K),0) FOR K IN 1,1,I;
                              GO TO DS1);
        # A NAME: ITS ADDRESS #
        HOOK(A,A,DEWOP(OADDR,AREG1(1,15B),B));
        GO TO DS1);
 A);

# SUBRPAR(S,PP): ADD THE ARGUMENT PP TO THE CALL S #
SUBR SUBRPAR(S,PP) IS (
 P ARE LOCAL;
 P_SUBARG(S,PP);
 ADDREC(S,KOP,OARG,0,FREE(P),FREE(P+1),0);
 HOOK(S,P,S));

# PRINPAR(N,A,B,C,D): A PRINT LIST ITEM; THE ENTRY IT MAKES HAS THE CODE THAT COMPUTES THE ITEM IN WORD 2 AND, IN WORD 1, THE RECORDS THAT
  ENTER IT IN THE PRINT LIST.  N IS 0 AN EXPRESSION, 1 OCT, 2 IGR, 3 STG, 5 / (NEW LINE), 6 FILE, 7 IMAGE MODE, 8 DEVICE, 9 TAB, 10 FILL, 11 FLT #
SUBR PRINPAR(N,AA,B,C,D) IS (
 A,T,I,J,KK,SH,SA,SV,K ARE LOCAL;
 PPS IS 3 LONG;
 A_AA;
 T_ENSTACK(0);
 N=5 => (ADDREC(T,KOP,OPITEM,0,0,0,N); GO TO PP9);
 N=11 => (
    (FREE(A) AND 77B)=4 => (FREE(B) AND 77B)=4 => (
        FREES(A+1,((FREE(A+1) AND HMASK) OR (FREE(B+1) LS HSH)));
        FREES(A,R18(FREE(A)));
        GO TO PP1);
    I_REGOF(DEWOP(OLOAD,AREG1(1,13B),A));
    J_REGOF(DEWOP(OLOAD,AREG1(1,13B),B));
    HOOK(B,B,DEWOP(OLSH,J,STACKUP(HSH)));
    HOOK(A,A,B);
    DEWOP(OIOR,I,A);
    PP1: 0);
 A_SUBARG(T,A);
 ADDREC(T,KOP,OPITEM,0,FREE(A),FREE(A+1),N);
 N NE 6 => GO TO PP9;
 PPS[0]_B; PPS[1]_C; PPS[2]_D;
 (PPS[K]=0 => (ADDREC(T,KOP,OPITEM,0,0,0,N); GO TO PP10);
  SA_SUBARG(T,PPS[K]);
  (FREE(SA) AND 77B)=4 => (
     K>0 => (                                # PROJECT AND PROGRAMMER: A DECIMAL CONSTANT READ AS OCTAL #
        CONVC(L18(FREE(SA))); J_CONST;
        SH_0; SV_0;
        PP11: J NE 0 => (KK_J/10;
                         (KK_J-(10*KK))>7 => ERROR(1,'NON-OCTAL PJ OR PN **');
                         SV_SV OR (KK_J-(10*KK)) LS SH; SH_SH+3;
                         J_J/10; GO TO PP11);
        FREES(SA,SX36(4 OR ((STCON(SV) LS 9) LS 9)));
        FREES(SA+1,0)));
  ADDREC(T,KOP,OPITEM,0,FREE(SA),FREE(SA+1),N);
  PP10: PPS[K]=0 => 0 ELSE HOOK(A,SA,A)) FOR K IN 0,1,2;
 PP9: FREES(A+1,FREE(T+2));
 FREES(A,4);                                 # SO THE MATCHER DOES NOT READ WORD 2 #
 A);

# PRINCAL(A,B): ADD THE PRINT LIST ITEM B TO THE PRINT CALL A #
SUBR PRINCAL(A,B) IS (
 C ARE LOCAL;
 C_ENSTACK(0); FREES(C+2,FREE(B+1));
 HOOK(B,B,HOOK(C,A,C));
 FREES(B,FREE(A)); FREES(B+1,FREE(A+1));
 SUBPR0(1);
 B);

SUBR OJUMPOP(I) IS (
 VAL ARE LOCAL;
 VAL_7 AND (I+4);
 I GE 8 => (1 AND I) NE 0 => VAL_((2 AND (I+2)) OR (5 AND I));
 VAL);

# ADDR(S): THE ORIGINAL MAKES S OF TYPE 20B, SO THAT WHAT WAS THE VALUE WINDS UP IN THE ADDRESS FIELD OF THE INSTRUCTION (AN IMMEDIATE OPERAND, A SHIFT
  BY A CONSTANT).  AN OPERAND OF THE IR MACHINE CAN BE A CONSTANT, SO NOTHING #
SUBR ADDR(S) IS S %%
