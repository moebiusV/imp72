TWOSEG;
CO,NCO,ANCO ARE COMMON;
#THIS IS FILE CODE3, HOLDING OVERFLOW FROM CODE2, THE TRANSLATION OF DECUS/CODE3.IMC FOR THE 64 BIT PORT (SEE CODE2).  PCODE, THE LISTING OF THE
 CODE, IS NOT TRANSLATED; BYTEP IS NOT YET.#

SUBR SUBCALL(A,B) IS (
 A_SUBRCALL(NAME(A));
 WHILE GETLIST(B) DO A_SUBRPAR(A,B);
 DEWFUN(A,2,REGOF(A));
 SUBPR0(1);
 A);

# SUBSCRIPT(S,T): THE SUBSCRIPTED VARIABLE S[T] (S=0: [T], THE WORD AT ADDRESS T) #
SUBR SUBSCRIPT(S,T) IS (
 TTY,STY,TE,SC,I,SEE ARE LOCAL;
 TTY_FREE(T) AND 77B;
 TTY=20B => FREE(T+1) LT 0 => (DEWOP(OLOAD,AREG1(1,15B),T); TTY_2);
 S=0 => (TTY NE 2 => TTY NE 4 => (FREE(T+1) LT 0 => (DEWOP(OLOAD,AREG1(1,15B),T);
                                                       TTY_20B;
                                                       FREES(T,SX36((20B OR (FREE(T) AND 77B)))))
                                  ELSE FREES(T+1,SX36(FREE(T+1) OR (1 LS 35))));
         TE_20B OR (FREE(T) AND (NOT 77B));
         TTY=4 => (TE_10B OR (TE AND 777700B);
                   FREES(T+1,R18(FREE(T+1))));
         FREES(T,SX36(TE)); RETURN T);
 TTY NE 2 => TTY NE 4 => (DEWOP(OLOAD,AREG1(1,15B),T); TTY_2);
 STY_FREE(S) AND 77B;
 STY=20B => FREE(S+1) LT 0 => (DEWOP(OADDR,AREG1(1,15B),S); STY_20B;
                               FREES(S,SX36((20B OR (FREE(S) AND 700B)))));
 STY=2 => (ERROR(1,'SUBSCRIPTED REGISTER - IGNORED. '); RETURN S);
 STY=4 => (SEE_FREE(S) AND (NOT 77B);
           L18(SEE)=0 => (ERROR(2,'CALCULATED CONSTANT IS SUBSCRIPTED. ');
                          I_STCON(FREE(S+1));
                          SEE_(((I LS 9) LS 9) OR R18(SEE)));
           FREES(S,SX36((SEE OR 10B))); FREES(S+1,0));
 TTY=2 => (STY NE 20B => (FREES(S,SX36((20B OR (FREE(S) AND (NOT 77B)))));
                          FREES(S+1,SX36(FREE(S+1) OR ((REGOF(T) LS 9) LS 9))))
           ELSE ADDREC(S,KOP,OADD,REGOF(S),FREE(T),FREE(T+1),0));
 TTY=4 => (SC_R18(R18(FREE(S+1))+FREE(T+1));
           FREES(S+1,SX36((SC OR (FREE(S+1) AND (NOT 777777B))))));
 HOOK(S,T,S));

SUBR BYTEP(A,S,P,FLAG) IS (
 ERROR(1,'BYTE FIELDS ARE NOT YET IN THE IR PATH.');
 A) %%
