TWOSEG;
# THIS IS FILE IMPM, DRIVER PROGRAM AND A FEW UTILITY SUBRS #

FINAM IS COMMON,6 LONG;

# IMPK(NIL) IS THE DRIVER PROGRAM: IT READS THE SYNTAX WITH RSYN, THEN COMPILES THE FILES NAMED ON THE COMMAND LINE WITH THE SYNTAX SO FAR, AND RETURNS 0 IF ALL WENT WELL.  (THE ORIGINAL IS THE
  MAIN PROGRAM AND ASKS FOR ITS COMMANDS; A FATAL ERROR ENDS THE COMPILATION AS IT DOES THERE: ERROR CALLS IMPFATAL, WHICH RETURNS FROM IMPK WITH 1, WHERE THE ORIGINAL GOES TO FIN.)

    IMP72 [-S LETTERS] [-O LISTING] [-C IRFILE] [-T TARGET] SYNTAX [FILE ...]

  -S SETS THE SWITCHES, EACH LETTER OF LETTERS THE ONE OF THAT NAME (THE ORIGINAL'S /A /B ...); -O SAYS WHERE THE LISTING AND THE PRINT-OUTS GO, -C WHERE THE PCC IR GOES (- IS THE STANDARD
  OUTPUT), -T FOR WHAT MACHINE (AMD64, THE DEFAULT, I386, AARCH64, ARM).  THE SYNTAX IS THE FIRST FILE: THE PART OF IT UP TO THE FIRST % IS READ BY RSYN, AND THE REST OF IT, AND THE
  OTHER FILES, ARE COMPILED. #
SUBR IMPK(NIL) IS (
 NARGS_CCALL IMPARGC(0); ARGI_1; FINAM[5]_0;
 OPT: ARGI<NARGS => (ARGP_CCALL IMPARGV(ARGI);
        ARGC_CCALL IMPBYTE(ARGP,0);
        ARGC=55B => (ARGC_CCALL IMPBYTE(ARGP,1);
                     ARGC=0 => GO TO OPTX;
                     ARGI+1<NARGS => (ARGJ_CCALL IMPARGV(ARGI+1);
                                      CCALL IMPSTREQ(ARGP,LOC('-s')) => (SETSW(ARGJ); ARGI_ARGI+2; GO TO OPT);
                                      CCALL IMPSTREQ(ARGP,LOC('-o')) => (CCALL IMPOPENLIST(ARGJ)<0 => RETURN 1;
                                                                          ARGI_ARGI+2; GO TO OPT);
                                      CCALL IMPSTREQ(ARGP,LOC('-c')) => (CCALL IMPOPENIR(ARGJ)<0 => RETURN 1;
                                                                          ARGI_ARGI+2; GO TO OPT);
                                      CCALL IMPSTREQ(ARGP,LOC('-T')) => (CCALL IMPSETTARGET(ARGJ)=0 =>
                                                                            (OUTSTR('imp72: no target '); MSG(ARGJ); RETURN 2);
                                                                          ARGI_ARGI+2; GO TO OPT));
                     RETURN USAGE(0)));
 OPTX: ARGI GE NARGS => RETURN USAGE(0);
 NFILES_NARGS-ARGI;
 CCALL CSEMS(0); IMPSEM(0); CODEI(0);
 ARGP_CCALL IMPARGV(ARGI);
 LEXIN(ARGP)=0 => GO TO GOTCHA;
 MSG('CAN''T FIND FILE: '); MSG(ARGP); RETURN 1;
 GOTCHA: RSYN(0);
 CCALL IMPISQUIET(0)=0 => MSG('SYNTAX BOOTSTRAPPED');
 ARGJ_0;
 NEXTF: ARGJ<NFILES => (ARGP_CCALL IMPARGV(ARGI+ARGJ);
        ARGJ>0 => (LEXIN(ARGP) NE 0 => (OUTSTR('? FILE NOT FOUND: '); MSG(ARGP); RETURN 1));
        STINIT(0); COTREE(0); PARSE('#PG'); CKDONE(0);
        FINAM[5] AND 100000000B => PSTATS(0);
        FINAM[5] AND 40000000B => GPRIN1(0);
        FINAM[5] AND 2000000B => TPRIN1(0);
        FINAM[5] AND 1000000B => SEMPER(0);
        FINAM[5] AND 400B => DSTATS(0);
        ARGJ_ARGJ+1; GO TO NEXTF);
 FIN: CCALL IMPCLOSELIST(0);
 (FINAM[5] AND 4000B) NE 0 => RETURN 1;
 0);

# USAGE: THE ARGUMENTS ARE NOT OF THE FORM ABOVE #
SUBR USAGE(NIL) IS (OUTSTR('USAGE: IMP72 [-S LETTERS] [-O FILE] [-C IRFILE] [-T TARGET] SYNTAX [FILE ...]'); OUTCHR(12B); 2);

# SETSW(S): THE SWITCHES NAMED BY THE LETTERS OF THE STRING S #
SUBR SETSW(S) IS (
 SWK_0;
 SW1: SWC_CCALL IMPBYTE(S,SWK);
 SWC=0 => RETURN 0;
 (SWC GE 141B => SWC LE 172B => SWC_SWC-40B);
 SWC GE 101B => SWC LE 132B => FINAM[5]_FINAM[5] OR (1 LS (SWC-101B));
 SWK_SWK+1; GO TO SW1);

SUBR HELP(NIL) IS (
 MSG('TYPE FILENAME.EXT TO COMPILE FROM THAT FILE TO FILENAME.REL.');
 MSG(' DEFAULT EXTENSION IS EITHER NULL OR IMP.');
 MSG(' FILE NAME MAY BE FOLLOWED BY /A/B/C... WHERE A,B,C ARE');
 MSG('       SINGLE LETTER SWITCHES AS FOLLOWS:');
 MSG('A = PRODUCE AN ASSEMBLY LISTING');
 MSG('C = CONTINUE BY COMPILING ANOTHER FILE AFTER THIS ONE');
 MSG('H = TYPE THIS LIST OF SWITCHES');
 MSG('L = PRODUCE A SOURCE LISTING');
 MSG('Y = LIST SOURCE ON TTY');
 MSG('NULL FILENAME MEANS KEEP GOING ON CURRENT FILE');
 0);

SUBR OUTSTR(M) IS CCALL IMPOUTSTR(LOC(M));

SUBR OUTCHR(M) IS CCALL IMPOUTCHR(M);

SUBR MSG(M) IS (OUTSTR(M); OUTCHR(12B));

SUBR ERROR(N,E) IS (
 N LE 1=>FINAM[5]_FINAM[5] OR 4000B;
 E=>(CCALL IMPNOISY(N,LOC(E))=>(
     N<2=>(OUTSTR('** ERROR - ');
           CCALL IMPHASLIST(0)=>PRINT STG 0,'** ERROR - ');
     N=2=>(OUTSTR('** ADVISORY - ');
           CCALL IMPHASLIST(0)=>PRINT STG 0,'** ADVISORY - ');
     MSG(E); CCALL IMPHASLIST(0)=>PRINT STG 0,E,/));
 ERR_-1; N=0 => (FINAM[5]_FINAM[5] AND NOT 4; CCALL IMPFATAL(0)))%%
