TWOSEG;
# THIS IS FILE IMPM, DRIVER PROGRAM AND A FEW UTILITY SUBRS #

FINAM IS COMMON,6 LONG;
HITHERE IS 4 LONG;
IMGP IS 1 LONG;                                    # THE IMAGE TO START FROM (-I), OR 0 #
FREL,FLST,GREL,GLST ARE 2 LONG;
BF IS 18 LONG;                                    # 17 WORDS OF THE ORIGINAL, OF 8 CHARACTERS: 136 COLUMNS, AND A WORD FOR THE % AND THE END #
RPGM IS 4 LONG;
NMB IS 6 LONG;
LISTING,QUIET,IRF,ARGVP,AW,IMPHOOK,IMPLB ARE COMMON;       # IMPHOOK: THE DRIVER WANTS THE OBJECT (THE REL FILE) OF EACH COMPILATION; IMPLB: WHETHER /L WAS ASKED, TO TELL AN ERROR FROM IT #
IRNM IS 520 LONG;                                 # THE FILE THE IR IS WRITTEN TO #
BANB IS 64 LONG;                                  # THE BANNER #
BDT IS 2 LONG;                         # THE LISTING (A FILE) OR 0, AND THE DRIVER'S WISH FOR NO CHATTER: THE C THAT REMAINS SETS AND READS THEM (SRC/SHARED.TXT) #
CB IS 2 LONG;

# IMPK(NIL) IS THE DRIVER PROGRAM: IT READS THE SYNTAX WITH RSYN, THEN COMPILES THE FILES NAMED ON THE COMMAND LINE WITH THE SYNTAX SO FAR, AND RETURNS 0 IF ALL WENT WELL.  (THE ORIGINAL IS THE
  MAIN PROGRAM AND ASKS FOR ITS COMMANDS; A FATAL ERROR ENDS THE COMPILATION AS IT DOES THERE: ERROR CALLS IMPFATAL, WHICH RETURNS FROM IMPK WITH 1, WHERE THE ORIGINAL GOES TO FIN.)

    IMP72 [-I] [-S LETTERS] [-O LISTING] [-C IRFILE] [-T TARGET] SYNTAX [FILE ...]

  -S SETS THE SWITCHES, EACH LETTER OF LETTERS THE ONE OF THAT NAME (THE ORIGINAL'S /A /B ...); -O SAYS WHERE THE LISTING AND THE PRINT-OUTS GO, -C WHERE THE PCC IR GOES (- IS THE STANDARD
  OUTPUT), -T FOR WHAT MACHINE (AMD64, THE DEFAULT, I386, AARCH64, ARM).  THE SYNTAX IS THE FIRST FILE: THE PART OF IT UP TO THE FIRST % IS READ BY RSYN, AND THE REST OF IT, AND THE
  OTHER FILES, ARE COMPILED.  WITH -I, THEN, THE COMMANDS OF THE ORIGINAL ARE READ FROM THE TERMINAL (SEE GETTY AND READCMD IN LEX): A PROMPT *, AND
  REL,LST_FILE.EXT/A/B... FOR EACH, WITH THE SWITCHES AS FOR -S; AFTER ONE COMPILATION IT ENDS UNLESS THE SWITCH C IS GIVEN, AS THE ORIGINAL DOES. #
SUBR IMPK(NARGS,AV) IS (
 ARGVP:=AV; CCALL impsetdefout(LOC(LISTOUT)); ARGI:=1; FINAM[5]:=0;
 OPT: ARGI<NARGS => (ARGP:=IMPARGV(ARGI);
        ARGC:=IMPBYTE(ARGP,0);
        ARGC=55B => (ARGC:=IMPBYTE(ARGP,1);
                     ARGC=0 => GO TO OPTX;
                     ARGC=151B => (IMPBYTE(ARGP,2)=0 => (INTER:=1; ARGI:=ARGI+1; GO TO OPT));
                     ARGI+1<NARGS => (ARGJ:=IMPARGV(ARGI+1);
                                      CCALL strcmp(ARGP,LOC('-s'))=0 => (SETSW(ARGJ); ARGI:=ARGI+2; GO TO OPT);
                                      CCALL strcmp(ARGP,LOC('-I'))=0 => (IMGP:=ARGJ; ARGI:=ARGI+2; GO TO OPT);
                                      CCALL strcmp(ARGP,LOC('-o'))=0 => (IMPOPENLIST(ARGJ)<0 => RETURN 1;
                                                                          ARGI:=ARGI+2; GO TO OPT);
                                      CCALL strcmp(ARGP,LOC('-c'))=0 => (IMPOPENIR(ARGJ)<0 => RETURN 1;
                                                                          ARGI:=ARGI+2; GO TO OPT);
                                      CCALL strcmp(ARGP,LOC('-T'))=0 => (IXSETTARGET(ARGJ)=0 =>
                                                                            (OUTSTR('imp72: no target '); OUTCS(ARGJ); OUTCHR(12B); RETURN 2);
                                                                          ARGI:=ARGI+2; GO TO OPT));
                     RETURN USAGE(0)));
 OPTX: ARGI GE NARGS => IMGP=0 => RETURN USAGE(0);
 NFILES:=NARGS-ARGI;
 IMPSEM(0); CODEI(0);
 IMGP NE 0 => (RSYNI(0); STINIT(0); COTREE(0);     # THE ROUTINES THAT THE MODULES ENTER WHEN THEY BEGIN, AS A RUN THAT READS THE SYNTAX DOES #
               IMPIMGLOAD(IMGP)=0 => RETURN 1;
               GO TO GOTCHA);
 ARGP:=IMPARGV(ARGI);
 LEXIN(ARGP)=0 => GO TO GOTCHA;
 OUTSTR('CAN''T FIND FILE: '); OUTCS(ARGP); OUTCHR(12B); RETURN 1;
 GOTCHA: IMGP=0 => RSYN(0);
 QUIET=0 => (IMGP=0 => MSG('SYNTAX BOOTSTRAPPED') ELSE MSG('IMAGE LOADED'));
 ARGJ:=0;
 NEXTF: ARGJ<NFILES => (ARGP:=IMPARGV(ARGI+ARGJ);
        ARGJ>0 => GO TO OPN;
        IMGP NE 0 => GO TO OPN;
        GO TO CMP;
        OPN: LEXIN(ARGP) NE 0 => (OUTSTR('? FILE NOT FOUND: '); OUTCS(ARGP); OUTCHR(12B); RETURN 1);
        CMP:         COMPIL(0);
        ARGJ:=ARGJ+1; GO TO NEXTF);
 INTER=0 => GO TO FIN;
 AGAINSAM: IMPSVNUM(0)=0 => DATE(BDT,CALLI(14B,0)) ELSE DATE(BDT,IMPSVDAT(0));                   # THE BANNER: THE VERSION AND THE DATE, OF THE LAST SAVE IF THE COMPILER WAS SAVED, WITH (A) THE FIRST TIME, (B) THE NEXT, AS THE ORIGINAL'S #
          IMPSVNUM(0)=0 => CCALL snprintf(LOC(BANB),512,LOC('IMP72 0.9.0     %s'),LOC(BDT))
                 ELSE CCALL snprintf(LOC(BANB),512,LOC('IMP72 0.9.0(%c)  %s'),64+(IMPSVNUM(0)-26*((IMPSVNUM(0)-1)/26)),LOC(BDT));
          MSG(BANB);
          GETTY(BF)<0 => GO TO FIN;
          CHR0(BF)=CODE('?') => (MSG('TYPE /H FOR HELP.'); GO TO AGAINSAM);
          READCMD(BF,FINAM,GREL,GLST,DEV,RPGM);
          FINAM[5] AND 200B => (HELP(0); GO TO AGAINSAM);
          FINAM[5] AND 10B => (HELPD(0); GO TO AGAINSAM);
          GREL => (FREL:=GREL; FREL[1]:=GREL[1]);
          GLST => (FLST:=GLST; FLST[1]:=GLST[1]);
          FINAM[5] AND 14000000B => (GREL=0 => (MSG('NAME THE IMAGE: NAME_/U'); GO TO AGAINSAM);
                                      MKNAME(FREL,'img');
                                      SV0:=IMPSVNUM(0); SV1:=IMPSVDAT(0); IMPSVSET(SV0+1,CALLI(14B,0));
                                      IMPIMGSAVE(LOC(NMB))=0 => (IMPSVSET(SV0,SV1); GO TO AGAINSAM);
                                      OUTSTR('** COMPILER SAVED ON '); OUTCS(LOC(NMB)); OUTSTR(' **'); OUTCHR(12B); GO TO FIN);       # (THE ORIGINAL SAYS ** SSAVE COMPILER ** AND EXITS TO THE MONITOR: THE SAVING IS DONE HERE) #
          FINAM=0 => FINAM[5]=0 => RPGM => (RUNPGM(RPGM); RPGM:=0; GO TO AGAINSAM);
          FINAM => (GOTFILE:=0;
                    OPENIN() NE 0 => (MSG('? FILE NOT FOUND'); GO TO AGAINSAM);
                    GOTFILE:=1);
          GOTFILE=0 => GO TO AGAINSAM;
          IMPCLOSELIST(0);
          FINAM[5] AND 4000B => (MKNAME(FLST,'lst'); IMPOPENLIST(LOC(NMB))<0 => GO TO AGAINSAM);
          MKNAME(FREL,'ir'); IMPOPENIR(LOC(NMB))<0 => GO TO AGAINSAM;
          IMPLB:=FINAM[5] AND 4000B;
          COMPIL(0);
          IMPOBJ(0);
          FINAM[5] AND 4 => GO TO AGAINSAM;
          IMPCLOSELIST(0);
          RETURN 0;
 FIN: IMPCLOSELIST(0);
 (FINAM[5] AND 4000B) NE 0 => RETURN 1;
 0);

# USAGE: THE ARGUMENTS ARE NOT OF THE FORM ABOVE #
SUBR USAGE(NIL) IS (OUTSTR('USAGE: IMP72 [-I] [-S LETTERS] [-O FILE] [-C IRFILE] [-T TARGET] [-I IMAGE] SYNTAX [FILE ...]'); OUTCHR(12B); 2);

# SETSW(S): THE SWITCHES NAMED BY THE LETTERS OF THE STRING S #
SUBR SETSW(S) IS (
 SWK:=0;
 SW1: SWC:=IMPBYTE(S,SWK);
 SWC=0 => RETURN 0;
 (SWC GE 141B => SWC LE 172B => SWC:=SWC-40B);
 SWC GE 101B => SWC LE 132B => FINAM[5]:=FINAM[5] OR (1 LS (SWC-101B));
 SWK:=SWK+1; GO TO SW1);

SUBR HELP(NIL) IS (
 MSG('TYPE FILENAME.EXT TO COMPILE FROM THAT FILE TO FILENAME.o.');
 MSG(' DEFAULT EXTENSION IS EITHER NULL, imp OR imc.');
 MSG(' FILE NAME MAY BE FOLLOWED BY /A/B/C... WHERE A,B,C ARE');
 MSG('       SINGLE LETTER SWITCHES AS FOLLOWS:');
 MSG('A = PRODUCE AN ASSEMBLY LISTING');
 MSG('C = CONTINUE BY COMPILING ANOTHER FILE AFTER THIS ONE');
 MSG('H = TYPE THIS LIST OF SWITCHES');
 MSG('L = PRODUCE A SOURCE LISTING');
 MSG('R = GENERATE A RE-ENTRANT SEGMENT OF CODE (ALWAYS SO HERE).');
 MSG('U = EXIT TO SAVE COMPILER: NAME_/U SAVES IT AS NAME.img (RUN IT WITH -I NAME.img).');
 MSG('V = THE SAME (THE IMAGE HAS NO CODE, SO THERE IS NO HIGH SEGMENT TO KEEP).');
 MSG('Y = LIST SOURCE ON TTY');
 MSG('NULL FILENAME MEANS KEEP GOING ON CURRENT FILE');
 0);

# DATE(A,JJ): THE DATE JJ (THE MONITOR'S: ((YEAR-1964)*12+MONTH-1)*31+DAY-1) AS DD-MON-YY IN THE WORDS A, A SPACE FOR A ZERO IN THE TENS OF THE DAY #
SUBR DATE(A,JJ) IS (
 J:=JJ;
 K:=J/31; DAY:=1+J-31*K;
 J:=K/12; MO:=K-12*J;
 YR:=64+J; YR:=YR-100*(YR/100);
 A:=A[1]:=0;
 Q:=BYTEP A<7,36>; P:=BYTEP 'JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC'<7,36>; P:=P+3*MO;
 K:=DAY/10; K=0 => <+Q>:=40B ELSE <+Q>:=60B+K;
 <+Q>:=60B+DAY-10*K;
 <+Q>:=55B;
 <+Q>:=<+P>; <+Q>:=<+P>; <+Q>:=<+P>;
 <+Q>:=55B;
 K:=YR/10; <+Q>:=60B+K;
 <+Q>:=60B+YR-10*K;
 0);

# TIME(A): THE TIME OF DAY AS HH:MM IN THE WORD A #
SUBR TIME(A) IS (
 J:=CALLI(23B,0)/60000;
 HR:=J/60; MIN:=J-60*HR;
 A:=0;
 Q:=BYTEP A<7,36>;
 J:=HR/10; K:=HR-10*J;
 <+Q>:=60B+J; <+Q>:=60B+K; <+Q>:=72B;
 J:=MIN/10; K:=MIN-10*J;
 <+Q>:=60B+J; <+Q>:=60B+K;
 0);

# COMPIL: COMPILE THE FILE THAT THE LEXER HAS OPEN, AND PRINT WHAT THE SWITCHES ASK FOR (THE ORIGINAL HAS THIS INLINE IN THE MAIN PROGRAM) #
SUBR COMPIL(NIL) IS (
 STINIT(0); COTREE(0); PARSE('#PG'); CKDONE(0);
 FINAM[5] AND 100000000B => PSTATS(0);
 FINAM[5] AND 40000000B => GPRINT(0);
 FINAM[5] AND 2000000B => TPRINT(0);
 FINAM[5] AND 1000000B => SEMPER(0);
 FINAM[5] AND 400B => DSTATS(0);
 0);

# MKNAME(F,E): THE FILE NAME IN THE TWO WORDS F, AND THE EXTENSION IN THE WORD E (0 FOR NONE), AS A STRING IN NMB (THE ORIGINAL'S NAMES ARE SIX CHARACTERS OF A FILE
  NAME AND THREE OF AN EXTENSION; HERE THEY ARE 15 AND 7) #
SUBR MKNAME(F,E) IS (
 NMB[I]:=0 FOR I FROM 5;
 Q:=BYTEP NMB<7,36>; P:=BYTEP F<7,36>; N:=0;
 MK1: N<15 => ((C:=<+P>) NE 0 => (<+Q>:=C; N:=N+1; GO TO MK1));
 E => (<+Q>:=56B; P:=BYTEP E<7,36>; N:=0;
       MK2: N<7 => ((C:=<+P>) NE 0 => (<+Q>:=C; N:=N+1; GO TO MK2)));
 0);

# OPENIN: OPEN THE FILE NAMED IN FINAM FOR THE LEXER; 0 FOR SUCCESS.  WITH NO EXTENSION IT IS TRIED AS IT IS, THEN WITH imp AND imc (THE ORIGINAL'S SEXTS) #
SUBR OPENIN(NIL) IS (
 NMP:=LOC(NMB);                                   # LEXIN TAKES THE ADDRESS OF THE NAME AS ITS ARGUMENT #
 FINAM[2] => (MKNAME(FINAM,FINAM[2]); RETURN LEXIN(NMP));
 MKNAME(FINAM,0); LEXIN(NMP)=0 => RETURN 0;
 MKNAME(FINAM,'imp'); LEXIN(NMP)=0 => RETURN 0;
 MKNAME(FINAM,'imc'); LEXIN(NMP));

# INCHWL: THE NEXT CHARACTER FROM THE TERMINAL, WAITING FOR A LINE; -1 AT THE END OF THE INPUT #
SUBR INCHWL(NIL) IS (C ARE LOCAL; C:=CCALL getchar(0); C=37777777777B => 0-1 ELSE C);       # (GETCHAR RETURNS AN INT: ITS -1 IS 32 BITS) #

# RUNPGM(N): RUN THE PROGRAM NAMED N (THE ORIGINAL CHAINS TO IT; HERE THE SHELL RUNS IT AND THIS RETURNS) #
SUBR RUNPGM(N) IS (N => CCALL system(LOC(N)); 0);

# THE COMMAND LINE AND THE FILES, WHICH THE ORIGINAL ASKS THE MONITOR FOR (INIT, LOOKUP, ENTER); HERE THE C LIBRARY'S, THROUGH CCALL.  A NAME IS THE ADDRESS OF A C STRING #
SUBR IMPARGV(I) IS (IMPARGET(LOC(AW),ARGVP,I); AW);

SUBR IMPBYTE(P,I) IS (Q ARE LOCAL; Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR IMPOPENLIST(P) IS (
 LISTING:=CCALL fopen(P,LOC('w'));
 LISTING=0 => (CCALL perror(P); RETURN 0-1);
 0);

SUBR IMPCLOSELIST(Z) IS (
 LISTING NE 0 => CCALL impfclose(LISTING);
 LISTING:=0;
 0);

# THE FILE OF PCC IR: - IS THE STANDARD OUTPUT #
SUBR IMPOPENIR(P) IS (
 FF ARE LOCAL;
 FF:=0;
 CCALL snprintf(LOC(IRNM),4096,LOC('%s'),P);
 CCALL strcmp(P,LOC('-'))=0 => FF:=CCALL fdopen(1,LOC('w')) ELSE FF:=CCALL fopen(P,LOC('w'));
 FF=0 => (CCALL perror(P); RETURN 0-1);
 IRF:=FF;
 0);

# THE REL FILE OF TOPS-10, WHICH HERE IS AN OBJECT FILE OF THE SYSTEM (OR OF --TARGET): MADE FROM THE IR JUST WRITTEN, WHEN THE DRIVER ASKS FOR IT (IMPHOOK; THE KERNEL ALONE KEEPS THE IR).  A FILE OF SYNTAX
  AND DECLARATIONS WRITES NO CODE, AND SO NO OBJECT (THE ORIGINAL'S /C FILES MAKE NO REL FILE EITHER); AN ERROR LEAVES THE IR, AND NO OBJECT #
SUBR IMPOBJ(Z) IS (
 N ARE LOCAL;
 IMPHOOK=0 => RETURN 0;
 IRF=0 => RETURN 0;
 CCALL fflush(IRF); N:=CCALL ftell(IRF);
 CCALL impfclose(IRF); IRF:=0;
 N=0 => (CCALL remove(LOC(IRNM)); RETURN 0);
 (((FINAM[5] AND 4000B) NE 0) AND (IMPLB=0)) => RETURN 1;
 MKNAME(FREL,'o');
 LLVMOBJ(LOC(IRNM),LOC(NMB)) NE 0 => (MSG('? OBJECT FILE NOT WRITTEN'); RETURN 1);
 CCALL remove(LOC(IRNM));
 0);

# WHERE THE PRINT STATEMENTS OF THE MODULES GO: THE LISTING, OR THE STANDARD OUTPUT IF THERE IS NONE (0) #
SUBR LISTOUT(NIL) IS LISTING;

# GETC OF A FILE: AN INT, WHOSE -1 IS 32 BITS #
SUBR IMPGETC(F) IS (C ARE LOCAL; C:=CCALL fgetc(F); C=37777777777B => 0-1 ELSE C);

# DOES ERROR(N,E) SAY ANYTHING? (THE DRIVER OF THE COMPILER LEAVES OUT THE ADVISORY ABOUT A PRODUCTION THAT IS THERE ALREADY) #
SUBR IMPNOISY(N,E) IS (
 QUIET NE 0 => N=2 => CCALL strncmp(LOC(E),LOC('PRODUCTION DUPLICATES'),21)=0 => RETURN 0;
 1);

SUBR OUTSTR(M) IS CCALL write(2,LOC(M),CCALL strlen(LOC(M)));           # THE STANDARD ERROR, WHICH HAS NO BUFFER #

# OUTCS(P): THE C STRING AT THE ADDRESS P (OUTSTR'S ARGUMENT IS A TEXT CONSTANT, WHICH THE CALL PASSES BY ADDRESS) #
SUBR OUTCS(P) IS CCALL write(2,P,CCALL strlen(P));

SUBR OUTCHR(M) IS (Q ARE LOCAL; Q:=BYTEP CB<7,36>; <+Q>:=M; CCALL write(2,LOC(CB),1));

SUBR MSG(M) IS (OUTSTR(M); OUTCHR(12B));

# ERROR(N,E): N=0 ENDS THE COMPILATION, AND SO DOES THE 100000TH ERROR (THE ORIGINAL GOES TO FIN: HERE THE LISTING IS CLOSED AND THE PROGRAM EXITS WITH 1) #
SUBR ERROR(N,E) IS (
 N LE 1=>FINAM[5]:=FINAM[5] OR 4000B;
 N LE 1=>(NERRS:=NERRS+1;                                  # A COMPILATION THAT GOES ON FOR EVER MAKING ERRORS (A BROKEN COMPILER) ENDS, AND DOES NOT FILL THE DISK WITH THEM #
         NERRS>100000=>(MSG('** TOO MANY ERRORS: STOPPED **'); IMPCLOSELIST(0); CCALL exit(1)));
 E=>(IMPNOISY(N,E)=>(
     N<2=>(OUTSTR('** ERROR - ');
           LISTING NE 0 =>PRINT STG 0,'** ERROR - ');
     N=2=>(OUTSTR('** ADVISORY - ');
           LISTING NE 0 =>PRINT STG 0,'** ADVISORY - ');
     MSG(E); LISTING NE 0 =>PRINT STG 0,E,/));
 ERR:=-1; N=0 => (FINAM[5]:=FINAM[5] AND NOT 4; IMPCLOSELIST(0); CCALL exit(1))) %%
