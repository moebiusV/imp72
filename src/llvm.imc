#THIS IS FILE LLVM, THE LLVM BACK END IN THE PROCESS (IT WAS STAGE0/LLVM.C, WHICH THE SEED KEEPS): THE MODULE OF LLVM IR THAT IR2LLRUN WRITES BECOMES AN OBJECT FILE WITH THE TARGET MACHINE OF THE HOST, OR ASSEMBLY OR IR TEXT,
 WITHOUT A CLANG IN BETWEEN.  THE C API OF LLVM IS CALLED WITH CCALL: A NAME WITH A LOWER CASE LETTER IS A FOREIGN NAME EXACTLY AS WRITTEN (DOCS/FFI.MD), SO LLVMGETHOSTCPUNAME IS THE
 FUNCTION OF THAT NAME.  WHAT THE PREPROCESSOR DECIDED IN C IS THE MODULE LLVMGEN, WRITTEN BY TOOLS/LLVM.SH FOR THE LLVM OF THE BUILD (LLVMNATIVEINIT, LLVMALLINIT, AND THE ENTRIES OF LLD WHERE THERE IS NONE).  THE ENUMS
 OF THE C API ARE THEIR NUMBERS (LLVM-C/TARGETMACHINE.H): CODEGENLEVELDEFAULT 2, RELOCPIC 2, CODEMODELDEFAULT 0, OBJECTFILE 1.  A C FUNCTION RETURNS AN INT IN HALF A REGISTER, SO THE ANSWERS OF THE LLVMBOOL KIND ARE MASKED TO 32 BITS #
TGTSWAP ARE COMMON;                                    # 1 WHEN THE TARGET HAS THE OTHER BYTE ORDER FROM THE HOST (SET ONCE BY LLVMTARGET, FROM THE DATA LAYOUT OF THE TARGET MACHINE; SRC/DIR.IMC, SRC/IX.IMC, SRC/IR2LL.IMC READ IT) #
LVINIT,LVCPU,LVFEAT,LVTARGET,LVTRI,LVZERO,LVOPT ARE COMMON;       # LVTARGET: THE TRIPLE OF --TARGET, 0 FOR THE HOST; LVTRI: THE TRIPLE IN USE; LVZERO: A WORD OF ZEROS, THE EMPTY C STRING #
LVTXT,LVTXTN,LVOBJP,LVOBJN ARE COMMON;                          # THE TEXT OF THE MODULE (LVMODULEF) AND THE OBJECT IN MEMORY (LVEMIT), EACH A POINTER AND A LENGTH #
LVA1,LVV1,LVO1,LVE1,LVA2,LVV2,LVO2,LVE2 ARE 8 LONG;                                  # THE FIELDS OF TWO TRIPLES: ARCHITECTURE, VENDOR, SYSTEM, ENVIRONMENT #                                      # THE PATH OF THE TEXT OF THE MODULE: THE IR'S WITH .LL #
LVKB IS 80 LONG;                                      # THE REASON A TRIPLE IS REFUSED, A C STRING #

EXTERNAL INT sscanf(PTR, PTR, ...);
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
# THE FAILURE OF AN LLVM CALL: THE MESSAGE OF THE ERROR E, AFTER WHAT WAS BEING DONE #
SUBR LVERR(WHAT,E) IS (
 M ARE LOCAL;
 M:=CCALL LLVMGetErrorMessage(E);
 OUTSTR('imp: LLVM: '); OUTSTR(WHAT); OUTSTR(': '); OUTCS(M); OUTCHR(12B);
 CCALL LLVMDisposeErrorMessage(M);
 1);

# THE NATIVE TARGET, ONCE; 1 AND A MESSAGE IF LLVM HAS NO CODE GENERATOR FOR THIS MACHINE #
SUBR LVINIT1(Z) IS (
 LVINIT NE 0 => RETURN 0;
 LVTARGET NE 0 => (LLVMALLINIT(0); LVINIT:=1; RETURN 0);                           # --TARGET: EVERY TARGET THIS LLVM HAS #
 LLVMNATIVEINIT(0) NE 0 => (OUTSTR('imp: LLVM has no code generator for this machine'); OUTCHR(12B); RETURN 1);
 LVINIT:=1;
 0);

# THE MODULE OF THE TEXT AT LVTXT (LVTXTN BYTES) IN CONTEXT CTX, THE BUFFER NAMED NAME (A C STRING); 0 AND A MESSAGE IF IT DOES NOT PARSE.  (LVTSC OF LLVMGEN CALLS IT WITH THE NAME ITS CALLER GAVE) #
SUBR LVPARSE(CTX,NAME) IS (
 MB,M,MSG ARE LOCAL;
 M:=0; MSG:=0;
 MB:=CCALL LLVMCreateMemoryBufferWithMemoryRangeCopy(LVTXT,LVTXTN,NAME);
 (CCALL LLVMParseIRInContext(CTX,MB,LOC(M),LOC(MSG)) AND 4294967295) NE 0 => (        # (THE BUFFER IS CONSUMED) #
     OUTSTR('imp: LLVM: the module does not parse: '); MSG NE 0 => OUTCS(MSG); OUTCHR(12B);
     MSG NE 0 => CCALL LLVMDisposeMessage(MSG);
     RETURN 0);
 M);

# THE PROCESSOR AND FEATURES OF THE HOST, IN LVCPU AND LVFEAT; 1 IF THEY ARE NOT LLVM'S OWN TO TAKE.  RISCV64 UNDER AN EMULATOR DOES NOT SAY WHAT IT HAS (NO +D), AND THEN THE CODE WOULD BE SOFT FLOAT: RV64GC, WHAT
  EVERY LINUX DISTRIBUTION IS BUILT FOR.  AND WHERE IT DOES SAY, THE LIST HAS FEATURES THAT LLVM DOES NOT KNOW ("-ZICFISS"), EACH A WARNING ON THE STANDARD ERROR EVERY TIME A TARGET MACHINE IS MADE FROM IT: THE ONES
  THAT ONLY SWITCH A FEATURE OFF ARE LEFT OUT #
SUBR LVHOSTCPU(TRIPLE) IS (
 F,O,T,L ARE LOCAL;
 LVCPU:=CCALL LLVMGetHostCPUName();
 LVFEAT:=CCALL LLVMGetHostCPUFeatures();
 CCALL getenv(LOC('IMPLLVMINFO')) NE 0 => (          # WHAT THE HOST SAYS (TOOLS/CI-HOST.SH RECORDS IT IN EVERY CI RUN) #
     OUTSTR('imp-host: triple='); OUTCS(TRIPLE); OUTSTR(' cpu='); OUTCS(LVCPU); OUTSTR(' features='); OUTCS(LVFEAT); OUTCHR(12B));
 (CCALL strncmp(TRIPLE,LOC('riscv64'),7) AND 4294967295) NE 0 => RETURN 0;
 CCALL strstr(LVFEAT,LOC('+d'))=0 => (LVCPU:=LOC('generic-rv64'); LVFEAT:=LOC('+m,+a,+f,+d,+c'); RETURN 1);
 F:=LVFEAT;
 O:=CCALL malloc(CCALL strlen(F)+1);
 O=0 => RETURN 1;
 CCALL memset(O,0,CCALL strlen(F)+1);
 T:=CCALL strtok(F,LOC(','));
 LH1: T=0 => GO TO LH2;
      (CCALL strncmp(T,LOC('-'),1) AND 4294967295) NE 0 => (
          L:=CCALL strlen(O);
          L NE 0 => (CCALL memcpy(O+L,LOC(','),1); L:=L+1);
          CCALL memcpy(O+L,T,CCALL strlen(T)+1));
      T:=CCALL strtok(0,LOC(','));
      GO TO LH1;
 LH2: LVFEAT:=O;
 1);

# THE TRIPLE, PROCESSOR AND FEATURES OF THE TARGET (--TARGET, NORMALISED BY LLVM) OR OF THE HOST, IN LVTRI, LVCPU AND LVFEAT.  A TARGET IS GENERIC, EXCEPT RISCV64, WHICH IS RV64GC AS THE HOST'S FALLBACK IS #
SUBR LVTRIPLE(Z) IS (
 LVTARGET=0 => (LVTRI:=CCALL LLVMNormalizeTargetTriple(CCALL LLVMGetDefaultTargetTriple()); LVHOSTCPU(LVTRI); RETURN 0);
 LVTRI:=CCALL LLVMNormalizeTargetTriple(LVTARGET);
 LVCPU:=LOC('generic'); LVZERO:=0; LVFEAT:=LOC(LVZERO);
 (CCALL strncmp(LVTRI,LOC('riscv64'),7) AND 4294967295)=0 => (LVCPU:=LOC('generic-rv64'); LVFEAT:=LOC('+m,+a,+f,+d,+c'));
 0);

# 1 IF THE NORMALISED --TARGET TRIPLE IS ONE LLVM'S OWN TRIPLE PARSER KNOWS (STAGE0/LVTRIPLE.CPP: THE CHARACTERS, THE ARCHITECTURE, THE OPERATING SYSTEM, THE ENVIRONMENT AND OBJECT FORMAT; THE VENDOR IS FREE TEXT); 0 AND THE REASON IN LVKB IF NOT.  THE HOST'S OWN TRIPLE IS NOT CHECKED #
SUBR LVTRIOK(Z) IS (
 LVTARGET=0 => RETURN 1;
 LVKB:=0;
 (CCALL imp_triple_check(LVTARGET,LVTRI,LOC(LVKB),640) AND 4294967295)=0);

# THE OPTIMIZATION LEVEL OF THE DRIVER'S -O: 0 TO 3 FOR -O0 TO -O3, 4 FOR -OS, 5 FOR -OZ (LVOPT HOLDS THE LEVEL PLUS 1, SO THAT NOTHING SET IS -OS, THE DEFAULT) #
SUBR LLVMOPT(N) IS (LVOPT:=N+1; 0);
SUBR LVLEVEL(Z) IS (LVOPT=0 => 4 ELSE LVOPT-1);

# THE LEVEL OF CODE GENERATION FOR THE OPTIMIZATION LEVEL: NONE, LESS, DEFAULT, AGGRESSIVE FOR -O0 TO -O3; -OS AND -OZ ARE DEFAULT (LLVM-C/TARGETMACHINE.H: 0 TO 3) #
SUBR LVCGLEVEL(Z) IS (LVLEVEL(0)<4 => LVLEVEL(0) ELSE 2);

# THE TARGET MACHINE FOR LVTRI, LVCPU, LVFEAT (MODEL IS THE CODE MODEL); 0 AND A MESSAGE IF LLVM HAS NONE #
SUBR LVMAKETM(MODEL) IS (
 TGT,MSG ARE LOCAL;
 TGT:=0; MSG:=0;
 LVTRIOK(0)=0 => (OUTSTR('imp: unrecognized target "'); OUTCS(LVTARGET); OUTSTR('": '); OUTCS(LOC(LVKB)); OUTSTR(' (expected ARCH-VENDOR-OS[-ENVIRONMENT], for example x86_64-linux-gnu)'); OUTCHR(12B); RETURN 0);
 (CCALL LLVMGetTargetFromTriple(LVTRI,LOC(TGT),LOC(MSG)) AND 4294967295) NE 0 => (
     OUTSTR('imp: LLVM: '); OUTCS(MSG); OUTCHR(12B); CCALL LLVMDisposeMessage(MSG); RETURN 0);
 CCALL LLVMCreateTargetMachine(TGT,LVTRI,LVCPU,LVFEAT,LVCGLEVEL(0),2,MODEL));

# THE BYTE ORDER OF THE HOST (1 LITTLE, 0 BIG), AS LLVM'S DATA LAYOUT OF THE HOST'S TRIPLE SAYS #
SUBR LVHOSTBO(Z) IS (
 T,TM,TGT,MSG ARE LOCAL;
 T:=CCALL LLVMNormalizeTargetTriple(CCALL LLVMGetDefaultTargetTriple());
 TGT:=0; MSG:=0;
 (CCALL LLVMGetTargetFromTriple(T,LOC(TGT),LOC(MSG)) AND 4294967295) NE 0 => RETURN 1;
 LVZERO:=0;
 TM:=CCALL LLVMCreateTargetMachine(TGT,T,LOC('generic'),LOC(LVZERO),2,2,0);                 # THE HOST'S ORDER DOES NOT DEPEND ON THE PROCESSOR, AND THE TARGET'S SETTINGS ARE NOT FOR IT #
 (CCALL LLVMByteOrder(CCALL LLVMCreateTargetDataLayout(TM)) AND 4294967295));

# THE POINTERS OF THE TARGET: 1 IF THEY ARE 32 BITS, 0 IF 64, 0-1 IF THERE IS NO SUCH TARGET #
SUBR LVPTR32(Z) IS (
 TM,DL,N ARE LOCAL;
 LVTARGET=0 => RETURN (IMPPTRSIZE(0)=4 => 1 ELSE 0);
 LVINIT1(0) NE 0 => RETURN 0-1;
 LVTRIPLE(0);
 TM:=LVMAKETM(0); TM=0 => RETURN 0-1;
 DL:=CCALL LLVMCreateTargetDataLayout(TM);
 N:=CCALL LLVMPointerSize(DL) AND 4294967295;
 N=4 => 1 ELSE 0);

# -OS AND -OZ: EACH FUNCTION THE MODULE DEFINES GETS THE ATTRIBUTE OPTSIZE (-OZ: AND MINSIZE), WHICH THE PASSES AND THE CODE GENERATOR READ #
SUBR LVSIZEATTR(CTX,M,L) IS (
 F,K,A,B ARE LOCAL;
 K:=CCALL LLVMGetEnumAttributeKindForName(LOC('optsize'),7) AND 4294967295;
 A:=CCALL LLVMCreateEnumAttribute(CTX,K,0);
 K:=CCALL LLVMGetEnumAttributeKindForName(LOC('minsize'),7) AND 4294967295;
 B:=CCALL LLVMCreateEnumAttribute(CTX,K,0);
 F:=CCALL LLVMGetFirstFunction(M);
 SA1: F=0 => RETURN 0;
      (CCALL LLVMCountBasicBlocks(F) AND 4294967295) NE 0 => (
          CCALL LLVMAddAttributeAtIndex(F,4294967295,A);
          L=5 => CCALL LLVMAddAttributeAtIndex(F,4294967295,B));
      F:=CCALL LLVMGetNextFunction(F);
      GO TO SA1);

# THE PASS PIPELINE FOR THE OPTIMIZATION LEVEL, A C STRING #
SUBR LVPIPELINE(Z) IS (
 L ARE LOCAL;
 L:=LVLEVEL(0);
 L=0 => RETURN LOC('default<O0>');
 L=1 => RETURN LOC('default<O1>');
 L=2 => RETURN LOC('default<O2>');
 L=3 => RETURN LOC('default<O3>');
 L=5 => RETURN LOC('default<Oz>');
 LOC('default<Os>'));

# THE MODULE AT LVTXT, OPTIMISED, AS A FILE PATH FOR THE TARGET (FT IS 1 FOR AN OBJECT, 0 FOR ASSEMBLY); OR, WITH PATH 0, AN OBJECT IN MEMORY, AT LVOBJP (LVOBJN BYTES) #
SUBR LVEMIT(PATH,FT) IS (
 CTX,M,TM,DL,PBO,E,MSG,OB ARE LOCAL;
 LVINIT1(0) NE 0 => RETURN 1;
 CTX:=CCALL LLVMContextCreate();
 M:=LVPARSE(CTX,LOC('module')); M=0 => RETURN 1;
 LVTRIPLE(0);
 TM:=LVMAKETM(0); TM=0 => RETURN 1;
 CCALL LLVMSetTarget(M,LVTRI);
 DL:=CCALL LLVMCreateTargetDataLayout(TM);
 CCALL LLVMSetModuleDataLayout(M,DL);
 LVLEVEL(0)>3 => LVSIZEATTR(CTX,M,LVLEVEL(0));
 PBO:=CCALL LLVMCreatePassBuilderOptions();
 E:=CCALL LLVMRunPasses(M,LVPIPELINE(0),TM,PBO);
 E NE 0 => (LVERR('the optimiser',E); RETURN 1);
 CCALL LLVMDisposePassBuilderOptions(PBO);
 MSG:=0;
 PATH=0 => (OB:=0;
            (CCALL LLVMTargetMachineEmitToMemoryBuffer(TM,M,FT,LOC(MSG),LOC(OB)) AND 4294967295) NE 0 => (
                OUTSTR('imp: LLVM: '); OUTCS(MSG); OUTCHR(12B); CCALL LLVMDisposeMessage(MSG); RETURN 1);
            LVOBJP:=CCALL LLVMGetBufferStart(OB); LVOBJN:=CCALL LLVMGetBufferSize(OB);
            RETURN 0);
 (CCALL LLVMTargetMachineEmitToFile(TM,M,PATH,FT,LOC(MSG)) AND 4294967295) NE 0 => (
     OUTSTR('imp: LLVM: '); OUTCS(PATH); OUTSTR(': '); OUTCS(MSG); OUTCHR(12B); CCALL LLVMDisposeMessage(MSG); RETURN 1);
 0);

# THE MODULE OF LLVM IR FOR THE IR READ FROM THE C STREAM FIN, AS TEXT IN MEMORY, AT LVTXT (LVTXTN BYTES): 0 FOR SUCCESS #
SUBR LVMODULEF(FIN) IS (
 OUTF,P32,RC ARE LOCAL;
 P32:=LVPTR32(0); P32<0 => RETURN 1;
 TGTSWAP NE 0 => P32:=P32+2;                               # (BIT 1: THE BYTE ORDER OF THE TARGET IS NOT THE HOST'S) #
 LVTXT:=0; LVTXTN:=0;
 OUTF:=CCALL open_memstream(LOC(LVTXT),LOC(LVTXTN));
 OUTF=0 => (CCALL perror(LOC('open_memstream')); RETURN 1);
 RC:=IR2LLRUN(FIN,OUTF,P32);
 CCALL fclose(OUTF);
 RC);

# THE SAME FOR THE IR TEXT AT BUF (N BYTES), IN MEMORY: NO FILE #
SUBR LVMODULEB(BUF,N) IS (
 FIN,RC ARE LOCAL;
 N=0 => FIN:=CCALL fopen(LOC('/dev/null'),LOC('r')) ELSE FIN:=CCALL fmemopen(BUF,N,LOC('r'));
 FIN=0 => (CCALL perror(LOC('the IR in memory')); RETURN 1);
 RC:=LVMODULEF(FIN);
 CCALL fclose(FIN);
 RC);

# THE SAME FOR THE IR IN THE FILE PATH (THE INTERACTIVE MODE KEEPS ITS IR IN A FILE OF THE USER'S) #
SUBR LVMODULEP(PATH) IS (
 FIN,RC ARE LOCAL;
 FIN:=CCALL fopen(PATH,LOC('r'));
 FIN=0 => (CCALL perror(PATH); RETURN 1);
 RC:=LVMODULEF(FIN);
 CCALL fclose(FIN);
 RC);

# THE ENTRIES OF THE DRIVER (SRC/DRIVER.IMC): 0 FOR SUCCESS.  THE IR TEXT OF THE KERNEL IS IN MEMORY (BUF, N BYTES) #
SUBR LLVMHAVE(Z) IS 1;

# --TARGET: THE TRIPLE (A C STRING) THE OBJECT, THE ASSEMBLY AND THE IR ARE MADE FOR.  THE BYTE ORDER OF THE TARGET IS WHAT THE DATA LAYOUT OF ITS TARGET MACHINE SAYS; TGTSWAP IS SET HERE, BEFORE ANY CODE IS GENERATED.
  1 AND A MESSAGE IF LLVM HAS NO SUCH TARGET #
SUBR LLVMTARGET(T) IS (
 TM ARE LOCAL;
 LVTARGET:=T; TGTSWAP:=0;
 LVINIT1(0) NE 0 => RETURN 1;
 LVTRIPLE(0);
 TM:=LVMAKETM(0); TM=0 => RETURN 1;
 (CCALL LLVMByteOrder(CCALL LLVMCreateTargetDataLayout(TM)) AND 4294967295) NE LVHOSTBO(0) => TGTSWAP:=1;
 0);

SUBR LLVMTRIPLE(Z) IS (LVTRIPLE(0); LVTRI);                 # THE NORMALISED TRIPLE OF THE TARGET (OR THE HOST'S), A C STRING #

SUBR LLVMNATIVE(Z) IS (                                     # 1 IF THE TARGET IS THE HOST (NONE NAMED, OR THE SAME ARCHITECTURE AND SYSTEM WHATEVER THE VENDOR AND THE C LIBRARY: X86_64-LINUX-GNU IS X86_64-PC-LINUX-GNU AND X86_64-ALPINE-LINUX-MUSL), SO THAT A PROGRAM CAN BE LINKED AND RUN #
 N,H ARE LOCAL;
 LVTARGET=0 => RETURN 1;
 N:=CCALL LLVMNormalizeTargetTriple(LVTARGET);
 H:=CCALL LLVMNormalizeTargetTriple(CCALL LLVMGetDefaultTargetTriple());
 LVA1:=0; LVO1:=0; LVE1:=0; LVA2:=0; LVO2:=0; LVE2:=0; LVV1:=0; LVV2:=0;
 CCALL sscanf(N,LOC('%[^-]-%[^-]-%[^-]-%s'),LOC(LVA1),LOC(LVV1),LOC(LVO1),LOC(LVE1));
 CCALL sscanf(H,LOC('%[^-]-%[^-]-%[^-]-%s'),LOC(LVA2),LOC(LVV2),LOC(LVO2),LOC(LVE2));
 (((CCALL strcmp(LOC(LVA1),LOC(LVA2)) AND 4294967295)=0) AND ((CCALL strcmp(LOC(LVO1),LOC(LVO2)) AND 4294967295)=0)) => RETURN 1;      # THE SAME ARCHITECTURE AND SYSTEM: GNU OR MUSL, IT LINKS WITH THE C LIBRARY THERE IS #
 0);

SUBR LLVMOBJ(IR,OUT) IS (                              # THE OBJECT OF THE PROGRAM IN THE FILE IR, TO THE FILE OUT (THE INTERACTIVE MODE) #
 LVMODULEP(IR) NE 0 => RETURN 1;
 LVEMIT(OUT,1) NE 0 => RETURN 1;
 0);

SUBR LLVMOBJB(BUF,N,OUT) IS (                          # THE OBJECT OF THE PROGRAM, TO THE FILE OUT (-C) #
 LVMODULEB(BUF,N) NE 0 => RETURN 1;
 LVEMIT(OUT,1) NE 0 => RETURN 1;
 0);

SUBR LLVMOBJMEM(BUF,N) IS (                            # THE OBJECT OF THE PROGRAM IN MEMORY: AT LVOBJP, LVOBJN BYTES #
 LVMODULEB(BUF,N) NE 0 => RETURN 1;
 LVEMIT(0,1) NE 0 => RETURN 1;
 0);

SUBR LLVMASMB(BUF,N,OUT) IS (                          # THE ASSEMBLY OF THE PROGRAM FOR THE TARGET (-S) #
 LVMODULEB(BUF,N) NE 0 => RETURN 1;
 LVEMIT(OUT,0) NE 0 => RETURN 1;
 0);

SUBR LLVMSAVEB(BUF,N,OUT) IS (                         # THE MODULE AS LLVM IR TEXT (-SIR) #
 F ARE LOCAL;
 LVMODULEB(BUF,N) NE 0 => RETURN 1;
 F:=CCALL fopen(OUT,LOC('w'));
 F=0 => (CCALL perror(OUT); RETURN 1);
 (CCALL fwrite(LVTXT,1,LVTXTN,F)) NE LVTXTN => (CCALL perror(OUT); CCALL fclose(F); RETURN 1);
 (CCALL fclose(F) AND 4294967295) NE 0 => (CCALL perror(OUT); RETURN 1);
 0)
%%
