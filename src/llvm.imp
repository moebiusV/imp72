#THIS IS FILE LLVM, THE LLVM BACK END IN THE PROCESS (IT WAS STAGE0/LLVMORC.C, WHICH THE SEED KEEPS): THE MODULE OF LLVM IR THAT IR2LLRUN WRITES BECOMES AN OBJECT FILE WITH THE TARGET MACHINE OF THE HOST, OR IS COMPILED
 BY ORC (LLJIT) AND RUN, WITHOUT A CLANG IN BETWEEN.  THE C API OF LLVM IS CALLED WITH CCALL: A NAME WITH A LOWER CASE LETTER IS A FOREIGN NAME EXACTLY AS WRITTEN (DOCS/FFI.MD), SO LLVMGETHOSTCPUNAME IS THE
 FUNCTION OF THAT NAME.  WHAT THE PREPROCESSOR DECIDED IN C IS THE MODULE LLVMGEN, WRITTEN BY TOOLS/LLVM.SH FOR THE LLVM OF THE BUILD (LLVMNATIVEINIT, LVTSC, AND THE ENTRIES OF LLD WHERE THERE IS NONE).  THE ENUMS
 OF THE C API ARE THEIR NUMBERS (LLVM-C/TARGETMACHINE.H): CODEGENLEVELDEFAULT 2, RELOCPIC 2, CODEMODELDEFAULT 0, CODEMODELJITDEFAULT 1, OBJECTFILE 1.  THE RUNTIME LIBRARY AND THE C LIBRARY ARE FOUND IN THE PROGRAM ITSELF,
 WHICH IS LINKED WITH -RDYNAMIC FOR THE PURPOSE.  A C FUNCTION RETURNS AN INT IN HALF A REGISTER, SO THE ANSWERS OF THE LLVMBOOL KIND ARE MASKED TO 32 BITS #
LVINIT,LVMOD,LVCPU,LVFEAT ARE COMMON;
LVLL IS 520 LONG;                                      # THE PATH OF THE TEXT OF THE MODULE: THE IR'S WITH .LL #
LVPARS IS 5 LONG;                                      # THE PARAMETERS THAT IMPSEMCALL PASSES #

# THE FAILURE OF AN LLVM CALL: THE MESSAGE OF THE ERROR E, AFTER WHAT WAS BEING DONE (A TEXT CONSTANT; LVERRC TAKES A C STRING) #
SUBR LVERR(WHAT,E) IS (
 M ARE LOCAL;
 M_CCALL LLVMGetErrorMessage(E);
 OUTSTR('imp72: LLVM: '); OUTSTR(WHAT); OUTSTR(': '); OUTCS(M); OUTCHR(12B);
 CCALL LLVMDisposeErrorMessage(M);
 1);
SUBR LVERRC(WHAT,E) IS (
 M ARE LOCAL;
 M_CCALL LLVMGetErrorMessage(E);
 OUTSTR('imp72: LLVM: '); OUTCS(WHAT); OUTSTR(': '); OUTCS(M); OUTCHR(12B);
 CCALL LLVMDisposeErrorMessage(M);
 1);

# THE NATIVE TARGET, ONCE; 1 AND A MESSAGE IF LLVM HAS NO CODE GENERATOR FOR THIS MACHINE #
SUBR LVINIT1(Z) IS (
 LVINIT NE 0 => RETURN 0;
 LLVMNATIVEINIT(0) NE 0 => (OUTSTR('imp72: LLVM has no code generator for this machine'); OUTCHR(12B); RETURN 1);
 LVINIT_1;
 0);

# THE MODULE OF THE TEXT IN THE FILE PATH, IN CONTEXT CTX; 0 AND A MESSAGE IF IT DOES NOT PARSE #
SUBR LVPARSE(CTX,PATH) IS (
 MB,M,MSG ARE LOCAL;
 MB_0; M_0; MSG_0;
 (CCALL LLVMCreateMemoryBufferWithContentsOfFile(PATH,LOC(MB),LOC(MSG)) AND 4294967295) NE 0 => (
     OUTSTR('imp72: LLVM: '); OUTCS(PATH); OUTSTR(': '); MSG NE 0 => OUTCS(MSG); OUTCHR(12B);
     MSG NE 0 => CCALL LLVMDisposeMessage(MSG);
     RETURN 0);
 (CCALL LLVMParseIRInContext(CTX,MB,LOC(M),LOC(MSG)) AND 4294967295) NE 0 => (        # (THE BUFFER IS CONSUMED) #
     OUTSTR('imp72: LLVM: the module does not parse: '); MSG NE 0 => OUTCS(MSG); OUTCHR(12B);
     MSG NE 0 => CCALL LLVMDisposeMessage(MSG);
     RETURN 0);
 M);

# THE PROCESSOR AND FEATURES OF THE HOST, IN LVCPU AND LVFEAT; 1 IF THEY ARE NOT LLVM'S OWN TO TAKE.  RISCV64 UNDER AN EMULATOR DOES NOT SAY WHAT IT HAS (NO +D), AND THEN THE CODE WOULD BE SOFT FLOAT: RV64GC, WHAT
  EVERY LINUX DISTRIBUTION IS BUILT FOR.  AND WHERE IT DOES SAY, THE LIST HAS FEATURES THAT LLVM DOES NOT KNOW ("-ZICFISS"), EACH A WARNING ON THE STANDARD ERROR EVERY TIME A TARGET MACHINE IS MADE FROM IT: THE ONES
  THAT ONLY SWITCH A FEATURE OFF ARE LEFT OUT #
SUBR LVHOSTCPU(TRIPLE) IS (
 F,O,T ARE LOCAL;
 LVCPU_CCALL LLVMGetHostCPUName();
 LVFEAT_CCALL LLVMGetHostCPUFeatures();
 CCALL GETENV(LOC('IMP72LLVMINFO')) NE 0 => (          # WHAT THE HOST SAYS (TOOLS/CI-HOST.SH RECORDS IT IN EVERY CI RUN) #
     OUTSTR('imp72-host: triple='); OUTCS(TRIPLE); OUTSTR(' cpu='); OUTCS(LVCPU); OUTSTR(' features='); OUTCS(LVFEAT); OUTCHR(12B));
 (CCALL STRNCMP(TRIPLE,LOC('riscv64'),7) AND 4294967295) NE 0 => RETURN 0;
 CCALL STRSTR(LVFEAT,LOC('+d'))=0 => (LVCPU_LOC('generic-rv64'); LVFEAT_LOC('+m,+a,+f,+d,+c'); RETURN 1);
 F_LVFEAT;
 O_CCALL MALLOC(CCALL STRLEN(F)+1);
 O=0 => RETURN 1;
 CCALL MEMSET(O,0,CCALL STRLEN(F)+1);
 T_CCALL STRTOK(F,LOC(','));
 LH1: T=0 => GO TO LH2;
      (CCALL STRNCMP(T,LOC('-'),1) AND 4294967295) NE 0 => (
          CCALL STRLEN(O) NE 0 => CCALL STRCAT(O,LOC(','));
          CCALL STRCAT(O,T));
      T_CCALL STRTOK(0,LOC(','));
      GO TO LH1;
 LH2: LVFEAT_O;
 1);

# THE MODULE IN THE FILE IR (LLVM IR TEXT), OPTIMISED, AS AN OBJECT FILE PATH #
SUBR LVOBJECT(IR,PATH) IS (
 CTX,M,TGT,TM,DL,PBO,E,TRIPLE,MSG ARE LOCAL;
 LVINIT1(0) NE 0 => RETURN 1;
 CTX_CCALL LLVMContextCreate();
 M_LVPARSE(CTX,IR); M=0 => RETURN 1;
 TRIPLE_CCALL LLVMGetDefaultTargetTriple();
 LVHOSTCPU(TRIPLE);
 MSG_0; TGT_0;
 (CCALL LLVMGetTargetFromTriple(TRIPLE,LOC(TGT),LOC(MSG)) AND 4294967295) NE 0 => (
     OUTSTR('imp72: LLVM: '); OUTCS(MSG); OUTCHR(12B); CCALL LLVMDisposeMessage(MSG); RETURN 1);
 TM_CCALL LLVMCreateTargetMachine(TGT,TRIPLE,LVCPU,LVFEAT,2,2,0);
 CCALL LLVMSetTarget(M,TRIPLE);
 DL_CCALL LLVMCreateTargetDataLayout(TM);
 CCALL LLVMSetModuleDataLayout(M,DL);
 PBO_CCALL LLVMCreatePassBuilderOptions();
 E_CCALL LLVMRunPasses(M,LOC('default<O1>'),TM,PBO);
 E NE 0 => (LVERR('the optimiser',E); RETURN 1);
 CCALL LLVMDisposePassBuilderOptions(PBO);
 MSG_0;
 (CCALL LLVMTargetMachineEmitToFile(TM,M,PATH,1,LOC(MSG)) AND 4294967295) NE 0 => (
     OUTSTR('imp72: LLVM: '); OUTCS(PATH); OUTSTR(': '); OUTCS(MSG); OUTCHR(12B); CCALL LLVMDisposeMessage(MSG); RETURN 1);
 0);

# THE MODULE IN THE FILE IR COMPILED BY ORC AND ITS FUNCTION ENTRY (NO ARGUMENTS) CALLED: 0 FOR SUCCESS, THE RESULT OF THE CALL IS NOT KEPT.  THE CALL THROUGH THE ADDRESS IS IMPSEMCALL OF THE LIBRARY #
SUBR LVRUN(IR,ENTRY) IS (
 JIT,JD,GEN,TSC,TSM,ADDR,E,LB,TRIPLE,TGT,TM,MSG ARE LOCAL;
 LVINIT1(0) NE 0 => RETURN 1;
 LB_0; MSG_0; TGT_0; JIT_0; GEN_0; ADDR_0;
 TRIPLE_CCALL LLVMGetDefaultTargetTriple();
 LVHOSTCPU(TRIPLE) NE 0 => (                          # THE JIT DETECTS THE HOST ITSELF, AND WOULD FIND NO +D #
     (CCALL LLVMGetTargetFromTriple(TRIPLE,LOC(TGT),LOC(MSG)) AND 4294967295)=0 => (
         TM_CCALL LLVMCreateTargetMachine(TGT,TRIPLE,LVCPU,LVFEAT,2,2,1);
         LB_CCALL LLVMOrcCreateLLJITBuilder();
         CCALL LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(LB,CCALL LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(TM))));
 E_CCALL LLVMOrcCreateLLJIT(LOC(JIT),LB);
 E NE 0 => RETURN LVERR('the JIT',E);
 JD_CCALL LLVMOrcLLJITGetMainJITDylib(JIT);
 E_CCALL LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(LOC(GEN),CCALL LLVMOrcLLJITGetGlobalPrefix(JIT),0,0);
 E NE 0 => RETURN LVERR('the symbols of the program',E);
 CCALL LLVMOrcJITDylibAddGenerator(JD,GEN);
 TSC_LVTSC(IR); TSC=0 => RETURN 1;
 TSM_CCALL LLVMOrcCreateNewThreadSafeModule(LVMOD,TSC);
 CCALL LLVMOrcDisposeThreadSafeContext(TSC);
 E_CCALL LLVMOrcLLJITAddLLVMIRModule(JIT,JD,TSM);
 E NE 0 => RETURN LVERR('adding the module',E);
 E_CCALL LLVMOrcLLJITLookup(JIT,LOC(ADDR),ENTRY);
 E NE 0 => RETURN LVERRC(ENTRY,E);
 LVPARS[0]_LVPARS[1]_LVPARS[2]_LVPARS[3]_LVPARS[4]_0;
 CCALL IMPSEMCALL(ADDR,LOC(LVPARS));
 0);

# THE MODULE OF LLVM IR FOR THE PCC IR IN THE FILE IR, AS TEXT IN THE FILE OUTP: 0 FOR SUCCESS #
SUBR LVMODULE(IR,OUTP) IS (
 IRF,OUTF,P32,RC ARE LOCAL;
 IRF_CCALL FOPEN(IR,LOC('r'));
 IRF=0 => (CCALL PERROR(IR); RETURN 1);
 OUTF_CCALL FOPEN(OUTP,LOC('w'));
 OUTF=0 => (CCALL PERROR(OUTP); CCALL IMPFCLOSE(IRF); RETURN 1);
 P32_(CCALL IMPPTRSIZE(0)=4 => 1 ELSE 0);
 RC_IR2LLRUN(IRF,OUTF,P32);
 CCALL IMPFCLOSE(OUTF); CCALL IMPFCLOSE(IRF);
 RC);

# THE ENTRIES OF THE DRIVER (SRC/DRIVER.IMP): 0 FOR SUCCESS #
SUBR LLVMHAVE(Z) IS 1;

SUBR LLVMOBJ(IR,OUT) IS (                              # THE OBJECT OF THE PROGRAM; THE TEXT OF THE MODULE IS NEXT TO THE IR #
 CCALL SNPRINTF(LOC(LVLL),4096,LOC('%s.ll'),IR);
 LVMODULE(IR,LOC(LVLL)) NE 0 => RETURN 1;
 LVOBJECT(LOC(LVLL),OUT) NE 0 => RETURN 1;
 0);

SUBR LLVMSAVE(IR,OUT) IS (                             # THE MODULE AS TEXT (-S) #
 LVMODULE(IR,OUT) NE 0 => RETURN 1;
 0);

SUBR LLVMRUN(IR) IS (                                  # COMPILE WITH ORC AND RUN: THE MAIN PROGRAM IS IMPMAIN #
 CCALL SNPRINTF(LOC(LVLL),4096,LOC('%s.ll'),IR);
 LVMODULE(IR,LOC(LVLL)) NE 0 => RETURN 1;
 LVRUN(LOC(LVLL),LOC('impmain')) NE 0 => RETURN 1;
 0)
%%
