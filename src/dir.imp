TWOSEG;
DM,DN ARE COMMON;                           # THE C SIDE READS THEM (SRC/SHARED.TXT) #
#THIS IS FILE DIR.I10, DIRECTORY PACKAGE FOR IMP COMPILERS.
   DIR(I) RETURNS DIRECTORY INDEX OF ASCII NAME BEGINNING I.
   DPROP(PROP,I) RETURNS VALUE OF PROPERTY PROP FOR ENTRY WHOSE INDEX IS I
   DPROPS(PROP,I,V) SETS VALUE OF PROPERTY PROP TO V FOR ENTRY I.
     ** DPROP AND DPROPS HAVE BEEN EXPANDED IN-LINE  **
     ** REFER TO SPECIAL SYNTAX FOR COMPILER, IMPSYN **
   DSEQ(N) ALLOWS SEQUENCING THROUGH ALL ENTRIES IN THE DIRECTORY.  INITIALLY
      SET N NEGATIVE.  REPEATED CALLS ON DSEQ(N) WILL SET N TO INDEX OF EACH
      ENTRY IN DIR.  AFTER THE LAST ENTRY, N BECOMES NEGATIVE AGAIN.  THE
      VALUE OF DSEQ IS N.
   PNAME(N) PRINTS THE NAME OF DIR ENTRY N.
   GNAME(N) RETURNS THE ADDRESS OF A LOCAL VECTOR WHICH CONTAINS
            THE FIRST 24 CHARACTERS OF THE NAME OF DIR ENTRY N.
   DNAME(I,J) RETURNS JTH WORD (8 ASCII CHARACTERS) OF NAME FOR DIRECTORY
            INDEX I.
   DSTATS() PRINTS DIR STATISTICS.
   RADI50(N) RETURNS THE RADIX50 VALUE OF DIR ENTRY N (FIRST 6 CHARS ONLY)

 HASH-CODED DIRECTORY
 INDEX IS OFF-SET IN FREE ARRAY PRP, WHICH IS COMPOSED OF 3-WORD NODES:

        WORD 1  LEFT HALF    HASH SIBLING INDEX
                RIGHT HALF   ALF INDEX
        WORD 2  LEFT HALF    'ENTRY'     !
                RIGHT HALF   'NODE'      !
        WORD 3  BITS 41-43   'USE'        >  ACCESS TO THESE PROPERTIES
                     39-40   'LXTY'      !   IS GRANTED BY MEANS OF THE
                     37-38   'ISNM'      !   SYNTAX EXTENSIONS OF IMPSYN.
                     35-36   'COM'       !
                     32-34   'ATYPE'     !
                     0-31    'SEM'       !

 THE FREE ARRAY ALF CONCATENATES THE 'NAME'S.  A NAME IS AN ARRAY OF WORDS WITH
 EIGHT CHARACTERS EACH, THE FIRST IN THE LOW BYTE (A STRING CONSTANT IS ONE).  TERMINAL
 NULL CHARACTERS ARE REQUIRED. #

SUBR HASH(NM) IS (#9-BIT HASH CODE#
                  HSH_NM XOR NM RS 32;
                  HSH_HSH XOR HSH RS 16;
                  HSH_HSH XOR HSH RS 9;
                  HSH AND 777B);

SUBR DIR(NM) IS (
 DINIT=0 => (DINIT_1;
             FRELOT(PRP,'PRP',2100,0); FINCSET(PRP,90); NPRP_1536;
             FRELOT(ALF,'ALF',900,0); FINCSET(ALF,45); NALF_1);
 H_HASH(NM[0]); HN_2; N_0;
L0: (NM[N] RS 56) => (N_N+1; GO TO L0);
L1: (I_H*3)=0 => I_3;
L2: Q_FREE(PRP+I);
 J_HR(Q);
 J=0 => (FREES(PRP+I,NALF); DM_DM+1; GO TO L4);
 (NM[K] NE FREE(ALF+J+K) => (HN => (H_H XOR HN; HN_HN RS 1; GO TO L1);
                        I1_I; (I_HL(Q)) => GO TO L2;
                        GO TO L3))  FOR K TO N;
 GO TO L5;
L3: I_NPRP; DN_DN+1;
 FREES(PRP+I1,Q OR I LS 32);
 K_NPRP+3; FLEN(PRP) LE K => FADDEX(PRP,K);
 FREES(PRP+NPRP,NALF); NPRP_K;
L4: K_NALF+N+1; FLEN(ALF) LE K => FADDEX(ALF,K);
 AX_NALF; NALF_K;
 FREES(ALF+AX+K,NM[K]) FOR K TO N;
L5: I);

SUBR DSEQ(N) IS (
 N<0 => (N_-3; NMARK_-1);
 NMARK GE 0 => (N_HL(FREE(PRP+N));
                N=0 => (N_NMARK; NMARK_-1));
 NMARK<0 => (L6: N_N+3;
              N GE 1536 => N_-1
                      ELSE (FREE(PRP+N)=0 => GO TO L6;
                            NMARK_N));
N);

# DIRW(TOK): DIR OF THE TOKEN IN FREE ARRAY TOK, ONE CHARACTER TO A WORD, ENDED BY A 0 (THE LEXICAL ANALYSER MAKES IT SO) #
SUBR DIRW(TOK) IS (
 NMV IS 100 LONG;
 C,N,K,W ARE LOCAL;
 N_0; K_0; W_0;
 DW1: C_FREE(TOK+N);
 W_W OR ((C AND 377B) LS (8*(N AND 7)));
 C=0 => (NMV[K]_W; GO TO DW2);
 N_N+1; (N AND 7)=0 => (NMV[K]_W; K_K+1; W_0);
 GO TO DW1;
 DW2: DIR(NMV[0]));

SUBR PNAME(DJ) IS (DJ GE 0=>PRINT STG 0,FREE(ALF+HR(FREE(PRP+DJ))));

SUBR DNAME(DI,J) IS FREE(ALF+J+HR(FREE(PRP+DI)));

SUBR GNAME(DJ) IS (
 LCL IS 4 LONG;
 LCL[K]_DNAME(DJ,K) FOR K TO 2;
 LCL[3]_0;
 LOC(LCL));

SUBR DSTATS() IS (
 PRINT STG 0,'DIRECTORY HASHED INTO ',IGR 0,DM,STG 0,' BOXES.  OVERFLOW IS ',
   IGR 0,DN,STG 0,'.',/;
 FINAM IS COMMON; (FINAM[5] AND 400B) => DSPILL(0);
 0);

SUBR DSPILL() IS (
 PRINT STG 0, 'HASH CODE   TOKEN', /;
 N_-1; H1_-1;
L7: DSEQ(N);
 N GE 0 => (H_HASH(DNAME(N,0));
            H NE H1 => (PRINT STG 0, '    ', OCT 3, H; H1_H)
                  ELSE (PRINT STG 0, '       ');
            PRINT STG 0, '    '; PNAME(N); PRINT /; GO TO L7);
 0);

SUBR RADI50(N) IS (
 NX_DNAME(N,0);
 VAL_0;
 (C_377B AND (NX RS (8*P));
  C=0 => GO TO RDX;
  C=56B=>(K_37; GO TO UCH);  #.#
  C=44B=>(K_38; GO TO UCH);  #$#
  C=45B=>(K_39; GO TO UCH);  #%#
  C>132B=>GO TO NCHR;
  C>100B=>(K_C-66B; GO TO UCH);
  C>71B=>GO TO NCHR;
  (K_C-57B) LE 0=>GO TO NCHR;
  UCH: VAL_(VAL*40)+K;
  NCHR: 0) FOR P TO 5;
RDX: VAL);

# THIS IS FILE CONVC - CONVERTS A CONSTANT.
  CALL WITH DIRECTORY ENTRY.
  RETURNS  0 IF NOT A CONSTANT
          -1 IF A NUMERIC CONSTANT, IN WHICH CASE VALUE IS IN COMMON
                  CONST.
          POSITIVE POINTER TO FREE ARRAY IF A STRING CONSTANT,
                  IN WHICH CASE ARRAY[0] IS N, AND CONSTANT IS IN
                  WORDS 1-N (AND FIRST WORD IN CONST).
  STCON(V) MAKES A DIRECTORY ENTRY FOR CONSTANT VALUE V AND RETURNS INDEX.
  NEWNAME(I) RETURNS DIR INDEX OF A UNIQUE NAME PREFACED BY % AND
  THE FIRST LETTERS OF THE STRING I. #

SUBR CONVC(C) IS (
 CONST IS COMMON, 1 LONG;
 CINIT=0=>(CINIT_1; FRELOT(CBUF,'CONVC',25,0));
 NC_VAL_OC_0; BAS_-1;
 CC_0;
 W_DNAME(C,CC);
 # CHECK FOR STRING, WHICH IS ONLY MULTI-WORD CASE.#
 (W AND 377B)=47B=>(JNIT=0=>(JNIT_1; CFR_FNEW('CONST',10)#FIXED#);
                 NCFR_1;
                  T1: WW_W RS 8;
                      (W RS 56)=>(
                           CC_CC+1;
                           W_DNAME(C,CC);
                           WW_WW OR ((W AND 377B) LS 56));
                      FADD(CFR,NCFR,WW);
                      (WW RS 56)=>GO TO T1;
                  FREES(CFR,NCFR-1);
                  CONST_FREE(CFR+1);
                  VAL_CFR; GO TO CONVX);
 (WW_W AND 377B)<60B=>GO TO CONVX; WW>71B=>GO TO CONVX;
 # PICK IT APART #
 GO TO T2;
 NXW: CC_CC+1;
      W_DNAME(C,CC);
 T2:  (CH_377B AND W RS N;
       CH=0=>GO TO T3;
       CH GE 60B=>CH LE 71B=>(T5: FADD(CBUF,NC,CH); GO TO T4);
       (CH_CH AND 137B)=102B=>(BAS_NC; GO TO T5);
       BAS_-1;
       CH>100B=>CH LE 132B=>(CH_CH-7; GO TO T5);
       GO TO CONVX;
       T4: 0) FOR N IN 0,8,56;
      GO TO NXW;
 T3: J_NC-1;
 B_10;
 BAS>0=>(BAS=J=>(J_J-1; B_8; GO TO T6);
         B_0;
         (K_FREE(CBUF+I); B_(K-60B)+10*B) FOR I IN BAS+1,1,J;
         J_BAS-1);
 T6: CONST_0;
 (B=8=>(CONST_CONST LS 3) ELSE (CONST_CONST*B);
  (K_FREE(CBUF+I)-60B) GE B=>GO TO CONVX; CONST_CONST+K) FOR I TO J;
 VAL_-1;
 CONVX: VAL);

# STCON(V): THE DIRECTORY ENTRY OF THE CONSTANT V, NAMED BY ITS OCTAL DIGITS (22 FOR A 64 BIT NUMBER, WITHOUT THE LEADING ZEROS) AND A B #
SUBR STCON(V) IS (SCW IS 4 LONG;
                  SCW[0]_SCW[1]_SCW[2]_SCW[3]_0;
                  NS_0; F_0;
                  ((J_(V RS (3*I)) AND 7) NE 0 => F_1;
                   F => PUTC(SCW,NS,60B+J)) FOR I IN 21,-1,0;
                  F=0 => PUTC(SCW,NS,60B);
                  PUTC(SCW,NS,102B);
                  DIR(SCW));

# PUTC(A,N,C): THE CHARACTER C AS CHARACTER N (FROM 0) OF THE NAME IN THE VECTOR A; N GOES UP BY ONE #
SUBR PUTC(A,N,C) IS (
 A[N RS 3]_A[N RS 3] OR (C LS (8*(N AND 7)));
 N_N+1);

SUBR NEWNAME(I) IS (
 NMF IS 3 LONG;
 NMF_((I AND 37777777777B) LS 8) OR 45B; NMF[1]_NMF[2]_0;
 N_0;
 T7: ((NMF RS (8*N)) AND 377B) NE 0 => (N_N+1; GO TO T7);
 J_NEWNUM_NEWNUM+1; TP_100000;
 T10: (J/TP)=0=>(TP_TP/10; GO TO T10);
 T8: JJ_J/TP;
     PUTC(NMF,N,60B+JJ);
     J_J-TP*JJ; TP_TP/10;
     TP => GO TO T8;
 DIR(NMF));

SUBR NEWNAMEG(X) IS NEWNAME(DNAME(X,0))%%
