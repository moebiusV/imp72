TWOSEG;
DM,DN ARE COMMON;                           # THE C SIDE READS THEM (SRC/SHARED.TXT) #
RTN,NRTN,CRTN ARE COMMON;                   # THE TABLE OF SEMANTIC ROUTINES: TWO WORDS EACH, THE ADDRESS OF ITS NAME AND OF THE ROUTINE (C MEMORY); THE IMAGE LEAVES THEM ALONE #
#THIS IS FILE DIR.I10, DIRECTORY PACKAGE FOR IMP COMPILERS.
   DIR(I) RETURNS DIRECTORY INDEX OF ASCII NAME BEGINNING I.
   DPROP(PROP,I) RETURNS VALUE OF PROPERTY PROP FOR ENTRY WHOSE INDEX IS I
   DPROPS(PROP,I,V) SETS VALUE OF PROPERTY PROP TO V FOR ENTRY I.
     ** DPROP AND DPROPS HAVE BEEN EXPANDED IN-LINE  **
     ** REFER TO SPECIAL SYNTAX FOR COMPILER, IMPSYN **
   DSEQ(N) ALLOWS SEQUENCING THROUGH ALL ENTRIES IN THE DIRECTORY.  INITIALLY
      SET N NEGATIVE.  REPEATED CALLS ON DSEQ(N) WILL SET N TO INDEX OF EACH
      ENTRY IN DIR.  AFTER THE LAST ENTRY, N BECOMES NEGATIVE AGAIN.  THE
      VALUE OF DSEQ IS N.
   PNAME(N) PRINTS THE NAME OF DIR ENTRY N.
   GNAME(N) RETURNS THE ADDRESS OF A LOCAL VECTOR WHICH CONTAINS
            THE FIRST 24 CHARACTERS OF THE NAME OF DIR ENTRY N.
   DNAME(I,J) RETURNS JTH WORD (8 ASCII CHARACTERS) OF NAME FOR DIRECTORY
            INDEX I.
   DSTATS() PRINTS DIR STATISTICS.
   RADI50(N) RETURNS THE RADIX50 VALUE OF DIR ENTRY N (FIRST 6 CHARS ONLY)

 HASH-CODED DIRECTORY
 INDEX IS OFF-SET IN FREE ARRAY PRP, WHICH IS COMPOSED OF 3-WORD NODES:

        WORD 1  LEFT HALF    HASH SIBLING INDEX
                RIGHT HALF   ALF INDEX
        WORD 2  LEFT HALF    'ENTRY'     !
                RIGHT HALF   'NODE'      !
        WORD 3  BITS 41-43   'USE'        >  ACCESS TO THESE PROPERTIES
                     39-40   'LXTY'      !   IS GRANTED BY MEANS OF THE
                     37-38   'ISNM'      !   SYNTAX EXTENSIONS OF IMPSYN.
                     35-36   'COM'       !
                     32-34   'ATYPE'     !
                     0-31    'SEM'       !

 THE FREE ARRAY ALF CONCATENATES THE 'NAME'S.  A NAME IS AN ARRAY OF WORDS WITH
 EIGHT CHARACTERS EACH, THE FIRST IN THE LOW BYTE (A STRING CONSTANT IS ONE).  TERMINAL
 NULL CHARACTERS ARE REQUIRED. #

SUBR HASH(NM) IS (#9-BIT HASH CODE#
                  HSH:=NM XOR NM RS 32;
                  HSH:=HSH XOR HSH RS 16;
                  HSH:=HSH XOR HSH RS 9;
                  HSH AND 777B);

SUBR DIR(NM) IS (
 DINIT=0 => (DINIT:=1;
             FRELOT(PRP,'PRP',2100,0); FINCSET(PRP,90); NPRP:=1536;
             FRELOT(ALF,'ALF',900,0); FINCSET(ALF,45); NALF:=1);
 H:=HASH(NM[0]); HN:=2; N:=0;
L0: LASTC(NM[N]) => (N:=N+1; GO TO L0);
L1: (I:=H*3)=0 => I:=3;
L2: Q:=FREE(PRP+I);
 J:=HR(Q);
 J=0 => (FREES(PRP+I,NALF); DM:=DM+1; GO TO L4);
 (NM[K] NE FREE(ALF+J+K) => (HN => (H:=H XOR HN; HN:=HN RS 1; GO TO L1);
                        I1:=I; (I:=HL(Q)) => GO TO L2;
                        GO TO L3))  FOR K TO N;
 GO TO L5;
L3: I:=NPRP; DN:=DN+1;
 FREES(PRP+I1,Q OR I LS 32);
 K:=NPRP+3; FLEN(PRP) LE K => FADDEX(PRP,K);
 FREES(PRP+NPRP,NALF); NPRP:=K;
L4: K:=NALF+N+1; FLEN(ALF) LE K => FADDEX(ALF,K);
 AX:=NALF; NALF:=K;
 FREES(ALF+AX+K,NM[K]) FOR K TO N;
L5: I);

# DSEM(N,S): ENTER THE ROUTINE S AS THE SEMANTIC ROUTINE NAMED N.  THE ORIGINAL PUTS THE ADDRESS OF S IN THE 'SEM' PROPERTY OF THE NAME; HERE THE PROPERTY IS THE ID OF THE ROUTINE, 1 PLUS ITS PLACE IN THE TABLE,
  BECAUSE AN ADDRESS DOES NOT FIT IN IT (THE TABLE IS C MEMORY).  S IS CALLED BY SEMCALL, BELOW #
SUBR DSEM(N,S) IS (
 D,SL,NP,FP,NN ARE LOCAL;
 D:=DIR(N); NP:=LOC(N); FP:=LOC(S);
 SL:=DPROP('SEM',D);
 SL>0 => SL LE NRTN => CCALL strcmp([RTN+(16*(SL-1))],NP)=0 => ([RTN+((16*(SL-1))+8)]:=FP; RETURN 0);        # ENTERED AGAIN: REPLACE #
 NRTN=CRTN => (NN:=CRTN+64; RTN:=CCALL realloc(RTN,16*NN); CCALL memset(RTN+(16*CRTN),0,16*(NN-CRTN)); CRTN:=NN);
 [RTN+(16*NRTN)]:=NP; [RTN+((16*NRTN)+8)]:=FP;
 NRTN:=NRTN+1;
 DPROPS('SEM',D,NRTN);
 0);

# SEMCALL(ID,PARS): CALL THE SEMANTIC ROUTINE WITH ID, WITH THE PARAMETERS IN THE ARRAY PARS, BY REFERENCE.  THE ORIGINAL JUMPS TO THE ADDRESS IN THE JSA INSTRUCTION THAT DOSEM PATCHES; AN IMP WORD CANNOT BE JUMPED TO, SO
  THE CALL IS A CALL THROUGH THE ADDRESS (IMPCALLW, SEE IR2LLX), WITH POINTERS TO A COPY OF THE PARAMETERS (THE ROUTINE MAY CHANGE THEM) #
SEMSTK IS 5000 LONG;
SUBR SEMCALL(ID,PARS) IS (
 SMFR ARE LOCAL;
 ID<1 => (ERROR(0,'ATTEMPT TO EXECUTE UNDEFINED SEMANTIC ROUTINE.'); RETURN 0);
 ID>NRTN => (ERROR(0,'ATTEMPT TO EXECUTE UNDEFINED SEMANTIC ROUTINE.'); RETURN 0);
 SMFR:=SEMSP; SEMSP:=SMFR+5;                  # A FRAME OF FIVE WORDS ON A STACK OF OUR OWN: THE LOCALS OF A ROUTINE ARE ONE SET FOR ALL ITS CALLS, AND A SEMANTIC ROUTINE CALLS SEMCALL AGAIN #
 SEMSP>5000 => (ERROR(0,'SEMANTIC ROUTINES NESTED TOO DEEP.'); SEMSP:=SMFR; RETURN 0);
 SEMSTK[SMFR]:=[LOC(PARS)]; SEMSTK[SMFR+1]:=[LOC(PARS)+1]; SEMSTK[SMFR+2]:=[LOC(PARS)+2]; SEMSTK[SMFR+3]:=[LOC(PARS)+3]; SEMSTK[SMFR+4]:=[LOC(PARS)+4];      # ([X+N] WITH A CONSTANT N IS N WORDS FROM X) #
 SMFR:=CCALL impcallw([RTN+((16*(ID-1))+8)],LOC(SEMSTK[SMFR]),LOC(SEMSTK[SMFR+1]),LOC(SEMSTK[SMFR+2]),LOC(SEMSTK[SMFR+3]),LOC(SEMSTK[SMFR+4]));
 SEMSP:=SEMSP-5;
 SMFR);

# THE TABLE FOR THE IMAGE (U AND V): HOW MANY ROUTINES, THE NAME OF THE I-TH, AND THE TABLE MADE AGAIN IN THE ORDER OF THE NAMES THE IMAGE HAS (ITS TABLES HOLD THE IDS) #
SUBR SEMCOUNT(Z) IS NRTN;

SUBR SEMNAME(I) IS [RTN+(16*I)];

SUBR SEMREMAP(NAMES,N) IS (
 T,I,J ARE LOCAL;
 T:=CCALL calloc(N+1,16);
 I:=0;
 SR1: I<N => (J:=0;
     SR2: J<NRTN => (CCALL strcmp([RTN+(16*J)],[NAMES+(8*I)])=0 => GO TO SR3; J:=J+1; GO TO SR2);
     OUTSTR('imp72: the image uses the routine '); OUTCS([NAMES+(8*I)]);
     OUTSTR(', which this run has not entered'); OUTCHR(12B);
     RETURN 0;
     SR3: [T+(16*I)]:=[RTN+(16*J)]; [T+((16*I)+8)]:=[RTN+((16*J)+8)];
     I:=I+1; GO TO SR1);
 RTN:=T; NRTN:=N; CRTN:=N;
 1);

SUBR DSEQ(N) IS (
 N<0 => (N:=-3; NMARK:=-1);
 NMARK GE 0 => (N:=HL(FREE(PRP+N));
                N=0 => (N:=NMARK; NMARK:=-1));
 NMARK<0 => (L6: N:=N+3;
              N GE 1536 => N:=-1
                      ELSE (FREE(PRP+N)=0 => GO TO L6;
                            NMARK:=N));
N);

SUBR PNAME(DJ) IS (DJ GE 0=>PRINT STG 0,FREE(ALF+HR(FREE(PRP+DJ))));

SUBR DNAME(DI,J) IS FREE(ALF+J+HR(FREE(PRP+DI)));

SUBR GNAME(DJ) IS (
 LCL IS 4 LONG;
 LCL[K]:=DNAME(DJ,K) FOR K TO 2;
 LCL[3]:=0;
 LOC(LCL));

SUBR DSTATS() IS (
 PRINT STG 0,'DIRECTORY HASHED INTO ',IGR 0,DM,STG 0,' BOXES.  OVERFLOW IS ',
   IGR 0,DN,STG 0,'.',/;
 FINAM IS COMMON; (FINAM[5] AND 400B) => DSPILL(0);
 0);

SUBR DSPILL() IS (
 PRINT STG 0, 'HASH CODE   TOKEN', /;
 N:=-1; H1:=-1;
L7: DSEQ(N);
 N GE 0 => (H:=HASH(DNAME(N,0));
            H NE H1 => (PRINT STG 0, '    ', OCT 3, H; H1:=H)
                  ELSE (PRINT STG 0, '       ');
            PRINT STG 0, '    '; PNAME(N); PRINT /; GO TO L7);
 0);

SUBR RADI50(N) IS (
 NX:=DNAME(N,0);
 VAL:=0;
 (C:=CHR(NX,P);
  C=0 => GO TO RDX;
  C=56B=>(K:=37; GO TO UCH);  #.#
  C=44B=>(K:=38; GO TO UCH);  #$#
  C=45B=>(K:=39; GO TO UCH);  #%#
  C>132B=>GO TO NCHR;
  C>100B=>(K:=C-66B; GO TO UCH);
  C>71B=>GO TO NCHR;
  (K:=C-57B) LE 0=>GO TO NCHR;
  UCH: VAL:=(VAL*40)+K;
  NCHR: 0) FOR P TO 5;
RDX: VAL);

# THIS IS FILE CONVC - CONVERTS A CONSTANT.
  CALL WITH DIRECTORY ENTRY.
  RETURNS  0 IF NOT A CONSTANT
          -1 IF A NUMERIC CONSTANT, IN WHICH CASE VALUE IS IN COMMON
                  CONST.
          POSITIVE POINTER TO FREE ARRAY IF A STRING CONSTANT,
                  IN WHICH CASE ARRAY[0] IS N, AND CONSTANT IS IN
                  WORDS 1-N (AND FIRST WORD IN CONST).
  STCON(V) MAKES A DIRECTORY ENTRY FOR CONSTANT VALUE V AND RETURNS INDEX.
  NEWNAME(I) RETURNS DIR INDEX OF A UNIQUE NAME PREFACED BY % AND
  THE FIRST LETTERS OF THE STRING I. #

SUBR CONVC(C) IS (
 CONST IS COMMON, 1 LONG;
 CINIT=0=>(CINIT:=1; FRELOT(CBUF,'CONVC',25,0));
 NC:=VAL:=OC:=0; BAS:=-1;
 CC:=0;
 W:=DNAME(C,CC);
 # CHECK FOR STRING, WHICH IS ONLY MULTI-WORD CASE.#
 CHR0(W)=47B=>(JNIT=0=>(JNIT:=1; CFR:=FNEW('CONST',10)#FIXED#);
                 NCFR:=1;
                  T1: WW:=REST(W);
                      LASTC(W)=>(
                           CC:=CC+1;
                           W:=DNAME(C,CC);
                           WW:=WW OR FRONTLAST(W));
                      FADD(CFR,NCFR,WW);
                      LASTC(WW)=>GO TO T1;
                  FREES(CFR,NCFR-1);
                  CONST:=FREE(CFR+1);
                  VAL:=CFR; GO TO CONVX);
 (WW:=CHR0(W))<60B=>GO TO CONVX; WW>71B=>GO TO CONVX;
 # PICK IT APART #
 GO TO T2;
 NXW: CC:=CC+1;
      W:=DNAME(C,CC);
 T2:  (CH:=377B AND W RS N;
       CH=0=>GO TO T3;
       CH GE 60B=>CH LE 71B=>(T5: FADD(CBUF,NC,CH); GO TO T4);
       (CH:=CH AND 137B)=102B=>(BAS:=NC; GO TO T5);
       BAS:=-1;
       CH>100B=>CH LE 132B=>(CH:=CH-7; GO TO T5);
       GO TO CONVX;
       T4: 0) FOR N IN CHFIRST,CHSTEP,CHEND;
      GO TO NXW;
 T3: J:=NC-1;
 B:=10;
 BAS>0=>(BAS=J=>(J:=J-1; B:=8; GO TO T6);
         B:=0;
         (K:=FREE(CBUF+I); B:=(K-60B)+10*B) FOR I IN BAS+1,1,J;
         J:=BAS-1);
 T6: CONST:=0;
 (B=8=>(CONST:=CONST LS 3) ELSE (CONST:=CONST*B);
  (K:=FREE(CBUF+I)-60B) GE B=>GO TO CONVX; CONST:=CONST+K) FOR I TO J;
 VAL:=-1;
 CONVX: VAL);

# STCON(V): THE DIRECTORY ENTRY OF THE CONSTANT V, NAMED BY ITS OCTAL DIGITS (22 FOR A 64 BIT NUMBER, WITHOUT THE LEADING ZEROS) AND A B #
SUBR STCON(V) IS (SCW IS 4 LONG;
                  SCW[0]:=SCW[1]:=SCW[2]:=SCW[3]:=0;
                  K:=BYTEP SCW<7,36>; F:=0;
                  ((J:=(V RS (3*I)) AND 7) NE 0 => F:=1;
                   F => <+K>:=60B+J) FOR I IN 21,-1,0;
                  F=0 => <+K>:=60B;
                  <+K>:=102B;
                  DIR(SCW));

SUBR NEWNAME(I) IS (
 NMF IS 3 LONG;
 NMF:=PREP(PFX4(I),45B); NMF[1]:=NMF[2]:=0;
 K:=BYTEP NMF<7,36>; WHILE <+K> DO 0; K:=K-1;
 J:=NEWNUM:=NEWNUM+1; TP:=100000;
 T10: (J/TP)=0=>(TP:=TP/10; GO TO T10);
 T8: JJ:=J/TP;
     <+K>:=60B+JJ;
     J:=J-TP*JJ; TP:=TP/10;
     TP => GO TO T8;
 DIR(NMF))%%
