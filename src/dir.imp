TWOSEG;
DM,DN ARE COMMON;                           # THE C SIDE READS THEM (SRC/SHARED.TXT) #
#THIS IS FILE DIR, THE DIRECTORY PACKAGE FOR THE 64 BIT PORT: HASH, DIR, DSEQ, DNAME, PNAME, GNAME, DSTATS, DSPILL, RADI50,
   CONVC, STCON AND NEWNAME OF DECUS/DIR.IMC.  A NAME IS KEPT PACKED, FIVE 7 BIT CHARACTERS TO A WORD, AS ON THE PDP-10, AND
   DIRP IS THE DIR OF THE ORIGINAL.  A STRING CONSTANT OF THIS PORT IS BYTES (8 BITS, THE FIRST CHARACTER IN THE LOW BYTE,
   ENDED BY A NUL), SO DIR OF A CONSTANT, WHICH THE ORIGINAL CALLS WITH THE PACKED CONSTANT, PACKS IT FIRST; DIRW DOES THE
   SAME FOR A TOKEN HELD ONE CHARACTER TO A WORD, AS LEX MAKES IT.

 THE NAME NM IS AN ARRAY OF WORDS, FIVE 7 BIT CHARACTERS EACH, LEFT JUSTIFIED
 IN THE LOW 36 BITS, ENDING WITH A WORD WHOSE LAST CHARACTER IS NUL, AS BEFORE.
 A NODE OF PRP HAS THREE WORDS, LIKE THE ORIGINAL, BUT THE HALVES OF A WORD
 ARE 32 BITS (THE LEFT ONE IS WORD RS HSH):

        WORD 1  LEFT   HASH SIBLING INDEX
                RIGHT  ALF INDEX
        WORD 2  LEFT   'ENTRY'     RIGHT  'NODE'
        WORD 3  THE SMALL FIELDS ABOVE 'SEM' (DPROP IN C) AND 'SEM' #

SUBR HASH(NM) IS (
 # A SHIFT BY 18 IS A HALFWORD MOVE TO THE TRANSLATOR (SYNTAX.IMC: "A LS 18"),
   AND HALVES ARE 32 BITS HERE; THE TRUE SHIFT BY 18 IS TWO BY 9.  THE ORIGINAL KEEPS THE HASH IN A VARIABLE
   CALLED HSH, WHICH IS A MACRO HERE (THE WIDTH OF A HALF): THE HASH WAS A CONSTANT AND ALL NAMES WENT INTO
   THREE BOXES.  IT IS HV. #
 HV_NM XOR ((NM RS 9) RS 9);
 HV_HV XOR HV RS 9;
 HV AND 777B);

# DIRP(NM): THE DIR OF THE ORIGINAL, FOR A NAME PACKED FIVE 7 BIT CHARACTERS TO A WORD #
SUBR DIRP(NM) IS (
 DINIT=0 => (DINIT_1;
             FRELOT(PRP,'PRP',2100,0); FINCSET(PRP,90); NPRP_1536;
             FRELOT(ALF,'ALF',900,0); FINCSET(ALF,45); NALF_1);
 H_HASH(NM[0]); HN_2; N_0;
# [ALFX+K] OF THE ORIGINAL IS A WORD ADDRESS PLUS A WORD COUNT; HERE ADDRESSES ARE
   BYTES, SO THE ARRAY IS ADDRESSED BY INDEX WITH FREE AND FREES. #
L0: (NM[N] AND 377B) => (N_N+1; GO TO L0);
L1: (I_H*3)=0 => I_3;
L2: Q_FREE(PRP+I);
 J_Q AND HMASK;
 J=0 => (FREES(PRP+I,NALF); DM_DM+1; GO TO L4);
 (NM[K] NE FREE(ALF+J+K) => (HN => (H_H XOR HN; HN_HN RS 1; GO TO L1);
                        I1_I; (I_Q RS HSH) => GO TO L2;
                        GO TO L3))  FOR K TO N;
 GO TO L5;
L3: I_NPRP; DN_DN+1;
 FREES(PRP+I1,Q OR I LS HSH);
 K_NPRP+3; FLEN(PRP) LE K => FADDEX(PRP,K);
 FREES(PRP+NPRP,NALF); NPRP_K;
L4: K_NALF+N+1; FLEN(ALF) LE K => FADDEX(ALF,K);
 AX_NALF; NALF_K;
 FREES(ALF+AX+K,NM[K]) FOR K TO N;
L5: I);

SUBR DSEQ(N) IS (
 N<0 => (N_-3; NMARK_-1);
 NMARK GE 0 => (N_FREE(PRP+N) RS HSH;
                N=0 => (N_NMARK; NMARK_-1));
 NMARK<0 => (L6: N_N+3;
              N GE 1536 => N_-1
                      ELSE (FREE(PRP+N)=0 => GO TO L6;
                            NMARK_N));
N);

SUBR DNAME(DI,J) IS FREE(ALF+J+(FREE(PRP+DI) AND HMASK));

# DIR(S): THE DIRECTORY INDEX OF THE NAME THE BYTES AT S SPELL (A STRING CONSTANT OF THIS PORT) #
SUBR DIR(S) IS (
 NMW IS 100 LONG;
 C,N,K,W,M ARE LOCAL;
 N_0; K_0; W_0; M_29;
 DR1: C_377B AND (S[N RS 3] RS (8*(N AND 7)));
 W_W OR (C LS M);
 C=0 => (NMW[K]_W; GO TO DR2);
 N_N+1; M_M-7;
 M<0 => (NMW[K]_W; K_K+1; W_0; M_29);
 GO TO DR1;
 DR2: DIRP(NMW[0]));

# DIRW(TOK): THE SAME FOR A TOKEN IN FREE ARRAY TOK, A CHARACTER TO A WORD, ENDED BY A 0 #
SUBR DIRW(TOK) IS (
 NMV IS 100 LONG;
 C,N,K,W,M ARE LOCAL;
 N_0; K_0; W_0; M_29;
 DW1: C_FREE(TOK+N);
 W_W OR ((C AND 177B) LS M);
 C=0 => (NMV[K]_W; GO TO DW2);
 N_N+1; M_M-7;
 M<0 => (NMV[K]_W; K_K+1; W_0; M_29);
 GO TO DW1;
 DW2: DIRP(NMV[0]));

# UNPK(DJ,B): THE NAME OF ENTRY DJ AS BYTES IN THE VECTOR B, ENDED BY A NUL, FOR PRINT #
SUBR UNPK(DJ,B) IS (
 W,J,M,C,N,Z ARE LOCAL;
 B[Z]_0 FOR Z TO 39;
 N_0; J_0;
 UP1: W_DNAME(DJ,J);
 (C_177B AND (W RS (29-7*M));
  C=0 => RETURN N;
  B[N RS 3]_B[N RS 3] OR (C LS (8*(N AND 7)));
  N_N+1) FOR M TO 4;
 J_J+1; GO TO UP1);

SUBR PNAME(DJ) IS (
 NB IS 40 LONG;
 DJ GE 0 => (UNPK(DJ,NB); PRINT STG 0,NB);
 0);

SUBR GNAME(DJ) IS (
 LCL IS 5 LONG;
 LCL[K]_DNAME(DJ,K) FOR K TO 5;
 LCL[4]_LCL[4] AND NOT 377B;
 LOC(LCL));

SUBR DSTATS() IS (
 PRINT STG 0,'DIRECTORY HASHED INTO ',IGR 0,DM,STG 0,' BOXES.  OVERFLOW IS ',
   IGR 0,DN,STG 0,'.',/;
 FINAM IS COMMON; (FINAM[5] AND 400B) => DSPILL(0);
 0);

SUBR DSPILL() IS (
 PRINT STG 0, 'HASH CODE   TOKEN', /;
 N_-1; H1_-1;
L7: DSEQ(N);
 N GE 0 => (H_HASH(DNAME(N,0));
            H NE H1 => (PRINT STG 0, '    ', OCT 3, H; H1_H)
                  ELSE (PRINT STG 0, '       ');
            PRINT STG 0, '    '; PNAME(N); PRINT /; GO TO L7);
 0);

# RADI50(N): THE RADIX50 VALUE OF THE FIRST SIX CHARACTERS OF ENTRY N.  THE ORIGINAL STEPS A BYTE POINTER OVER THE PACKED NAME; THE CHARACTERS ARE TAKEN BY SHIFTING HERE #
SUBR RADI50(N) IS (
 NX IS 2 LONG; NX[1]_0;
 (NX_DNAME(N,0)) AND 377B => (NX[1]_DNAME(N,1) AND 774000000000B);
 VAL_0;
 (C_177B AND (NX[Q RS 2] RS (29-7*(Q AND 3)));
  C=0 => RETURN VAL;
  C=56B=>(K_37; GO TO UCH);  #.#
  C=44B=>(K_38; GO TO UCH);  #$#
  C=45B=>(K_39; GO TO UCH);  #%#
  C>132B=>GO TO NCHR;
  C>100B=>(K_C-66B; GO TO UCH);
  C>71B=>GO TO NCHR;
  (K_C-57B) LE 0=>GO TO NCHR;
  UCH: VAL_(VAL*40)+K;
  NCHR: 0) FOR Q TO 5;
 VAL);

# CONVC(C): CONVERTS A CONSTANT, AS IN THE ORIGINAL.  THE CONSTANT IS 64 BITS: A 12 DIGIT OCTAL CONSTANT WITH BIT 35 SET IS THE NEGATIVE 36 BIT NUMBER IT IS ON THE PDP-10,
  SO THAT 777777777777B IS STILL -1 #
SUBR CONVC(C) IS (
 CONST IS COMMON, 1 LONG;
 CINIT=0=>(CINIT_1; FRELOT(CBUF,'CONVC',25,0));
 NC_VAL_OC_0; BAS_-1;
 CC_0;
 W_DNAME(C,CC);
 # CHECK FOR STRING, WHICH IS ONLY MULTI-WORD CASE.#
 (W RS 29)=47B=>(JNIT=0=>(JNIT_1; CFR_FALLOT('CONST',10)#FIXED#);
                 NCFR_1;
                  T1: WW_U36(W LS 7);
                      (377B AND W)=>(
                           CC_CC+1;
                           W_DNAME(C,CC);
                           WW_WW OR 376B AND W RS 28);
                      FADD(CFR,NCFR,WW);
                      (377B AND WW)=>GO TO T1;
                  FREES(CFR,NCFR-1);
                  CONST_FREE(CFR+1);
                  VAL_CFR; GO TO CONVX);
 (WW_W RS 29)<60B=>GO TO CONVX; WW>71B=>GO TO CONVX;
 # PICK IT APART #
 GO TO T2;
 NXW: CC_CC+1;
      W_DNAME(C,CC);
 T2:  (CH_177B AND W RS N;
       CH=0=>GO TO T3;
       CH GE 60B=>CH LE 71B=>(T5: FADD(CBUF,NC,CH); GO TO T4);
       (CH_CH AND 137B)=102B=>(BAS_NC; GO TO T5);
       BAS_-1;
       CH>100B=>CH LE 132B=>(CH_CH-7; GO TO T5);
       GO TO CONVX;
       T4: 0) FOR N IN 29,-7,1;
      GO TO NXW;
 T3: J_NC-1;
 B_10;
 BAS>0=>(BAS=J=>(J_J-1; B_8; GO TO T6);
         B_0;
         (K_FREE(CBUF+I); B_(K-60B)+10*B) FOR I IN BAS+1,1,J;
         J_BAS-1);
 T6: CONST_0;
 (B=8=>(CONST_CONST LS 3) ELSE (CONST_CONST*B);
  (K_FREE(CBUF+I)-60B) GE B=>GO TO CONVX; CONST_CONST+K) FOR I TO J;
 B=8 => J=11 => (U36(CONST) AND 0400000000000B) NE 0 => CONST_CONST-01000000000000B;
 VAL_-1;
 CONVX: VAL);

# STCON(V): MAKES A DIRECTORY ENTRY FOR THE CONSTANT V, NAMED IN OCTAL, AND RETURNS ITS INDEX.  A NUMBER OF 36 BITS (-2**35 TO 2**35-1) HAS THE 12 DIGITS OF THE PDP-10, A
  NEGATIVE ONE AS 36 BITS; THE OTHERS HAVE 22.  A LEADING 0 KEEPS A POSITIVE NUMBER WITH BIT 35 SET FROM BEING READ BACK AS NEGATIVE BY CONVC #
SUBR STCON(V) IS (SCW IS 6 LONG;
                  SCW[Z]_0 FOR Z TO 5;
                  U_V; NS_0;
                  V<0 => V GE -34359738368 => U_V AND 0777777777777B;
                  (V>0 => (U RS 35) NE 0 => (U RS 36)=0 => PUTC(SCW,NS,60B));
                  F_0;
                  ((J_(U RS (3*I)) AND 7) NE 0 => F_1;
                   F => PUTC(SCW,NS,60B+J)) FOR I IN 21,-1,0;
                  F=0 => PUTC(SCW,NS,60B);
                  PUTC(SCW,NS,102B);
                  DIRP(SCW));

# PUTC(A,N,C): THE CHARACTER C AS CHARACTER N (FROM 0) OF THE NAME PACKED IN THE VECTOR A; N GOES UP BY ONE #
SUBR PUTC(A,N,C) IS (
 A[N/5]_A[N/5] OR (C LS (29-7*(N-5*(N/5))));
 N_N+1);

# NEWNAME(S): THE DIRECTORY INDEX OF A UNIQUE NAME, % AND THE FIRST LETTERS OF THE STRING OF BYTES S AND A NUMBER (THE ORIGINAL TAKES THE PACKED NAME) #
SUBR NEWNAME(S) IS (
 W,N,C ARE LOCAL;
 W_0;
 (C_377B AND (S[N RS 3] RS (8*(N AND 7)));
  C=0 => GO TO NN1;
  W_W OR (C LS (29-7*N))) FOR N TO 3;
 NN1: NEWNAMEP(W));

# NEWNAMEG(X): THE SAME FOR THE NAME OF DIRECTORY ENTRY X #
SUBR NEWNAMEG(X) IS NEWNAMEP(DNAME(X,0));

SUBR NEWNAMEP(I) IS (
 FOO IS 4 LONG;
 FOO_((NOT 1) AND (I RS 7)) OR (45B LS 29); FOO[1]_FOO[2]_FOO[3]_0;
 SH_29; W_0; J_NEWNUM_NEWNUM+1; TP_100000;
 T10: (J/TP)=0=>(TP_TP/10; GO TO T10);
 T8: (FOO[W] AND (177B LS SH))=>GO TO T9;
     JJ_J/TP;
     FOO[W]_FOO[W] OR (60B+JJ) LS SH;
     J_J-TP*JJ; TP_TP/10;
     TP=>(T9: (SH_SH-7)<0=>(SH_29; W_W+1);
          GO TO T8);
 DIRP(FOO))%%
