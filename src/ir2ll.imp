#THIS IS FILE IR2LL, THE LLVM IR WRITER: THE TRANSLATION OF TOOLS/IR2LL.C (WHICH THE SEED KEEPS) INTO IMP, SO THAT NO C IS LEFT IN IT BUT THE SHIM STAGE0/IR2LL_SHIM.C THAT STAGE0/LLVMORC.C CALLS.  NOT IN THE TAPE: THE ORIGINAL'S OMOD
 WRITES PDP-10 OBJECT CODE.  IR2LLRUN(INF,OUTF,PTR32) READS THE TEXT OF THE PCC IR THAT THE CODE GENERATOR WRITES (SRC/PCCIR/IX.IMP: "* TEXT" LINES, "! TYPE FLAGS PROLAB TMPBASE LBLBASE NAME", "^ N", '" OP TYPE QUAL ...' ONE TREE NODE A LINE, PREORDER,
 AND "% AUTOS RETLAB TMPEND LBLEND NAME") FROM THE FILE INF AND WRITES THE MODULE OF LLVM IR AS TEXT TO THE FILE OUTF; PTR32 IS 1 WHEN THE HOST'S POINTERS ARE 32 BITS.  IT RETURNS 0.  THE TEXT IS THE C'S BYTE FOR BYTE.  THE CODE GENERATOR OF THIS COMPILER CAN NAME ONLY 2047 REGISTERS IN A COMPILATION (AREG1 IN SRC/PCCIR/IMPSEM.IMP: THE INDEX IS 11 BITS IN THE RECORDS), SO THE WRITER IS IN TWO FILES: THIS ONE HAS
 THE ENTRY, THE READING AND THE DATA, AND SRC/IR2LLX.IMP THE EXPRESSIONS AND THE STATEMENTS.  WHAT THEY SHARE IS COMMON, DECLARED THE SAME IN BOTH (THE IMAGE LEAVES ALL OF IT OUT: IMGSKIP IN SRC/IMAGE.IMP).
 A NODE IS EIGHT WORDS (OP, TYPE, VALUE, REGISTER OR TEMP NUMBER, NAME, LEFT, RIGHT; THE FIELDS ARE [N]..[N+6]: A BRACKET WITH A LITERAL INDEX COUNTS WORDS).  THE TEXT IS BUILT IN BUFFERS OF OUR OWN (IRLPC, IRLPS, IRLPN:
 THE C LIBRARY'S OPEN_MEMSTREAM HAS AN UNDERSCORE, AND A NUMBER IS WRITTEN WITHOUT A CALL THAT TAKES A 64 BIT VALUE, AS IN IX.IMP); THE NODES AND THE STRINGS OF A FUNCTION ARE IN AN ARENA THAT IS GIVEN BACK AT ITS END.
 THE ROUTINES THAT CALL ONE ANOTHER WITHOUT END (THE EXPRESSIONS: IRLEXPR, IRLEXC, IRLLOAD, IRLPLACE, IRLSTORE, IRLCOMPARE, IRLCALLEXPR, AND IRLREAD AND IRLNOTE FOR THE TREES) KEEP NOTHING IN THEIR VARIABLES ACROSS A CALL (A VARIABLE IS ONE WORD
 OF STORAGE, NOT A PLACE ON A STACK): WHAT THEY NEED AFTERWARDS THEY PUSH ON THE STACK IRLSTK (IRLPUSH, IRLPOP) AND TAKE BACK, AND THEY COPY THEIR ARGUMENTS INTO VARIABLES AT ONCE, BECAUSE AN ARGUMENT IS A REFERENCE TO A WORD THE CALLER MAY CHANGE.
 THE OPERATORS AND TYPES ARE PCC'S: NAME 2, ICON 4, REG 6, TEMP 8, PLUS 10, MINUS 11, DIV 12, MOD 13, MUL 14, AND 15, OR 16, ER 17, LS 18, RS 19, COMPL 20, UMUL 23, UMINUS 24, EQ 25, NE 26, LE 27, LT 28, GE 29, GT 30, ULE 31, ULT 32,
 UGE 33, UGT 34, CBRANCH 35, SCONV 37, PCONV 38, CALL 41, UCALL 42, CM 48, ASSIGN 49, GOTO 54; UCHAR 3, INT 6, LONG 8, ULONG 9, DOUBLE 13.  THE SETS OF NAMES ARE NUMBERED: CALLED 0, DATAREFS 1, DATADEFS 2, FUNCS 3, CFUNCS 4, LOCALS 5.
 THE BUFFERS ARE NUMBERED: THE FUNCTION BEING WRITTEN 0, THE GLOBAL VARIABLES 1, THE FUNCTIONS 2, THE STRING BEING MADE 3, AN ASSEMBLER STRING AS AN LLVM CONSTANT 4.#

IRLIN,IRLOUTP,IRLP32,IRLSP,IRLCH,IRLTOP,IRLEND,IRLNVR,IRLNCM,IRLNDQ,IRLDLABEL,IRLDSTRING,IRLUSEJ,IRLNVAL,IRLTERM,IRLNDEAD,IRLNT,IRLMAXARG,IRLPOS,IRLV,IRLLEN ARE COMMON;
IRLBB,IRLBL,IRLBC ARE COMMON,6 LONG;
IRLSETV IS COMMON,24576 LONG;
IRLSETN IS COMMON,6 LONG;
IRLTT IS COMMON,8192 LONG;
IRLSTM IS COMMON,100000 LONG;
IRLLAB IS COMMON,100000 LONG;
IRLSTK IS COMMON,200000 LONG;
IRLDQ IS COMMON,4096 LONG;
IRLVRS,IRLVRN,IRLVRZ ARE COMMON,4096 LONG;
IRLCMN,IRLCMZ,IRLCML ARE COMMON,4096 LONG;
IRLLINE IS COMMON,80 LONG;
IRLHDR IS COMMON,90 LONG;
IRLFNM IS COMMON,33 LONG;
IRLTOKB IS COMMON,70 LONG;
IRLSYMB IS COMMON,33 LONG;
IRLNMB IS COMMON,38 LONG;
IRLDG IS COMMON,24 LONG;
IRLZERO IS COMMON,2 LONG;
IRLSTP IS COMMON,260 LONG;

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE (AS IN TOOLS/IMPRENAME.IMP) #
SUBR IRLGB(P,I) IS (
 Q ARE LOCAL;
 Q_BYTEP [P]<7,36>; Q_Q+I; <+Q>);

SUBR IRLPUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q_BYTEP [P]<7,36>; Q_Q+I; <+Q>_V; 0);

# AN ERROR: ONLY THE MESSAGE AND WHAT IT IS ABOUT ON THE STANDARD ERROR, AND THE END (IR2LL: MSG: LINE) #
SUBR IRLDIE(M,A) IS (
 CCALL WRITE(2,LOC('ir2ll: '),7);
 CCALL WRITE(2,M,CCALL STRLEN(M));
 CCALL WRITE(2,LOC(': '),2);
 CCALL WRITE(2,A,CCALL STRLEN(A));
 IRLPUTB(LOC(IRLDG),0,10); CCALL WRITE(2,LOC(IRLDG),1);
 CCALL EXIT(1);
 0);

# WHAT IS NOT TO BE DONE: THE TEXT AND A NUMBER ON THE STANDARD ERROR, AND THE END #
SUBR IRLERRN(S,V) IS (
 IRLRST(3); IRLPS(3,S); IRLPN(3,V); IRLPC(3,10);
 CCALL WRITE(2,IRLBB[3],IRLBL[3]);
 CCALL EXIT(1);
 0);

# ---- THE STACK FOR WHAT A ROUTINE NEEDS AFTER IT CALLS ITSELF ---- #
SUBR IRLPUSH(V) IS (
 IRLSP GE 199000 => IRLDIE(LOC('tree too deep'),LOC(IRLZERO));
 IRLSTK[IRLSP]_V; IRLSP_IRLSP+1; 0);

SUBR IRLPOP(Z) IS (IRLSP_IRLSP-1; IRLSTK[IRLSP]);

# ---- THE ARENA: CHUNKS OF A MEGABYTE, LINKED BY THE FIRST WORD, GIVEN BACK ALL AT ONCE ---- #
SUBR IRLALLOC(N) IS (
 M,R,S,Q ARE LOCAL;
 M_(N+7) AND (NOT 7);
 (IRLTOP+M)>IRLEND => (S_1048576; M>S => S_M;
                       Q_CCALL MALLOC(S+8);
                       Q=0 => IRLDIE(LOC('out of memory'),LOC(IRLZERO));
                       [Q]_IRLCH; IRLCH_Q; IRLTOP_Q+8; IRLEND_(Q+8)+S);
 R_IRLTOP; IRLTOP_IRLTOP+M;
 CCALL MEMSET(R,0,M);
 R);

SUBR IRLARST(Z) IS (
 C,Q ARE LOCAL;
 C_IRLCH;
 AR1: C NE 0 => (Q_[C]; CCALL FREE(C); C_Q; GO TO AR1);
 IRLCH_0; IRLTOP_0; IRLEND_0; 0);

# A COPY OF THE STRING S IN THE ARENA #
SUBR IRLSDUP(S) IS (
 L,R ARE LOCAL;
 L_CCALL STRLEN(S);
 R_IRLALLOC(L+1);
 CCALL MEMCPY(R,S,L+1);
 R);

# ---- THE BUFFERS ---- #
SUBR IRLRST(B) IS (
 K ARE LOCAL;
 K_B;
 IRLBL[K]_0; IRLPUTB(IRLBB[K],0,0); 0);

SUBR IRLGROW(B,N) IS (
 K,NC ARE LOCAL;
 K_B;
 NC_IRLBC[K]*2; NC<((IRLBL[K]+N)+64) => NC_(IRLBL[K]+N)+64;
 IRLBB[K]_CCALL REALLOC(IRLBB[K],NC);
 IRLBB[K]=0 => IRLDIE(LOC('out of memory'),LOC(IRLZERO));
 IRLBC[K]_NC; 0);

# A BYTE, A STRING AND A DECIMAL NUMBER ONTO THE BUFFER B #
SUBR IRLPC(B,C) IS (
 K,Q ARE LOCAL;
 K_B;
 (IRLBL[K]+2)>IRLBC[K] => IRLGROW(K,2);
 Q_IRLBB[K]+IRLBL[K];
 IRLPUTB(Q,0,C); IRLPUTB(Q,1,0);
 IRLBL[K]_IRLBL[K]+1; 0);

SUBR IRLPS(B,S) IS (
 K,Q,L ARE LOCAL;
 K_B;
 L_CCALL STRLEN(S);
 ((IRLBL[K]+L)+1)>IRLBC[K] => IRLGROW(K,L+1);
 Q_IRLBB[K]+IRLBL[K];
 CCALL MEMCPY(Q,S,L+1);
 IRLBL[K]_IRLBL[K]+L; 0);

SUBR IRLPN(B,V) IS (
 K,W,R,NG,J ARE LOCAL;
 K_B;
 W_V; NG_0; W<0 => NG_1; J_0;
 PN1: R_W-((W/10)*10); R<0 => R_0-R;
 IRLDG[J]_R; J_J+1; W_W/10; W NE 0 => GO TO PN1;
 NG NE 0 => IRLPC(K,45);
 PN2: J_J-1; IRLPC(K,48+IRLDG[J]); J>0 => GO TO PN2;
 0);

# THE TWO UPPER CASE HEXADECIMAL DIGITS OF C (THE C'S %02X) #
SUBR IRLPH(B,C) IS (
 K,V ARE LOCAL;
 K_B; V_C AND 255;
 IRLPC(K,((V RS 4)<10 => 48+(V RS 4) ELSE 55+(V RS 4)));
 V_V AND 15;
 IRLPC(K,(V<10 => 48+V ELSE 55+V));
 0);

# THE ADDRESS OF A GLOBAL NAME, @"S" #
SUBR IRLGN(B,S) IS (
 K ARE LOCAL;
 K_B;
 IRLPS(K,LOC('@"')); IRLPS(K,S); IRLPC(K,34); 0);

# THE STRING IN BUFFER 3 AS A STRING OF THE ARENA #
SUBR IRLSVE(Z) IS IRLSDUP(IRLBB[3]);

# THE STRING "%" CH V: %v7, %a0, %t100, %n9 #
SUBR IRLVN(CH,V) IS (
 IRLRST(3); IRLPC(3,37); IRLPC(3,CH); IRLPN(3,V);
 IRLSVE(0));

SUBR IRLINIT(Z) IS (
 K ARE LOCAL;
 K_0;
 IT1: IRLBB[K]=0 => (IRLBB[K]_CCALL MALLOC(4096); IRLBC[K]_4096);
 IRLRST(K);
 K_K+1; K<5 => GO TO IT1;
 K_0;
 IT2: IRLSETN[K]_0; K_K+1; K<6 => GO TO IT2;
 IRLNVR_0; IRLNCM_0; IRLNDQ_0; IRLDLABEL_0; IRLDSTRING_0; IRLUSEJ_0; IRLSP_0;
 IRLCH_0; IRLTOP_0; IRLEND_0;
 IRLNVAL_0; IRLTERM_0; IRLNDEAD_0; IRLNT_0; IRLMAXARG_0-1;
 0);

# ---- THE SETS OF NAMES (CALLED, DATAREFS, DATADEFS, FUNCS, CFUNCS, LOCALS): UP TO 4096 EACH, THE NAMES COPIED ---- #
SUBR IRLINSET(K,X) IS (
 I,B,S ARE LOCAL;
 S_K;
 B_S*4096; I_0;
 SI1: I<IRLSETN[S] => (CCALL STRCMP(IRLSETV[B+I],X)=0 => RETURN 1; I_I+1; GO TO SI1);
 0);

SUBR IRLADD(K,X) IS (
 S,Y ARE LOCAL;
 S_K; Y_X;
 IRLINSET(S,Y) NE 0 => RETURN 0;
 IRLSETN[S]<4096 => (IRLSETV[(S*4096)+IRLSETN[S]]_CCALL STRDUP(Y); IRLSETN[S]_IRLSETN[S]+1);
 0);

# THE C FUNCTIONS (CCALL'S, MARKED WITH A CFUNC COMMENT LINE): THEY RETURN A C LONG, NOT A WORD; WHAT THE IR DEFINES, AND THE RUNTIME LIBRARY, RETURNS A WORD #
SUBR IRLISC(NM) IS (
 IRLINSET(3,NM) NE 0 => RETURN 0;
 CCALL STRCMP(NM,LOC('_setjmp'))=0 => RETURN 1;
 CCALL STRCMP(NM,LOC('setjmp'))=0 => RETURN 1;
 CCALL STRCMP(NM,LOC('longjmp'))=0 => RETURN 1;
 CCALL STRCMP(NM,LOC('_longjmp'))=0 => RETURN 1;
 IRLINSET(4,NM));

# THE NUMBER OF FIXED PARAMETERS OF THE C LIBRARY'S VARIADIC FUNCTIONS THAT PROGRAMS CALL, ELSE 0 #
SUBR IRLVARF(NM) IS (
 CCALL STRCMP(NM,LOC('printf'))=0 => RETURN 1;
 CCALL STRCMP(NM,LOC('fprintf'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('sprintf'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('snprintf'))=0 => RETURN 3;
 CCALL STRCMP(NM,LOC('dprintf'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('scanf'))=0 => RETURN 1;
 CCALL STRCMP(NM,LOC('sscanf'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('fscanf'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('syslog'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('open'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('fcntl'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('ioctl'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('execl'))=0 => RETURN 2;
 CCALL STRCMP(NM,LOC('execlp'))=0 => RETURN 2;
 0);

# ---- LLVM TYPES ---- #
SUBR IRLLTYPE(T) IS (
 T=3 => RETURN LOC('i8');
 T=6 => RETURN LOC('i32');
 T=13 => RETURN LOC('double');
 LOC('i64'));

SUBR IRLBITS(T) IS (
 T=3 => RETURN 8;
 T=6 => RETURN 32;
 64);

SUBR IRLISU(T) IS (
 T=9 => RETURN 1;
 T=3 => RETURN 1;
 0);

SUBR IRLLALIGN(T) IS (
 T=3 => RETURN LOC('1');
 T=6 => RETURN LOC('4');
 IRLP32 NE 0 => RETURN LOC('4');
 LOC('8'));

# THE TYPE OF A POINTER SIZED INTEGER #
SUBR IRLIPT(Z) IS (
 IRLP32 NE 0 => RETURN LOC('i32');
 LOC('i64'));

# ---- THE TEXT OF AN INSTRUCTION: A BLOCK THAT WAS ENDED IS FOLLOWED BY ONE THAT NOTHING REACHES; IRLI BEGINS ONE, IRLE ENDS IT, IRLTE ENDS ONE THAT TERMINATES THE BLOCK ---- #
SUBR IRLI(Z) IS (
 IRLTERM NE 0 => (IRLPS(0,LOC('dead')); IRLPN(0,IRLNDEAD); IRLPC(0,58); IRLPC(0,10); IRLNDEAD_IRLNDEAD+1; IRLTERM_0);
 IRLPS(0,LOC('  ')); 0);

SUBR IRLE(Z) IS (IRLPC(0,10); 0);

SUBR IRLTE(Z) IS (IRLPC(0,10); IRLTERM_1; 0);

# A NAME "%vN": THE SSA VALUES OF THE FUNCTION #
SUBR IRLNEWVAL(Z) IS (
 R ARE LOCAL;
 R_IRLVN(118,IRLNVAL); IRLNVAL_IRLNVAL+1; R);

# ---- READING: THE LINE BEING SCANNED IS AT IRLPOS ---- #
SUBR IRLISSP(C) IS (
 C=32 => RETURN 1;
 ((C GE 9) AND (C LE 13)) => RETURN 1;
 0);

SUBR IRLSKW(Z) IS (
 C ARE LOCAL;
 SK1: C_IRLGB(IRLPOS,0);
 IRLISSP(C) NE 0 => (IRLPOS_IRLPOS+1; GO TO SK1);
 0);

# A DECIMAL NUMBER (THE C'S %D, %LD, %LLD): BLANKS, A SIGN, DIGITS; 1 AND THE NUMBER IN IRLV, ELSE 0.  A NUMBER TOO LARGE IS THE LARGEST, AS STRTOLL'S IS #
SUBR IRLSCI(Z) IS (
 C,NG,ACC,D,OV,LIM,V ARE LOCAL;
 IRLSKW(0); C_IRLGB(IRLPOS,0); NG_0;
 ((C=45) OR (C=43)) => (C=45 => NG_1; IRLPOS_IRLPOS+1; C_IRLGB(IRLPOS,0));
 ((C<48) OR (C>57)) => RETURN 0;
 LIM_0-922337203685477580; ACC_0; OV_0;
 SC1: ((C GE 48) AND (C LE 57)) => (D_C-48;
        OV=0 => (((ACC<LIM) OR ((ACC=LIM) AND (D>8))) => OV_1 ELSE ACC_(ACC*10)-D);
        IRLPOS_IRLPOS+1; C_IRLGB(IRLPOS,0); GO TO SC1);
 OV NE 0 => (NG NE 0 => V_(0-9223372036854775807)-1 ELSE V_9223372036854775807)
   ELSE (NG NE 0 => V_ACC ELSE (ACC=((0-9223372036854775807)-1) => V_9223372036854775807 ELSE V_0-ACC));
 IRLV_V; 1);

# ATOLL OF THE STRING P #
SUBR IRLATOLL(P) IS (
 IRLPOS_P;
 IRLSCI(0)=0 => RETURN 0;
 IRLV);

# V AS AN INT: THE LOW 32 BITS, SIGNED #
SUBR IRLSX32(V) IS (
 X ARE LOCAL;
 X_V AND 4294967295;
 X GE 2147483648 => X_X-4294967296;
 X);

# THE WORD AT IRLPOS (THE C'S %NNNS): BLANKS, THEN AT MOST MAXN CHARACTERS THAT ARE NOT BLANKS, TO THE STRING AT DEST; THE LENGTH #
SUBR IRLTOK(MAXN,DEST) IS (
 K,C,MX,DS ARE LOCAL;
 MX_MAXN; DS_DEST;
 IRLSKW(0); K_0;
 TK1: C_IRLGB(IRLPOS,0);
 ((K<MX) AND (C NE 0) AND (IRLISSP(C)=0)) => (IRLPUTB(DS,K,C); K_K+1; IRLPOS_IRLPOS+1; GO TO TK1);
 IRLPUTB(DS,K,0);
 K);

# THE NEXT CHARACTER OF THE INPUT, OR -1 AT THE END #
SUBR IRLGETC(Z) IS (
 C ARE LOCAL;
 C_CCALL FGETC(IRLIN);
 (C AND 4294967295)=4294967295 => RETURN 0-1;
 C AND 255);

# FSCANF(IN,"%D"): A NUMBER FROM THE INPUT, AFTER BLANKS INCLUDING LINE ENDS; 1 AND THE NUMBER IN IRLV, ELSE 0 #
SUBR IRLFSCI(Z) IS (
 C,NG,ACC,D,OV,LIM,V ARE LOCAL;
 FC0: C_IRLGETC(0); C GE 0 => IRLISSP(C) NE 0 => GO TO FC0;
 C<0 => RETURN 0;
 NG_0;
 ((C=45) OR (C=43)) => (C=45 => NG_1; C_IRLGETC(0));
 ((C<48) OR (C>57)) => (C GE 0 => CCALL UNGETC(C,IRLIN); RETURN 0);
 LIM_0-922337203685477580; ACC_0; OV_0;
 FC1: ((C GE 48) AND (C LE 57)) => (D_C-48;
        OV=0 => (((ACC<LIM) OR ((ACC=LIM) AND (D>8))) => OV_1 ELSE ACC_(ACC*10)-D);
        C_IRLGETC(0); GO TO FC1);
 C GE 0 => CCALL UNGETC(C,IRLIN);
 OV NE 0 => (NG NE 0 => V_(0-9223372036854775807)-1 ELSE V_9223372036854775807)
   ELSE (NG NE 0 => V_ACC ELSE (ACC=((0-9223372036854775807)-1) => V_9223372036854775807 ELSE V_0-ACC));
 IRLV_V; 1);

# ---- A TREE FROM THE INPUT: A LINE A NODE, PREORDER ---- #
SUBR IRLREAD(Z) IS (
 N,OP,TY,K,T,P ARE LOCAL;
 P_CCALL FGETS(LOC(IRLLINE),600,IRLIN);
 P=0 => IRLDIE(LOC('tree expected'),LOC(IRLLINE));
 IRLGB(LOC(IRLLINE),0) NE 34 => IRLDIE(LOC('tree expected'),LOC(IRLLINE));
 N_IRLALLOC(64);
 IRLPOS_LOC(IRLLINE); IRLPOS_IRLPOS+1;
 IRLSCI(0)=0 => IRLDIE(LOC('bad node'),LOC(IRLLINE));
 OP_IRLSX32(IRLV);
 IRLSCI(0)=0 => IRLDIE(LOC('bad node'),LOC(IRLLINE));
 TY_IRLSX32(IRLV);
 IRLSCI(0)=0 => IRLDIE(LOC('bad node'),LOC(IRLLINE));
 [N]_OP; [N+1]_TY;
 ((OP=2) OR (OP=4)) => GO TO RDLEAF;
 ((OP=6) OR (OP=8)) => GO TO RDREG;
 IRLSCI(0)=0 => GO TO RDBIN;
 [N+3]_IRLSX32(IRLV);                                     # UNARY #
 IRLPUSH(N);
 T_IRLREAD(0);
 N_IRLPOP(0);
 [N+5]_T;
 RETURN N;
 RDBIN: IRLPUSH(N);
 T_IRLREAD(0);
 N_IRLPOP(0);
 [N+5]_T;
 IRLPUSH(N);
 T_IRLREAD(0);
 N_IRLPOP(0);
 [N+6]_T;
 RETURN N;
 RDLEAF: IRLSCI(0)=0 => IRLDIE(LOC('bad leaf'),LOC(IRLLINE));
 [N+2]_IRLV;
 K_IRLTOK(499,LOC(IRLTOKB));
 K NE 0 => [N+4]_IRLSDUP(LOC(IRLTOKB));
 RETURN N;
 RDREG: IRLSCI(0)=0 => IRLDIE(LOC('bad register'),LOC(IRLLINE));
 IRLSCI(0)=0 => IRLDIE(LOC('bad register'),LOC(IRLLINE));
 [N+3]_IRLSX32(IRLV);
 N);

# THE TEMPS OF A TREE: THE TYPE OF THE FIRST APPEARANCE OF EACH, AND HOW MANY #
SUBR IRLNOTE(NN) IS (
 N,I ARE LOCAL;
 N_NN;
 N=0 => RETURN 0;
 [N]=8 => (I_[N+3]-100;
           ((I<0) OR (I GE 8192)) => IRLDIE(LOC('temp out of range'),LOC(IRLZERO));
           IRLTT[I]=0 => IRLTT[I]_[N+1];
           (I+1)>IRLNT => IRLNT_I+1);
 IRLPUSH(N);
 IRLNOTE([N+5]);
 N_IRLPOP(0);
 IRLNOTE([N+6]);
 0);

# ---- DATA ---- #
# THE VALUE OF A HEXADECIMAL DIGIT, OR -1 #
SUBR IRLHEXV(C) IS (
 ((C GE 48) AND (C LE 57)) => RETURN C-48;
 ((C GE 97) AND (C LE 102)) => RETURN (C-97)+10;
 ((C GE 65) AND (C LE 70)) => RETURN (C-65)+10;
 0-1);

# THE BYTES OF AN ASSEMBLER STRING (ESCAPES: \N \T \R \B \F \A \V \X AND OCTAL; ANY OTHER CHARACTER AFTER A BACKSLASH IS ITSELF) AS AN LLVM CONSTANT, \XX FOR EACH, THEN \00; THE STRING IS BUFFER 4, ITS LENGTH IN IRLLEN #
SUBR IRLLLSTR(S) IS (
 P,C,X,K,N,D ARE LOCAL;
 P_S; N_0; IRLRST(4);
 LL1: C_IRLGB(P,0); C=0 => GO TO LL9;
 P_P+1;
 ((C=92) AND (IRLGB(P,0) NE 0)) => (C_IRLGB(P,0); P_P+1;
    C=110 => (C_10; GO TO LL8);
    C=116 => (C_9; GO TO LL8);
    C=114 => (C_13; GO TO LL8);
    C=98 => (C_8; GO TO LL8);
    C=102 => (C_12; GO TO LL8);
    C=97 => (C_7; GO TO LL8);
    C=118 => (C_11; GO TO LL8);
    C=120 => (X_0; K_0;
              LL2: D_IRLHEXV(IRLGB(P,0));
              ((K<2) AND (D GE 0)) => (X_(X*16)+D; P_P+1; K_K+1; GO TO LL2);
              C_X; GO TO LL8);
    ((C GE 48) AND (C LE 55)) => (X_C-48; K_1;
              LL3: D_IRLGB(P,0);
              ((K<3) AND (D GE 48) AND (D LE 55)) => (X_(X*8)+(D-48); P_P+1; K_K+1; GO TO LL3);
              C_X AND 255));
 LL8: IRLPC(4,92); IRLPH(4,C); N_N+1; GO TO LL1;
 LL9: IRLPC(4,92); IRLPC(4,48); IRLPC(4,48); N_N+1;
 IRLLEN_N;
 IRLBB[4]);

# THE LABEL AND THE DATA OF THE ASSEMBLER LINES SO FAR, AS A GLOBAL VARIABLE #
SUBR IRLFLUSH(Z) IS (
 S,I,LK ARE LOCAL;
 IRLDLABEL=0 => GO TO FL9;
 LK_LOC('dso_local'); CCALL STRNCMP(IRLDLABEL,LOC('.L'),2)=0 => LK_LOC('internal');
 IRLDSTRING NE 0 => (S_IRLLLSTR(IRLDSTRING);
                     IRLGN(1,IRLDLABEL); IRLPS(1,LOC(' = ')); IRLPS(1,LK); IRLPS(1,LOC(' global [')); IRLPN(1,IRLLEN); IRLPS(1,LOC(' x i8] c"')); IRLPS(1,S); IRLPS(1,LOC('", align 8')); IRLPC(1,10);
                     IRLADD(2,IRLDLABEL);
                     GO TO FL9);
 IRLNDQ>0 => (IRLGN(1,IRLDLABEL); IRLPS(1,LOC(' = ')); IRLPS(1,LK); IRLPS(1,LOC(' global [')); IRLPN(1,IRLNDQ); IRLPS(1,LOC(' x i64] ['));
              I_0;
              FL1: I<IRLNDQ => (I>0 => IRLPS(1,LOC(', ')); IRLPS(1,LOC('i64 ')); IRLPN(1,IRLDQ[I]); I_I+1; GO TO FL1);
              IRLPS(1,LOC('], align 8')); IRLPC(1,10);
              IRLADD(2,IRLDLABEL));
 FL9: IRLDLABEL NE 0 => CCALL FREE(IRLDLABEL);
 IRLDSTRING NE 0 => CCALL FREE(IRLDSTRING);
 IRLDLABEL_0; IRLDSTRING_0; IRLNDQ_0; 0);

# A .COMM LINE (THE C'S SSCANF(LINE, ".COMM %255[^,],%LD")): 1 IF IT WAS ONE #
SUBR IRLCOMM(LL) IS (
 L,C,K,SZ ARE LOCAL;
 L_LL;
 CCALL STRNCMP(L,LOC('.comm'),5) NE 0 => RETURN 0;
 IRLPOS_L+5; IRLSKW(0);
 K_0;
 CM1: C_IRLGB(IRLPOS,0);
 ((K<255) AND (C NE 0) AND (C NE 44)) => (IRLPUTB(LOC(IRLNMB),K,C); K_K+1; IRLPOS_IRLPOS+1; GO TO CM1);
 K=0 => RETURN 0;
 C NE 44 => RETURN 0;
 IRLPUTB(LOC(IRLNMB),K,0);
 IRLPOS_IRLPOS+1;
 IRLSCI(0)=0 => RETURN 0;
 SZ_IRLV;
 IRLFLUSH(0);
 IRLNCM<4096 => (IRLCMN[IRLNCM]_CCALL STRDUP(LOC(IRLNMB)); IRLCMZ[IRLNCM]_SZ; IRLCML[IRLNCM]_IRLINSET(5,LOC(IRLNMB)); IRLNCM_IRLNCM+1);
 IRLADD(2,LOC(IRLNMB));
 1);

# A VARREC LINE (SYMBOL, SIZE, NAME): 1 IF IT WAS ONE #
SUBR IRLVREC(LL) IS (
 L,K,SZ ARE LOCAL;
 L_LL;
 CCALL STRNCMP(L,LOC('# varrec '),9) NE 0 => RETURN 0;
 IRLPOS_L+9;
 K_IRLTOK(255,LOC(IRLSYMB)); K=0 => RETURN 1;
 IRLSCI(0)=0 => RETURN 1;
 SZ_IRLV;
 K_IRLTOK(299,LOC(IRLNMB)); K=0 => RETURN 1;
 IRLNVR<4096 => (IRLVRS[IRLNVR]_CCALL STRDUP(LOC(IRLSYMB)); IRLVRZ[IRLNVR]_SZ; IRLVRN[IRLNVR]_CCALL STRDUP(LOC(IRLNMB));
                 IRLNVR_IRLNVR+1; IRLADD(1,LOC(IRLSYMB)));
 1);

# A PASS-THROUGH ASSEMBLER LINE (WITHOUT THE LEADING "* "): ONLY THE DATA DIRECTIVES MEAN ANYTHING HERE (.TEXT .DATA .ALIGN .BALIGN .GLOBL .TYPE .SECTION SAY NOTHING IN LLVM IR) #
SUBR IRLPASS(LL) IS (
 L,C,K,Q ARE LOCAL;
 L_LL;
 PA1: C_IRLGB(L,0); ((C=32) OR (C=9)) => (L_L+1; GO TO PA1);
 CCALL STRNCMP(L,LOC('.local '),7)=0 => (K_L+7; IRLADD(5,K); RETURN 0);
 IRLCOMM(L) NE 0 => RETURN 0;
 CCALL STRNCMP(L,LOC('.quad '),6)=0 => (IRLNDQ<4096 => (K_L+6; IRLDQ[IRLNDQ]_IRLATOLL(K); IRLNDQ_IRLNDQ+1);
                                        RETURN 0);
 CCALL STRNCMP(L,LOC('.string "'),9)=0 => (Q_CCALL STRRCHR(L,34); IRLPUTB(Q,0,0);
                                           IRLDSTRING NE 0 => CCALL FREE(IRLDSTRING);
                                           K_L+9; IRLDSTRING_CCALL STRDUP(K);
                                           RETURN 0);
 IRLVREC(L) NE 0 => RETURN 0;
 CCALL STRNCMP(L,LOC('# cfunc '),8)=0 => (K_L+8; IRLADD(4,K); RETURN 0);
 Q_CCALL STRCHR(L,58);
 Q NE 0 => (((IRLGB(L,0) NE 46) OR (CCALL STRNCMP(L,LOC('.L'),2)=0)) => (K_Q+1; IRLGB(K,0)=0 => (IRLPUTB(Q,0,0);
                                                                                                  IRLFLUSH(0);
                                                                                                  IRLDLABEL_CCALL STRDUP(L))));
 0);

# ---- A FUNCTION: THE HEADER IS IN IRLHDR, THE TREES FOLLOW ON THE INPUT TO THE "%" LINE ---- #
SUBR IRLFUNC(Z) IS (
 C,NST,I,K,LAB,S,SP,X,Y,T ARE LOCAL;
 IRLPOS_LOC(IRLHDR);
 IRLGB(IRLPOS,0) NE 33 => IRLDIE(LOC('bad function header'),LOC(IRLHDR));
 IRLPOS_IRLPOS+1;
 I_0;
 FH1: IRLSCI(0)=0 => IRLDIE(LOC('bad function header'),LOC(IRLHDR));
 I_I+1; I<5 => GO TO FH1;
 IRLTOK(255,LOC(IRLFNM))=0 => IRLDIE(LOC('bad function header'),LOC(IRLHDR));
 CCALL MEMSET(LOC(IRLTT),0,65536);
 IRLNT_0; IRLMAXARG_0-1;
 IRLDLABEL NE 0 => (CCALL FREE(IRLDLABEL); IRLDLABEL_0);              # THE ENTRY LABEL JUST BEFORE THE HEADER #
 IRLARST(0);
 NST_0;
 FR1: C_IRLGETC(0);
 C<0 => IRLDIE(LOC('function without an end'),LOC(IRLFNM));
 C=37 => (CCALL FGETS(LOC(IRLLINE),600,IRLIN); GO TO FR9);
 C=94 => (IRLFSCI(0)=0 => IRLDIE(LOC('bad label'),LOC(IRLFNM));
          LAB_IRLSX32(IRLV);
          FR2: C_IRLGETC(0);
          ((C NE 10) AND (C GE 0)) => GO TO FR2;
          IRLLAB[NST]_LAB; IRLSTM[NST]_0; NST_NST+1;
          GO TO FR1);
 C=42 => (CCALL FGETS(LOC(IRLLINE),600,IRLIN)=0 => GO TO FR9;
          S_CCALL STRCHR(LOC(IRLLINE),10); S NE 0 => IRLPUTB(S,0,0);
          S_LOC(IRLLINE); S_S+1; IRLPASS(S);
          GO TO FR1);
 CCALL UNGETC(C,IRLIN);
 T_IRLREAD(0);
 IRLSTM[NST]_T;
 IRLNOTE(T);
 NST_NST+1;
 GO TO FR1;
 FR9: IRLUSEJ_0;                                              # DOES IT CALL _SETJMP?  (THEN ITS TEMPS ARE VOLATILE) #
 I_0;
 FS1: I GE NST => GO TO FS9;
 IRLSTM[I]=0 => (I_I+1; GO TO FS1);
 SP_0; IRLSTP[SP]_IRLSTM[I]; SP_SP+1;
 FS2: SP>0 => (SP_SP-1; X_IRLSTP[SP];
               X=0 => GO TO FS2;
               (([X]=41) OR ([X]=42)) => (Y_[X+5];
                  (([Y]=4) AND ([Y+4] NE 0)) => (((CCALL STRCMP([Y+4],LOC('_setjmp'))=0) OR (CCALL STRCMP([Y+4],LOC('setjmp'))=0)) => IRLUSEJ_1));
               SP<250 => (Y_[X+5]; IRLSTP[SP]_Y; SP_SP+1; Y_[X+6]; IRLSTP[SP]_Y; SP_SP+1);
               GO TO FS2);
 I_I+1; GO TO FS1;
 FS9: IRLRST(0);
 IRLNVAL_0; IRLNDEAD_0; IRLTERM_0;
 I_0;
 FE1: I GE NST => GO TO FE9;
 IRLSTM[I] NE 0 => (IRLSTMT(IRLSTM[I]); I_I+1; GO TO FE1);
 IRLTERM=0 => (IRLPS(0,LOC('  br label %L')); IRLPN(0,IRLLAB[I]); IRLPC(0,10));
 IRLPS(0,LOC('L')); IRLPN(0,IRLLAB[I]); IRLPC(0,58); IRLPC(0,10); IRLTERM_0;
 I_I+1; GO TO FE1;
 FE9: IRLTERM=0 => (IRLPS(0,LOC('  ret i64 0')); IRLPC(0,10));
 IRLADD(3,LOC(IRLFNM));
 IRLPS(2,LOC('define ')); CCALL STRNCMP(LOC(IRLFNM),LOC('.L'),2)=0 => IRLPS(2,LOC('internal '));
 IRLPS(2,LOC('i64 ')); IRLGN(2,LOC(IRLFNM)); IRLPC(2,40);
 K_0;
 FP1: K>IRLMAXARG => GO TO FP9;
 K>0 => IRLPS(2,LOC(', '));
 IRLPS(2,IRLIPT(0)); IRLPS(2,LOC(' %a')); IRLPN(2,K);
 K_K+1; GO TO FP1;
 FP9: IRLPS(2,LOC(') {')); IRLPC(2,10); IRLPS(2,LOC('entry:')); IRLPC(2,10);
 K_0;
 FA1: K GE IRLNT => GO TO FA9;
 IRLTT[K] NE 0 => (IRLPS(2,LOC('  %t')); IRLPN(2,K+100); IRLPS(2,LOC(' = alloca ')); IRLPS(2,IRLLTYPE(IRLTT[K])); IRLPS(2,LOC(', align ')); IRLPS(2,IRLLALIGN(IRLTT[K])); IRLPC(2,10);
                   IRLPS(2,LOC('  store ')); IRLPS(2,IRLLTYPE(IRLTT[K])); IRLPC(2,32);
                   IRLTT[K]=13 => IRLPS(2,LOC('0.0')) ELSE IRLPC(2,48);
                   IRLPS(2,LOC(', ptr %t')); IRLPN(2,K+100); IRLPS(2,LOC(', align ')); IRLPS(2,IRLLALIGN(IRLTT[K])); IRLPC(2,10));
 K_K+1; GO TO FA1;
 FA9: IRLPS(2,IRLBB[0]);
 IRLPC(2,125); IRLPC(2,10); IRLPC(2,10);
 IRLARST(0);
 0);

# THE END OF A RUN: WHAT WAS GOT FROM MALLOC IS GIVEN BACK #
SUBR IRLCLEAN(Z) IS (
 I,K ARE LOCAL;
 K_0;
 CL1: I_0;
 CL2: I<IRLSETN[K] => (CCALL FREE(IRLSETV[(K*4096)+I]); I_I+1; GO TO CL2);
 IRLSETN[K]_0;
 K_K+1; K<6 => GO TO CL1;
 I_0;
 CL3: I<IRLNVR => (CCALL FREE(IRLVRS[I]); CCALL FREE(IRLVRN[I]); I_I+1; GO TO CL3);
 IRLNVR_0;
 I_0;
 CL4: I<IRLNCM => (CCALL FREE(IRLCMN[I]); I_I+1; GO TO CL4);
 IRLNCM_0;
 IRLDLABEL NE 0 => CCALL FREE(IRLDLABEL);
 IRLDSTRING NE 0 => CCALL FREE(IRLDSTRING);
 IRLDLABEL_0; IRLDSTRING_0;
 IRLARST(0);
 K_0;
 CL5: CCALL FREE(IRLBB[K]); IRLBB[K]_0; IRLBC[K]_0; IRLBL[K]_0;
 K_K+1; K<5 => GO TO CL5;
 0);

# THE IR ON INF, THE MODULE ON OUTF; PTR32: THE HOST'S POINTERS ARE 32 BITS.  THE C'S IR2LL_RUN: THE SHIM STAGE0/IR2LL_SHIM.C CALLS THIS FROM LLVMORC.C.  EVERYTHING STARTS AGAIN, SO THAT IT MAY RUN MORE THAN ONCE IN A PROCESS #
SUBR IR2LLRUN(INF,OUTF,PTR32) IS (
 C,I,NM,Q ARE LOCAL;
 IRLIN_INF; IRLOUTP_OUTF; IRLP32_PTR32;
 IRLINIT(0);
 RL1: C_IRLGETC(0);
 C<0 => GO TO RL9;
 C=42 => (CCALL FGETS(LOC(IRLLINE),600,IRLIN)=0 => GO TO RL9;
          Q_CCALL STRCHR(LOC(IRLLINE),10); Q NE 0 => IRLPUTB(Q,0,0);
          Q_LOC(IRLLINE); Q_Q+1; IRLPASS(Q);
          GO TO RL1);
 C=33 => (CCALL FGETS(LOC(IRLLINE),600,IRLIN)=0 => GO TO RL9;
          IRLPUTB(LOC(IRLHDR),0,33);
          Q_LOC(IRLHDR); Q_Q+1; CCALL STRCPY(Q,LOC(IRLLINE));
          IRLFLUSH(0); IRLFUNC(0);
          GO TO RL1);
 RL2: ((C NE 10) AND (C GE 0)) => (C_IRLGETC(0); GO TO RL2);
 GO TO RL1;
 RL9: IRLFLUSH(0);
 IRLRST(3);
 IRLPS(3,LOC('; generated by ir2ll')); IRLPC(3,10); IRLPC(3,10);
 I_0;
 DC1: I GE IRLSETN[0] => GO TO DC9;
 NM_IRLSETV[I];
 IRLINSET(3,NM) NE 0 => (I_I+1; GO TO DC1);
 ((CCALL STRCMP(NM,LOC('_setjmp'))=0) OR (CCALL STRCMP(NM,LOC('setjmp'))=0)) => (IRLPS(3,LOC('declare ')); IRLPS(3,IRLIPT(0)); IRLPC(3,32); IRLGN(3,NM); IRLPS(3,LOC('(...) returns_twice')); IRLPC(3,10);
                                                                          I_I+1; GO TO DC1);
 IRLVARF(NM)>0 => (IRLPS(3,LOC('declare i32 ')); IRLGN(3,NM); IRLPC(3,40); IRLPS(3,IRLIPT(0)); IRLPS(3,LOC(', ...)')); IRLPC(3,10);
                   I_I+1; GO TO DC1);
 IRLPS(3,LOC('declare '));
 IRLISC(NM) NE 0 => IRLPS(3,IRLIPT(0)) ELSE IRLPS(3,LOC('i64'));
 IRLPC(3,32); IRLGN(3,NM); IRLPS(3,LOC('(...)')); IRLPC(3,10);
 I_I+1; GO TO DC1;
 DC9: I_0;
 DR1: I GE IRLSETN[1] => GO TO DR9;
 NM_IRLSETV[4096+I];
 ((IRLINSET(2,NM)=0) AND (IRLINSET(0,NM)=0) AND (IRLINSET(3,NM)=0)) => (IRLGN(3,NM); IRLPS(3,LOC(' = external global i8')); IRLPC(3,10));
 I_I+1; GO TO DR1;
 DR9: I_0;
 DM1: I GE IRLNCM => GO TO DM9;
 NM_IRLCMN[I];
 ((IRLINSET(0,NM) NE 0) OR (IRLINSET(3,NM) NE 0)) => (I_I+1; GO TO DM1);
 IRLGN(3,NM);
 IRLCML[I] NE 0 => IRLPS(3,LOC(' = internal global [')) ELSE IRLPS(3,LOC(' = common global ['));
 IRLPN(3,(IRLCMZ[I]+7)/8); IRLPS(3,LOC(' x i64] zeroinitializer, align 8')); IRLPC(3,10);
 I_I+1; GO TO DM1;
 DM9: CCALL FPUTS(IRLBB[3],IRLOUTP);
 CCALL FPUTS(IRLBB[1],IRLOUTP);
 IRLRST(3);
 I_0;
 DV1: I GE IRLNVR => GO TO DV9;
 IRLLLSTR(IRLVRN[I]);
 IRLPS(3,LOC('@"ivn.')); IRLPN(3,I); IRLPS(3,LOC('" = private constant [')); IRLPN(3,IRLLEN); IRLPS(3,LOC(' x i8] c"')); IRLPS(3,IRLBB[4]); IRLPC(3,34); IRLPC(3,10);
 IRLPS(3,LOC('@"ivr.')); IRLPN(3,I); IRLPS(3,LOC('" = internal global { ptr, ')); IRLPS(3,IRLIPT(0)); IRLPS(3,LOC(', ptr } { ptr ')); IRLGN(3,IRLVRS[I]);
 IRLPS(3,LOC(', ')); IRLPS(3,IRLIPT(0)); IRLPC(3,32); IRLPN(3,IRLVRZ[I]); IRLPS(3,LOC(', ptr @"ivn.')); IRLPN(3,I); IRLPS(3,LOC('" }, section "'));
 CCALL STRCMP(CCALL IMPHOSTOS(0),LOC('darwin'))=0 => IRLPS(3,LOC('__DATA,'));
 IRLPS(3,LOC('impvars", align ')); IRLP32 NE 0 => IRLPC(3,52) ELSE IRLPC(3,56);
 IRLPC(3,10);
 I_I+1; GO TO DV1;
 DV9: IRLNVR>0 => (IRLPS(3,LOC('@llvm.used = appending global [')); IRLPN(3,IRLNVR); IRLPS(3,LOC(' x ptr] ['));
                   I_0;
                   DU1: I<IRLNVR => (I>0 => IRLPS(3,LOC(', ')); IRLPS(3,LOC('ptr @"ivr.')); IRLPN(3,I); IRLPC(3,34); I_I+1; GO TO DU1);
                   IRLPS(3,LOC('], section "llvm.metadata"')); IRLPC(3,10));
 CCALL FPUTS(IRLBB[3],IRLOUTP);
 CCALL FPUTS(IRLBB[2],IRLOUTP);
 IRLCLEAN(0);
 0)
%%
