QUIET,ARGVP,IMPHOOK ARE COMMON;
#THIS IS FILE DRIVER, THE FRONT OF THE COMPILER: THE MAIN PROGRAM OF IMP72, WHICH THE LIBRARY'S MAIN CALLS.  NOT IN THE TAPE, WHICH HAS ONE PROGRAM THAT READS ITS COMMANDS FROM THE TERMINAL (SRC/IMPM.IMC IS THAT,
 IMPK); THIS TURNS A COMMAND LINE LIKE THE C COMPILER'S INTO A COMPILATION AND AN EXECUTABLE:

    IMP [-c | -S | -Sir] [-o OUT] [--target=TRIPLE] [-s LETTERS] [-I IMAGE] [-C SYNTAX] FILE.imp ...
    IMP [-s LETTERS] [-I IMAGE] [-C SYNTAX]      NO FILE: THE COMMANDS OF THE ORIGINAL, FROM THE TERMINAL OR A PIPE

 (-c STOP AT THE OBJECT, NAME.O, WHICH IS WHAT A REL FILE IS ON TOPS-10; -S AT THE ASSEMBLY OF THE TARGET, NAME.S; -SIR AT LLVM IR, NAME.LL; NOTHING: A PROGRAM, A.OUT; -o THE OUTPUT; --TARGET=TRIPLE FOR ANOTHER SYSTEM; -s THE SWITCHES; -I AN IMAGE SAVED BY U OR V.)  IT FINDS ITS PARTS RELATIVE TO ITSELF (THE SOURCE TREE, OR PREFIX/BIN, PREFIX/LIB/IMP72 AND PREFIX/SHARE/IMP72),
 RUNS THE KERNEL (IMPK) IN THIS PROCESS TO WRITE THE IR OF THE PROGRAM, AND THEN THE BACK END, LLVM IN THE PROCESS (SRC/LLVM.IMC); THE LINK IS THE SYSTEM'S CC.  CALLED
 BY ANOTHER NAME THAN IMP OR IMPSTAGE... (IMPD IS ONE) IT IS THE KERNEL ALONE: IMPK, WITH THE ARGUMENTS OF STAGE0/IMPS0.C.  STAGE0/IMPS0.C IS THE SEED'S DRIVER, WHICH THIS REPLACES FOR IMP72.#

DIRB,ROOT,TMPB,OFILE,BASEN,SYNP,FFIP,UTFP,LIBP,OUTB,C1P,C2P,C3P,LIBD,DLP,MAD,CBP,CEP,LCP,LMP,RTP ARE 520 LONG;
CMD IS 4096 LONG;
EXEB IS 520 LONG;
AV0,NA0,KA,KNN,OUTN,TRI,DLG,DLM,WH,DW,FC0,EMU ARE COMMON;
DSTOP,DSW,DIMG,DINTER,DTGT,DSIR,DOPT,DHV,DNH,DNSRC,DSRCV,DNOBJI,DOBJI,DOBJL,DNOBJL,DEMP,DKV,DNK,DSYV,DNSY,DSYSROOT,DRUNTIME ARE COMMON;      # THE OPTIONS, THE SOURCES AND THE OBJECTS NAMED, THE OBJECTS TO LINK #
DSELFB,DB1,DB3 ARE 520 LONG;
IRBUF,IRLEN,LVOBJP,LVOBJN ARE COMMON;                                     # THE IR OF THE KERNEL, AND THE OBJECT, IN MEMORY (SRC/IMPM.IMC, SRC/LLVM.IMC) #
CYG,WSTART,WLIBK ARE COMMON;                                                  # A CYGWIN TARGET (1); THE START FILE AND THE LIBRARY THAT MARK A WINDOWS SYSROOT #
LGCA,LGCB ARE 520 LONG;                                                          # THE PATHS OF THE BUILTINS LIBRARY OF A TARGET #
HAVELGC IS 1 LONG;
EMPTYS IS 1 LONG;                                                             # AN EMPTY C STRING: THE ROOT OF THIS SYSTEM #
DTA,DTV,DTO,DTE ARE 8 LONG;                                              # THE FIELDS OF THE TARGET'S TRIPLE: ARCHITECTURE, VENDOR, SYSTEM, ENVIRONMENT #

IMPD(0);

EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL INT sscanf(PTR, PTR, ...);
EXTERNAL PTR strstr(PTR, PTR);
EXTERNAL PTR popen(PTR, PTR);
EXTERNAL INT pclose(PTR);
EXTERNAL PTR fgets(PTR, INT, PTR);
EXTERNAL INT system(PTR);
EXTERNAL PTR strchr(PTR, INT);
# EXISTS(P): CAN THE FILE BE RUN OR READ #
SUBR EXISTS(P) IS (
 (CCALL access(P,1) AND 37777777777B)=0 => RETURN 1;
 (CCALL access(P,4) AND 37777777777B)=0 => RETURN 1;
 0);

# ENVOR(NAME,DFLT): THE ENVIRONMENT VARIABLE NAME, OR DFLT IF IT IS NOT SET OR EMPTY #
SUBR ENVOR(NM,DF) IS (
 V ARE LOCAL;
 V:=CCALL getenv(NM);
 V=0 => RETURN DF;
 IMPBYTE(V,0)=0 => RETURN DF;
 V);

# OVERRIDE(DEST,NAME): THE PATH IN DEST (A BUFFER) REPLACED BY THE ENVIRONMENT VARIABLE'S VALUE, IF IT IS SET #
SUBR OVERRIDE(DS,NM) IS (
 V ARE LOCAL;
 V:=CCALL getenv(NM);
 V=0 => RETURN 0;
 IMPBYTE(V,0)=0 => RETURN 0;
 CCALL snprintf(DS,4096,LOC('%s'),V);
 0);

# THE DIRECTORY OF THE RUNNING PROGRAM, IN DIRB; 0-1 IF IT IS NOT FOUND #
SUBR EXEDIR(A0) IS (
 K,S,P,L,E,EB ARE LOCAL;
 EB:=LOC(EXEB);
 K:=IMPEXEPATH(EB,4096);                                    # (THE PATH OF THE PROGRAM: LIB/IMPHOST.IML, OR LIB/IMPHOST-WIN.IML ON WINDOWS) #
 K>0 => (CCALL memset(EB+K,0,1); GO TO XD3);
 IMPBYTE(A0,0)=0 => RETURN 0-1;
 CCALL strchr(A0,57B) NE 0 => (IMPFULLPATH(A0,EB)=0 => RETURN 0-1; GO TO XD3);
 P:=CCALL getenv(LOC('PATH'));                         # FOUND THROUGH THE PATH #
 XD1: P=0 => RETURN 0-1;
      IMPBYTE(P,0)=0 => RETURN 0-1;
      E:=CCALL strchr(P,72B);
      E NE 0 => L:=E-P ELSE L:=CCALL strlen(P);
      CCALL snprintf(LOC(CMD),4096,LOC('%.*s/%s'),L,P,A0);
      (CCALL access(LOC(CMD),1) AND 37777777777B)=0 => IMPFULLPATH(LOC(CMD),EB) NE 0 => GO TO XD3;
      E NE 0 => (P:=E+1; GO TO XD1);
      RETURN 0-1;
 XD3: S:=CCALL strrchr(EB,57B);
 S=0 => RETURN 0-1;
 CCALL memset(S,0,1);
 CCALL snprintf(LOC(DIRB),4096,LOC('%s'),EB);
 0);

SUBR DARG(I) IS (IMPARGET(LOC(DW),AV0,I); DW);

# THE COMMAND LINE OF THE KERNEL, IN C MEMORY: KA, K WORDS SO FAR #
SUBR KADD(V) IS (IMPARGSET(KA,KNN,V); KNN:=KNN+1; 0);

# THE MATH LIBRARY, WHICH A PROGRAM THAT CALLS SQRT OR POW NEEDS AND WHICH IS NOT IN THE C LIBRARY ON EVERY SYSTEM #
SUBR LMADD(D) IS (
 HAVEF(LOC(LMP),D,LOC('libm.so')) NE 0 => KADD(LOC('-lm')) ELSE (HAVEF(LOC(LMP),D,LOC('libm.a')) NE 0 => KADD(LOC('-lm')));
 0);

# THE NAME OF THE OUTPUT: OUT IF -O NAMED ONE, ELSE THE BASEN OF THE FIRST FILE AND EXT #
SUBR OUTNAME(EXT) IS (
 OUTN NE 0 => RETURN OUTN;
 EXT=0 => RETURN LOC('a.out');                       # AS THE C COMPILER'S #
 CCALL snprintf(LOC(OUTB),4096,LOC('%s%s'),LOC(BASEN),EXT);
 LOC(OUTB));

# THE BASE OF THE FILE NAME P, WITHOUT ITS DIRECTORY AND A .IMP, IN THE BUFFER B (THE C COMPILER WRITES NAME.O IN THE CURRENT DIRECTORY) #
SUBR BASEOF(P,B) IS (
 S,L,Q ARE LOCAL;
 S:=CCALL strrchr(P,57B);
 Q:=CCALL strrchr(P,134B);                              # (A WINDOWS PATH) #
 Q NE 0 => (S=0 => S:=Q ELSE (Q>S => S:=Q));
 S=0 => S:=P ELSE S:=S+1;
 CCALL snprintf(B,4096,LOC('%s'),S);
 L:=CCALL strlen(B);
 L>4 => ((((CCALL strcmp(B+(L-4),LOC('.imp')) AND 4294967295)=0) OR ((CCALL strcmp(B+(L-4),LOC('.imc')) AND 4294967295)=0)) => CCALL memset(B+(L-4),0,1));
 0);

# THE OBJECTS TO LINK, AFTER THE ARGUMENTS KADD HAS COLLECTED SO FAR #
SUBR ADDOBJS(Z) IS (
 K ARE LOCAL;
 K:=0;
 AO1: K<DNOBJL => (IMPARGET(LOC(DW),DOBJL,K); KADD(DW); K:=K+1; GO TO AO1);
 0);

# TRYDIR(D): THE FILES OF THE C LIBRARY (CRT1.O, CRTI.O, CRTN.O) ARE IN THE DIRECTORY D; SETS C1P, C2P, C3P AND LIBD #
SUBR TRYDIR(D) IS (
 CCALL snprintf(LOC(C1P),4096,LOC('%s/crt1.o'),D);
 EXISTS(LOC(C1P))=0 => RETURN 0;
 CCALL snprintf(LOC(C2P),4096,LOC('%s/crti.o'),D);
 CCALL snprintf(LOC(C3P),4096,LOC('%s/crtn.o'),D);
 CCALL snprintf(LOC(LIBD),4096,LOC('%s'),D);
 1);

# HAVEF(B,D,N): THE FILE N IN THE DIRECTORY D EXISTS; ITS PATH IS IN THE BUFFER B #
SUBR HAVEF(B,D,N) IS (
 CCALL snprintf(B,4096,LOC('%s/%s'),D,N);
 EXISTS(B));

# THE ARGUMENTS OF LD, WHEN IMPLDSHOW IS SET, ON THE STANDARD ERROR (THE SEED'S DRIVER, STAGE0/IMPS0.C, DOES THE SAME: A TEST REQUIRES THE TWO TO WRITE THE SAME) #
SUBR SHOWLD(Z) IS (
 K ARE LOCAL;
 CCALL getenv(LOC('IMPLDSHOW'))=0 => RETURN 0;
 K:=0;
 SH1: K<KNN => (IMPARGET(LOC(DW),KA,K); OUTCS(DW); OUTCHR(40B); K:=K+1; GO TO SH1);
 OUTCHR(12B);
 0);

# RUN LLD WITH THE ARGUMENTS KADD HAS COLLECTED; 0 IF IT LINKED.  THE LIBRARY OF LLD IN THIS PROCESS WHERE THERE IS ONE; A COMPILER BUILT WITHOUT IT RUNS LLD AS A PROGRAM, BY THE NAME THE
  TABLES GIVE IT (LD.LLD, LD64.LLD: OPENBSD'S OWN LINKER IS LLD, AND IT HAS NO LIBRARY OF IT).  NO OTHER LINKER, NEVER CC #
SUBR RUNLD(Z) IS (
 OK ARE LOCAL;
 SHOWLD(0);
 CCALL getenv(LOC('IMPLDSHOW')) NE 0 => CCALL impldhave(0) NE 0 => (OUTSTR('linker: lld in this process'); OUTCHR(12B));
 CCALL impldhave(0) NE 0 => OK:=(CCALL impld(KNN,KA) NE 0 => 1 ELSE 0) ELSE OK:=(IMPRUNLD(KNN,KA) NE 0 => 1 ELSE 0);
 OK);

# THE LINK OF THIS MACHINE LEARNS ITS FILES FROM ITSELF, NOT FROM A TABLE OF ARCHITECTURES: THE LOADER AND THE C LIBRARY THIS VERY PROGRAM RUNS WITH (IMPHOSTINTERP, IMPHOSTLIBC, IMPHOSTCRTDIR), AND
  FOR A PROGRAM WITH NO LOADER OF ITS OWN THE FILES WHOSE ELF HEADERS ARE ITS OWN (IMPHOSTPROBE).  THE BSDS KEEP THEIRS IN /USR/LIB, WHATEVER THE ARCHITECTURE.  A TARGET OF ANOTHER SYSTEM IS LNKCROSS, WHICH
  GETS THE LOADER FROM THE TRIPLE #

# THE LINK ON LINUX, WITH THE C LIBRARY OF GLIBC OR MUSL, ON ANY ARCHITECTURE #
SUBR LNKLIN(Z) IS (
 OK ARE LOCAL;
 OK:=0;
 IMPHOSTCRTDIR(LOC(MAD)) NE 0 => IMPHOSTINTERP(LOC(DLP)) NE 0 => OK:=TRYDIR(LOC(MAD));       # WHAT THIS PROGRAM'S OWN LOADER FOUND #
 OK=0 => IMPHOSTPROBE(LOC(MAD),LOC(DLP)) NE 0 => OK:=TRYDIR(LOC(MAD));                        # A PROGRAM WITH NO LOADER OF ITS OWN: THE FILES OF ITS MACHINE #
 OK=0 => (OUTSTR('imp: cannot link: this program has no dynamic loader of its own, and no crt1.o of this machine is under /usr/lib, /usr/lib64 or /lib; use -c to make the object'); OUTCHR(12B); RETURN 1);
 KA:=CCALL calloc(40+DNOBJL,8); KNN:=0;
 KADD(LOC('ld.lld')); KADD(LOC('-o')); KADD(OUTNAME(0)); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP));
 KADD(LOC(C1P)); KADD(LOC(C2P)); ADDOBJS(0); KADD(LOC(LIBP)); KADD(LOC('-L')); KADD(LOC(LIBD)); KADD(LOC('-lc')); LMADD(LOC(LIBD)); KADD(LOC(C3P));
 RUNLD(0));

# THE NAMES OF THE SYSTEM OF THE BSDS: THE LOADER AND THE FIRST CRT FILE (CRT1.O ON FREEBSD, CRT0.O ON THE OTHERS), AND WH, 1 IF THE SYSTEM HAS CRTI.O AND CRTN.O (OPENBSD HAS NOT, AND IT HAS NO LIBC.SO TO FIND
  BY -LC, ONLY LIBC.SO.MAJOR.MINOR, WHICH IMPFINDLIB LOOKS FOR).  SETS DLG AND FC0 AND WH; RETURNS 1 FREEBSD, 2 NETBSD, 3 OPENBSD, 0 FOR ANOTHER SYSTEM #
SUBR BSDNAMES(OS) IS (
 CCALL strcmp(OS,LOC('freebsd'))=0 => (DLG:=LOC('/libexec/ld-elf.so.1'); FC0:=LOC('crt1.o'); WH:=1; RETURN 1);
 CCALL strcmp(OS,LOC('netbsd'))=0 => (DLG:=LOC('/usr/libexec/ld.elf_so'); FC0:=LOC('crt0.o'); WH:=1; RETURN 2);
 CCALL strcmp(OS,LOC('openbsd'))=0 => (DLG:=LOC('/usr/libexec/ld.so'); FC0:=LOC('crt0.o'); WH:=0; RETURN 3);
 0);

# A FILE OF A BSD'S LIBRARY DIRECTORY (ROOT/USR/LIB) IS NOT THERE: SAY SO.  FOR A TARGET (TRIPLE IN DTGT) IT SAYS FOR WHICH #
SUBR BSDMISS(WHAT,LD) IS (
 DTGT NE 0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no ')) ELSE OUTSTR('imp: cannot link: no ');
 OUTCS(WHAT); OUTSTR(' under '); OUTCS(LD); OUTCHR(12B);
 1);

# THE LINK ON FREEBSD, NETBSD AND OPENBSD, ON ANY ARCHITECTURE.  ROOT IS THE ROOT OF THE SYSTEM ('' FOR THIS ONE, THE SYSROOT FOR A TARGET), LIB THE RUNTIME LIBRARY, TGT 1 FOR A TARGET (THE LOADER IS THE
  SYSTEM'S, NOT THIS PROGRAM'S).  THE FILES ARE IN ROOT/USR/LIB #
SUBR LNKBSD(OS,ROOT,LIB,TGT) IS (
 OBSD,UL,K ARE LOCAL;
 K:=BSDNAMES(OS);
 K=0 => (OUTSTR('imp: cannot link: linking is not supported on '); OUTCS(OS); OUTSTR('; use -c to make the object'); OUTCHR(12B); RETURN 1);
 OBSD:=(K=3 => 1 ELSE 0);
 CCALL snprintf(LOC(LIBD),4096,LOC('%s/usr/lib'),ROOT);
 UL:=LOC(LIBD);
 HAVEF(LOC(C1P),UL,FC0)=0 => RETURN BSDMISS(FC0,UL);
 HAVEF(LOC(CBP),UL,LOC('crtbegin.o'))=0 => RETURN BSDMISS(LOC('crtbegin.o'),UL);
 HAVEF(LOC(CEP),UL,LOC('crtend.o'))=0 => RETURN BSDMISS(LOC('crtend.o'),UL);
 WH NE 0 => (HAVEF(LOC(C2P),UL,LOC('crti.o'))=0 => RETURN BSDMISS(LOC('crti.o'),UL);
             HAVEF(LOC(C3P),UL,LOC('crtn.o'))=0 => RETURN BSDMISS(LOC('crtn.o'),UL));
 TGT NE 0 => (DRUNTIME=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no libimp.a built for it is given (--runtime=FILE or IMPRUNTIME)'); OUTCHR(12B); RETURN 1);
              EXISTS(DRUNTIME)=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no '); OUTCS(DRUNTIME); OUTCHR(12B); RETURN 1));
 OBSD NE 0 => (TGT NE 0 => IMPFINDLIB(LOC(LCP),UL,LOC('libc.so.'))=0 => RETURN BSDMISS(LOC('libc.so.MAJOR.MINOR'),UL);
               TGT=0 => IMPHOSTLIBC(LOC(LCP))=0 => IMPFINDLIB(LOC(LCP),UL,LOC('libc.so.'))=0 => RETURN BSDMISS(LOC('libc.so.MAJOR.MINOR'),UL));
 TGT NE 0 => CCALL snprintf(LOC(DLP),4096,LOC('%s'),DLG) ELSE (IMPHOSTINTERP(LOC(DLP))=0 => CCALL snprintf(LOC(DLP),4096,LOC('%s'),DLG));      # THE LOADER THIS PROGRAM HAS, ELSE THE SYSTEM'S #
 HAVEF(LOC(RTP),UL,LOC('libcompiler_rt.a'));
 KA:=CCALL calloc(48+DNOBJL,8); KNN:=0;
 KADD(LOC('ld.lld')); TGT NE 0 => (SETEMU(CROSSARCH(LOC(DTA)),LOC(DTE),K); EMU NE 0 => (KADD(LOC('-m')); KADD(EMU)));
 TGT NE 0 => (DSYSROOT NE 0 => (CCALL snprintf(LOC(DB1),4096,LOC('--sysroot=%s'),DSYSROOT); KADD(CCALL strdup(LOC(DB1)))));       # (THE ABSOLUTE PATHS OF ITS LINKER SCRIPTS, GROUP ( /lib/libc.so.7 ... ), ARE IN THE SYSROOT) #
 KADD(LOC('--eh-frame-hdr')); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP)); KADD(LOC('-o')); KADD(OUTNAME(0));
 KADD(LOC(C1P)); WH NE 0 => KADD(LOC(C2P)); KADD(LOC(CBP)); ADDOBJS(0); KADD(LIB);
 OBSD NE 0 => (KADD(LOC(LCP)); IMPFINDLIB(LOC(LMP),UL,LOC('libm.so.')) NE 0 => KADD(LOC(LMP))) ELSE (KADD(LOC('-L')); KADD(UL); KADD(LOC('-lc')); LMADD(UL));
 EXISTS(LOC(RTP)) NE 0 => KADD(LOC(RTP));
 KADD(LOC(CEP)); WH NE 0 => KADD(LOC(C3P));
 RUNLD(0));

# THE LINK ON MACOS (ARM64 AND X86-64): LLD'S MACH-O DRIVER, WITH THE SDK (SDKROOT, ELSE THE COMMAND LINE TOOLS, ELSE XCODE) AND -LSYSTEM #
SUBR LNKMAC(HA) IS (
 SDK,AR,MV ARE LOCAL;
 AR:=0;
 CCALL strcmp(HA,LOC('aarch64'))=0 => (AR:=LOC('arm64'); MV:=LOC('11.0'));
 CCALL strcmp(HA,LOC('x86_64'))=0 => (AR:=LOC('x86_64'); MV:=LOC('10.13'));
 AR=0 => (OUTSTR('imp: cannot link: macOS on '); IMPBYTE(HA,0)=0 => OUTSTR('this architecture') ELSE OUTCS(HA); OUTSTR(': only arm64 and x86_64 are supported; use -c to make the object'); OUTCHR(12B); RETURN 1);
 SDK:=ENVOR(LOC('SDKROOT'),0);
 SDK=0 => (CCALL snprintf(LOC(LIBD),4096,LOC('/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk')); EXISTS(LOC(LIBD)) NE 0 => SDK:=LOC(LIBD));
 SDK=0 => (CCALL snprintf(LOC(LIBD),4096,LOC('/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk'));
           EXISTS(LOC(LIBD)) NE 0 => SDK:=LOC(LIBD));
 SDK=0 => (OUTSTR('imp: cannot link: no macOS SDK (set SDKROOT, or install the Command Line Tools or Xcode)'); OUTCHR(12B); RETURN 1);
 KA:=CCALL calloc(40+DNOBJL,8); KNN:=0;
 KADD(LOC('ld64.lld')); KADD(LOC('-arch')); KADD(AR); KADD(LOC('-platform_version')); KADD(LOC('macos')); KADD(MV); KADD(MV);
 KADD(LOC('-syslibroot')); KADD(SDK); KADD(LOC('-o')); KADD(OUTNAME(0)); ADDOBJS(0); KADD(LOC(LIBP)); KADD(LOC('-lSystem'));
 RUNLD(0));

# THE LINK OF OFILE WITH THE RUNTIME LIBRARY INTO THE EXECUTABLE: LLD IN THIS PROCESS (STAGE0/IMPLD.CPP), OR LLD AS A PROGRAM WHERE THERE IS NO LLD LIBRARY, FOR THE SYSTEM THIS IS (OR, WITH --TARGET, FOR
  THE ONE NAMED); NEVER CC.  RETURNS 0 IF IT WORKED #
# THE LINK ON WINDOWS, FOR WINDOWS: THE LINK FOR ANOTHER SYSTEM (LNKCROSS, LNKCROSSWIN) WITH THE FILES OF MINGW-W64 THAT COME WITH THE PROGRAM, UNDER THE ROOT --SYSROOT OR IMPSYSROOT NAMES, ELSE THE DIRECTORY ABOVE THE ONE THIS
  PROGRAM IS IN (THE UCRT64 TREE OF MSYS2: BIN, LIB, INCLUDE), AND ITS RUNTIME LIBRARY; THE UCRT, UNLESS IMPCRT=MSVCRT #
SUBR LNKWIN(Z) IS (
 CCALL snprintf(LOC(DB1),4096,LOC('%s/..'),LOC(DIRB));
 DSYSROOT=0 => DSYSROOT:=CCALL strdup(LOC(DB1));
 DRUNTIME=0 => DRUNTIME:=CCALL strdup(LOC(LIBP));
 DTGT=0 => (CCALL strcmp(ENVOR(LOC('IMPCRT'),LOC('ucrt')),LOC('msvcrt'))=0 => DTGT:=LOC('x86_64-w64-mingw32') ELSE DTGT:=LOC('x86_64-w64-mingw32-ucrt'));
 LNKCROSS(0));

SUBR LNK(Z) IS (
 HA,OS ARE LOCAL;
 LLVMNATIVE(0)=0 => RETURN LNKCROSS(0);                    # ANOTHER SYSTEM #
 OS:=IMPHOSTOS(0); HA:=IMPHOSTARCH(0);
 CCALL strcmp(OS,LOC('windows'))=0 => RETURN LNKWIN(0);
 CCALL strcmp(OS,LOC('linux'))=0 => RETURN LNKLIN(0);
 CCALL strcmp(OS,LOC('darwin'))=0 => RETURN LNKMAC(HA);
 EMPTYS:=0;
 LNKBSD(OS,LOC(EMPTYS),LOC(LIBP),0));


# THE LINK FOR A TARGET FAILS FOR A FILE OF THE TARGET THAT IS NOT THERE: THE FIRST LINE SAYS WHICH, AND THE REST HOW TO SAY WHERE THE FILES ARE.  WHY IS 0 FOR NO SYSROOT NAMED, 1 FOR NO START FILES (CRT1.O) IN
  IT, 2 FOR NO LIBIMP.A #
SUBR CROSSMSG(WHY) IS (
 OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': ');
 WHY=0 => (OUTSTR('no sysroot is given, and the link needs the files of that system'); OUTCHR(12B));
 WHY=1 => (OUTSTR('no crt1.o under '); OUTCS(DSYSROOT); OUTSTR('/usr/lib/'); OUTCS(TRI); OUTSTR(', '); OUTCS(DSYSROOT); OUTSTR('/usr/lib, '); OUTCS(DSYSROOT); OUTSTR('/usr/lib64, '); OUTCS(DSYSROOT);
           OUTSTR('/lib/'); OUTCS(TRI); OUTSTR(' or '); OUTCS(DSYSROOT); OUTSTR('/lib'); OUTCHR(12B));
 WHY=2 => (OUTSTR('no libimp.a: it was not given, nor found next to the C library ('); OUTCS(LOC(LIBD)); OUTSTR(')'); OUTCHR(12B));
 OUTSTR('  It needs, from that system: the start files of its C library (crt1.o, crti.o, crtn.o), the C library (-lc), and libimp.a, the runtime of imp, built for it.'); OUTCHR(12B);
 OUTSTR('  (The dynamic linker is only named, as '); OUTCS(LOC(DLP)); OUTSTR('.)'); OUTCHR(12B);
 OUTSTR('  Say where they are:'); OUTCHR(12B);
 OUTSTR('    --sysroot=DIR    the root of that system (DIR/usr/lib/'); OUTCS(TRI); OUTSTR('/crt1.o, ...), or set IMPSYSROOT'); OUTCHR(12B);
 OUTSTR('    --runtime=FILE   its libimp.a (or put it with the C library), or set IMPRUNTIME'); OUTCHR(12B);
 OUTSTR('  Or compile with -c (an object file) and link on that system.'); OUTCHR(12B);
 1);

# WHAT A LINK FOR MACOS NEEDS AND DOES NOT HAVE.  WHY IS 0 FOR NO SDK NAMED, 1 FOR A SYSROOT THAT IS NOT AN SDK (NO USR/LIB/LIBSYSTEM.TBD), 2 FOR NO LIBIMP.A #
SUBR CROSSMSGMAC(WHY) IS (
 OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': ');
 WHY=0 => (OUTSTR('no SDK is given (--sysroot=DIR or IMPSYSROOT)'); OUTCHR(12B));
 WHY=1 => (OUTSTR('no usr/lib/libSystem.tbd under '); OUTCS(DSYSROOT); OUTCHR(12B));
 WHY=2 => (OUTSTR('no libimp.a: it was not given (--runtime=FILE or IMPRUNTIME)'); OUTCHR(12B));
 OUTSTR('  It needs the SDK of macOS (the MacOSX.sdk directory, with usr/lib/libSystem.tbd) and libimp.a, the runtime of imp, built for it.'); OUTCHR(12B);
 OUTSTR('  Say where they are:'); OUTCHR(12B);
 OUTSTR('    --sysroot=DIR    the SDK (Xcode or the Command Line Tools have it), or set IMPSYSROOT'); OUTCHR(12B);
 OUTSTR('    --runtime=FILE   its libimp.a, or set IMPRUNTIME'); OUTCHR(12B);
 OUTSTR('  Or compile with -c (an object file) and link on that system.'); OUTCHR(12B);
 1);

# THE LINK FOR MACOS FROM ANOTHER SYSTEM (OR ANOTHER ARCHITECTURE): THE MACH-O DRIVER OF LLD, WITH THE SDK AS THE SYSROOT.  RETURNS 0 IF IT LINKED #
SUBR LNKCROSSMAC(Z) IS (
 AR,MV ARE LOCAL;
 AR:=0;
 ((CCALL strcmp(LOC(DTA),LOC('arm64'))=0) OR (CCALL strcmp(LOC(DTA),LOC('aarch64'))=0)) => (AR:=LOC('arm64'); MV:=LOC('11.0'));
 CCALL strcmp(LOC(DTA),LOC('x86_64'))=0 => (AR:=LOC('x86_64'); MV:=LOC('10.13'));
 AR=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': macOS on '); OUTCS(LOC(DTA)); OUTSTR(' is not supported (arm64 and x86_64 only); use -c to make the object'); OUTCHR(12B); RETURN 1);
 DSYSROOT=0 => RETURN CROSSMSGMAC(0);
 CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib/libSystem.tbd'),DSYSROOT);
 EXISTS(LOC(MAD))=0 => RETURN CROSSMSGMAC(1);
 DRUNTIME=0 => RETURN CROSSMSGMAC(2);
 EXISTS(DRUNTIME)=0 => RETURN CROSSMSGMAC(2);
 KA:=CCALL calloc(40+DNOBJL,8); KNN:=0;
 KADD(LOC('ld64.lld')); KADD(LOC('-arch')); KADD(AR); KADD(LOC('-platform_version')); KADD(LOC('macos')); KADD(MV); KADD(MV);
 KADD(LOC('-syslibroot')); KADD(DSYSROOT); KADD(LOC('-o')); KADD(OUTNAME(0)); ADDOBJS(0); KADD(DRUNTIME); KADD(LOC('-lSystem'));
 RUNLD(0));

# THE LINK FOR A BSD TARGET: THE SAME AS FOR THIS MACHINE, WITH THE FILES FROM --SYSROOT AND THE LIBRARY OF THE RUNTIME FROM --RUNTIME, WHATEVER THE ARCHITECTURE #
SUBR LNKCROSSBSD(OS) IS (
 DSYSROOT=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no sysroot is given (--sysroot=DIR or IMPSYSROOT), and the link needs its /usr/lib (crt0.o or crt1.o, crtbegin.o, crtend.o, libc)'); OUTCHR(12B); RETURN 1);
 LNKBSD(OS,DSYSROOT,DRUNTIME,1));

# THE LINK FOR WINDOWS WITH MINGW-W64 (THE ENVIRONMENT GNU: X86_64-W64-MINGW32, I686-W64-MINGW32, AARCH64-W64-MINGW32): LLD'S MINGW DRIVER (LD.LLD -M I386PEP), WITH THE FILES OF A MINGW-W64 SYSROOT: CRT2.O AND
  THE LIBRARIES (LIBMINGW32, LIBMOLDNAME, LIBMINGWEX, LIBMSVCRT, THE IMPORT LIBRARIES OF THE SYSTEM DLLS) IN DIR/USR/TRIPLE/LIB, DIR/TRIPLE/LIB, DIR/LIB OR DIR/USR/LIB.  THE ENVIRONMENT MSVC NEEDS THE WINDOWS SDK AND
  IS REFUSED.  RETURNS 0 IF IT LINKED #
SUBR LNKCROSSWIN(Z) IS (
 MT,PM,OK ARE LOCAL;
 CYG:=STARTS(LOC(DTE),LOC('cygnus'));
 ((STARTS(LOC(DTE),LOC('gnu'))=0) AND (CYG=0)) => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': linking for windows is supported with the mingw-w64 C library (the environment gnu: x86_64-w64-mingw32) and with Cygwin (x86_64-pc-cygwin), not for '); OUTCS(LOC(DTE));
                                   OUTSTR('; use -c to make the object'); OUTCHR(12B); RETURN 1);
 MT:=0;
 CCALL strcmp(LOC(DTA),LOC('x86_64'))=0 => (MT:=LOC('x86_64-w64-mingw32'); PM:=LOC('i386pep'));
 ((IMPBYTE(LOC(DTA),0)=151B) AND (IMPBYTE(LOC(DTA),2)=70B) AND (IMPBYTE(LOC(DTA),3)=66B) AND (IMPBYTE(LOC(DTA),4)=0)) => (MT:=LOC('i686-w64-mingw32'); PM:=LOC('i386pe'));
 STARTS(LOC(DTA),LOC('aarch64'))=1 => (MT:=LOC('aarch64-w64-mingw32'); PM:=LOC('arm64pe'));
 STARTS(LOC(DTA),LOC('arm'))=1 => (MT:=LOC('armv7-w64-mingw32'); PM:=LOC('thumb2pe'));
 CYG NE 0 => (MT NE 0 => (CCALL strcmp(MT,LOC('x86_64-w64-mingw32'))=0 => MT:=LOC('x86_64-pc-cygwin') ELSE (CCALL strcmp(MT,LOC('i686-w64-mingw32'))=0 => MT:=LOC('i686-pc-cygwin') ELSE MT:=0)));          # (CYGWIN HAS NO ARM OR AARCH64) #
 CYG NE 0 => (WSTART:=LOC('crt0.o'); WLIBK:=LOC('libcygwin.a')) ELSE (WSTART:=LOC('crt2.o'); WLIBK:=LOC('libmingw32.a'));
 MT=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': linking for windows on '); OUTCS(LOC(DTA)); OUTSTR(' is not supported (x86_64, i686, aarch64 and arm are); use -c to make the object'); OUTCHR(12B); RETURN 1);
 DSYSROOT=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no sysroot is given (--sysroot=DIR or IMPSYSROOT): a mingw-w64 tree with crt2.o and libmingw32.a under DIR/usr/'); OUTCS(MT);
                OUTSTR('/lib (the Debian package mingw-w64-x86-64-dev has it)'); OUTCHR(12B); RETURN 1);
 CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/%s/lib'),DSYSROOT,MT); OK:=WINDIR(LOC(MAD),WSTART,WLIBK);
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/%s/lib'),DSYSROOT,MT); OK:=WINDIR(LOC(MAD),WSTART,WLIBK));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/lib'),DSYSROOT); OK:=WINDIR(LOC(MAD),WSTART,WLIBK));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib'),DSYSROOT); OK:=WINDIR(LOC(MAD),WSTART,WLIBK));
 OK=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no '); OUTCS(WSTART); OUTSTR(' and '); OUTCS(WLIBK); OUTSTR(' under '); OUTCS(DSYSROOT); OUTSTR('/usr/'); OUTCS(MT); OUTSTR('/lib, '); OUTCS(DSYSROOT); OUTSTR('/'); OUTCS(MT);
          OUTSTR('/lib, '); OUTCS(DSYSROOT); OUTSTR('/lib or '); OUTCS(DSYSROOT); OUTSTR('/usr/lib'); OUTCHR(12B); RETURN 1);
 DRUNTIME=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no libimp.a built for it is given (--runtime=FILE or IMPRUNTIME)'); OUTCHR(12B); RETURN 1);
 EXISTS(DRUNTIME)=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no '); OUTCS(DRUNTIME); OUTCHR(12B); RETURN 1);
 KA:=CCALL calloc(48+DNOBJL,8); KNN:=0;
 HAVELGC:=0; EMPTYS:=0;                            # CYGWIN: THE FILES OF GCC (CRTBEGIN.O, CRTEND.O, LIBGCC.A) ARE IN USR/LIB/GCC/TRIPLE/VERSION #
 CYG NE 0 => (CCALL snprintf(LOC(LGCA),4096,LOC('%s/usr/lib/gcc/%s'),DSYSROOT,MT);
              IMPFINDLIB(LOC(LGCB),LOC(LGCA),LOC(EMPTYS)) NE 0 => HAVELGC:=1);
 KADD(LOC('ld.lld')); KADD(LOC('-m')); KADD(PM); KADD(LOC('-o')); KADD(OUTNAME(0)); KADD(LOC(C1P));
 HAVELGC NE 0 => (HAVEF(LOC(CBP),LOC(LGCB),LOC('crtbegin.o')) NE 0 => KADD(LOC(CBP)));
 ADDOBJS(0); KADD(DRUNTIME); KADD(LOC('-L')); KADD(LOC(LIBD));
 HAVELGC NE 0 => (KADD(LOC('-L')); KADD(LOC(LGCB)));
 CYG NE 0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib/w32api'),DSYSROOT); EXISTS(LOC(MAD)) NE 0 => (KADD(LOC('-L')); KADD(CCALL strdup(LOC(MAD)))));      # (THE IMPORT LIBRARIES OF WINDOWS, KERNEL32 AND ITS KIN, ARE OF CYGWIN'S W32API-RUNTIME: USR/LIB/W32API) #
 CYG NE 0 => (KADD(LOC('-lcygwin')); KADD(LOC('-lgcc')); KADD(LOC('-ladvapi32')); KADD(LOC('-lshell32')); KADD(LOC('-luser32')); KADD(LOC('-lkernel32'));
              HAVELGC NE 0 => (HAVEF(LOC(CEP),LOC(LGCB),LOC('crtend.o')) NE 0 => KADD(LOC(CEP)));
              RETURN RUNLD(0));
 KADD(LOC('-lmingw32')); KADD(LOC('-lmoldname')); KADD(LOC('-lmingwex')); KADD(LOC('-lgcc')); (CCALL strstr(DTGT,LOC('ucrt')) NE 0 => KADD(LOC('-lucrt')) ELSE KADD(LOC('-lmsvcrt'))); KADD(LOC('-ladvapi32')); KADD(LOC('-lshell32')); KADD(LOC('-luser32')); KADD(LOC('-lkernel32'));
 RUNLD(0));

# THE DIRECTORY D HAS THE START FILE OF MINGW-W64 (CRT2.O) AND ITS LIBRARY (LIBMINGW32.A); SETS C1P AND LIBD #
SUBR WINDIR(D,ST,LK) IS (
 CCALL snprintf(LOC(C1P),4096,LOC('%s/%s'),D,ST);
 EXISTS(LOC(C1P))=0 => RETURN 0;
 CCALL snprintf(LOC(C2P),4096,LOC('%s/%s'),D,LK);
 EXISTS(LOC(C2P))=0 => RETURN 0;
 CCALL snprintf(LOC(LIBD),4096,LOC('%s'),D);
 1);

# THE LINK FOR ANOTHER SYSTEM: LLD LINKS FOR ANY TARGET, SO WHAT IT NEEDS IS THE FILES OF THE TARGET, FROM --SYSROOT AND --RUNTIME, AND THE LOADER, WHICH THE TRIPLE NAMES.  LINUX (GLIBC AND MUSL, THE ARCHITECTURES
  OF SETARCH), FREEBSD, NETBSD, OPENBSD AND MACOS; ANOTHER SYSTEM (WINDOWS, AN IOS) IS REFUSED WITH THE NAME OF IT.  RETURNS 0 IF IT LINKED #
SUBR LNKCROSS(Z) IS (
 AR,TT,OK ARE LOCAL;
 TT:=LLVMTRIPLE(0);
 DTA[0]:=DTV[0]:=DTO[0]:=DTE[0]:=0;
 CCALL sscanf(TT,LOC('%[^-]-%[^-]-%[^-]-%s'),LOC(DTA),LOC(DTV),LOC(DTO),LOC(DTE));
 ((STARTS(LOC(DTO),LOC('darwin'))=1) OR (STARTS(LOC(DTO),LOC('macos'))=1)) => RETURN LNKCROSSMAC(0);
 ((STARTS(LOC(DTO),LOC('windows'))=1) OR (STARTS(LOC(DTO),LOC('win32'))=1) OR (STARTS(LOC(DTO),LOC('mingw'))=1)) => RETURN LNKCROSSWIN(0);
 STARTS(LOC(DTO),LOC('freebsd'))=1 => RETURN LNKCROSSBSD(LOC('freebsd'));
 STARTS(LOC(DTO),LOC('netbsd'))=1 => RETURN LNKCROSSBSD(LOC('netbsd'));
 STARTS(LOC(DTO),LOC('openbsd'))=1 => RETURN LNKCROSSBSD(LOC('openbsd'));
 STARTS(LOC(DTO),LOC('linux'))=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': linking for ');
     ((IMPBYTE(LOC(DTO),0)=0) OR (CCALL strcmp(LOC(DTO),LOC('unknown'))=0) OR (CCALL strcmp(LOC(DTO),LOC('none'))=0)) => OUTSTR('a target with no operating system') ELSE OUTCS(LOC(DTO));
     OUTSTR(' is not supported; use -c to make the object (Linux, FreeBSD, NetBSD, OpenBSD, macOS and Windows with mingw-w64 are linked)'); OUTCHR(12B); RETURN 1);
 STARTS(LOC(DTE),LOC('android'))=1 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': linking for android is not supported (its C library is bionic); use -c to make the object'); OUTCHR(12B); RETURN 1);
 AR:=CROSSARCH(LOC(DTA));
 AR=0 => (OUTSTR('imp: cannot link for '); OUTCS(DTGT); OUTSTR(': no standard dynamic loader is known for the architecture '); OUTCS(LOC(DTA)); OUTSTR(' on Linux; use -c to make the object'); OUTCHR(12B); RETURN 1);
 SETARCH(AR,LOC(DTE))=0 => RETURN 1;
 SETEMU(AR,LOC(DTE),0);
 STARTS(LOC(DTE),LOC('musl'))=1 => CCALL snprintf(LOC(DLP),4096,LOC('/lib/ld-musl-%s.so.1'),DLM) ELSE CCALL snprintf(LOC(DLP),4096,LOC('%s'),DLG);
 CCALL snprintf(LOC(LIBD),4096,LOC('(no sysroot)'));
 DSYSROOT=0 => RETURN CROSSMSG(0);
 CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib/%s'),DSYSROOT,TRI); OK:=TRYDIR(LOC(MAD));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib'),DSYSROOT); OK:=TRYDIR(LOC(MAD)));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/usr/lib64'),DSYSROOT); OK:=TRYDIR(LOC(MAD)));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/lib/%s'),DSYSROOT,TRI); OK:=TRYDIR(LOC(MAD)));
 OK=0 => (CCALL snprintf(LOC(MAD),4096,LOC('%s/lib'),DSYSROOT); OK:=TRYDIR(LOC(MAD)));
 OK=0 => RETURN CROSSMSG(1);
 DRUNTIME NE 0 => CCALL snprintf(LOC(LCP),4096,LOC('%s'),DRUNTIME) ELSE CCALL snprintf(LOC(LCP),4096,LOC('%s/libimp.a'),LOC(LIBD));
 EXISTS(LOC(LCP))=0 => RETURN CROSSMSG(2);
 CCALL snprintf(LOC(CBP),4096,LOC('--sysroot=%s'),DSYSROOT);
 HAVELGC:=0; EMPTYS:=0;                                   # THE BUILTINS OF THE COMPILER (LIBGCC.A: __DIVDI3 AND ITS KIN) OF THE TARGET'S SYSROOT, WHERE THE LIBRARY OF THE RUNTIME HAS NONE: USR/LIB/GCC/TRI/VERSION #
 CCALL snprintf(LOC(LGCA),4096,LOC('%s/usr/lib/gcc/%s'),DSYSROOT,TRI);
 IMPFINDLIB(LOC(LGCB),LOC(LGCA),LOC(EMPTYS)) NE 0 => (CCALL snprintf(LOC(LGCA),4096,LOC('%s/libgcc.a'),LOC(LGCB)); EXISTS(LOC(LGCA)) NE 0 => (CCALL snprintf(LOC(LGCB),4096,LOC('%s'),LOC(LGCA)); HAVELGC:=1));
 KA:=CCALL calloc(48+DNOBJL,8); KNN:=0;
 KADD(LOC('ld.lld')); EMU NE 0 => (KADD(LOC('-m')); KADD(EMU)); KADD(LOC(CBP)); KADD(LOC('-o')); KADD(OUTNAME(0)); KADD(LOC('-dynamic-linker')); KADD(LOC(DLP));
 KADD(LOC(C1P)); KADD(LOC(C2P)); ADDOBJS(0); KADD(LOC(LCP)); KADD(LOC('-L')); KADD(LOC(LIBD)); KADD(LOC('-lc')); LMADD(LOC(LIBD)); HAVELGC NE 0 => KADD(LOC(LGCB)); KADD(LOC(C3P));
 RUNLD(0));

# WHETHER THE C STRING A BEGINS WITH THE C STRING P #
SUBR STARTS(A,P) IS ((CCALL strncmp(A,P,CCALL strlen(P)) AND 4294967295)=0 => 1 ELSE 0);

# WHETHER THE FILE NAME A ENDS IN THE C STRING E #
SUBR ENDS(A,E) IS (
 LA,LE ARE LOCAL;
 LA:=CCALL strlen(A); LE:=CCALL strlen(E);
 LA<LE => RETURN 0;
 (CCALL strcmp(A+(LA-LE),E) AND 4294967295)=0 => 1 ELSE 0);

SUBR DRVHELP(Z) IS (
 CCALL puts(LOC('usage: imp [options] file.imp ...'));
 CCALL puts(LOC('  -c                 compile to an object file, file.o, and do not link'));
 CCALL puts(LOC('  -S                 compile to the assembly of the target, file.s'));
 CCALL puts(LOC('  -Sir               compile to LLVM IR text, file.ll'));
 CCALL puts(LOC('  -o FILE            name the output (a.out for a program)'));
 CCALL puts(LOC('  -O0 -O1 -O2 -O3 -Os -Oz   the optimization level (-O is -O1; the last one given wins; -Os is the default); or set IMPOPT'));
 CCALL puts(LOC('  --target=TRIPLE    for another system (with -c, -S, -Sir), say aarch64-linux-gnu or riscv64-unknown-linux-musl'));
CCALL puts(LOC('  --sysroot=DIR      with --target and no -c: the root of that system, for its C library (DIR/usr/lib/crt1.o ...); or IMPSYSROOT'));
 CCALL puts(LOC('  --runtime=FILE     with --target and no -c: the libimp.a built for that system; or IMPRUNTIME'));
 CCALL puts(LOC('  -C FILE            a file of syntax or declarations, read before the sources (as /C on the tape)'));
 CCALL puts(LOC('  -H FILE            a file of declarations, read in front of each source (it is part of the source: a declaration holds to the end of it)'));
 CCALL puts(LOC('  -s LETTERS         the switches of the original compiler (A listing, T tree, ...)'));
 CCALL puts(LOC('  -I IMAGE           start from the compiler saved by /U or /V'));
 CCALL puts(LOC('  (no file)          the commands of the original compiler, from the terminal or a pipe: OBJ,LIST_FILE/switches'));
 CCALL puts(LOC('  --version, --help'));
 0);

# THE OPTIMIZATION LEVEL THE TEXT A NAMES (THE LETTERS AFTER -O): NOTHING IS 1, 0 TO 3 ARE THEIR NUMBERS, S IS 4, Z IS 5; -1 IF IT IS NONE OF THESE #
SUBR OPTLVL(A) IS (
 C ARE LOCAL;
 C:=IMPBYTE(A,0);
 C=0 => RETURN 1;
 IMPBYTE(A,1) NE 0 => RETURN 0-1;
 C GE 60B => (C LE 63B => RETURN C-60B);
 C=163B => RETURN 4;
 C=172B => RETURN 5;
 0-1);

# THE OPTIONS AND THE FILES OF THE COMMAND LINE, IN ANY ORDER AS THE C COMPILER'S: A NAME THAT ENDS IN .O, .A OR .SO IS TO BE LINKED, ANY OTHER IS A SOURCE (A FILE OF SYNTAX OR DECLARATIONS IS NAMED BY -C, AS THE TAPE'S /C).  A MISTAKE ENDS THE PROGRAM (2) #
SUBR OPTS(Z) IS (
 I,A,V ARE LOCAL;
 DHV:=CCALL calloc(NA0+1,8); DNH:=0; DSRCV:=CCALL calloc(NA0+1,8); DOBJI:=CCALL calloc(NA0+1,8); DKV:=CCALL calloc(NA0+1,8); DSYV:=CCALL calloc(NA0+1,8); DNSRC:=0; DNOBJI:=0; DNK:=0; DNSY:=0;
 DSTOP:=170B; DINTER:=0; OUTN:=0; DSW:=0; DIMG:=0; DTGT:=0; DSIR:=0; DOPT:=0-1; DEMP:=0; DSYSROOT:=ENVOR(LOC('IMPSYSROOT'),0); DRUNTIME:=ENVOR(LOC('IMPRUNTIME'),0);
 I:=1;
 OP1: I GE NA0 => RETURN 0;
      A:=DARG(I); I:=I+1;
      ((IMPBYTE(A,0) NE 55B) OR (IMPBYTE(A,1)=0)) => GO TO OPF;                   # A FILE (AND - ALONE IS NOT AN OPTION) #
      CCALL strcmp(A,LOC('-c'))=0 => (DSTOP:=157B; GO TO OP1);
      CCALL strcmp(A,LOC('-S'))=0 => (DSTOP:=123B; DSIR:=0; GO TO OP1);
      CCALL strcmp(A,LOC('-Sir'))=0 => (DSTOP:=123B; DSIR:=1; GO TO OP1);
      CCALL strcmp(A,LOC('--version'))=0 => (CCALL puts(LOC('imp 0.10.0')); CCALL exit(0));
      ((CCALL strcmp(A,LOC('--help'))=0) OR (CCALL strcmp(A,LOC('-h'))=0)) => (DRVHELP(0); CCALL exit(0));
      STARTS(A,LOC('--target='))=1 => (DTGT:=A+9; GO TO OP1);
      STARTS(A,LOC('--sysroot='))=1 => (DSYSROOT:=A+10; GO TO OP1);
      STARTS(A,LOC('--runtime='))=1 => (DRUNTIME:=A+10; GO TO OP1);
      ((CCALL strcmp(A,LOC('--sysroot'))=0) OR (CCALL strcmp(A,LOC('--runtime'))=0)) => (
          I GE NA0 => GO TO OPM;
          CCALL strcmp(A,LOC('--sysroot'))=0 => DSYSROOT:=DARG(I) ELSE DRUNTIME:=DARG(I);
          I:=I+1; GO TO OP1);
      ((CCALL strcmp(A,LOC('--target'))=0) OR (CCALL strcmp(A,LOC('-target'))=0)) => (
          I GE NA0 => GO TO OPM;
          DTGT:=DARG(I); I:=I+1; GO TO OP1);
      STARTS(A,LOC('-O'))=1 => (V:=OPTLVL(A+2);
                                V<0 => (OUTSTR('imp: unknown option '); OUTCS(A); OUTCHR(12B); CCALL exit(2));
                                DOPT:=V; GO TO OP1);                                                    # -O, -O0 ... -O3, -OS, -OZ #
      STARTS(A,LOC('-o'))=1 => (IMPBYTE(A,2) NE 0 => (OUTN:=A+2; GO TO OP1);              # -OFILE #
                                I GE NA0 => GO TO OPM;
                                OUTN:=DARG(I); I:=I+1; GO TO OP1);                       # -O FILE #
      CCALL strcmp(A,LOC('-H'))=0 => (
          I GE NA0 => GO TO OPM;
          IMPARGSET(DHV,DNH,DARG(I)); DNH:=DNH+1; I:=I+1; GO TO OP1);                          # IN FRONT OF EACH SOURCE #
      CCALL strcmp(A,LOC('-C'))=0 => (
          I GE NA0 => GO TO OPM;
          IMPARGSET(DKV,DNK,DARG(I)); DNK:=DNK+1; IMPARGSET(DSYV,DNSY,DARG(I)); DNSY:=DNSY+1;      # IN THE ORDER GIVEN, WITH THE SOURCES #
          I:=I+1; GO TO OP1);
      ((CCALL strcmp(A,LOC('-s'))=0) OR (CCALL strcmp(A,LOC('-I'))=0)) => (
          I GE NA0 => GO TO OPM;
          CCALL strcmp(A,LOC('-s'))=0 => DSW:=DARG(I) ELSE DIMG:=DARG(I);
          I:=I+1; GO TO OP1);
      OUTSTR('imp: unknown option '); OUTCS(A); OUTCHR(12B); CCALL exit(2);
 OPM: OUTSTR('imp: missing argument to '); OUTCS(A); OUTCHR(12B); CCALL exit(2);
 OPF: ((ENDS(A,LOC('.o'))=1) OR (ENDS(A,LOC('.a'))=1) OR (ENDS(A,LOC('.so'))=1)) => (IMPARGSET(DOBJI,DNOBJI,A); DNOBJI:=DNOBJI+1; GO TO OP1);
      IMPARGSET(DKV,DNK,A); DNK:=DNK+1;                                                  # SYNTAX AND SOURCES, IN THE ORDER GIVEN: THE KERNEL READS THEM SO #
      IMPARGSET(DSRCV,DNSRC,A); DNSRC:=DNSRC+1;
      GO TO OP1);

# WHERE THE PARTS ARE: THE SOURCE TREE (BUILD/DIR/IMPD) OR INSTALLED (DIRB, SYNP, FFIP, LIBP, TMPB) #
SUBR SETPATHS(Z) IS (
 EXEDIR(DARG(0))<0 => (OUTSTR('imp: cannot find myself'); OUTCHR(12B); CCALL exit(1));
 CCALL snprintf(LOC(ROOT),4096,LOC('%s/..'),LOC(DIRB));
 CCALL snprintf(LOC(SYNP),4096,LOC('%s/share/imp/syntax.imc'),LOC(ROOT));
 EXISTS(LOC(SYNP)) NE 0 => (CCALL snprintf(LOC(FFIP),4096,LOC('%s/share/imp/ffi.imc'),LOC(ROOT));
                            CCALL snprintf(LOC(LIBP),4096,LOC('%s/lib/imp/libimp.a'),LOC(ROOT));
                            CCALL snprintf(LOC(TMPB),4096,LOC('/tmp')))                # INSTALLED: THE SYSTEM'S TEMPORARY DIRECTORY #
   ELSE (CCALL snprintf(LOC(SYNP),4096,LOC('%s/../src/syntax.imc'),LOC(ROOT));
         CCALL snprintf(LOC(FFIP),4096,LOC('%s/../lib/ffi.imc'),LOC(ROOT));
         CCALL snprintf(LOC(LIBP),4096,LOC('%s/lib/libimp.a'),LOC(ROOT));
         CCALL snprintf(LOC(TMPB),4096,LOC('%s/../tmp'),LOC(ROOT)));       # THE TREE'S OWN (GITIGNORED) TMP/ #
 IMPTMPBASE(LOC(TMPB));                           # (TMPDIR, IF IT IS AN ABSOLUTE PATH NAMING A DIRECTORY, ELSE THIS: USED ONLY WHEN A FILE IS NEEDED) #
 OVERRIDE(LOC(SYNP),LOC('IMPSYNTAX')); OVERRIDE(LOC(FFIP),LOC('IMPFFI')); OVERRIDE(LOC(LIBP),LOC('IMPLIB'));
 CCALL snprintf(LOC(UTFP),4096,LOC('%s'),LOC(FFIP));                    # THE SYMBOLS OF UTF-8 ARE BESIDE THE C INTERFACE (LIB/UTF8.IMC) #
 CCALL strcpy(CCALL strrchr(LOC(UTFP),57B)+1,LOC('utf8.imc'));
 0);

# THE COMMANDS OF THE ORIGINAL, FROM THE TERMINAL: THE KERNEL ALONE, WITH THE SYNTAX, THE FILES NAMED, THEN THE TERMINAL.  NEVER RETURNS #
SUBR RUNINTER(Z) IS (
 K ARE LOCAL;
 KA:=CCALL calloc((DNK+12),8); KNN:=0;
 QUIET:=1; IMPHOOK:=1;                                 # EACH COMPILATION WRITES ITS OBJECT, THE REL FILE #
 KADD(LOC('imps0'));
 DSW NE 0 => (KADD(LOC('-s')); KADD(DSW));
 DIMG NE 0 => (KADD(LOC('-I')); KADD(DIMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)); KADD(LOC(UTFP)));
 K:=0; RI1: K<DNK => (IMPARGET(LOC(DW),DKV,K); KADD(DW); K:=K+1; GO TO RI1);
 ARGVP:=KA;
 CCALL exit(IMPKI(KNN,KA)));

# ONE SOURCE, COMPILED IN THIS PROCESS: THE KERNEL WRITES THE IR TO MEMORY (NO FILE), THE BACK END MAKES WHAT -c, -S, -SIR OR NOTHING (A PROGRAM) ASKS FOR.  A TEMPORARY FILE IS MADE ONLY FOR THE OBJECT OF A PROGRAM TO BE
  LINKED (IMPTMPOBJ, SRC/../LIB/IMPHOST.IML: A MEMORY FILE ON LINUX, ELSE A PRIVATE DIRECTORY).  NEVER RETURNS #
SUBR ONEFILE(SRC) IS (
 R,K,S,H ARE LOCAL;
 S:=SRC;                                                       # (SRC IS DW, WHICH THE LOOP BELOW READS INTO) #
 BASEOF(SRC,LOC(BASEN));
 KA:=CCALL calloc(DNK+(2*DNH)+16,8); KNN:=0;                           # THE KERNEL, IN THIS PROCESS #
 KADD(LOC('imps0'));
 DSW NE 0 => (KADD(LOC('-s')); KADD(DSW); CCALL dup2(2,1)) ELSE QUIET:=1;        # THE DUMPS GO WITH THE MESSAGES #
 DIMG NE 0 => (KADD(LOC('-I')); KADD(DIMG)) ELSE (KADD(LOC(SYNP)); KADD(LOC(FFIP)); KADD(LOC(UTFP)));
 K:=0; OK1: K<DNK => (IMPARGET(LOC(DW),DKV,K);
                      DW=S => (H:=0; OK2: H<DNH => (KADD(LOC('-H')); IMPARGET(LOC(DW),DHV,H); KADD(DW); H:=H+1; GO TO OK2);
                               IMPARGET(LOC(DW),DKV,K));          # THE FILES OF DECLARATIONS GO IN FRONT OF THE SOURCE #
                      KADD(DW); K:=K+1; GO TO OK1);
 ARGVP:=KA;
 IMPOPENIRMEM(0) NE 0 => CCALL exit(1);
 IMPK(KNN,KA) NE 0 => CCALL exit(1);
 IMPCLOSEIRMEM(0) NE 0 => CCALL exit(1);
 CCALL fflush(0);
 DSTOP=123B => (DSIR NE 0 => R:=LLVMSAVEB(IRBUF,IRLEN,OUTNAME(LOC('.ll'))) ELSE R:=LLVMASMB(IRBUF,IRLEN,OUTNAME(LOC('.s')));
               CCALL exit((R NE 0 => 1 ELSE 0)));
 DSTOP=157B => CCALL exit((LLVMOBJB(IRBUF,IRLEN,OUTNAME(LOC('.o'))) NE 0 => 1 ELSE 0));
 LLVMOBJMEM(IRBUF,IRLEN) NE 0 => (MSG('? OBJECT FILE NOT WRITTEN'); CCALL exit(1));
 IMPTMPOBJ(LVOBJP,LVOBJN,LOC(OFILE)) NE 0 => CCALL exit(1);
 DOBJL:=CCALL calloc(DNOBJI+2,8); IMPARGSET(DOBJL,0,LOC(OFILE)); DNOBJL:=1;
 K:=0;
 OF1: K<DNOBJI => (IMPARGET(LOC(DW),DOBJI,K); IMPARGSET(DOBJL,DNOBJL,DW); DNOBJL:=DNOBJL+1; K:=K+1; GO TO OF1);
 CCALL exit(LNK(0)));

# MORE THAN ONE SOURCE: EACH IS COMPILED BY A PROGRAM OF ITS OWN, AS THE C COMPILER DOES (THIS PROGRAM, RUN WITHOUT A SHELL), TO NAME.O (-c), NAME.S (-S), NAME.LL (-SIR) OR AN OBJECT IN THE PRIVATE TEMPORARY
  DIRECTORY TO BE LINKED WITH THE OTHERS.  NEVER RETURNS #
SUBR MULTI(Z) IS (
 K,S,BAD,FL,C ARE LOCAL;
 DOBJL:=CCALL calloc(DNSRC+DNOBJI+2,8); DNOBJL:=0; BAD:=0;
 DSTOP=157B => FL:=LOC('-c');
 DSTOP=170B => FL:=LOC('-c');
 DSTOP=123B => (DSIR NE 0 => FL:=LOC('-Sir') ELSE FL:=LOC('-S'));
 K:=0;
 ML1: K<DNSRC => (
     IMPARGET(LOC(DW),DSRCV,K); S:=DW;
     KA:=CCALL calloc(DNSY+(2*DNH)+12,8); KNN:=0;
     KADD(LOC(DSELFB)); KADD(FL);
     DSTOP=170B => (CCALL snprintf(LOC(DB1),24,LOC('o%d.o'),K);
                    IMPTMPPATH(LOC(DB1),LOC(DB3)) NE 0 => CCALL exit(1);
                    KADD(LOC('-o')); KADD(CCALL strdup(LOC(DB3))));
     CCALL snprintf(LOC(DB1),8,LOC('-O%c'),IMPBYTE(LOC('0123sz'),DOPT)); KADD(CCALL strdup(LOC(DB1)));
     DSW NE 0 => (KADD(LOC('-s')); KADD(DSW));
     DIMG NE 0 => (KADD(LOC('-I')); KADD(DIMG));
     DTGT NE 0 => (CCALL snprintf(LOC(DB1),4096,LOC('--target=%s'),DTGT); KADD(CCALL strdup(LOC(DB1))));
     C:=0; MH1: C<DNH => (IMPARGET(LOC(DW),DHV,C); KADD(LOC('-H')); KADD(DW); C:=C+1; GO TO MH1);
     C:=0; MS1: C<DNSY => (IMPARGET(LOC(DW),DSYV,C); KADD(LOC('-C')); KADD(DW); C:=C+1; GO TO MS1);
     KADD(S);
     IMPARGSET(KA,KNN,0);
     IMPRUNKID(KNN,KA) NE 0 => BAD:=1;
     DSTOP=170B => (IMPARGSET(DOBJL,DNOBJL,CCALL strdup(LOC(DB3))); DNOBJL:=DNOBJL+1);        # A COPY: DB3 IS WRITTEN AGAIN FOR THE NEXT FILE #
     K:=K+1; GO TO ML1);
 BAD NE 0 => CCALL exit(1);
 DSTOP NE 170B => CCALL exit(0);
 K:=0; ML2: K<DNOBJI => (IMPARGET(LOC(DW),DOBJI,K); IMPARGSET(DOBJL,DNOBJL,DW); DNOBJL:=DNOBJL+1; K:=K+1; GO TO ML2);
 CCALL exit(LNK(0)));

# FOR A LINK FOR ANOTHER SYSTEM WITH NO --SYSROOT OR --RUNTIME: WHAT IMP-SYSROOT HAS MADE OF THE SYSTEM, ITS C LIBRARY'S FILES AND THE RUNTIME LIBRARY, IN ITS CACHE (IMP-SYSROOT --PATH TARGET WRITES THEM, ONE TO A LINE); IF IT HAS NOT, IMP-SYSROOT
  FETCHES THEM (IMPFETCH=0 FORBIDS THAT) AND THEY ARE LOOKED FOR AGAIN.  THE TOOL IS BESIDE THIS PROGRAM OR IN THE PATH; WITHOUT IT NOTHING HAPPENS AND THE USUAL MESSAGE SAYS WHAT IS NEEDED #
SUBR CROSSPATH(Z) IS (
 F,K,P ARE LOCAL;
 CCALL snprintf(LOC(DB1),4096,LOC('%s/imp-sysroot --path %s 2>/dev/null'),LOC(DIRB),DTGT);
 F:=CCALL popen(LOC(DB1),LOC('r'));
 F=0 => RETURN 0;
 K:=0;
 CP1: CCALL fgets(LOC(DB3),4096,F)=0 => GO TO CP9;
      P:=CCALL strchr(LOC(DB3),10); P NE 0 => CCALL memset(P,0,1);
      K=0 => (DSYSROOT=0 => DSYSROOT:=CCALL strdup(LOC(DB3)));
      K=1 => (DRUNTIME=0 => DRUNTIME:=CCALL strdup(LOC(DB3)));
      K:=K+1; GO TO CP1;
 CP9: (CCALL pclose(F) AND 4294967295)=0 => RETURN 1;
 0);

SUBR CROSSAUTO(Z) IS (
 I,C ARE LOCAL;
 ((DSYSROOT NE 0) AND (DRUNTIME NE 0)) => RETURN 0;
 I:=0;                                                             # (THE TARGET IS TEXT THE SHELL READS: ONLY THE CHARACTERS OF A TRIPLE OR OS/ARCH ARE LET THROUGH) #
 CA1: C:=IMPBYTE(DTGT,I); C=0 => GO TO CA2;
      (((C GE 97) AND (C LE 122)) OR ((C GE 65) AND (C LE 90)) OR ((C GE 48) AND (C LE 57)) OR (C=45) OR (C=95) OR (C=46) OR (C=47)) => (I:=I+1; GO TO CA1);
      RETURN 0;
 CA2: CROSSPATH(0) NE 0 => RETURN 0;
 IMPBYTE(ENVOR(LOC('IMPFETCH'),LOC('1')),0)=60B => RETURN 0;                 # (IMPFETCH=0: NOTHING IS DOWNLOADED) #
 CCALL snprintf(LOC(DB1),4096,LOC('%s/imp-sysroot --auto %s 1>&2'),LOC(DIRB),DTGT);
 CCALL system(LOC(DB1)) NE 0 => RETURN 0;
 CROSSPATH(0));

SUBR IMPD(Z) IS (
 P,V,Q ARE LOCAL;
 NA0:=CCALL impargc(0); AV0:=CCALL impargvp(0);
 P:=CCALL strrchr(DARG(0),57B);
 Q:=CCALL strrchr(DARG(0),134B);                      # (WINDOWS: THE PATH OF THE PROGRAM HAS BACKSLASHES) #
 Q NE 0 => (P=0 => P:=Q ELSE (Q>P => P:=Q));
 P=0 => P:=DARG(0) ELSE P:=P+1;
 CCALL strncmp(P,LOC('impstage'),8)=0 => GO TO DRV;
 CCALL strcmp(P,LOC('imp'))=0 => GO TO DRV;
 CCALL strcmp(P,LOC('imp.exe'))=0 => GO TO DRV;
 ARGVP:=AV0;                                       # ANOTHER NAME (IMPD): THE KERNEL ALONE #
 CCALL exit(IMPK(NA0,AV0));
 DRV: OPTS(0);
 DOPT<0 => (V:=ENVOR(LOC('IMPOPT'),0);                              # NO -O GIVEN: THE ENVIRONMENT, OR -OS #
            V=0 => DOPT:=4 ELSE (STARTS(V,LOC('-O'))=1 => V:=V+2; DOPT:=OPTLVL(V); DOPT<0 => DOPT:=4));
 LLVMOPT(DOPT);
 ((DNSRC=0) AND (DNOBJI=0)) => DINTER:=1;                        # NO FILE: THE COMMANDS OF THE ORIGINAL (A PROMPT ON THE STANDARD ERROR, THE COMMANDS ON THE STANDARD INPUT: A TERMINAL, A PIPE, EXPECT) #
 ((OUTN NE 0) AND (DSTOP NE 170B) AND (DNSRC>1)) => (OUTSTR('imp: cannot name the output with more than one source to compile'); OUTCHR(12B); CCALL exit(1));
 SETPATHS(0);
 CCALL snprintf(LOC(DSELFB),4096,LOC('%s/%s'),LOC(DIRB),P);        # THIS PROGRAM, FOR THE ONES IT STARTS #
 DTGT NE 0 => (LLVMTARGET(DTGT) NE 0 => CCALL exit(1));
 ((DTGT NE 0) AND (DSTOP=170B)) => CROSSAUTO(0);                  # (A LINK FOR ANOTHER SYSTEM: ITS FILES FROM IMP-SYSROOT, IF NO --SYSROOT AND --RUNTIME SAY WHERE THEY ARE) #
 DINTER NE 0 => RUNINTER(0);
 DNSRC=0 => (DOBJL:=DOBJI; DNOBJL:=DNOBJI; CCALL exit(LNK(0)));       # ONLY OBJECTS: LINK THEM #
 DNSRC>1 => MULTI(0);
 IMPARGET(LOC(DW),DSRCV,0);
 ONEFILE(DW))
%%
