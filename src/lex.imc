TWOSEG;
#LEX: LEXICAL ANALYZER MODULE FOR IMP COMPILER, FOR THE 64 BIT PORT.
 SEE DECUS/LEX.IMC FOR THE ORIGINAL AND DOCS/PORTING/MODULES.MD FOR THE DIFFERENCES.
 A TOKEN IS A RUN OF LETTERS AND DIGITS; A TEXT IN APOSTROPHES (THE TOKEN KEEPS ITS OPENING
 APOSTROPHE AND LOSES THE CLOSING ONE; TWO APOSTROPHES ARE ONE); A TEXT BETWEEN EXCLAMATION MARKS (THE
 MARKS ARE DROPPED); OR ONE OTHER NON-BLANK CHARACTER.  BLANKS AND CONTROL CHARACTERS SEPARATE TOKENS;
 A TEXT BETWEEN NUMBER SIGNS IS A COMMENT.
 THE LINE AND THE TOKEN ARE PACKED, A CHARACTER (A BYTE, UTF-8) TO A BYTE, EIGHT TO A WORD, AND ARE STEPPED THROUGH
 WITH BYTE POINTERS AS IN THE ORIGINAL; THE TOKEN IS A NAME OF THE DIRECTORY AS IT IS.  THE FILE IS READ WITH THE C
 LIBRARY'S FOPEN AND IMPGETC WHERE THE ORIGINAL READS BUFFERS OF A CHANNEL (OPENIN, INPUT, BHEAD); BYTES OF 128 AND UP
 ARE LETTERS, SO THAT A NAME MAY BE IN UTF-8.  THE ARRAYS ARE FILLED THROUGH POINTERS INTO FREE STORAGE, WHICH DOES NOT MOVE
 (SEE CORE IN FREE).  C IS AN ORDINARY VARIABLE OF THE MODULE, WHERE THE ORIGINAL KEEPS IT IN A RESERVED REGISTER. #

FINAM IS COMMON;

EXTERNAL PTR strdup(PTR);
EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL VOID free(PTR);


# THE FILES OF DECLARATIONS THAT GO IN FRONT OF EACH SOURCE (-H OF IMP): LEXHDR(P) ADDS THE FILE NAMED BY THE C STRING P TO THE ONES THAT THE SOURCES OPENED FROM NOW ON ARE READ BEHIND, EACH FILE
  AND THEN THE SOURCE AS ONE INPUT (A DECLARATION HOLDS TO THE END OF ITS UNIT, WHICH IS THE END OF THE SOURCE).  THE FIRST LEXIN, THE SYNTAX, IS BEFORE THE FIRST OF THEM #
SUBR LEXHDR(P) IS (
 PA ARE LOCAL;
 PA:=P;
 HDV=0 => HDV:=CCALL calloc(65,8);
 NHD<64 => (IMPARGSET(HDV,NHD,PA); NHD:=NHD+1);
 0);

# AT THE END OF A FILE OF DECLARATIONS THE NEXT IS OPENED, AND AFTER THE LAST THE SOURCE: 0 IF THERE IS ANOTHER INPUT, 1 AT THE END OF THE SOURCE #
SUBR LEXNEXT(Z) IS (
 W ARE LOCAL;
 HDI GE NHD => RETURN 1;
 HDI:=HDI+1;
 CCALL impfclose(CHAN);
 HDI<NHD => (IMPARGET(LOC(W),HDV,HDI); CHAN:=CCALL fopen(W,LOC('r')))
   ELSE CHAN:=CCALL fopen(SRCN,LOC('r'));
 CHAN=0 => RETURN 1;
 0);

SUBR LEXIN(NAME) IS (
 W ARE LOCAL;
 CHAN NE 0 => CCALL impfclose(CHAN);
 NHD=0 => CHAN:=CCALL fopen(NAME,LOC('r'))
   ELSE (SRCN NE 0 => CCALL free(SRCN);
         SRCN:=CCALL strdup(NAME); HDI:=0;
         IMPARGET(LOC(W),HDV,0); CHAN:=CCALL fopen(W,LOC('r'));
         CHAN=0 => (OUTSTR('imp: cannot read the declarations file '); OUTCS(W); OUTCHR(12B)));
 CHAN=0 => RETURN -1;
 LINIT=0=>(LINIT:=1;
	LINE:=FALLOT('LEXL',20); LLINE:=90;
	TOKE:=FALLOT('LEXT',20); LTOKE:=90;
	PC:=QC:=BYTEP FREE(LINE)<7,36>;
	K0:=BYTEP FREE(TOKE)<7,36>);
 FREES(LINE,0);
 PC:=QC; SKIP:=0;
 SYN:=INS:=P1:=P2:=0;
 PCT:=0);

SUBR LEX(S) IS (
     C:=CSV; K:=K0; ITOKE:=0;
 T0: SKIP=0 => NEXTCHAR(); SKIP:=0;
     ISANM=0 => GO TO T2;
     FC:=C; NC:=0;
 T1: <+K>:=C; NC:=NC+1; NEXTCHAR();
     ISANM => GO TO T1;
     (NC=1) AND (FC=CODE('R')) => (C=047B => (RSTR(0); GO TO LX);
                                   C=042B => (SYN=0 => (RSTR(1); GO TO LX));
                                   C=041B => (RSTR(2); GO TO LX));       # R'TEXT', R"TEXT" AND R!'TEXT!: THE CHARACTERS RIGHT-JUSTIFIED IN A NUMBER #
     SKIP:=-1; GO TO LX;
 T2: C LE 040B=>GO TO T0;
     C=043B => (T3: NEXTCHAR();
                C NE 043B => GO TO T3;
                GO TO T0);
     C=047B => (T4: <+K>:=C; NEXTCHAR();
                C NE 047B => GO TO T4;
		NEXTCHAR(); C=047B=>GO TO T4;
		SKIP:=-1;
                K=K0+1 => (K:=K0; <+K>:=060B);              # '' IS THE CONSTANT 0, AS IT IS ON THE TAPE #
                GO TO LX);
     C=041B => (T5: NEXTCHAR();
                C NE 041B => (<+K>:=C; GO TO T5);
                GO TO LX);
     C=042B => (SYN=0 => ((LC LT 060B) OR (LC GT 071B) => (CSTR(0); K=K0+1 => (K:=K0; <+K>:=060B); GO TO LX)));      # "TEXT" WITH C'S ESCAPES, AS A STRING CONSTANT (SEE CSTR; "" IS THE CONSTANT 0, AS '' IS); A " AFTER A DIGIT IS THE EXPONENT OF A REAL (3.27"-5); IN A SYNTAX STATEMENT " IS THE DELIMITER OF A SEMANTIC STRING #
     C=042B => (SYN NE 0 => INS:=1-INS);
     <+K>:=C;
     C=072B => (LC NE 072B => (NEXTCHAR(); C=075B => (<+K>:=C; GO TO LX); SKIP:=-1));    # := IS ONE TOKEN, ::= IS NOT #
 LX: <+K>:=0 FOR I FROM 7;
     CSV:=C;
     TKSTATE(0);
     S:=DIR(FREE(TOKE)); IC);

SUBR LEXSAV() IS (PC0:=PC; IC0:=IC; SKIP0:=SKIP; CSV0:=CSV; ISANM0:=ISANM; SYN0:=SYN; INS0:=INS; P10:=P1; P20:=P2; SKIP:=0);

SUBR LEXRES() IS (PC:=PC0; IC:=IC0; SKIP:=SKIP0; CSV:=CSV0; ISANM:=ISANM0; SYN:=SYN0; INS:=INS0; P1:=P10; P2:=P20);

# WHERE A " IS THE DELIMITER OF A SEMANTIC STRING AND WHERE IT STARTS A C STRING: A SYNTAX STATEMENT (<..> ::= ... ::= ...;) IS FROM ITS ::= (THE TOKENS : : =) TO ITS ; OR ITS % OUTSIDE A SEMANTIC STRING;
  IN IT EVERY " IS A TOKEN OF ITS OWN AND INS SAYS WHETHER WE ARE BETWEEN A PAIR; ANYWHERE ELSE A " STARTS A STRING.  SYN AND INS ARE THE STATE, P1 AND P2 THE KINDS OF THE LAST TWO TOKENS (1 :, 2 =, 0 ANY OTHER) #
SUBR TKSTATE(Z) IS (
 W,B0,K ARE LOCAL;
 W:=FREE(TOKE); B0:=CHR0(W);
 K:=0;
 CHR(W,1) NE 0 => (P2:=P1; P1:=0; RETURN 0);                        # (MORE THAN ONE CHARACTER: NOT ONE OF THESE) #
 B0=CODE(':') => K:=1;
 B0=CODE('=') => K:=2;
 K=2 => P1=1 => P2=1 => SYN:=1;
 B0=CODE(';') => INS=0 => SYN:=0;
 B0=CODE('%') => INS=0 => SYN:=0;
 P2:=P1; P1:=K;
 0);

# R'TEXT': THE CHARACTERS OF THE STRING, ONE TO EIGHT, RIGHT-JUSTIFIED IN A NUMBER (THE LAST IN THE LOW BYTE; THE TAPE'S ARE ONE TO FIVE, 7 BITS EACH).  THE LEXER HAS READ THE R AND STANDS AT THE ' OR " OR ! THAT FOLLOWS, WHICH IS THE
  WAY THE FORM OF THE STRING IS TOLD (\'TEXT', "TEXT" WITH C'S ESCAPES, OR !'TEXT!, WHICH R MAY PREFIX AS WELL).  THE STRING IS READ INTO THE TOKEN AS IT WOULD BE, AND THE TOKEN BECOMES THE NUMBER, IN OCTAL WITH A B (UP TO 22 DIGITS) #
SUBR RSTR(F) IS (
 FA,N,V,I,B,Q,DG,P0 ARE LOCAL;
 FA:=F;
 K:=K0;
 FA=0 => (<+K>:=047B; RA1: NEXTCHAR(); C NE 047B => (<+K>:=C; GO TO RA1);
          NEXTCHAR(); C=047B => (<+K>:=C; GO TO RA1));
 FA=1 => CSTR(0);
 FA=2 => (NEXTCHAR(); C=047B => (<+K>:=047B; RA2: NEXTCHAR(); C NE 041B => (<+K>:=C; GO TO RA2); NEXTCHAR())
          ELSE (ERROR(1,'R REQUIRES TEXT CONSTANT OPERAND.'); K:=K0; <+K>:=060B; <+K>:=102B; SKIP:=-1; RETURN 0));
 SKIP:=-1;
 N:=K-K0;                                                            # THE BYTES OF THE TOKEN, THE LEADING ' INCLUDED #
 V:=0; Q:=K0; I:=0;
 <+Q>;
 RV1: I<N-1 => (V:=(V LS 8) OR <+Q>; I:=I+1; GO TO RV1);
 N>9 => ERROR(1,'R TAKES AT MOST EIGHT CHARACTERS.');
 K:=K0;
 V=0 => (<+K>:=060B; <+K>:=102B; RETURN 0);
 DG:=22; P0:=0;
 RV2: DG>0 => (DG:=DG-1; B:=(V RS (3*DG)) AND 7;
               (B NE 0) OR (P0 NE 0) => (<+K>:=060B+B; P0:=1);
               GO TO RV2);
 <+K>:=102B;
 0);

# THE VALUE OF A HEXADECIMAL DIGIT, -1 IF CH IS NONE #
SUBR HEXV(CH) IS (
 H ARE LOCAL;
 H:=CH;
 H GE CODE('0') => (H LE CODE('9') => RETURN H-CODE('0'));
 H GE CODE('A') => (H LE CODE('F') => RETURN (H-CODE('A'))+10);
 H GE CODE('a') => (H LE CODE('f') => RETURN (H-CODE('a'))+10);
 0-1);

# A BYTE OF A C STRING: PUT IN THE TOKEN UNLESS A \0 HAS ENDED THE STRING (THE REST OF IT UP TO THE CLOSING " IS READ AND LEFT OUT) #
SUBR CPUT(V) IS (DEAD=0 => (<+K>:=V); 0);

# THE BYTES OF THE CODE POINT U IN UTF-8 ARE PUT IN THE TOKEN AT K (THE POINTER OF LEX) #
SUBR PUTU(U) IS (
 X ARE LOCAL;
 X:=U;
 X<128 => (CPUT(X); RETURN 0);
 X<2048 => (CPUT(192 OR (X RS 6)); CPUT(128 OR (X AND 63)); RETURN 0);
 X<65536 => (CPUT(224 OR (X RS 12)); CPUT(128 OR ((X RS 6) AND 63)); CPUT(128 OR (X AND 63)); RETURN 0);
 CPUT(240 OR (X RS 18)); CPUT(128 OR ((X RS 12) AND 63)); CPUT(128 OR ((X RS 6) AND 63)); CPUT(128 OR (X AND 63));
 0);

# CSTR: "TEXT" AT THE " THAT STARTS IT: THE TOKEN IS THE ONE OF A STRING IN APOSTROPHES (THE APOSTROPHE AND THE BYTES) AND IT IS THE SAME STRING CONSTANT.  THE ESCAPES ARE C'S: \N \T \R \A \B \F \V \E
  \0 (WHICH ENDS THE STRING: A STRING IS ASCIZ) \\ \" \' \XHH (ONE BYTE) \UHHHH AND \UHHHHHHHH (A CODE POINT, AS UTF-8); ANY OTHER CHARACTER AFTER A \ IS ITSELF.  THE STRING ENDS AT THE NEXT " THAT IS NOT ESCAPED, ON ITS LINE #
SUBR CSTR(Z) IS (
 V,D,I,N ARE LOCAL;
 DEAD:=0; CPUT(047B);
 CS1: NEXTCHAR();
      C=CODE('"') => (NEXTCHAR(); SKIP:=-1; RETURN 0);
      C=12B => (ERROR(1,'A STRING IN QUOTES ENDS AT THE END OF THE LINE.'); SKIP:=-1; RETURN 0);
      C NE CODE('\') => (CPUT(C); GO TO CS1);
      NEXTCHAR();
      C=CODE('n') => (CPUT(12B); GO TO CS1);
      C=CODE('t') => (CPUT(11B); GO TO CS1);
      C=CODE('r') => (CPUT(15B); GO TO CS1);
      C=CODE('a') => (CPUT(7); GO TO CS1);
      C=CODE('b') => (CPUT(10B); GO TO CS1);
      C=CODE('f') => (CPUT(14B); GO TO CS1);
      C=CODE('v') => (CPUT(13B); GO TO CS1);
      C=CODE('e') => (CPUT(33B); GO TO CS1);
      C=CODE('0') => (DEAD:=1; GO TO CS1);
      C=CODE('x') => (N:=2; GO TO CS2);
      C=CODE('u') => (N:=4; GO TO CS2);
      C=CODE('U') => (N:=8; GO TO CS2);
      CPUT(C); GO TO CS1;
 CS2: V:=0; I:=0;
      CS3: I<N => (NEXTCHAR(); D:=HEXV(C);
                   D<0 => (ERROR(1,'A HEXADECIMAL DIGIT IS EXPECTED AFTER \X OR \U IN A STRING.'); SKIP:=-1; RETURN 0);
                   V:=(V LS 4) OR D; I:=I+1; GO TO CS3);
      N=2 => CPUT(V) ELSE PUTU(V);
      GO TO CS1);


SUBR NEXTCHAR() IS (
 (ITOKE:=ITOKE+1) GE LTOKE=>(
	TOKE:=FALLOT(OTOKE:=TOKE,(17+LTOKE:=LTOKE+50)/8);
	K:=K-8*(OTOKE:=OTOKE-TOKE); K0:=K0-8*OTOKE);
 NEXT: LC:=C; C:=<+PC>; IC:=IC+1;
 C=0 => (PC:=QC; OPCT:=PCT;
	 ILINE:=0;
         GCHRS: (ILINE:=ILINE+1) GE LLINE=>(
		LINE:=FALLOT(OTOKE:=LINE,(17+LLINE:=LLINE+50)/8);
		PC:=PC-8*(OTOKE:=OTOKE-LINE); QC:=QC-8*OTOKE);
         C:=IMPGETC(CHAN);
         C<0 => (LEXNEXT(0) NE 0 => ERROR(0,'PREMATURE END OF INPUT FILE'); C:=12B);
	 C NE 12B=>(C=><+PC>:=C;
	         C=CODE('(') => PCT:=PCT+1;
	         C=CODE(')') => PCT:=PCT-1;
		GO TO GCHRS);
         <+PC>:=0; PC:=QC; IC:=TFL:=0;
         PLINE(FREE(LINE),OPCT); C:=12B);
 #ISANM IS MADE NON-ZERO FOR ALPHA-NUMERIC CHARS#
 ISANM:=(1 LS 31) AND ISTAB[C RS 5] LS 37B AND C;
 CMDM => (C=137B => ISANM:=0));      # A COMMAND LINE IS NOT IMP: THERE _ SEPARATES, AS IT DID IN THE ORIGINAL (SEE READCMD) #

#ISTAB IS THE ORIGINAL'S TABLE OF A BIT FOR EACH CHARACTER, A WORD OF 32 BITS FOR 32 CHARACTERS, THE FIRST AT THE TOP BIT OF THE 32 (THE ORIGINAL HAS 36): THE DIGITS, THE
 LETTERS, THE UNDERSCORE (A NAME IS A VALID C NAME; ASSIGNMENT IS :=), THE LOWER CASE LETTERS, AND, TO TAKE UTF-8, ALL OF 128 AND UP#
ISTAB: DATA(0,177700B,17777777741B,17777777740B,37777777777B,37777777777B,37777777777B,37777777777B);

SUBR PLINE1(OL) IS (TFL=0=>(TFL:=-1; RC:=QC; J:=0;
 WHILE (I:=<+RC>) DO (
	(J:=J+1)=OL=>OUTCHR(12B); OUTCHR(I));
 OUTCHR(12B)));

SUBR PLINE(BF,PCT) IS (
 FINAM[5] AND 4000B => PRINT IGR 3,PCT,STG 0,' ',BF,/;
 FINAM[5] AND 100000000B => MSG(BF));

# GETTY(BF): A LINE FROM THE TERMINAL, WITH THE PROMPT (ON THE STANDARD ERROR, AS A SHELL'S IS), IN BF; -1 AT THE END OF THE INPUT (^D).  THE TAPE TURNED A TYPED ! INTO \ (A TOPS-10 TERMINAL HAD NO BACKSLASH); A UNIX KEYBOARD HAS BOTH, AND ! QUOTES A NAME (!DIR/FILE.IMP!).  A TAB IS A BLANK #
SUBR GETTY(BF) IS (OUTSTR('*');
                   Q:=BYTEP BF<7,36>; N:=0;
                   PL: C:=INCHWL(0);
                       C<0 => RETURN -1;
                       C=011B => C:=040B;
                       C GE 040B => (N<4128 => (<+Q>:=C; N:=N+1));
                       C NE 12B => GO TO PL;
                   <+Q>:=045B; <+Q>:=0);

SUBR READCMD(BF,FINAM,FREL,FLST,DEV,RPGM) IS (
# REL,LST_DEV:FILE.EXT[PJ,PG]/A/B...(AB...)PGM\% #
 FINAM[I]:=0 FOR I FROM 5; DEV:='DSK';
 FREL:=FREL[1]:=FLST:=FLST[1]:=0;
 KEY IS 8 LONG; K:=BYTEP ',_.[/(%'<7,36>;
 KEY[I]:=DIR(CHAT(<+K>,0)) FOR I IN 1,1,7;
 CMA:=KEY[1]; LAR:=KEY[2];
 COL:=DIR(':'); BSL:=DIR('\');
 LEXSAV(); PC:=BYTEP BF<7,36>; CMDM:=1;
 L0: LEX(S);
 L1: (S=KEY[I] => GO TO L2) FOR I IN 7,-1,1;
 L2: GO TO (K00,K1,K2,K3,K4,K5,K6,K7) I;
 K00: LEX(S1);
     S1=BSL => (K:=GNAME(S); RPGM[I]:=[K+8*I] FOR I FROM 3; GO TO L0);
     S1=CMA => (PUTN(FREL,S,1); S:=S1; GO TO L1);
     S1=LAR => (PUTN(FREL,S,1); GO TO L0);
     S1=COL => (PUTN(DEV,S,0); LEX(S); LEX(S1));
     PUTN(FINAM,S,1); S:=S1; GO TO L1;
 K1: LEX(S); S=LAR=> GO TO L0;
     PUTN(FLST,S,1); GO TO L0;
 K2: GO TO L0;
 K3: LEX(S); PUTN(FINAM[2],S,0); GO TO L0;
 K4: LEX(S); PUTO(FINAM[3],S); LEX(S);
     LEX(S); PUTO(FINAM[4],S); LEX(S); GO TO L0;
 K5: LEX(S); PUTSW(FINAM[5],S); GO TO L0;
 K6: LEX(S); PUTSW(FINAM[5],S); LEX(S); GO TO L0;
 K7: FLST => FINAM[5]:=FINAM[5] OR 4000B;
     FREL=0 => (FREL:=FINAM; FREL[1]:=FINAM[1]);
     FLST=0 => (FLST:=FINAM; FLST[1]:=FINAM[1]);
     CMDM:=0; LEXRES());

# PUTN(X,S,N): THE TAPE COPIES THE FIRST N+1 WORDS OF THE NAME OF THE TOKEN S TO X (SIX SIXBIT CHARACTERS A WORD).  HERE A NAME OF A FILE (N>0) IS KEPT WHOLE, A UNIX NAME OF ANY LENGTH: A COPY OF IT AS A C STRING, ITS ADDRESS IN THE FIRST WORD OF X AND 0 IN THE SECOND (MKNAME OF IMPM READS IT); THE ONE WORD (N=0) OF THE DEVICE AND THE EXTENSION IS AS ON THE TAPE #
SUBR PUTN(X,S,N) IS (K:=GNAME(S);
                     N=0 => (X:=[K]; RETURN 0);
                     X:=CCALL strdup(K); X[1]:=0);

SUBR PUTO(X,S) IS (X:=0; K:=GNAME(S); K:=BYTEP [K]<7,36>;
                   WHILE I:=<+K> DO X:=(X LS 3)+I-060B);

SUBR PUTSW(X,S) IS (K:=GNAME(S); K:=BYTEP [K]<7,36>;
                    WHILE I:=<+K> DO X:=X OR 1 LS 37B AND I-101B)%%
