TWOSEG;
#LEX: LEXICAL ANALYZER MODULE FOR IMP COMPILER, FOR THE 64 BIT PORT.
 SEE DECUS/LEX.IMC FOR THE ORIGINAL AND DOCS/PORTING/MODULES.MD FOR THE DIFFERENCES.
 A TOKEN IS A RUN OF LETTERS AND DIGITS; A TEXT IN APOSTROPHES (THE TOKEN KEEPS ITS OPENING
 APOSTROPHE AND LOSES THE CLOSING ONE; TWO APOSTROPHES ARE ONE); A TEXT BETWEEN EXCLAMATION MARKS (THE
 MARKS ARE DROPPED); OR ONE OTHER NON-BLANK CHARACTER.  BLANKS AND CONTROL CHARACTERS SEPARATE TOKENS;
 A TEXT BETWEEN NUMBER SIGNS IS A COMMENT.
 THE LINE AND THE TOKEN ARE PACKED, A CHARACTER (A BYTE, UTF-8) TO A BYTE, EIGHT TO A WORD, AND ARE STEPPED THROUGH
 WITH BYTE POINTERS AS IN THE ORIGINAL; THE TOKEN IS A NAME OF THE DIRECTORY AS IT IS.  THE FILE IS READ WITH THE C
 LIBRARY'S FOPEN AND IMPGETC WHERE THE ORIGINAL READS BUFFERS OF A CHANNEL (OPENIN, INPUT, BHEAD); BYTES OF 128 AND UP
 ARE LETTERS, SO THAT A NAME MAY BE IN UTF-8.  THE ARRAYS ARE FILLED THROUGH POINTERS INTO FREE STORAGE, WHICH DOES NOT MOVE
 (SEE CORE IN FREE).  C IS AN ORDINARY VARIABLE OF THE MODULE, WHERE THE ORIGINAL KEEPS IT IN A RESERVED REGISTER. #

FINAM IS COMMON;


SUBR LEXIN(NAME) IS (
 SRCFP NE 0 => CCALL impfclose(SRCFP);
 SRCFP:=CCALL fopen(NAME,LOC('r'));
 SRCFP=0 => RETURN -1;
 LINIT=0=>(LINIT:=1;
	LINE:=FNEW('LEXL',20); LLINE:=90;
	TOKE:=FNEW('LEXT',20); LTOKE:=90;
	PC:=QC:=BYTEP FREE(LINE)<7,36>;
	K0:=BYTEP FREE(TOKE)<7,36>);
 FREES(LINE,0);
 PC:=QC; SKIP:=0;
 PCT:=0);

SUBR LEX(S) IS (
     C:=CSV; K:=K0; ITOKE:=0;
 T0: SKIP=0 => NEXTCHAR(); SKIP:=0;
     ISANM=0 => GO TO T2;
 T1: <+K>:=C; NEXTCHAR();
     ISANM => GO TO T1;
     SKIP:=-1; GO TO LX;
 T2: C LE 040B=>GO TO T0;
     C=043B => (T3: NEXTCHAR();
                C NE 043B => GO TO T3;
                GO TO T0);
     C=047B => (T4: <+K>:=C; NEXTCHAR();
                C NE 047B => GO TO T4;
		NEXTCHAR(); C=047B=>GO TO T4;
		SKIP:=-1;
                GO TO LX);
     C=041B => (T5: NEXTCHAR();
                C NE 041B => (<+K>:=C; GO TO T5);
                GO TO LX);
     <+K>:=C;
     C=072B => (LC NE 072B => (NEXTCHAR(); C=075B => (<+K>:=C; GO TO LX); SKIP:=-1));    # := IS ONE TOKEN, ::= IS NOT #
 LX: <+K>:=0 FOR I FROM 7;
     CSV:=C;
     S:=DIR(FREE(TOKE)); IC);

SUBR LEXSAV() IS (PC0:=PC; IC0:=IC; SKIP0:=SKIP; CSV0:=CSV; ISANM0:=ISANM; SKIP:=0);

SUBR LEXRES() IS (PC:=PC0; IC:=IC0; SKIP:=SKIP0; CSV:=CSV0; ISANM:=ISANM0);

SUBR NEXTCHAR() IS (
 (ITOKE:=ITOKE+1) GE LTOKE=>(
	TOKE:=FALLOT(OTOKE:=TOKE,(17+LTOKE:=LTOKE+50)/8);
	K:=K-8*(OTOKE:=OTOKE-TOKE); K0:=K0-8*OTOKE);
 NEXT: LC:=C; C:=<+PC>; IC:=IC+1;
 C=0 => (PC:=QC; OPCT:=PCT;
	 ILINE:=0;
         GCHRS: (ILINE:=ILINE+1) GE LLINE=>(
		LINE:=FALLOT(OTOKE:=LINE,(17+LLINE:=LLINE+50)/8);
		PC:=PC-8*(OTOKE:=OTOKE-LINE); QC:=QC-8*OTOKE);
         C:=IMPGETC(SRCFP);
         C<0 => ERROR(0,'PREMATURE END OF INPUT FILE');
	 C NE 12B=>(C=><+PC>:=C;
	         C=CODE('(') => PCT:=PCT+1;
	         C=CODE(')') => PCT:=PCT-1;
		GO TO GCHRS);
         <+PC>:=0; PC:=QC; IC:=TFL:=0;
         PLINE(FREE(LINE),OPCT); C:=12B);
 #ISANM IS MADE NON-ZERO FOR ALPHA-NUMERIC CHARS#
 ISANM:=(1 LS 31) AND ISTAB[C RS 5] LS 37B AND C;
 CMDM => (C=137B => ISANM:=0));      # A COMMAND LINE IS NOT IMP: THERE _ SEPARATES, AS IT DID IN THE ORIGINAL (SEE READCMD) #

#ISTAB IS THE ORIGINAL'S TABLE OF A BIT FOR EACH CHARACTER, A WORD OF 32 BITS FOR 32 CHARACTERS, THE FIRST AT THE TOP BIT OF THE 32 (THE ORIGINAL HAS 36): THE DIGITS, @ AND THE
 LETTERS, THE UNDERSCORE (A NAME IS A VALID C NAME; ASSIGNMENT IS :=), ` AND THE LOWER CASE LETTERS, AND, TO TAKE UTF-8, ALL OF 128 AND UP#
ISTAB: DATA(0,177700B,37777777741B,37777777740B,37777777777B,37777777777B,37777777777B,37777777777B);

SUBR PLINE1(OL) IS (TFL=0=>(TFL:=-1; RC:=QC; J:=0;
 WHILE (I:=<+RC>) DO (
	(J:=J+1)=OL=>OUTCHR(12B); OUTCHR(I));
 OUTCHR(12B)));

SUBR PLINE(BF,PCT) IS (
 FINAM[5] AND 4000B => PRINT IGR 3,PCT,STG 0,' ',BF,/;
 FINAM[5] AND 100000000B => MSG(BF));

SUBR GETTY(BF) IS (OUTSTR('*');
                   Q:=BYTEP BF<7,36>; N:=0;
                   PL: C:=INCHWL(0);
                       C<0 => RETURN -1;
                       C=041B => C:=134B;
                       C GE 040B => (N<136 => (<+Q>:=C; N:=N+1));
                       C NE 12B => GO TO PL;
                   <+Q>:=045B; <+Q>:=0);

SUBR READCMD(BF,FINAM,FREL,FLST,DEV,RPGM) IS (
# REL,LST_DEV:FILE.EXT[PJ,PG]/A/B...(AB...)PGM\% #
 FINAM[I]:=0 FOR I FROM 5; DEV:='DSK';
 FREL:=FREL[1]:=FLST:=FLST[1]:=0;
 KEY IS 8 LONG; K:=BYTEP ',_.[/(%'<7,36>;
 KEY[I]:=DIR(CHAT(<+K>,0)) FOR I IN 1,1,7;
 CMA:=KEY[1]; LAR:=KEY[2];
 COL:=DIR(':'); BSL:=DIR('\');
 LEXSAV(); PC:=BYTEP BF<7,36>; CMDM:=1;
 L0: LEX(S);
 L1: (S=KEY[I] => GO TO L2) FOR I IN 7,-1,1;
 L2: GO TO (K00,K1,K2,K3,K4,K5,K6,K7) I;
 K00: LEX(S1);
     S1=BSL => (K:=GNAME(S); RPGM[I]:=[K+8*I] FOR I FROM 3; GO TO L0);
     S1=CMA => (PUTN(FREL,S,1); S:=S1; GO TO L1);
     S1=LAR => (PUTN(FREL,S,1); GO TO L0);
     S1=COL => (PUTN(DEV,S,0); LEX(S); LEX(S1));
     PUTN(FINAM,S,1); S:=S1; GO TO L1;
 K1: LEX(S); S=LAR=> GO TO L0;
     PUTN(FLST,S,1); GO TO L0;
 K2: GO TO L0;
 K3: LEX(S); PUTN(FINAM[2],S,0); GO TO L0;
 K4: LEX(S); PUTO(FINAM[3],S); LEX(S);
     LEX(S); PUTO(FINAM[4],S); LEX(S); GO TO L0;
 K5: LEX(S); PUTSW(FINAM[5],S); GO TO L0;
 K6: LEX(S); PUTSW(FINAM[5],S); LEX(S); GO TO L0;
 K7: FLST => FINAM[5]:=FINAM[5] OR 4000B;
     FREL=0 => (FREL:=FINAM; FREL[1]:=FINAM[1]);
     FLST=0 => (FLST:=FINAM; FLST[1]:=FINAM[1]);
     CMDM:=0; LEXRES());

SUBR PUTN(X,S,N) IS (K:=GNAME(S); X[I]:=[K+8*I] FOR I FROM N);

SUBR PUTO(X,S) IS (X:=0; K:=GNAME(S); K:=BYTEP [K]<7,36>;
                   WHILE I:=<+K> DO X:=(X LS 3)+I-060B);

SUBR PUTSW(X,S) IS (K:=GNAME(S); K:=BYTEP [K]<7,36>;
                    WHILE I:=<+K> DO X:=X OR 1 LS 37B AND I-101B)%%
