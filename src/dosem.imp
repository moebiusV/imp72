TWOSEG;
#THIS IS FILE DOSEM, SEMANTIC ARRAY INTERPRETER FOR IMP COMPILERS, FOR THE 64 BIT PORT.
 SEE DECUS/DOSEM.IMC FOR THE ORIGINAL AND ITS (LONG) COMMENTS, DOCS/PORTING/DOSEM.MD FOR
 THE DIFFERENCES.

DOSEM IS CALLED BY COTREE WITH A POINTER INTO THE SEMANTIC ARRAY SEMS.  A WORD OF SEMS IS A 36 BIT
NUMBER (SX36, U36):

           BITS 17-0   V (ADDRESS OR VALUE FIELD).
           BITS 29-18  N (AUXILIARY COUNT FIELD).
           BITS 35-30  TYPE  0=THIS IS BEGINNING OF A SEMANTIC ROUTINE WITH
                                   N ARGUMENTS.  BITS 29-27 ARE PRIORITY FOR
                                   IMMEDIATE EXECUTION BY COTREE.  V IS THE
                                   INDEX OF THE PRODUCTION'S ENTRY IN PROSEM.
                             1=THIS IS END OF SEMANTICS.  (SO IS SECOND TYPE 0.)
                             2=PUSH STACK POINTER OF PARAMETER V ONTO PSTAK.
                             3=CALL SEMANTIC SUBROUTINE V WITH N BOTTOM ENTRIES
                                   OF PSTAK AND PUT RESULT ON PSTAK.
                             4=PUSH THE VALUE -V AS NEXT SEMANTICS PARAMETER.
                             5-7, 10-12: SEE THE ORIGINAL.

THE SEMANTIC ROUTINES ARE C FUNCTIONS, CALLED THROUGH IMPSEMCALL (THE ORIGINAL JUMPS TO THE
ADDRESS IN THE JSA INSTRUCTION).  THE C ROUTINES THAT THIS CALLS ARE CALLED THROUGH
STAGE0/IMPGLUE.C, BY REFERENCE: IMPSETSTK, IMPSTPOP, IMPSTACK, IMPCODENT, IMPCFUDGE,
IMPPSTACK, IMPSEMCALL, IMPSYNARG, IMPNEWNAMEG, IMPDSEMS2.  PAR AND THE SEMPER/STACK ENTRIES ARE
C (STAGE0/DOSEM_IMP.C).  SEMS, NSEMS, PROSEM, NPROSEM, SCRATCH AND CASEP ARE COMMON FOR THE C
SIDE (SRC/SHARED.TXT).  #

SEMS,NSEMS,PROSEM,NPROSEM,SCRATCH,CASEP ARE COMMON;
PARS IS 10 LONG;
<ATOM> ::= MARGS ::= "10";

SUBR DOSEM(PPO) IS (
 NPO_L18(PPO); PO_R18(PPO);
 PO=1 => GO TO DOSEX;
 FINAM IS COMMON; TR_FINAM[5] AND 100000B;
 S_PO; NCASEP_NT0_0; FREES(PSTAK,0);
 NEXTSEM: SE_U36(FREE(SEMS+S)); STY_SE RS 30; SVAL_R18(SE);
 TR => (PRINT STG 0,' [', OCT 0,S,STG 0,'] = ',OCT 12,SE);
 GO TO (TYPE0,TYPE1,TYPE2,TYPE3,TYPE4,TYPE5,
                TYPE6,TYPE7,TYPE10,TYPE11,TYPE12) STY;
 ERROR(0,'BAD TYPE IN SEMANTICS'); GO TO TYPEX;
 TYPE0: NT0=>GO TO TYPE1;    # SECOND TYPE 0 IS A TYPE 1 #
        NT0_1;
        NPO=>GO TO NXSEM;
        SCRATCH_SNARG(S);
 # TRY TO INSURE STACK WON'T MOVE DURING DOSEM, WHICH WOULD BE DISASTROUS. #
        IMPSETSTK(MANY,0,0,0);
        IMPSTPOP(SCRATCH-1);
        GO TO NXSEM;
 TYPE1: NPO=0=>(J_FREE(PSTAK); K_IMPSTACK(0);
                J=K => GO TO TYPEX;
                J>K => J LE (K+3*SCRATCH) => (FREES(K,FREE(J)); FREES(K+1,FREE(J+1));
                                              FREES(K+2,FREE(J+2)); GO TO TYPEX);
                J=0=>(FREES(K+2,0); GO TO TYPEX);
                PRINT /,OCT 0,PPO,STG 0,'=',OCT 0,J,STG 0,', ';
                ERROR(2,'BAD RESULT OF SEMANTICS; IGNORED **');
                GO TO TYPEX);
        S_NPO; NPO_NT0_0; GO TO NEXTSEM;
 TYPE2: SW_IMPSTACK(SVAL); FADD(PSTAK,NPSTAK,SW);
        GO TO NXSEM;
 TYPE3: SVAL=0=>ERROR(0,'ATTEMPT TO EXECUTE UNDEFINED SEMANTIC ROUTINE.');
        SN_7777B AND L18(SE);
        NPSTAK_NPSTAK-SN;
        SN LE MARGS=>NPSTAK GE 0 =>GO TO L1;
        ERROR(0,'** TOO MANY ARGS TO SEMANTIC RTN OR PARAM STACK UNDERFLOW **');
        L1: SN => (JX_PSTAK+NPSTAK+SN;
                   (JX_JX-1; PARS[I]_FREE(JX)) FOR I FROM SN-1);
        J_IMPSEMCALL(SVAL,PARS);
        FADD(PSTAK,NPSTAK,J); GO TO NXSEM;
 TYPE10:
 TYPE4:
 TYPE5: SVAL_SE AND 007777777777B;
        (SVAL AND 004000000000B)=>SVAL_SVAL OR 770000000000B;
        STY=4=>(FADD(PSTAK,NPSTAK,-SVAL); GO TO NXSEM);
        STY=10B=>(FADD(CASEP,NCASEP,-SVAL); GO TO NXSEM);
        J_1;
        SVAL>0=>(# USE PARS FOR LOCAL VBLS SINCE SEMANTIC RTNS AND "STUFF" NEVER
                                                                   ARE MIXED. #
                 SVAL>777777B=>((I_(L18(SVAL))-1)>MARGS=>(I_1; ERROR(1,
                             ' TOO MANY LOCAL SYMBOLS IN REFERENCED SEMANTICS'));
                                (SVAL_R18(SVAL))=>(
                                             SVAL_IMPNEWNAMEG(SVAL);
                                             PARS[I]_SVAL);
                                SVAL_PARS[I]));
        SVAL<0=>(J_0; SVAL_-SVAL);
        IMPCODENT(SX36(J OR ((SVAL LS 9) LS 9)),0,0,0);
        GO TO NXSEM;
 TYPE6:
 TYPE7: J_IMPSTACK(SVAL);
        I_FREE(J);
        (I AND 77B)=0=>FREE(J+1)=>(# VALUE SEMANTICS - REPLACE ORIG. PRODN NR #
               I_FREE(J+1);
               FREES(J,SX36(0777777000000B AND I));
               FREES(J+1,0));
        IMPCODENT(FREE(J),FREE(J+1),FREE(J+2),STY-6);
        GO TO NXSEM;
 TYPE11:NPSTAK_NPSTAK-1; J_FREE(PSTAK+NPSTAK);
        QQ_FREE(PSTAK+NPSTAK-1); FREES(PSTAK+NPSTAK-1,SX36(J+QQ));
        GO TO NXSEM;
 TYPE12:J_IMPSTACK(0);
        FREES(J,SX36((SVAL LS 9) LS 9));
        FREES(J+1,SX36((((PO LS 9) LS 9)) OR (7777B AND L18(SE))));
        FREES(J+2,0);
        FREES(PSTAK,J);
        IMPCFUDGE(0);
 NXSEM: TR=>(PRINT STG 0,'=>STK[',IGR 0,NPSTAK,STG 0,']=';
        J_FREE(PSTAK+NPSTAK); K_IMPSTACK(0);
        J GE K=>J LE (K+3*SCRATCH)=>
        (IMPPSTACK(K,J-K); GO TO LL1);
        PRINT IGR 0,J,/; LL1:0);
 S_S+1; GO TO NEXTSEM;
 TYPEX: TR=>PRINT /; NPSTAK_0;
 DOSEX: 0);

SUBR SEMFIX(I,A) IS (
 NA_I0_0;
 L2: K_FREE(A+NA); K GE 0=>(NA_NA+1; GO TO L2);
 J_FREE(SEMS+I);
 FREES(SEMS+I,SX36(((NA LS 9) LS 9) OR (U36(J) AND 0776000777777B)));
 NA_NA-1;
 J_I;
 L3: J_J+1;
     K_FREE(SEMS+J);
     JT_U36(K) RS 30;
     GO TO (L10,L11,L12,L3,L14,L14,L12,L12,L3,L3,L3) JT;
 L10: I0=>GO TO L11;
      I0_1; GO TO L3;
 L12: JT_4 OR (2 AND (JT RS 1));
      K_SX36(U36(IMPSYNARG(R18(K))) OR 040000000000B);
      FREES(SEMS+J,K);
 L14: (U36(K) AND 004000000000B)=0=>NA GE 0=>(K_R18(K))=>(
        (KT_FREE(A+KK);
         KT=(-K)=>(FREES(SEMS+J,SX36(70000000000B OR KK)); GO TO L3);
         KT=K=>(JT=4=>FREES(SEMS+J,SX36(20000000000B OR KK))
                   ELSE (FREES(SEMS+J,SX36(60000000000B OR KK));
                         FREES(A+KK,-KT));
                GO TO L3)) FOR KK TO NA);
      # CHECK FOR VAL/ ARGUMENTS #
      (U36(K) AND 004000000000B)=>(
            KT_-SX36(U36(K) OR 0770000000000B);
            KT<1000000B=>GO TO L3;
            NA GE 0=>((JJ_FREE(A+KK);
                       JJ=KT=>(FREES(SEMS+J,SX36(0600000000000B OR KK));
                               GO TO L3)) FOR KK TO NA));
      GO TO L3;
 L11: 0);

SUBR SEMFX1(I,A,NA) IS (
 NA=0=>GO TO L20;
 J_I+1;
 L21: K_FREE(SEMS+J);
 JT_U36(K) RS 30;
 JT=5=>(U36(K) AND 004000000000B)=>(K_-SX36(0770000000000B OR U36(K))) GE 1000000B=>(
    K_R18(K);
    (JJ_-FREE(A+KK);
     JJ<0=>JJ_DPROP('SEM',-JJ);
     JJ=K=>(FREES(A+KK,-(JJ OR ((JJ LS 9) LS 9)));
            FREES(SEMS+J,SX36(060000000000B OR KK)))) FOR KK FROM NA-1);
 JT>1=>(J_J+1; GO TO L21);
 L20: 0);

SUBR DOCASE(ID,SEMN,PRODN) IS (
 # ROUTINE TO MAKE PROSEM ENTRIES FOR ALL CASES OF CASE ID UNDER PRODN,
     WHERE SEMN IS THE SEMANTICS FOR THE SETUP. #
 JD_DPROP('SEM',ID);
 JD=0=>(ERROR(1,'CASE UNDEFINED ** '); IMPPNAME(ID); PRINT /;
        GO TO DOCEX);
 JD_R18(FREE(SEMS+JD));
 # OR IN LEVEL BITS FOR CODE GENERATION TREE #
 JE_FREE(PROSEM+JD); JE<0=>JE_-JE;
 NOTEPROD(PRODN,-1);
 KD_PROSEM+R18(FREE(SEMS+PRODN));
 KE_FREE(KD); KE<0=>KE_-KE; FREES(KD,SX36(KE OR JE));
 JD_FREE(PROSEM+JD+1);
 L29: JD=>(JE_FREE(PROSEM+JD+1); JD_FREE(PROSEM+JD);
           ENPROD(PRODN,L18(JD),SX36(SEMN OR ((JE LS 9) LS 9)));
           JD_R18(JD);
           GO TO L29);
 DOCEX: 0);

SUBR ENPROD(PN,NO,SEM) IS (
 J_FREE(SEMS+PN);
 (K_R18(J))=0=>(K_NPROSEM; FADD(PROSEM,NPROSEM,0);
                       FADD(PROSEM,NPROSEM,0);
                       FREES(SEMS+PN,SX36(J OR K)));
 J_FREE(PROSEM+K+1);
 FREES(PROSEM+K+1,NPROSEM);
 FADD(PROSEM,NPROSEM,SX36(J OR ((NO LS 9) LS 9)));
 FADD(PROSEM,NPROSEM,SEM));

SUBR MATCHP(PN,N) IS (
 J_R18(FREE(SEMS+PN));
 J=0 => GO TO MATCHPX;
 J_FREE(PROSEM+J+1);
 LM1: J=>(JX_PROSEM+J; K_FREE(JX);
          N=L18(K) => (J_FREE(JX+1); GO TO MATCHPX);
          J_R18(K); GO TO LM1);
 MATCHPX: J);

SUBR NOTEPROD(PN,N) IS (
 J_FREE(SEMS+PN);
 (K_R18(J))=0=>(K_NPROSEM; FADD(PROSEM,NPROSEM,0);
                                  FADD(PROSEM,NPROSEM,0);
                                  FADD(PROSEM,NPROSEM,NSNODES_NSNODES+1);
                                  FREES(SEMS+PN,SX36(J OR K)));
 J_FREE(PROSEM+K);
 J=0 => (J_-LS36(1,N))
   ELSE (J<0 => J_-J;
         J_J OR LS36(1,N));
 FREES(PROSEM+K,J));

SUBR PLIES(I) IS ((J_R18(FREE(SEMS+I)))=>J_FREE(PROSEM+J); J);

SUBR SNODEN(I) IS ((J_R18(FREE(SEMS+I)))=>J_FREE(PROSEM+J+2); J);

SUBR ENSTACK(V) IS(
 #TAKES A POS OR NEG. DIRECTORY INDEX, MAKES A SCRATCH STACK NODE.#
 SCRATCH>MANY=>ERROR(0,' SEMANTICS STACK OVERFLOW **');
 VV_V; V<0=>VV_-V;
 W_IMPSETSTK(SCRATCH,1 OR ((VV LS 9) LS 9),0,0);
 SCRATCH_SCRATCH+1; W);

SUBR RESETSEM(VAL,A) IS (
 J_FREE(SEMS+A);
 FREES(SEMS+A,SX36(R18(J) OR ((VAL LS 9) LS 9))));

SUBR SETSEM(TY,VAL) IS (
 SNIT=0=>(SNIT_1; FRELOT(SEMS,'SEMS',2200,0); NSEMS_2;
          MANY_31; #MAX STACK EXPANSION DURING ONE EXECUTION#
          FREES(SEMS+1,010000000001B);
          FRELOT(PSTAK,'SPSTK',20,0); NPSTAK_0;
          FRELOT(PROSEM,'PROSM',1200,0); NPROSEM_1;
          FRELOT(CASEP,'CASEP',10,0);
          IMPDSEMS2(0);
          NSNODES_0);
 V_NSEMS; FADD(SEMS,NSEMS,SX36(VAL OR (TY LS 30))); V);

SUBR SNARG(N) IS (777B AND L18(FREE(SEMS+N)));

SUBR SEMGET(N) IS (Q_R18(FREE(SEMS+N));
                   Q_FREE(PROSEM+Q+1);
                   R18(FREE(PROSEM+Q+1)));

SUBR SEMED(A) IS (7 AND (U36(FREE(SEMS+A)) RS 27));

SUBR SEMOR(A,N) IS (QQ_FREE(SEMS+N);
                    FREES(SEMS+N,SX36(QQ OR A)));

SUBR CKSVAL(V,I) IS ( # CHECKS IF [V] IS A VALUE (TYPE 12) CASE OF I #
 Q_U36(FREE(SEMS+V+1));
 VAL_0;
 (Q AND 0770000777777B)=U36(I OR 0120000000000B)=>VAL_1;
 VAL)%%%
