TWOSEG;
NG,NPRODS,GRNODES,GRNTGENT,GRNBITN ARE COMMON;   # THE C SIDE READS THEM (SRC/SHARED.TXT) #
GRBITM,GRNBITM ARE COMMON,3 LONG;

#THIS IS FILE GRAPH, GRAPH CREATION AND ACCESS MODULE FOR IMP COMPILERS, FOR THE
 64 BIT PORT.  SEE DECUS/GRAPH.IMC FOR THE ORIGINAL AND ITS COMMENTS, DOCS/PORTING/GRAPH.MD
 FOR THE DIFFERENCES.

THE SYNTAX GRAPH IS KEPT IN NODES OF NS WORDS EACH IN A FREE STORAGE ARRAY
POINTED TO BY GA.  THE FIRST NODE IS AT 1, THE LAST NODE IS AT NG.  THE ARRAY
IS INITIALIZED WITH A FREE NODE, SO THAT NG>0 IS ALWAYS TRUE.  THE NODE AT
1+NS*(N-1) IS NODE NUMBER N.

THE FORMAT FOR GRAPH NODES IS (HALVES ARE 32 BITS, AS IN DIR.IMP):

   WD. 0  LEFT HALF   INDEX OF ALT (ALTERNATE, DOWN LINK) OR 0
          RIGHT HALF  INDEX OF SCR (SUCCESSOR, RIGHT LINK) OR 0
   WD. 1  BITS 48-50  TYPE: 0=NONTERMINAL NODE
                            1=TERMINAL NODE
                            2=CIRCLED NONTERMINAL NODE
                            3=BOXED PRODUCTION NODE
                            5=NODE ON CHAIN OF TERMINAL ENTRY POINTS
          BITS 32-47  A ROW INDEX FOR THE NODE IN THE BIT MATRIX NBITM.
          BITS 0-31   PRODUCTION NODES: NUMBER OF PRODUCTION
                      NONTERMINAL AND TERMINAL NODES: DIR INDEX OF NAME

THE STATE THAT THE C SIDE READS HAS THE NAMES OF STAGE0/GRAPH.C: GA, NG, NPRODS,
GRNODES (NODES), GRNTGENT, GRNBITN, GRBITM, GRNBITM (SRC/SHARED.TXT).  THE C
ROUTINES THAT THIS CALLS ARE CALLED THROUGH STAGE0/IMPGLUE.C, WHICH TAKES ITS ARGUMENTS
BY REFERENCE: BITS, BITOR, BITZ, PUSHMI, PULLYU, POUT, PNAME,
DNAME AND IMPMSEC.  GA, PRP AND ALF ARE IN IMPSYN64. #

<ATOM>::=NS::="2"; #NS IS SIZE OF A GRAPH NODE #
<EXP> ::= <A>/NS::="A RS 1";

SUBR GRAPH(SYNT,NSYNT,PNQ) IS (PNR_PNQ;
 NPRODS_PNR;
 INIT=0=>(INIT_1;
          FRELOT(GA,'GRAPH',1300,0); FINCSET(GA,50);
          FREES(GA+2,7 LS GTSH);
          NG_GRNTGENT_NNODES_GRNBITN_1;
          FRELOT(GRNODES,'NODES',100,0);
          GRBITM[1]_625; GRNBITM[1]_150;
          GEPT_0);
 MAKING_NEWNO(0,0,2,FREE(SYNT));
 MAKENT_DPROP('NODE',FREE(SYNT));
 #COMMENCE BY LOOKING FOR ENTRY POINT/CIRCLED NODE FOR FIRST SYMBOL.#
 ENT_0;
 HOOK_DPROP('ENTRY',FREE(SYNT+1)); HOOKN_1;
 HOOK=>(J_GTYPE(HOOK); J=2=>ENT_HOOK);
 #IF NO ENTRY POINT, WE WILL HAVE TO ENTER THE WHOLE PRODUCTION - SO MAKE
  AN ENTRY POINT, AND THAT BECOMES THE HOOK-ON POINT.#
 HOOK=0=>(HOOK_NEWNO(0,0,6,FREE(SYNT+1));
          J_GTYPE(HOOK); J=1=>(GEPT_NEWNO(GEPT,HOOK,5,0))
                             ELSE(GMARK(HOOK); ENT_HOOK);
          DPROPS('ENTRY',FREE(SYNT+1),HOOK); GO TO MAKEIT);
 #CHECK IF WE CAN EXTEND HOOK-ON POINT FURTHER DOWN PRODUCTION#
 CHOOK: GMARK(HOOK);
        HOOKN=NSYNT=>GO TO CHECKIT;
        NHOOK_SCR(HOOK);
        LHOOK: NHOOK=0=>GO TO MAKEIT;
               SQ_GVAL(NHOOK);
               J_FREE(SYNT+HOOKN+1);
               J NE SQ=>(L3:NHOOK_ALT(NHOOK);
                            GO TO LHOOK);
               J_GTYPE(NHOOK); J>1=>GO TO L3;
               HOOK_NHOOK; HOOKN_HOOKN+1; GO TO CHOOK;
 #CHECK IF DUPLICATE PRODUCTION #
 CHECKIT: J_SCR(HOOK);
    CK1:  J=0=>GO TO MAKEIT;
          JJ_GTYPE(J);
          JJ=2=>(KK_GVAL(J); GO TO L22);
          JJ=3=>(KK_GVAL(SCR(J));
            L22: K_FREE(SYNT);
            KK=K=>(ERROR(2,'PRODUCTION DUPLICATES ONE ALREADY IN SYNTAX **');
                   JJ=2=>(# NEEDS PRODUCTION #
                          # THIS OK BECAUSE CIRCLED NODES CANT HAVE OR BE ALT #
                          SETSCR(HOOK,NEWNO(J,0,3,PNR));
                          GO TO GRAPHEX);
                   NPRODS_GVAL(J);
                   NPRODS=1=>(FREES(GA+J+1,3 LS GTSH OR PNR); NPRODS_PNR);
                   GO TO GRAPHEX));
          J_ALT(J);
          GO TO CK1;
 #NOW MAKE A STRING OF NODES OUT OF SYNT[0], PROD. NR., AND SYNT ENTRIES
   FROM HOOKN+1 TO NSYNT, IF ANY.  CONNECT STRING AS SCR TO HOOK.  DONE.#
 MAKEIT:
 # INSERT PROD'N 1 NODE IF NEEDED TO AVOID ALT TO TYPE 2 NODE #
 (HOOKN=NSYNT=>PNR=0=>SCR(HOOK)=>PNR_1);
 J_MAKING;
 PNR=>(J_NEWNO(0,J,3,PNR));
 HOOKN<NSYNT=>((J_NEWNO(0,J,4,FREE(SYNT+K))) FOR K IN NSYNT,-1,HOOKN+1);
 SETALT(J,SCR(HOOK));
 SETSCR(HOOK,J);
# IF FIRST NODE IN PRODN WAS CIRCLED NODE, WE MUST UPDATE CONNECTIVITY
  MATRIX FOR ALL NODES THAT GET TO IT. #
 ENT=>(COL_DPROP('NODE',GVAL(ENT));
       ROW_1+ENT/NS;
       J_1+NG/NS;
       (BIT(GRBITM,NN,COL)=>(BIT(GRBITM,NN,MAKENT);
                              BITOR(GRBITM,NN,ROW))) FOR NN IN 1,1,J);
 GRAPHEX: FINAM IS COMMON;
  FINAM[5] AND 20B => (
     PRINT STG 0,'PRODUCTION ENTERED IN GRAPH: ';
     PNAME(FREE(SYNT)); PRINT STG 0,' [',OCT 0,NPRODS,STG 0,'] ';
     PNAME(FREE(SYNT+I)) FOR I IN 1,1,NSYNT; PRINT /);
 NPRODS);

SUBR SETSCR(SV,VV) IS (SQ_ALT(SV); FREES(GA+SV,VV OR SQ LS HSH));
SUBR SETALT(SV,VV) IS (SQ_SCR(SV); FREES(GA+SV,SQ OR VV LS HSH));
SUBR GENTRY() IS GEPT;
SUBR GCONN(Q,QGOAL) IS (QV_0; Q=>QV_BIT(GRBITM,1+Q/NS,QGOAL); QV);

SUBR GMADE(Q,QGOAL) IS (GRNBITM[2]=0 => 1 AND FREE(GRNBITM+GNB(Q)) RS QGOAL
                                 ELSE BIT(GRNBITM,GNB(Q),QGOAL));

SUBR GGOAL(NT) IS (
  GGOAL1_NEWNO(0,0,0,0); SETSCR(GGOAL1,GGOAL1);
  BITS(GRBITM,1+GGOAL1/NS,DPROP('NODE',NT));
  FREES(GA+GGOAL1+1,NT); GGOAL1);

SUBR GALT(Q,QGOAL) IS (QQ_Q;
 #RETURNS NEXT GRAPH NODE ALT TO Q WHICH CAN REACH GOAL QGOAL#
 L8: QQ_ALT(QQ); QQ=>BIT(GRBITM,1+QQ/NS,QGOAL)=0=>GO TO L8; QQ);

SUBR GNT2T(NT,NI,GL,NO) IS (
 L7: NI=0=>(NO_0; GO TO G2X);
 J_FREE(GRNODES+NI); NO_J AND HMASK;
 NI_J RS HSH;
 BIT(GRBITM,1+NO/NS,GL)=0=>GO TO L7;
 GLEAP(NT,NO)=0=>GO TO L7;
 G2X: NO);

# THE SPEEDED UP VERSION WORKS WITH A WORD OF THE MATRICES, OF 64 COLUMNS NOW, NOT 36 #
SUBR GNT2TX(NT,NI,GL,NO) IS (
 GL<64 => NT<64 => (MSK1_1 LS GL; MSK2_1 LS NT; GO TO GNT1);
 GNT2T(NT,NI,GL,NO); GO TO GNTX;
                  GNT1: NI=0 => (NO_0; GO TO GNTX);
                  J_FREE(GRNODES+NI);
                  NO_J AND HMASK; NI_J RS HSH;
                  (MSK1 AND FREE(GRBITM+(NO RS 1)+1))=0 => GO TO GNT1;
                  (MSK2 AND FREE(GRNBITM+GNB(NO)))=0 => GO TO GNT1;
 GNTX: NO);

SUBR GLEAP(NT,NO) IS (BIT(GRNBITM,GNB(NO),NT));

SUBR GNEXT(Q,QGOAL) IS (
 (Q0_Q)=0 => RETURN 0;
 GRBITM[2]=0 => (MASK_1 LS QGOAL;
              GNE1: Q0 => ((MASK AND FREE(GRBITM+(Q0 RS 1)+1))=0
                                  => (Q0_ALT(Q0); GO TO GNE1)))
         ELSE (GCONN(Q0,QGOAL)=0 => (Q0_GALT(Q0,QGOAL)));
 Q0);

SUBR NEWNO(DS,RTS,TYP,IDA) IS (
 ID_IDA;   # THE CALLERS PASS A WORD OF FREE STORAGE, WHICH MOVES WHEN MAKENO GROWS IT #
   #MAKES A NEW NODE GIVEN DOWN-SUCCESSOR, RIGHT-SUCCESSOR, TYPE AND
     DIR INDEX OF NAME.  FOR CIRCLED NODE, RETURNS EXISTING ONE IF ANY.
   TY=4=>DECIDE FROM NAME IF TYPE SHOULD BE 0 OR 1.  TY=6=>DECIDE BETWEEN
   1 AND 2.#
 TY_TYP;
 (TY AND 5)=4=>(NR_DNAME(ID,0); TY_TY AND 3;
                (NR AND 377B) NE 43B => TY_1);
 PTRS_RTS OR DS LS HSH;
 (TY AND 1)=0=>(#WE HAVE NONTERMINAL - CHECK IT HAS CIRCLED NODE #
                N1_DPROP('ENTRY',ID);
                N1=0=>(DPROPS('NODE',ID,GRNTGENT);
                       GRNTGENT_GRNTGENT+1;
                       N1_MAKENO((TY=0=>0 ELSE PTRS),2,GRNBITN,ID);
                       GRNBITN_GRNBITN+1;
                       DPROPS('ENTRY',ID,N1));
                TY=0=>(#WE WANT NON-CIRCLED NODE#
                       N1_MAKENO(PTRS,TY,0,ID));
                GO TO NEWEX);
 N1_MAKENO(PTRS,TY,0,ID);
 NEWEX: N1);

SUBR MAKENO(MW1,MTY,MNO,MID) IS (
 MW2_MID OR (MTY LS GTSH) OR (MNO LS HSH);
 MG_NG; FADD(GA,NG,MW1); FADD(GA,NG,MW2);
 MTY NE 2=>GMARK(MG) ELSE BITS(GRBITM,1+MG/NS,DPROP('NODE',MID));
 MG);

SUBR GMARK(NO) IS (
 IM_1+NO/NS;
 BITS(GRBITM,IM,MAKENT);
 BITOR(GRBITM,IM,1+MAKING/NS));

SUBR GMATR(TFL) IS (
 TIN_CALLI(27B,0);
 TFL<0=>GO TO GMTRX;
 BITZ(GRNBITM);
 NNODES_1;
 (J_FREE(GA+NN+1);
  ((J RS GTSH) AND 7)=1=>DPROPS('NODE',J AND HMASK,0)) FOR NN IN 1,NS,NG;
 (NN=GGOAL1=>GO TO M2;
  J_FREE(GA+NN+1); ((J RS GTSH) AND 7) NE 2 =>GO TO M2;
  PUSHMI(-1);
  COL_DPROP('NODE',J AND HMASK);
  ROW_(J RS HSH) AND NBMASK;
  BITS(GRNBITM,ROW,COL);
  BITS(GRBITM,1+NN/NS,COL);
  NO_SCR(NN);
  M1: NO=0=>(NO_PULLYU(0); NO=-1=>GO TO M2;
             ALTERM: NO_ALT(NO); GO TO M1);
  NODA_FREE(GA+NO+1); NOTY_(NODA RS GTSH) AND 7; NOID_NODA AND HMASK;
  NOTY=2=>(BITS(GRNBITM,ROW,DPROP('NODE',NOID));
           NO=NN=>GO TO ALTERM);
  NOTY=1=>(GRREQ(NOID,NO,NO);
           GO TO ALTERM);
  NOTY = 0 =>     (NTNR_DPROP('NODE',NOID);
                   GNT2B(NO);
                   K_GEPT;
                    M3: K=>(J_SCR(K);
                            BIT(GRBITM,1+J/NS,NTNR)=>GRREQ(
                                    FREE(GA+J+1) AND HMASK,NO,J);
                            K_ALT(K); GO TO M3);
                   GO TO ALTERM);
 PUSHMI(NO);
 NO_SCR(NO); GO TO M1;
 M2:  0) FOR NN IN 1,NS,NG;
 GMTRX: NN_CALLI(27B,0);
 TIM_TIM+NN-TIN; TIN_TIM;
 TFL<0=>TIM_0;
 TIN);

SUBR GRAPHF() IS (
 FALLOT(GA,0); FALLOT(GRNODES,0));

SUBR GRREQ(TN,NNR,ND) IS (
 GNT2B(ND);
 S_SS_DPROP('NODE',TN);
 L9: S=>(S_FREE(GRNODES+S);
         (S AND HMASK)=NNR=>GO TO GRREX;
         S_S RS HSH; GO TO L9);
 DPROPS('NODE',TN,NNODES);
 FADD(GRNODES,NNODES,NNR OR SS LS HSH);
 GRREX: 0);
SUBR GNT2B(ND) IS (
 NDA_FREE(GA+ND+1); NON_(NDA RS HSH) AND NBMASK;
 NON=0=>(NON_GRNBITN; GRNBITN_GRNBITN+1;
         FREES(GA+ND+1,NDA OR NON LS HSH));
 BITS(GRNBITM,NON,COL));

# GPOUT1 AND GPOUT2: WHERE THE ORIGINAL TESTS A BIT OF A NONTERMINAL NUMBER IN A WORD,
  THIS DOES NOT FOR A NUMBER OF 64 OR MORE (STAGE0/GRAPH.C DOES THE SAME) #
SUBR GPOUT1(CNODE,NNODE,PUT) IS (
 # PUTS OUT THE PRODUCTION NUMBERS ALONG A PATH FROM CNODE TO NNODE
  WHICH CONSISTS ONLY OF TYPE 2 AND 3 NODES.  NNODE IS A TERMINAL-
  OR NONTERMINAL-REQUIRED NODE APPEARING AFTER A CIRCLED NODE. #
 NNODE0_NNODE; PUT0_PUT;
 BITROW_FREE(GRNBITM+GNB(NNODE0));
 K_SCR(CNODE);
 GP1: K=NNODE0 => GO TO GPX;
      GO TO (GP6,GP6,GP2,GP3,GP6) GTYPE(K);
 GP2: VAL_0; L_K; GO TO GP4;
 GP3: VAL_GVAL(K); L_SCR(K);
 GP4: NTN_DPROP('NODE',GVAL(L));
      NTN<64 => (I_1 LS NTN) ELSE I_0;
      I=0 => (GLEAP(NTN,NNODE) => GO TO GP5; GO TO GP6);
      (BITROW AND I) => (GP5: K_SCR(L);
                                VAL => POUT(PUT0,VAL);
                                GO TO GP1);
 GP6: (K_ALT(K)) => GO TO GP1;
 GPX: 0);

SUBR GPOUT2(CNODE,GOAL,PUT) IS (
 # PUTS OUT THE PRODUCTION NUMBERS ALONG A PATH FROM CNODE TO GOAL
  WHICH CONSISTS ONLY OF TYPE 2 AND 3 NODES.  GOAL IS A NONTERMINAL
  NUMBER WHICH REPRESENTS THE CORRESPONDING CIRCLED NODE. #
 GOAL0_GOAL; PUT0_PUT;
 NTN_DPROP('NODE',GVAL(CNODE));
 NTN=GOAL0 => GO TO GPXX;
 GOAL0<64 => MASK_1 LS GOAL0 ELSE MASK_0;
 K_SCR(CNODE);
 GP7:  GO TO (GP12,GP12,GP8,GP9,GP12) GTYPE(K);
 GP8:  VL_0; L_K; GO TO GP10;
 GP9:  VL_GVAL(K); L_SCR(K);
 GP10: GRNBITM[2] => (GMADE(L,GOAL0) => GO TO GP11; GO TO GP12);
       (MASK AND FREE(GRNBITM+GNB(L))) => (GP11: K_SCR(L);
                                         VL => POUT(PUT0,VL);
                                         NTN_DPROP('NODE',GVAL(L));
                                         NTN=GOAL0 => GO TO GPXX;
                                         GO TO GP7);
 GP12: (K_ALT(K)) => GO TO GP7;
 GPXX: 0) %%%
