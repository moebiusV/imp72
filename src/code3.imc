TWOSEG;
CO,NCO,ANCO ARE COMMON;
BDESC,NBD,FDESC,NFD ARE COMMON;
TWLL,TPUSH,LVTARGET,LVTRI ARE COMMON;
#THIS IS FILE CODE3, HOLDING OVERFLOW FROM CODE2, THE TRANSLATION OF DECUS/CODE3.IMC FOR THE 64 BIT PORT (SEE CODE2).  PCODE, THE LISTING OF THE
 CODE, AND PCODE1 ARE AT THE END; BYTEP IS NOT YET.#

EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);


# CSUBCALL(A,B): CCALL F(B), A CALL OF A C FUNCTION WITH ITS ARGUMENTS BY VALUE (LIB/FFI.IMC; NOT IN THE ORIGINAL).  THE ARGUMENTS OF A DECLARED FUNCTION (EXTERNAL INT F(PTR);) ARE COUNTED
  AND CONVERTED TO THE TYPES OF THE DECLARATION (CPAR); ONE THAT IS NOT DECLARED IS CALLED AS IMP CALLS A SUBROUTINE, BY VALUE #
SUBR CSUBCALL(A,B) IS (
 D,H,K ARE LOCAL;
 D:=HLEFT(FREE(A));
 H:=CPHEAD(D);
 H=0 => RETURN SUBCALL(A,B);
 (H AND 1024) NE 0 => (CBNOCALL(D); RETURN SUBCALL(A,B));
 A:=SUBRCALL(NAME(A));
 K:=0;
 WHILE GETLIST(B) DO (K<16 => A:=CPAR(A,B,D,K); K:=K+1);
 CPCOUNT(D,K);
 DEWFUN(A,2,REGOF(A));
 SUBPR0(1);
 A);

# CCALL F(), WITH NO ARGUMENTS: AS THE SYNTAX OF A CALL (DEWFUN(SUBRCALL(NAME(A)),2,REGOF(A),SUBPR0(1))), AND THE COUNT OF A DECLARED FUNCTION CHECKED #
SUBR C0CALL(A) IS (
 D,R,P ARE LOCAL;
 D:=HLEFT(FREE(A));
 (CPHEAD(D) AND 1024) NE 0 => CBNOCALL(D) ELSE (CPHEAD(D) NE 0 => CPCOUNT(D,0));
 A:=SUBRCALL(NAME(A));
 R:=REGOF(A);
 P:=SUBPR0(1);
 DEWFUN(A,2,R));

# CCALL OF A NAME THAT IS DECLARED A CALLBACK: IT IS AN IMP SUBR, CALLED WITHOUT CCALL #
SUBR CBNOCALL(D) IS (
 CMSG IS 40 LONG;
 CCALL snprintf(LOC(CMSG),300,LOC('%s IS A CALLBACK, A SUBR: CALL IT WITHOUT CCALL.'),IRSYMNAME(D));
 ERROR(1,CMSG);
 0);

# CALLBACK(NAME): THE ADDRESS OF THE C FUNCTION THAT CALLS THE SUBR NAME (LIB/FFI.IMC; NOT IN THE ORIGINAL).  IT IS AN ADDR RECORD WHOSE X IS 1: DEMIT NAMES THE SYMBOL NAME@SIGNATURE, WHICH THE WRITERS OF LLVM IR
  DEFINE AS THE FUNCTION WITH THE C TYPES OF THE DECLARATION (CALLBACK TYPE NAME(TYPES);) #
SUBR CBADDR(A) IS (
 D,H,S,R ARE LOCAL;
 CMSG IS 40 LONG;
 D:=HLEFT(FREE(A));
 H:=CPHEAD(D);
 (H AND 1024)=0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT DECLARED A CALLBACK.'),IRSYMNAME(D)); ERROR(1,CMSG));
 S:=NAME(A);
 R:=AREG1(1,15B);
 ADDCODE(S,KOP,OADDR,R,FREE(S),FREE(S+1),1);
 FREES(S,((2 OR (FREE(S) AND 777700B))));
 FREES(S+1,(R LS 32));
 S);

# THE NUMBER K OF ARGUMENTS OF A CALL OF THE DECLARED FUNCTION D: AT LEAST THE PARAMETERS OF A VARIADIC ONE, ELSE EXACTLY #
SUBR CPCOUNT(D,K) IS (
 H,NP ARE LOCAL;
 CMSG IS 40 LONG;
 H:=CPHEAD(D);
 NP:=(H RS 4) AND 31;
 K>16 => (CCALL snprintf(LOC(CMSG),300,LOC('CCALL %s HAS MORE THAN 16 ARGUMENTS.'),IRSYMNAME(D)); ERROR(1,CMSG); RETURN 0);
 (H AND 512) NE 0 => (K<NP => (CCALL snprintf(LOC(CMSG),300,LOC('CCALL %s TAKES AT LEAST %ld ARGUMENTS, NOT %ld.'),IRSYMNAME(D),NP,K); ERROR(1,CMSG)); RETURN 0);
 K NE NP => (CCALL snprintf(LOC(CMSG),300,LOC('CCALL %s TAKES %ld ARGUMENTS, NOT %ld.'),IRSYMNAME(D),NP,K); ERROR(1,CMSG));
 0);

# THE ARGUMENT PP, THE K'TH OF A CALL S OF THE DECLARED FUNCTION D, CONVERTED AS C WOULD: TO THE TYPE OF THE PARAMETER, OR, FOR ONE OF THE ARGUMENTS OF A VARIADIC CALL THAT HAVE NO PARAMETER, TO A DOUBLE
  FOR A REAL AND TO A LONG FOR AN INTEGER.  A REAL IS FLOATED FOR A DOUBLE OR A FLOAT AND FIXED FOR ANY OTHER TYPE; A TEXT CONSTANT FOR A PTR IS PASSED BY ITS ADDRESS (+16 IN THE TYPE OF THE RECORD).
  THE X OF THE OARG RECORD IS THE TYPE #
SUBR CPAR(S,PP,D,K) IS (
 T,SF,X,H,P ARE LOCAL;
 H:=CPHEAD(D);
 SF:=FREE(PP);
 K<((H RS 4) AND 31) => T:=CPTYPE(D,K)
  ELSE (T:=7; (SF AND 300B)=200B => T:=13);
 X:=T;
 T=13 => (FLOAT(PP); GO TO CP1);
 T=14 => (FLOAT(PP); GO TO CP1);
 T=12 => (SF AND 77B)=4 => HLEFT(SF) NE 0 => IRKIND(HLEFT(SF))=1 => (X:=T+16; GO TO CP1);
 (SF AND 300B)=200B => FIX(PP);
 CP1: P:=SUBARG(S,PP);
 ADDCODE(S,KOP,OARG,0,FREE(P),FREE(P+1),X);
 HOOK(S,P,S));

# STRUCT N ( : BEGINS THE STRUCTURE N #
SUBR STBEG(N) IS (
 D ARE LOCAL;
 CMSG IS 40 LONG;
 D:=HLEFT(FREE(N));
 STCUR NE 0 => STEND(0);
 STFIND(D) GE 0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS DECLARED TWICE AS A STRUCTURE.'),IRSYMNAME(D)); ERROR(1,CMSG); RETURN ENSTACK(0));
 CTYPEOF(D) NE 0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS A TYPE OF C, NOT A NAME FOR A STRUCTURE.'),IRSYMNAME(D)); ERROR(1,CMSG); RETURN ENSTACK(0));
 STT=0 => FRELOT(STT,'STT',25,0);
 SFT=0 => FRELOT(SFT,'SFT',25,0);
 STCUR:=NSTT+1;
 FADD(STT,NSTT,D); FADD(STT,NSTT,0); FADD(STT,NSTT,1); FADD(STT,NSTT,NSFT); FADD(STT,NSTT,0);
 STOFS:=0; STAL:=1;
 ENSTACK(0));

# THE INDEX IN STT OF THE STRUCTURE NAMED D, OR -1 #
SUBR STFIND(D) IS (
 I ARE LOCAL;
 NSTT>0 => ((FREE(STT+I)=D => RETURN I) FOR I IN 0,5,NSTT-5);
 0-1);

# T F OR T F [ N ]: A FIELD OF THE STRUCTURE BEING DECLARED, OF THE TYPE T (A TYPE OF C OR A STRUCTURE DECLARED BEFORE), AN ARRAY OF N OF THEM IF N IS NOT 0 #
SUBR STFLD(T,F,N) IS (
 TD,FD,TY,CNT,K,I,SZ,AL ARE LOCAL;
 CMSG IS 40 LONG;
 STCUR=0 => RETURN ENSTACK(0);
 TD:=HLEFT(FREE(T)); FD:=HLEFT(FREE(F));
 TY:=CTYPEOF(TD);
 TY=15 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT THE TYPE OF A FIELD.'),IRSYMNAME(TD)); ERROR(1,CMSG); TY:=5);
 TY=0 => TY:=TYSTRUCT(STFIND(TD));
 TY=0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT A TYPE OF C OR A STRUCTURE DECLARED BEFORE.'),IRSYMNAME(TD)); ERROR(1,CMSG); TY:=5);
 CNT:=0;
 N NE 0 => (CNT:=FREE(N+1);
            (FREE(N) AND 77B) NE 4 => CNT:=0;
            CNT LE 0 => CNT:=0;
            CNT GE 16777216 => CNT:=0;
            CNT=0 => (CCALL snprintf(LOC(CMSG),300,LOC('THE LENGTH OF THE ARRAY FIELD %s IS NOT A POSITIVE CONSTANT.'),IRSYMNAME(FD)); ERROR(1,CMSG); CNT:=1));
 K:=FREE(((STT+STCUR)-1)+3);
 K LT NSFT => ((FREE(SFT+I)=FD => (CCALL snprintf(LOC(CMSG),300,LOC('THE FIELD %s IS DECLARED TWICE.'),IRSYMNAME(FD)); ERROR(1,CMSG))) FOR I IN K,5,NSFT-5);
 SZ:=TYSIZE(TY); AL:=TYALIGN(TY);
 AL LT 1 => AL:=1;
 STOFS:=((STOFS+(AL-1))/AL)*AL;
 FADD(SFT,NSFT,FD); FADD(SFT,NSFT,TY); FADD(SFT,NSFT,CNT); FADD(SFT,NSFT,STOFS); FADD(SFT,NSFT,0);
 K:=((STT+STCUR)-1)+4;
 FREES(K,FREE(K)+1);
 CNT=0 => STOFS:=STOFS+SZ ELSE STOFS:=STOFS+(SZ*CNT);
 AL GT STAL => STAL:=AL;
 ENSTACK(0));

# THE SIZE IN BYTES OF THE TYPE T #
SUBR TYSIZE(T) IS (
 T=1 => RETURN 1;
 T=2 => RETURN 1;
 T=3 => RETURN 2;
 T=4 => RETURN 2;
 T=5 => RETURN 4;
 T=6 => RETURN 4;
 T=14 => RETURN 4;
 T=9 => RETURN 8;
 T=10 => RETURN 8;
 T=13 => RETURN 8;
 T GE 64 => RETURN FREE((STT+(5*(T-64)))+1);
 STP32(0) NE 0 => RETURN 4;
 8);

SUBR STP32(Z) IS ((STINFO(0)-1) AND 1);

# THE ALIGNMENT OF THE TYPE T: ITS SIZE, EXCEPT THAT THE I386 ALIGNS THE 8 BYTE TYPES OF A STRUCTURE TO 4 #
SUBR TYALIGN(T) IS (
 N ARE LOCAL;
 T GE 64 => RETURN FREE((STT+(5*(T-64)))+2);
 N:=TYSIZE(T);
 N=8 => STP32(0) NE 0 => ((STINFO(0)-1) AND 2)=0 => N:=4;
 N);

# LAYOUTS OF C STRUCTURES (STRUCT OF LIB/FFI.IMC; NOT IN THE ORIGINAL).  STT HOLDS THE STRUCTURES OF THE UNIT, FIVE WORDS EACH: THE NAME (A DIRECTORY INDEX), THE SIZE, THE ALIGNMENT, THE INDEX IN SFT OF THE FIRST
  FIELD AND THE NUMBER OF FIELDS.  SFT HOLDS THE FIELDS, FIVE WORDS EACH: THE NAME, THE TYPE, THE COUNT (0 FOR A FIELD THAT IS NOT AN ARRAY), THE OFFSET FROM THE START OF THE STRUCTURE, 0.  A TYPE IS 1 TO 14, THE
  NUMBER OF A TYPE OF C (THE TYPES OF THE TYPED DECLARATIONS), OR 64 PLUS THE NUMBER OF A STRUCTURE (ITS INDEX IN STT DIVIDED BY 5).  THE LAYOUT IS C'S FOR THE MACHINE THE PROGRAM IS COMPILED FOR: THE SIZES OF LONG
  AND OF POINTERS ARE THOSE OF THE WORD (4 WHERE THE POINTERS ARE 32 BITS), AND THE 8 BYTE TYPES OF THE I386 ALIGN TO 4.  STOFS IS THE OFFSET OF THE NEXT FIELD, STAL THE GREATEST ALIGNMENT, STCUR IS THE INDEX IN STT OF THE STRUCTURE BEING DECLARED, PLUS 1 (0: NONE).  STT AND SFT
  ARE EMPTIED WHEN THE UNIT ENDS (ASSEMC, STRESET) #

# 1 + P32 + 2*ARM: P32 IF THE PROGRAM IS COMPILED FOR A MACHINE WHOSE POINTERS AND LONGS ARE 32 BITS (THE GENERATOR'S OWN TARGET, -T I386 OR ARM, OR THE ONE OF THE DRIVER: --TARGET, ELSE THE HOST), ARM IF IT IS AN ARM,
  WHOSE 8 BYTE TYPES ALIGN TO 8 IN A STRUCTURE WHERE THE I386'S ALIGN TO 4.  ASKED ONCE (STPC) #
SUBR STINFO(Z) IS (
 P,A ARE LOCAL;
 STPC NE 0 => RETURN STPC;
 P:=0; A:=0;
 TWLL NE 0 => (P:=1; TPUSH NE 0 => A:=1; STPC:=(1+P)+(2*A); RETURN STPC);
 LVTARGET=0 => (IMPPTRSIZE(0)=4 => P:=1; CCALL strcmp(IMPHOSTARCH(0),LOC('arm'))=0 => A:=1; STPC:=(1+P)+(2*A); RETURN STPC);
 LVPTR32(0)=1 => P:=1;
 CCALL strncmp(LVTRI,LOC('arm'),3)=0 => A:=1;
 CCALL strncmp(LVTRI,LOC('thumb'),5)=0 => A:=1;
 STPC:=(1+P)+(2*A);
 STPC);

# THE TYPE OF THE STRUCTURE AT THE INDEX K OF STT (K<0: NONE) FOR USE AS A TYPE, OR 0 FOR THE ONE BEING DECLARED #
SUBR TYSTRUCT(K) IS (
 K LT 0 => RETURN 0;
 (K+1)=STCUR => RETURN 0;
 64+(K/5));

# THE END OF THE UNIT #
SUBR STRESET(Z) IS (NSTT:=0; NSFT:=0; STCUR:=0; 0);

# ) : ENDS THE STRUCTURE.  ITS SIZE IS THE END OF THE LAST FIELD ROUNDED UP TO THE GREATEST ALIGNMENT #
SUBR STEND(H) IS (
 K ARE LOCAL;
 CMSG IS 40 LONG;
 STCUR=0 => RETURN ENSTACK(0);
 K:=(STT+STCUR)-1;
 FREE(K+4)=0 => (CCALL snprintf(LOC(CMSG),300,LOC('THE STRUCTURE %s HAS NO FIELD.'),IRSYMNAME(FREE(K))); ERROR(1,CMSG));
 FREES(K+1,((STOFS+(STAL-1))/STAL)*STAL);
 FREES(K+2,STAL);
 STCUR:=0;
 ENSTACK(0));

# SIZEOF(N): THE SIZE IN BYTES OF THE TYPE OF C OR THE STRUCTURE N, A CONSTANT #
SUBR STSIZE(S) IS (
 D,TY ARE LOCAL;
 CMSG IS 40 LONG;
 D:=HLEFT(FREE(S));
 TY:=STTYPE(D);
 TY=0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT A TYPE OF C OR A STRUCTURE.'),IRSYMNAME(D)); ERROR(1,CMSG); RETURN STCONST(0));
 STCONST(TYSIZE(TY)));

# THE TYPE OF THE NAME D, A TYPE OF C OR A STRUCTURE (FOR SIZEOF), OR 0 #
SUBR STTYPE(D) IS (
 TY ARE LOCAL;
 TY:=CTYPEOF(D);
 TY=15 => RETURN 0;
 TY NE 0 => RETURN TY;
 TYSTRUCT(STFIND(D)));

# A CONSTANT OF THE SEMANTICS STACK #
SUBR STCONST(V) IS (
 E ARE LOCAL;
 E:=ENSTACK(0);
 FREES(E,104B); FREES(E+1,V);
 E);

# A PATH S.F OR S,F: THE ENTRY HOLDS, IN THE WORD 0, 1 AND THE TYPE (FROM BIT 8, 16 BITS) AND THE COUNT OF THE ARRAY (FROM BIT 24) OF THE FIELD THE PATH ENDS AT, AND IN THE WORD 1 ITS OFFSET.  TYPE 0 IS A
  PATH THAT FAILED (THE ERROR IS SAID ONCE) #
SUBR FPBEG(S,F) IS (
 D,K,E,TY ARE LOCAL;
 CMSG IS 40 LONG;
 D:=HLEFT(FREE(S));
 E:=ENSTACK(0);
 TY:=TYSTRUCT(STFIND(D));
 TY=0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT A STRUCTURE.'),IRSYMNAME(D)); ERROR(1,CMSG); FREES(E,1); FREES(E+1,0); RETURN E);
 FREES(E,1 OR (TY LS 8)); FREES(E+1,0);
 FPFLD(E,F));

SUBR FPFLD(P,F) IS (
 FD,TY,K,I,N,J ARE LOCAL;
 CMSG IS 40 LONG;
 FD:=HLEFT(FREE(F));
 TY:=(FREE(P) RS 8) AND 65535;
 TY=0 => RETURN P;
 I:=0;
 TY LT 64 => I:=1;
 (FREE(P) RS 24) NE 0 => I:=1;
 I NE 0 => (CCALL snprintf(LOC(CMSG),300,LOC('%s IS NOT A FIELD OF A STRUCTURE TYPE (FOR AN ARRAY OF STRUCTURES ADD THE ELEMENT OFFSET TO THE ADDRESS).'),IRSYMNAME(FD)); ERROR(1,CMSG);
            FREES(P,1); RETURN P);
 K:=STT+(5*(TY-64));
 N:=FREE(K+4);
 I:=FREE(K+3);
 N>0 => (((FREE(SFT+J)=FD => (FREES(P,(1 OR (FREE((SFT+J)+1) LS 8)) OR (FREE((SFT+J)+2) LS 24));
                              FREES(P+1,FREE(P+1)+FREE((SFT+J)+3));
                              RETURN P)) FOR J IN I,5,(I+(5*N))-5));
 CCALL snprintf(LOC(CMSG),300,LOC('THE STRUCTURE %s HAS NO FIELD %s.'),IRSYMNAME(FREE(K)),IRSYMNAME(FD)); ERROR(1,CMSG);
 FREES(P,1);
 P);

# OFFSETOF(S,F): THE OFFSET OF THE FIELD IN BYTES, A CONSTANT #
SUBR STOFF(P) IS STCONST(FREE(P+1));

# FIELD(P,S.F) AND FIELD(P,S.F,I): THE FIELD F OF THE STRUCTURE S AT THE ADDRESS P (THE ITH ELEMENT IF THE FIELD IS AN ARRAY).  THE ENTRY IS A VARIABLE NAMED FOR A DESCRIPTOR IN FDESC (EIGHT WORDS: THE NAME, THE
  ADDRESS P AS AN OPERAND OF TWO WORDS, THE INDEX I AS AN OPERAND OF TWO WORDS OR 0, THE OFFSET OF THE FIELD PLUS THE OFFSET OF THE ELEMENT IF I IS A CONSTANT, THE TYPE, THE SIZE OF AN ELEMENT).  THE OPERATIONS
  LDB AND DPB ON IT LOAD AND STORE THE FIELD WITH ITS TYPE (DEMIT) #
SUBR FLDP(P,FP,IDX) IS (
 TD,E,TY,CNT,OFF,ESZ,I0,I1,CI,IX,AR ARE LOCAL;
 TY:=(FREE(FP) RS 8) AND 65535;
 CNT:=FREE(FP) RS 24;
 OFF:=FREE(FP+1);
 IX:=IDX;
 TY=0 => TY:=5;
 TY GE 64 => (ERROR(1,'THE FIELD IS OF A STRUCTURE TYPE: NAME A FIELD OF IT (FIELD(P, S.F.G)).'); TY:=5);
 CI:=0;
 CNT NE 0 => IX=0 => (ERROR(1,'THE FIELD IS AN ARRAY: GIVE THE ELEMENT (FIELD(P, S.F, I)).'); CNT:=0);
 CNT=0 => IX NE 0 => (ERROR(1,'THE FIELD IS NOT AN ARRAY, SO IT TAKES NO ELEMENT.'); IX:=0);
 ESZ:=TYSIZE(TY);
 I0:=0; I1:=0;
 IX NE 0 => ((FREE(IX) AND 77B)=4 => (OFF:=OFF+(FREE(IX+1)*ESZ); CI:=1)
              ELSE (FETCH(IX); I0:=FREE(IX); I1:=FREE(IX+1)));
 TD:=NEWNAME('FLD');
 E:=NAME(ENSTACK(TD));
 (FREE(P) AND 77B) NE 4 => FETCH(P);
 FDESC=0 => FRELOT(FDESC,'FDESC',80,0);
 FADD(FDESC,NFD,TD);
 FADD(FDESC,NFD,FREE(P)); FADD(FDESC,NFD,FREE(P+1));
 FADD(FDESC,NFD,I0); FADD(FDESC,NFD,I1);
 FADD(FDESC,NFD,OFF); FADD(FDESC,NFD,TY); FADD(FDESC,NFD,ESZ);
 IX NE 0 => CI=0 => HOOK(P,P,IX);
 HOOK(E,P,E);
 FREES(E+1,0);
 AR:=110B;
 TY=13 => AR:=210B;
 TY=14 => AR:=210B;
 FREES(E,AR OR (TD LS 32));
 E);

# FIELD(...) := B: THE VALUE B IS CONVERTED TO THE TYPE OF THE FIELD (A REAL FOR DOUBLE AND FLOAT, AN INTEGER OTHERWISE) AND DEPOSITED #
SUBR FLDST(A,B) IS (
 FA ARE LOCAL;
 FA:=FREE(A) AND 300B;
 FA=200B => FLOAT(B);
 FA NE 200B => FLDFIX(B);
 ADDOP(25,A,B));

# FIX(S) OF CODE2.IMC: INSURE THAT S IS AN INTEGER.  THE NAME FIX( IN IMP SOURCE IS THE OPERATOR THAT TRUNCATES A REAL, SO THE ROUTINE CANNOT BE CALLED BY ITS NAME #
SUBR FLDFIX(S) IS (
 X IS REAL;
 SF,J,B ARE LOCAL;
 SF:=FREE(S);
 (SF AND 300B)=0 => (FREES(S,(SF OR 100B)); RETURN S);
 (SF AND 300B) NE 100B => (
     (SF AND 77B)=4 => (B:=FREE(S+1); CCALL memcpy(LOC(X),LOC(B),8); FREES(S+1,FIX(X));
                        FREES(S,((104B OR (SF AND 777000B))));
                        RETURN S);
     FETCH(S);
     J:=REGOF(S);
     ADDCODE(S,KOP,OFIX,J,FREE(S),FREE(S+1),0);
     FREES(S,((102B OR (SF AND (NOT 377B))))));
 S);

OPN: DATA(
          '?      ','LOAD   ','NEG    ',
          'COMPL  ','ADDR   ','STORE  ',
          'ADD    ','SUB    ','MUL    ',
          'DIV    ','MOD    ','AND    ',
          'ANDCA  ','ANDCM  ','ANDCB  ',
          'IOR    ','ORCA   ','ORCM   ',
          'ORCB   ','XOR    ','EQV    ',
          'LSH    ','ASH    ','ROT    ',
          '?      ','?      ','?      ',
          '?      ','?      ','?      ',
          'FADD   ','FSUB   ','FMUL   ',
          'FDIV   ','FLOAT  ','FIX    ',
          'FNEG   ','?      ','?      ',
          '?      ','JUMP   ','JEQ    ',
          'JLT    ','JLE    ','JGE    ',
          'JGT    ','JNE    ','?      ',
          '?      ','?      ','?      ',
          'FJEQ   ','FJLT   ','FJLE   ',
          'FJGE   ','FJGT   ','FJNE   ',
          '?      ','?      ','?      ',
          'CALLB  ','ARG    ','CALLE  ',
          'PITEM  ','?      ','?      ',
          '?      ','?      ','?      ',
          '?      ','ENTRY  ','RET    ');

SUBR CODE3I(NIL) IS (DSEM('SUBSCRIPT',SUBSCRIPT);
                     DSEM('SUBCALL',SUBCALL);
                     DSEM('CSUBCALL',CSUBCALL);
                     DSEM('CCALL0',C0CALL);
                     DSEM('CBADDR',CBADDR);
                     DSEM('BYTEP',BYTEP);
                     DSEM('STBEG',STBEG);
                     DSEM('STFLD',STFLD);
                     DSEM('STEND',STEND);
                     DSEM('STSIZE',STSIZE);
                     DSEM('FPBEG',FPBEG);
                     DSEM('FPFLD',FPFLD);
                     DSEM('STOFF',STOFF);
                     DSEM('FLDP',FLDP);
                     DSEM('FLDST',FLDST);
                     0);SUBR SUBCALL(A,B) IS (
 A:=SUBRCALL(NAME(A));
 WHILE GETLIST(B) DO A:=SUBRPAR(A,B);
 DEWFUN(A,2,REGOF(A));
 SUBPR0(1);
 A);

# SUBSCRIPT(S,T): THE SUBSCRIPTED VARIABLE S[T] (S=0: [T], THE WORD AT ADDRESS T) #
SUBR SUBSCRIPT(S,T) IS (
 TTY,STY,TE,SC,I,SEE,R0,K ARE LOCAL;
 TTY:=FREE(T) AND 77B;
 TTY=2 => REG0(REGOF(T)) NE 0 => (DEWOP(OLOAD,AREG1(1,15B),T); TTY:=2);     # (A FIXED REGISTER, THE VALUE OF A CALL: COPIED INTO A FRESH ONE, WHICH LEAVES THE NAME OF THE ROUTINE BEHIND; THE TAPE'S GO TO L46) #
 TTY=20B => FREE(T+1) LT 0 => (DEWOP(OLOAD,AREG1(1,15B),T); TTY:=2);
 S=0 => (TTY NE 2 => TTY NE 4 => (FREE(T+1) LT 0 => (DEWOP(OLOAD,AREG1(1,15B),T);
                                                       TTY:=20B;
                                                       FREES(T,((20B OR (FREE(T) AND 77B)))))
                                  ELSE FREES(T+1,(FREE(T+1) OR (1 LS 63))));
         TE:=20B OR (FREE(T) AND (NOT 77B));
         TTY=4 => (TE:=10B OR (TE AND 777700B);
                   FREES(T+1,HRIGHT(FREE(T+1))));
         FREES(T,TE); RETURN T);
 TTY NE 2 => TTY NE 4 => (DEWOP(OLOAD,AREG1(1,15B),T); TTY:=2);
 STY:=FREE(S) AND 77B;
 STY=20B => FREE(S+1) LT 0 => (DEWOP(OADDR,AREG1(1,15B),S); STY:=20B;
                               FREES(S,((20B OR (FREE(S) AND 700B)))));
 STY=2 => (ERROR(1,'SUBSCRIPTED REGISTER - IGNORED. '); RETURN S);
 STY=4 => (SEE:=FREE(S) AND (NOT 77B);
           HLEFT(SEE)=0 => (ERROR(2,'CALCULATED CONSTANT IS SUBSCRIPTED. ');
                          I:=STCON(FREE(S+1));
                          SEE:=((I LS 32) OR HRIGHT(SEE)));
           FREES(S,((SEE OR 10B))); FREES(S+1,0));
 TTY=2 => (STY NE 20B => (FREES(S,((20B OR (FREE(S) AND (NOT 77B)))));
                          FREES(S+1,(FREE(S+1) OR (REGOF(T) LS 32))))
           ELSE (R0:=REGOF(S);
                 R0=0 => FREES(S+1,(FREE(S+1) OR (REGOF(T) LS 32)))
                  ELSE (# ADD THE INDEX TO A COPY OF THE REGISTER: IT MAY BE A PARAMETER'S OR A USER'S #
                        K:=AREG1(1,15B);
                        ADDCODE(S,KOP,OLOAD,K,2,(R0 LS 32),0);
                        FREES(S+1,REGFIELD(FREE(S+1),R0,K));
                        HLEFT(FREE(S))=0 => ADDCODE(S,KOP,OADDX,K,FREE(T),FREE(T+1),0)       # A POINTER IN A REGISTER: THE INDEX IS IN WORDS #
                         ELSE ADDCODE(S,KOP,OADD,K,FREE(T),FREE(T+1),0))));
 TTY=4 => (SC:=HRIGHT(HRIGHT(FREE(S+1))+FREE(T+1));
           FREES(S+1,(SC OR (FREE(S+1) AND NOT HMASK))));      # THE REGISTER AND THE INDIRECT BIT KEPT #
 HOOK(S,T,S));

# BYTEP(A,S,P,FLAG): THE BYTE A<S,P> (S BITS WITH THE LOW BIT AT BIT P).  THE ORIGINAL BUILDS A PDP-10 BYTE POINTER AS CONSTANT CODE; HERE THE ENTRY IS A VARIABLE
  NAMED FOR A DESCRIPTOR KEPT IN THE TABLE BDESC (SEVEN WORDS: THE NAME, THE OPERAND A, THE SIZE S AND THE POSITION P, TWO WORDS OF AN ENTRY EACH, A REGISTER OR
  A CONSTANT).  THE OPERATIONS LOAD BYTE, DEPOSIT BYTE AND MOVE (THE POINTER'S VALUE) READ IT IN DEMIT #
SUBR BYTEP(A,S,P,FLAG) IS (
 TD ARE LOCAL;
 TD:=NEWNAME('BYTE');
 NAME(ENSTACK(TD));
 (FREE(P) AND 77B) NE 4 => FETCH(P);
 (FREE(S) AND 77B) NE 4 => FETCH(S);
 BDESC=0 => FRELOT(BDESC,'BDESC',70,0);
 FADD(BDESC,NBD,TD);
 FADD(BDESC,NBD,FREE(A)); FADD(BDESC,NBD,FREE(A+1));
 FADD(BDESC,NBD,FREE(S)); FADD(BDESC,NBD,FREE(S+1));
 FADD(BDESC,NBD,FREE(P)); FADD(BDESC,NBD,FREE(P+1));
 HOOK(A,HOOK(P,P,S),A);
 FREES(A+1,0); FREES(A,(110B OR (TD LS 32)));
 A);

# PCODE(S,NS): LIST THE CODE OF THE ENTRY S, UP TO NS LINES (NS=0: 15).  THE ORIGINAL LISTS THE PDP-10 INSTRUCTIONS OF THE CHAIN; HERE A RECORD OF THE CHAIN IS AN
  OPERATION OF IR (DOCS/PORTING/LLVM-IR-MACHINE.MD): ITS NUMBER, THE OPERATION, THE REGISTER, THE TWO FIELDS (OCTAL) AND THE EXTRA WORD.  THE TABLE OF THE NAMES
  OF THE OPERATIONS IS THAT OF DEMIT, ONE TO A WORD (A TEXT CONSTANT OF SEVEN CHARACTERS AND ITS NUL).  THE ORIGINAL TESTS WHETHER PCODE1 IS LOADED; IT ALWAYS IS HERE. #
SUBR PCODE(S,NS) IS PCODE1(S,NS)%%
