TWOSEG;
USEDFS IS COMMON;
CO,NCO,ANCO ARE COMMON;
ARR,NARR,REGN,REMO,XTAGS,NXT ARE COMMON;
BDESC,NBD ARE COMMON;
ARGS IS 16 LONG;
ATYS IS 16 LONG;
CSIG IS 4 LONG;
CNB IS 56 LONG;
CWNB IS 128 LONG;
PARGS IS 2 LONG;
#THIS IS FILE DEMIT, WHICH TAKES THE PLACE OF THE ASSEMBLER, THE REGISTER ALLOCATOR AND THE OUTPUT MODULE OF THE ORIGINAL (AMOD, RMOD, OMOD): IT READS THE
 CHAINS OF RECORDS THE CODE GENERATOR MADE (DOCS/PORTING/LLVM-IR-MACHINE.MD) AND WRITES THEM AS IR, THROUGH THE ROUTINES OF STAGE0/IR.C (CCALL).
 LLVM DOES THE REGISTER ALLOCATION, THE INSTRUCTION SELECTION AND THE OBJECT FILE.  A REGISTER INDEX IS A TEMPORARY OF THE IR; A PROGRAM IS THE
 FUNCTION IMP_MAIN AND EACH SUBROUTINE ONE FUNCTION; THE ARGUMENTS OF A CALL ARE POINTERS TO THE VALUES (IMP PASSES BY REFERENCE).  THE ROUTINES ARE NOT
 RE-ENTERED (THE VARIABLES OF A ROUTINE ARE ITS OWN).  THE NAMES IRSYMNAME, IRKIND, IRSTRVAL, IRLABNAME, IRPOOLEMIT, IRFNKIND AND IRRESET ARE
 STAGE0/IRSEM.C'S.#

SUBR RV(R) IS (
 T ARE LOCAL;
 FLEN(RTMP) LE R => (FADDEX(RTMP,R+64));
 T:=FREE(RTMP+R);
 T=0 => (T:=IXNEWTEMP(0); FREES(RTMP+R,T));
 IXTEMP(T,TLONG));

SUBR ICN(V) IS IXICON(V,TLONG);

SUBR ASG(L,R) IS IXSTMT(IXASSIGN(L,R));

# THE OFFSET FIELD OF AN ENTRY'S WORD 1: 18 BITS, SIGNED #
SUBR OFFSET(W) IS ((HR(W) XOR 20000000000B) - 20000000000B);

SUBR TAGLABEL(D) IS (
 I,L ARE LOCAL;
 NTAGS>0 => ((FREE(TAGS+I)=D => RETURN FREE((TAGS+I)+1)) FOR I IN 0,2,NTAGS-2);
 L:=IXNEWLABEL(0);
 FADD(TAGS,NTAGS,D); FADD(TAGS,NTAGS,L);
 L);

# NOTE THAT VARIABLE D IS USED BY THE UNIT #
SUBR USEVAR(D) IS (
 I ARE LOCAL;
 NUSED>0 => ((FREE(USEDV+I)=D => RETURN 0) FOR I IN 0,1,NUSED-1);
 FADD(USEDV,NUSED,D);
 0);

# THE LABEL OF THE POOLED CONSTANT NAMED D (A TEXT OR A NUMBER USED AS AN ADDRESS) #
SUBR POOLOF(D) IS (
 I,L ARE LOCAL;
 NPOOL>0 => ((FREE(POOLS+I)=D => RETURN FREE((POOLS+I)+1)) FOR I IN 0,2,NPOOL-2);
 L:=IXNEWLABEL(0);
 FADD(POOLS,NPOOL,D); FADD(POOLS,NPOOL,L);
 L);

# THE ADDRESS OF A DIRECTORY ENTRY D, PLUS O WORDS, AS A POINTER #
SUBR SYMADDR(D,O) IS (
 K ARE LOCAL;
 K:=IRKIND(D);
 K=0 => (USEVAR(D); RETURN IXSYM(IRSYMNAME(D),8*O,TPLONG));
 IXSYM(IRLABNAME(POOLOF(D)),8*O,TPLONG));

# THE ADDRESS OF THE OPERAND (V0,V1) AS A POINTER EXPRESSION.  A VARIABLE IS ITS BYTE ADDRESS; THE OFFSET AND THE INDEX REGISTER COUNT WORDS WHEN THERE IS A
  VARIABLE (V[I] IS AT &V+8*I); A WORD WITH NO VARIABLE IS A POINTER IN THE REGISTER, PLUS THE OFFSET IN WORDS, OR AN ABSOLUTE ADDRESS #
SUBR EADDR(V0,V1) IS (
 D,R,O,E,X1,X2,X3 ARE LOCAL;
 D:=HL(V0);
 (V0 AND 77B)=4 => (D=0 => ERROR(1,'THE ADDRESS OF A COMPUTED CONSTANT.');       # A NAMED CONSTANT: THE ADDRESS OF ITS WORD #
                    RETURN SYMADDR(D,0));
 R:=3777B AND HL(V1); O:=OFFSET(V1);
 D NE 0 => (E:=SYMADDR(D,O);
            R NE 0 => (X1:=RV(R); X2:=IXICON(3,TINT); X3:=IXBIN(IRLS,TLONG,X1,X2);
                       E:=IXBIN(IRPLUS,TPLONG,E,X3)))
  ELSE (R NE 0 => (X1:=IXICON(8*O,TPLONG); X2:=RV(R); E:=IXBIN(IRPLUS,TPLONG,X1,X2))
         ELSE E:=IXICON(O,TPLONG));
 V1 LT 0 => (X1:=IXDEREF(E,TLONG); E:=IXUN(IRPCONV,TPLONG,X1));       # INDIRECT: THE WORD IS A POINTER #
 E);

# THE VALUE OF THE OPERAND (V0,V1) #
SUBR VEXPR(V0,V1) IS (
 K,D,R,O,X1,X2 ARE LOCAL;
 K:=V0 AND 77B; D:=HL(V0);
 K=2 => RETURN RV(3777B AND HL(V1));
 K=4 => (D NE 0 => (IRKIND(D)=1 => RETURN IXICON(IRSTRVAL(D),TLONG));
         RETURN ICN(V1));
 D NE 0 => K=10B => (BDFIND(D)) GE 0 => RETURN BPVALUE(BDFIND(D));
 R:=3777B AND HL(V1); O:=OFFSET(V1);
 D NE 0 => R=0 => V1 GE 0 => IRKIND(D)=0 => (USEVAR(D);
                                                  RETURN IXNAME(IRSYMNAME(D),8*O,TLONG));
 IXDEREF(EADDR(V0,V1),TLONG));

SUBR BOOLOP(OP,A,B) IS (
 OP=OAND => RETURN IXBIN(IRAND,TLONG,A,B);
 OP=OANDCA => RETURN IXBIN(IRAND,TLONG,IXUN(IRCOMPL,TLONG,A),B);
 OP=OANDCM => RETURN IXBIN(IRAND,TLONG,A,IXUN(IRCOMPL,TLONG,B));
 OP=OANDCB => RETURN IXBIN(IRAND,TLONG,IXUN(IRCOMPL,TLONG,A),IXUN(IRCOMPL,TLONG,B));
 OP=OIOR => RETURN IXBIN(IROR,TLONG,A,B);
 OP=OORCA => RETURN IXBIN(IROR,TLONG,IXUN(IRCOMPL,TLONG,A),B);
 OP=OORCM => RETURN IXBIN(IROR,TLONG,A,IXUN(IRCOMPL,TLONG,B));
 OP=OORCB => RETURN IXBIN(IROR,TLONG,IXUN(IRCOMPL,TLONG,A),IXUN(IRCOMPL,TLONG,B));
 OP=OXOR => RETURN IXBIN(IRER,TLONG,A,B);
 IXUN(IRCOMPL,TLONG,IXBIN(IRER,TLONG,A,B)));

# THE COMPARISON OPERATOR OF THE JUMP OPERATION OP (41 TO 46, 51 TO 56) #
SUBR CMPOF(OP) IS (
 K ARE LOCAL;
 K:=OP; K>50 => K:=K-10;
 K=OJEQ => RETURN IREQ;
 K=OJLT => RETURN IRLT;
 K=OJLE => RETURN IRLE;
 K=OJGE => RETURN IRGE;
 K=OJGT => RETURN IRGT;
 IRNE);

# A SHIFT OR ROTATION OF RD BY A COUNT THAT IS NOT A CONSTANT, IN LINE (THE SEED'S SAME CODE, STAGE0/TRANS.C SHIFT): THE RUNTIME LIBRARY IS COMPILED SO (IMP72CHARPTR, SEE CHARPTR), FOR THE ROUTINES
  IMPLSH, IMPASH AND IMPROT ARE MADE OF SHIFTS AND WOULD CALL THEMSELVES.  A COUNT OF 64 PLACES OR MORE SHIFTS EVERYTHING OUT; A NEGATIVE COUNT SHIFTS TO THE RIGHT (ARITHMETIC OR LOGICAL AS THE OPERATION);
  A ROTATION IS BY THE COUNT AND 63 #
SUBR ESHIFTV(OP,RD,V0,V1) IS (
 CT,CT2,U1,U2,LPOS,LRS,LLS,LDONE,KR,X1,X2 ARE LOCAL;
 OP=OROT => (
     X1:=IXBIN(IRAND,TLONG,VEXPR(V0,V1),ICN(63)); CT:=TMPV(X1);
     X1:=IXBIN(IRMINUS,TLONG,ICN(64),TV(CT)); X2:=IXBIN(IRAND,TLONG,X1,ICN(63)); CT2:=TMPV(X2);
     U1:=TMPV(RV(RD)); U2:=TMPV(RV(RD));
     X1:=IXSHIFT(0,TV(U1),TV(CT)); ASG(TV(U1),X1);
     X1:=IXSHIFT(1,TV(U2),TV(CT2)); ASG(TV(U2),X1);
     X1:=IXBIN(IROR,TLONG,TV(U1),TV(U2));
     RETURN ASG(RV(RD),X1));
 OP=OASH => KR:=2 ELSE KR:=1;
 CT:=TMPV(VEXPR(V0,V1));
 LPOS:=IXNEWLABEL(0); LRS:=IXNEWLABEL(0); LLS:=IXNEWLABEL(0); LDONE:=IXNEWLABEL(0);
 IXCBRANCH(IRGE,TV(CT),ICN(0),LPOS);
 IXCBRANCH(IRGT,TV(CT),ICN(0-64),LRS);
 OP=OASH => (X1:=IXSHIFT(2,RV(RD),ICN(63)); ASG(RV(RD),X1)) ELSE ASG(RV(RD),ICN(0));
 IXGOTO(LDONE);
 IXLABEL(LRS);
 X2:=IXUN(IRUMINUS,TLONG,TV(CT)); X1:=IXSHIFT(KR,RV(RD),X2); ASG(RV(RD),X1);
 IXGOTO(LDONE);
 IXLABEL(LPOS);
 IXCBRANCH(IRLT,TV(CT),ICN(64),LLS);
 ASG(RV(RD),ICN(0));
 IXGOTO(LDONE);
 IXLABEL(LLS);
 X1:=IXSHIFT(0,RV(RD),TV(CT)); ASG(RV(RD),X1);
 IXLABEL(LDONE);
 0);

# A SHIFT BY A COUNT: ARITHMETIC (OP=OASH), LOGICAL (OLSH) OR A ROTATION.  A CONSTANT COUNT IS DONE IN LINE; THE RUNTIME ROUTINES IMP_LSH, IMP_ASH AND IMP_ROT DO THE REST:
  THEY TAKE THE ADDRESSES OF THE WORDS IMP_SA, IMP_SB (THE OPERANDS) AND IMP_SR (THE RESULT), FOR A CALL CANNOT CARRY A 64 BIT WORD ON A 32 BIT MACHINE #
SUBR ESHIFT(OP,RD,V0,V1) IS (
 N,X1,X2,X3 ARE LOCAL;
 (V0 AND 77B)=4 => OP NE OROT => (
     N:=V1;
     N=0 => RETURN 0;
     N GE 64 => RETURN ASG(RV(RD),ICN(0));
     N LE -64 => (OP=OASH => N:=-63 ELSE RETURN ASG(RV(RD),ICN(0)));
     N>0 => RETURN ASG(RV(RD),IXSHIFT(0,RV(RD),ICN(N)));
     OP=OASH => RETURN ASG(RV(RD),IXSHIFT(2,RV(RD),ICN(0-N)));
     RETURN ASG(RV(RD),IXSHIFT(1,RV(RD),ICN(0-N))));
 CHARPTR(0) NE 0 => RETURN ESHIFTV(OP,RD,V0,V1);
 SHUSED:=1;
 X1:=IXNAME(LOC('imp_sa'),0,TLONG); X2:=RV(RD); ASG(X1,X2);
 X1:=IXNAME(LOC('imp_sb'),0,TLONG); X2:=VEXPR(V0,V1); ASG(X1,X2);
 ARGS[0]:=IXSYM(LOC('imp_sa'),0,TPLONG);
 ARGS[1]:=IXSYM(LOC('imp_sb'),0,TPLONG);
 ARGS[2]:=IXSYM(LOC('imp_sr'),0,TPLONG);
 OP=OLSH => X3:=IXSYM(LOC('implsh'),0,TPFTN)
  ELSE (OP=OASH => X3:=IXSYM(LOC('impash'),0,TPFTN) ELSE X3:=IXSYM(LOC('improt'),0,TPFTN));
 IXSTMT(IXCALL(X3,LOC(ARGS),3,1));
 X1:=IXNAME(LOC('imp_sr'),0,TLONG);
 ASG(RV(RD),X1));

# THE LETTER OF THE C TYPE T (1 TO 15) IN THE SIGNATURE OF A TYPED CALL: CHAR c, UCHAR C, SHORT s, USHORT S, INT i, UINT I, LONG l, ULONG L, LLONG q, ULLONG Q, SIZE z, PTR p, DOUBLE d, FLOAT f,
  VOID v.  THE WRITERS OF LLVM IR READ THEM #
SUBR CTLET(T) IS (
 T=1 => RETURN 99;
 T=2 => RETURN 67;
 T=3 => RETURN 115;
 T=4 => RETURN 83;
 T=5 => RETURN 105;
 T=6 => RETURN 73;
 T=7 => RETURN 108;
 T=8 => RETURN 76;
 T=9 => RETURN 113;
 T=10 => RETURN 81;
 T=11 => RETURN 122;
 T=12 => RETURN 112;
 T=13 => RETURN 100;
 T=14 => RETURN 102;
 118);

# END A CALL OF A DECLARED C FUNCTION (EXTERNAL INT F(PTR);): THE FUNCTION IS NAMED IN THE IR BY ITS NAME, AN @ AND ITS SIGNATURE, THE LETTER OF THE TYPE OF THE RESULT, THEN THOSE OF THE ARGUMENTS, WITH A DOT BEFORE
  THE ARGUMENTS OF A VARIADIC CALL THAT HAVE NO PARAMETER (f@ip.d: INT F(PTR, ...) CALLED WITH A PTR AND A DOUBLE, LOWER CASE).  EVERY ARGUMENT IS A WORD OF THE IR; A DOUBLE, A FLOAT AND A LLONG ARE THE ADDRESS OF A WORD OF
  64 BITS (IMP_CW0 TO IMP_CW15, STORED JUST BEFORE), WHICH THE WRITER OF LLVM IR LOADS WITH THE TYPE, FOR A CALL CANNOT CARRY 64 BITS ON A 32 BIT MACHINE.  A TEXT CONSTANT FOR A PTR IS ITS ADDRESS.  THE VALUE OF THE
  CALL IS THE WORD THE PROGRAM SEES (THE WRITER CONVERTS IT), SO THE CALL HAS THE TYPE LONG ON EVERY MACHINE (CRET 2) #
SUBR ECALLT(RD,H) IS (
 TREE,K,T,V,Q,NP,X1,X2 ARE LOCAL;
 NP:=(H RS 4) AND 31;
 Q:=BYTEP CSIG<7,36>;
 <+Q>:=CTLET(H AND 15);
 K:=0;
 WHILE K<NARGS DO (
   (H AND 512) NE 0 => K=NP => <+Q>:=46;
   T:=ATYS[K] AND 15;
   T=0 => T:=7;
   (ATYS[K] AND 16) NE 0 => V:=IXUN(IRPCONV,TLONG,ARGS[K]) ELSE V:=IXDEREF(ARGS[K],TLONG);
   ((T=9) OR (T=10) OR (T=13) OR (T=14)) => (
       CCALL snprintf(LOC(CWNB)+(64*K),64,LOC('imp_cw%ld'),K);
       X1:=IXNAME(LOC(CWNB)+(64*K),0,TLONG); ASG(X1,V);
       V:=IXSYM(LOC(CWNB)+(64*K),0,TPLONG);
       K GE CWUSED => CWUSED:=K+1);
   ARGS[K]:=V;
   <+Q>:=CTLET(T);
   K:=K+1);
 (H AND 512) NE 0 => NARGS LE NP => <+Q>:=46;
 <+Q>:=0;
 (H AND 2048) NE 0 => CCALL snprintf(LOC(CNB),400,LOC('impcallt@%s'),LOC(CSIG)) ELSE CCALL snprintf(LOC(CNB),400,LOC('%s@%s'),IRSYMNAME(CALLFN),LOC(CSIG));
 TREE:=IXCALL(IXSYM(LOC(CNB),0,TPFTN),LOC(ARGS),NARGS,2);
 RD NE 0 => ASG(RV(RD),TREE) ELSE IXSTMT(TREE);
 0);

# THE ADDRESS OF THE C FUNCTION THAT CALLS THE CALLBACK D (CALLBACK(NAME); A RECORD ADDR WITH X 1): THE SYMBOL NAME@SIGNATURE, THE SIGNATURE AS IN A TYPED CALL (THE LETTER OF THE RESULT, THEN ONE FOR EACH PARAMETER).  THE WRITERS OF
  LLVM IR DEFINE THE FUNCTION AT THE FIRST USE OF THE SYMBOL (IT IS INTERNAL TO THE MODULE) AND DECLARE THE SUBR NAME IF THE MODULE DOES NOT DEFINE IT #
SUBR ECBADDR(RD,V0) IS (
 D,H,K,NP,Q,X1 ARE LOCAL;
 D:=HL(V0);
 H:=CPHEAD(D);
 NP:=(H RS 4) AND 31;
 Q:=BYTEP CSIG<7,36>;
 <+Q>:=CTLET(H AND 15);
 K:=0;
 WHILE K<NP DO (<+Q>:=CTLET(CPTYPE(D,K)); K:=K+1);
 <+Q>:=0;
 CCALL snprintf(LOC(CNB),400,LOC('%s@%s'),IRSYMNAME(D),LOC(CSIG));
 X1:=IXSYM(LOC(CNB),0,TPLONG);
 ASG(RV(RD),IXUN(IRPCONV,TLONG,X1)));

# END A CALL (CALLE): THE CALL OF THE FUNCTION CALLFN WITH THE ARGUMENTS ARGS; RD IS WHERE THE VALUE GOES #
SUBR ECALL(RD) IS (
 TREE,K,CVAL,CRET,H ARE LOCAL;
 CALLMODE NE 0 => (PLAST NE 0 => (RD NE 0 => ASG(RV(RD),PLAST) ELSE IXSTMT(PLAST));
                   PLAST:=0; CALLMODE:=0; RETURN 0);
 CVAL:=ISCVAL(CALLFN);
 CRET:=CVAL;
 CRET=0 => CRET:=IRRUNTIME(CALLFN);
 NFN<60 => FADD(FNAMES,NFN,CALLFN);
 H:=CPHEAD(CALLFN);
 H NE 0 => (H AND 1024)=0 => RETURN ECALLT(RD,H);
 CVAL NE 0 => (ARGS[K]:=IXDEREF(ARGS[K],TLONG)) FOR K IN 0,1,NARGS-1;
 CVAL NE 0 => IXPASS(LOC('# cfunc %s'),IRSYMNAME(CALLFN),0,0,0);
 TREE:=IXCALL(IXSYM(IRSYMNAME(CALLFN),0,TPFTN),LOC(ARGS),NARGS,CRET);
 RD NE 0 => ASG(RV(RD),TREE) ELSE IXSTMT(TREE);
 0);

# A PRINT LIST ITEM: A CALL OF IMP_PR (OR IMP_RD) FOR THE ITEM, WITH THE FORMAT CODE N AND THE ADDRESS OF THE OPERAND (0 FOR NONE) #
SUBR EPITEM(N,V0,V1) IS (
 TREE,X1 ARE LOCAL;
 PLAST NE 0 => (IXSTMT(PLAST); PLAST:=0);               # THE CELLS ARE THE NEXT CALL'S #
 ASG(IXNAME(LOC('impca'),0,TLONG),ICN(N));
 V0=0 => X1:=ICN(0) ELSE X1:=IXUN(IRPCONV,TLONG,EADDR(V0,V1));
 ASG(IXNAME(LOC('impca'),8,TLONG),X1);
 PARGS[0]:=IXSYM(LOC('impca'),0,TPLONG);
 PARGS[1]:=IXSYM(LOC('impca'),8,TPLONG);
 CALLMODE=2 => TREE:=IXCALL(IXSYM(LOC('imprd'),0,TPFTN),LOC(PARGS),2,0)
  ELSE TREE:=IXCALL(IXSYM(LOC('imppr'),0,TPFTN),LOC(PARGS),2,0);
 PLAST:=TREE;
 0);

# A JUMP THROUGH A TABLE: GO[B] WITH A REGISTER IN THE ADDRESS (TYPE 20B), OR WITH A CONSTANT B, WHICH IS THE OFFSET OF THE TAG #
SUBR ISTABJ(V0,V1) IS (
 (V0 AND 77B)=20B => RETURN 1;
 OFFSET(V1) NE 0 => RETURN 1;
 0);

# THE TAG AND THE OFFSET OF THE TARGET OF A CONDITIONAL JUMP RECORD (THE X OF THE RECORD) #
SUBR JTAG(X) IS (X AND 4294967295);
SUBR JOFF(X) IS (((X RS 32) XOR 20000000000B) - 20000000000B);

# THE INDEX IN RLIST OF THE TAG D, OR -1 #
SUBR TABFIND(D) IS (
 J,I,RR ARE LOCAL;
 J:=-1;
 (RR:=FREE(RLIST+I); RKIND(RR)=KTAG => RX(RR)=D => J:=I) FOR I IN 0,1,NRL-1;
 J);

# THE LABEL OF THE PLACE TAG+O, WHERE THE JUMPS AFTER THE TAG D ARE A TABLE (GO TO GO[B], AND GO TO (L0,L1,...) B, WHICH IS GO TO GO[B]; GO: GO TO L0; GO TO L1; ...): THE TARGET OF THE O'TH JUMP,
  OR, FOR AN O OUT OF THE TABLE, THE PLACE AFTER IT, AS WHEN THE JUMPS ARE INSTRUCTIONS (GO TO COND[1] SKIPS THE INSTRUCTION AFTER THE TAG).  TAGS BETWEEN THE JUMPS TAKE NO SPACE #
SUBR TABLABEL(D,O) IS (
 J,I,K,RR,L ARE LOCAL;
 J:=TABFIND(D);
 J<0 => (ERROR(1,'COMPUTED GO TO WITHOUT ITS TABLE.'); RETURN TAGLABEL(D));
 K:=0; I:=J+1;
 TL1: I<NRL => (RR:=FREE(RLIST+I);
                RKIND(RR)=KTAG => (I:=I+1; GO TO TL1);
                RKIND(RR)=KOP => ROP(RR)=OJUMP => ISTABJ(RV0(RR),RV1(RR))=0 => (
                    K=O => RETURN TAGLABEL(HL(RV0(RR)));
                    K:=K+1; I:=I+1; GO TO TL1));
 L:=IXNEWLABEL(0);
 FADD(TBLE,NTBLE,I); FADD(TBLE,NTBLE,L);
 L);

# GO TO GO[B] (A COMPUTED GO TO): THE INDEX IS THE REGISTER PLUS THE OFFSET.  A COMPARISON FOR EACH JUMP OF THE TABLE #
SUBR ETABJUMP(V0,V1) IS (
 D,R,O,I,J,K,T,E,RR,L ARE LOCAL;
 D:=HL(V0); R:=3777B AND HL(V1); O:=OFFSET(V1);
 J:=TABFIND(D);
 J<0 => RETURN ERROR(1,'COMPUTED GO TO WITHOUT ITS TABLE.');
 R=0 => RETURN IXGOTO(TABLABEL(D,O));
 E:=RV(R); O NE 0 => E:=IXBIN(IRPLUS,TLONG,E,ICN(O));
 T:=IXNEWTEMP(0);
 ASG(IXTEMP(T,TLONG),E);
 K:=0; I:=J+1;
 TJ1: I<NRL => (RR:=FREE(RLIST+I);
                RKIND(RR)=KTAG => (I:=I+1; GO TO TJ1);
                RKIND(RR)=KOP => ROP(RR)=OJUMP => ISTABJ(RV0(RR),RV1(RR))=0 => (
                    IXCBRANCH(IREQ,IXTEMP(T,TLONG),ICN(K),TAGLABEL(HL(RV0(RR))));
                    K:=K+1; I:=I+1; GO TO TJ1));
 L:=IXNEWLABEL(0);                       # AN INDEX OUT OF THE TABLE GOES ON AFTER IT #
 FADD(TBLE,NTBLE,I); FADD(TBLE,NTBLE,L);
 IXGOTO(L));

# THE LABELS OF THE JUMPS THROUGH TABLES THAT ARE DEFINED BEFORE THE RECORD I OF THE UNIT (EBODY) #
SUBR TBLEMIT(I) IS (
 P ARE LOCAL;
 NTBLE>0 => ((FREE(TBLE+P)=I => (IXLABEL(FREE((TBLE+P)+1)); FREES(TBLE+P,-1))) FOR P IN 0,2,NTBLE-2);
 0);

# THE LABEL A CONDITIONAL JUMP RECORD JUMPS TO (ITS X) #
SUBR JLABEL(X) IS (
 JOFF(X) NE 0 => RETURN TABLABEL(JTAG(X),JOFF(X));
 TAGLABEL(JTAG(X)));

# BYTES: THE DESCRIPTORS (BYTEP) AND THE BYTE POINTERS.  A BYTE POINTER KEPT IN A VARIABLE OR REGISTER IS ONE WORD: BITS 63-58 THE SIZE, 57-52 THE POSITION (BITS
  FROM THE RIGHT, AS IN A<S,P>), AND THE LOW 52 BITS THE BYTE ADDRESS OF THE WORD THAT HOLDS THE FIELD.  STEPPING IT MOVES TO THE NEXT LOWER FIELD OF THE SAME SIZE, OR
  TO THE NEXT WORD (ADDRESS+8) WHEN THERE IS NO ROOM. #

SUBR BDFIND(D) IS (
 I ARE LOCAL;
 NBD>0 => ((FREE(BDESC+I)=D => RETURN I) FOR I IN 0,7,NBD-7);
 0-1);

# A VALUE KEPT IN A TEMPORARY (THE IR CANNOT HAVE TWO VARIABLE SHIFTS IN ONE TREE, AND A NODE IS USED ONCE) #
SUBR TMPV(E) IS (
 T ARE LOCAL;
 T:=IXNEWTEMP(0);
 ASG(IXTEMP(T,TLONG),E);
 T);

SUBR TV(T) IS IXTEMP(T,TLONG);
SUBR SHL(X,C) IS IXSHIFT(0,X,C);
SUBR SHR(X,C) IS IXSHIFT(1,X,C);

# THE MASK OF A FIELD OF SIZE (V0,V1) #
SUBR FMASK(V0,V1) IS (
 M ARE LOCAL;
 (V0 AND 77B)=4 => (V1 GE 64 => M:=-1 ELSE M:=((1 LS V1)-1);
                    RETURN ICN(M));
 IXBIN(IRMINUS,TLONG,SHL(ICN(1),VEXPR(V0,V1)),ICN(1)));

# THE VALUE OF THE DESCRIPTOR AT BDESC+J AS A BYTE POINTER (BYTEP A<S,P>).  A POINTER TO CHARACTERS, THE TAPE'S BYTEP A<7,36> (OR A<8,64>), IS THE BYTE ADDRESS OF THE
  BYTE BEFORE THE FIRST OF A (A STEP COMES BEFORE THE ACCESS); ANY OTHER FIELD GIVES THE POINTER OF THE RUNTIME (SIZE, POSITION, ADDRESS OF THE WORD: IMP72RT.C) #
SUBR BPVALUE(J) IS (
 E,X1,X2,X3,X4,A0,A1,SZ,PS,CH ARE LOCAL;
 A0:=FREE((BDESC+J)+1); A1:=FREE((BDESC+J)+2);
 X1:=EADDR(A0,A1);
 E:=IXUN(IRPCONV,TLONG,X1);
 CH:=0;
 (FREE((BDESC+J)+3) AND 77B)=4 => (FREE((BDESC+J)+5) AND 77B)=4 => (
     SZ:=FREE((BDESC+J)+4); PS:=FREE((BDESC+J)+6);
     SZ=7 => PS=36 => CH:=1;
     SZ=8 => PS=64 => CH:=1);
 CH NE 0 => RETURN IXBIN(IRMINUS,TLONG,E,ICN(1));
 A0:=FREE((BDESC+J)+3); A1:=FREE((BDESC+J)+4);
 X2:=VEXPR(A0,A1);
 X3:=SHL(X2,ICN(58));
 E:=IXBIN(IROR,TLONG,E,X3);
 A0:=FREE((BDESC+J)+5); A1:=FREE((BDESC+J)+6);
 X2:=VEXPR(A0,A1);
 X4:=SHL(X2,ICN(52));
 IXBIN(IROR,TLONG,E,X4));

# THE POINTER OPERAND (V0,V1) INTO IMP_BPP, AND BACK; THE RUNTIME ROUTINES IBP, LDB AND DPB WORK ON IMP_BPP AND IMP_BPV #
SUBR BPIN(V0,V1) IS (
 X1,X2 ARE LOCAL;
 X1:=IXNAME(LOC('impbpp'),0,TLONG); X2:=VEXPR(V0,V1); ASG(X1,X2));

SUBR BPOUT(V0,V1) IS (
 X1,X2 ARE LOCAL;
 X1:=IXNAME(LOC('impbpp'),0,TLONG); X2:=VEXPR(V0,V1); ASG(X2,X1));

# IMP72CHARPTR IN THE ENVIRONMENT (THE SEED'S SAME SWITCH, STAGE0/TRANS.C): A BYTE POINTER HELD IN A VARIABLE IS A POINTER TO CHARACTERS, A BYTE ADDRESS, AND THE STEPPING, LOADING AND STORING ARE DONE IN LINE
  INSTEAD OF BY IMPIBP, IMPLDB AND IMPDPB.  THE RUNTIME LIBRARY (LIB/IMP72RT.IMP, IMP72IO.IMP) IS COMPILED SO: THOSE ROUTINES ARE THE ONES THAT WOULD CALL THEMSELVES.  CPFLAG: 0 NOT ASKED YET, 1 NO, 2 YES #
SUBR CHARPTR(Z) IS (
 CPFLAG=0 => (CCALL getenv(LOC('IMP72CHARPTR'))=0 => CPFLAG:=1 ELSE CPFLAG:=2);
 CPFLAG=2);

# THE POINTER OPERAND (V0,V1) STEPPED BY ONE BYTE #
SUBR CPSTEP(V0,V1) IS (
 X1,X2 ARE LOCAL;
 X1:=VEXPR(V0,V1); X2:=ICN(1); X1:=IXBIN(IRPLUS,TLONG,X1,X2);
 X2:=VEXPR(V0,V1); ASG(X2,X1));

# THE BYTE THE POINTER OPERAND (V0,V1) POINTS TO #
SUBR CPBYTE(V0,V1) IS (
 X1,X2 ARE LOCAL;
 X1:=VEXPR(V0,V1); X2:=IXUN(IRPCONV,TPUCHAR,X1);
 IXDEREF(X2,TUCHAR));

SUBR BPIBP(NIL) IS (
 X1 ARE LOCAL;
 X1:=IXSYM(LOC('impibp'),0,TPFTN);
 IXSTMT(IXCALL(X1,LOC(ARGS),0,0)));

SUBR BPLDB(NIL) IS (
 X1 ARE LOCAL;
 X1:=IXSYM(LOC('impldb'),0,TPFTN);
 IXSTMT(IXCALL(X1,LOC(ARGS),0,0)));

SUBR BPDPB(NIL) IS (
 X1 ARE LOCAL;
 X1:=IXSYM(LOC('impdpb'),0,TPFTN);
 IXSTMT(IXCALL(X1,LOC(ARGS),0,0)));

# RD GETS (W SHIFTED RIGHT BY P) AND M, THE TEMPORARIES; ONE STEP AT A TIME, FOR A ROUTINE'S ARGUMENTS ARE NOT RE-ENTERED #
SUBR EFIELD(RD,W,P,M) IS (
 X1,X2,X3,X4 ARE LOCAL;
 X1:=SHR(TV(W),TV(P));
 X2:=TV(M);
 X3:=IXBIN(IRAND,TLONG,X1,X2);
 X4:=RV(RD);
 ASG(X4,X3));

# THE WORD OF A FIELD: ITS OLD VALUE WITH THE BITS OF THE MASK (TEMPORARY M) CLEARED AND THE BITS OF THE VALUE (TEMPORARY V) PUT IN #
SUBR ENEWWORD(OLD,M,V) IS (
 X1,X2,X3,X4 ARE LOCAL;
 X1:=IXUN(IRCOMPL,TLONG,TV(M));
 X2:=IXBIN(IRAND,TLONG,OLD,X1);
 X3:=IXBIN(IRAND,TLONG,TV(V),TV(M));
 IXBIN(IROR,TLONG,X2,X3));

# ASSIGN THE NODE R TO THE PLACE L #
SUBR EWRITE(L,R) IS ASG(L,R);

# LOAD BYTE: RD GETS THE FIELD, RIGHT JUSTIFIED.  THE OPERAND IS A DESCRIPTOR (A<S,P>) OR A VARIABLE HOLDING A BYTE POINTER; STEP: ILDB #
SUBR ELDB(RD,V0,V1,STEP) IS (
 J,W,P,M,PT,X1,A0,A1 ARE LOCAL;
 J:=-1;
 (V0 AND 77B)=10B => STEP=0 => (J:=FDFIND(HL(V0)); J GE 0 => RETURN ELDF(RD,J); J:=BDFIND(HL(V0)));
 J GE 0 => (A0:=FREE((BDESC+J)+1); A1:=FREE((BDESC+J)+2);
            X1:=VEXPR(A0,A1); W:=TMPV(X1);
            A0:=FREE((BDESC+J)+5); A1:=FREE((BDESC+J)+6);
            X1:=VEXPR(A0,A1); P:=TMPV(X1);
            A0:=FREE((BDESC+J)+3); A1:=FREE((BDESC+J)+4);
            X1:=FMASK(A0,A1); M:=TMPV(X1);
            RETURN EFIELD(RD,W,P,M));
 CHARPTR(0) NE 0 => (STEP NE 0 => CPSTEP(V0,V1);
                X1:=CPBYTE(V0,V1); X2:=IXUN(IRSCONV,TLONG,X1);
                X1:=RV(RD); RETURN ASG(X1,X2));
 BPIN(V0,V1);
 STEP NE 0 => (BPIBP(0); BPOUT(V0,V1));
 BPLDB(0);
 X1:=IXNAME(LOC('impbpv'),0,TLONG); X2:=RV(RD);
 ASG(X2,X1));

# DEPOSIT BYTE: THE LOW BITS OF RD INTO THE FIELD; STEP: IDPB #
SUBR EDPB(RD,V0,V1,STEP) IS (
 J,P,K,M,V,PT,X1,X2,X3,A0,A1,B0,B1 ARE LOCAL;
 J:=-1;
 (V0 AND 77B)=10B => STEP=0 => (J:=FDFIND(HL(V0)); J GE 0 => RETURN EDPF(RD,J); J:=BDFIND(HL(V0)));
 J GE 0 => (A0:=FREE((BDESC+J)+5); A1:=FREE((BDESC+J)+6);
            X1:=VEXPR(A0,A1); P:=TMPV(X1);
            A0:=FREE((BDESC+J)+3); A1:=FREE((BDESC+J)+4);
            X1:=FMASK(A0,A1); K:=TMPV(X1);
            X1:=SHL(TV(K),TV(P)); M:=TMPV(X1);
            X1:=RV(RD); X2:=SHL(X1,TV(P)); V:=TMPV(X2);
            B0:=FREE((BDESC+J)+1); B1:=FREE((BDESC+J)+2);
            X1:=VEXPR(B0,B1);
            X2:=ENEWWORD(X1,M,V);
            X3:=VEXPR(B0,B1);
            RETURN EWRITE(X3,X2));
 CHARPTR(0) NE 0 => (STEP NE 0 => CPSTEP(V0,V1);
                X1:=CPBYTE(V0,V1); X2:=RV(RD); X2:=IXUN(IRSCONV,TUCHAR,X2);
                RETURN ASG(X1,X2));
 X1:=RV(RD); X2:=IXNAME(LOC('impbpv'),0,TLONG); ASG(X2,X1);
 BPIN(V0,V1);
 STEP NE 0 => (BPIBP(0); BPOUT(V0,V1));
 BPDPB(0));

# HRLM, HRRM: THE RIGHT HALF OF RD INTO THE LEFT (POS=32) OR THE RIGHT (POS=0) HALF OF THE OPERAND; THE HALVES ARE 32 BITS #
SUBR EHALF(RD,V0,V1,POS) IS (
 M,V,X1,X2,X3,X4 ARE LOCAL;
 X1:=ICN(HMASK);
 POS NE 0 => (X2:=ICN(POS); X3:=IXBIN(IRLS,TLONG,X1,X2)) ELSE X3:=X1;
 M:=TMPV(X3);
 X1:=RV(RD); X2:=ICN(POS); X3:=SHL(X1,X2);
 V:=TMPV(X3);
 X1:=VEXPR(V0,V1);
 X2:=ENEWWORD(X1,M,V);
 X1:=VEXPR(V0,V1);
 EWRITE(X1,X2));

# CALLI: RD GETS THE VALUE OF IMP_CALLI(THE CODE, THE AC); THE LIBRARY ROUTINE TAKES THE TWO WORDS AS C LONGS #
SUBR ECALLI(RD,V0,V1) IS (
 X1,X2 ARE LOCAL;
 ASG(IXNAME(LOC('impca'),0,TLONG),VEXPR(V0,V1));
 ASG(IXNAME(LOC('impca'),8,TLONG),RV(RD));
 ARGS[0]:=IXSYM(LOC('impca'),0,TPLONG);
 ARGS[1]:=IXSYM(LOC('impca'),8,TPLONG);
 X1:=IXSYM(LOC('impcalli'),0,TPFTN);
 X2:=IXCALL(X1,LOC(ARGS),2,0);
 ASG(RV(RD),X2));

# EXECUTE: THE WORD IS AN INSTRUCTION OF THIS MACHINE, RUN BY THE LIBRARY'S IMP_XCT.  THE REGISTERS OF THE CODE ARE TEMPS, THE ACCUMULATORS OF THE INSTRUCTION ARE THE WORDS OF IMP_AC: THE
  REGISTERS 1 TO 15 THAT THE ROUTINE USES ARE STORED THERE BEFORE AND LOADED AFTER #
SUBR EXECUTEW(V0,V1) IS (
 I,X1,X2,X3 ARE LOCAL;
 X1:=VEXPR(V0,V1); X2:=IXNAME(LOC('impxw'),0,TLONG); ASG(X2,X1);     # THE WORD GOES IN IMP_XW: A RUNTIME ROUTINE TAKES A C LONG, WHICH IS NOT A WORD EVERYWHERE #
 (FLEN(RTMP)>I => FREE(RTMP+I) NE 0 => (X1:=IXSYM(LOC('impac'),8*(I-33),TPLONG); X2:=IXDEREF(X1,TLONG);
                                       ASG(X2,RV(I)))) FOR I IN 33,1,48;
 X1:=IXSYM(LOC('impxct'),0,TPFTN);
 IXSTMT(IXCALL(X1,LOC(ARGS),0,0));
 (FLEN(RTMP)>I => FREE(RTMP+I) NE 0 => (X1:=IXSYM(LOC('impac'),8*(I-33),TPLONG); X2:=IXDEREF(X1,TLONG);
                                       ASG(RV(I),X2))) FOR I IN 33,1,48;
 0);

# ONE RECORD OF THE CODE #
SUBR EREC(R) IS (
 OP,RD,V0,V1,TREE,K,X1,X2,X3 ARE LOCAL;
 OP:=ROP(R); RD:=RRD(R); V0:=RV0(R); V1:=RV1(R);
 RKIND(R)=KTAG => RETURN IXLABEL(TAGLABEL(RX(R)));
 RKIND(R) NE KOP => RETURN 0;
 OP=OENTRY => RETURN 0;
 OP=OPARAM => RETURN 0;
 OP=OLOAD => RETURN ASG(RV(RD),VEXPR(V0,V1));
 OP=ONEG => RETURN ASG(RV(RD),IXUN(IRUMINUS,TLONG,VEXPR(V0,V1)));
 OP=OCOMPL => RETURN ASG(RV(RD),IXUN(IRCOMPL,TLONG,VEXPR(V0,V1)));
 OP=OADDR => (RX(R)=1 => RETURN ECBADDR(RD,V0); RETURN ASG(RV(RD),IXUN(IRPCONV,TLONG,EADDR(V0,V1))));
 OP=OSTORE => RETURN ASG(VEXPR(V0,V1),RV(RD));
 OP=OADD => RETURN ASG(RV(RD),IXBIN(IRPLUS,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OADDX => RETURN ASG(RV(RD),IXBIN(IRPLUS,TLONG,RV(RD),IXBIN(IRMUL,TLONG,VEXPR(V0,V1),ICN(8))));
 OP=OSUB => RETURN ASG(RV(RD),IXBIN(IRMINUS,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OMUL => RETURN ASG(RV(RD),IXBIN(IRMUL,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=ODIV => RETURN ASG(RV(RD),IXBIN(IRDIV,TLONG,RV(RD),VEXPR(V0,V1)));
 OP=OMOD => RETURN ASG(RV(RD),IXBIN(IRMOD,TLONG,RV(RD),VEXPR(V0,V1)));
 OP GE OAND => OP LE OEQV => RETURN ASG(RV(RD),BOOLOP(OP,RV(RD),VEXPR(V0,V1)));
 OP GE OLSH => OP LE OROT => RETURN ESHIFT(OP,RD,V0,V1);
 OP GE OFADD => OP LE OFDIV => (
     OP=OFADD => K:=IRPLUS;
     OP=OFSUB => K:=IRMINUS;
     OP=OFMUL => K:=IRMUL;
     OP=OFDIV => K:=IRDIV;
     X1:=RV(RD); X2:=IXTODOUBLE(X1,0);
     X1:=VEXPR(V0,V1); X3:=IXTODOUBLE(X1,1);
     TREE:=IXBIN(K,TDOUBLE,X2,X3);
     X1:=IXFROMDOUBLE(TREE);
     RETURN ASG(RV(RD),X1));
 OP=ONEGF => RETURN ASG(RV(RD),IXBIN(IRER,TLONG,VEXPR(V0,V1),ICN(1 LS 63)));
 OP=OLDB => RETURN ELDB(RD,V0,V1,0);
 OP=OILDB => RETURN ELDB(RD,V0,V1,1);
 OP=ODPB => RETURN EDPB(RD,V0,V1,0);
 OP=OIDPB => RETURN EDPB(RD,V0,V1,1);
 OP=OFLOAT => (X1:=VEXPR(V0,V1); X2:=IXUN(IRSCONV,TDOUBLE,X1); X1:=IXFROMDOUBLE(X2); RETURN ASG(RV(RD),X1));
 OP=OFIX => (X1:=VEXPR(V0,V1); X2:=IXTODOUBLE(X1,0); X1:=IXUN(IRSCONV,TLONG,X2); RETURN ASG(RV(RD),X1));
 OP=OJUMP => (ISTABJ(V0,V1) NE 0 => RETURN ETABJUMP(V0,V1); RETURN IXGOTO(TAGLABEL(HL(V0))));
 OP GE OJEQ => OP LE OJNE => RETURN IXCBRANCH(CMPOF(OP),RV(RD),VEXPR(V0,V1),JLABEL(RX(R)));
 OP GE 51 => OP LE 56 => (X1:=RV(RD); X2:=IXTODOUBLE(X1,0);              # THE JUMPS ON REALS #
                           X1:=VEXPR(V0,V1); X3:=IXTODOUBLE(X1,1);
                           RETURN IXCBRANCH(CMPOF(OP),X2,X3,JLABEL(RX(R))));
 OP=OCALLB => (CALLFN:=HL(V0); NARGS:=0; PLAST:=0; CALLMODE:=IRFNKIND(CALLFN); RETURN 0);
 OP=OARG => (NARGS<16 => (ARGS[NARGS]:=EADDR(V0,V1); ATYS[NARGS]:=RX(R); NARGS:=NARGS+1); RETURN 0);
 OP=OCALLE => RETURN ECALL(RD);
 OP=OCALLI => RETURN ECALLI(RD,V0,V1);
 OP=OHRLM => RETURN EHALF(RD,V0,V1,32);
 OP=OHRRM => RETURN EHALF(RD,V0,V1,0);
 OP=OXCT => RETURN EXECUTEW(V0,V1);
 OP=OPITEM => RETURN EPITEM(RX(R),V0,V1);
 OP=ORET => (ASG(IXTEMP(RETTMP,TLONG),RV(RD)); RETURN IXGOTO(RETLAB));
 ERROR(1,'UNKNOWN OPERATION IN THE CODE.');
 0);

# A GO TO TO A TAG OF ANOTHER ROUTINE (ERROR OF THE ORIGINAL'S IMPM GOES TO FIN OF THE MAIN PROGRAM) HAS NO JUMP TO BE: THE ROUTINE THAT HAS THE TAG TAKES A SETJMP AT ITS ENTRY (EXPORTTAGS) AND THE
  JUMP IS A LONGJMP TO IT.  XTAGS ARE THE TAGS JUMPED TO FROM OUTSIDE.  A TAG OF THE UNIT THAT IS NOT IN THE ROUTINE OF THE JUMP IS FOUND BY XSCAN BEFORE ANY CODE IS MADE #
SUBR TAGDEF(B,I0,I1,D) IS (
 J ARE LOCAL;
 (RKIND(FREE(B+J))=KTAG => RX(FREE(B+J))=D => RETURN 1) FOR J IN I0,1,I1-1;
 0);

SUBR ISXTAG(D) IS (
 I ARE LOCAL;
 NXT>0 => ((FREE(XTAGS+I)=D => RETURN 1) FOR I IN 0,1,NXT-1);
 0);

# THE TAG A JUMP RECORD JUMPS TO, OR 0 #
SUBR JUMPTAG(R) IS (
 OP ARE LOCAL;
 RKIND(R) NE KOP => RETURN 0;
 OP:=ROP(R);
 OP=OJUMP => (ISTABJ(RV0(R),RV1(R)) NE 0 => RETURN 0; RETURN HL(RV0(R)));
 OP GE OJEQ => OP LE OJNE => (JOFF(RX(R)) NE 0 => RETURN 0; RETURN JTAG(RX(R)));
 OP GE 51 => OP LE 56 => (JOFF(RX(R)) NE 0 => RETURN 0; RETURN JTAG(RX(R)));
 0);

# ONLY A TAG OF THE MAIN PROGRAM (THE RECORDS BEFORE THE FIRST ENTRY, UP TO MAINEND), WHICH IS ACTIVE WHENEVER A ROUTINE RUNS, CAN BE JUMPED TO FROM OTHER ROUTINES; A TAG OF ANOTHER SUBROUTINE (WHICH MAY
  HAVE RETURNED) OR OF NO ROUTINE IS THE ERROR OF ECHKTAGS #
SUBR XSCAN(I0,I1) IS (
 I,T ARE LOCAL;
 (T:=JUMPTAG(FREE(RLIST+I));
  T NE 0 => (TAGDEF(RLIST,I0,I1,T)=0 => TAGDEF(RLIST2,0,NRL2,T)=0 => ISXTAG(T)=0 => TAGDEF(RLIST,0,MAINEND,T) NE 0 => FADD(XTAGS,NXT,T))) FOR I IN I0,1,I1-1;
 0);

# AT THE ENTRY OF A ROUTINE: A SETJMP FOR EACH OF ITS TAGS THAT OTHER ROUTINES JUMP TO; A NONZERO RETURN IS THE JUMP #
SUBR EXPORTTAGS(I0,I1) IS (
 I,T,X1,X2 ARE LOCAL;
 NXT>0 => ((T:=FREE(XTAGS+I);
            TAGDEF(RLIST,I0,I1,T)+TAGDEF(RLIST2,0,NRL2,T) NE 0 => (
               ARGS[0]:=IXSYM(IRJBNAME(T),0,TPLONG);
               X1:=IXSYM(LOC('_setjmp'),0,TPFTN);
               X2:=IXCALL(X1,LOC(ARGS),1,1);
               IXCBRANCH(IRNE,X2,ICN(0),TAGLABEL(T)))) FOR I IN 0,1,NXT-1);
 0);

# A JUMP TO A TAG THAT IS NOT IN THE FUNCTION (A GO TO ACROSS SUBROUTINES) IS AN ERROR; THE TAG IS DEFINED AT THE END, FOR THE FIRST BACK END STOPPED AT A LABEL NOT DEFINED #
SUBR ECHKTAGS(I0,I1) IS (
 I,J,Q,X1 ARE LOCAL;
 NTAGS>0 => ((Q:=0;
              (RKIND(FREE(RLIST+J))=KTAG => RX(FREE(RLIST+J))=FREE(TAGS+I) => Q:=1) FOR J IN I0,1,I1-1;
              NRL2>0 => ((RKIND(FREE(RLIST2+J))=KTAG => RX(FREE(RLIST2+J))=FREE(TAGS+I) => Q:=1) FOR J IN 0,1,NRL2-1);
              Q=0 => (ISXTAG(FREE(TAGS+I))=0 => IRTAGERR(FREE(TAGS+I));
                      IXLABEL(FREE((TAGS+I)+1));
                      ISXTAG(FREE(TAGS+I)) NE 0 => (ARGS[0]:=IXSYM(IRJBNAME(FREE(TAGS+I)),0,TPLONG); ARGS[1]:=ICN(1);
                                                    X1:=IXSYM(LOC('_longjmp'),0,TPFTN);
                                                    IXSTMT(IXCALL(X1,LOC(ARGS),2,0))))) FOR I IN 0,2,NTAGS-2);
 0);

# A WORD OF A DATA STATEMENT IS TWO WORDS OF DDW: THE SYMBOL WHOSE ADDRESS IT IS (0 FOR A NUMBER) AND THE NUMBER, OR THE OFFSET IN BYTES FROM THE SYMBOL #
SUBR EDATW(R) IS (
 D ARE LOCAL;
 RV0(R)=0 => (FADD(DDW,NDDW,0); FADD(DDW,NDDW,RV1(R)); RETURN 0);
 D:=HL(RV0(R));
 D=0 => (ERROR(1,'NON-CONSTANT EXPRESSION IN DATA STATEMENT.'); RETURN 0);
 (3777B AND HL(RV1(R))) NE 0 => (ERROR(1,'NON-CONSTANT EXPRESSION IN DATA STATEMENT.'); RETURN 0);
 IRKIND(D)=0 => USEVAR(D) ELSE POOLOF(D);
 FADD(DDW,NDDW,D); FADD(DDW,NDDW,8*OFFSET(RV1(R)));
 0);

# THE ASSEMBLER NAME OF THE SYMBOL D OF A DATA WORD #
SUBR DATSYM(D) IS (
 IRKIND(D)=0 => RETURN IRSYMNAME(D);
 IRLABNAME(POOLOF(D)));

# THE RECORDS B[I0] TO B[I1-1] OF A FUNCTION.  F=1: THE REMOTE CODE (REMOT), OF WHICH ONLY THE SEGMENTS MARKED WITH NN, THE NAME OF THE ROUTINE (0: THE MAIN PROGRAM) ARE ITS #
SUBR EBODY(B,I0,I1,F,NN) IS (
 I,R,CNT,ACT ARE LOCAL;
 I:=I0; ACT:=1; F NE 0 => ACT:=0;
 EB1: B=RLIST => TBLEMIT(I);
 I<I1 => (R:=FREE(B+I);
               F NE 0 => RKIND(R)=KOP => ROP(R)=OREMOTE => (RX(R)=NN => ACT:=1 ELSE ACT:=0; I:=I+1; GO TO EB1);
               ACT=0 => (I:=I+1; GO TO EB1);
               # DATA: A TAG FOLLOWED BY WORDS #
               RKIND(R)=KTAG => (I+1<I1 => RKIND(FREE((B+I)+1))=KWORD => (
                   FADD(DDL,NDDL,RX(R)); FADD(DDL,NDDL,NDDW);
                   CNT:=0; I:=I+1;
                   EB2: I<I1 => RKIND(FREE(B+I))=KWORD => (EDATW(FREE(B+I)); CNT:=CNT+1; I:=I+1; GO TO EB2);
                   FADD(DDL,NDDL,CNT);
                   GO TO EB1));
               EREC(R);
               I:=I+1; GO TO EB1);
 0);

# AN EXECUTE IN THE RECORDS B[I0] TO B[I1-1]? #
SUBR HASXCT(B,I0,I1) IS (
 I,R ARE LOCAL;
 (R:=FREE(B+I); RKIND(R)=KOP => ROP(R)=OXCT => RETURN 1) FOR I IN I0,1,I1-1;
 0);

# THE REGISTERS (0R TO 15R, THE TEMPORARIES 33 TO 48) THAT THE RECORDS B[I0] TO B[I1-1] MENTION GET THEIR TEMPORARIES: AN EXECUTE STORES AND LOADS THOSE THAT EXIST WHEN IT IS MADE, AND A REGISTER THAT THE ROUTINE
  MENTIONS ONLY AFTER THE EXECUTE (IN THE ORDER OF THE CODE) MUST BE ONE OF THEM #
SUBR EXREGS(B,I0,I1) IS (
 I,R,X ARE LOCAL;
 (R:=FREE(B+I);
  RKIND(R)=KOP => (X:=RRD(R); X GE 33 => X LE 48 => RV(X);
                   (RV0(R) AND 77B) NE 4 => (X:=3777B AND HL(RV1(R)); X GE 33 => X LE 48 => RV(X)))) FOR I IN I0,1,I1-1;
 0);

# A FUNCTION: THE RECORDS RLIST[I0] TO RLIST[I1-1]; THE MAIN PROGRAM (ISMAIN) OR A SUBROUTINE, WHICH BEGINS WITH THE ENTRY RECORD AND ITS PARAMETERS #
SUBR EFUNC(I0,I1,ISMAIN) IS (
 I,R,K,J,NM,NN ARE LOCAL;
 ISMAIN NE 0 => NM:=LOC('impmain')
  ELSE (NM:=IRSYMNAME(HL(RV0(FREE(RLIST+I0)))); FADD(FNAMES,NFN,HL(RV0(FREE(RLIST+I0)))));
 IXFUNCBEGIN(NM,1);
 (FREES(RTMP+J,0)) FOR J IN 0,1,FLEN(RTMP)-1;
 NTAGS:=0;
 RETLAB:=IXNEWLABEL(0);
 RETTMP:=IXNEWTEMP(0);
 K:=0;
 ISMAIN=0 => ((R:=FREE(RLIST+I)) => (RKIND(R)=KOP => ROP(R)=OPARAM => (
                  ASG(RV(RRD(R)),IXUN(IRPCONV,TLONG,IXPARAM(K))); K:=K+1))) FOR I IN I0,1,I1-1;
 J:=HASXCT(RLIST,I0,I1); J=0 => NRL2>0 => J:=HASXCT(RLIST2,0,NRL2);
 J NE 0 => (EXREGS(RLIST,I0,I1); NRL2>0 => EXREGS(RLIST2,0,NRL2));
 IXLABEL(IXNEWLABEL(0));            # THE FIRST BACK END'S OPTIMIZER WANTED A LABEL BETWEEN THE ARGUMENT MOVES AND THE CODE (DELJUMPS: PROLOG, LABEL, MOVES, LABEL, CODE) #
 EXPORTTAGS(I0,I1);
 EBODY(RLIST,I0,I1,0,0);
 ISMAIN NE 0 => NN:=0 ELSE NN:=HL(RV0(FREE(RLIST+I0)));
 EBODY(RLIST2,0,NRL2,1,NN);                    # THE REMOTE CODE OF THIS ROUTINE (REMOT) #
 ECHKTAGS(I0,I1);
 IXFUNCEND(RETLAB,RETTMP);
 0);

# THE DATA OF THE UNIT: THE VARIABLES USED (COMMON SYMBOLS, SIZED BY THEIR DECLARATIONS), DATA STATEMENTS AND THE POOLED CONSTANTS #
SUBR EDATA(NIL) IS (
 I,D,J,SZ,W,Q ARE LOCAL;
 USEDFS NE 0 => (IXPASS(LOC(' .comm imp_fs0,8,8'),0,0,0,0); IXPASS(LOC(' .comm imp_fs1,8,8'),0,0,0,0); IXPASS(LOC(' .comm imp_fsr,8,8'),0,0,0,0));
 CWUSED>0 => ((CCALL snprintf(LOC(CNB),64,LOC('imp_cw%ld'),I); IXPASS(LOC(' .comm %s,8,8'),LOC(CNB),0,0,0)) FOR I IN 0,1,CWUSED-1);
 SHUSED NE 0 => (IXPASS(LOC(' .comm imp_sa,8,8'),0,0,0,0); IXPASS(LOC(' .comm imp_sb,8,8'),0,0,0,0); IXPASS(LOC(' .comm imp_sr,8,8'),0,0,0,0); SHUSED:=0);
 NUSED>0 => (
  D:=FREE(USEDV+I);
  Q:=0;
  NDDL>0 => ((FREE(DDL+J)=D => Q:=1) FOR J IN 0,3,NDDL-3);
  NFN>0 => ((FREE(FNAMES+J)=D => Q:=1) FOR J IN 0,1,NFN-1);
  DPROP('COM',D)=3 => Q:=1;                       # EXTERNAL: DEFINED ELSEWHERE #
  Q=0 => (SZ:=8;
          NARR>0 => ((W:=FREE(ARR+J); HR(W)=D => SZ:=8*HL(W)) FOR J IN 0,1,NARR-1);
          DPROP('COM',D)=0 => IXPASS(LOC(' .local %s'),IRSYMNAME(D),0,0,0);
          IXPASS(LOC(' .comm %s,%ld,8'),IRSYMNAME(D),SZ,0,0);
          IRVARREC(IRSYMNAME(D),SZ))) FOR I IN 0,1,NUSED-1;
 NXT>0 => (IXPASS(LOC(' .comm %s,512,16'),IRJBNAME(FREE(XTAGS+I)),0,0,0) FOR I IN 0,1,NXT-1);
 NDDL>0 => (
  IXPASS(LOC(' .data'),0,0,0,0);
  IXPASS(LOC(' .balign 8'),0,0,0,0);
  IXPASS(LOC('%s:'),IRSYMNAME(FREE(DDL+I)),0,0,0);
  (W:=FREE((DDL+I)+1)+(2*J); Q:=FREE(DDW+W);
   Q NE 0 => IXPASS(LOC(' .quad %s+%ld'),DATSYM(Q),FREE(DDW+(W+1)),0,0) ELSE IXQUAD(FREE(DDW+(W+1)))) FOR J IN 0,1,FREE((DDL+I)+2)-1) FOR I IN 0,3,NDDL-3;
 NPOOL>0 => (
  IXPASS(LOC(' .data'),0,0,0,0);
  IXPASS(LOC(' .balign 8'),0,0,0,0);
  IXPASS(LOC('.L%d:'),FREE((POOLS+I)+1),0,0,0);
  IRPOOLEMIT(FREE(POOLS+I))) FOR I IN 0,2,NPOOL-2;
 0);

# DEMIT(A): THE UNIT WHOSE CODE IS THE CHAIN OF STACK ENTRY A #
SUBR DEMIT(A) IS (
 R,I,START ARE LOCAL;
 DINIT=0 => (DINIT:=1;
             FRELOT(RTMP,'RTMP',300,0); FINCSET(RTMP,300);
             FRELOT(TAGS,'TAGS',20,0); FRELOT(USEDV,'USEDV',20,0); FRELOT(POOLS,'POOLS',20,0);
             FRELOT(FNAMES,'FNAMS',20,0); FRELOT(RLIST,'RLIST',100,0); FRELOT(RLIST2,'RLIS2',20,0); FRELOT(XTAGS,'XTAGS',20,0); FRELOT(DDL,'DDL',20,0); FRELOT(DDW,'DDW',20,0); FRELOT(TBLE,'TBLE',20,0));
 NRL:=0; NXT:=0; NTAGS:=0; NUSED:=0; NPOOL:=0; NFN:=0; NDDL:=0; NDDW:=0; NTBLE:=0;
 USEDFS:=0; CWUSED:=0;
 R:=HL(FREE(A+2));
 EM1: R NE 0 => (FADD(RLIST,NRL,R); R:=RNEXT(R); GO TO EM1);
 NRL2:=0;
 REMO NE 0 => (R:=HL(FREE(REMO+2));                    # THE REMOTE CODE: THE ORIGINAL PUTS IT IN THE HIGH SEGMENT #
               EM3: R NE 0 => (FADD(RLIST2,NRL2,R); R:=RNEXT(R); GO TO EM3);
               FREES(REMO+2,0));
 MAINEND:=NRL;
 (R:=FREE(RLIST+I); RKIND(R)=KOP => ROP(R)=OENTRY => MAINEND=NRL => MAINEND:=I) FOR I IN 0,1,NRL-1;
 START:=-1;
 (R:=FREE(RLIST+I);
  RKIND(R)=KOP => ROP(R)=OENTRY => (START GE 0 => XSCAN(START,I) ELSE (I>0 => XSCAN(0,I)); START:=I)) FOR I IN 0,1,NRL-1;
 START GE 0 => XSCAN(START,NRL) ELSE (NRL>0 => XSCAN(0,NRL));
 START:=-1;
 (R:=FREE(RLIST+I);
  RKIND(R)=KOP => ROP(R)=OENTRY => (START GE 0 => EFUNC(START,I,0) ELSE (I>0 => EFUNC(0,I,1));
                                    START:=I)) FOR I IN 0,1,NRL-1;
 START GE 0 => EFUNC(START,NRL,0) ELSE (NRL>0 => EFUNC(0,NRL,1));
 EDATA(0);
 CCALL fflush(0);
 0) %%
