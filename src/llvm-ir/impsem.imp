TWOSEG;
CONST IS COMMON;
ARR,NARR,REGN ARE COMMON;
CO,NCO,ANCO,REMO ARE COMMON;                  # THE C SIDE READS THEM (SRC/SHARED.TXT) #
FINAM IS COMMON;
#THIS IS FILE IMPSEM, THE MACHINE-INDEPENDENT SEMANTIC ROUTINES OF DECUS/IMPSEM.IMC FOR THE 64 BIT PORT THAT COMPILES TO IR (SEE CODE2; A
 FORMAL PARAMETER IS A TEMPORARY HOLDING THE POINTER, A REGISTER DECLARATION A TEMPORARY OF THE IR): NAME, AREG,
 AREG1, REG2, TSTRN, VAL, SVAL, STACKUP, SWITCH, DECL, DECLARE, THE REGISTER TESTS OF THE CODE GENERATOR (HISREG, PAIRFIRST,
 SUBREG, TMPREG, SAMEREG, REGEQ, REGSIM, REG0, RMATCH), THE SUBROUTINE ROUTINES (SUBPR0, SUBPRM, SUBTMPF, SUBBEG, SUBEND, NSUBP),
 REMOT, CALLME AND REG2S.  FCON (WHICH CALLS THE C LIBRARY'S SSCANF), LETSYN, ERRSRT AND CVAL (THE TABLE OF THE NAMES CALLED WITH VALUES)
 ARE HERE TOO.  THE TABLE OF SEMANTIC ROUTINES HOLDS ADDRESSES (STAGE0/SEMTAB.C), SO EACH ROUTINE
 IS ENTERED WITH DSEM(NAME,ROUTINE) AS IN THE ORIGINAL, BY THE PROCEDURES THE DRIVER CALLS (IMPSEM, CODEI, CODE2I, CODE3I).
 

 THE REGISTERS ARE DESCRIBED BY WORDS OF THE ARRAY RG, IN THE LAYOUT OF THE ORIGINAL (THE COMMENT AT AREG1 IN IMPSEM.IMC): BIT 35
 A HARDWARE REGISTER HAS BEEN ASSIGNED, BITS 29-18 THE REFERENCE COUNT, 17-13 THE HARDWARE REGISTER, BIT 12 NOT A TEMPORARY, BIT 11
 A SUBROUTINE CALL, BITS 10-6 THE LOWER LIMIT, BIT 5 TWO SUCCESSIVE REGISTERS, BITS 4-0 THE UPPER LIMIT.  THE WORDS OF THE
 STACK AND OF THESE ARRAYS HAVE FIELDS OF THEIR OWN (SEE COTREE).  NO OPERATOR HAS PRECEDENCE IN IMP:
 THE EXPRESSIONS ARE FULLY PARENTHESISED. #

SUBR IINIT(NIL) IS (
 GINIT NE 0 => RETURN 0;
 GINIT:=1;
 FRELOT(SUBPAR,'SUBRP',5,0); NSUBPAR:=0;
 FRELOT(PARTMP,'PARTM',5,0); NPARTMP:=0;
 FRELOT(LISTS,'LISTS',50,0); LISTB:=LISTE:=BLIST:=0;
 FRELOT(REGDEC,'RGDEC',5,0); NREGDEC:=0;
 FRELOT(LOCV,'LOCV',5,0); NLOCV:=0;
 FRELOT(ARR,'ARRYS',5,0); NARR:=0;
 FRELOT(RG,'REGS',300,0); REGN:=65;
 FREES((RG+I)+1,((10000B AND (I LS 7)) OR (101B*(I AND 37B)))) FOR I IN 0,1,63;
 SUBTMPN:=0;
 SUBTMP:=NEWNAME('PAR');
 0);

# AREG(I) IS THE REGISTER INDEX OF HARDWARE REGISTER I (NOT A NEW ONE); WITH THE 40B BIT SET IT IS A REGISTER DEFINED BY THE USER #
SUBR AREG(I) IS I+1;
SUBR REG2(N) IS N+1;

# AREG1(I,J): ASSIGN A REGISTER BETWEEN I AND J, GIVING ITS INDEX #
SUBR AREG1(I,J) IS (
 S,II,JJ ARE LOCAL;
 IINIT(0);
 II:=I; JJ:=J;
 ((II OR JJ) AND (NOT 177B)) NE 0 => (ERROR(1,'IN AREG1 - I OR J OUT OF RANGE.'); II:=0; JJ:=37B);
 S:=REGN;
 FADD(RG,REGN,(JJ OR (II LS 6)));
 (JJ AND 40B) NE 0 => FADD(RG,REGN,((JJ AND 37B) OR (II LS 6)));
 REGN>2048 => ERROR(0,'MORE THAN 2047 REGISTERS IN ONE COMPILATION (THE INDEX IS 11 BITS IN THE RECORDS): SPLIT THE FILE.');   # NOT IN THE TAPE: THE INDEX IS NEVER GIVEN BACK HERE, AND A LONG FILE USED TO GET WRONG CODE WITHOUT A WORD #
 S);

# TSTRN(DI): THE REGISTER NUMBER IF THE NAME IS ONE OF 0R ... 15R, ELSE -1.  THE NAME IS EIGHT CHARACTERS IN THE FIRST WORD #
SUBR TSTRN(DI) IS (
 W,C1,C2,C3,C4 ARE LOCAL;
 W:=DNAME(DI,0);
 C1:=CHR(W,0); C2:=CHR(W,1); C3:=CHR(W,2); C4:=CHR(W,3);
 C1 GE 60B => C1 LE 71B => C2=122B => C3=0 => RETURN (C1-60B);
 C1=61B => C2 GE 60B => C2 LE 65B => C3=122B => C4=0 => RETURN ((C2-60B)+10);
 0-1);

SUBR NAME(S) IS (
 D,J,ATY,K,I,R16 ARE LOCAL;
 IINIT(0);
 (FREE(S) AND 77B) NE 1 => RETURN S;
 D:=HL(FREE(S));
 ATY:=(DPROP('ATYPE',D) LS 6);
 ATY=0 => (DPROPS('ATYPE',D,1); ATY:=(1 LS 6));
 (K:=TSTRN(D)) GE 0 => (FREES(S,(2 OR ATY));
                       K:=AREG(K+40B);
                       FREES(S+1,(K LS 32));
                       RETURN S);
 CONVC(D) NE 0 => (FREES(S,((ATY OR 4) OR (D LS 32)));
                           FREES(S+1,CONST);
                           RETURN S);
 NLOCV NE 0 => (I:=NLOCV-1;
  NL1: I GE 0 => (J:=FREE(LOCV+I);
                  D=HL(J) => (D:=HR(J);
                               ATY:=(DPROP('ATYPE',D) LS 6);
                               NSUBPAR NE 0 => (I:=NSUBPAR-1;
                                NL2: I GE 0 => (J:=FREE(SUBPAR+I);
                                                D=J => (FREES(S,(ATY OR 20B));      # THE WORD AT THE ADDRESS IN THE PARAMETER'S TEMPORARY #
                                                        R16:=FREE(PARTMP+I);
                                                        FREES(S+1,(R16 LS 32));
                                                        RETURN S);
                                                I:=I-1; GO TO NL2));
                               GO TO NL3);
                  I:=I-1; GO TO NL1));
 NL3: NREGDEC NE 0 => (I:=NREGDEC-1;
  NL4: I GE 0 => (J:=FREE(REGDEC+I);
                  D=HR(J) => (FREES(S,(ATY OR 2));
                               FREES(S+1,J AND NOT HMASK);          # THE LEFT PART OF J #
                               RETURN S);
                  I:=I-1; GO TO NL4));
 FREES(S,(((10B OR ATY)) OR (D LS 32)));
 FREES(S+1,0);
 S);

SUBR VAL(S) IS HR(FREE(S+1));

SUBR SVAL(N) IS (J:=ENSTACK(0); FREES(J+1,N); J);

SUBR STACKUP(V) IS (T:=ENSTACK(0); FREES(T,4); FREES(T+1,V); T);

# SWITCH 18 (TWOSEG) PUTS THE CODE OF THE SUBROUTINES IN THE HIGH SEGMENT BEHIND A JUMP IN THE LOW ONE; THERE IS ONE SEGMENT HERE #
# THE C KEYWORD SWITCH IS NOT A NAME THE C BACK END ACCEPTS #
SUBR SWITCH(N) IS (
 N NE 18 => FINAM[5]:=(FINAM[5] OR (1 LS (N-1)));
 ENSTACK(0));

SUBR NSUBP(NIL) IS NSUBPAR;

# THE TESTS OF THE REGISTERS #
SUBR HISREG(I) IS (IINIT(0); 10000B AND FREE(RG+I));
SUBR PAIRFIRST(J) IS (IINIT(0); 40B AND FREE(RG+J));
SUBR SUBREG(J) IS (IINIT(0); 4000B AND FREE(RG+J));

# TMPREG(J): IS REGISTER J A TEMPORARY THAT CAN BE OPTIMISED OUT? #
SUBR TMPREG(J) IS (
 IINIT(0);
 J LE 64 => RETURN 0;
 (FREE(RG+J) AND 14040B) NE 0 => RETURN 0;
 1);

# SAMEREG(J): A NEW REGISTER WITH THE LIMITS OF REGISTER J #
SUBR SAMEREG(J) IS (
 K ARE LOCAL;
 TMPREG(J)=0 => RETURN J;
 K:=FREE(RG+J);
 AREG1((77B AND (K RS 6)),(77B AND K)));

SUBR REGEQ(I,J) IS (
 II,JJ ARE LOCAL;
 IINIT(0);
 I=J => RETURN 1;
 I=0 => RETURN 0;
 J=0 => RETURN 0;
 II:=FREE(RG+I); JJ:=FREE(RG+J);
 (37B AND II)=(37B AND (II RS 6)) => (II=JJ => RETURN 1);
 0);

SUBR REGSIM(I,J) IS (
 IINIT(0);
 I=J => RETURN 1;
 I=0 => RETURN 0;
 J=0 => RETURN 0;
 FREE(RG+I)=FREE(RG+J) => 1 ELSE 0);

SUBR REG0(I) IS (
 IINIT(0);
 I=0 => RETURN 0;
 (FREE(RG+I) AND 3700B)=0 => 1 ELSE 0);

# RMATCH(I,J,RN): IS REGISTER RN WITHIN THE LIMITS I..J? #
SUBR RMATCH(I,J,RN) IS (
 K ARE LOCAL;
 IINIT(0);
 K:=FREE(RG+RN);
 J LT (37B AND K) => RETURN 0;
 I GT (37B AND (K RS 6)) => RETURN 0;
 1);

# SUBPR0(I): 0 AT SUBROUTINE CALLS, 1 AT THE END OF A PARAMETER LIST; KEEPS TRACK OF WHEN THE CALL TEMPORARIES CAN BE REUSED #
SUBR SUBPR0(I) IS (
 I NE 0 => (SUBCNT:=SUBCNT-1; SUBCNT=0 => SUBTMPK:=0)
  ELSE SUBCNT:=SUBCNT+1;
 0);

SUBR SUBPRM(I) IS (
 J ARE LOCAL;
 IINIT(0);
 J:=ENSTACK(0);
 FREES(J,(10B OR (SUBTMP LS 32)));
 FREES(J+1,SUBTMPK);
 SUBTMPK:=SUBTMPK+1;
 SUBTMPK>SUBTMPN => SUBTMPN:=SUBTMPK;
 J);

SUBR SUBTMPF(NIL) IS (
 IINIT(0);
 SUBTMPN NE 0 => (FADD(ARR,NARR,(SUBTMP OR (SUBTMPN LS 32)));
                  SUBTMP:=NEWNAME('PAR');
                  SUBTMPN:=0; SUBTMPK:=0);
 0);

# SUBBEG(A): BEGIN A SUBROUTINE NAMED AT STACK ENTRY A, WHOSE FORMAL ARGUMENTS ARE THE CURRENT LIST.  THE CODE BEGINS WITH AN ENTRY RECORD AND, FOR
  EACH FORMAL, A PARAMETER RECORD NAMING THE TEMPORARY THAT GETS THE POINTER; ALL SUBROUTINES CAN BE RE-ENTERED #
SUBR SUBBEG(A) IS (
 J,K,I,T ARE LOCAL;
 IINIT(0);
 SUBRTN NE 0 => ERROR(1,'NESTED SUBROUTINES.');
 SUBRTN:=1;
 J:=HL(FREE(A));
 SUBNAM:=J;
 DPROPS('COM',J,2);
 ADDREC(A,KOP,OENTRY,0,FREE(A),FREE(A+1),0);
 K:=ENSTACK(0);
 SB1: GETLIST(K) NE 0 => (I:=HL(FREE(K));
                          J:=NEWNAME(DNAME(I,0));
                          FADD(LOCV,NLOCV,(J OR (I LS 32)));
                          FADD(SUBPAR,NSUBPAR,J);
                          T:=AREG1(101B,0);
                          FADD(PARTMP,NPARTMP,T);
                          ADDREC(A,KOP,OPARAM,T,0,0,0);
                          GO TO SB1);
 SUBTMPF(0);
 A);

SUBR SUBEND(NIL) IS (SUBRTN:=0; SUBNAM:=0; NLOCV:=0; NSUBPAR:=0; NPARTMP:=0; 0);

# REMOT(A): CODE FOR THE REMOTE (HIGH) SEGMENT.  IT IS KEPT IN THE CHAIN REMO, WHICH DEMIT PUTS AT THE END OF THE MAIN PROGRAM (THERE IS ONE SEGMENT HERE) #
SUBR REMOT(A) IS (
 M ARE LOCAL;
 IINIT(0);
 REMO=0 => (FRELOT(REMO,'REMOT',3,0); FREES(REMO+2,0));       # NOT A SCRATCH ENTRY OF THE STACK: IT LIVES UNTIL THE UNIT IS ASSEMBLED #
 M:=ENSTACK(0);                                 # A MARKER IN FRONT OF THE CODE: THE REMOTE CODE OF A ROUTINE IS EMITTED WITH THE ROUTINE #
 ADDREC(M,KOP,OREMOTE,0,0,0,SUBNAM);
 HOOK(M,M,A);
 HOOK(REMO,REMO,M);
 FREES(A+2,0);
 A);

SUBR CALLME(A) IS (RELNM:=HL(FREE(A)); A);

SUBR REG2S(S) IS (
 J,F,R ARE LOCAL;
 J:=FREE(S+1);
 F:=(3777B AND HL(J));                      # THE REGISTER FIELD, BITS 32-42 #
 R:=REG2(F);
 FREES(S+1,(J AND NOT (3777B LS 32)) OR (R LS 32));
 S);

# THE LISTS (OF THE ORIGINAL'S IMPSEM.IMC; THE SEED HAS THEM IN SEM.C): NEWLIST(S) OPENS A NEW LIST, WITH THE STACK ENTRY S ON IT IF S; ENLIST(S) ADDS S TO IT;
  GETLIST(S) PUTS THE NEXT ENTRY OF THE CURRENT LIST AT S, AND IS 0 WHEN THERE IS NONE, WHICH ALSO CLOSES THE LIST AND REOPENS THE PREVIOUS #
SUBR NEWLIST(S) IS (
 IINIT(0);
 FLEN(LISTS) LE (LISTE+3) => FADDEX(LISTS,LISTE+3);
 FREES(LISTS+LISTE,LISTB);
 FREES((LISTS+LISTE)+1,LISTE);
 FREES((LISTS+LISTE)+2,BLIST);
 LISTE:=LISTE+3; LISTB:=LISTE; BLIST:=LISTE;
 S NE 0 => ENLIST(S);
 S);

SUBR ENLIST(S) IS (
 V0,V1,V2 ARE LOCAL;
 IINIT(0);
 V0:=FREE(S); V1:=FREE(S+1); V2:=FREE(S+2);
 FADD(LISTS,LISTE,V0);
 FADD(LISTS,LISTE,V1);
 FADD(LISTS,LISTE,V2);
 0);

SUBR GETLIST(S) IS (
 J ARE LOCAL;
 IINIT(0);
 J:=LISTE-BLIST;
 J NE 0 => (FREES(S,FREE(LISTS+BLIST));
            FREES(S+1,FREE((LISTS+BLIST)+1));
            FREES(S+2,FREE((LISTS+BLIST)+2));
            BLIST:=BLIST+3;
            RETURN J/3);
 BLIST:=FREE((LISTS+LISTB)-1);
 LISTE:=FREE((LISTS+LISTB)-2);
 LISTB:=FREE((LISTS+LISTB)-3);
 0);

# ASSEMC(A): THE END OF A COMPILATION UNIT; A IS THE STACK ENTRY WHOSE CODE IS THE WHOLE PROGRAM.  THE ORIGINAL ASSEMBLES IT; HERE THE CHAINS ARE WRITTEN AS IR (DEMIT),
  AND LISTED FIRST IF /A #
SUBR ASSEMC(A) IS (
 ANYCODE(0) NE 0 => (SUBTMPF(0);
                     (FINAM[5] AND 1) NE 0 => (PRINT /,STG 0,'** CODE PRODUCED BY PROGRAM',/;
                                               PCODE(A,77777777777B));
                     DEMIT(A));
 0);

# DECL(I,S): NOTE ONE PROPERTY OF A DECLARATION: 0 A SYNONYM FOR THE REGISTER NAMED AT S, 1 A LENGTH (S IS A CONSTANT), 2 AND OVER A
  FLAG (BIT I OF PROPS) #
SUBR DECL(I,S) IS (
 J,K ARE LOCAL;
 IINIT(0);
 I>1 => (PROPS:=(PROPS OR (1 LS I)); RETURN 0);
 I=0 => (PREGSYN NE 0 => ERROR(1,'TWO REGISTERS IN SAME DECLARATION.');
         J:=HL(FREE(S));
         (K:=TSTRN(J)) GE 0 => PREGSYN:=AREG(K+40B)
          ELSE ERROR(1,'ANTECEDENT NOT A HARDWARE REGISTER IN SYNONYM DECLARATION.');
         RETURN 0);
 PLONG NE 0 => ERROR(1,'TWO LENGTHS IN SAME DECLARATION. ');
 (FREE(S) AND 77B)=4 => PLONG:=FREE(S+1)
  ELSE ERROR(1,'N NOT A CONSTANT IN N LONG.');
 0);

# DECLARE(S): APPLY THE DECLARED PROPERTIES TO THE NAMES OF THE CURRENT LIST (THEIR ENTRIES ARE PUT IN THE STACK AT S ONE AT A TIME) #
SUBR DECLARE(S) IS (
 T,J,JJ,K,I,OLD ARE LOCAL;
 IINIT(0);
 T:=ENSTACK(0);
 DL1: GETLIST(S)=0 => GO TO DLX;
 J:=HL(FREE(S));
 JJ:=0;
 NLOCV NE 0 => (I:=NLOCV-1;
  DL2: I GE 0 => (K:=FREE(LOCV+I);
                  J=HL(K) => (J:=HR(K); GO TO DL3);
                  I:=I-1; GO TO DL2));
 DL3: (PROPS AND 2048) NE 0 => (OLD:=J;                   # LOCAL #
                                J:=NEWNAME(DNAME(J,0));
                                FADD(LOCV,NLOCV,(J OR (OLD LS 32))));
 NREGDEC NE 0 => (I:=NREGDEC-1;
  DL4: I GE 0 => (K:=FREE(REGDEC+I);
                  J=HR(K) => (JJ:=HL(K); GO TO DL5);
                  I:=I-1; GO TO DL4));
 DL5: (K:=TSTRN(J)) GE 0 => JJ:=AREG(K+40B);
 PREGSYN NE 0 => (JJ:=PREGSYN;
                  FADD(REGDEC,NREGDEC,(J OR (JJ LS 32))));
 (PROPS AND 4) NE 0 => JJ=0 => DPROPS('COM',J,1);
 (PROPS AND 4096) NE 0 => JJ=0 => DPROPS('COM',J,3);          # EXTERNAL: A VARIABLE OF THE C LIBRARY OR OF ANOTHER OBJECT, NOTHING IS DEFINED HERE #
 (PROPS AND 8) NE 0 => DPROPS('ATYPE',J,2);
 (PROPS AND 16) NE 0 => DPROPS('ATYPE',J,1);
 (PROPS AND 32) NE 0 => (JJ=0 => (JJ:=AREG1(101B,15B);               # REGISTER #
                                  FADD(REGDEC,NREGDEC,(J OR (JJ LS 32))));
                         0);
 (PROPS AND 64) NE 0 => JJ NE 0 => 0;               # RESERVED #
 (PROPS AND 128) NE 0 => JJ NE 0 => 0;              # SCRATCH #
 (PROPS AND 256) NE 0 => JJ NE 0 => 0;             # PROTECTED #
 (PROPS AND 512) NE 0 => JJ NE 0 => 0;              # AVAILABLE #
 (PROPS AND 1024) NE 0 => JJ NE 0 => (I:=NREGDEC-1;                  # RELEASED #
   DL6: I GE 0 => (J=HR(FREE(REGDEC+I)) => FREES(REGDEC+I,0);
                   I:=I-1; GO TO DL6);
   0);
 PLONG NE 0 => JJ=0 => FADD(ARR,NARR,(J OR (PLONG LS 32)));
 JJ NE 0 => (PLONG OR (PROPS AND 28)) NE 0 => ERROR(1,'PROPERTY DECLARED IS NOT APPLICABLE TO REGISTER.');
 JJ=0 => (PROPS AND 1984) NE 0 => ERROR(1,'PROPERTY MAY ONLY BE DECLARED FOR REGISTERS.');
 GO TO DL1;
 DLX: PROPS:=PLONG:=PREGSYN:=0;
 T);

# LETSYN(S): LET X = Y (OF THE ORIGINAL'S IMPSEM.IMC) #
SUBR LETSYN(S) IS (MAX:=FREE(S+1);

 SYNT(ENSTACK(DIR('VBL')),0);
 SYTRM(ENSTACK(-FREE(MAX)));
 SYNTAX(1);
 J:=MAX; WHILE K:=FREE(J+1) DO (FREES(J,K); J:=J+1); FREES(J,0);
 EQUOSE(S,NEWLIST(0)); SEMANTICS(); ENSTACK(0));

SUBR ERRSRT(N,E) IS (ERROR(N,FREE(DPROP('NAME',-E)));
	NAME(ENSTACK(DIR('0'))));

# CVAL(A): THE NAME A IS A C FUNCTION THAT TAKES ITS ARGUMENTS BY VALUE (CCALL of LIB/FFI.IMC; NOT IN THE ORIGINAL).  ISCVAL(D): IS THE NAME WITH DIRECTORY INDEX D ONE #
SUBR CVAL(A) IS (
 D ARE LOCAL;
 D:=HL(FREE(A));
 ISCVAL(D) => RETURN A;
 CVT=0 => FRELOT(CVT,'CVALS',16,0);
 FADD(CVT,NCVT,D);
 A);

SUBR ISCVAL(D) IS (
 I ARE LOCAL;
 NCVT>0 => ((FREE(CVT+I)=D => RETURN 1) FOR I IN 0,1,NCVT-1);
 0);

# FCON(A,B,E): THE FLOATING CONSTANT A.B"E, WHOSE PARTS ARE THE NAMES OF STACK ENTRIES A AND B (DIGITS) AND THE CONSTANT E (OR 0), AS THE BITS OF THE IEEE 754 DOUBLE NEAREST TO IT (THE ORIGINAL BUILDS
  A PDP-10 FLOATING POINT WORD; THE C LIBRARY'S SSCANF DOES THE CONVERSION HERE) #
SUBR FCON(A,B,E) IS (
 FBUF IS 32 LONG;
 DGW IS 6 LONG;
 FP,FQ,FC,FN,EX,BITS,EXN,I ARE LOCAL;
 FQ:=BYTEP FBUF<7,36>; FN:=0;
 FP:=BYTEP FREE(DPROP('NAME',HL(FREE(A))))<7,36>;
 WHILE FC:=<+FP> DO (FC<60B => GO TO FBAD; FC>71B => GO TO FBAD; FN<100 => (<+FQ>:=FC; FN:=FN+1));
 FN=0 => <+FQ>:=60B;
 <+FQ>:=56B; FN:=0;
 FP:=BYTEP FREE(DPROP('NAME',HL(FREE(B))))<7,36>;
 WHILE FC:=<+FP> DO (FC<60B => GO TO FBAD; FC>71B => GO TO FBAD; FN<100 => (<+FQ>:=FC; FN:=FN+1));
 FN=0 => <+FQ>:=60B;
 <+FQ>:=145B;
 EX:=0;
 E => ((FREE(E) AND 77B) NE 4 => GO TO FBAD;
       EX:=FREE(E+1);
       EX>308 => GO TO FRANGE;
       EX<-330 => GO TO FRANGE;
       GO TO FEXP;
       FRANGE: ERROR(1,'EXPONENT OUT OF RANGE.'); EX:=0;
       FEXP: 0);
 EX<0 => (EX:=-EX; <+FQ>:=55B);
 EXN:=0;                                              # THE DIGITS OF THE EXPONENT, THE LAST FIRST #
 FEX: DGW[EXN]:=60B+(EX-10*(EX/10)); EXN:=EXN+1; EX:=EX/10; EX>0 => GO TO FEX;
 (<+FQ>:=DGW[I]) FOR I IN EXN-1,-1,0;
 <+FQ>:=0;
 CCALL sscanf(LOC(FBUF),LOC('%lf'),LOC(BITS));
 GO TO FDONE;
 FBAD: ERROR(1,'ILLEGAL CHARACTER IN FLOATING CONSTANT.');
 BITS:=0;
 FDONE: FREES(A,204B);
 FREES(A+1,BITS);
 A);

SUBR IMPSEM(NIL) IS (
  IINIT(0);
  DSEM('NAME',NAME);
  DSEM('AREG1',AREG1);
  DSEM('AREG',AREG);
  DSEM('REG2',REG2);
  DSEM('VAL',VAL);
  DSEM('SVAL',SVAL);
  DSEM('NEWLIST',NEWLIST);
  DSEM('ENLIST',ENLIST);
  DSEM('DECL',DECL);
  DSEM('DECLARE',DECLARE);
  DSEM('SUBBEG',SUBBEG);
  DSEM('SUBEND',SUBEND);
  DSEM('SUBPR0',SUBPR0);
  DSEM('REMOT',REMOT);
  DSEM('ASSEMC',ASSEMC);
  DSEM('CALLME',CALLME);
  DSEM('SWITCH',SWITCH);
  DSEM('STACKUP',STACKUP);
  DSEM('REG2S',REG2S);
  DSEM('ERROR',ERRSRT);
  DSEM('LETSYN',LETSYN);
  DSEM('CVAL',CVAL);
  DSEM('FCON',FCON);
  0)%%
