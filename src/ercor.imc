TWOSEG;
#THIS IS THE IMP PARSER ERROR CORRECTOR, ERCOR, FOR THE 64 BIT PORT.
 SEE DECUS/ERCOR.IMC FOR THE ORIGINAL AND ITS COMMENTS, DOCS/PORTING/MODULES.MD FOR THE
 DIFFERENCES.
 CALL ERCOR(OP,NP,S) WHERE OP IS THE FREE STORAGE POINTER TO THE NP
   PREVIOUS PARSES, AND S IS THE LAST SYMBOL READ.  RETURNS THE FREE
   STORAGE POINTER OF AN ARRAY CONTAINING SYMBOLS TO BE INSERTED IN THE
   INPUT STREAM, TERMINATED WITH A 0.
 THE CURRENT GOAL LIST IS KEPT IN CGL IN 2-WORD PACKETS (NODE,GOAL).  THE
   STACK ERST HOLDS ONE-WORD ENTRIES (NODE OR TYPE LS GTSH), WHERE THE TYPE IS
   AS FOLLOWS:
              0-3  TYPE OF GRAPH NODE.
              4    INFORMATION FROM GOAL WHICH WAS REACHED.  HOLDS NODE NR.
                     WHICH CALLED FOR THE GOAL.  WORD ABOVE ON STACK HOLDS
                     NT NR OF GOAL OR BEST WIDTH LS 32.  WORD ABOVE THAT
                     MUST BE TYPE 2 NODE.
              5    NODE ON CHAIN OF TERMINAL ENTRY POINTS TO GRAPH.
 (HALVES ARE 32 BITS.)

ISNAME(S) - RETURNS 1 IF SYMBOL WITH DIRECTORY INDEX S MAY BE USED AS A SYMBOL
 IN SYNTAX EXTENSIONS, RETURNS 2 IF IT MAY BE USED AS AN IDENTIFIER, RETURNS 0
 OTHERWISE.  (THE MARKS ;:%< ARE NOT SYMBOLS; IDENTIFIERS ARE ALPHANUMERIC.)

AMBIG(P,NP,PN,O,TR) - CHECKS THE ARRAY OF PARSES TO DETERMINE IF THERE ARE ANY
   AMBIGUITIES, AND DECIDES BETWEEN THEM IF THERE ARE.  #

SUBR ERCOR(OP,NP,SS) IS (
 ERST=0=>ERST:=FNEW('ER/ST',20);
 EINIT=0=>(FRELOT(CGL,'ER/CG',20,0); MAXPATH:=3;
          PCT:=DIR('%'); NAM:=DIR('NAM#'); ZER:=DIR('0'));
 (EINIT:=EINIT+1)>50=>ERROR(0,'** TOO MANY SYNTAX ERRORS **');
 FINAM IS COMMON; TR:=FINAM[5] AND 100B;
 TR=>PRINT /,STG 0,'** ERROR CORRECTOR ENTERED.',/;
 TERMS:=-1;
 S:=SS;
 NCHARS:=0;
NEXTERM:
 PNAME(S); PRINT STG 1,' ';
 MP:=1;
 NMP:  BWIDTH:=TCUR:=PN:=IP:=0;
 TPATH:=MP+1;
 TR=>(PNAME(S); PRINT STG 0,' IS NEW TERMINAL.',/);
NEXTPARSE:
 (PN:=PN+1)>NP=>(TERMS>0=>GO TO X;
                (NCHARS:=NCHARS+1)>5=>(TIPIT:
                     PRINT /;
                     ERROR(0,'** ERROR CORRECTOR GIVES UP. **'));
                (MP:=MP+1) LE MAXPATH=>GO TO NMP;
                S=PCT=>ERROR(0,'** ERROR CORRECTOR GIVES UP AT % **');
                LEX(S); GO TO NEXTERM);
 TR=>PRINT STG 0,'PARSE #',IGR 0,PN,/;
 NST:=NCGL:=0;
 #MAKE GOAL/NODE LIST FROM PARSE#
 NODE:=FREE(OP+IP+1);
 J:=FREE(OP+IP) AND HMASK;
 (FADD(CGL,NCGL,FREE(OP+K) RS HSH);
  I:=FREE(OP+K) AND HMASK; FADD(CGL,NCGL,I);
  TR=>(PRINT STG 0,'  GOAL '; PNAME(GVAL(FREE(OP+K) RS HSH));
       PRINT STG 0,' AT NODE #',IGR 0,FREE(OP+K) RS HSH,/)) FOR K IN IP+2,1,IP+J;
 CGOAL:=I;
 IP:=IP+J+1; WIDTH:=NCGL;
NEXTNODE: NODE=0=>(TR=>PRINT /; GO TO BACKUP);
 #WALK THE NEXT NODE#
 TY:=GTYPE(NODE); VAL:=GVAL(NODE);
 TR=>(PRINT STG 0,'NODE #',IGR 0, NODE,STG 0,', TYPE ',IGR 0,TY,STG 0,', ';
      TY =3=>(PRINT '[',IGR 0, VAL,STG 1,']')
               ELSE (PNAME( VAL));
      PRINT STG 0,', ',IGR 0,TCUR,STG 0,' TERMS. SO FAR, STACK ',IGR 0,NST,/);
 GO TO (TYPE0,TYPE1,TYPE2,TYPE3,NEXTNODE,TYPE5) TY;
 TYPE5: TY:=3;
 PUSHIT: TYPE3: FADD(ERST,NST,NODE OR TY LS GTSH);
 SCRFWD: NODE:=SCR(NODE);
         TR=>PRINT STG 0,'ON TO SCR, ';
         GO TO NEXTNODE;
 TYPE1: VAL=S=>(#FOUND THE TERMINAL SYMBOL#
                FTS: TPATH=TCUR=>WIDTH GE BWIDTH=>GO TO TOOMANY;
                NTERMS:=0;
                TERMS<0=>FRELOT(TERMS,'TSYMS',20,0);
                TR=>PRINT STG 0,'** VALID PATH FOUND WITH ',IGR 0,TCUR,
                  STG 0,' TERMINALS, BRANCHING MIN.',IGR 0, WIDTH/2,/;
                NST=>(
                  (J:=FREE(ERST+I);
                   TR=>PRINT STG 8,' ',OCT 12,J,IGR 6,J AND HMASK,/;
                   (J RS GTSH)=1=>((J:=GVAL(J AND HMASK))=NAM=>J:=ZER;
                                 FADD(TERMS,NTERMS,J)))  FOR I TO NST-1);
                FADD(TERMS,NTERMS,S);
                FADD(TERMS,NTERMS,0);
                BWIDTH:=WIDTH; TPATH:=TCUR;
                GO TO ALTFWD);
        ISNAME(S)=2 => VAL=NAM => GO TO FTS;
        (TCUR:=TCUR+1)<TPATH=>GO TO PUSHIT;
        TCUR=TPATH=>WIDTH<BWIDTH=>GO TO PUSHIT;
        TCUR:=TCUR-1;
        TOOMANY: TR=>PRINT STG 0,'TOO MANY TERMINALS;';
 ALTFWD: NODE:=GNEXT(ALT(NODE),CGOAL);
         TR=>PRINT STG 0,'TRY ALTERNATE ';
         GO TO NEXTNODE;
 TYPE2: GMADE(NODE,CGOAL)=>(NCGL LE 4=>GO TO PUSHIT;
                            FADD(ERST,NST,NODE OR 2 LS GTSH);
                            FADD(ERST,NST,CGOAL OR WIDTH LS HSH);
                            J:=FREE(CGL+NCGL-2);
                            FADD(ERST,NST,J OR 4 LS GTSH);
                            (NCGL:=NCGL-2)<WIDTH=>WIDTH:=NCGL;
                            CGOAL:=FREE(CGL+NCGL-1);
                            NODE:=SCR(FREE(CGL+NCGL));
                            TR=>PRINT STG 0,'MADE GOAL, POP TO ';
                            GO TO NEXTNODE);
        GO TO PUSHIT;
 TYPE0: FADD(CGL,NCGL,NODE);
        FADD(CGL,NCGL,(CGOAL:=DPROP('NODE',VAL)));
        FADD(ERST,NST,NODE);
        TR=>(PRINT STG 0,'NEW GOAL ';PNAME(VAL); PRINT STG 0,'=',IGR 0,
               CGOAL,STG 0,' AT LVL ',IGR 0,NCGL,/);
        NODE:=GENTRY(0); GCONN(NODE,CGOAL)=>GO TO NEXTNODE;
        GO TO ALTFWD;

 BACKUP: NST=0=>GO TO NEXTPARSE;
         J:=FSUB(ERST,NST);
         TY:=J RS GTSH; NODE:=J AND HMASK;
         TR=>PRINT 'BACKING UP PAST NODE #',IGR 0,NODE,STG 0,
                ', TYPE ',IGR 0,TY,STG 0,', GOAL #',IGR 0,CGOAL,STG 0,
                ' LVL ',IGR 0,NCGL,/;
         GO TO (BK0,BK1,BK2,BK3,BK4) TY;
 BK0: NCGL:=NCGL-2;
      CGOAL:=FREE(CGL+NCGL-1);
      GO TO ALTFWD;
 BK1: TCUR:=TCUR-1;
 BK3: BK2: GO TO ALTFWD;
 #HERE IS THE MEATY BACKUP - THROUGH A GOAL-REACHED TYPE 2 NODE#
 BK4: FADD(CGL,NCGL,NODE);
      J:=FSUB(ERST,NST);
      FADD(CGL,NCGL,(CGOAL:=J AND HMASK));
      WIDTH:=J RS HSH;
      J:=FREE(ERST+NST-1);
      NODE:=J AND HMASK; GO TO SCRFWD;
 X: TERMS);

SUBR FSUB (Q,QQ) IS (
 (QQ:=QQ-1)<0=>ERROR(0,'** STACK UNDERFLOW IN FSUB **');
 FREE(Q+QQ));

# THE ORIGINAL STARTS WITH NM=R'''' => RETURN 2, COMPARING NM LEFT OVER FROM THE PREVIOUS
  CALL WITH THE APOSTROPHE (47B); IT IS KEPT.  A STRING CONSTANT IS BYTES HERE AND THE
  NAME IS PACKED, SO THE TESTS FOR MORE THAN ONE CHARACTER AND FOR THE FIRST ARE WRITTEN
  OUT. #
SUBR ISNAME(S) IS (
 ISNIT=0 => (SEM:=DIR(';'); COL:=DIR(':');
             PCT:=DIR('%'); LBR:=DIR('<'); ISNIT:=1);
 NM=47B=>RETURN 2;
 NM:=DNAME(S,0); REST(NM) => RETURN 2;
 (NM:=CHR0(NM)) GE 060B => NM LE 071B => RETURN 2;
 (NM:=NM AND 137B) GE 101B => NM LE 132B => RETURN 2;
 NZ:=1; S=SEM=>NZ:=0; S=COL=>NZ:=0; S=PCT=>NZ:=0; S=LBR=>NZ:=0; NZ);

SUBR AMBIG(P,NP,PN,O,TR) IS (
 # COMPARES ALL PAIRS I,J OF PARSES, I<J.  I, J ARE INDICES, NI, NJ ARE NUMBER.#
 A1: I:=P; NI:=0; IL:=-1;
 A4: NI:=NI+1;
     I:=I+IL+1;
 A2: NI=PN=>GO TO AX;
     IL:=FREE(I) AND HMASK;
     J:=I; NJ:=NI; JL:=IL;
 A3: (NJ:=NJ+1)>PN=>GO TO A4;
     J:=J+JL+1;
     JL:=FREE(J) AND HMASK;
     IL NE JL=>GO TO A3;
     (FREE(I+K) NE FREE(J+K) => GO TO A3) FOR K IN 1,1,IL;
 TR=>PRINT STG 0,'AMBIGUITY FOUND - IDENTICAL PARSES # ',
           IGR 3,NI,STG 0,',',IGR 0,NJ,STG 0,/;
 IO:=FREE(I) RS HSH; JO:=FREE(J) RS HSH;
 IT:=JT:=SAME:=0;
 A5: IO=>JO=>(IO:=FREE(O+IO); JO:=FREE(O+JO);
              (IO RS HSH) NE (JO RS HSH)=>SAME:=1;
              IO<0=>IT:=IT+1; JO<0=>JT:=JT+1;
              IO:=IO AND HMASK; JO:=JO AND HMASK;
              GO TO A5);
 (IO OR JO OR SAME)=0=>(TR=>PRINT 'OUTPUTS IDENTICAL'; GO TO OFFJ);
 LONGER:=IO-JO;
 A6: IO=>(IO:=FREE(O+IO); IO<0=>IT:=IT+1; IO:=IO AND HMASK; GO TO A6);
 A7: JO=>(JO:=FREE(O+JO); JO<0=>JT:=JT+1; JO:=JO AND HMASK; GO TO A7);
 IT NE JT=>(TR=>PRINT 'MORE TERMINALS'; IT>JT=>GO TO OFFI; GO TO OFFJ);
 LONGER=0=>(ERROR(1,'SYNTACTIC AMBIGUITY.');
	FINAM IS COMMON; FINAM[5]:=FINAM[5] OR 40000B; # TURN ON LIST #
	(IO:=FREE(I) RS HSH)=>(
		PRINT STG 0,' * IDENTIFIERS IN AMBIGUOUS SEGMENT (IN REVERSE ORDER): ',/,' ';
		WHILE IO DO ((IO:=FREE(O+IO))<0=>(PNAME(-(IO ARS HSH));
					PRINT STG 0,' ');
			IO:=IO AND HMASK);
		PRINT /);
	GO TO OFFJ);
 TR=>PRINT 'LONGER'; LONGER>0=>GO TO OFFI;
 OFFJ: I:=J; NI:=NJ; IL:=JL;
 OFFI: TR=>PRINT ', #',IGR 0,NI,STG 0,' DISCARDED.',/;
 # MOVE UP FROM I+IL+1 TO I #
 J:=I+(IL:=IL+1); JL:=P+NP-1;
 J LE JL =>(FREES(I+K,FREE(J+K)) FOR K TO JL-J);
 NP:=NP-IL;
 (PN:=PN-1)>1=>GO TO A1;
 AX: 0)%%
