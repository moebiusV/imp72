  0 SUBR COLLATZ(N) IS (S_0; WHILE N NE 1 DO (N_((N AND 1)=>(3*N)+1 ELSE N RS 1); S_S+1); S);
  0 SUBR DIGSUM(N) IS (S_0; WHILE N>0 DO (S_S+N-(N/10)*10; N_N/10); S)
