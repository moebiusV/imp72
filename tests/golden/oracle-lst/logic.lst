  0 PRINT IGR 3,R2(1,2),IGR 3,R2(2,1),IGR 3,R2(2,2),/;
  0 PRINT OCT 12,12 AND 10,OCT 12,12 OR 3,OCT 12,12 XOR 10,OCT 12,L1(5),OCT 12,L2(1),/;
