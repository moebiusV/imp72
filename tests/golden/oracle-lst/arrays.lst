   IMP 1.5    20-AUG-73      ARRAYS.IMP[1,2]      27-APR-79   06:53

  0 A IS 20 LONG;
  0 B IS 20 LONG;
  0 (A[I]_I*I) FOR I TO 10;
  0 (B[I]_A[I]+A[10-I]) FOR I TO 10;
  0 PRINT IGR 4,A[0],IGR 4,A[1],IGR 4,A[5],IGR 4,A[10],/;
  0 PRINT IGR 4,B[0],IGR 4,B[3],IGR 4,B[5],IGR 4,B[10],/;
  0 PRINT IGR 5,TOT(10),IGR 5,MX(10),IGR 5,IDX(10,B[5]),IGR 5,IDX(10,12345),/;
  0 FINI(0);
  0 SUBR TOT(N) IS (S_0; (S_S+B[I]) FOR I TO N; S);
  0 SUBR MX(N) IS (M_B[1]; I_2; WHILE I LE N DO ((B[I]>M=>M_B[I]); I_I+1); M);
  0 SUBR IDX(N,V) IS (K_0; (B[I]=V=>(K=0=>K_I)) FOR I TO N; K)
  0 %%

