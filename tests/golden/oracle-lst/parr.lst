   IMP 1.5    20-AUG-73      PARR.IMP[1,2]      27-APR-79   06:55

  0 A IS 12 LONG;
  0 B IS 12 LONG;
  0 (A[I]_I*3+1) FOR I TO 11;
  0 PRINT IGR 4,SUM(A,11),IGR 4,PICK(A,7),IGR 4,PICK(B,3),/;
  0 FILL(B,11,5);
  0 PRINT IGR 4,B[0],IGR 4,B[6],IGR 4,B[11],IGR 4,SUM(B,11),/;
  0 COPY(B,A,11);
  0 PRINT IGR 4,B[0],IGR 4,B[5],IGR 4,B[11],IGR 4,MAXOF(B,11),/;
  0 FINI(0);
  0 SUBR SUM(V,N) IS (S_0; (S_S+V[I]) FOR I TO N; S);
  0 SUBR PICK(V,K) IS V[K];
  0 SUBR FILL(V,N,X) IS (V[I]_X*I FOR I TO N; 0);
  0 SUBR COPY(D,S,N) IS (D[I]_S[N-I] FOR I TO N; 0);
  0 SUBR MAXOF(V,N) IS (M_V[0]; (V[I]>M=>M_V[I]) FOR I TO N; M)
  0 %%

