X_5;
PRINT IGR 8,X LS 3,IGR 8,X RS 1,IGR 8,100 RS 3,IGR 8,SH(1,10),IGR 8,SH2(4096,5),/;
PRINT OCT 12,6 AND 3,OCT 12,6 OR 1,OCT 12,6 XOR 3,OCT 12,NOT 0 AND 77B,/;
PRINT IGR 8,ROT1(1),IGR 8,ROT2(3),/;
FINI(0);
SUBR SH(A,B) IS A LS B;
SUBR SH2(A,B) IS A RS B;
SUBR ROT1(A) IS (A LROT 4) AND 777B;
SUBR ROT2(A) IS (A RROT 1) AND 7
