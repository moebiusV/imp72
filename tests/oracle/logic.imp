PRINT IGR 3,R1(1,2),IGR 3,R1(2,1),IGR 3,R1(2,2),/;
PRINT IGR 3,R2(1,2),IGR 3,R2(2,1),IGR 3,R2(2,2),/;
PRINT OCT 12,12 AND 10,OCT 12,12 OR 3,OCT 12,12 XOR 10,OCT 12,L1(5),OCT 12,L2(1),/;
PRINT IGR 3,L3(6),IGR 3,L3(7),IGR 3,B1(3),IGR 3,B1(0),/;
FINI(0);
SUBR R1(A,B) IS (A<B)+10*(A>B)+100*(A=B);
SUBR R2(A,B) IS (A LE B)+10*(A GE B)+100*(A NE B);
SUBR L1(N) IS N LS 3;
SUBR L2(N) IS (N LS 4) OR (N LS 2);
SUBR L3(N) IS (N AND 1=>1 ELSE 2);
SUBR B1(N) IS (N=>7 ELSE 8)
%%
