NN IS 1 LONG;
X_5; Y_9;
SWAP(X,Y);
PRINT IGR 4,X,IGR 4,Y,/;
Z_ADD3(1,2,3);
PRINT IGR 4,Z,IGR 4,ADD3(X,Y,Z),IGR 4,TWICE(TWICE(3)),IGR 4,SQ(SQ(3)),/;
INCR(X); INCR(X);
PRINT IGR 4,X,IGR 4,COUNT(0),IGR 4,COUNT(0),IGR 4,COUNT(5),/;
FINI(0);
SUBR SWAP(A,B) IS (T_A; A_B; B_T; 0);
SUBR ADD3(A,B,C) IS A+B+C;
SUBR TWICE(A) IS A+A;
SUBR SQ(A) IS A*A;
SUBR INCR(A) IS (A_A+1; A);
SUBR COUNT(A) IS (NN_NN+A+1; NN)
%%
