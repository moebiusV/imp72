X IS REAL; Y IS REAL; Z IS REAL;
X_FLT(7)/FLT(4);
Y_FLT(5)*2.5;
Z_X+Y;
PRINT FLT 9.3,X,FLT 9.3,Y,FLT 9.3,Z,/;
PRINT IGR 6,FIX(X),IGR 6,FIX(Y),IGR 6,FIX(Z),IGR 6,FIX(0.0-Y),/;
Z_X*Y-1.5;
PRINT FLT 10.4,Z,FLT 10.4,0.0-Z,/;
Z_(Y-X)/4.0;
PRINT FLT 10.4,Z,/;
PRINT IGR 4,CMP1(X,Y),IGR 4,CMP1(Y,X),IGR 4,CMP2(X,X),IGR 4,CMP2(X,Y),/;
Z_(X*X-X)/FLT(2);
PRINT FLT 8.2,Z,IGR 6,FIX(Z*100.0),IGR 6,FIX(FLT(10)/4.0+1.0),/;
K_0; WHILE K<4 DO (Z_FLT(K)*0.25; PRINT FLT 7.2,Z; K_K+1);
PRINT /;
Z_0.0; K_0; WHILE K<8 DO (Z_Z+0.5; K_K+1);
PRINT FLT 8.3,Z,/;
FINI(0);
SUBR CMP1(A,B) IS (A<B=>1 ELSE 0);
SUBR CMP2(A,B) IS (A=B=>1 ELSE 0)
%%
