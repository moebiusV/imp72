A IS 12 LONG;
B IS 12 LONG;
(A[I]:=I*3+1) FOR I TO 11;
PRINT IGR 4,SUM(A,11),IGR 4,PICK(A,7),IGR 4,PICK(B,3),/;
FILL(B,11,5);
PRINT IGR 4,B[0],IGR 4,B[6],IGR 4,B[11],IGR 4,SUM(B,11),/;
COPY(B,A,11);
PRINT IGR 4,B[0],IGR 4,B[5],IGR 4,B[11],IGR 4,MAXOF(B,11),/;
FINI(0);
SUBR SUM(V,N) IS (S:=0; (S:=S+V[I]) FOR I TO N; S);
SUBR PICK(V,K) IS V[K];
SUBR FILL(V,N,X) IS (V[I]:=X*I FOR I TO N; 0);
SUBR COPY(D,S,N) IS (D[I]:=S[N-I] FOR I TO N; 0);
SUBR MAXOF(V,N) IS (M:=V[0]; (V[I]>M=>M:=V[I]) FOR I TO N; M)
%%
