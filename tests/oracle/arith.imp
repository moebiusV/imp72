PRINT IGR 5,7+3,IGR 5,7-3,IGR 5,7*3,IGR 5,7/3,IGR 5,0-7,/;
PRINT IGR 5,(0-7)/2,IGR 5,7/(0-2),IGR 5,(0-7)/(0-2),IGR 5,(0-7)*3,IGR 5,100-7*3,/;
PRINT IGR 5,2+3*4,IGR 5,(2+3)*4,IGR 5,10-2-3,IGR 5,100/10/5,IGR 5,2*3+4,/;
PRINT IGR 5,F1(7,3),IGR 5,F2(7,3),IGR 5,F3(20),IGR 5,F4(5),IGR 5,F5(1000),/;
PRINT IGR 8,123456,IGR 8,0-123456,IGR 8,98765432,IGR 3,5,IGR 2,12345,/;
FINI(0);
SUBR F1(A,B) IS A-B*2;
SUBR F2(A,B) IS A-(A/B)*B;
SUBR F3(N) IS (N+1)*(N-1);
SUBR F4(N) IS (R:=1; (R:=R*I) FOR I TO N; R);
SUBR F5(N) IS (S:=0; (S:=S+I*I) FOR I TO N; S)
%%
