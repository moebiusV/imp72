A IS 20 LONG;
B IS 20 LONG;
(A[I]:=I*I) FOR I TO 10;
(B[I]:=A[I]+A[10-I]) FOR I TO 10;
PRINT IGR 4,A[0],IGR 4,A[1],IGR 4,A[5],IGR 4,A[10],/;
PRINT IGR 4,B[0],IGR 4,B[3],IGR 4,B[5],IGR 4,B[10],/;
PRINT IGR 5,TOT(10),IGR 5,MX(10),IGR 5,IDX(10,B[5]),IGR 5,IDX(10,12345),/;
FINI(0);
SUBR TOT(N) IS (S:=0; (S:=S+B[I]) FOR I TO N; S);
SUBR MX(N) IS (M:=B[1]; I:=2; WHILE I LE N DO ((B[I]>M=>M:=B[I]); I:=I+1); M);
SUBR IDX(N,V) IS (K:=0; (B[I]=V=>(K=0=>K:=I)) FOR I TO N; K)
%%
