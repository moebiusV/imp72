PRINT STG 0,'FORMATS',/;
PRINT IGR 6,42,IGR 6,0-42,IGR 2,12345,IGR 0,77,/;
PRINT OCT 4,8,OCT 8,64,OCT 6,511,/;
PRINT STG 5,'ABCDEFGHIJ',STG 0,'|',STG 3,'AB',STG 0,'|',/;
PRINT TAB 5,'X',TAB 10,'Y',/;
PRINT STG 0,'ONE',/,STG 0,'TWO',/,/,STG 0,'FOUR',/;
(PRINT IGR 3,I,STG 0,':',IGR 4,I*I*I,/) FOR I TO 5;
PRINT STG 0,'IT''S',/;
FINI(0)
