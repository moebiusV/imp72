X:=53191;
PRINT OCT 12,X,OCT 12,X<8,4>,OCT 12,X<6,0>,OCT 12,X<3,9>,/;
Y:=X;
Y<8,4>:=377B;
PRINT OCT 12,Y,/;
Y<6,0>:=0;
PRINT OCT 12,Y,OCT 12,GETF(X),OCT 12,SETF(X,25B),/;
V IS 4 LONG;
V[2]:=123456B;
PRINT OCT 12,V[2]<9,3>,OCT 12,V[2]<3,0>,/;
FINI(0);
SUBR GETF(A) IS A<8,4>;
SUBR SETF(A,B) IS (X:=A; X<8,8>:=B; X)
%%
