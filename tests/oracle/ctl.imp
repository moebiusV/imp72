PRINT IGR 4,C1(1),IGR 4,C1(5),IGR 4,C1(10),IGR 4,C1(15),/;
PRINT IGR 4,C2(0),IGR 4,C2(1),IGR 4,C2(2),/;
PRINT IGR 4,C3(5),IGR 4,C3(20),IGR 4,C4(10),IGR 4,C4(37),/;
PRINT IGR 4,C5(3),IGR 4,C5(6),IGR 4,C6(4),IGR 4,C6(100),/;
FINI(0);
SUBR C1(N) IS (N<5=>1 ELSE (N<10=>2 ELSE (N<15=>3 ELSE 4)));
SUBR C2(N) IS (GO TO (L0,L1,L2) N; R_99; GO TO OUT; L0: R_10; GO TO OUT; L1: R_11; GO TO OUT; L2: R_12; OUT: R);
SUBR C3(N) IS (S_0; K_0; WHILE K<N DO (S_S+K; K_K+3); S);
SUBR C4(N) IS (S_0; K_N; WHILE K NE 0 DO (S_S+1; K_K/2); S);
SUBR C5(N) IS (S_0; ((S_S+I*J) FOR J TO N) FOR I TO N; S);
SUBR C6(N) IS (R_0; (R_R+1; R>N=>GO TO FIN) FOR I TO 10; FIN: R)
%%
