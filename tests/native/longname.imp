EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL INT remove(PTR);
EXTERNAL PTR memset(PTR, INT, SIZE);
NM IS 24 LONG;
EX IS 8 LONG;
FN IS 36 LONG;
A IS 1 LONG;
CCALL memset(LOC(NM),97,150);
CCALL memset(LOC(EX),98,50);
CCALL snprintf(LOC(FN),288,LOC('%s.%s'),LOC(NM),LOC(EX));
PRINT FILE NM.EX,IGR 3,42,/;
FINI(-1);
READ FILE NM.EX,IGR 3,A;
CCALL remove(LOC(FN));
A=42 => PRINT STG 0,'LONG NAME OK',/ ELSE PRINT STG 0,'LONG NAME BAD',/;
FINI(0)
%%
