PRINT IGR 0,FIB(15),IGR 5,PRIMES(100),IGR 5,GCDI(1071,462),IGR 6,COLLATZ(27),IGR 6,DIGSUM(98765),/;FINI(0);
SIEVE IS 200 LONG;
SUBR FIB(N) IS (A:=0; B:=1; (T:=A+B; A:=B; B:=T) FOR I TO N-1; A);
SUBR PRIMES(N) IS (
  (SIEVE[I]:=1) FOR I TO N;
  K:=0;
  P:=2;
  WHILE P LE N DO (
    SIEVE[P]=>(K:=K+1; Q:=P+P; WHILE Q LE N DO (SIEVE[Q]:=0; Q:=Q+P));
    P:=P+1);
  K);
SUBR GCDI(X,Y) IS (WHILE Y NE 0 DO (R:=X-(X/Y)*Y; X:=Y; Y:=R); X);
SUBR COLLATZ(N) IS (S:=0; WHILE N NE 1 DO (N:=((N AND 1)=>(3*N)+1 ELSE N RS 1); S:=S+1); S);
SUBR DIGSUM(N) IS (S:=0; WHILE N>0 DO (S:=S+N-(N/10)*10; N:=N/10); S)
%%
