PRINT IGR 0,FIB(15),IGR 5,PRIMES(100),IGR 5,GCDI(1071,462),IGR 6,COLLATZ(27),IGR 6,DIGSUM(98765),/;
SIEVE IS 200 LONG;
SUBR FIB(N) IS (A_0; B_1; (T_A+B; A_B; B_T) FOR I TO N-1; A);
SUBR PRIMES(N) IS (
  (SIEVE[I]_1) FOR I TO N;
  K_0;
  P_2;
  WHILE P LE N DO (
    SIEVE[P]=>(K_K+1; Q_P+P; WHILE Q LE N DO (SIEVE[Q]_0; Q_Q+P));
    P_P+1);
  K);
SUBR GCDI(X,Y) IS (WHILE Y NE 0 DO (R_X-(X/Y)*Y; X_Y; Y_R); X);
SUBR COLLATZ(N) IS (S_0; WHILE N NE 1 DO (N_((N AND 1)=>(3*N)+1 ELSE N RS 1); S_S+1); S);
SUBR DIGSUM(N) IS (S_0; WHILE N>0 DO (S_S+N-(N/10)*10; N_N/10); S)
%%
