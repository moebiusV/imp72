T,U,P ARE 1 LONG;
T:=CALLI(14B,0);
U:=CALLI(23B,0)/1000;
P:=CALLI(30B,0);
(T>1700000000) AND (T<4000000000) => PRINT STG 0,'UNIX TIME OK',/ ELSE PRINT STG 0,'UNIX TIME BAD',/;
(U-T<2) AND (T-U<2) => PRINT STG 0,'MILLISECONDS OK',/ ELSE PRINT STG 0,'MILLISECONDS BAD',/;
P>1 => PRINT STG 0,'PROCESS NUMBER OK',/ ELSE PRINT STG 0,'PROCESS NUMBER BAD',/;
FINI(0)
%%
