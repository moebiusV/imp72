H IS 3 LONG;
G IS 3 LONG;
K IS 3 LONG;
A IS 258 LONG;
B IS 4 LONG;
W IS 4 LONG;
I,N ARE 1 LONG;
I:=0;
WHILE I<258 DO (A[I]:=I; I:=I+1);
W[0]:=258; W[1]:=LOC(A); W[2]:=0;
INIT(0,17B,'DSK',H,'0');
ENTER(0,'CHAN2','TMP',0,0) => (PRINT STG 0,'ENTER FAILED',/; FINI(0));
OUTPUT(0,W) => PRINT STG 0,'DUMP OUTPUT FAILED',/;
CLOSE(0);
INIT(1,0,'DSK','0',G);
LOOKUP(1,'CHAN2','TMP',0,0) => (PRINT STG 0,'LOOKUP FAILED',/; FINI(0));
USETI(1,2) => PRINT STG 0,'USETI FAILED',/;
INPUT(1) => PRINT STG 0,'INPUT 1 FAILED',/;
PRINT STG 0,'BLOCK 2: ',IGR 0,G[2],STG 0,' BYTES',/;
INPUT(1) => PRINT STG 0,'INPUT 2 FAILED',/;
PRINT STG 0,'THEN: ',IGR 0,G[2],STG 0,' BYTES',/;
INPUT(1) => PRINT STG 0,'END OF FILE, STATUS ',OCT 0,GETSTS(1),/;
PRINT STG 0,'EOF BIT ',IGR 0,STATO(1,20000B),STG 0,' ',IGR 0,STATZ(1,20000B),/;
USETI(1,1);
PRINT STG 0,'AFTER USETI ',IGR 0,STATO(1,20000B),/;
INPUT(1);
PRINT STG 0,'BLOCK 1: ',IGR 0,G[2],STG 0,' BYTES',/;
CLOSE(1);
INIT(2,17B,'DSK','0',K);
LOOKUP(2,'CHAN2','TMP',0,0) => (PRINT STG 0,'LOOKUP 2 FAILED',/; FINI(0));
W[0]:=4; W[1]:=LOC(B); W[2]:=0;
INPUT(2,W) => PRINT STG 0,'DUMP INPUT FAILED',/;
PRINT STG 0,'WORDS ',IGR 0,B[0],STG 0,' ',IGR 0,B[1],STG 0,' ',IGR 0,B[2],STG 0,' ',IGR 0,B[3],/;
W[0]:=300; W[1]:=LOC(A);
INPUT(2,W) => PRINT STG 0,'SHORT, EOF BIT ',IGR 0,STATO(2,20000B),/;
SETSTS(2,0);
PRINT STG 0,'CLEARED ',IGR 0,STATO(2,20000B),/;
RENAME(2,0,0);
CLOSE(2);
FINI(0)
%%
