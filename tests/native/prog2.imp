V IS 100 LONG;
SUBR FILL(N) IS ((V[I]_I*I) FOR I TO N; 0);
SUBR TOTAL(N) IS (T_0; (T_T+V[I]) FOR I TO N; T);
SUBR FACT(N) IS (R_1; K_N; WHILE K>1 DO (R_R*K; K_K-1); R);
SUBR GCD(A,B) IS (X_A; Y_B; WHILE Y NE 0 DO (Z_X-(X/Y)*Y; X_Y; Y_Z); X);
SUBR TWICE(A) IS A+A;
SUBR CALLER(A) IS TWICE(A+1)+TWICE(7);
SUBR BITS(A) IS ((A LS 3) OR (A RS 1)) AND 255;
SUBR REM(A,B) IS A//B
%%
