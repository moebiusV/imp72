V IS 100 LONG;
SUBR FILL(N) IS ((V[I]:=I*I) FOR I TO N; 0);
SUBR TOTAL(N) IS (T:=0; (T:=T+V[I]) FOR I TO N; T);
SUBR FACT(N) IS (R:=1; K:=N; WHILE K>1 DO (R:=R*K; K:=K-1); R);
SUBR GCD(A,B) IS (X:=A; Y:=B; WHILE Y NE 0 DO (Z:=X-(X/Y)*Y; X:=Y; Y:=Z); X);
SUBR TWICE(A) IS A+A;
SUBR CALLER(A) IS TWICE(A+1)+TWICE(7);
SUBR BITS(A) IS ((A LS 3) OR (A RS 1)) AND 255;
SUBR REM(A,B) IS A//B
%%
