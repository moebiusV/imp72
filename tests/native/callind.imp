BUF IS 64 LONG;
BUF[1]:=77; BUF[2]:=88;
PRINT STG 0,'THE WORD AT THE ADDRESS A CALL RETURNS ',IGR 0,[AD(2)],/;
PRINT STG 0,'AND ONE ',IGR 0,[AD(1)]+1,/;
[AD(3)]:=99;
PRINT STG 0,'STORED THROUGH IT ',IGR 0,BUF[3],/;
P:=BYTEP [AD(1)]<7,36>;
PRINT STG 0,'A BYTE POINTER TO IT ',IGR 0,P-LOC(BUF),/;
FINI(0);
SUBR AD(D) IS LOC(BUF)+(8*D)
%%
