PRINT IGR 0,TEST1(5),IGR 4,TEST2(2),IGR 4,TEST3(7),IGR 4,TEST4(3),/;FINI(0);
TABLE IS 5 LONG;
LET SEVEN=7, BF=TABLE[1];
SUBR TEST1(N) IS (GO TO (A1,A2,A3) N-3; X:=0; GO TO DONE; A1: X:=100; GO TO DONE; A2: X:=200; GO TO DONE; A3: X:=300; DONE: X);
SUBR TEST2(N) IS (N+SEVEN);
SUBR TEST3(N) IS (R:=0; (R:=R+I) FOR I IN 1,2,N; (R:=R+1000) FOR I FROM 2; R);
SUBR TEST4(N) IS (TABLE[0]:=N; BF:=N*2; TABLE[2]:=TABLE[0]+BF; (N=3=>TABLE[2] ELSE 0))
%%
