X IS REAL;
X_FLT(7)/FLT(4);
PRINT FLT 8.3,X,/;
PRINT FLT 0.2,X,/;
PRINT FLT -12.4,X,/;
PRINT OCT 6,64,IGR 5,-12,STG 4,'ABCDEFG',/;
PRINT TAB 10,'X',TAB 4,'Y',/;
PRINT FILE 'IOTEST'.'TMP',IGR 3,42,IGR 4,-7,/,STG 0,'LINE TWO',/;
FINI(-1);
READ FILE 'IOTEST'.'TMP',IGR 3,A,IGR 4,B;
READ /;
READ STG 0,S;
PRINT DEVICE 'TTY:',IGR 0,A,IGR 4,B,/;
PRINT IGR 0,A+B,/;FINI(0)
%%
