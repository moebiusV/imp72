EXTERNAL INT puts(PTR);
EXTERNAL INT printf(PTR, ...);
EXTERNAL CHAR atoi(PTR);
EXTERNAL UCHAR abs(INT);
EXTERNAL SHORT labs(LONG);
EXTERNAL USHORT strtol(PTR, PTR, INT);
EXTERNAL INT toupper(CHAR);
EXTERNAL INT tolower(UCHAR);
EXTERNAL INT isalpha(SHORT);
EXTERNAL INT isdigit(USHORT);
EXTERNAL ULONG strtoul(PTR, PTR, INT);
EXTERNAL LONG atol(PTR);
EXTERNAL LLONG llabs(LLONG);
EXTERNAL LLONG strtoll(PTR, PTR, INT);
EXTERNAL ULLONG strtoull(PTR, PTR, INT);
EXTERNAL INT rand(VOID);
EXTERNAL VOID srand(UINT);
CCALL printf('atoi(200) as CHAR = %d%c',CCALL atoi('200'),10);
CCALL printf('abs(-300) as UCHAR = %d%c',CCALL abs(0-300),10);
CCALL printf('labs(-40000) as SHORT = %d%c',CCALL labs(0-40000),10);
CCALL printf('strtol(70000) as USHORT = %d%c',CCALL strtol('70000',0,10),10);
CCALL printf('toupper of a CHAR 353 = %d%c',CCALL toupper(353),10);
CCALL printf('tolower of a UCHAR 321 = %d%c',CCALL tolower(321),10);
CCALL isalpha(65+65536) NE 0 => CCALL puts('isalpha of a SHORT 65+65536 is true') ELSE CCALL puts('wrong: isalpha');
CCALL isdigit(48+65536) NE 0 => CCALL puts('isdigit of a USHORT 48+65536 is true') ELSE CCALL puts('wrong: isdigit');
R:=CCALL strtoul('4000000000',0,10);
R=4000000000 => CCALL puts('a ulong result is zero extended') ELSE CCALL puts('wrong: a ulong result');
R:=CCALL atol('-5');
R=(0-5) => CCALL puts('a long result is sign extended') ELSE CCALL puts('wrong: a long result');
R:=CCALL llabs(0-5000000000);
R=5000000000 => CCALL puts('llabs of a LLONG') ELSE CCALL puts('wrong: llabs');
R:=CCALL strtoll('-5000000000',0,10);
R=(0-5000000000) => CCALL puts('a llong result') ELSE CCALL puts('wrong: a llong result');
R:=CCALL strtoull('18446744073709551615',0,10);
R=(0-1) => CCALL puts('a ullong result is the whole word') ELSE CCALL puts('wrong: a ullong result');
CCALL srand(1);
R:=CCALL rand();
R GE 0 => CCALL puts('rand() takes no argument') ELSE CCALL puts('wrong: rand');
FINI(0)
%%
