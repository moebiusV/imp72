S,T,U,V,W,K ARE 1 LONG;
S:=CSNEW('HELLO');
T:=CSNEW(', WORLD');
PRINT STG 0,'LEN ',IGR 0,CSLEN(S),STG 0,' ',IGR 0,CSLEN(T),/;
U:=CSCAT(S,T);
CSPRINT(U); PRINT /;
PRINT STG 0,'LEN ',IGR 0,CSLEN(U),STG 0,' CMP ',IGR 0,CSCMP(S,U),STG 0,' ',IGR 0,CSCMP(U,S),STG 0,' ',IGR 0,CSCMP(S,S),/;
V:=CSSUB(U,7,5);
CSPRINT(V); PRINT STG 0,' AT ',IGR 0,CSFIND(U,V),STG 0,' AGAIN ',IGR 0,CSFIND(U,S),/;
K:=CSNEW('XYZ');
PRINT STG 0,'FIND ',IGR 0,CSFIND(U,K),STG 0,' EMPTY ',IGR 0,CSFIND(U,CSNEW('')),/;
S:=CSAPP(S,CSNEW('!!'));
CSPRINT(S); PRINT STG 0,' ',IGR 0,CSLEN(S),/;
W:=CSSUB(U,0-5,100);
PRINT STG 0,'CLIPPED ',IGR 0,CSLEN(W),/;
W:=CSMAKE(CSBYTES(U),3);
CSPRINT(W); PRINT STG 0,' COPY ',IGR 0,CSLEN(CSCOPY(W)),/;
PRINT STG 0,'UTF8 ',IGR 0,CSLEN(CSNEW("caf\xC3\xA9")),/;
CSFREE(S); CSFREE(T); CSFREE(U); CSFREE(V); CSFREE(W);
FINI(0)
%%
