W,B ARE 1 LONG;
PRINT OCT 0,SIXBIT('ABC'),/;
W:=ASCII(SIXBIT('Hello'));
PRINT STG 0,W,/;
PRINT IGR 0,RAD50('ABC',0),/;
PRINT IGR 0,RAD50('ABC',5),/;
PRINT IGR 0,RADX50(SIXBIT('ABC'),0),/;
W:=RAD50('A.B$%',3);
PRINT IGR 0,W,/;
B:=99;
W:=ASCI50(W,B);
PRINT STG 0,W,STG 0,' ',IGR 0,B,/;
W:=SIX50(RAD50('A.B$%',3),B);
PRINT OCT 0,W,STG 0,' ',IGR 0,B,/;
FINI(0)
%%
