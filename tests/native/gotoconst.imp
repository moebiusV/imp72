PRINT IGR 0,T(0),IGR 4,T(1),IGR 4,T(2),IGR 4,T(3),IGR 4,T(4),/;
PRINT IGR 0,C0(),IGR 4,C1(),IGR 4,C2(),IGR 4,C3(),IGR 4,C9(),/;
A:=1; B:=1; N:=0;
(A=1) AND (B=1) => N:=9;
PRINT IGR 0,N,/;
N:=0; (A=2) OR (B=5) => N:=9;
PRINT IGR 0,N,/;
N:=0; (A=2) OR (B=1) => N:=9;
PRINT IGR 0,N,/;
N:=0; (A=1) AND (B=2) => N:=9;
PRINT IGR 0,N,/;
N:=0; (A=1) AND (B=2) => (N:=9) ELSE (N:=7);
PRINT IGR 0,N,/;
N:=0; WHILE (A=1) AND (B=1) DO (N:=N+1; N=3=>A:=0);
PRINT IGR 0,N,/;
A:=1; N:=0; WHILE (A=1) OR (B=0) DO (N:=N+1; N=4=>A:=0);
PRINT IGR 0,N,/;
A:=1; N:=0; (N:=N+1; N=5=>A:=0) UNTIL (A=0) OR (B=0);
PRINT IGR 0,N,/;
FINI(0);
SUBR T(N) IS (GO TO (L0,L1,L2) N; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V);
SUBR C0() IS (GO TO (L0,L1,L2) 0; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V);
SUBR C1() IS (GO TO (L0,L1,L2) 1; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V);
SUBR C2() IS (GO TO (L0,L1,L2) 2; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V);
SUBR C3() IS (GO TO (L0,L1,L2) 3; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V);
SUBR C9() IS (GO TO (L0,L1,L2) 9; V:=-1; GO TO D; L0: V:=10; GO TO D; L1: V:=11; GO TO D; L2: V:=12; D: V)
%%
