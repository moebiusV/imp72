EXTERNAL INT puts(PTR);
EXTERNAL INT printf(PTR, ...);
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL DOUBLE ldexp(DOUBLE, INT);
EXTERNAL DOUBLE frexp(DOUBLE, PTR);
EXTERNAL DOUBLE strtod(PTR, PTR);
EXTERNAL FLOAT ldexpf(FLOAT, INT);
EXTERNAL FLOAT copysignf(FLOAT, FLOAT);
EXTERNAL SIZE strlen(PTR);
EXTERNAL LONG labs(LONG);
EXTERNAL INT abs(INT);
EXTERNAL INT close(INT);
EXTERNAL INT toupper(INT);
EXTERNAL UINT htonl(UINT);
EXTERNAL PTR malloc(SIZE);
EXTERNAL PTR memcpy(PTR, PTR, SIZE);
EXTERNAL VOID free(PTR);
EXTERNAL INT getpid();
X IS REAL;
Y IS REAL;
BUF IS 8 LONG;
SCALE IS REAL;
E IS 2 LONG;
X:=CCALL ldexp(1.5,4);
CCALL printf('ldexp(1.5,4) = %.6f%c',X,10);
Y:=CCALL ldexp(1.0,40);
CCALL printf('ldexp(1,40) = %.1f%c',Y,10);
X:=CCALL ldexp(3,2);
CCALL printf('ldexp(3,2) = %.1f, from an integer%c',X,10);
X:=CCALL strtod('3.25',0);
CCALL printf('strtod = %.2f%c',X,10);
X:=CCALL ldexpf(0.75,3);
CCALL printf('ldexpf(0.75,3) = %.4f%c',X,10);
X:=CCALL copysignf(2.5,0-1.0);
CCALL printf('copysignf(2.5,-1) = %.1f%c',X,10);
N:=CCALL snprintf(LOC(BUF),64,'v=%.2f i=%d s=%s',2.5,42,LOC('ok'));
CCALL printf('%s (%d characters)%c',LOC(BUF),N,10);
CCALL printf('a variadic call with a REAL: %.3f and %d%c',X+0.5,7,10);
CCALL printf('strlen = %d%c',CCALL strlen('hello world'),10);
CCALL printf('labs(-5) = %d, abs(-7) = %d%c',CCALL labs(0-5),CCALL abs(0-7),10);
R:=CCALL close(0-1);
R=(0-1) => CCALL puts('an int result of -1 stays -1') ELSE CCALL puts('wrong: an int result of -1');
R:=CCALL toupper('a');
CCALL printf('toupper = %d%c',R,10);
R:=CCALL htonl(4294967295);
R=4294967295 => CCALL puts('a uint result is zero extended') ELSE CCALL puts('wrong: a uint result');
P:=CCALL malloc(16);
P=0 => CCALL puts('malloc failed');
CCALL memcpy(P,'copied',7);
CCALL printf('%s%c',P,10);
CCALL free(P);
CCALL printf('scale(5) = %.1f%c',SCALE(5),10);
X:=CCALL frexp(40.0,LOC(E));
CCALL printf('frexp(40) = %.4f * 2^%d%c',X,E,10);
CCALL getpid()>0 => CCALL puts('getpid() is positive');
FINI(0);
SUBR SCALE(A) IS (
   X IS REAL;
   X:=CCALL ldexp(A,3);
   X)
%%
