CNT:=0;
PRINT IGR 0,F(1),IGR 0,F(2),IGR 0,F(3),/;
PRINT IGR 0,G(),IGR 3,G(),IGR 3,G(),/;
PRINT IGR 0,F(7),STG 0,' ',IGR 0,F(8)+F(9),/;
X:=PRINT IGR 0,F(1),IGR 0,F(2);
PRINT /,IGR 0,X,/;
PRINT IGR 0,F(PR2(5)),/;
FINI(0);
SUBR F(A) IS (PRINT IGR 0,A,STG 0,'<'; PRINT IGR 0,A; A);
SUBR PR2(Q) IS (PRINT IGR 0,Q,STG 0,'>',IGR 0,F(Q+1); Q);
SUBR G() IS (CNT:=CNT+1; CNT)
%%
