CCALL printf('%d %d %d %d%c',MAUVE,TEAL,GREEN+BLUE,MASK,10);
CCALL printf('%d %d %d%c',SIZEOF(later),OFFSETOF(later,m),SIZEOF(expr_len),10);
CCALL printf('%d%c',CCALL strlen('abcd'),10)
