LET F_F=2;
STRUCT pt (INT x, INT y);
STRUCT cpx (DOUBLE re, DOUBLE im);
STRUCT line (pt a, pt b, CHAR name[20], UCHAR flags[6], PTR user, PTR cb);
STRUCT wrap (cpx c, line l);
