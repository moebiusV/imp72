# DECLARATIONS FOR IMP72 FROM PREPROCESSED C TEXT, MADE BY IMP-CIMPORT (FUNCTIONS 31, STRUCTURES 11, CONSTANTS 14; THE LAYOUTS OF THE STRUCTURES ARE COMPUTED BY IMP72 FOR THE MACHINE THE PROGRAM IS COMPILED FOR) #
LET RED=0;
LET GREEN=5;
LET BLUE=6;
