#!/bin/sh
# imp72c: compile IMP72 programs to native code.
#
#   imp72c [-S | -c] [-o OUT] [-s LETTERS] FILE.imp ...
#
# Each FILE.imp is read with the syntax of the compiler (decus/syntax.imc), made
# into pcc IR by stage 0 (imp72s0), into assembly by cc1 (pass 2 of pcc), and
# assembled by cc and linked with the runtime library (build/lib/libimp72.a).
# -C uses the C back end (tools/ir2c.c, the host's C compiler) instead of pcc;
# -S then stops at C.  Where pcc's cc1 was not built (every host but amd64) the
# C back end is the only one.
# -S stops at assembly, -c at the object file (the default output names are
# FILE.s and FILE.o), else an executable FILE is made.  -s gives switches to
# the stage 0 driver (for listings and dumps).
#
# IMP72 passes arguments by reference, so a SUBR is a C function of pointers
# to its arguments and a C program can call it.  Variables are common symbols.
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
if [ -x "$root/stage0/imp72s0" ]; then             # in the source tree
    s0=${IMP72S0:-$root/stage0/imp72s0}
    cc1=${CC1:-$root/build/pcc/cc/ccom/cc1}
    syntax=${IMP72SYNTAX:-$root/decus/syntax.imc}
    ffi=${IMP72FFI:-$root/lib/ffi.imc}
    ir2c=${IR2C:-$root/build/bin/ir2c}
    lib=${IMP72LIB:-$root/build/lib/libimp72.a}
else                                               # installed: PREFIX/bin/imp72c
    s0=${IMP72S0:-$root/lib/imp72/imp72s0}
    cc1=${CC1:-$root/lib/imp72/cc1}
    syntax=${IMP72SYNTAX:-$root/share/imp72/syntax.imc}
    ffi=${IMP72FFI:-$root/share/imp72/ffi.imc}
    ir2c=${IR2C:-$root/lib/imp72/ir2c}
    lib=${IMP72LIB:-$root/lib/imp72/libimp72.a}
fi
# the back end: pcc where it was built (amd64), else the C one
if [ -x "$cc1" ]; then backend=${IMP72BACKEND:-pcc}; else backend=c; fi
stop=x out= sw=
while [ $# -gt 0 ]; do
    case $1 in
    -C) backend=c ;;
    -S) stop=S ;;
    -c) stop=o ;;
    -o) out=$2; shift ;;
    -s) sw=$2; shift ;;
    -*) echo "imp72c: unknown option $1" >&2; exit 2 ;;
    *) break ;;
    esac
    shift
done
[ $# -ge 1 ] || { echo "usage: imp72c [-S|-c] [-o OUT] [-s LETTERS] FILE.imp ..." >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/imp72c.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
set -e
first=$1
base=${first%.imp}
if [ -n "$sw" ]; then
    "$s0" -s "$sw" -c "$tmp/p.ir" "$syntax" "$ffi" "$@" >&2
else
    "$s0" -c "$tmp/p.ir" "$syntax" "$ffi" "$@" 2>"$tmp/err" || { grep -v "^SYNTAX BOOTSTRAPPED" "$tmp/err" >&2; exit 1; }
    grep -v "^SYNTAX BOOTSTRAPPED\|ADVISORY - PRODUCTION DUPLICATES" "$tmp/err" >&2 || true
fi
if [ "$backend" = c ]; then
    # the C back end: the IR as C, for the host's compiler
    "$ir2c" <"$tmp/p.ir" >"$tmp/p.c"
    if [ $stop = S ]; then
        cp "$tmp/p.c" "${out:-$base.c}"
    elif [ $stop = o ]; then
        cc -w -c -o "${out:-$base.o}" "$tmp/p.c"
    else
        cc -w -c -o "$tmp/p.o" "$tmp/p.c"
        cc -o "${out:-$base}" "$tmp/p.o" "$lib"
    fi
    exit 0
fi
"$cc1" <"$tmp/p.ir" >"$tmp/p.s"
if [ $stop = S ]; then
    cp "$tmp/p.s" "${out:-$base.s}"
elif [ $stop = o ]; then
    cc -c -o "${out:-$base.o}" -x assembler "$tmp/p.s"
else
    cc -c -o "$tmp/p.o" -x assembler "$tmp/p.s"
    cc -no-pie -o "${out:-$base}" "$tmp/p.o" "$lib"
fi
