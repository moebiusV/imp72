#!/bin/sh
# imp72c: compile IMP72 programs to native code.
#
#   imp72c [-S | -c] [-o OUT] [-s LETTERS] FILE.imp ...
#
# Each FILE.imp is read with the syntax of the compiler (decus/syntax.imc), made
# into pcc IR by stage 0 (imp72s0), into assembly by cc1 (pass 2 of pcc), and
# assembled by cc.  -S stops at assembly, -c at the object file (the default
# output names are FILE.s and FILE.o); the others are for the stage 0 driver.
#
# IMP72 passes arguments by reference, so a SUBR is a C function of pointers
# to its arguments and a C program can call it.  Variables are common symbols.
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
s0=${IMP72S0:-$root/stage0/imp72s0}
cc1=${CC1:-$root/build/pcc/cc/ccom/cc1}
syntax=${IMP72SYNTAX:-$root/decus/syntax.imc}
stop=o out= sw=
while [ $# -gt 0 ]; do
    case $1 in
    -S) stop=S ;;
    -c) stop=o ;;
    -o) out=$2; shift ;;
    -s) sw=$2; shift ;;
    -*) echo "imp72c: unknown option $1" >&2; exit 2 ;;
    *) break ;;
    esac
    shift
done
[ $# -ge 1 ] || { echo "usage: imp72c [-S|-c] [-o OUT] [-s LETTERS] FILE.imp ..." >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/imp72c.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
set -e
first=$1
base=${first%.imp}
if [ -n "$sw" ]; then
    "$s0" -s "$sw" -c "$tmp/p.ir" "$syntax" "$@" >&2
else
    "$s0" -c "$tmp/p.ir" "$syntax" "$@" 2>"$tmp/err" || { grep -v "^SYNTAX BOOTSTRAPPED" "$tmp/err" >&2; exit 1; }
    grep -v "^SYNTAX BOOTSTRAPPED\|ADVISORY - PRODUCTION DUPLICATES" "$tmp/err" >&2 || true
fi
"$cc1" <"$tmp/p.ir" >"$tmp/p.s"
if [ $stop = S ]; then
    cp "$tmp/p.s" "${out:-$base.s}"
else
    cc -c -o "${out:-$base.o}" -x assembler "$tmp/p.s"
fi
