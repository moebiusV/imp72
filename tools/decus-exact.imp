#DECUS-EXACT.IMP -- EXACT 36 BIT FILES OF THE DECUS LIB 3 TAPE FOR DECUS/'S BINARIES.  RUN BY TOOLS/IMPTOOL.SH.

    DECUS-EXACT TAPE OUT_DIR [DECUS_DIR]

THE ARCHIVE'S EXTRACTED FILES (DECUS/IMP.SHR, ...) KEEP 35 BITS OF EACH WORD; THE TAPE IMAGE (HTTPS://PDP-10.TRAILING-EDGE.COM/TAPES/DECUSLIB10-03.TAP.BZ2, SIMH .TAP, CORE-DUMP FRAMES) HAS ALL 36.
THE EXTRACTED FILE SAYS WHAT THE WORDS ARE EXCEPT FOR THE LAST BIT, SO THE WORDS ARE FOUND IN THE TAPE AND THEIR LAST BIT IS READ FROM THERE.  OUT_DIR GETS NAME.WORDS (5 FRAMES TO THE WORD, THE FORM
TOOLS/PDP10TAP.IMP WRITES TO TAPE) FOR IMP.LOW, IMP.SHR AND IMPLIB.LIB.  DECUS_DIR (DEFAULT decus, FROM THE DIRECTORY THE TOOL IS RUN IN: THE ROOT OF THE TREE) HAS THE EXTRACTED FILES.#

BUF,N,WORD,NA,I,W,NW,LOSSY,NL,OUTP,OUTN,DECUS,DIRN,POS ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
((NA<3) OR (NA>4)) => (CCALL write(2,LOC('usage: decus-exact TAPE OUT_DIR [DECUS_DIR]'),43); PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));
DECUS:=LOC('decus'); NA=4 => DECUS:=CCALL strdup(ARG(3));
TAPEWORDS(ARG(1));
MKDIRS(ARG(2));
DONE(LOC('imp.low')); DONE(LOC('imp.shr')); DONE(LOC('implib.lib'));
CCALL exit(0);

EXTERNAL INT printf(PTR, ...);
EXTERNAL INT sprintf(PTR, PTR, ...);
# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

# A MESSAGE ON THE STANDARD ERROR, AND THE END WITH STATUS 1 #
SUBR DIE(M,A) IS (
 CCALL write(2,M,CCALL strlen(M)); A NE 0 => (CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A)));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

# THE FILE INTO BUF, N BYTES (AND ZEROS AFTER THEM) #
SUBR SLURP(PATH) IS (
 F ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); N:=CCALL ftell(F); CCALL fseek(F,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => CCALL fread(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH);
 CCALL fclose(F);
 0);

# THE DIRECTORY P AND THE ONES ABOVE IT, AS MKDIR -P #
SUBR MKDIRS(P) IS (
 J,L,C ARE LOCAL;
 L:=CCALL strlen(P); J:=1;
 WHILE J<(L+1) DO (
    C:=GETB(P,J);
    ((C=47) OR (C=0)) => (PUTB(P,J,0); CCALL mkdir(P,511); PUTB(P,J,C));
    J:=J+1);
 0);

# THE WORDS OF THE TAPE IN W (5 FRAMES TO A WORD, TAPE MARKS AND PADS SKIPPED): NW OF THEM #
SUBR TAPEWORDS(PATH) IS (
 K,Z,R,X,L,E ARE LOCAL;
 SLURP(PATH);
 W:=CCALL calloc((N/5)+16,8); NW:=0;
 K:=0;
 WHILE K<(N-3) DO (
    Z:=GETB(BUF,K) OR (GETB(BUF,K+1) LS 8) OR (GETB(BUF,K+2) LS 16) OR (GETB(BUF,K+3) LS 24);
    K:=K+4;
    Z NE 0 => (
       E:=(Z<(N-K) => Z ELSE N-K);          # (THE RECORD, AS FAR AS THE FILE HAS IT) #
       R:=0;
       WHILE R<(E-4) DO (
          X:=GETB(BUF,K+R); X:=(X LS 8) OR GETB(BUF,K+R+1); X:=(X LS 8) OR GETB(BUF,K+R+2); X:=(X LS 8) OR GETB(BUF,K+R+3);
          X:=(X LS 4) OR (GETB(BUF,K+R+4) AND 15);
          [W+(8*NW)]:=X; NW:=NW+1; R:=R+5);
       K:=K+Z+(Z AND 1)+4));
 0);

# THE WORDS OF AN EXTRACTED FILE (7 BITS OF A BYTE, THE LAST BIT FROM THE TOP BIT OF THE FIFTH) IN LOSSY: NL OF THEM #
SUBR ARCHIVE(PATH) IS (
 J,K,X ARE LOCAL;
 SLURP(PATH);
 NL:=N/5; LOSSY:=CCALL calloc(NL+16,8); J:=0;
 WHILE J<NL DO (
    X:=0; K:=0;
    WHILE K<5 DO (X:=(X LS 7) OR (GETB(BUF,(5*J)+K) AND 127); K:=K+1);
    [LOSSY+(8*J)]:=((X LS 1) OR (GETB(BUF,(5*J)+4) RS 7)); J:=J+1);
 0);

# DO THE 4 WORDS OF THE TAPE AT K MATCH THE 4 OF THE FILE AT I, ALL BUT THE LAST BIT #
SUBR SAME4(K,I) IS (
 J,OK ARE LOCAL;
 OK:=1; J:=0;
 WHILE J<4 DO (
    (([W+(8*(K+J))]) RS 1) NE (([LOSSY+(8*(I+J))]) RS 1) => OK:=0;
    J:=J+1);
 OK);

# THE WORDS OF THE FILE NAME, FOUND IN THE TAPE; THEY GO TO OUTP, OUTN OF THEM #
SUBR EXACT(NAME) IS (
 K,I,S,J,F ARE LOCAL;
 NL<4 => DIE(LOC('not on the tape: its first words'),NAME);
 S:=0-1; K:=0;
 WHILE S<0 DO (K<(NW-3) => (SAME4(K,0) NE 0 => S:=K ELSE K:=K+1) ELSE S:=NW);        # (S: THE START; NW IF THERE IS NONE) #
 S=NW => DIE(LOC('its first words are not on the tape'),NAME);
 POS:=S; I:=0; OUTN:=0;
 OUTP:=CCALL calloc(NL+16,8);
 WHILE I<NL DO (
    ((POS<NW) AND ((([W+(8*POS)]) RS 1)=(([LOSSY+(8*I)]) RS 1))) => (
        [OUTP+(8*OUTN)]:=[W+(8*POS)]; OUTN:=OUTN+1; POS:=POS+1; I:=I+1; GO TO EX);
    # A BLOCK BOUNDARY: THE NEXT WORDS OF THE FILE ARE FURTHER ON (A HEADER BETWEEN) #
    (I+4)>NL => DIE(LOC('lost the file'),NAME);
    F:=0-1; J:=POS;
    WHILE F<0 DO (((J<(POS+200)) AND (J<(NW-3))) => (SAME4(J,I) NE 0 => F:=J ELSE J:=J+1) ELSE F:=NW);
    F=NW => DIE(LOC('lost the file'),NAME);
    POS:=F;
    EX: 0);
 0);

# ONE OF THE FILES: THE EXACT WORDS TO OUT_DIR/NAME.WORDS, AND A LINE OF COUNTS #
SUBR DONE(NAME) IS (
 PATH,OUT,F,J,ODD,X,B ARE LOCAL;
 PATH:=CCALL calloc(CCALL strlen(DECUS)+CCALL strlen(NAME)+4,1);
 CCALL sprintf(PATH,LOC('%s/%s'),DECUS,NAME);
 ARCHIVE(PATH);
 EXACT(NAME);
 OUT:=CCALL calloc(CCALL strlen(ARG(2))+CCALL strlen(NAME)+16,1);
 CCALL sprintf(OUT,LOC('%s/%s.words'),ARG(2),NAME);
 B:=CCALL calloc((OUTN*5)+16,1); ODD:=0; J:=0;
 WHILE J<OUTN DO (
    X:=[OUTP+(8*J)];
    PUTB(B,5*J,(X RS 28) AND 255); PUTB(B,(5*J)+1,(X RS 20) AND 255); PUTB(B,(5*J)+2,(X RS 12) AND 255);
    PUTB(B,(5*J)+3,(X RS 4) AND 255); PUTB(B,(5*J)+4,X AND 15);
    ODD:=ODD+(X AND 1); J:=J+1);
 F:=CCALL fopen(OUT,LOC('wb'));
 F=0 => DIE(LOC('cannot write'),OUT);
 CCALL fwrite(B,1,OUTN*5,F) NE (OUTN*5) => DIE(LOC('cannot write'),OUT);
 CCALL fclose(F);
 CCALL printf(LOC('%s: %d words, %d with the last bit set'),NAME,OUTN,ODD);
 CCALL putchar(10);
 0)
%%
