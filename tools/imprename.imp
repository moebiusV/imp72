#IMPRENAME.IMP -- THE PART OF NM AND OBJCOPY THAT THE BUILD OF THE COMPILERS USES (TOOLS/DIRECT.SH), FOR THE OBJECT FILES OF EVERY SYSTEM: ELF (32 AND 64 BIT, LITTLE AND BIG ENDIAN) AND MACH-O (64 BIT).  NO BINUTILS, NO LLVM-OBJCOPY.
THE SEED COMPILES THIS.

    IMPRENAME -D OBJECT            PRINT THE NAMES OF THE GLOBAL SYMBOLS THE OBJECT DEFINES IN ITS TEXT, DATA AND BSS, AND ITS COMMON SYMBOLS (NM'S T, D, B AND C), ONE A LINE, WITHOUT MACH-O'S FIRST UNDERSCORE
    IMPRENAME -F MAP OBJECT OUT    WRITE OBJECT TO OUT WITH THE SYMBOLS OF MAP RENAMED: A LINE "OLD NEW" FOR EACH, A SYMBOL OLD, DEFINED OR NOT, IS NEW

THE NEW NAMES ARE WRITTEN AT THE END OF THE FILE AND THE STRING TABLE OF THE SYMBOLS IS MADE TO POINT THERE; NOTHING ELSE IN THE OBJECT CHANGES (RELOCATIONS NAME SYMBOLS BY NUMBER).  THE BYTES OF AN OBJECT ARE READ
AND WRITTEN ONE AT A TIME, SO THAT THE ORDER OF BYTES OF THE MACHINE THIS RUNS ON DOES NOT MATTER.  NAMES ARE SIGNIFICANT TO EIGHT CHARACTERS IN IMP: THEY ARE SHORT HERE.#

OLDN IS 20000 LONG;
NEWN IS 20000 LONG;
HT IS 65536 LONG;
ZR IS 2 LONG;
NMAP,BUF,BSZ,STRS,NSTRS,CAPS,BE,IS64,SHOFF,SHENT,SHNUM,WORD,NA,MACHO ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
ZR[0]:=0; ZR[1]:=0;
NA=3 => CCALL strcmp(ARG(1),LOC('-d'))=0 => (SLURP(ARG(2)); BE:=0; MACHO:=(BSZ>3 => (R32(BUF)=4277009103 => 1 ELSE 0) ELSE 0);
                                              MACHO NE 0 => MACHLIST(0) ELSE ELFLIST(0);
                                              CCALL exit(0));
NA=5 => CCALL strcmp(ARG(1),LOC('-f'))=0 => (READMAP(ARG(2)); SLURP(ARG(3)); BE:=0; MACHO:=(BSZ>3 => (R32(BUF)=4277009103 => 1 ELSE 0) ELSE 0);
                                              MACHO NE 0 => MACHREN(ARG(4)) ELSE ELFREN(ARG(4));
                                              CCALL exit(0));
CCALL write(2,LOC('usage: imprename -d OBJECT | imprename -f MAP OBJECT OUT'),58);
PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1);
CCALL exit(2);


# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

# THE NUMBERS OF 2, 4 AND 8 BYTES AT P, BIG ENDIAN IF BE, ELSE LITTLE ENDIAN #
SUBR R16(P) IS (
 BE NE 0 => ((GETB(P,0) LS 8) OR GETB(P,1)) ELSE ((GETB(P,1) LS 8) OR GETB(P,0)));

SUBR R32(P) IS (
 BE NE 0 => ((GETB(P,0) LS 24) OR (GETB(P,1) LS 16) OR (GETB(P,2) LS 8) OR GETB(P,3))
 ELSE ((GETB(P,3) LS 24) OR (GETB(P,2) LS 16) OR (GETB(P,1) LS 8) OR GETB(P,0)));

SUBR R64(P) IS (
 BE NE 0 => ((R32(P) LS 32) OR R32(P+4)) ELSE ((R32(P+4) LS 32) OR R32(P)));

SUBR W32(P,V) IS (
 I ARE LOCAL;
 BE NE 0 => (PUTB(P,0,(V RS 24) AND 255); PUTB(P,1,(V RS 16) AND 255); PUTB(P,2,(V RS 8) AND 255); PUTB(P,3,V AND 255))
 ELSE (PUTB(P,3,(V RS 24) AND 255); PUTB(P,2,(V RS 16) AND 255); PUTB(P,1,(V RS 8) AND 255); PUTB(P,0,V AND 255));
 0);

SUBR W64(P,V) IS (
 BE NE 0 => (W32(P,V RS 32); W32(P+4,V AND 4294967295)) ELSE (W32(P+4,V RS 32); W32(P,V AND 4294967295));
 0);

# AN ERROR: THE MESSAGE AND WHAT IT IS ABOUT ON THE STANDARD ERROR, AND THE END #
SUBR DIE(M,A) IS (
 CCALL write(2,LOC('imprename: '),11);
 CCALL write(2,M,CCALL strlen(M));
 A NE 0 => (CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A)));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1);
 CCALL exit(1);
 0);

# THE FILE PATH INTO BUF AND ITS LENGTH INTO BSZ #
SUBR SLURP(PATH) IS (
 F,N ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); N:=CCALL ftell(F); CCALL fseek(F,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => CCALL fread(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH);
 CCALL fclose(F);
 BSZ:=N;
 0);

# THE MAP: THE LINES "OLD NEW" OF THE FILE, IN A HASH TABLE OF THE OLD NAMES #
SUBR HSH(S) IS (
 H,I,C ARE LOCAL;
 H:=5381; I:=0;
 HL: C:=GETB(S,I); C=0 => RETURN H;
 H:=((H*33)+C) AND 65535; I:=I+1; GO TO HL);

SUBR READMAP(PATH) IS (
 P,E,NL,SP,H ARE LOCAL;
 SLURP(PATH);
 P:=BUF; E:=BUF+BSZ; NMAP:=0;
 RM1: P<E => (NL:=CCALL memchr(P,10,E-P); NL=0 => NL:=E;
              PUTB(NL,0,0);
              SP:=CCALL strchr(P,32);
              SP NE 0 => SP>P => GETB(SP,1) NE 0 => (PUTB(SP,0,0);
                                                      OLDN[NMAP]:=P; NEWN[NMAP]:=SP+1;
                                                      H:=HSH(P);
                                                      RM2: HT[H] NE 0 => (H:=(H+1) AND 65535; GO TO RM2);
                                                      HT[H]:=NMAP+1; NMAP:=NMAP+1);
              P:=NL+1; GO TO RM1);
 0);

# THE NEW NAME OF NAME, OR 0 #
SUBR NEWNAME(S) IS (
 H,J,K ARE LOCAL;
 NMAP=0 => RETURN 0;
 H:=HSH(S);
 NN1: J:=HT[H]; J=0 => RETURN 0;
 K:=J-1;                                              # NOT OLDN[J-1]: THE COMPILER ENCODES THE CONSTANT -8 OF THAT ADDRESS IN 21 BITS (0X1FFFF8) #
 CCALL strcmp(OLDN[K],S)=0 => RETURN NEWN[K];
 H:=(H+1) AND 65535; GO TO NN1);

# THE NEW STRING TABLE: THE OLD STRINGS AND THE NEW NAMES AFTER THEM #
SUBR STRSINIT(OLD,N) IS (
 CAPS:=N+4096;
 STRS:=CCALL malloc(CAPS);
 STRS=0 => DIE(LOC('out of memory'),0);
 CCALL memcpy(STRS,OLD,N);
 NSTRS:=N;
 0);

# THE STRING PREFIX AND S ADDED TO THE NEW TABLE; ITS OFFSET #
SUBR STRSADD(S,PRE) IS (
 NEED,AT ARE LOCAL;
 NEED:=CCALL strlen(PRE)+CCALL strlen(S)+1;
 AT:=NSTRS;
 NSTRS+NEED>CAPS => (CAPS:=(NSTRS+NEED)*2; STRS:=CCALL realloc(STRS,CAPS);
                     STRS=0 => DIE(LOC('out of memory'),0));
 CCALL snprintf(STRS+AT,NEED,LOC('%s%s'),PRE,S);
 NSTRS:=NSTRS+NEED;
 AT);

# OUT: BUF, THEN PAD ZERO BYTES, THEN THE NEW STRING TABLE #
SUBR WRITEOUT(PATH,PAD) IS (
 F ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('wb'));
 F=0 => DIE(LOC('cannot write'),PATH);
 CCALL fwrite(BUF,1,BSZ,F) NE BSZ => DIE(LOC('cannot write'),PATH);
 PAD>0 => CCALL fwrite(LOC(ZR),1,PAD,F) NE PAD => DIE(LOC('cannot write'),PATH);
 CCALL fwrite(STRS,1,NSTRS,F) NE NSTRS => DIE(LOC('cannot write'),PATH);
 CCALL fclose(F);
 0);

# ---- ELF ---- #
SUBR SHP(I) IS BUF+SHOFF+(I*SHENT);
SUBR SHTYPE(I) IS R32(SHP(I)+4);
SUBR SHFLAGS(I) IS (IS64=1 => R64(SHP(I)+8) ELSE R32(SHP(I)+8));
SUBR SHOFS(I) IS (IS64=1 => R64(SHP(I)+24) ELSE R32(SHP(I)+16));
SUBR SHSIZE(I) IS (IS64=1 => R64(SHP(I)+32) ELSE R32(SHP(I)+20));
SUBR SHLINK(I) IS (IS64=1 => R32(SHP(I)+40) ELSE R32(SHP(I)+24));

SUBR ELFOPEN(Z) IS (
 BSZ<52 => DIE(LOC('not an ELF object'),0);
 GETB(BUF,0)=127 => GETB(BUF,1)=69 => GETB(BUF,2)=76 => GETB(BUF,3)=70 => GO TO EO1;
 DIE(LOC('not an ELF object'),0);
 EO1: IS64:=(GETB(BUF,4)=2 => 1 ELSE 0);
 BE:=(GETB(BUF,5)=2 => 1 ELSE 0);
 IS64=1 => (SHOFF:=R64(BUF+40); SHENT:=R16(BUF+58); SHNUM:=R16(BUF+60))
 ELSE (SHOFF:=R32(BUF+32); SHENT:=R16(BUF+46); SHNUM:=R16(BUF+48));
 SHOFF=0 => DIE(LOC('no section headers'),0);
 SHOFF+(SHNUM*SHENT)>BSZ => DIE(LOC('no section headers'),0);
 0);

# THE FIRST SYMBOL TABLE: ITS SECTION, OR 0-1; THE SECTION OF ITS STRINGS IS SHLINK OF IT #
SUBR ELFSYM(Z) IS (
 I ARE LOCAL;
 I:=0;
 ES1: I<SHNUM => (SHTYPE(I)=2 => RETURN I; I:=I+1; GO TO ES1);
 0-1);

SUBR ELFLIST(Z) IS (
 ST,SS,ENT,N,I,SY,STR,INFO,TYPE,BIND,SHNDX,NM,OK,FL ARE LOCAL;
 ELFOPEN(0);
 ST:=ELFSYM(0); ST<0 => RETURN 0;
 SS:=SHLINK(ST);
 ENT:=(IS64=1 => 24 ELSE 16);
 N:=SHSIZE(ST)/ENT;
 STR:=BUF+SHOFS(SS);
 I:=1;
 EL1: I<N => (SY:=BUF+SHOFS(ST)+(I*ENT);
              INFO:=(IS64=1 => GETB(SY,4) ELSE GETB(SY,12));
              TYPE:=INFO AND 15; BIND:=INFO RS 4;
              SHNDX:=R16(SY+(IS64=1 => 6 ELSE 14)); NM:=R32(SY);
              OK:=0;
              NM NE 0 => BIND=1 => TYPE NE 3 => TYPE NE 4 => SHNDX NE 0 =>
                (SHNDX=65522 => OK:=1
                 ELSE (SHNDX<65280 => SHNDX<SHNUM => (FL:=SHFLAGS(SHNDX);
                       (FL AND 4) NE 0 => OK:=1 ELSE ((FL AND 2) NE 0 => (FL AND 1) NE 0 => OK:=1))));
              OK NE 0 => CCALL puts(STR+NM);
              I:=I+1; GO TO EL1);
 0);

SUBR ELFREN(OUT) IS (
 ST,SS,ENT,N,I,SY,STR,STROFF,STRSZ,NM,TN,PAD,SH ARE LOCAL;
 ELFOPEN(0);
 ST:=ELFSYM(0); ST<0 => DIE(LOC('no symbol table'),0);
 SS:=SHLINK(ST);
 ENT:=(IS64=1 => 24 ELSE 16);
 N:=SHSIZE(ST)/ENT;
 STROFF:=SHOFS(SS); STRSZ:=SHSIZE(SS);
 STR:=BUF+STROFF;
 STRSINIT(STR,STRSZ);
 I:=1;
 ER1: I<N => (SY:=BUF+SHOFS(ST)+(I*ENT); NM:=R32(SY);
              NM NE 0 => NM<STRSZ => (TN:=NEWNAME(STR+NM); TN NE 0 => W32(SY,STRSADD(TN,LOC(ZR))));
              I:=I+1; GO TO ER1);
 PAD:=(8-(BSZ AND 7)) AND 7;
 SH:=SHP(SS);
 IS64=1 => (W64(SH+24,BSZ+PAD); W64(SH+32,NSTRS)) ELSE (W32(SH+16,BSZ+PAD); W32(SH+20,NSTRS));
 WRITEOUT(OUT,PAD);
 0);

# ---- MACH-O (64 BIT) ---- #
# THE LOAD COMMAND LC_SYMTAB: ITS ADDRESS #
SUBR MACHSYM(Z) IS (
 NC,I,OFF,CMD,SZ ARE LOCAL;
 BE:=0;
 BSZ<32 => DIE(LOC('not a 64 bit Mach-O object'),0);
 R32(BUF) NE 4277009103 => DIE(LOC('not a 64 bit Mach-O object'),0);
 NC:=R32(BUF+16); I:=0; OFF:=32;
 MS1: I<NC => OFF+8 LE BSZ => (CMD:=R32(BUF+OFF); SZ:=R32(BUF+OFF+4);
                                CMD=2 => RETURN BUF+OFF;
                                SZ=0 => GO TO MS2;
                                OFF:=OFF+SZ; I:=I+1; GO TO MS1);
 MS2: DIE(LOC('no symbol table'),0);
 0);

SUBR MACHLIST(Z) IS (
 LC,I,SYMOFF,NSYMS,STROFF,SY,TYPE,NAME ARE LOCAL;
 LC:=MACHSYM(0);
 SYMOFF:=R32(LC+8); NSYMS:=R32(LC+12); STROFF:=R32(LC+16);
 I:=0;
 ML1: I<NSYMS => (SY:=BUF+SYMOFF+(I*16); TYPE:=GETB(SY,4);
                  NAME:=BUF+STROFF+R32(SY);
                  (TYPE AND 1) NE 0 => (TYPE AND 224)=0 => GETB(NAME,0) NE 0 =>
                    (((TYPE AND 14)=14) OR (((TYPE AND 14)=0) AND (R64(SY+8) NE 0))) NE 0 =>
                      (GETB(NAME,0)=95 => CCALL puts(NAME+1) ELSE CCALL puts(NAME));
                  I:=I+1; GO TO ML1);
 0);

SUBR MACHREN(OUT) IS (
 LC,I,SYMOFF,NSYMS,STROFF,STRSZ,SY,TYPE,NAME,STRX,TN,PAD ARE LOCAL;
 LC:=MACHSYM(0);
 SYMOFF:=R32(LC+8); NSYMS:=R32(LC+12); STROFF:=R32(LC+16); STRSZ:=R32(LC+20);
 STRSINIT(BUF+STROFF,STRSZ);
 I:=0;
 MR1: I<NSYMS => (SY:=BUF+SYMOFF+(I*16); STRX:=R32(SY); TYPE:=GETB(SY,4);
                  NAME:=BUF+STROFF+STRX;
                  (TYPE AND 1) NE 0 => (TYPE AND 224)=0 => GETB(NAME,0)=95 => STRX<STRSZ =>
                    (TN:=NEWNAME(NAME+1); TN NE 0 => W32(SY,STRSADD(TN,LOC('_'))));
                  I:=I+1; GO TO MR1);
 PAD:=(8-(BSZ AND 7)) AND 7;
 W32(LC+16,BSZ+PAD); W32(LC+20,NSTRS);
 WRITEOUT(OUT,PAD);
 0);

# THE ARGUMENT I OF THE COMMAND LINE #
SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD)
%%
