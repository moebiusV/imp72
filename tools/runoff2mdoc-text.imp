#RUNOFF2MDOC-TEXT.IMP -- THE SECOND FILE OF TOOLS/RUNOFF2MDOC.IMP (THE COMPILER NAMES ONLY 2047 REGISTERS IN A FILE, SO THE PROGRAM IS IN THREE; IMPTOOL.SH COMPILES THE THREE TOGETHER): THE CASE FLAGS OF RUNOFF, THE TEXT OF AN
ARGUMENT OF A MACRO LINE, THE KINDS OF WORDS, THE TOKENS OF A PARAGRAPH AND THE MDOC LINES THEY BECOME.#

LET KW=1, KIC=2, KAR=3, KLI=4, KPA=5, KSY=6, KNAME=7, KGROUP=8;
LET F_KIND=0, F_TEXT=1, F_PRE=2, F_POST=3, F_SUF=4, F_TOKS=5, F_QUOTE=6;
LET SP=32, DQ=34, SQ=39, BS=92, HAT=94, LF=10;
# THE VARIABLES THE MODULES SHARE (THE SAME DECLARATIONS IN EACH OF THE THREE FILES; A VARIABLE THAT IS NOT COMMON BELONGS TO ITS FILE) #
ARGW,FIXPATH,FIXOLD,FIXNEW,CASER,SPANS,OUT,EV,ST_LIST,ST_ITEM,ST_SUB,ST_RAG,ST_FIRSTPAR,ST_LIT,ST_PP,ST_MARGIN,CRT,CRF,GQ_TODO ARE COMMON;
NAMES_SET,MACROS_SET,VARNEXT_SET,EMPH_SET,PLAIN_SET,PAPER_SET,FILEEXT_SET,ABBR1_L,ABBR2_L ARE COMMON;
SET_PRE,SET_POST,SET_QPOST,SET_BPOST,UPPER_SET,LOWER_SET,ALPHA_SET,ALNUM_SET,ALNUMUP_SET,DIGIT_SET,CAPSPACE_SET,PUNCT3,PUNCT4,SPACES_SET ARE COMMON;
TABSTR,MARK1,MARK2,MARK3,EMDASH,TDASH,RSQ,LDQ,RDQ,ORDTH ARE COMMON;
CMDW,CMDA,FMHEAD,FMBODY,FFHEAD,FFBODY,FNNAME,NH_TAG,NH_BODY,MR_G1,MR_G2,M2_G1,M2_G2 ARE COMMON;

# ---- THE CASE FLAGS OF RUNOFF ---- #

# A CASER IS [CAPS, UNDER]: ^^ ... TWO BACKSLASHES SETS AND CLEARS THE FIRST, ^& ... \& THE SECOND (WHICH NOTHING READS) #
SUBR CS_NEW(Z) IS CCALL calloc(2,8);

# THE TEXT WITH THE FLAGS RESOLVED INTO CRT, AND A STRING OF THE SAME LENGTH, A 1 FOR EACH CHARACTER THAT WAS RAISED BY ITS OWN ^ (OR BY ^^) AND A 0 FOR THE OTHERS, INTO CRF; THE VALUE IS CRT #
SUBR CS_RUN(CS,TXT) IS (
 B,F,I,N,C,D,X ARE LOCAL;
 B:=B_NEW(0); F:=B_NEW(0); I:=0; N:=CCALL strlen(TXT);
 CL: I<N => (
    C:=GETB(TXT,I);
    ((C=94) AND ((I+1)<N)) => (
       D:=GETB(TXT,I+1);
       D=94 => (WR(CS,0,1); I:=I+2; GO TO CL);
       D=38 => (WR(CS,1,1); I:=I+2; GO TO CL);
       IS_ALPHA(D) NE 0 => (B_CH(B,TO_UPPER(D)); B_CH(F,49)) ELSE (B_CH(B,D); B_CH(F,48));
       I:=I+2; GO TO CL);
    C=92 => (
       X:=GETB(TXT,I+1);
       X=92 => (WR(CS,0,0); I:=I+2; GO TO CL);
       X=38 => (WR(CS,1,0); I:=I+2; GO TO CL);
       I:=I+1;
       I<N => (B_CH(B,TO_LOWER(GETB(TXT,I))); B_CH(F,48); I:=I+1);
       GO TO CL);
    ((C=95) AND ((I+1)<N)) => (B_CH(B,GETB(TXT,I+1)); B_CH(F,48); I:=I+2; GO TO CL);
    IS_ALPHA(C) NE 0 => (
       RD(CS,0) NE 0 => (B_CH(B,TO_UPPER(C)); B_CH(F,49)) ELSE (B_CH(B,TO_LOWER(C)); B_CH(F,48)))
    ELSE (B_CH(B,C); B_CH(F,48));
    I:=I+1; GO TO CL);
 CRT:=B_GET(B); CRF:=B_GET(F); CRT);

# CASER().RUN(TXT): A NEW CASER, ONLY THE TEXT #
SUBR CASE_FRESH(TXT) IS (
 C ARE LOCAL;
 C:=CS_NEW(0); CS_RUN(C,TXT));

# ---- THE TEXT OF AN ARGUMENT OF A MACRO LINE ---- #

# AN ARGUMENT OF A MACRO LINE; CODE NE 0 FOR LITERAL TEXT (THE CHARACTERS MDOC WOULD TAKE FOR MARKUP ARE ESCAPED) #
SUBR ESC(S,CODE) IS (
 B,I,N,C,T,L,LC,L1,Q,M,X ARE LOCAL;
 B:=B_NEW(0); N:=CCALL strlen(S); I:=0;
 WHILE I<N DO (
    C:=GETB(S,I);
    C=92 => B_STR(B,LOC('\e'))
    ELSE (
      ((CODE NE 0) AND (C=45)) => B_STR(B,LOC('\-'))
      ELSE (((CODE NE 0) AND (C=39)) => B_STR(B,LOC('\(aq'))
      ELSE (((CODE NE 0) AND (C=96)) => B_STR(B,LOC('\(ga'))
      ELSE (((CODE NE 0) AND (C=126)) => B_STR(B,LOC('\(ti'))
      ELSE (((CODE NE 0) AND (C=94)) => B_STR(B,LOC('\(ha'))
      ELSE (C=34 => B_STR(B,LOC('\(dq')) ELSE B_CH(B,C)))))));
    I:=I+1);
 T:=B_GET(B); L:=CCALL strlen(T);
 L>1 => (
    LC:=GETB(T,L-1);
    IN_SET(LC,LOC('.,:;)]?!')) NE 0 => (
       ALL_IN(T,0,LOC('.,:;()[]?!|'))=0 => (
          L1:=L-1; X:=S_SUB(T,0,L1); Q:=S_C(LC); T:=S_CAT3(X,LOC('\&'),Q))));
 L:=CCALL strlen(T); M:=0;
 IN_WORDS(MACROS_SET,T) NE 0 => M:=1;
 L>0 => (C:=GETB(T,0); ((C=39) OR (C=46)) => M:=1);
 L>0 => (ALL_IN(T,0,LOC('|.,:;()[]?!')) NE 0 => M:=1);
 M NE 0 => T:=S_CAT(LOC('\&'),T);
 ((S_ANY(T,LOC(' ')) NE 0) OR (S_LEN(T)=0)) => (Q:=S_C(34); T:=S_CAT3(Q,T,Q));
 T);

# A WORD OF A TEXT LINE #
SUBR ESCTEXT(S) IS (
 T,C ARE LOCAL;
 T:=S_REPL(S,LOC('\'),LOC('\e'));
 C:=GETB(T,0);
 ((C=0) OR (C=46) OR (C=39)) => T:=S_CAT(LOC('\&'),T);
 T);

# THE TYPOGRAPHY OF THE PAGE: A SPACED HYPHEN IS A DASH, AN APOSTROPHE BETWEEN WORD CHARACTERS IS A CURLY ONE #
SUBR UTF8IZE(S) IS (
 T,B,I,N,C,Z ARE LOCAL;
 T:=S_REPL(S,TDASH,EMDASH);
 B:=B_NEW(0); N:=CCALL strlen(T); I:=0;
 WHILE I<N DO (
    C:=GETB(T,I); Z:=0;
    ((C=39) AND (I>0)) => (
       IS_W(GETB(T,I-1)) NE 0 => (IS_W(GETB(T,I+1)) NE 0 => Z:=1));
    Z NE 0 => B_STR(B,RSQ) ELSE B_CH(B,C);
    I:=I+1);
 B_GET(B));

# ---- THE TOKENS ---- #

SUBR TOK_NEW(KIND,TXT,PRE,POST,SUF) IS (
 T ARE LOCAL;
 T:=CCALL calloc(8,8);
 WR(T,F_KIND,KIND); WR(T,F_TEXT,TXT); WR(T,F_PRE,PRE); WR(T,F_POST,POST); WR(T,F_SUF,SUF); T);

SUBR GRP_NEW(Q,TOKS,PRE,POST) IS (
 T,E ARE LOCAL;
 E:=S_E(0);
 T:=CCALL calloc(8,8);
 WR(T,F_KIND,KGROUP); WR(T,F_TEXT,E); WR(T,F_SUF,E); WR(T,F_QUOTE,Q); WR(T,F_TOKS,TOKS); WR(T,F_PRE,PRE); WR(T,F_POST,POST); T);

# THE MDOC MACRO OF A KIND #
SUBR KMAC(K) IS (
 K=KIC => RETURN LOC('Ic');
 K=KAR => RETURN LOC('Ar');
 K=KLI => RETURN LOC('Li');
 K=KPA => RETURN LOC('Pa');
 K=KSY => RETURN LOC('Sy');
 LOC('w'));

# IS THE STRING A FILE NAME OF THE TAPE: LETTERS AND DIGITS, A DOT, AND AN EXTENSION OF THE LIST (ANY CASE) #
SUBR IS_FILE(S) IS (
 P,E,U ARE LOCAL;
 P:=S_INDEX(S,LOC('.'),0);
 P<1 => RETURN 0;
 E:=S_SUB(S,0,P);
 ALL_IN(E,0,ALNUM_SET)=0 => RETURN 0;
 E:=S_FROM(S,P+1); U:=S_UPPER(E);
 IN_WORDS(FILEEXT_SET,U));

# DOES C HOLD A [ AT F, ONE OR MORE OF A-Z AND COMMA, AND A ] AT ITS END #
SUBR M_BRK(C,F) IS (
 N,I ARE LOCAL;
 N:=S_LEN(C);
 GETB(C,F) NE 91 => RETURN 0;
 GETB(C,N-1) NE 93 => RETURN 0;
 (N-1)<(F+2) => RETURN 0;
 I:=F+1;
 WHILE I<(N-1) DO (
    ((IS_UP(GETB(C,I)) NE 0) OR (GETB(C,I)=44)) => I:=I+1 ELSE RETURN 0);
 1);

# THE FORMS A.B, A.B[X,Y] AND A[X,Y] (LETTERS A-Z) #
SUBR M_P1(C) IS (
 N ARE LOCAL;
 N:=S_LEN(C);
 IS_UP(GETB(C,0))=0 => RETURN 0;
 ((GETB(C,1)=46) AND (IS_UP(GETB(C,2)) NE 0)) => (N=3 => RETURN 1; RETURN M_BRK(C,3));
 GETB(C,1)=91 => RETURN M_BRK(C,1);
 0);

# THE KIND OF A WORD, FROM ITS TEXT AND ITS FLAGS #
SUBR CLASSIFY(CORE,FL) IS (
 N,I,C,NL,ANYR,ALLR,OPS,SLASH,LOW3,D ARE LOCAL;
 N:=S_LEN(CORE); NL:=0; ANYR:=0; ALLR:=1; I:=0;
 WHILE I<N DO (
    C:=GETB(CORE,I);
    IS_ALPHA(C) NE 0 => (NL:=NL+1; GETB(FL,I)=49 => ANYR:=1 ELSE ALLR:=0);
    I:=I+1);
 IS_FILE(CORE) NE 0 => RETURN KPA;
 IN_WORDS(PLAIN_SET,CORE) NE 0 => RETURN KW;
 OPS:=S_ANY(CORE,LOC('=<>+*[]_#%$|@'));
 # THREE LOWER CASE LETTERS IN A ROW #
 LOW3:=0; I:=0;
 WHILE I<N DO (
    ((IS_LOW(GETB(CORE,I)) NE 0) AND (IS_LOW(GETB(CORE,I+1)) NE 0) AND (IS_LOW(GETB(CORE,I+2)) NE 0)) => LOW3:=1;
    I:=I+1);
 # A LETTER OR DIGIT, THEN ( : OR COMMA, THEN A LETTER, DIGIT OR ( #
 ANYR NE 0 => (
    I:=0;
    WHILE I<N DO (
       ((IS_ALNUM(GETB(CORE,I)) NE 0) AND (IN_SET(GETB(CORE,I+1),LOC('(:,')) NE 0)) => (
          D:=GETB(CORE,I+2);
          (((IS_ALNUM(D) NE 0) OR (D=40)) AND (LOW3=0)) => OPS:=1);
       I:=I+1));
 ((N=3) AND (IS_UP(GETB(CORE,0)) NE 0) AND (GETB(CORE,1)=45) AND (IS_UP(GETB(CORE,2)) NE 0) AND (ALLR NE 0)) => OPS:=1;
 SLASH:=0;
 S_ANY(CORE,LOC('/')) NE 0 => (
    ANYR NE 0 => SLASH:=1;
    S_ANY(CORE,LOC('0123456789')) NE 0 => SLASH:=1);
 ((N>0) AND (ALL_IN(CORE,0,LOC('/=<>+*%#@$"''')) NE 0)) => RETURN KLI;
 ((NL>0) AND (ALLR NE 0) AND (M_P1(CORE) NE 0)) => RETURN KLI;
 ((NL=1) AND (ALLR NE 0) AND (N=1)) => RETURN KAR;
 ((OPS NE 0) OR (SLASH NE 0)) => RETURN KLI;
 ((NL>1) AND (ALLR NE 0) AND (ALL_IN(CORE,0,ALPHA_SET) NE 0)) => (
    IN_WORDS(EMPH_SET,S_UPPER(CORE)) NE 0 => RETURN KSY;
    IN_WORDS(NAMES_SET,S_UPPER(CORE)) NE 0 => RETURN KNAME;
    RETURN KIC);
 # A RUN OF CAPITALS AND THEN A RUN OF DIGITS #
 ((NL>1) AND (ALLR NE 0)) => (
    I:=0;
    WHILE IS_UP(GETB(CORE,I)) NE 0 DO I:=I+1;
    ((I>0) AND (IS_DIG(GETB(CORE,I)) NE 0)) => (
       D:=I;
       WHILE IS_DIG(GETB(CORE,I)) NE 0 DO I:=I+1;
       I=N => (
          IN_WORDS(NAMES_SET,S_SUB(CORE,0,D)) NE 0 => RETURN KNAME;
          RETURN KLI)));
 # A DIGIT AND THEN DIGITS AND CAPITALS, WITH A CAPITAL IN IT, BUT NOT DIGITS AND K #
 IS_DIG(GETB(CORE,0)) NE 0 => (
    ALL_IN(CORE,0,ALNUMUP_SET) NE 0 => (
       S_ANY(CORE,UPPER_SET) NE 0 => (
          I:=N-1;
          ((GETB(CORE,I)=75) AND (ALL_IN(S_SUB(CORE,0,I),0,DIGIT_SET) NE 0) AND (I>0)) => RETURN KW;
          RETURN KLI)));
 KW);

# ---- THE WORDS OF A PARAGRAPH ---- #

# THE LENGTH OF THE RUN OF CHARACTERS OF SET AT THE FRONT OF W #
SUBR RUN_FRONT(W,SET) IS (
 I,N,F ARE LOCAL;
 N:=S_LEN(W); I:=0; F:=1;
 WHILE F NE 0 DO (I<N => (IN_SET(GETB(W,I),SET) NE 0 => I:=I+1 ELSE F:=0) ELSE F:=0);
 I);

# THE INDEX FROM WHICH THE CHARACTERS OF W UP TO ITS END ARE ALL IN SET, NOT BELOW LOW #
SUBR RUN_BACK(W,LOW,SET) IS (
 I,F ARE LOCAL;
 I:=S_LEN(W); F:=1;
 WHILE F NE 0 DO (I>LOW => (IN_SET(GETB(W,I-1),SET) NE 0 => I:=I-1 ELSE F:=0) ELSE F:=0);
 I);

# THE NUMBER K IN DIGITS #
SUBR S_NUM(K) IS (
 B,V,D,R,Z ARE LOCAL;
 K=0 => RETURN LOC('0');
 B:=B_NEW(0); R:=B_NEW(0); V:=K;
 WHILE V>0 DO (D:=V-((V/10)*10); B_CH(R,48+D); V:=V/10);
 D:=RD(R,0); Z:=RD(R,2);
 WHILE D>0 DO (D:=D-1; B_CH(B,GETB(Z,D)));
 B_GET(B));

# THE MARKER OF SPAN K: THE CHARACTER 1, THE NUMBER, THE CHARACTER 2 #
SUBR MARKER(K) IS (
 B ARE LOCAL;
 B:=B_NEW(0); B_CH(B,1); B_STR(B,S_NUM(K)); B_CH(B,2); B_GET(B));

# THE PARAGRAPH WITH EVERY ^^ ... TWO BACKSLASHES (WHICH MAY HOLD SPACES) MADE ONE WORD, A MARKER; THE SPANS ARE KEPT IN THE LIST SPANS #
SUBR GRAB_SPANS(TXT) IS (
 B,I,N,J,K,D ARE LOCAL;
 B:=B_NEW(0); N:=CCALL strlen(TXT); I:=0;
 WHILE I<N DO (
    D:=0;
    ((GETB(TXT,I)=94) AND (GETB(TXT,I+1)=94)) => (
       K:=I+2; J:=S_INDEX(TXT,LOC('\\'),K);
       J GE 0 => (
          L_ADD(SPANS,S_SUB(TXT,K,J));
          K:=L_LEN(SPANS)-1; B_STR(B,MARKER(K)); I:=J+2; D:=1));
    D=0 => (B_CH(B,GETB(TXT,I)); I:=I+1));
 B_GET(B));

# A * AT THE FRONT OF A WORD AND FOLLOWED BY A LETTER OR ^ IS A SPAN OF ITS OWN (A MARKER AND A SPACE) #
SUBR GRAB_STARS(TXT) IS (
 B,I,N,C,D,K,Z ARE LOCAL;
 B:=B_NEW(0); N:=CCALL strlen(TXT); I:=0;
 WHILE I<N DO (
    C:=GETB(TXT,I); Z:=0;
    C=42 => (
       D:=GETB(TXT,I+1); K:=1;
       I>0 => (GETB(TXT,I-1) NE 32 => K:=0);
       ((IS_ALPHA(D) NE 0) OR (D=94)) => (
          K NE 0 => (L_ADD(SPANS,LOC('*')); K:=L_LEN(SPANS)-1; B_STR(B,MARKER(K)); B_CH(B,32); Z:=1)));
    Z=0 => B_CH(B,C);
    I:=I+1);
 B_GET(B));

# THE TEXT OF A WORD THAT HOLDS SPAN MARKERS: THE SPANS AS THEY ARE AND THE PIECES BETWEEN THEM WITH THEIR FLAGS RESOLVED #
SUBR SPAN_TEXT(CORE) IS (
 B,I,N,C,J,K,P,F ARE LOCAL;
 B:=B_NEW(0); N:=CCALL strlen(CORE); I:=0;
 WHILE I<N DO (
    C:=GETB(CORE,I);
    C=1 => (
       J:=I+1; K:=0;
       WHILE IS_DIG(GETB(CORE,J)) NE 0 DO (K:=(K*10)+(GETB(CORE,J)-48); J:=J+1);
       B_STR(B,L_GET(SPANS,K)); I:=J+1)
    ELSE (
       J:=I; F:=1;
       WHILE F NE 0 DO (J<N => (GETB(CORE,J) NE 1 => J:=J+1 ELSE F:=0) ELSE F:=0);
       P:=S_SUB(CORE,I,J); B_STR(B,CASE_FRESH(P)); I:=J));
 B_GET(B));

# IS THE STRING CAPITALS, A COMMA AND A SPACE, MORE CAPITALS ...: [A-Z]+(, [A-Z]+)+ #
SUBR IS_CAPLIST(T) IS (
 I,N,C,K,L ARE LOCAL;
 N:=S_LEN(T); I:=0; K:=0; L:=0;
 WHILE I<N DO (
    C:=GETB(T,I);
    IS_UP(C) NE 0 => (L:=L+1; I:=I+1)
    ELSE (
      ((C=44) AND (GETB(T,I+1)=32) AND (L>0)) => (K:=K+1; L:=0; I:=I+2)
      ELSE RETURN 0));
 ((L>0) AND (K>0)));

# THE WORD W AS A TOKEN OR TOKENS ADDED TO TOKS #
SUBR WORD_TOKS(W,CS,TOKS) IS (
 N,P,Q,E,PRE,CORE,POST,I,C,T,K,KIND,X,J,FLG,WORDS,Y,Z,EM ARE LOCAL;
 N:=S_LEN(W); EM:=S_E(0);
 # A QUOTE, ONE CHARACTER THAT IS NOT A LETTER, A DIGIT OR WHITE SPACE, THE SAME QUOTE, AND CLOSING PUNCTUATION #
 C:=GETB(W,0);
 ((N>2) AND ((C=34) OR (C=39)) AND (GETB(W,2)=C) AND (IS_ALNUM(GETB(W,1))=0) AND (IS_SPACE(GETB(W,1))=0)) => (
    ALL_IN(W,3,SET_QPOST) NE 0 => (
       X:=S_C(GETB(W,1)); T:=TOK_NEW(KLI,X,EM,EM,EM); K:=L_NEW(0); L_ADD(K,T);
       Y:=S_FROM(W,3); Z:=GRP_NEW(C,K,EM,Y); L_ADD(TOKS,Z); RETURN 0));
 # CODE BETWEEN EXCLAMATION MARKS #
 P:=RUN_FRONT(W,SET_PRE);
 GETB(W,P)=33 => (
    E:=P+2;
    WHILE E<N DO (
       GETB(W,E)=33 => (
          ALL_IN(W,E+1,SET_BPOST) NE 0 => (
             PRE:=S_SUB(W,0,P); X:=E+1; CORE:=S_SUB(W,P,X); POST:=S_FROM(W,X);
             CORE:=CASE_FRESH(CORE); T:=TOK_NEW(KLI,CORE,PRE,POST,EM); L_ADD(TOKS,T); RETURN 0));
       E:=E+1));
 # THE GENERAL WORD: OPENING PUNCTUATION, THE WORD, CLOSING PUNCTUATION #
 Q:=RUN_BACK(W,P,SET_POST);
 PRE:=S_SUB(W,0,P); CORE:=S_SUB(W,P,Q); POST:=S_FROM(W,Q);
 # A CLOSING PARENTHESIS OR BRACKET THAT THE WORD OPENED STAYS IN IT #
 K:=1;
 WHILE K NE 0 DO (
    C:=GETB(POST,0);
    ((C=41) OR (C=93)) => (
       C=41 => X:=S_COUNT(CORE,40) ELSE X:=S_COUNT(CORE,91);
       Y:=S_COUNT(CORE,C);
       X>Y => (Z:=S_C(C); CORE:=S_CAT(CORE,Z); POST:=S_FROM(POST,1)) ELSE K:=0)
    ELSE K:=0);
 ((S_LEN(CORE)=0) AND (S_LEN(PRE)>0) AND (S_LEN(POST)=0)) => (CORE:=PRE; PRE:=EM);
 # A WORD WITH A ^^ SPAN IN IT #
 S_ANY(CORE,MARK1) NE 0 => (
    T:=SPAN_TEXT(CORE);
    # CAPITALS FOLLOWED BY PUNCTUATION: THE PUNCTUATION LEAVES THE TEXT #
    N:=S_LEN(T); I:=RUN_FRONT(T,CAPSPACE_SET);
    ((I>1) AND (IS_UP(GETB(T,0)) NE 0) AND (IS_SPACE(GETB(T,I-1))=0)) => (
       IN_SET(GETB(T,I),PUNCT3) NE 0 => (
          J:=I;
          WHILE IN_SET(GETB(T,J),PUNCT3) NE 0 DO J:=J+1;
          ALL_IN(T,J,SPACES_SET) NE 0 => (
             X:=S_SUB(T,I,J); POST:=S_CAT(X,POST); T:=S_SUB(T,0,I))));
    T:=S_STRIP(T);
    ((S_ANY(T,LOWER_SET) NE 0) AND (S_ANY(T,UPPER_SET) NE 0) AND (S_ANY(T,LOC('=<>+*/[](),:'))=0)) => (
       X:=TOK_NEW(KW,T,PRE,POST,EM); L_ADD(TOKS,X); RETURN 0);
    IS_CAPLIST(T) NE 0 => (
       I:=0; WORDS:=L_NEW(0);
       WHILE I GE 0 DO (
          J:=S_INDEX(T,LOC(', '),I);
          J<0 => (L_ADD(WORDS,S_FROM(T,I)); I:=-1)
          ELSE (L_ADD(WORDS,S_SUB(T,I,J)); I:=J+2));
       N:=L_LEN(WORDS); I:=0;
       WHILE I<N DO (
          I=0 => X:=PRE ELSE X:=EM;
          I=(N-1) => Y:=POST ELSE Y:=LOC(',');
          Z:=TOK_NEW(KIC,L_GET(WORDS,I),X,Y,EM); L_ADD(TOKS,Z); I:=I+1);
       RETURN 0);
    KIND:=KIC;
    IS_FILE(T) NE 0 => KIND:=KPA
    ELSE (S_ANY(T,LOC('=<>+*/[](),:')) NE 0 => KIND:=KLI
    ELSE (S_ANY(T,ALPHA_SET)=0 => KIND:=KLI
    ELSE (IN_WORDS(NAMES_SET,S_UPPER(S_WORD1(T))) NE 0 => KIND:=KW
    ELSE (S_ANY(T,LOC(' ')) NE 0 => KIND:=KLI ELSE KIND:=KIC))));
    X:=TOK_NEW(KIND,T,PRE,POST,EM); L_ADD(TOKS,X); RETURN 0);
 CS_RUN(CS,CORE); T:=CRT; FLG:=CRF;
 # ^X'TH: A VARIABLE AND AN ORDINAL ENDING #
 N:=S_LEN(CORE);
 ((N=5) AND (GETB(CORE,0)=94) AND (IS_UP(GETB(CORE,1)) NE 0) AND (GETB(CORE,2)=39)) => (
    X:=S_FROM(CORE,3);
    ((S_EQ(X,LOC('TH')) NE 0) OR (S_EQ(X,LOC('th')) NE 0)) => (
       X:=S_C(GETB(CORE,1)); Z:=TOK_NEW(KAR,X,PRE,POST,ORDTH); L_ADD(TOKS,Z); RETURN 0));
 N>0 => KIND:=CLASSIFY(T,FLG) ELSE KIND:=KW;
 KIND=KNAME => KIND:=KW;
 X:=TOK_NEW(KIND,T,PRE,POST,EM); L_ADD(TOKS,X);
 0);

# A LONE A OR I IS THE ARTICLE OR THE PRONOUN UNLESS THE WORD AFTER IT SAYS IT IS A VARIABLE #
SUBR VARNEXT_FIX(TOKS) IS (
 K,N,T,NXT,NT,SKIP,TX ARE LOCAL;
 N:=L_LEN(TOKS); K:=0;
 WHILE K<N DO (
    T:=L_GET(TOKS,K);
    RD(T,F_KIND)=KAR => (
       TX:=RD(T,F_TEXT);
       ((S_EQ(TX,LOC('A')) NE 0) OR (S_EQ(TX,LOC('I')) NE 0)) => (
          SKIP:=0;
          S_LEN(RD(T,F_POST))>0 => SKIP:=1;
          (K+1)<N => (
             NXT:=L_GET(TOKS,K+1); NT:=S_UPPER(RD(NXT,F_TEXT));
             IS_ALNUM(GETB(NT,0))=0 => SKIP:=1;
             IN_WORDS(VARNEXT_SET,NT) NE 0 => SKIP:=1;
             RD(NXT,F_KIND)=KLI => SKIP:=1)
          ELSE SKIP:=1;
          SKIP=0 => WR(T,F_KIND,KW)));
    K:=K+1);
 0);

# AN OPENING PARENTHESIS THAT IS CLOSED A FEW WORDS LATER MAKES THE WORDS ONE PIECE OF CODE; CODE ELSE CODE IS ONE PIECE #
SUBR PAREN_GROUPS(TOKS) IS (
 K,A,KIND,PRE,I,C,QP,PP,FULL,DEPTH,COND1,J,TXT,F,T,FF,B,CORE,POST,X,Y,Z,NX,BB,CC,EM ARE LOCAL;
 EM:=S_E(0); K:=0;
 PG: K<L_LEN(TOKS) => (
    A:=L_GET(TOKS,K); KIND:=RD(A,F_KIND); PRE:=RD(A,F_PRE);
    QP:=B_NEW(0); PP:=B_NEW(0); I:=0;
    WHILE I<S_LEN(PRE) DO (
       C:=GETB(PRE,I);
       ((C=34) OR (C=39)) => B_CH(QP,C) ELSE B_CH(PP,C);
       I:=I+1);
    QP:=B_GET(QP); PP:=B_GET(PP);
    FULL:=S_CAT3(PP,RD(A,F_TEXT),RD(A,F_POST));
    X:=S_COUNT(FULL,40); Y:=S_COUNT(FULL,41); DEPTH:=X-Y;
    COND1:=0;
    ((KIND NE KW) AND (KIND NE KGROUP)) => (DEPTH>0 => COND1:=1);
    COND1 NE 0 => (
       J:=K+1; TXT:=FULL; F:=1;
       WHILE F NE 0 DO (
          ((J<L_LEN(TOKS)) AND (DEPTH>0) AND (J<(K+12))) => (
             T:=L_GET(TOKS,J);
             FF:=S_CAT3(RD(T,F_PRE),RD(T,F_TEXT),RD(T,F_POST));
             X:=S_COUNT(FF,40); Y:=S_COUNT(FF,41); DEPTH:=(DEPTH+X)-Y;
             TXT:=S_CAT3(TXT,LOC(' '),FF);
             J:=J+1)
          ELSE F:=0);
       DEPTH=0 => (
          B:=RUN_BACK(TXT,0,PUNCT4);
          CORE:=S_SUB(TXT,0,B); POST:=S_FROM(TXT,B);
          WR(A,F_PRE,QP); WR(A,F_TEXT,CORE); WR(A,F_POST,POST); WR(A,F_KIND,KLI);
          NX:=K+1; L_DELR(TOKS,NX,J));
       K:=K+1; GO TO PG);
    # CODE ELSE CODE #
    ((KIND=KLI) AND ((K+2)<L_LEN(TOKS))) => (
       BB:=L_GET(TOKS,K+1); CC:=L_GET(TOKS,K+2);
       ((RD(BB,F_KIND)=KIC) AND (S_EQ(RD(BB,F_TEXT),LOC('ELSE')) NE 0) AND ((RD(CC,F_KIND)=KAR) OR (RD(CC,F_KIND)=KLI)) AND (S_LEN(RD(A,F_POST))=0) AND (S_LEN(RD(BB,F_POST))=0)) => (
          X:=S_CAT3(RD(A,F_PRE),RD(A,F_TEXT),LOC(' ELSE '));
          Y:=S_CAT(RD(CC,F_PRE),RD(CC,F_TEXT));
          X:=S_CAT(X,Y);
          WR(A,F_TEXT,X); WR(A,F_PRE,EM); WR(A,F_POST,RD(CC,F_POST));
          NX:=K+1; Z:=K+3; L_DELR(TOKS,NX,Z);
          GO TO PG));
    K:=K+1; GO TO PG);
 0);

# TWO CODES NEXT TO EACH OTHER, THE FIRST ENDING IN ; OR , AND THE SECOND NOT OPENING, ARE ONE #
SUBR MERGE_LI(TOKS) IS (
 K,A,B,P,X,Y,NX ARE LOCAL;
 K:=0;
 ML: (K+1)<L_LEN(TOKS) => (
    A:=L_GET(TOKS,K); B:=L_GET(TOKS,K+1); P:=RD(A,F_POST);
    ((RD(A,F_KIND)=KLI) AND (RD(B,F_KIND)=KLI) AND ((S_EQ(P,LOC(';')) NE 0) OR (S_EQ(P,LOC(',')) NE 0)) AND (S_LEN(RD(B,F_PRE))=0)) => (
       X:=S_CAT3(RD(A,F_TEXT),P,LOC(' ')); Y:=S_CAT(X,RD(B,F_TEXT));
       WR(A,F_TEXT,Y); WR(A,F_POST,RD(B,F_POST));
       NX:=K+1; L_DEL1(TOKS,NX);
       GO TO ML);
    K:=K+1; GO TO ML);
 0);

# DOES THE (LOWER CASED) STRING END IN ONE OF THE WORDS OF THE LIST AND A DOT, THE WORD NOT PART OF A LONGER ONE #
SUBR ENDS_ABBR(PT,WL) IS (
 LP,N,I,W,WD,L ARE LOCAL;
 LP:=S_LOWER(PT); N:=L_LEN(WL); I:=0;
 WHILE I<N DO (
    W:=L_GET(WL,I); WD:=S_CAT(W,LOC('.'));
    S_ENDS(LP,WD) NE 0 => (
       L:=S_LEN(LP)-S_LEN(WD);
       L=0 => RETURN 1;
       IS_W(GETB(LP,L-1))=0 => RETURN 1);
    I:=I+1);
 0);

# THREE LOWER CASE LETTERS AND A . ? OR ! AT THE END OF THE STRING #
SUBR ENDS_SENT(PT) IS (
 L ARE LOCAL;
 L:=S_LEN(PT);
 L<4 => RETURN 0;
 IN_SET(GETB(PT,L-1),LOC('.?!'))=0 => RETURN 0;
 ((IS_LOW(GETB(PT,L-2)) NE 0) AND (IS_LOW(GETB(PT,L-3)) NE 0) AND (IS_LOW(GETB(PT,L-4)) NE 0)));

# THE TOKEN'S TEXT WITH ITS FIRST LETTER RAISED #
SUBR UPPER_FIRST(T) IS (
 X,Y,C ARE LOCAL;
 X:=RD(T,F_TEXT); C:=TO_UPPER(GETB(X,0)); Y:=S_C(C); X:=S_FROM(X,1); X:=S_CAT(Y,X);
 WR(T,F_TEXT,X); 0);

# A WORD THAT STARTS A SENTENCE GETS A CAPITAL #
SUBR CAPITALIZE(TOKS) IS (
 K,N,T,PREV,PT,C,X,TX,PO ARE LOCAL;
 N:=L_LEN(TOKS); K:=0; PREV:=0;
 WHILE K<N DO (
    T:=L_GET(TOKS,K);
    PREV NE 0 => (
       TX:=RD(T,F_TEXT); C:=GETB(TX,0);
       ((RD(T,F_KIND)=KW) AND (IS_LOW(C) NE 0) AND (S_LEN(RD(T,F_PRE))=0)) => (
          # NOT A.B. #
          ((IS_LOW(GETB(TX,0)) NE 0) AND (GETB(TX,1)=46) AND (IS_LOW(GETB(TX,2)) NE 0) AND (GETB(TX,3)=46)) => GO TO CP1;
          PT:=S_CAT(RD(PREV,F_TEXT),RD(PREV,F_POST));
          RD(PREV,F_KIND)=KW => (
             ENDS_SENT(PT) NE 0 => (ENDS_ABBR(PT,ABBR1_L)=0 => UPPER_FIRST(T)))
          ELSE (
             PO:=RD(PREV,F_POST);
             ((S_LEN(PO)>0) AND (IN_SET(GETB(PO,S_LEN(PO)-1),LOC('.?!')) NE 0)) => UPPER_FIRST(T))));
    CP1: PREV:=T; K:=K+1);
 0);

# THE WORK OF GROUP_QUOTES THAT IS STILL TO DO: THE GROUPS WHOSE TOKENS HAVE TO BE GROUPED IN TURN #
SUBR GQ_FLAT(TOKS) IS (
 R,K,N,T,Q,END,J,TJ,C,I,LEAD,TE,CUT,TRAIL,INNER,G,PRE,POST,F,LIM,PI,TP ARE LOCAL;
 R:=L_NEW(0); K:=0; N:=L_LEN(TOKS);
 WHILE K<N DO (
    T:=L_GET(TOKS,K); PRE:=RD(T,F_PRE);
    Q:=0; I:=0; PI:=0;
    WHILE I<S_LEN(PRE) DO (
       C:=GETB(PRE,I);
       ((C=34) OR (C=39)) => (Q:=C; PI:=I; I:=S_LEN(PRE)) ELSE I:=I+1);
    END:=-1;
    Q NE 0 => (
       J:=K; LIM:=K+14; LIM>N => LIM:=N; F:=1;
       WHILE F NE 0 DO (
          J<LIM => (
             TJ:=L_GET(TOKS,J);
             S_COUNT(RD(TJ,F_POST),Q)>0 => (END:=J; F:=0) ELSE J:=J+1)
          ELSE F:=0));
    END GE 0 => (
       LEAD:=S_SUB(PRE,0,PI); I:=PI+1; WR(T,F_PRE,S_FROM(PRE,I));
       TE:=L_GET(TOKS,END); TP:=RD(TE,F_POST);
       CUT:=0; WHILE GETB(TP,CUT) NE Q DO CUT:=CUT+1;
       I:=CUT+1; TRAIL:=S_FROM(TP,I); WR(TE,F_POST,S_SUB(TP,0,CUT));
       J:=END+1; INNER:=L_SLICE(TOKS,K,J);
       G:=GRP_NEW(Q,INNER,LEAD,TRAIL);
       END>K => L_ADD(GQ_TODO,G);
       L_ADD(R,G); K:=END+1)
    ELSE (L_ADD(R,T); K:=K+1));
 R);

# TOKENS BETWEEN MATCHING QUOTE MARKS BECOME A GROUP #
SUBR GROUP_QUOTES(TOKS) IS (
 R,G,I ARE LOCAL;
 R:=GQ_FLAT(TOKS);
 WHILE L_LEN(GQ_TODO)>0 DO (
    G:=L_POP(GQ_TODO); I:=GQ_FLAT(RD(G,F_TOKS)); WR(G,F_TOKS,I));
 R);

# A PARAGRAPH'S RAW TEXT TO A LIST OF TOKENS #
SUBR TOKENIZE(TXT,CS,GROUPS) IS (
 RAW,I,N,J,TOKS,W,F ARE LOCAL;
 SPANS:=L_NEW(0);
 RAW:=GRAB_SPANS(TXT);
 RAW:=S_SQUEEZE(RAW); RAW:=S_STRIP(RAW);
 RAW:=GRAB_STARS(RAW);
 TOKS:=L_NEW(0); N:=S_LEN(RAW); I:=0;
 WHILE I<N DO (
    J:=I; F:=1;
    WHILE F NE 0 DO (J<N => (GETB(RAW,J)=32 => F:=0 ELSE J:=J+1) ELSE F:=0);
    W:=S_SUB(RAW,I,J);
    S_LEN(W)>0 => WORD_TOKS(W,CS,TOKS);
    I:=J+1);
 VARNEXT_FIX(TOKS);
 GROUPS NE 0 => PAREN_GROUPS(TOKS);
 MERGE_LI(TOKS);
 CAPITALIZE(TOKS);
 GROUPS NE 0 => RETURN GROUP_QUOTES(TOKS);
 TOKS);

# ---- THE MDOC LINES OF A PARAGRAPH ---- #

SUBR TEXTWORD(T) IS (
 X ARE LOCAL;
 X:=S_CAT3(RD(T,F_PRE),RD(T,F_TEXT),RD(T,F_POST)); X:=UTF8IZE(X); ESCTEXT(X));

# THE LENGTH IN CHARACTERS OF THE ITEMS OF THE LIST JOINED WITH SPACES #
SUBR JOIN_LEN(L) IS (
 N,I,K ARE LOCAL;
 N:=L_LEN(L); I:=0; K:=0;
 WHILE I<N DO (K:=K+S_CLEN(L_GET(L,I)); I:=I+1);
 N>0 => K:=(K+N)-1;
 K);

# THE WORDS OF LINE JOINED WITH SPACES ARE A LINE OF OUT; LINE IS EMPTY AGAIN #
SUBR FLUSH_LINE(LINE,OUTL) IS (
 S ARE LOCAL;
 L_LEN(LINE)>0 => (S:=S_JOINL(LINE,LOC(' ')); L_ADD(OUTL,S); WR(LINE,0,0));
 0);

# [A-Z0-9)] AND THEN . ? OR ! AT THE END (A WORD THAT ENDS A SENTENCE) #
SUBR ENDS_PAT(S) IS (
 L ARE LOCAL;
 L:=S_LEN(S);
 L<2 => RETURN 0;
 IN_SET(GETB(S,L-1),LOC('.?!'))=0 => RETURN 0;
 ((IS_LOW(GETB(S,L-2)) NE 0) OR (IS_DIG(GETB(S,L-2)) NE 0) OR (GETB(S,L-2)=41)));

# THE POST OF A TOKEN AS THE END OF A LINE: A SPACE AND ITS CHARACTERS SEPARATED BY SPACES #
SUBR POSTPART(P) IS (
 S_LEN(P)=0 => RETURN S_E(0);
 S_CAT(LOC(' '),S_JOINC(P)));

# THE TOKENS TO MDOC LINES ADDED TO OUTL (THE PYTHON'S RECURSION ON THE TOKENS OF A QUOTED GROUP IS A STACK OF FRAMES) #
SUBR EMIT_PAR(TOKS0,OUT0) IS (
 TOKS,OUTL,I,N,LINE,GT,FST,T,KIND,NXT,TXT,ENDS,DOFL,INNER,QUOTE,PRE,POST,CODEY,N1,COND,X,Y,Z,K,TEXT,HEAD,F,G,SUB,SIMPLE,MACRO,PARTS,ARGS,J,CODE,A,PP,S1,WL,EM ARE LOCAL;
 EM:=S_E(0);
 FST:=L_NEW(0); TOKS:=TOKS0; OUTL:=OUT0; GT:=0; I:=0; N:=L_LEN(TOKS); LINE:=L_NEW(0);
 EL: I<N => (
    T:=L_GET(TOKS,I); KIND:=RD(T,F_KIND);
    KIND=KW => (
       L_ADD(LINE,TEXTWORD(T));
       NXT:=0; (I+1)<N => NXT:=L_GET(TOKS,I+1);
       TXT:=S_CAT(RD(T,F_TEXT),RD(T,F_POST));
       ENDS:=0;
       ENDS_PAT(TXT) NE 0 => (ENDS_ABBR(TXT,ABBR2_L)=0 => ENDS:=1);
       DOFL:=0;
       JOIN_LEN(LINE)>66 => DOFL:=1;
       ENDS NE 0 => (
          NXT=0 => DOFL:=1
          ELSE (RD(NXT,F_KIND) NE KW => DOFL:=1 ELSE (IS_UP(GETB(RD(NXT,F_TEXT),0)) NE 0 => DOFL:=1)));
       DOFL NE 0 => FLUSH_LINE(LINE,OUTL);
       I:=I+1; GO TO EL);
    KIND=KGROUP => (
       FLUSH_LINE(LINE,OUTL);
       INNER:=RD(T,F_TOKS); QUOTE:=RD(T,F_QUOTE); PRE:=RD(T,F_PRE); POST:=RD(T,F_POST);
       N1:=L_LEN(INNER); CODEY:=0; K:=0;
       WHILE K<N1 DO (
          X:=L_GET(INNER,K); Y:=RD(X,F_KIND);
          ((Y=KLI) OR (Y=KAR) OR (Y=KIC) OR (Y=KPA)) => CODEY:=1;
          K:=K+1);
       COND:=CODEY;
       ((N1=1) AND (QUOTE=39)) => COND:=1;
       N1=1 => (X:=L_GET(INNER,0); S_ANY(RD(X,F_TEXT),ALNUM_SET)=0 => COND:=1);
       COND NE 0 => (
          # THE TOKENS AS LITERAL TEXT #
          TEXT:=L_NEW(0); K:=0;
          WHILE K<N1 DO (
             X:=L_GET(INNER,K);
             RD(X,F_KIND) NE KGROUP => (Y:=S_CAT3(RD(X,F_PRE),RD(X,F_TEXT),RD(X,F_POST)); L_ADD(TEXT,Y))
             ELSE (QUOTE=34 => 0 ELSE L_ADD(TEXT,EM));
             K:=K+1);
          TXT:=S_JOINL(TEXT,LOC(' '));
          Z:=ESC(TXT,1); Y:=POSTPART(POST);
          QUOTE=34 => (
             S_LEN(PRE)>0 => (X:=ESC(PRE,0); HEAD:=S_CAT3(LOC('.Pf '),X,LOC(' Dq Li ')))
             ELSE HEAD:=LOC('.Dq Li '))
          ELSE (
             S_LEN(PRE)>0 => (X:=ESC(PRE,0); HEAD:=S_CAT3(LOC('.Pf '),X,LOC(' Ql ')))
             ELSE HEAD:=LOC('.Ql '));
          X:=S_CAT3(HEAD,Z,Y); L_ADD(OUTL,X);
          I:=I+1; GO TO EL);
       # A QUOTED GROUP OF PROSE: ITS TOKENS ARE EMITTED INTO A LIST OF THEIR OWN, AFTER A FRAME IS PUSHED #
       F:=CCALL calloc(8,8);
       WR(F,0,TOKS); WR(F,1,I); WR(F,2,N); WR(F,3,LINE); WR(F,4,OUTL); WR(F,5,GT); L_ADD(FST,F);
       GT:=T; TOKS:=INNER; I:=0; N:=L_LEN(INNER); LINE:=L_NEW(0); OUTL:=L_NEW(0);
       GO TO EL);
    # A WORD OF THE LANGUAGE, A VARIABLE, A CODE, A FILE NAME: A RUN OF TOKENS OF THE SAME KIND IS ONE MACRO LINE #
    MACRO:=KMAC(KIND); PRE:=RD(T,F_PRE);
    ARGS:=L_NEW(0); J:=I; F:=1;
    WHILE F NE 0 DO (
       J<N => (
          X:=L_GET(TOKS,J);
          RD(X,F_KIND)=KIND => (
             COND:=0;
             J=I => COND:=1;
             J>I => (Y:=L_GET(TOKS,J-1); ((S_LEN(RD(X,F_PRE))=0) AND (S_LEN(RD(Y,F_POST))=0)) => COND:=1);
             COND NE 0 => (L_ADD(ARGS,RD(X,F_TEXT)); J:=J+1) ELSE F:=0)
          ELSE F:=0)
       ELSE F:=0);
    Y:=L_GET(TOKS,J-1); POST:=RD(Y,F_POST);
    FLUSH_LINE(LINE,OUTL);
    CODE:=0;
    ((KIND=KLI) OR (KIC=KIND) OR (KIND=KPA)) => CODE:=1;
    KIND=KSY => (X:=S_JOINL(ARGS,LOC(' ')); ARGS:=L_NEW(0); L_ADD(ARGS,X));
    PARTS:=L_NEW(0);
    S_LEN(PRE)>0 => (X:=ESC(PRE,0); X:=S_CAT3(LOC('.Pf '),X,LOC(' ')); X:=S_CAT(X,MACRO); L_ADD(PARTS,X))
    ELSE (X:=S_CAT(LOC('.'),MACRO); L_ADD(PARTS,X));
    ((KIND=KLI) AND (L_LEN(ARGS)>1)) => (X:=S_JOINL(ARGS,LOC(' ')); ARGS:=L_NEW(0); L_ADD(ARGS,X));
    K:=0; N1:=L_LEN(ARGS);
    WHILE K<N1 DO (
       X:=L_GET(ARGS,K);
       CODE=0 => X:=UTF8IZE(X);
       Y:=ESC(X,CODE); L_ADD(PARTS,Y); K:=K+1);
    Y:=L_GET(TOKS,J-1);
    S_LEN(RD(Y,F_SUF))>0 => (L_ADD(PARTS,LOC('Ns')); X:=ESC(RD(Y,F_SUF),0); L_ADD(PARTS,X));
    K:=0;
    WHILE K<S_LEN(POST) DO (L_ADD(PARTS,S_C(GETB(POST,K))); K:=K+1);
    X:=S_JOINL(PARTS,LOC(' ')); L_ADD(OUTL,X);
    I:=J; GO TO EL);
 FLUSH_LINE(LINE,OUTL);
 L_LEN(FST)=0 => RETURN 0;
 # THE GROUP THAT THIS FRAME WAS FOR IS DONE: ITS LINES ARE SUB #
 SUB:=OUTL; G:=GT; F:=L_POP(FST);
 TOKS:=RD(F,0); I:=RD(F,1); N:=RD(F,2); LINE:=RD(F,3); OUTL:=RD(F,4); GT:=RD(F,5);
 QUOTE:=RD(G,F_QUOTE); PRE:=RD(G,F_PRE); POST:=RD(G,F_POST);
 SIMPLE:=0;
 L_LEN(SUB)=1 => (S1:=L_GET(SUB,0); GETB(S1,0) NE 46 => SIMPLE:=1);
 Y:=POSTPART(POST);
 S_LEN(PRE)>0 => (X:=ESC(PRE,0); HEAD:=S_CAT3(LOC('.Pf '),X,LOC(' '))) ELSE HEAD:=LOC('.');
 QUOTE=34 => MACRO:=LOC('Dq') ELSE MACRO:=LOC('Sq');
 SIMPLE NE 0 => (
    WL:=L_NEW(0); A:=0;
    # THE WORDS OF THE LINE SPLIT AT EVERY SPACE (EMPTY WORDS TOO) #
    PP:=0;
    WHILE PP GE 0 DO (
       J:=S_INDEX(S1,LOC(' '),PP);
       J<0 => (X:=S_FROM(S1,PP); X:=ESC(X,0); L_ADD(WL,X); PP:=-1)
       ELSE (X:=S_SUB(S1,PP,J); X:=ESC(X,0); L_ADD(WL,X); PP:=J+1));
    X:=S_JOINL(WL,LOC(' '));
    X:=S_CAT3(HEAD,MACRO,LOC(' ')) ;
    Z:=S_JOINL(WL,LOC(' '));
    X:=S_CAT3(X,Z,Y); L_ADD(OUTL,X))
 ELSE (
    QUOTE=34 => (X:=S_CAT(HEAD,LOC('Do'))) ELSE (X:=S_CAT(HEAD,LOC('So')));
    L_ADD(OUTL,X); L_EXT(OUTL,SUB);
    QUOTE=34 => (X:=LOC('.Dc')) ELSE (X:=LOC('.Sc'));
    X:=S_CAT(X,Y); L_ADD(OUTL,X));
 I:=I+1; GO TO EL)
%%
