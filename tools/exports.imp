#EXPORTS.IMP -- A HEADER FOR THE ROUTINES AND THE COMMON VARIABLES OF IMP72 SOURCES, FOR THE LANGUAGES THAT CALL THEM (ROADMAP 8).  THE COMPILER OF THE TREE BUILDS IT (SH TOOLS/IMPTOOL.SH EXPORTS ...), AS IT DOES IMP-CIMPORT, WHICH IT IS THE OTHER WAY AROUND OF.

    EXPORTS [-c | -z | -r] [-n NAME] [-o FILE] SOURCE ...

IT READS THE SOURCES AS TEXT (THE COMMENTS AND THE STRINGS ARE SKIPPED) AND WRITES, FOR EACH SUBR AND EACH VARIABLE DECLARED COMMON, THE DECLARATION THAT C (-c, THE DEFAULT), ZIG (-z) OR RUST (-r) NEEDS TO USE IT.  A SUBR IS A FUNCTION WHOSE PARAMETERS ARE POINTERS TO WORDS AND WHOSE RESULT IS A WORD,
SO THE DECLARATION OF SUBR ADD2(A,B) IS INT64_T ADD2(INT64_T *A, INT64_T *B); (THE PARAMETERS STAY BY REFERENCE, WHICH IS WHAT THEY ARE); A COMMON VARIABLE IS EXTERN INT64_T X; OR, DECLARED WITH A LENGTH (A IS COMMON,8 LONG), AN ARRAY.  THE NAMES ARE AS WRITTEN: IMP72 NAMES ARE CASE SENSITIVE AND A SYMBOL IS ITS NAME.  A PARAMETER NAMED
AS A KEYWORD OF THE LANGUAGE WRITTEN FOR GETS AN UNDERSCORE AFTER IT.  -n NAME IS THE NAME OF THE HEADER (THE GUARD OF A C HEADER), BY DEFAULT THAT OF THE FIRST SOURCE.  NOT DONE: A TYPED EXPORT (EXPORT INT F(INT)), WHICH THE LANGUAGE DOES NOT HAVE, AND THE SYMBOLS OF AN OBJECT FILE, WHICH SAY NOTHING OF THE PARAMETERS.#

EXTERNAL PTR fopen(PTR, PTR);
EXTERNAL PTR fdopen(INT, PTR);
EXTERNAL INT fclose(PTR);
EXTERNAL SIZE fread(PTR, SIZE, SIZE, PTR);
EXTERNAL INT fputs(PTR, PTR);
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL LONG write(INT, PTR, SIZE);
EXTERNAL VOID exit(INT);
EXTERNAL SIZE strlen(PTR);
EXTERNAL INT strcmp(PTR, PTR);
EXTERNAL PTR strdup(PTR);
EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL PTR realloc(PTR, SIZE);
EXTERNAL INT atoi(PTR);
EXTERNAL PTR strrchr(PTR, INT);
EXTERNAL INT toupper(INT);
EXTERNAL PTR strstr(PTR, PTR);

LNB IS 80 LONG;
LNB2 IS 80 LONG;
ARGW IS 1 LONG;

# THE MAIN PROGRAM #
CNM:=CCALL calloc(40,8); TXT:=CCALL calloc(320,1); GUARD:=CCALL calloc(80,1); HK:=CCALL calloc(64,8); HT:=CCALL calloc(64,8); HN:=0; NIT:=0;
ITK:=CCALL calloc(1024,8); ITN:=CCALL calloc(1024,8); ITP:=CCALL calloc(1024,8); ITNP:=CCALL calloc(1024,8); ITA:=CCALL calloc(1024,8);
OUTF:=0; LANG:=0; NFILES:=0; FILES:=CCALL calloc(64,8); GNAME:=0;
NA:=CCALL impargc(0);
I:=1;
AL: I<NA => (
    IMPARGET(LOC(ARGW),impargvp(0),I);
    ARG:=ARGW; I:=I+1;
    (S_EQ(ARG,LOC('-h')) OR S_EQ(ARG,LOC('--help'))) => USAGE(0);
    S_EQ(ARG,LOC('-c')) => (LANG:=0; GO TO AL);
    S_EQ(ARG,LOC('-z')) => (LANG:=1; GO TO AL);
    S_EQ(ARG,LOC('-r')) => (LANG:=2; GO TO AL);
    (S_EQ(ARG,LOC('-n')) OR S_EQ(ARG,LOC('-o'))) => (
       I GE NA => DIE(LOC('missing value for'),ARG);
       IMPARGET(LOC(ARGW),impargvp(0),I); VAL:=ARGW; I:=I+1;
       S_EQ(ARG,LOC('-n')) => (GNAME:=VAL; GO TO AL);
       OUTF:=CCALL fopen(VAL,LOC('w'));
       OUTF=0 => DIE(LOC('cannot write'),VAL);
       GO TO AL);
    GETB(ARG,0)=45 => DIE(LOC('unknown option'),ARG);
    NFILES<64 => (WR(FILES,NFILES,ARG); NFILES:=NFILES+1);
    GO TO AL);
NFILES=0 => USAGE(0);
OUTF=0 => OUTF:=CCALL fdopen(1,LOC('w'));
GNAME NE 0 => GUARDOF(GNAME) ELSE GUARDOF(RD(FILES,0));
K:=0;
FL: K<NFILES => (
    SLURP(RD(FILES,K)); BP:=0;
    ML: NEXT(0); TKK=0 => GO TO FD;
        PUSH(0);
        TKK=1 => (S_EQ(TXT,LOC('SUBR')) => (DOSUBR(0); GO TO ML);
                  S_EQ(TXT,LOC('COMMON')) => (DOCOMMON(0); GO TO ML));
        GO TO ML;
    FD: K:=K+1; GO TO FL);
LANG=0 => OUTC(0);
LANG=1 => OUTZ(0);
LANG=2 => OUTR(0);
CCALL fclose(OUTF);
0
;

SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR RD(P,I) IS (
 Q,K ARE LOCAL;
 K:=8*I; Q:=P+K; [Q]);

SUBR WR(P,I,V) IS (
 Q,K ARE LOCAL;
 K:=8*I; Q:=P+K; [Q]:=V; 0);

SUBR S_EQ(A,B) IS (CCALL strcmp(A,B)=0);

SUBR DIE(M,A) IS (
 CCALL write(2,'exports: ',9); CCALL write(2,M,CCALL strlen(M));
 A NE 0 => (CCALL write(2,': ',2); CCALL write(2,A,CCALL strlen(A)));
 CCALL write(2,"\n",1);
 CCALL exit(1));

# IS THE CHARACTER C A LETTER OF AN IMP72 NAME (LETTERS, DIGITS, _ AND THE BYTES OF 128 AND UP) #
SUBR ISNM(C) IS (
 X ARE LOCAL;
 X:=C;
 X GE 48 => (X LE 57 => RETURN 1);
 X GE 65 => (X LE 90 => RETURN 1);
 X GE 97 => (X LE 122 => RETURN 1);
 X=95 => RETURN 1;
 X GE 128 => RETURN 1;
 0);

# THE NEXT TOKEN OF THE SOURCE IN BUF: TKK 1 A NAME, 2 A NUMBER, 3 ANY OTHER CHARACTER, 4 A STRING, 0 THE END; ITS TEXT IS IN TXT (A STRING'S IS EMPTY).  COMMENTS BETWEEN NUMBER SIGNS ARE SKIPPED #
SUBR NEXT(Z) IS (
 C,N,Q ARE LOCAL;
 N:=0;
 NX0: BP GE BL => (TKK:=0; RETURN 0);
      C:=GETB(BUF,BP); BP:=BP+1;
      C LE 32 => GO TO NX0;
      C=35 => (NX1: BP GE BL => (TKK:=0; RETURN 0);
               C:=GETB(BUF,BP); BP:=BP+1;
               C NE 35 => GO TO NX1;
               GO TO NX0);
      C=39 => (NX2: BP GE BL => (TKK:=0; RETURN 0);
               C:=GETB(BUF,BP); BP:=BP+1;
               C NE 39 => GO TO NX2;
               BP<BL => (GETB(BUF,BP)=39 => (BP:=BP+1; GO TO NX2));
               TKK:=4; PUTB(TXT,0,0); RETURN 1);
      C=33 => (NX4: BP GE BL => (TKK:=0; RETURN 0);
               C:=GETB(BUF,BP); BP:=BP+1;
               C NE 33 => GO TO NX4;
               TKK:=4; PUTB(TXT,0,0); RETURN 1);
      C=34 => (NX3: BP GE BL => (TKK:=0; RETURN 0);
               C:=GETB(BUF,BP); BP:=BP+1;
               C=92 => (BP:=BP+1; GO TO NX3);
               C NE 34 => GO TO NX3;
               TKK:=4; PUTB(TXT,0,0); RETURN 1);
      ISNM(C) NE 0 => (
          C GE 48 => (C LE 57 => TKK:=2 ELSE TKK:=1) ELSE TKK:=1;
          NX5: N<290 => (PUTB(TXT,N,C); N:=N+1);
               BP<BL => (ISNM(GETB(BUF,BP)) NE 0 => (C:=GETB(BUF,BP); BP:=BP+1; GO TO NX5));
          PUTB(TXT,N,0); RETURN 1);
      TKK:=3; PUTB(TXT,0,C); PUTB(TXT,1,0); 1);

# THE TOKEN IN TXT IS KEPT IN THE HISTORY OF THE LAST 64 (THE NAMES BEFORE AN IS ARE FOUND BACKWARDS) #
SUBR PUSH(Z) IS (
 K ARE LOCAL;
 K:=HN-(64*(HN/64));
 WR(HK,K,TKK); WR(HT,K,CCALL strdup(TXT));
 HN:=HN+1; 0);

# THE KIND AND THE TEXT OF THE TOKEN BACK BEFORE THE LAST ONE: B 0 IS THE LAST, 1 THE ONE BEFORE; THE TEXT OF NONE IS 0 #
SUBR HIST(B,WHAT) IS (
 K,BB ARE LOCAL;
 BB:=B;
 BB GE HN => RETURN 0;
 K:=(HN-1)-BB; K:=K-(64*(K/64));
 WHAT=0 => RETURN RD(HK,K);
 RD(HT,K));

# THE NAME N IS AN ITEM ALREADY (A VARIABLE DECLARED COMMON IN MORE THAN ONE SOURCE) #
SUBR HAVE(NM,KIND) IS (
 J ARE LOCAL;
 J:=0;
 HV1: J<NIT => (RD(ITK,J)=KIND => (S_EQ(RD(ITN,J),NM) NE 0 => RETURN 1);
                J:=J+1; GO TO HV1);
 0);

SUBR ADDIT(KIND,NM) IS (
 N ARE LOCAL;
 N:=NIT;
 WR(ITK,N,KIND); WR(ITN,N,CCALL strdup(NM)); WR(ITP,N,CCALL calloc(40,8)); WR(ITNP,N,0); WR(ITA,N,0);
 NIT:=N+1; N);

# SUBR NAME(PARAMETERS): THE ROUTINE AND ITS PARAMETERS, NIL FOR NONE #
SUBR DOSUBR(Z) IS (
 IT,NP ARE LOCAL;
 NEXT(0); TKK NE 1 => RETURN 0;
 PUSH(0);
 HAVE(TXT,1) NE 0 => RETURN 0;
 IT:=ADDIT(1,TXT);
 NEXT(0); TKK=0 => RETURN 0;
 PUSH(0);
 TKK=3 => (GETB(TXT,0)=40 => (
     NP:=0;
     DS1: NEXT(0); TKK=0 => RETURN 0;
          PUSH(0);
          TKK=3 => (GETB(TXT,0)=41 => (WR(ITNP,IT,NP); RETURN 0));
          TKK=1 => (S_EQ(TXT,LOC('NIL'))=0 => (NP<38 => (WR(RD(ITP,IT),NP,CCALL strdup(TXT)); NP:=NP+1)));
          GO TO DS1));
 0);

# X ARE COMMON, OR X IS COMMON, WITH A LENGTH AFTER IT, COMMON,8 LONG, FOR AN ARRAY; THE NAMES ARE THE ONES BEFORE THE IS OR ARE #
SUBR DOCOMMON(Z) IS (
 B,N,J,SZ,I2 ARE LOCAL;
 HIST(1,0)=1 => ((S_EQ(HIST(1,1),LOC('IS')) OR S_EQ(HIST(1,1),LOC('ARE'))) NE 0 => GO TO DC0);
 RETURN 0;
 DC0: B:=2; N:=0;
 DC1: HIST(B,0)=1 => (WR(CNM,N,HIST(B,1)); N:=N+1;
                      HIST(B+1,0)=3 => (GETB(HIST(B+1,1),0)=44 => (B:=B+2; GO TO DC1)));
 SZ:=0;
 NEXT(0);
 TKK=3 => (GETB(TXT,0)=44 => (PUSH(0); NEXT(0); TKK=2 => (PUSH(0); SZ:=CCALL atoi(TXT) AND 4294967295; NEXT(0); PUSH(0)))
            ELSE PUSH(0))
   ELSE (TKK NE 0 => PUSH(0));
 I2:=N-1;
 DC2: I2 GE 0 => (HAVE(RD(CNM,I2),2)=0 => (J:=ADDIT(2,RD(CNM,I2)); WR(ITA,J,SZ));
                  I2:=I2-1; GO TO DC2);
 0);

# THE KEYWORDS OF THE LANGUAGES THE PARAMETER NAMES GO TO: A NAME THAT IS ONE GETS AN UNDERSCORE AFTER IT #
SUBR KEYW(NM,L) IS (
 LST,P ARE LOCAL;
 L=0 => LST:=LOC(' auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while ');
 L=1 => LST:=LOC(' addrspace align allowzero and anyframe type anytype asm async await break callconv catch comptime const continue defer else enum errdefer error export extern fn for if inline linksection noalias nosuspend opaque or orelse packed pub resume return struct suspend switch test threadlocal try union unreachable usingnamespace var volatile while ');
 L=2 => LST:=LOC(' as break const continue crate else enum extern false fn for if impl in let loop match mod move mut pub ref return self Self static struct super trait true type unsafe use where while async await dyn abstract become box do final macro override priv typeof unsized virtual yield try ');
 CCALL snprintf(LOC(LNB),300,LOC(' %s '),NM);
 CCALL strstr(LST,LOC(LNB)) NE 0 => 1 ELSE 0);

# THE PARAMETER NAME, A KEYWORD OF THE LANGUAGE L GETTING AN UNDERSCORE, IN LNB #
SUBR PNAME(NM,L) IS (
 KEYW(NM,L) NE 0 => CCALL snprintf(LOC(LNB),300,LOC('%s_'),NM) ELSE CCALL snprintf(LOC(LNB),300,LOC('%s'),NM);
 0);

SUBR PUT(S) IS (CCALL fputs(S,OUTF); 0);

# THE DECLARATIONS, FOR C #
SUBR OUTC(Z) IS (
 J,K,NP,L2 ARE LOCAL;
 PUT(LOC("/* the routines and variables of the IMP72 sources, for C (written by exports) */\n"));
 CCALL snprintf(LOC(LNB),300,LOC("#ifndef %s_H\n#define %s_H\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"),GUARD,GUARD); PUT(LOC(LNB));
 J:=0;
 OC1: J<NIT => (
     RD(ITK,J)=1 => (
         CCALL snprintf(LOC(LNB2),600,LOC('int64_t %s('),RD(ITN,J)); PUT(LOC(LNB2));
         NP:=RD(ITNP,J);
         NP=0 => PUT(LOC('void'));
         K:=0; OC2: K<NP => (K>0 => PUT(LOC(', ')); PNAME(RD(RD(ITP,J),K),0); CCALL snprintf(LOC(LNB2),600,LOC('int64_t *%s'),LOC(LNB)); PUT(LOC(LNB2)); K:=K+1; GO TO OC2);
         PUT(LOC(");\n")))
       ELSE (RD(ITA,J)=0 => CCALL snprintf(LOC(LNB2),600,LOC("extern int64_t %s;\n"),RD(ITN,J))
              ELSE CCALL snprintf(LOC(LNB2),600,LOC("extern int64_t %s[%d];\n"),RD(ITN,J),RD(ITA,J)); PUT(LOC(LNB2)));
     J:=J+1; GO TO OC1);
 PUT(LOC("\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"));
 0);

# THE DECLARATIONS, FOR ZIG #
SUBR OUTZ(Z) IS (
 J,K,NP ARE LOCAL;
 PUT(LOC("// the routines and variables of the IMP72 sources, for Zig (written by exports)\n\n"));
 J:=0;
 OZ1: J<NIT => (
     RD(ITK,J)=1 => (
         CCALL snprintf(LOC(LNB2),600,LOC('pub extern fn %s('),RD(ITN,J)); PUT(LOC(LNB2));
         NP:=RD(ITNP,J);
         K:=0; OZ2: K<NP => (K>0 => PUT(LOC(', ')); PNAME(RD(RD(ITP,J),K),1); CCALL snprintf(LOC(LNB2),600,LOC('%s: *i64'),LOC(LNB)); PUT(LOC(LNB2)); K:=K+1; GO TO OZ2);
         PUT(LOC(") i64;\n")))
       ELSE (RD(ITA,J)=0 => CCALL snprintf(LOC(LNB2),600,LOC("pub extern var %s: i64;\n"),RD(ITN,J))
              ELSE CCALL snprintf(LOC(LNB2),600,LOC("pub extern var %s: [%d]i64;\n"),RD(ITN,J),RD(ITA,J)); PUT(LOC(LNB2)));
     J:=J+1; GO TO OZ1);
 0);

# THE DECLARATIONS, FOR RUST #
SUBR OUTR(Z) IS (
 J,K,NP ARE LOCAL;
 PUT(LOC("// the routines and variables of the IMP72 sources, for Rust (written by exports)\n\n#[allow(non_snake_case, non_upper_case_globals)]\nextern \"C\" {\n"));
 J:=0;
 OR1: J<NIT => (
     RD(ITK,J)=1 => (
         CCALL snprintf(LOC(LNB2),600,LOC('    pub fn %s('),RD(ITN,J)); PUT(LOC(LNB2));
         NP:=RD(ITNP,J);
         K:=0; OR2: K<NP => (K>0 => PUT(LOC(', ')); PNAME(RD(RD(ITP,J),K),2); CCALL snprintf(LOC(LNB2),600,LOC('%s: *mut i64'),LOC(LNB)); PUT(LOC(LNB2)); K:=K+1; GO TO OR2);
         PUT(LOC(") -> i64;\n")))
       ELSE (RD(ITA,J)=0 => CCALL snprintf(LOC(LNB2),600,LOC("    pub static mut %s: i64;\n"),RD(ITN,J))
              ELSE CCALL snprintf(LOC(LNB2),600,LOC("    pub static mut %s: [i64; %d];\n"),RD(ITN,J),RD(ITA,J)); PUT(LOC(LNB2)));
     J:=J+1; GO TO OR1);
 PUT(LOC("}\n"));
 0);

SUBR USAGE(Z) IS (
 CCALL write(2,"usage: exports [-c | -z | -r] [-n NAME] [-o FILE] SOURCE ...\n  -c C (default), -z Zig, -r Rust; -n the name of the header; -o the file (else the standard output)\n",143);
 CCALL exit(2));

# THE SOURCE AT PATH, ALL OF IT, IN BUF (BL BYTES) #
SUBR SLURP(PATH) IS (
 F,N,CAP ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('r'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CAP:=65536; BUF:=CCALL calloc(CAP+8,1); BL:=0;
 SL1: N:=CCALL fread(BUF+BL,1,4096,F);
      N>0 => (BL:=BL+N;
              (BL+4096)>CAP => (CAP:=CAP*2; BUF:=CCALL realloc(BUF,CAP+8));
              GO TO SL1);
 CCALL fclose(F);
 0);

# THE GUARD OF A C HEADER FROM THE NAME OF A FILE: ITS BASE NAME IN CAPITALS, A LETTER OR A DIGIT EACH, ANY OTHER CHARACTER AN UNDERSCORE #
SUBR GUARDOF(PATH) IS (
 P,N,C ARE LOCAL;
 P:=CCALL strrchr(PATH,47);
 P=0 => P:=PATH ELSE P:=P+1;
 N:=0;
 GD1: C:=GETB(P,N); C=0 => (PUTB(GUARD,N,0); RETURN 0);
      C=46 => (PUTB(GUARD,N,0); RETURN 0);
      ISNM(C) NE 0 => (C GE 97 => (C LE 122 => C:=C-32)) ELSE C:=95;
      N<60 => (PUTB(GUARD,N,C); N:=N+1);
      GO TO GD1)
%%
