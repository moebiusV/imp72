#IMP-TRACE.IMP -- A PROGRAM OF IMP-FUZZ2.PY WITH A PRINT OF THE SUBROUTINE'S VARIABLES AFTER EVERY STATEMENT OF EVERY SUBR BODY, SO THAT TWO IMPLEMENTATIONS CAN BE COMPARED STATEMENT BY STATEMENT (THE FIRST LINE WHERE THEIR OUTPUT DIFFERS NAMES THE STATEMENT).  THE COMPILER BUILDS IT (TOOLS/IMPTOOL.SH).

    IMP-TRACE IN.IMP OUT.IMP

A LINE "SUBR NAME(P1,P2) IS (S1; S2; S3)" (OR THE SAME ENDED BY ";") BECOMES THE SAME WITH, BETWEEN THE STATEMENTS (SPLIT AT THE ; OUTSIDE ( ) AND [ ]),
        PRINT STG 0,'NAME',IGR 6,P1,IGR 6,P2,IGR 6,LAME0,IGR 6,LAME1,IGR 6,A,IGR 6,B,IGR 6,C,IGR 6,D,/
(LAME0 IS "L", THE NAME WITHOUT ITS FIRST LETTER, AND 0).  EVERY OTHER LINE IS COPIED.  IT REPLACES TOOLS/IMP-TRACE.PY, BYTE FOR BYTE.#

BUF,N,WORD,NA,F,NS,NE,PS,PE,BS,BE,SEMI,LB,LF ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
NA NE 3 => DIE(LOC('usage'),LOC('imp-trace IN.imp OUT.imp'));
SLURP(ARG(1));
F:=CCALL fopen(ARG(2),LOC('wb'));
F=0 => DIE(LOC('cannot write'),ARG(2));
LB:=0;
L0: LF:=LB;
    WHILE LF<N DO (GETB(BUF,LF)=10 => GO TO L1; LF:=LF+1);   # (A WHILE ON  A AND B  DOES NOT RUN: THIS COMPILER) #
L1:
    DOLINE(LB,LF);
    LF<N => (CCALL fputc(10,F); LB:=LF+1; GO TO L0);
CCALL fclose(F);
CCALL exit(0);

SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

SUBR DIE(M,A) IS (
 CCALL write(2,M,CCALL strlen(M)); CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

SUBR SLURP(PATH) IS (
 G ARE LOCAL;
 G:=CCALL fopen(PATH,LOC('rb'));
 G=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(G,0,2); N:=CCALL ftell(G); CCALL fseek(G,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => CCALL fread(BUF,1,N,G) NE N => DIE(LOC('cannot read'),PATH);
 CCALL fclose(G);
 0);

# THE BYTES A TO B (EXCLUSIVE) OF THE INPUT ON THE OUTPUT, AND A STRING #
SUBR PUTR(A,B) IS (
 B>A => CCALL fwrite(BUF+A,1,B-A,F);
 0);

SUBR PUTS(P) IS (CCALL fputs(P,F); 0);

SUBR ISW(C) IS (((C>47) AND (C<58)) OR ((C>64) AND (C<91)) OR ((C>96) AND (C<123)) OR (C=95));

SUBR ISSP(C) IS ((C=32) OR ((C>8) AND (C<14)));

# IS THE STRING AT P (ZERO ENDED) AT INDEX I OF THE INPUT, WITHIN A LINE ENDING AT E? #
SUBR HAS(P,I,E) IS (
 L ARE LOCAL;
 L:=CCALL strlen(P);
 (I+L)>E => RETURN 0;
 CCALL memcmp(BUF+I,P,L)=0 => RETURN 1;
 0);

# DOES THE LINE S..E LOOK LIKE  SUBR NAME(PARAMS) IS (BODY)  OR THE SAME WITH ;?  IF SO: NAME NS..NE, PARAMS PS..PE, BODY BS..BE, SEMI #
SUBR MATCH(S,E) IS (
 I,T ARE LOCAL;
 HAS(LOC('SUBR '),S,E)=0 => RETURN 0;
 I:=S+5; NS:=I;
 WHILE I<E DO (ISW(GETB(BUF,I))=0 => GO TO M1; I:=I+1);
 M1:
 I=NS => RETURN 0;
 NE:=I;
 I GE E => RETURN 0;
 GETB(BUF,I) NE 40 => RETURN 0;
 I:=I+1; PS:=I;
 WHILE I<E DO (GETB(BUF,I)=41 => GO TO M2; I:=I+1);
 M2:
 I GE E => RETURN 0;
 PE:=I;
 HAS(LOC(') IS ('),I,E)=0 => RETURN 0;
 BS:=I+6;
 T:=E; SEMI:=0;
 T>S => (GETB(BUF,T-1)=59 => (SEMI:=1; T:=T-1));
 T LE BS => RETURN 0;
 GETB(BUF,T-1) NE 41 => RETURN 0;
 BE:=T-1;
 1);

# THE PRINT: THE PARAMETERS (SPLIT AT EVERY COMMA, NOT STRIPPED), L<NAME-1>0, L<NAME-1>1, A, B, C, D #
SUBR TRACE(Z) IS (
 I,J ARE LOCAL;
 PUTS(LOC('PRINT STG 0,'));
 CCALL fputc(39,F); PUTR(NS,NE); CCALL fputc(39,F);
 I:=PS; J:=PS;
 L2: ((J=PE) OR (GETB(BUF,J)=44)) => (
        PUTS(LOC(',IGR 6,')); PUTR(I,J);
        J=PE => GO TO L3;
        J:=J+1; I:=J; GO TO L2);
     J:=J+1; GO TO L2;
 L3: PUTS(LOC(',IGR 6,L')); PUTR(NS+1,NE); PUTS(LOC('0,IGR 6,L')); PUTR(NS+1,NE);
 PUTS(LOC('1,IGR 6,A,IGR 6,B,IGR 6,C,IGR 6,D,/'));
 0);

# A PART OF THE BODY, STRIPPED #
SUBR PART(A,B) IS (
 X,Y ARE LOCAL;
 X:=A; Y:=B;
 WHILE X<Y DO (ISSP(GETB(BUF,X))=0 => GO TO P1; X:=X+1);
 P1:
 WHILE Y>X DO (ISSP(GETB(BUF,Y-1))=0 => GO TO P2; Y:=Y-1);
 P2:
 PUTR(X,Y);
 0);

SUBR DOLINE(S,E) IS (
 I,D,C,P ARE LOCAL;
 MATCH(S,E)=0 => RETURN PUTR(S,E);
 PUTR(S,PE+1); PUTS(LOC(' IS ('));          # (S..PE+1 IS "SUBR NAME(PARAMS)") #
 I:=BS; P:=BS; D:=0;
 L4: I<BE => (
       C:=GETB(BUF,I);
       ((C=40) OR (C=91)) => D:=D+1;
       ((C=41) OR (C=93)) => D:=D-1;
       ((C=59) AND (D=0)) => (PART(P,I); PUTS(LOC('; ')); TRACE(0); PUTS(LOC('; ')); P:=I+1);
       I:=I+1; GO TO L4);
 PART(P,BE);
 PUTS(LOC(')'));
 SEMI NE 0 => PUTS(LOC(';'));
 0)
%%
