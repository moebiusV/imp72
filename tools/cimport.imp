#CIMPORT.IMP -- THE DECLARATIONS OF A C HEADER AS AN IMP72 FILE OF DECLARATIONS (EXTERNAL, STRUCT, LET).  THE COMPILER OF THE TREE BUILDS IT (SH TOOLS/IMPTOOL.SH CIMPORT ARGS); IT IS INSTALLED AS IMP72-CIMPORT.

    CIMPORT [-n NAME] [-p PREFIX] [-D MACRO] [-I DIR] [-o FILE] HEADER
    CIMPORT [-n NAME] [-p PREFIX] [-o FILE] -i FILE

THE C PREPROCESSOR (THE CC OF THE ENVIRONMENT, -E) READS AN INCLUDE OF THE HEADER, OR -i NAMES A FILE (- IS THE STANDARD INPUT) OF TEXT THAT IT HAS PREPROCESSED.  THE TOOL READS THE DECLARATIONS OF THAT TEXT AND WRITES, FOR THE NAMES SELECTED (ALL WITHOUT -n AND -p),
EXTERNAL DECLARATIONS OF THE FUNCTIONS, STRUCT DECLARATIONS OF THE STRUCTURES AND LET DECLARATIONS OF THE ENUMERATORS, AND OF THE MACROS NAMED BY -D, WHICH THE C COMPILER EVALUATES.  WHAT IT CANNOT EXPRESS IS LISTED IN A COMMENT AT THE END OF THE OUTPUT,
WITH THE REASON.  THE PROGRAM IS IN FOUR FILES (THE COMPILER NAMES ONLY 2047 REGISTERS IN A FILE): CIMPORT.IMP (THIS ONE: THE STRINGS, THE LISTS, THE ARGUMENTS AND THE INPUT), CIMPORT-TOK.IMP (THE WORDS OF THE C TEXT), CIMPORT-PARSE.IMP (THE DECLARATIONS) AND
CIMPORT-OUT.IMP (THE SELECTION, THE OUTPUT AND THE PROBE OF MACROS).  STRINGS ARE C STRINGS, LISTS ARE BLOCKS OF THREE WORDS (COUNT, CAPACITY, ITEMS); THE VARIABLES OF A ROUTINE ARE STATIC, SO NO ROUTINE CALLS ITSELF; AN ARGUMENT IS PASSED BY REFERENCE, SO A TEXT
CONSTANT GIVEN TO A ROUTINE IS WRITTEN LOC('TEXT').#

LET CH_LF=10, CH_SP=32, CH_QUOTE=34, CH_APOS=39, CH_LP=40, CH_RP=41, CH_STAR=42, CH_COMMA=44, CH_SLASH=47, CH_SEMI=59, CH_EQ=61, CH_LB=91, CH_RB=93, CH_LC=123, CH_RC=125;
LET T_CHAR=1, T_UCHAR=2, T_SHORT=3, T_USHORT=4, T_INT=5, T_UINT=6, T_LONG=7, T_ULONG=8, T_LLONG=9, T_ULLONG=10, T_SIZE=11, T_PTR=12, T_DOUBLE=13, T_FLOAT=14, T_VOID=15, T_SBASE=100, T_BBASE=100000;

EXTERNAL PTR fopen(PTR, PTR);
EXTERNAL PTR fdopen(INT, PTR);
EXTERNAL INT fclose(PTR);
EXTERNAL SIZE fread(PTR, SIZE, SIZE, PTR);
EXTERNAL SIZE fwrite(PTR, SIZE, SIZE, PTR);
EXTERNAL INT fflush(PTR);
EXTERNAL PTR popen(PTR, PTR);
EXTERNAL INT pclose(PTR);
EXTERNAL PTR getenv(PTR);
EXTERNAL LONG write(INT, PTR, SIZE);
EXTERNAL VOID exit(INT);
EXTERNAL SIZE strlen(PTR);
EXTERNAL INT strcmp(PTR, PTR);
EXTERNAL INT strncmp(PTR, PTR, SIZE);
EXTERNAL PTR memcpy(PTR, PTR, SIZE);
EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL VOID free(PTR);

# THE VARIABLES THE FILES SHARE (THE SAME DECLARATIONS IN EACH OF THE FOUR FILES; A VARIABLE THAT IS NOT COMMON BELONGS TO ITS FILE) #
TK,NT,TKP,EMPTYS,TDN,TDT,STNAME,STTAG,STSTATE,STBODY,STWHY,STDEPS,STNEED,STEMIT,ALN,ALI,BADL,FNN,FNT,FNW,CNN,CNV,CNK,CNW ARE COMMON;
SELN,SELP,MACD,INCD,HDR,OUTP,INP,NSEL,TYN,RW,OUT,MACV,MACW,INLEN,DEFORD ARE COMMON;
SP_TYPE,SP_END,SP_TD,DNAME,DKIND,DSTARS,DGRP,DPS,DPE,DARRN,DBIT,DEND,DOK,EV_OK,EV_VAL,INBODY,CURB,CURDEPS,CURBAD,CURFIRST,ASKIP,AEND,NUMOK,NUMV,TDIR,TFC,TFX,LASTSZ,SZON ARE COMMON;
NA,ARGW,TEXT ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
SELN:=L_NEW(0); SELP:=L_NEW(0); MACD:=L_NEW(0); INCD:=L_NEW(0);
HDR:=0; OUTP:=0; INP:=0;
I:=1;
AL: I<NA => (
    IMPARGET(LOC(ARGW),impargvp(0),I);
    ARG:=ARGW; I:=I+1;
    (S_EQ(ARG,LOC('-h')) OR S_EQ(ARG,LOC('--help'))) => USAGE(0);
    (S_EQ(ARG,LOC('-n')) OR S_EQ(ARG,LOC('-p')) OR S_EQ(ARG,LOC('-D')) OR S_EQ(ARG,LOC('-I')) OR S_EQ(ARG,LOC('-o')) OR S_EQ(ARG,LOC('-i'))) => (
       I GE NA => DIE(LOC('missing value for'),ARG);
       IMPARGET(LOC(ARGW),impargvp(0),I); VAL:=ARGW; I:=I+1;
       S_EQ(ARG,LOC('-n')) => (L_ADD(SELN,VAL); GO TO AL);
       S_EQ(ARG,LOC('-p')) => (L_ADD(SELP,VAL); GO TO AL);
       S_EQ(ARG,LOC('-D')) => (SAFEID(VAL)=0 => DIE(LOC('not a macro name'),VAL); L_ADD(MACD,VAL); GO TO AL);
       S_EQ(ARG,LOC('-I')) => (SAFENAME(VAL)=0 => DIE(LOC('not a plain directory name'),VAL); L_ADD(INCD,VAL); GO TO AL);
       S_EQ(ARG,LOC('-o')) => (OUTP:=VAL; GO TO AL);
       INP:=VAL; GO TO AL);
    GETB(ARG,0)=45 => DIE(LOC('unknown option'),ARG);
    HDR NE 0 => DIE(LOC('more than one header'),ARG);
    HDR:=ARG;
    GO TO AL);
((HDR=0) AND (INP=0)) => USAGE(0);
((HDR NE 0) AND (INP NE 0)) => DIE(LOC('a header and -i together'),0);
((INP NE 0) AND (L_LEN(MACD) NE 0)) => DIE(LOC('-D needs a header (cc evaluates the macros)'),0);
EMPTYS:=S_E(0);
INIT_TYPES(0);
INP NE 0 => TEXT:=READ_ALL(INP) ELSE TEXT:=PREPROCESS(HDR);
TOKENIZE(TEXT,INLEN);
PARSE_ALL(0);
OUT:=B_NEW(0);
WRITE_DECLS(0);
WRITE_FILE(0);
CCALL exit(0);

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

# THE WORD I OF THE BLOCK AT P, AND STORING ONE #
SUBR RD(P,I) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]);

SUBR WR(P,I,V) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]:=V; 0);

SUBR DIE(M,A) IS (
 NL ARE LOCAL;
 CCALL write(2,'imp-cimport: ',15); CCALL write(2,M,CCALL strlen(M));
 A NE 0 => (CCALL write(2,': ',2); CCALL write(2,A,CCALL strlen(A)));
 NL:=CCALL calloc(16,1); PUTB(NL,0,10); CCALL write(2,NL,1); CCALL exit(1));

SUBR WARN(M,A) IS (
 NL ARE LOCAL;
 CCALL write(2,'imp-cimport: ',15); CCALL write(2,M,CCALL strlen(M));
 A NE 0 => (CCALL write(2,' ',1); CCALL write(2,A,CCALL strlen(A)));
 NL:=CCALL calloc(16,1); PUTB(NL,0,10); CCALL write(2,NL,1); 0);

# THE EMPTY STRING (A TEXT CONSTANT CANNOT BE EMPTY) #
SUBR S_E(Z) IS CCALL calloc(16,1);

# A LIST OF WORDS: [COUNT, CAPACITY, ITEMS] #
SUBR L_NEW(Z) IS (
 B ARE LOCAL;
 B:=CCALL calloc(3,8); WR(B,1,8); WR(B,2,CCALL calloc(8,8)); B);

SUBR L_ADD(B,V) IS (
 N,CAP,P,NP ARE LOCAL;
 N:=RD(B,0); CAP:=RD(B,1); P:=RD(B,2);
 N=CAP => (NP:=CCALL calloc(CAP*2,8); CCALL memcpy(NP,P,CAP*8); CCALL free(P); WR(B,1,CAP*2); WR(B,2,NP); P:=NP);
 WR(P,N,V); WR(B,0,N+1); N);

SUBR L_GET(B,I) IS (
 P ARE LOCAL;
 P:=RD(B,2); RD(P,I));

SUBR L_SET(B,I,V) IS (
 P ARE LOCAL;
 P:=RD(B,2); WR(P,I,V));

SUBR L_LEN(B) IS RD(B,0);

# A BUFFER OF BYTES THAT GROWS: [LENGTH, CAPACITY, BYTES]; ITS BYTES ARE ALWAYS FOLLOWED BY ZEROS #
SUBR B_NEW(Z) IS (
 B ARE LOCAL;
 B:=CCALL calloc(3,8); WR(B,1,64); WR(B,2,CCALL calloc(80,1)); B);

SUBR B_CH(B,C) IS (
 N,CAP,P,NP ARE LOCAL;
 N:=RD(B,0); CAP:=RD(B,1); P:=RD(B,2);
 (N+2)>CAP => (NP:=CCALL calloc((CAP*2)+16,1); CCALL memcpy(NP,P,N); CCALL free(P); WR(B,1,CAP*2); WR(B,2,NP); P:=NP);
 PUTB(P,N,C); WR(B,0,N+1); 0);

# N BYTES AT P APPENDED #
SUBR B_APP(B,P,N) IS (
 L,CAP,D,NP,NC ARE LOCAL;
 L:=RD(B,0); CAP:=RD(B,1); D:=RD(B,2);
 (L+(N+2))>CAP => (NC:=(CAP*2)+N; NP:=CCALL calloc(NC+16,1); CCALL memcpy(NP,D,L); CCALL free(D); WR(B,1,NC); WR(B,2,NP); D:=NP);
 NP:=D+L; CCALL memcpy(NP,P,N); WR(B,0,L+N); 0);

SUBR B_STR(B,S) IS (
 N ARE LOCAL;
 N:=CCALL strlen(S); B_APP(B,S,N); 0);

# THE STRING S AND A NEW LINE #
SUBR B_LN(B,S) IS (B_STR(B,S); B_CH(B,10); 0);

# THE BYTES OF THE BUFFER AS A NEW STRING #
SUBR B_GET(B) IS (
 N,S ARE LOCAL;
 N:=RD(B,0); S:=CCALL calloc(N+16,1); CCALL memcpy(S,RD(B,2),N); S);

# THE NUMBER V IN DECIMAL (SIGNED) #
SUBR B_NUM(B,V) IS (
 T,S,E,P,X,Y ARE LOCAL;
 V<0 => (B_CH(B,45); T:=0-V) ELSE T:=V;
 T=0 => (B_CH(B,48); RETURN 0);
 S:=RD(B,0);
 WHILE T>0 DO (X:=T/10; Y:=T-(X*10); B_CH(B,48+Y); T:=X);
 E:=RD(B,0)-1; P:=RD(B,2);
 WHILE S<E DO (X:=GETB(P,S); Y:=GETB(P,E); PUTB(P,S,Y); PUTB(P,E,X); S:=S+1; E:=E-1);
 0);

SUBR S_DUP(S) IS (
 N,R ARE LOCAL;
 N:=CCALL strlen(S); R:=CCALL calloc(N+16,1); CCALL memcpy(R,S,N); R);

# THE BYTES I TO J (EXCLUSIVE) OF S #
SUBR S_SUB(S,I,J) IS (
 R,Q,N ARE LOCAL;
 N:=J-I; R:=CCALL calloc(N+16,1); Q:=S+I; CCALL memcpy(R,Q,N); R);

SUBR S_CAT(A,B) IS (
 NA,NB,R,Q ARE LOCAL;
 NA:=CCALL strlen(A); NB:=CCALL strlen(B); R:=CCALL calloc((NA+NB)+16,1);
 CCALL memcpy(R,A,NA); Q:=R+NA; CCALL memcpy(Q,B,NB); R);

SUBR S_EQ(A,B) IS (CCALL strcmp(A,B)=0);

# DOES S START WITH P #
SUBR S_PRE(S,P) IS (
 N ARE LOCAL;
 N:=CCALL strlen(P); CCALL strncmp(S,P,N)=0);

# THE INDEX OF THE STRING S IN THE LIST L, ELSE -1 #
SUBR L_FIND(L,S) IS (
 I,N ARE LOCAL;
 N:=RD(L,0); I:=0;
 WHILE I<N DO (S_EQ(L_GET(L,I),S) => RETURN I; I:=I+1);
 0-1);

SUBR IS_SPACE(C) IS ((C=32) OR ((C>8) AND (C<14)));

SUBR IS_IDS(C) IS (((C>64) AND (C<91)) OR ((C>96) AND (C<123)) OR (C=95));

SUBR IS_IDC(C) IS (((C>64) AND (C<91)) OR ((C>96) AND (C<123)) OR (C=95) OR ((C>47) AND (C<58)));

# THE WHOLE FILE AT PATH (- IS THE STANDARD INPUT) AS A STRING; THE LENGTH IS LEFT IN INLEN #
SUBR READ_ALL(PATH) IS (
 F,B,P,N ARE LOCAL;
 B:=B_NEW(0); P:=CCALL calloc(65536,1);
 S_EQ(PATH,LOC('-')) => F:=CCALL fdopen(0,'r') ELSE F:=CCALL fopen(PATH,'rb');
 F=0 => DIE(LOC('cannot read'),PATH);
 RL: N:=CCALL fread(P,1,65536,F);
 N>0 => (B_APP(B,P,N); GO TO RL);
 S_EQ(PATH,LOC('-'))=0 => CCALL fclose(F);
 INLEN:=RD(B,0); B_GET(B));

# THE OUTPUT OF THE SHELL COMMAND CMD (THE CALLER QUOTES THE NAMES IN IT) AS A STRING, ITS LENGTH IN INLEN; IF THE COMMAND FAILS IT IS AN ERROR WHEN HARD NE 0, ELSE THE RESULT IS 0 #
SUBR RUN_CMD(CMD,HARD) IS (
 F,B,P,N,ST ARE LOCAL;
 B:=B_NEW(0); P:=CCALL calloc(65536,1);
 CCALL fflush(0);
 F:=CCALL popen(CMD,'r');
 F=0 => (HARD NE 0 => DIE(LOC('cannot run'),CMD) ELSE RETURN 0);
 RC: N:=CCALL fread(P,1,65536,F);
 N>0 => (B_APP(B,P,N); GO TO RC);
 ST:=CCALL pclose(F);
 ST NE 0 => (HARD NE 0 => DIE(LOC('command failed'),CMD) ELSE RETURN 0);
 INLEN:=RD(B,0); B_GET(B));

# THE STRING S IN SINGLE QUOTES FOR THE SHELL (A QUOTE INSIDE BECOMES QUOTE, BACKSLASH, QUOTE, QUOTE) #
SUBR SHQ(S) IS (
 B,I,N,C ARE LOCAL;
 B:=B_NEW(0); B_CH(B,39); N:=CCALL strlen(S); I:=0;
 WHILE I<N DO (
    C:=GETB(S,I);
    C=39 => (B_CH(B,39); B_CH(B,92); B_CH(B,39); B_CH(B,39)) ELSE B_CH(B,C);
    I:=I+1);
 B_CH(B,39); B_GET(B));

# A NAME THE SHELL TAKES AS WRITTEN IN A LIST OF FILE NAMES AND THE C PREPROCESSOR AS A HEADER OR A DIRECTORY: LETTERS, DIGITS AND . _ / + - ONLY #
SUBR SAFENAME(S) IS (
 I,N,C ARE LOCAL;
 N:=CCALL strlen(S); N=0 => RETURN 0;
 I:=0;
 WHILE I<N DO (
    C:=GETB(S,I);
    ((IS_IDC(C)=0) AND (C NE 46) AND (C NE 47) AND (C NE 43) AND (C NE 45)) => RETURN 0;
    I:=I+1);
 1);

# A C NAME: A LETTER OR _ AND THEN LETTERS, DIGITS AND _ #
SUBR SAFEID(S) IS (
 I,N,C ARE LOCAL;
 N:=CCALL strlen(S); N=0 => RETURN 0;
 IS_IDS(GETB(S,0))=0 => RETURN 0;
 I:=0;
 WHILE I<N DO (
    C:=GETB(S,I);
    IS_IDC(C)=0 => RETURN 0;
    I:=I+1);
 1);

SUBR USAGE(Z) IS (
 B ARE LOCAL;
 B:=B_NEW(0);
 B_LN(B,LOC('usage: imp-cimport [-n NAME] [-p PREFIX] [-D MACRO] [-I DIR] [-o FILE] HEADER'));
 B_LN(B,LOC('       imp-cimport [-n NAME] [-p PREFIX] [-o FILE] -i FILE'));
 B_LN(B,LOC('  HEADER     a header, as #include <HEADER> names it (cc -E reads it; CC names the compiler)'));
 B_LN(B,LOC('  -i FILE    text that the C preprocessor made (- is the standard input), no cc'));
 B_LN(B,LOC('  -n NAME    declare only this name (function, structure, typedef name, enumerator); repeatable'));
 B_LN(B,LOC('  -p PREFIX  declare the names that start with PREFIX; repeatable'));
 B_LN(B,LOC('  -D MACRO   the integer value of a macro, from cc, as LET MACRO=value; repeatable'));
 B_LN(B,LOC('  -I DIR     a directory of headers, for cc; repeatable'));
 B_LN(B,LOC('  -o FILE    write the declarations to FILE (else the standard output)'));
 CCALL write(2,RD(B,2),RD(B,0)); CCALL exit(2))
%%
