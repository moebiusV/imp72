#RUNOFF2MD.IMP -- THE RUNOFF SOURCE OF THE IMP72 MANUAL (DOCS/MANUAL/IMP.RNO) AS MARKDOWN (DOCS/MANUAL/IMP.MD).  THE COMPILER OF THE TREE BUILDS IT (SH TOOLS/IMPTOOL.SH RUNOFF2MD DECUS/IMP.RNO).

    RUNOFF2MD IMP.RNO > IMP.MD

THE SOURCE IS TYPED IN CAPITALS AND RUNOFF LOWERS THEM: A ^ RAISES THE NEXT LETTER, ^^ ... \\ RAISES EVERYTHING BETWEEN, ^[ ... ^] KEEPS THE TEXT BETWEEN AS TYPED (CODE: BACKQUOTES IN THE MARKDOWN), ^& ... \& UNDERLINES, AND _ QUOTES THE NEXT CHARACTER (SO TWO UNDERSCORES ARE ONE UNDERSCORE, AND AN UNDERSCORE BEFORE A NUMBER SIGN IS THE NUMBER SIGN).
HANDLED COMMANDS: .SUBTITLE (A HEADING), .PARAGRAPH, .SKIP, .BREAK, .INDENT, .LEFT MARGIN, .NOFILL/.FILL (A CODE BLOCK), .CENTER (THE LINE AFTER IT).  .INDEX, .PAGE, .TEST, .RIGHT MARGIN, .TAB STOPS,
.SPACING, .NUMBER, .JUSTIFY AND .TITLE ONLY AFFECT THE PAPER AND ARE DROPPED.  (THIS REPLACES A PYTHON PROGRAM; THE TEXT IT WRITES IS THE SAME, BYTE FOR BYTE.)  THE ROUTINES BELOW THE MAIN PROGRAM ARE THE PIECES OF
THE TEXT: STRINGS ARE C STRINGS (A POINTER TO BYTES, A ZERO AFTER THEM), LISTS ARE BLOCKS OF THREE WORDS (COUNT, CAPACITY, ITEMS).  AN ARGUMENT IS PASSED BY REFERENCE: A ROUTINE NEVER ASSIGNS TO ITS ARGUMENTS.#

IMPLINES,NLINES,MD,CASEB,PARA,INDENT,NOFILL,CENTER,PATHP,ARGW,NA ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
NA<2 => (DIE(LOC('usage: runoff2md IMP.RNO'),S_E(0)));
IMPARGET(LOC(ARGW),impargvp(0),1);
READ_LINES(ARGW);
MD:=L_NEW(0);
PARA:=L_NEW(0);
NOFILL:=0; CENTER:=0; INDENT:=0;
CONVERT(0);
FLUSH(0);
WRITE_OUT(0);
CCALL fflush(IMPSTDOUT(0));
CCALL exit(0);

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

# THE WORD I OF THE BLOCK AT P, AND STORING ONE #
SUBR RD(P,I) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]);

SUBR WR(P,I,V) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]:=V; 0);

SUBR DIE(M,A) IS (
 NL ARE LOCAL;
 CCALL write(2,M,CCALL strlen(M)); CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A));
 NL:=CCALL calloc(16,1); PUTB(NL,0,10); CCALL write(2,NL,1); CCALL exit(1));

# THE EMPTY STRING (A TEXT CONSTANT CANNOT BE EMPTY: '' IS A QUOTE) #
SUBR S_E(Z) IS CCALL calloc(16,1);

# A LIST OF WORDS: [COUNT, CAPACITY, ITEMS] #
SUBR L_NEW(Z) IS (
 B ARE LOCAL;
 B:=CCALL calloc(3,8); WR(B,1,8); WR(B,2,CCALL calloc(8,8)); B);

SUBR L_ADD(B,V) IS (
 N,CAP,P,NP ARE LOCAL;
 N:=RD(B,0); CAP:=RD(B,1); P:=RD(B,2);
 N=CAP => (NP:=CCALL calloc(CAP*2,8); CCALL memcpy(NP,P,CAP*8); WR(B,1,CAP*2); WR(B,2,NP); P:=NP);
 WR(P,N,V); WR(B,0,N+1); 0);

SUBR L_GET(B,I) IS (
 P ARE LOCAL;
 P:=RD(B,2); RD(P,I));

SUBR L_SET(B,I,V) IS (
 P ARE LOCAL;
 P:=RD(B,2); WR(P,I,V));

SUBR L_LEN(B) IS RD(B,0);

SUBR L_POP(B) IS (
 N ARE LOCAL;
 N:=RD(B,0)-1; WR(B,0,N); L_GET(B,N));

# A BUFFER OF BYTES THAT GROWS: [LENGTH, CAPACITY, BYTES]; ITS BYTES ARE ALWAYS FOLLOWED BY A ZERO #
SUBR B_NEW(Z) IS (
 B ARE LOCAL;
 B:=CCALL calloc(3,8); WR(B,1,64); WR(B,2,CCALL calloc(80,1)); B);

SUBR B_CH(B,C) IS (
 N,CAP,P,NP ARE LOCAL;
 N:=RD(B,0); CAP:=RD(B,1); P:=RD(B,2);
 (N+2)>CAP => (NP:=CCALL calloc((CAP*2)+16,1); CCALL memcpy(NP,P,N); WR(B,1,CAP*2); WR(B,2,NP); CCALL free(P); P:=NP);
 PUTB(P,N,C); WR(B,0,N+1); 0);

SUBR B_STR(B,S) IS (
 I,N,C ARE LOCAL;
 N:=CCALL strlen(S); I:=0;
 WHILE I<N DO (C:=GETB(S,I); B_CH(B,C); I:=I+1);
 0);

# THE BYTES OF THE BUFFER AS A NEW STRING #
SUBR B_GET(B) IS (
 N,S ARE LOCAL;
 N:=RD(B,0); S:=CCALL calloc(N+16,1); CCALL memcpy(S,RD(B,2),N); S);

SUBR S_LEN(S) IS CCALL strlen(S);

SUBR S_DUP(S) IS (
 N,R ARE LOCAL;
 N:=CCALL strlen(S); R:=CCALL calloc(N+16,1); CCALL memcpy(R,S,N); R);

# THE STRINGS A AND B JOINED #
SUBR S_CAT(A,B) IS (
 NA,NB,R ARE LOCAL;
 NA:=CCALL strlen(A); NB:=CCALL strlen(B); R:=CCALL calloc((NA+NB)+16,1);
 CCALL memcpy(R,A,NA); NA:=R+NA; CCALL memcpy(NA,B,NB); R);

# THE BYTES I TO J (EXCLUSIVE) OF S #
SUBR S_SUB(S,I,J) IS (
 R,Q ARE LOCAL;
 R:=CCALL calloc((J-I)+16,1); Q:=S+I; CCALL memcpy(R,Q,J-I); R);

SUBR S_EQ(A,B) IS (CCALL strcmp(A,B)=0);

# THE STRING WITH WHITE SPACE TAKEN OFF AT THE FRONT AND AT THE END #
SUBR IS_SPACE(C) IS ((C=32) OR ((C>8) AND (C<14)) OR ((C>27) AND (C<32)));

SUBR S_STRIP(S) IS (
 I,J,F ARE LOCAL;
 I:=0; J:=CCALL strlen(S); F:=1;
 WHILE F NE 0 DO (I<J => (IS_SPACE(GETB(S,I)) => I:=I+1 ELSE F:=0) ELSE F:=0);
 F:=1;
 WHILE F NE 0 DO (J>I => (IS_SPACE(GETB(S,J-1)) => J:=J-1 ELSE F:=0) ELSE F:=0);
 S_SUB(S,I,J));

SUBR S_RSTRIP(S) IS (
 J,F ARE LOCAL;
 J:=CCALL strlen(S); F:=1;
 WHILE F NE 0 DO (J>0 => (IS_SPACE(GETB(S,J-1)) => J:=J-1 ELSE F:=0) ELSE F:=0);
 S_SUB(S,0,J));

SUBR IS_ALPHA(C) IS (((C>64) AND (C<91)) OR ((C>96) AND (C<123)));

# THE STRING S WITH A BACKSLASH BEFORE EACH < THAT STARTS A TAG-LIKE WORD (A LETTER OR A SLASH FOLLOWS IT): A BROWSER READS <B> AS THE START OF BOLD AND <A> AS A LINK, AND NEITHER ENDS #
SUBR ESCLT(S) IS (
 B,I,N,C,D ARE LOCAL;
 B:=B_NEW(0); N:=S_LEN(S); I:=0;
 WHILE I<N DO (
    C:=GETB(S,I);
    C=60 => (D:=GETB(S,I+1); (IS_ALPHA(D) OR (D=47)) => B_CH(B,92));
    B_CH(B,C); I:=I+1);
 B_GET(B));

SUBR TO_UPPER(C) IS (((C>96) AND (C<123)) => C-32 ELSE C);

SUBR TO_LOWER(C) IS (((C>64) AND (C<91)) => C+32 ELSE C);

# THE FILE AT PATH, ITS LINES (CR LF AND A LONE CR END A LINE; THE LAST LINE IS THE TEXT AFTER THE LAST END) IN IMPLINES #
SUBR READ_LINES(PATH) IS (
 F,N,BUF,I,C,B,S,PREV ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); N:=CCALL ftell(F); CCALL fseek(F,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => CCALL fread(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH);
 CCALL fclose(F);
 IMPLINES:=L_NEW(0); B:=B_NEW(0); I:=0; PREV:=0;
 WHILE I<N DO (
    C:=GETB(BUF,I);
    ((C=10) AND (PREV=13)) => (PREV:=0)
    ELSE (
      ((C=10) OR (C=13)) => (S:=B_GET(B); L_ADD(IMPLINES,S); WR(B,0,0); PUTB(RD(B,2),0,0))
      ELSE B_CH(B,C);
      PREV:=C);
    I:=I+1);
 S:=B_GET(B); L_ADD(IMPLINES,S);
 NLINES:=L_LEN(IMPLINES);
 0);

# RUNOFF'S CAPITALIZATION AND QUOTING APPLIED TO ONE PIECE OF TEXT; ^[ ... ^] IS TEXT KEPT AS TYPED, CODE (BACKQUOTES IN THE MARKDOWN) #
SUBR CASE(TXT) IS (
 B,I,N,C,D,CAPS,UNDER,X,VERB ARE LOCAL;
 B:=B_NEW(0); I:=0; N:=CCALL strlen(TXT); CAPS:=0; UNDER:=0; VERB:=0;
 CL: I<N => (
    C:=GETB(TXT,I);
    VERB NE 0 => (
       ((C=94) AND (GETB(TXT,I+1)=93)) => (B_CH(B,96); VERB:=0; I:=I+2; GO TO CL);
       B_CH(B,C); I:=I+1; GO TO CL);
    ((C=94) AND ((I+1)<N)) => (
       D:=GETB(TXT,I+1);
       D=94 => (CAPS:=1; I:=I+2; GO TO CL);
       D=91 => (B_CH(B,96); VERB:=1; I:=I+2; GO TO CL);
       D=38 => (UNDER=0 => B_CH(B,95); UNDER:=1; I:=I+2; GO TO CL);
       B_CH(B,TO_UPPER(D)); I:=I+2; GO TO CL);
    C=92 => (
       X:=GETB(TXT,I+1);
       X=92 => (CAPS:=0; I:=I+2; GO TO CL);
       X=38 => (UNDER NE 0 => B_CH(B,95); UNDER:=0; I:=I+2; GO TO CL);
       I:=I+1;
       I<N => (B_CH(B,TO_LOWER(GETB(TXT,I))); I:=I+1);
       GO TO CL);
    ((C=95) AND ((I+1)<N)) => (B_CH(B,GETB(TXT,I+1)); I:=I+2; GO TO CL);
    CAPS NE 0 => B_CH(B,TO_UPPER(C)) ELSE B_CH(B,TO_LOWER(C));
    I:=I+1; GO TO CL);
 B_GET(B));

# MD IS A LIST OF LINES #
SUBR MD_ADD(S) IS (L_ADD(MD,S); 0);

SUBR FLUSH(Z) IS (
 I,N,T,B,S,R,K,C,P ARE LOCAL;
 L_LEN(PARA)>0 => (
    B:=B_NEW(0); N:=L_LEN(PARA); I:=0; K:=0;
    WHILE I<N DO (
       T:=S_STRIP(L_GET(PARA,I));
       S_LEN(T)>0 => (K NE 0 => B_CH(B,32); B_STR(B,ESCLT(T)); K:=1);
       I:=I+1);
    # RUNS OF TWO OR MORE SPACES BECOME ONE #
    S:=B_GET(B); R:=B_NEW(0); N:=S_LEN(S); I:=0;
    WHILE I<N DO (
       C:=GETB(S,I);
       B_CH(R,C);
       C=32 => (WHILE GETB(S,I+1)=32 DO I:=I+1);
       I:=I+1);
    T:=B_GET(R);
    S_LEN(T)>0 => (
       INDENT NE 0 => MD_ADD(S_CAT(LOC('- '),T)) ELSE MD_ADD(T);
       MD_ADD(S_E(0))));
 PARA:=L_NEW(0); INDENT:=0; 0);

# THE COMMAND OF A SOURCE LINE THAT STARTS WITH A DOT: ITS NAME IN CAPITALS INTO CMDW AND ITS ARGUMENT INTO ARGS; 0 IF THERE IS NO NAME #
SUBR SPLIT_CMD(RAW) IS (
 I,N,B,C ARE LOCAL;
 N:=S_LEN(RAW); I:=1;
 WHILE IS_ALPHA(GETB(RAW,I)) DO I:=I+1;
 I=1 => RETURN 0;
 B:=B_NEW(0); C:=1;
 WHILE C<I DO (B_CH(B,TO_UPPER(GETB(RAW,C))); C:=C+1);
 CMDW:=B_GET(B);
 WHILE (IS_SPACE(GETB(RAW,I)) AND (I<N)) DO I:=I+1;
 ARGS:=S_SUB(RAW,I,N);
 1);

SUBR CONVERT(Z) IS (
 K,RAW,T,M,C,P,DEPTH,NUM,I,H,F ARE LOCAL;
 K:=0;
 MD_ADD(LOC('<!-- Generated by tools/runoff2md.imp from docs/manual/imp.rno: do not edit. -->'));
 MD_ADD(S_E(0));
 CV: K<NLINES => (
    RAW:=L_GET(IMPLINES,K); K:=K+1;
    GETB(RAW,0)=46 => (
       SPLIT_CMD(RAW)=0 => GO TO CV;
       S_EQ(CMDW,LOC('SUBTITLE')) => (
          FLUSH(0);
          T:=S_STRIP(CASE(ARGS));
          # A TITLE THAT STARTS WITH DIGITS AND DOTS, THEN A COLON, IS NUMBERED: ITS DEPTH IS THE DOTS BEFORE THE COLON PLUS TWO #
          I:=0; WHILE (GETB(T,I)=46) OR ((GETB(T,I)>47) AND (GETB(T,I)<58)) DO I:=I+1;
          ((I>0) AND (GETB(T,I)=58)) => (
             DEPTH:=2; C:=0; WHILE C<I DO (GETB(T,C)=46 => DEPTH:=DEPTH+1; C:=C+1))
          ELSE DEPTH:=2;
          DEPTH>6 => DEPTH:=6;
          H:=B_NEW(0); C:=0; WHILE C<DEPTH DO (B_CH(H,35); C:=C+1);
          B_CH(H,32); B_STR(H,T);
          MD_ADD(B_GET(H)); MD_ADD(S_E(0));
          GO TO CV);
       ((S_EQ(CMDW,LOC('PARAGRAPH'))) OR (S_EQ(CMDW,LOC('SKIP'))) OR (S_EQ(CMDW,LOC('BREAK'))) OR (S_EQ(CMDW,LOC('PAGE')))) => (FLUSH(0); GO TO CV);
       S_EQ(CMDW,LOC('INDENT')) => (FLUSH(0); INDENT:=1; GO TO CV);
       S_EQ(CMDW,LOC('CENTER')) => (FLUSH(0); CENTER:=1; GO TO CV);
       S_EQ(CMDW,LOC('NOFILL')) => (FLUSH(0); NOFILL:=1; MD_ADD(LOC('```')); GO TO CV);
       S_EQ(CMDW,LOC('FILL')) => (
          NOFILL NE 0 => (
             F:=1;
             WHILE F NE 0 DO (L_LEN(MD)>0 => (S_LEN(L_GET(MD,L_LEN(MD)-1))=0 => L_POP(MD) ELSE F:=0) ELSE F:=0);
             MD_ADD(LOC('```')); MD_ADD(S_E(0)));
          NOFILL:=0; GO TO CV);
       GO TO CV);
    NOFILL NE 0 => (MD_ADD(S_RSTRIP(CASE(RAW))); GO TO CV);
    CENTER NE 0 => (
       CENTER:=0;
       T:=S_STRIP(CASE(RAW));
       # A LINE THAT IS NOT EMPTY, NOT A NUMBERED HEADING AND NOT STARTING WITH AN UNDERSCORE IS A BOLD LINE #
       ((S_LEN(T)>0) AND (GETB(T,0) NE 95) AND (NUMCHK(T)=0)) => (
          FLUSH(0);
          H:=S_CAT(ESCLT(T),LOC('**')); H:=S_CAT(LOC('**'),H); MD_ADD(H); MD_ADD(S_E(0)));
       GO TO CV);
    L_ADD(PARA,CASE(RAW));
    GO TO CV);
 FLUSH(0);
 0);

# DOES THE STRING START WITH A DIGIT, DIGITS AND DOTS, THEN A COLON: A NUMBERED HEADING #
SUBR NUMCHK(T) IS (
 I ARE LOCAL;
 I:=0;
 ((GETB(T,0)>47) AND (GETB(T,0)<58)) => (
    WHILE (GETB(T,I)=46) OR ((GETB(T,I)>47) AND (GETB(T,I)<58)) DO I:=I+1;
    GETB(T,I)=58 => RETURN 1);
 0);

# THE LINES OF MD JOINED WITH A NEWLINE EACH, RUNS OF BLANK LINES MADE ONE, AND WRITTEN #
SUBR WRITE_OUT(Z) IS (
 B,I,N,S,J,M,C,NLS,O ARE LOCAL;
 B:=B_NEW(0); N:=L_LEN(MD); I:=0;
 WHILE I<N DO (
    I>0 => B_CH(B,10);
    B_STR(B,L_GET(MD,I)); I:=I+1);
 S:=B_GET(B); M:=S_LEN(S);
 O:=B_NEW(0); NLS:=0; J:=0;
 WHILE J<M DO (
    C:=GETB(S,J);
    C=10 => (NLS:=NLS+1; NLS<3 => B_CH(O,10)) ELSE (NLS:=0; B_CH(O,C));
    J:=J+1);
 B_CH(O,10);
 WRAP_OUT(B_GET(O));
 0);

# C STARTS A LINE THAT MARKDOWN WOULD READ AS A LIST ITEM, A HEADING OR A QUOTE: A HYPHEN, PLUS, STAR, HASH SIGN, GREATER-THAN SIGN OR DIGIT #
SUBR BADSTART(C) IS ((C=45) OR ((C=43) OR ((C=42) OR ((C=35) OR ((C=62) OR ((C>47) AND (C<58)))))));

# WHERE TO BREAK THE LINE S[Q..E): THE LAST BLANK IN THE FIRST 100 BYTES (NOT BEFORE THE 20TH) AFTER WHICH THE TEXT DOES NOT START LIKE ONE OF THOSE, ELSE THE FIRST BLANK AFTER THEM; E IF THERE IS NONE #
SUBR FINDBRK(S,Q,E) IS (
 B,C,N ARE LOCAL;
 B:=Q+100; N:=0;
 WHILE N=0 DO (
    B<(Q+20) => N:=2
     ELSE (GETB(S,B)=32 => (C:=GETB(S,B+1); BADSTART(C) => B:=B-1 ELSE N:=1)
            ELSE B:=B-1));
 N=1 => RETURN B;
 B:=Q+100;
 WHILE ((B<E) AND (GETB(S,B) NE 32)) DO B:=B+1;
 B);

# TEXT S TO THE STANDARD OUTPUT, THE LINES OF PROSE LONGER THAN 100 BYTES BROKEN AT A BLANK.  CODE IN FENCES, HEADINGS, TABLES AND LINES THAT START WITH A BLANK ARE LEFT AS THEY ARE; A LIST ITEM
  CONTINUES WITH TWO BLANKS #
SUBR WRAP_OUT(S) IS (
 WP,WK,WE,WF,WQ,WB,WI,WN,WO,WC,WOK,WM,WX ARE LOCAL;
 WM:=S_LEN(S); WP:=B_NEW(0); WK:=0; WF:=0;
 WHILE WK<WM DO (
    WE:=WK;
    WHILE ((WE<WM) AND (GETB(S,WE) NE 10)) DO WE:=WE+1;
    WN:=WE-WK; WC:=GETB(S,WK); WOK:=0;
    WN GE 3 => (WC=96 => (GETB(S,WK+1)=96 => (GETB(S,WK+2)=96 => (WF:=1-WF; WOK:=2))));
    WOK=0 => (WF=0 => (WN>100 => (WC NE 35 => (WC NE 124 => (WC NE 32 => WOK:=1)))));
    WQ:=WK; WX:=0;
    WOK=1 => (
       WI:=0;
       WC=45 => (GETB(S,WK+1)=32 => WI:=2);
       WHILE (((WE-WQ)>100) AND (WX=0)) DO (
          WB:=FINDBRK(S,WQ,WE);
          WB GE WE => WX:=1
           ELSE (WO:=WQ;
                 WHILE WO<WB DO (B_CH(WP,GETB(S,WO)); WO:=WO+1);
                 B_CH(WP,10);
                 WO:=0;
                 WHILE WO<WI DO (B_CH(WP,32); WO:=WO+1);
                 WQ:=WB+1;
                 WHILE ((WQ<WE) AND (GETB(S,WQ)=32)) DO WQ:=WQ+1)));
    WO:=WQ;
    WHILE WO<WE DO (B_CH(WP,GETB(S,WO)); WO:=WO+1);
    WE<WM => B_CH(WP,10);
    WK:=WE+1);
 CCALL fwrite(RD(WP,2),1,RD(WP,0),IMPSTDOUT(0));
 0)
%%
