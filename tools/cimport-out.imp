#CIMPORT-OUT.IMP -- THE FOURTH FILE OF TOOLS/CIMPORT.IMP: THE PREPROCESSOR (CC -E), THE VALUES OF MACROS (A C PROGRAM, COMPILED AND RUN IN A PRIVATE DIRECTORY), THE SELECTION OF NAMES AND THE TEXT OF THE DECLARATIONS.#

LET CH_LF=10, CH_SP=32, CH_QUOTE=34, CH_APOS=39, CH_LP=40, CH_RP=41, CH_STAR=42, CH_COMMA=44, CH_SLASH=47, CH_SEMI=59, CH_EQ=61, CH_LB=91, CH_RB=93, CH_LC=123, CH_RC=125;
LET T_CHAR=1, T_UCHAR=2, T_SHORT=3, T_USHORT=4, T_INT=5, T_UINT=6, T_LONG=7, T_ULONG=8, T_LLONG=9, T_ULLONG=10, T_SIZE=11, T_PTR=12, T_DOUBLE=13, T_FLOAT=14, T_VOID=15, T_SBASE=100, T_BBASE=100000;

EXTERNAL PTR fopen(PTR, PTR);
EXTERNAL INT fclose(PTR);
EXTERNAL SIZE fwrite(PTR, SIZE, SIZE, PTR);
EXTERNAL INT fflush(PTR);
EXTERNAL PTR getenv(PTR);
EXTERNAL INT unlink(PTR);
EXTERNAL INT rmdir(PTR);
EXTERNAL PTR mkdtemp(PTR);
EXTERNAL PTR opendir(PTR);
EXTERNAL INT closedir(PTR);
EXTERNAL PTR signal(INT, PTR);
EXTERNAL VOID _exit(INT);
EXTERNAL SIZE strlen(PTR);
CALLBACK VOID CLEAN(INT);

TK,NT,TKP,EMPTYS,TDN,TDT,STNAME,STTAG,STSTATE,STBODY,STWHY,STDEPS,STNEED,STEMIT,ALN,ALI,BADL,FNN,FNT,FNW,CNN,CNV,CNK,CNW ARE COMMON;
SELN,SELP,MACD,INCD,HDR,OUTP,INP,NSEL,TYN,RW,OUT,MACV,MACW,INLEN,DEFORD ARE COMMON;
SP_TYPE,SP_END,SP_TD,DNAME,DKIND,DSTARS,DGRP,DPS,DPE,DARRN,DBIT,DEND,DOK,EV_OK,EV_VAL,INBODY,CURB,CURDEPS,CURBAD,CURFIRST,ASKIP,AEND,NUMOK,NUMV,TDIR,TFC,TFX,LASTSZ,SZON ARE COMMON;
NA,ARGW,TEXT ARE COMMON;

# ---- NAMES ---- #

# THE WORDS OF THE LANGUAGE (THE SYNTAX FILES AND THE TYPES OF THE DECLARATIONS) THAT A C NAME CANNOT BE WRITTEN AS: SUCH A NAME IS WRITTEN BETWEEN EXCLAMATION MARKS #
SUBR RW_INIT(Z) IS (
 W,I,J,N,C ARE LOCAL;
 RW:=L_NEW(0);
 W:=LOC('ALS AND ARE ARS AVAILABLE BYTEP CALL CALLBACK CALLI CASE CCALL CHAR COMMON DATA DEVICE DO DOUBLE ELSE EQ EQV EXECUTE EXTERNAL FIELD FILE FILL FIX FLOAT FLT FNPTR FOR FROM GE GO GT IDPB IF IGR ILDB IMAGE IN INT INTEGER IOWD IS LE LET LLONG LOC LOCAL LONG LROT LS LT ME MODE MOVE NE NOT OCT OF OFFSETOF OR PRINT PRIORITY PROTECTED PTR READ REAL REGISTER RELEASED REMOTE RESERVED RETURN RROT RS SCRATCH SHORT SIZE SIZEOF STG STRUCT SUBR SYM TAB THROUGH TO TWOSEG UCHAR UINT ULLONG ULONG UNTIL USHORT VALUE VOID WH WHILE XOR XWD');
 N:=CCALL strlen(W); I:=0;
 RWL: I<N => (
    WHILE ((I<N) AND (GETB(W,I)=32)) DO I:=I+1;
    J:=I;
    WHILE ((J<N) AND (GETB(W,J) NE 32)) DO J:=J+1;
    J>I => L_ADD(RW,S_SUB(W,I,J));
    I:=J; GO TO RWL);
 0);

# THE NAME S AS IMP72 SPELLS IT: AS IT IS, OR BETWEEN ! WHEN IT IS A WORD OF THE LANGUAGE (A NAME OF CAPITAL LETTERS, DIGITS AND _ ONLY CAN BE ONE) #
SUBR QN(S) IS (
 I,N,C,UP,B ARE LOCAL;
 RW=0 => RW_INIT(0);
 N:=CCALL strlen(S); I:=0; UP:=1;
 WHILE I<N DO (
    C:=GETB(S,I);
    ((C>96) AND (C<123)) => UP:=0;
    I:=I+1);
 ((UP NE 0) AND (L_FIND(RW,S) GE 0)) => (
    B:=B_NEW(0); B_CH(B,33); B_STR(B,S); B_CH(B,33); RETURN B_GET(B));
 S);

# ---- THE PREPROCESSOR ---- #

# THE INCLUDE LINE FOR THE HEADER H: INCLUDE <H> (H WRITTEN <X> OR "X" KEEPS ITS FORM; A PLAIN NAME IS IN ANGLE BRACKETS) #
SUBR INCLINE(H) IS (
 N,L,F,I,B ARE LOCAL;
 N:=CCALL strlen(H); L:=GETB(H,0); F:=GETB(H,N-1);
 B:=B_NEW(0); B_STR(B,LOC('#include '));
 ((L=60) AND (F=62) AND (N>2)) => (I:=S_SUB(H,1,N-1); SAFENAME(I)=0 => DIE(LOC('not a plain header name'),H); B_STR(B,H); RETURN B_GET(B));
 ((L=34) AND (F=34) AND (N>2)) => (I:=S_SUB(H,1,N-1); SAFENAME(I)=0 => DIE(LOC('not a plain header name'),H); B_STR(B,H); RETURN B_GET(B));
 SAFENAME(H)=0 => DIE(LOC('not a plain header name'),H);
 B_CH(B,60); B_STR(B,H); B_CH(B,62); B_GET(B));

# THE C COMPILER, ITS WORDS AS THE SHELL READS THEM (CC OF THE ENVIRONMENT, ELSE cc) #
SUBR CCNAME(Z) IS (
 S ARE LOCAL;
 S:=CCALL getenv('CC');
 S=0 => RETURN S_DUP(LOC('cc'));
 GETB(S,0)=0 => RETURN S_DUP(LOC('cc'));
 S);

# THE -I OPTIONS OF THE COMMAND #
SUBR INCOPTS(Z) IS (
 B,I,N ARE LOCAL;
 B:=B_NEW(0); I:=0; N:=L_LEN(INCD);
 WHILE I<N DO (B_STR(B,LOC(' -I ')); B_STR(B,SHQ(L_GET(INCD,I))); I:=I+1);
 B_GET(B));

# THE TEXT THE PREPROCESSOR MAKES OF THE INCLUDE OF H, ITS LENGTH IN INLEN #
SUBR PREPROCESS(H) IS (
 B ARE LOCAL;
 B:=B_NEW(0);
 B_STR(B,LOC('printf ')); B_STR(B,SHQ(LOC('%s\n'))); B_CH(B,32); B_STR(B,SHQ(INCLINE(H)));
 B_STR(B,LOC(' | ')); B_STR(B,CCNAME(0)); B_STR(B,LOC(' -E -x c -')); B_STR(B,INCOPTS(0));
 RUN_CMD(B_GET(B),1));

# ---- THE VALUES OF MACROS ---- #

# REMOVE THE PROBE'S FILES AND ITS DIRECTORY (ON THE WAY OUT AND ON A SIGNAL) #
SUBR RMTMP(Z) IS (
 TDIR NE 0 => (
    TFC NE 0 => CCALL unlink(TFC);
    TFX NE 0 => CCALL unlink(TFX);
    CCALL rmdir(TDIR));
 TDIR:=0; 0);

SUBR CLEAN(S) IS (RMTMP(0); CCALL _exit(1));

# THE DIRECTORY FOR TEMPORARY FILES: TMPDIR IF IT IS AN ABSOLUTE PATH TO A DIRECTORY, ELSE /tmp #
SUBR TMPBASE(Z) IS (
 S,D ARE LOCAL;
 S:=CCALL getenv('TMPDIR');
 S=0 => RETURN S_DUP(LOC('/tmp'));
 GETB(S,0) NE 47 => RETURN S_DUP(LOC('/tmp'));
 D:=IMPOPENDIR(S);
 D=0 => RETURN S_DUP(LOC('/tmp'));
 CCALL closedir(D);
 S);

# THE PRIVATE DIRECTORY (MODE 0700, A NAME NOBODY CAN GUESS, MADE ONCE) AND THE NAMES OF THE TWO FILES IN IT #
SUBR MAKETMP(Z) IS (
 T,R ARE LOCAL;
 TDIR NE 0 => RETURN 1;
 T:=S_CAT(TMPBASE(0),LOC('/impcimportXXXXXX'));
 R:=CCALL mkdtemp(T);
 R=0 => DIE(LOC('cannot make a directory for the probe of macros'),0);
 TDIR:=T;
 TFC:=S_CAT(T,LOC('/p.c')); TFX:=S_CAT(T,LOC('/p'));
 CCALL signal(1,CALLBACK(CLEAN)); CCALL signal(2,CALLBACK(CLEAN)); CCALL signal(15,CALLBACK(CLEAN));
 1);

# THE C PROGRAM THAT PRINTS, FOR EACH NAME OF THE LIST L: NAME KIND UNSIGNED SIGNED, KIND 1 FOR AN INTEGER, 0 FOR OTHER VALUES, - IF THE MACRO IS NOT DEFINED #
SUBR PROBESRC(L) IS (
 B,I,N,S ARE LOCAL;
 B:=B_NEW(0);
 B_LN(B,INCLINE(HDR)); B_LN(B,LOC('#include <stdio.h>')); B_LN(B,LOC('int main(void) {'));
 N:=L_LEN(L); I:=0;
 WHILE I<N DO (
    S:=L_GET(L,I);
    B_STR(B,LOC('#ifdef ')); B_LN(B,S);
    B_STR(B,LOC(' printf("')); B_STR(B,S); B_STR(B,LOC(' %d %llu %lld'));
    B_CH(B,92); B_STR(B,LOC('n", _Generic(('));
    B_STR(B,S); B_STR(B,LOC('), char: 1, signed char: 1, unsigned char: 1, short: 1, unsigned short: 1, int: 1, unsigned: 1, long: 1, unsigned long: 1, long long: 1, unsigned long long: 1, _Bool: 1, default: 0), (unsigned long long)('));
    B_STR(B,S); B_STR(B,LOC('), (long long)(')); B_STR(B,S); B_LN(B,LOC('));'));
    B_LN(B,LOC('#else'));
    B_STR(B,LOC(' printf("')); B_STR(B,S); B_CH(B,32); B_STR(B,LOC('- 0 0')); B_CH(B,92); B_LN(B,LOC('n");'));
    B_LN(B,LOC('#endif'));
    I:=I+1);
 B_LN(B,LOC(' return 0;')); B_LN(B,LOC('}'));
 B_GET(B));

# THE TEXT THE PROBE FOR THE NAMES OF THE LIST L PRINTS, OR 0 IF IT DOES NOT COMPILE OR RUN #
SUBR PROBE_SET(L) IS (
 SRC,F,N,B,R ARE LOCAL;
 MAKETMP(0);
 SRC:=PROBESRC(L);
 CCALL unlink(TFX);
 F:=CCALL fopen(TFC,'w');
 F=0 => DIE(LOC('cannot write'),TFC);
 N:=CCALL strlen(SRC); CCALL fwrite(SRC,1,N,F); CCALL fclose(F);
 B:=B_NEW(0);
 B_STR(B,CCNAME(0)); B_STR(B,INCOPTS(0)); B_STR(B,LOC(' -o ')); B_STR(B,SHQ(TFX)); B_CH(B,32); B_STR(B,SHQ(TFC)); B_STR(B,LOC(' >/dev/null 2>&1'));
 R:=RUN_CMD(B_GET(B),0);
 R=0 => RETURN 0;
 RUN_CMD(SHQ(TFX),0));

# THE LINE OF THE TEXT T THAT STARTS WITH THE NAME S AND A BLANK: THE LINE (A STRING), ELSE 0 #
SUBR FINDLINE(T,S) IS (
 N,M,I,J,P ARE LOCAL;
 N:=CCALL strlen(T); M:=CCALL strlen(S); I:=0;
 FLL: I<N => (
    J:=I; WHILE ((J<N) AND (GETB(T,J) NE 10)) DO J:=J+1;
    P:=T+I;
    ((CCALL strncmp(P,S,M)=0) AND (GETB(T,I+M)=32)) => RETURN S_SUB(T,I,J);
    I:=J+1; GO TO FLL);
 0);

# THE WORD K (FROM 0) OF THE LINE S, SEPARATED BY BLANKS #
SUBR WORDOF(S,K) IS (
 N,I,J,C ARE LOCAL;
 N:=CCALL strlen(S); I:=0; C:=0;
 WOL: WHILE ((I<N) AND (GETB(S,I)=32)) DO I:=I+1;
 J:=I; WHILE ((J<N) AND (GETB(S,J) NE 32)) DO J:=J+1;
 C=K => RETURN S_SUB(S,I,J);
 J GE N => RETURN S_E(0);
 C:=C+1; I:=J; GO TO WOL);

# THE VALUES OF THE MACROS OF MACD: MACV (THE VALUE AS UNSIGNED DECIMAL, WITH THE SIGNED ONE IN MACS WHEN IT IS NEGATIVE) AND MACW (0 AN INTEGER, ELSE THE REASON AS A STRING) #
SUBR PROBE_MACROS(Z) IS (
 I,N,T,LN,ONE,W ARE LOCAL;
 MACV:=L_NEW(0); MACW:=L_NEW(0); MACS:=L_NEW(0);
 N:=L_LEN(MACD); N=0 => RETURN 0;
 T:=PROBE_SET(MACD);
 I:=0;
 PML: I<N => (
    T=0 => (ONE:=L_NEW(0); L_ADD(ONE,L_GET(MACD,I)); LN:=PROBE_SET(ONE); LN=0 => (L_ADD(MACV,0); L_ADD(MACS,0); L_ADD(MACW,S_DUP(LOC('the C compiler cannot evaluate it as a constant'))); I:=I+1; GO TO PML))
     ELSE LN:=T;
    LN:=FINDLINE(LN,L_GET(MACD,I));
    LN=0 => (L_ADD(MACV,0); L_ADD(MACS,0); L_ADD(MACW,S_DUP(LOC('no value was printed'))); I:=I+1; GO TO PML);
    W:=WORDOF(LN,1);
    S_EQ(W,LOC('-')) => (L_ADD(MACV,0); L_ADD(MACS,0); L_ADD(MACW,S_DUP(LOC('it is not defined'))); I:=I+1; GO TO PML);
    S_EQ(W,LOC('0')) => (L_ADD(MACV,0); L_ADD(MACS,0); L_ADD(MACW,S_DUP(LOC('it is not an integer (a floating point number, a string or a pointer)'))); I:=I+1; GO TO PML);
    L_ADD(MACV,WORDOF(LN,2)); L_ADD(MACS,WORDOF(LN,3)); L_ADD(MACW,0);
    I:=I+1; GO TO PML);
 RMTMP(0); 0);

# ---- SELECTION AND OUTPUT ---- #

# IS THE NAME S SELECTED BY -n OR -p (ALL ARE WITHOUT THEM) #
SUBR SELECTED(S) IS (
 I,N,A,B ARE LOCAL;
 A:=L_LEN(SELN); B:=L_LEN(SELP);
 ((A=0) AND (B=0)) => RETURN 1;
 L_FIND(SELN,S) GE 0 => RETURN 1;
 I:=0;
 WHILE I<B DO (S_PRE(S,L_GET(SELP,I)) => RETURN 1; I:=I+1);
 0);

# IS THE STRUCTURE I SELECTED BY ITS NAME, ITS TAG OR A TYPEDEF NAME OF IT #
SUBR STSEL(I) IS (
 K,N ARE LOCAL;
 L_GET(STNAME,I)=0 => RETURN 0;
 SELECTED(L_GET(STNAME,I)) NE 0 => RETURN 1;
 SELECTED(L_GET(STTAG,I)) NE 0 => RETURN 1;
 N:=L_LEN(ALN); K:=0;
 WHILE K<N DO (
    ((L_GET(ALI,K)=I) AND (SELECTED(L_GET(ALN,K)) NE 0)) => RETURN 1;
    K:=K+1);
 0);

# THE NUMBER V AS THE DECIMAL OF ITS 64-BIT PATTERN (THE LITERAL OF LET) #
SUBR B_UNS(B,V) IS (
 M,Q,R,HI,LO ARE LOCAL;
 V GE 0 => (B_NUM(B,V); RETURN 0);
 M:=0-V;
 M<0 => (B_STR(B,LOC('9223372036854775808')); RETURN 0);
 Q:=M/10; R:=M-(Q*10);
 HI:=1844674407370955161-Q; LO:=6-R;
 LO<0 => (HI:=HI-1; LO:=LO+10);
 B_NUM(B,HI); B_NUM(B,LO); 0);

# A WARNING ON THE STANDARD ERROR FOR EACH NAME OF -n THAT NOTHING IN THE TEXT DECLARES #
SUBR CHECK_NAMES(Z) IS (
 I,N,S ARE LOCAL;
 N:=L_LEN(SELN); I:=0;
 WHILE I<N DO (
    S:=L_GET(SELN,I);
    ((L_FIND(FNN,S)<0) AND (L_FIND(STTAG,S)<0) AND (L_FIND(ALN,S)<0) AND (L_FIND(CNN,S)<0) AND (L_FIND(TDN,S)<0)) => WARN(LOC('nothing is declared with the name'),S);
    I:=I+1);
 0);

# THE TEXT OF ALL THE DECLARATIONS INTO OUT #
SUBR WRITE_DECLS(Z) IS (
 I,N,NF,NS,NC,K,S,D,X,NB,NU,L,W,NO,J ARE LOCAL;
 PROBE_MACROS(0);
 CHECK_NAMES(0);
 # THE STRUCTURES THAT ARE NEEDED: SELECTED, OR A MEMBER OF ONE THAT IS (DEFORD IS THE ORDER OF THEIR DEFINITIONS) #
 N:=L_LEN(STNAME); I:=0;
 WHILE I<N DO (L_SET(STNEED,I,STSEL(I)); I:=I+1);
 NO:=L_LEN(DEFORD); J:=NO-1;
 WHILE J GE 0 DO (
    I:=L_GET(DEFORD,J);
    L_GET(STNEED,I) NE 0 => (
       L_GET(STSTATE,I)=1 => (
          D:=L_GET(STDEPS,I); K:=0;
          WHILE K<L_LEN(D) DO (L_SET(STNEED,L_GET(D,K),1); K:=K+1)));
    J:=J-1);
 # COUNTS #
 NF:=0; NS:=0; NC:=0;
 I:=0; WHILE I<L_LEN(FNN) DO ((L_GET(FNT,I) NE 0) AND (SELECTED(L_GET(FNN,I)) NE 0) => NF:=NF+1; I:=I+1);
 I:=0; WHILE I<N DO ((L_GET(STNEED,I) NE 0) AND (L_GET(STSTATE,I)=1) => NS:=NS+1; I:=I+1);
 I:=0; WHILE I<L_LEN(CNN) DO ((L_GET(CNK,I) NE 0) AND (SELECTED(L_GET(CNN,I)) NE 0) => NC:=NC+1; I:=I+1);
 B_STR(OUT,LOC('# DECLARATIONS FOR IMP72 FROM '));
 HDR NE 0 => B_STR(OUT,HDR) ELSE B_STR(OUT,LOC('PREPROCESSED C TEXT'));
 B_STR(OUT,LOC(', MADE BY IMP72-CIMPORT (FUNCTIONS '));  B_NUM(OUT,NF); B_STR(OUT,LOC(', STRUCTURES ')); B_NUM(OUT,NS);
 B_STR(OUT,LOC(', CONSTANTS ')); B_NUM(OUT,NC+L_LEN(MACD)); B_LN(OUT,LOC('; THE LAYOUTS OF THE STRUCTURES ARE COMPUTED BY IMP72 FOR THE MACHINE THE PROGRAM IS COMPILED FOR) #'));
 # THE CONSTANTS #
 I:=0;
 WHILE I<L_LEN(CNN) DO (
    ((L_GET(CNK,I) NE 0) AND (SELECTED(L_GET(CNN,I)) NE 0)) => (
       B_STR(OUT,LOC('LET ')); B_STR(OUT,QN(L_GET(CNN,I))); B_CH(OUT,61); B_UNS(OUT,L_GET(CNV,I)); B_CH(OUT,59);
       L_GET(CNV,I)<0 => (B_STR(OUT,LOC('   # ')); B_NUM(OUT,L_GET(CNV,I)); B_STR(OUT,LOC(' #')));
       B_CH(OUT,10));
    I:=I+1);
 I:=0;
 WHILE I<L_LEN(MACD) DO (
    L_GET(MACW,I)=0 => (
       B_STR(OUT,LOC('LET ')); B_STR(OUT,QN(L_GET(MACD,I))); B_CH(OUT,61); B_STR(OUT,L_GET(MACV,I)); B_CH(OUT,59);
       GETB(L_GET(MACS,I),0)=45 => (B_STR(OUT,LOC('   # ')); B_STR(OUT,L_GET(MACS,I)); B_STR(OUT,LOC(' #')));
       B_CH(OUT,10));
    I:=I+1);
 # THE STRUCTURES, IN THE ORDER OF THEIR DEFINITIONS (A MEMBER'S STRUCTURE IS BEFORE IT) #
 J:=0;
 WHILE J<NO DO (
    I:=L_GET(DEFORD,J);
    ((L_GET(STNEED,I) NE 0) AND (L_GET(STSTATE,I)=1)) => (
       B_STR(OUT,LOC('STRUCT ')); B_STR(OUT,QN(L_GET(STNAME,I))); B_STR(OUT,LOC(' ('));
       B_STR(OUT,L_GET(STBODY,I)); B_LN(OUT,LOC(');')));
    J:=J+1);
 # THE FUNCTIONS #
 I:=0;
 WHILE I<L_LEN(FNN) DO (
    ((L_GET(FNT,I) NE 0) AND (SELECTED(L_GET(FNN,I)) NE 0)) => B_LN(OUT,L_GET(FNT,I));
    I:=I+1);
 # WHAT CANNOT BE EXPRESSED #
 NU:=0;
 I:=0;
 WHILE I<L_LEN(FNN) DO (
    ((L_GET(FNT,I)=0) AND (SELECTED(L_GET(FNN,I)) NE 0)) => (
       NU=0 => (B_LN(OUT,LOC('# NOT EXPRESSED:')); NU:=1);
       B_STR(OUT,LOC('    function ')); B_STR(OUT,L_GET(FNN,I)); B_STR(OUT,LOC(': ')); B_STR(OUT,L_GET(FNW,I)); B_LN(OUT,S_E(0)));
    I:=I+1);
 I:=0;
 WHILE I<N DO (
    ((L_GET(STSTATE,I)=2) AND (STSEL(I) NE 0)) => (
       NU=0 => (B_LN(OUT,LOC('# NOT EXPRESSED:')); NU:=1);
       B_STR(OUT,LOC('    structure ')); B_STR(OUT,L_GET(STNAME,I)); B_STR(OUT,LOC(': ')); B_STR(OUT,L_GET(STWHY,I)); B_LN(OUT,S_E(0)));
    I:=I+1);
 I:=0;
 WHILE I<L_LEN(CNN) DO (
    ((L_GET(CNK,I)=0) AND (SELECTED(L_GET(CNN,I)) NE 0)) => (
       NU=0 => (B_LN(OUT,LOC('# NOT EXPRESSED:')); NU:=1);
       B_STR(OUT,LOC('    enumerator ')); B_STR(OUT,L_GET(CNN,I)); B_STR(OUT,LOC(': ')); B_STR(OUT,L_GET(CNW,I)); B_LN(OUT,S_E(0)));
    I:=I+1);
 I:=0;
 WHILE I<L_LEN(MACD) DO (
    L_GET(MACW,I) NE 0 => (
       NU=0 => (B_LN(OUT,LOC('# NOT EXPRESSED:')); NU:=1);
       B_STR(OUT,LOC('    macro ')); B_STR(OUT,L_GET(MACD,I)); B_STR(OUT,LOC(': ')); B_STR(OUT,L_GET(MACW,I)); B_LN(OUT,S_E(0)));
    I:=I+1);
 NU NE 0 => B_LN(OUT,LOC('#'));
 0);

# THE OUTPUT TO THE FILE -o NAMES, OR TO THE STANDARD OUTPUT #
SUBR WRITE_FILE(Z) IS (
 F,N ARE LOCAL;
 N:=RD(OUT,0);
 OUTP=0 => (CCALL fwrite(RD(OUT,2),1,N,IMPSTDOUT(0)); CCALL fflush(IMPSTDOUT(0)); RETURN 0);
 F:=CCALL fopen(OUTP,'wb');
 F=0 => DIE(LOC('cannot write'),OUTP);
 CCALL fwrite(RD(OUT,2),1,N,F);
 CCALL fclose(F)=0 => 0 ELSE DIE(LOC('write failed'),OUTP);
 0)
%%
