#TOKEN-DIFF-LEX.IMP -- THE SECOND FILE OF TOOLS/TOKEN-DIFF.IMP: THE TOKENS OF A SOURCE FILE OF IMP, AND THE LINES THEY ARE ON.
THE LEXER OF THE ORIGINAL (DECUS/LEX.IMC) AND OF THE PORT (SRC/LEX.IMC) AGREE ON EVERYTHING BUT WHICH CHARACTERS ARE PARTS OF NAMES: A NAME IS A RUN OF DIGITS AND LETTERS, AND IN THE PORT ALSO @, THE UNDERSCORE, THE GRAVE ACCENT AND ALL BYTES OF 128 AND UP
(UTF-8); IN THE ORIGINAL THOSE ARE TOKENS OF ONE CHARACTER, AND THE UNDERSCORE IS THE ASSIGNMENT.  A BYTE OF 32 OR LESS SEPARATES TOKENS.  A TEXT IN APOSTROPHES (TWO APOSTROPHES ARE ONE), A TEXT BETWEEN EXCLAMATION MARKS AND A COMMENT BETWEEN
NUMBER SIGNS ARE THE SAME IN BOTH.  THE NUMBERS ARE NOT THE LEXER'S: 1.5E3 IS THE TOKENS 1 . 5E3 AND THE SYNTAX PUTS THEM TOGETHER.  FOR READING THE DIFFERENCES A NUMBER WITH A POINT, := AND ::= AND => ARE TOKENS HERE, WHICH IS THE SAME ON BOTH SIDES.
EACH WORD OF A COMMENT IS A TOKEN, AND AN APOSTROPHE IN A COMMENT STARTS NO TEXT.  A TOKEN IS AN INTEGER (ITS NUMBER IN THE TABLE OF THE TEXTS SEEN, THE SAME IN BOTH FILES), SO THAT THE COMPARISON OF TOKENS IS EXACT AND QUICK.
PORT=1 IS THE PORT'S CHARACTERS, 0 THE ORIGINAL'S.#

LET LF=10, SQ=39, HASH=35, BANG=33;
EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL PTR strndup(PTR, SIZE);
EXTERNAL PTR strdup(PTR);
EXTERNAL INT strcmp(PTR, PTR);
TKEY,TID,NID,TAILW ARE COMMON;

# THE TABLE OF TEXTS: OPEN ADDRESSING, 2**18 SLOTS; A SLOT HAS THE TEXT (0 IF FREE) AND THE NUMBER OF THE TEXT #
SUBR TABINIT(Z) IS (
 TKEY:=CCALL calloc(262144,8); TID:=CCALL calloc(262144,8); NID:=0; 0);

SUBR INTERN(S) IS (
 H,I,C,SL,K,F ARE LOCAL;
 H:=0; I:=0; F:=1;
 WHILE F NE 0 DO (C:=GETB(S,I); C=0 => F:=0 ELSE (H:=(H*131)+C; I:=I+1));
 SL:=H AND 262143; F:=1;
 WHILE F NE 0 DO (
    K:=RD(TKEY,SL);
    K=0 => F:=0
    ELSE (CCALL strcmp(K,S)=0 => F:=0 ELSE SL:=(SL+1) AND 262143));
 RD(TKEY,SL)=0 => (
    NID>200000 => DIE(LOC('too many different tokens'),S);
    WR(TKEY,SL,CCALL strdup(S)); NID:=NID+1; WR(TID,SL,NID));
 RD(TID,SL));

# A LETTER OR A DIGIT, AND IN THE PORT THE OTHER CHARACTERS OF ITS NAMES #
SUBR ISNAMEC(C,PORT) IS (
 ((C GE 48) AND (C LE 57)) => RETURN 1;
 ((C GE 65) AND (C LE 90)) => RETURN 1;
 ((C GE 97) AND (C LE 122)) => RETURN 1;
 PORT=0 => RETURN 0;
 ((C=64) OR (C=95) OR (C=96) OR (C GE 128)) => RETURN 1;
 0);

SUBR ISDIG(C) IS ((C GE 48) AND (C LE 57));

# THE BYTES OF THE NAME THAT BEGINS AT P #
SUBR NAMELEN(BUF,P,PORT) IS (
 N,F ARE LOCAL;
 N:=1; F:=1;
 WHILE F NE 0 DO (ISNAMEC(GETB(BUF,P+N),PORT) NE 0 => N:=N+1 ELSE F:=0);
 N);

# THE BYTES OF THE TOKEN THAT BEGINS AT P (NEVER 0 BYTES): INC SAYS THE TOKEN IS IN A COMMENT #
SUBR TOKLEN(BUF,P,PORT,INC) IS (
 C,D,N,F ARE LOCAL;
 C:=GETB(BUF,P);
 INC NE 0 => (
    C=HASH => RETURN 1;
    N:=0; F:=1;
    WHILE F NE 0 DO (
       D:=GETB(BUF,P+N);
       ((D=0) OR (D=HASH) OR (D LE 32)) => F:=0 ELSE N:=N+1);
    N=0 => N:=1;
    RETURN N);
 C=SQ => (
    N:=1; F:=1;
    WHILE F NE 0 DO (
       D:=GETB(BUF,P+N);
       D=0 => F:=0
       ELSE (N:=N+1; D=SQ => (GETB(BUF,P+N)=SQ => N:=N+1 ELSE F:=0)));
    RETURN N);
 C=BANG => (
    N:=1; F:=1;
    WHILE F NE 0 DO (
       D:=GETB(BUF,P+N);
       D=0 => F:=0
       ELSE (N:=N+1; D=BANG => F:=0));
    RETURN N);
 ISDIG(C) NE 0 => (
    N:=NAMELEN(BUF,P,PORT);
    GETB(BUF,P+N)=46 => (ISDIG(GETB(BUF,P+N+1)) NE 0 => N:=N+1+NAMELEN(BUF,P+N+1,PORT));
    RETURN N);
 ISNAMEC(C,PORT) NE 0 => RETURN NAMELEN(BUF,P,PORT);
 C=58 => (
    GETB(BUF,P+1)=58 => (GETB(BUF,P+2)=61 => RETURN 3);
    GETB(BUF,P+1)=61 => RETURN 2;
    RETURN 1);
 C=61 => (GETB(BUF,P+1)=62 => RETURN 2; RETURN 1);
 C GE 128 => (
    N:=1; F:=1;
    WHILE F NE 0 DO (D:=GETB(BUF,P+N); ((D GE 128) AND (D<192)) => N:=N+1 ELSE F:=0);
    RETURN N);
 1);

# THE TOKENS OF BUF (LEN BYTES, FOLLOWED BY ZEROS): TO THE LISTS OF TEXTS TT, THE WHITE SPACE BEFORE EACH TP, THE LINE TL (FROM 1) AND THE NUMBER IN THE TABLE TD; TAILW IS THE WHITE SPACE AFTER THE LAST #
SUBR TOKENIZE(BUF,LEN,PORT,TT,TP,TL,TD) IS (
 P,S,LN,INC,N,C,T,F,I ARE LOCAL;
 P:=0; LN:=1; INC:=0; TAILW:=CCALL strdup(LOC(' '));
 PUTB(TAILW,0,0);
 WHILE P<LEN DO (
    S:=P; F:=1;
    WHILE F NE 0 DO (
       P<LEN => (GETB(BUF,P) LE 32 => (GETB(BUF,P)=LF => LN:=LN+1; P:=P+1) ELSE F:=0) ELSE F:=0);
    P GE LEN => (TAILW:=CCALL strndup(BUF+S,P-S); RETURN 0);
    C:=GETB(BUF,P);
    N:=TOKLEN(BUF,P,PORT,INC);
    T:=CCALL strndup(BUF+P,N);
    L_ADD(TP,CCALL strndup(BUF+S,P-S)); L_ADD(TT,T); L_ADD(TL,LN); L_ADD(TD,INTERN(T));
    C=HASH => (INC=0 => INC:=1 ELSE INC:=0);
    ((C=SQ) OR (C=BANG)) => (I:=0; WHILE I<N DO (GETB(BUF,P+I)=LF => LN:=LN+1; I:=I+1));
    P:=P+N);
 0)
%%
