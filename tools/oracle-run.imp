#ORACLE-RUN.IMP -- COMPILE, LINK AND RUN IMP PROGRAMS WITH THE ORIGINAL COMPILER (IMP 1.5 ON TOPS-10 6.03, THE SIMH KA10 OR KI10; START IT WITH TOOLS/ORACLE-BOOT.SH).  RUN BY TOOLS/IMPTOOL.SH.

    ORACLE-RUN [-D DIR] [--LST] PROG.IMP...

WITH --LST ONLY COMPILE, WITH /A/L (THE SWITCHES OF THE ENVIRONMENT'S ORACLE_SW, DEFAULT /A, AND /L), AND KEEP THE ASSEMBLY LISTING (DIR/NAME.LST).  FOR EACH PROGRAM THE OUTPUT THE PROGRAM PUT INTO ITS DEFAULT OUTPUT
FILE (PO) IS WRITTEN TO DIR/NAME.ORACLE (DEFAULT: STANDARD OUTPUT, AFTER A HEADER LINE), TABS EXPANDED TO THE 8 COLUMN STOPS OF THE TERMINAL.  THE COMPILER'S MESSAGES GO TO DIR/NAME.COMPILE, WHAT THE LINKER AND
THE PROGRAM SAID ON THE TERMINAL TO DIR/NAME.TTY.  A PROGRAM IS SENT TO THE ORIGINAL AS THE TAPE WROTE IT, WITH _ FOR THE ASSIGNMENT: TOOLS/IMP-ASSIGN.IMP -T MAKES THE TEXT (TMP/ORACLE-TEXT/NAME), AND
TOOLS/PDP10TAP.IMP PUTS IT ON THE TAPE ORACLE/TAPES/IN.TAP.  RUN FROM ANYWHERE: THE TREE IS FOUND FROM THE NAME OF THIS PROGRAM (BUILD/TOOLS/ORACLE-RUN).  IT IS THE TRANSLATION OF THE PYTHON PROGRAM THAT WAS HERE;
NUL BYTES FROM THE LINE ARE LEFT OUT, NOT KEPT.#

SFD,STO,USER,PASS,TSP,TMP3,PFD,RBUF,GOTB,RD,RAWB,WORD,NARG,AI,OUTDIR,LST,ROOT,SWT,CWD,SNLDOT,STYPPO,STMOUT,SNL,SEMPTY ARE COMMON;

# THE MAIN PROGRAM #
NARG:=CCALL impargc(0);
AI:=1; OUTDIR:=0; LST:=0;
PARSE(0);
FINDROOT(0);
OUTDIR NE 0 => SHELL(LOC('mkdir -p ''%s'''),OUTDIR);
RUN(0);
CCALL exit(0);

EXTERNAL INT printf(PTR, ...);
EXTERNAL INT sprintf(PTR, PTR, ...);
SUBR USAGE(Z) IS (DIE(LOC('usage: oracle-run [-d DIR] [--lst] PROG.imp...'),0));

SUBR PARSE(Z) IS (
 WHILE AI<NARG DO (
    GETB(ARG(AI),0) NE 45 => RETURN 0;
    SCMP(ARG(AI),LOC('-d'))=0 => (
       (AI+1)<NARG => 0 ELSE USAGE(0);
       OUTDIR:=CCALL strdup(ARG(AI+1)); AI:=AI+2)
    ELSE (SCMP(ARG(AI),LOC('--lst'))=0 => (LST:=1; AI:=AI+1) ELSE USAGE(0)));
 0);

# THE ROOT OF THE TREE: THE NAME OF THIS PROGRAM, BUILD/TOOLS/ORACLE-RUN, WITHOUT THE LAST THREE PARTS; AND THE DIRECTORY #
SUBR FINDROOT(Z) IS (
 K,P,S ARE LOCAL;
 S:=CCALL strdup(ARG(0));
 K:=0;
 L8: K<3 => (
    P:=CCALL strrchr(S,47);
    P=0 => (ROOT:=CCALL strdup(LOC('.')); GO TO L7);
    PUTB(P,0,0); K:=K+1; GO TO L8);
 GETB(S,0)=0 => ROOT:=CCALL strdup(LOC('/')) ELSE ROOT:=S;
 L7: CWD:=CCALL calloc(4100,1); CCALL getcwd(CWD,4096);
 SWT:=CCALL getenv(LOC('ORACLE_SW')); SWT=0 => SWT:=LOC('/A');
 SNLDOT:=MKS(LOC('|.')); STYPPO:=MKS(LOC('TYPE PO.|')); STMOUT:=MKS(LOC('|[TIMEOUT]|')); SNL:=MKS(LOC('|')); SEMPTY:=CCALL calloc(1,1);
 0);

# A COMMAND FOR THE SHELL FROM A FORMAT WITH ONE %S: AN ERROR IS THE END #
SUBR SHELL(FMT,A) IS (
 C,R ARE LOCAL;
 C:=CCALL calloc(CCALL strlen(FMT)+CCALL strlen(A)+8200,1);
 CCALL sprintf(C,FMT,A);
 R:=(CCALL system(C)) AND 4294967295;
 R NE 0 => DIE(LOC('command failed'),C);
 0);

# A BUFFER BYTE: THE BYTES OF TEXT APPENDED TO THE BUFFER BP #
SUBR APP(BP,S) IS (BADD(BP,S,CCALL strlen(S)); 0);

# THE BASE OF A FILE NAME: AFTER THE LAST /, BEFORE THE LAST POINT (NOT THE POINT OF A NAME THAT HAS NOTHING BUT POINTS BEFORE IT) #
SUBR STEM(PATH) IS (
 B,D,K,F,R ARE LOCAL;
 B:=CCALL strrchr(PATH,47); B=0 => B:=PATH ELSE B:=B+1;
 R:=CCALL strdup(B);
 D:=CCALL strrchr(R,46);
 D=0 => RETURN R;
 F:=0; K:=R;
 WHILE K<D DO (GETB(K,0) NE 46 => F:=1; K:=K+1);
 F NE 0 => PUTB(D,0,0);
 R);

# THE TOPS-10 NAME OF A PROGRAM: THE BASE IN CAPITALS, SIX CHARACTERS AT MOST #
SUBR NAMEOF(PATH) IS (
 R,K,C ARE LOCAL;
 R:=STEM(PATH); K:=0;
 WHILE GETB(R,K) NE 0 DO (C:=GETB(R,K); ((C>96) AND (C<123)) => PUTB(R,K,C-32); K:=K+1);
 CCALL strlen(R)>6 => PUTB(R,6,0);
 R);

# THE PROGRAM AS THE ORIGINAL READS IT: TOOLS/IMP-ASSIGN.IMP -T, INTO TMP/ORACLE-TEXT/ THE FILE'S NAME; THE NAME OF THAT FILE #
SUBR TAPETEXT(P) IS (
 Q,A,C,B,D,R ARE LOCAL;
 D:=CCALL calloc(CCALL strlen(ROOT)+64,1); CCALL sprintf(D,LOC('%s/tmp/oracle-text'),ROOT);
 SHELL(LOC('mkdir -p ''%s'''),D);
 B:=CCALL strrchr(P,47); B=0 => B:=P ELSE B:=B+1;
 Q:=CCALL calloc(CCALL strlen(D)+CCALL strlen(B)+8,1); CCALL sprintf(Q,LOC('%s/%s'),D,B);
 A:=CCALL calloc(CCALL strlen(CWD)+CCALL strlen(P)+8,1);
 GETB(P,0)=47 => CCALL strcpy(A,P) ELSE CCALL sprintf(A,LOC('%s/%s'),CWD,P);
 C:=CCALL calloc((CCALL strlen(ROOT)*2)+CCALL strlen(A)+CCALL strlen(Q)+8200,1);
 CCALL sprintf(C,LOC('sh ''%s/tools/imptool.sh'' imp-assign -t ''%s'' > ''%s'''),ROOT,A,Q);
 R:=(CCALL system(C)) AND 4294967295;
 R NE 0 => DIE(LOC('command failed'),C);
 Q);

# THE TAPE ORACLE/TAPES/IN.TAP WITH THE FILE ON IT (TOOLS/PDP10TAP.IMP) #
SUBR PUTTAPE(Q) IS (
 C,R ARE LOCAL;
 C:=CCALL calloc((CCALL strlen(ROOT)*2)+CCALL strlen(Q)+8200,1);
 CCALL sprintf(C,LOC('sh ''%s/tools/imptool.sh'' pdp10tap put ''%s/oracle/tapes/in.tap'' ''%s'''),ROOT,ROOT,Q);
 R:=(CCALL system(C)) AND 4294967295;
 R NE 0 => DIE(LOC('command failed'),C);
 0);

# THE TEXT AFTER THE FIRST S IN T (T WHOLE IF THERE IS NONE) #
SUBR AFTER(T,S) IS (
 P ARE LOCAL;
 P:=CCALL strstr(T,S);
 P=0 => RETURN T;
 P+CCALL strlen(S));

# A COPY OF THE TEXT UP TO THE LAST S IN T (T WHOLE IF THERE IS NONE) #
SUBR BEFORE(T,S) IS (
 P,R ARE LOCAL;
 R:=0; P:=CCALL strstr(T,S);
 WHILE P NE 0 DO (R:=P; P:=CCALL strstr(P+1,S));
 R=0 => RETURN CCALL strdup(T);
 CCALL strndup(T,R-T));

# A TEXT FROM THE CONSTANT, THE VERTICAL BARS BECOMING NEW LINES (A TEXT CONSTANT HAS NONE OF ITS OWN) #
SUBR MKS(T) IS (
 R,I,C ARE LOCAL;
 R:=CCALL strdup(T); I:=0; C:=GETB(R,0);
 WHILE C NE 0 DO (C=124 => PUTB(R,I,10); I:=I+1; C:=GETB(R,I));
 R);

# A COPY OF THE TEXT WITHOUT THE NEW LINES AT ITS START AND END #
SUBR STRIPNL(T) IS (
 S,E ARE LOCAL;
 S:=0; E:=CCALL strlen(T);
 WHILE GETB(T,S)=10 DO S:=S+1;
 L11: E>S => (GETB(T,E-1)=10 => (E:=E-1; GO TO L11));
 CCALL strndup(T+S,E-S));

SUBR ISWS(C) IS (((C=32) OR ((C>8) AND (C<14)) OR ((C>27) AND (C<32))));

# ONE BYTE ONTO A BUFFER #
SUBR BCH(BP,C) IS (PUTB(TMP3,16,C); BADD(BP,TMP3+16,1); 0);

# THE TEXT AS THE PYTHON MAKES IT OF THE LISTING OR THE OUTPUT: EACH LINE WITH ITS TABS EXPANDED TO THE STOPS OF 8 AND ITS BLANKS AT THE END GONE, THE NEW LINES AT THE START AND THE END GONE, AND ONE NEW LINE AT THE END #
SUBR TEXTFIX(T) IS (
 BP,LB,S,E,C,COL,K,N1,FIRST,R,X ARE LOCAL;
 BP:=BNEW(0); LB:=BNEW(0);
 S:=0; FIRST:=1;
 L12: E:=S;
 WHILE ISEOLN(GETB(T,E))=0 DO E:=E+1;
 BCLR(LB); COL:=0; K:=S;
 WHILE K<E DO (
    C:=GETB(T,K);
    C=9 => (N1:=8-(COL AND 7); WHILE N1>0 DO (BCH(LB,32); COL:=COL+1; N1:=N1-1)) ELSE (BCH(LB,C); COL:=COL+1);
    K:=K+1);
 N1:=GW(LB,1);
 WHILE N1>0 DO (ISWS(GETB(GW(LB,0),N1-1)) NE 0 => N1:=N1-1 ELSE GO TO L13);
 L13: FIRST=0 => BCH(BP,10);
 FIRST:=0;
 N1>0 => BADD(BP,GW(LB,0),N1);
 GETB(T,E)=0 => GO TO L14;
 S:=E+1; GO TO L12;
 L14: R:=STRIPNL(GW(BP,0));
 X:=BNEW(0); BADD(X,R,CCALL strlen(R)); BCH(X,10);
 GW(X,0));

SUBR ISEOLN(C) IS ((C=10) OR (C=0));

# THE TEXT, AS PYTHON'S REPR WRITES IT, ONTO A BUFFER #
SUBR REPR(BP,P) IS (
 Q,C,I ARE LOCAL;
 Q:=39;
 CCALL strchr(P,39) NE 0 => (CCALL strchr(P,34)=0 => Q:=34);
 BCH(BP,Q); I:=0; C:=GETB(P,0);
 WHILE C NE 0 DO (
    C=92 => (BCH(BP,92); BCH(BP,92)) ELSE (
    C=Q => (BCH(BP,92); BCH(BP,C)) ELSE (
    C=10 => (BCH(BP,92); BCH(BP,110)) ELSE (
    C=13 => (BCH(BP,92); BCH(BP,114)) ELSE (
    C=9 => (BCH(BP,92); BCH(BP,116)) ELSE (
    ((C<32) OR (C=127)) => (PUTB(TMP3,20,0); CCALL sprintf(TMP3+20,LOC('\x%02x'),C); APP(BP,TMP3+20)) ELSE BCH(BP,C))))));
    I:=I+1; C:=GETB(P,I));
 BCH(BP,Q); 0);

# A FILE WITH THE TEXT #
SUBR WRITEF(PATH,T) IS (
 F,L ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('wb'));
 F=0 => DIE(LOC('cannot write'),PATH);
 L:=CCALL strlen(T);
 L>0 => CCALL fwrite(T,1,L,F) NE L => DIE(LOC('cannot write'),PATH);
 CCALL fclose(F);
 0);

# A FILE OF THE DIRECTORY OF OUTPUT: DIR/BASE.EXT WITH THE TEXT #
SUBR WRITEO(BASE,EXT,T) IS (
 P ARE LOCAL;
 P:=CCALL calloc(CCALL strlen(OUTDIR)+CCALL strlen(BASE)+CCALL strlen(EXT)+4,1);
 CCALL sprintf(P,LOC('%s/%s%s'),OUTDIR,BASE,EXT);
 WRITEF(P,T);
 0);

# THE TWO TEXTS ONE AFTER THE OTHER #
SUBR CAT2(A,B) IS (
 R ARE LOCAL;
 R:=CCALL calloc(CCALL strlen(A)+CCALL strlen(B)+2,1);
 CCALL strcpy(R,A); CCALL strcat(R,B);
 R);

SUBR RUN(Z) IS (
 K,N,P,Q,NM,COMP,EX,TT,TTY,TXT,BASE,B,X,I,SEP,SWS ARE LOCAL;
 SESSION(10603,120);
 CMD(LOC('TTY WIDTH 200'),1,0);           # THE TERMINAL FOLDS LINES AT 72 COLUMNS: NOT IN OUR OUTPUT #
 K:=AI;
 WHILE K<NARG DO (                        # ONE TAPE PER PROGRAM: SEVERAL FILES ON ONE TAPE LOSE THE LAST #
    P:=ARG(K); NM:=NAMEOF(P);
    PUTTAPE(TAPETEXT(P));
    CMD(LOC('ASSIGN MTA0: TAPE'),1,0);
    CMD(LOC('REWIND TAPE:'),1,0);
    CMD(LOC('R PIP'),2,30);
    B:=CCALL calloc(CCALL strlen(NM)+32,1); CCALL sprintf(B,LOC('DSK:%s.IMP=TAPE:/B'),NM);
    SENDLN(B);
    EXPECTX(2,120);
    RAWC(3,0,1);
    EXPECTX(1,20);
    CMD(LOC('DEASSIGN TAPE:'),1,0);
    K:=K+1);
 K:=AI;
 WHILE K<NARG DO (
    P:=ARG(K); NM:=NAMEOF(P); BASE:=STEM(P);
    B:=CCALL calloc(CCALL strlen(NM)+64,1); CCALL sprintf(B,LOC('DELETE PO.,%s.REL'),NM);
    CMD(B,1,0);
    SENDLN(LOC('RUN IMP'));
    EXPECTX(2,60);
    B:=CCALL calloc(CCALL strlen(NM)+CCALL strlen(SWT)+16,1);
    LST NE 0 => CCALL sprintf(B,LOC('%s.IMP%s/L'),NM,SWT) ELSE CCALL sprintf(B,LOC('%s.IMP'),NM);
    SENDLN(B);
    COMP:=CCALL strdup(EXPECTX(1,600));
    LST NE 0 => (                          # THE ASSEMBLY LISTING ONLY: NO LINK, NO RUN #
       B:=CCALL calloc(CCALL strlen(NM)+16,1); CCALL sprintf(B,LOC('TYPE %s.LST'),NM);
       SENDLN(B);
       TXT:=CCALL strdup(EXPECTX(1,600));
       SEP:=CCALL calloc(CCALL strlen(NM)+16,1); CCALL sprintf(SEP,LOC('TYPE %s.LST'),NM); PUTB(SEP,CCALL strlen(SEP),10);
       TXT:=BEFORE(AFTER(TXT,SEP),SNLDOT);
       TXT:=TEXTFIX(TXT);
       OUTDIR NE 0 => (WRITEO(BASE,LOC('.lst'),TXT); WRITEO(BASE,LOC('.compile'),COMP))
       ELSE (OUTS(TXT); OUTC(10));
       B:=CCALL calloc((CCALL strlen(NM)*2)+32,1); CCALL sprintf(B,LOC('DELETE %s.LST,%s.REL'),NM,NM);
       CMD(B,1,0))
    ELSE (
       B:=CCALL calloc((CCALL strlen(NM)*2)+80,1); CCALL sprintf(B,LOC('EX %s.REL,/LIBRARY,IMPLIB.LIB,SYS:FORLIB/LIBRARY'),NM);
       SENDLN(B);
       EXPECT(1,120)=0 => (                 # A PROGRAM THAT DOES NOT STOP: ^C IT #
          X:=BNEW(0);
          APP(X,LOC('waiting for ''^\\.''; got '));
          I:=GW(GOTB,1); I>300 => I:=300;
          REPR(X,GW(GOTB,0)+(GW(GOTB,1)-I));
          APP(X,STMOUT);
          RAWC(3,3,2);
          CCALL sleep(2);
          TLREAD(3000);
          EX:=GW(X,0))
       ELSE EX:=CCALL strdup(GW(GOTB,0));
       TT:=BEFORE(AFTER(EX,LOC('Execution]')),SNLDOT);
       TTY:=STRIPNL(TT);
       CCALL sleep(1);
       SENDLN(LOC('TYPE PO.'));
       TXT:=CCALL strdup(EXPECTX(1,120));
       TXT:=BEFORE(AFTER(TXT,STYPPO),SNLDOT);
       TXT:=TEXTFIX(TXT);
       OUTDIR NE 0 => (
          WRITEO(BASE,LOC('.oracle'),TXT);
          WRITEO(BASE,LOC('.compile'),CAT2(COMP,EX));
          GETB(TTY,0) NE 0 => WRITEO(BASE,LOC('.tty'),CAT2(TTY,SNL)) ELSE WRITEO(BASE,LOC('.tty'),SEMPTY))
       ELSE (OUTS(LOC('== ')); OUTS(NM); OUTC(10); OUTS(TXT)));
    K:=K+1);
 CLOSE(0);
 0);

# ---- THE TERMINAL SESSION WITH TOPS-10 (THE TRANSLATION OF THE SESSION CLASS OF THE PYTHON TOOLS/ORACLE.PY): A TELNET CONNECTION TO THE DC LINE OF THE SIMULATOR ---- #

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR GW(P,I) IS [P+(8*I)];

SUBR SW(P,I,V) IS ([P+(8*I)]:=V; 0);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

# A MESSAGE ON THE STANDARD ERROR, AND THE END WITH STATUS 1 #
SUBR DIE(M,A) IS (
 CCALL write(2,M,CCALL strlen(M)); A NE 0 => (CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A)));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

# OUTPUT ON THE STANDARD OUTPUT OF THE C LIBRARY #
SUBR OUTS(P) IS (CCALL printf(LOC('%s'),P); 0);
SUBR OUTC(C) IS (CCALL putchar(C); 0);

SUBR SCMP(A,B) IS (
 R ARE LOCAL;
 R:=(CCALL strcmp(A,B)) AND 4294967295; R>2147483647 => R:=R-4294967296;
 R);

SUBR SNCMP(A,B,L) IS (
 R ARE LOCAL;
 R:=(CCALL strncmp(A,B,L)) AND 4294967295; R>2147483647 => R:=R-4294967296;
 R);

# THE MILLISECONDS OF THE MONOTONIC CLOCK #
SUBR NOWMS(Z) IS (
 CCALL clock_gettime(1,TSP);
 (GW(TSP,0)*1000)+(GW(TSP,1)/1000000));

# A BUFFER THAT GROWS: B, ITS LENGTH, ITS ROOM: A GROWTH BY L BYTES, AND THE BYTES P (L OF THEM) ADDED #
SUBR BADD(BP,P,L) IS (
 CAP,LN,B ARE LOCAL;
 B:=GW(BP,0); LN:=GW(BP,1); CAP:=GW(BP,2);
 WHILE (LN+L+2)>CAP DO CAP:=CAP*2;
 B:=CCALL realloc(B,CAP);
 CCALL memcpy(B+LN,P,L); LN:=LN+L; PUTB(B,LN,0);
 SW(BP,0,B); SW(BP,1,LN); SW(BP,2,CAP);
 0);

# A NEW BUFFER (THREE WORDS: THE BYTES, THE LENGTH, THE ROOM) #
SUBR BNEW(Z) IS (
 BP ARE LOCAL;
 BP:=CCALL calloc(3,8); SW(BP,0,CCALL calloc(4096,1)); SW(BP,1,0); SW(BP,2,4096);
 BP);

SUBR BCLR(BP) IS (SW(BP,1,0); PUTB(GW(BP,0),0,0); 0);

# WHOLE BUFFER SENT: ALL P (L BYTES) #
SUBR SENDALL(P,L) IS (
 K,R ARE LOCAL;
 K:=0;
 WHILE K<L DO (
    R:=CCALL send(SFD,P+K,L-K,16384);
    R<1 => DIE(LOC('cannot send to the oracle'),0);
    K:=K+R);
 0);

# THE TERMINAL LINE DROPS CHARACTERS SENT IN A BURST: ONE AT A TIME, 30 MS APART #
SUBR SEND(S) IS (
 K,L ARE LOCAL;
 L:=CCALL strlen(S); K:=0;
 WHILE K<L DO (SENDALL(S+K,1); CCALL usleep(30000); K:=K+1);
 0);

SUBR RAW(S) IS (SENDALL(S,CCALL strlen(S)); 0);

SUBR SEND3(A,B,C) IS (
 PUTB(TMP3,0,A); PUTB(TMP3,1,B); PUTB(TMP3,2,C); SENDALL(TMP3,3); 0);

# WHAT ARRIVES WITHIN WAITMS MILLISECONDS OF THE LAST DATA, THE TELNET NEGOTIATION ANSWERED AND TAKEN OUT, THE HIGH BIT AND THE CR (AND, HERE, NUL) LEFT OUT: IN THE BUFFER RD #
SUBR TLREAD(WAITMS) IS (
 R,NB,I,C,V,J,L,RP,REPLY,K ARE LOCAL;
 BCLR(RAWB); BCLR(RD);
 L1: PUTB(PFD,0,SFD AND 255); PUTB(PFD,1,(SFD RS 8) AND 255); PUTB(PFD,2,0); PUTB(PFD,3,0); PUTB(PFD,4,1); PUTB(PFD,5,0); PUTB(PFD,6,0); PUTB(PFD,7,0);
 R:=(CCALL poll(PFD,1,WAITMS)) AND 4294967295;
 R=0 => GO TO L2;
 R>2147483647 => GO TO L2;
 NB:=CCALL recv(SFD,RBUF,4096,0);
 NB<1 => GO TO L2;
 BADD(RAWB,RBUF,NB);
 GO TO L1;
 L2: RP:=GW(RAWB,0); L:=GW(RAWB,1); I:=0;
 WHILE I<L DO (
    C:=GETB(RP,I);
    ((C=255) AND ((I+1)<L)) => (
       V:=GETB(RP,I+1);
       (((V>250) AND (V<255)) AND ((I+2)<L)) => (
          REPLY:=0;
          V=253 => REPLY:=252;
          V=251 => REPLY:=254;
          REPLY NE 0 => SEND3(255,REPLY,GETB(RP,I+2));
          I:=I+3; GO TO L3);
       V=250 => (
          J:=I; K:=0-1;
          WHILE J<(L-1) DO (((GETB(RP,J)=255) AND (GETB(RP,J+1)=240)) => (K:=J; J:=L) ELSE J:=J+1);
          K<0 => I:=L ELSE I:=K+2;
          GO TO L3);
       I:=I+2; GO TO L3);
    C:=C AND 127;
    C NE 13 => (C NE 0 => (PUTB(TMP3,4,C); BADD(RD,TMP3+4,1)));
    I:=I+1;
    L3: 0);
 0);

# DOES THE TEXT OF THE SESSION HAVE WHAT KIND SAYS: 1 A LINE THAT STARTS WITH A POINT, 2 WITH AN ASTERISK, 3 PASSWORD: OR ALREADY OR A QUESTION MARK, 4 CONFIRM: #
SUBR MATCH(KIND) IS (
 I,C,G,L ARE LOCAL;
 G:=GW(GOTB,0); L:=GW(GOTB,1);
 KIND=3 => (
    CCALL strstr(G,LOC('Password:')) NE 0 => RETURN 1;
    CCALL strstr(G,LOC('already')) NE 0 => RETURN 1;
    CCALL strstr(G,LOC('Already')) NE 0 => RETURN 1;
    CCALL strchr(G,63) NE 0 => RETURN 1;
    RETURN 0);
 KIND=4 => (CCALL strstr(G,LOC('Confirm:')) NE 0 => RETURN 1 ELSE RETURN 0);
 C:=46; KIND=2 => C:=42;
 I:=0;
 WHILE I<L DO (
    GETB(G,I)=C => (I=0 => RETURN 1; GETB(G,I-1)=10 => RETURN 1);
    I:=I+1);
 0);

# THE TEXT OF THE SESSION UP TO WHAT KIND SAYS (IN GOTB: 1 IF IT CAME WITHIN TOSEC SECONDS (0: THE TIMEOUT OF THE SESSION), 0 IF NOT #
SUBR EXPECT(KIND,TOSEC) IS (
 E ARE LOCAL;
 BCLR(GOTB);
 E:=NOWMS(0);
 TOSEC=0 => E:=E+(STO*1000) ELSE E:=E+(TOSEC*1000);
 WHILE NOWMS(0)<E DO (
    TLREAD(300);
    GW(RD,1)>0 => BADD(GOTB,GW(RD,0),GW(RD,1));
    MATCH(KIND) NE 0 => RETURN 1);
 0);

# THE SAME, A TIMEOUT BEING THE END OF THE PROGRAM (AN UNCAUGHT TIMEOUTERROR OF THE PYTHON) AFTER THE SESSION IS CLOSED #
SUBR EXPECTX(KIND,TOSEC) IS (
 EXPECT(KIND,TOSEC)=0 => (CLOSE(0); DIE(LOC('timed out waiting for the oracle: '),TAILOF(0)));
 GW(GOTB,0));

# THE LAST 300 BYTES OF THE TEXT #
SUBR TAILOF(Z) IS (
 L ARE LOCAL;
 L:=GW(GOTB,1);
 L>300 => (GW(GOTB,0)+(L-300)) ELSE GW(GOTB,0));

# ONE CHARACTER TYPED #
SUBR SEND1(C) IS (
 PUTB(TMP3,8,C); SENDALL(TMP3+8,1); CCALL usleep(30000); 0);

# A LINE TYPED, AND THE RETURN #
SUBR SENDLN(S) IS (SEND(S); SEND1(13); 0);

# ONE OR TWO CHARACTERS SENT AT ONCE (NOT TYPED), LIKE ^C #
SUBR RAWC(A,B,N) IS (
 PUTB(TMP3,12,A); PUTB(TMP3,13,B); SENDALL(TMP3+12,N); 0);

# A COMMAND LINE: TYPED, AND THE ANSWER UP TO THE NEXT PROMPT OF THE MONITOR #
SUBR CMD(LINE,KIND,TOSEC) IS (
 SENDLN(LINE);
 EXPECTX(KIND,TOSEC));

# THE CONNECTION: 1 IF IT IS MADE #
SUBR CONNECT(PORT) IS (
 A,R ARE LOCAL;
 SFD:=CCALL socket(2,1,0);
 SFD<0 => RETURN 0;
 A:=CCALL calloc(16,1);
 PUTB(A,0,2); PUTB(A,1,0); PUTB(A,2,(PORT RS 8) AND 255); PUTB(A,3,PORT AND 255);
 PUTB(A,4,127); PUTB(A,5,0); PUTB(A,6,0); PUTB(A,7,1);
 R:=(CCALL connect(SFD,A,16)) AND 4294967295;
 R NE 0 => (CCALL close(SFD); RETURN 0);
 1);

# THE LOGIN: 1 IF IT WORKED #
SUBR LOGIN(Z) IS (
 B ARE LOCAL;
 TLREAD(3000);                                            # THE BANNER #
 RAWC(3,3,2);                                           # WHATEVER A LOST SESSION LEFT RUNNING #
 TLREAD(2000);
 RAWC(13,0,1);
 EXPECT(1,20)=0 => RETURN 0;
 B:=CCALL calloc(CCALL strlen(USER)+16,1); CCALL sprintf(B,LOC('login %s'),USER);
 SENDLN(B);
 EXPECT(3,20)=0 => RETURN 0;
 CCALL strstr(GW(GOTB,0),LOC('Password:')) NE 0 => (
    SENDLN(PASS);
    EXPECT(1,60)=0 => RETURN 0);
 1);

# THE SESSION, WITH A TIMEOUT OF TO SECONDS FOR WHAT IS EXPECTED: UP TO 8 TRIES, 5 SECONDS APART (A LINE JUST HUNG UP MAY NOT BE FREE YET) #
SUBR SESSION(PORT,TMO) IS (
 K,OK ARE LOCAL;
 STO:=TMO;
 USER:=CCALL getenv(LOC('ORACLE_USER')); USER=0 => USER:=LOC('100,100');
 PASS:=CCALL getenv(LOC('ORACLE_PASS')); PASS=0 => PASS:=LOC('demo1');
 TSP:=CCALL calloc(2,8); TMP3:=CCALL calloc(32,1); PFD:=CCALL calloc(8,1); RBUF:=CCALL calloc(4100,1);
 GOTB:=BNEW(0); RD:=BNEW(0); RAWB:=BNEW(0);
 K:=0;
 WHILE K<8 DO (
    OK:=0;
    CONNECT(PORT) NE 0 => (LOGIN(0) NE 0 => OK:=1 ELSE CCALL close(SFD));
    OK NE 0 => RETURN 0;
    CCALL sleep(5);
    K:=K+1);
 DIE(LOC('could not log in to TOPS-10'),0));

# LOG OUT (^C OUT OF WHATEVER RUNS, KJOB WITH THE F OPTION), THEN HANG UP #
SUBR CLOSE(Z) IS (
 RAWC(3,3,2);
 TLREAD(1000);
 SENDLN(LOC('KJOB'));
 EXPECT(4,15) NE 0 => (SENDLN(LOC('F')); TLREAD(3000));
 CCALL close(SFD);
 0)

