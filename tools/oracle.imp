#ORACLE.IMP -- DRIVE TOPS-10 ON THE SIMH KA10 OR KI10 (ORACLE/COMMON.INI) OVER ITS TELNET PORT.  RUN BY TOOLS/IMPTOOL.SH.

    ORACLE [-P PORT] CMD...      LOG IN, RUN EACH COMMAND, PRINT WHAT THE SYSTEM SAID

A COMMAND IS SENT AS A LINE AND THE REPLY IS READ UP TO THE NEXT MONITOR PROMPT ("." AT THE START OF A LINE) UNLESS IT BEGINS WITH "!" (SEND THE TEXT RAW, NO WAIT; WHAT ARRIVES IN A SECOND IS PRINTED).
THE ACCOUNT IS 100,100 / DEMO1 (THE KA10 DISK), OR THE ENVIRONMENT'S ORACLE_USER AND ORACLE_PASS (THE KI10 DISK'S IS 1,2 / FAILSA).  THE CHARACTERS ARE TYPED SLOWLY: THE SIMULATED LINE DROPS THEM IN A BURST.
IT IS THE TRANSLATION OF THE PYTHON PROGRAM THAT WAS HERE; NUL BYTES FROM THE LINE ARE LEFT OUT, NOT KEPT.#

SFD,STO,USER,PASS,TSP,TMP3,PFD,RBUF,GOTB,RD,RAWB,WORD,NARG,PORT,AI ARE COMMON;

# THE MAIN PROGRAM #
NARG:=CCALL impargc(0);
PORT:=10603; AI:=1;
NARG>1 => (SCMP(ARG(1),LOC('-p'))=0 => (NARG<3 => DIE(LOC('usage: oracle [-p PORT] CMD...'),0); PORT:=CCALL atoi(ARG(2)); AI:=3));
SESSION(PORT,120);
WHILE AI<NARG DO (RUNONE(ARG(AI)); AI:=AI+1);
CLOSE(0);
CCALL exit(0);

SUBR RUNONE(C) IS (
 B,L ARE LOCAL;
 GETB(C,0)=33 => (
    L:=CCALL strlen(C);
    B:=CCALL calloc(L+2,1); CCALL memcpy(B,C+1,L-1); PUTB(B,L-1,13);
    RAW(B);
    TLREAD(1000); OUTS(GW(RD,0)))
 ELSE OUTS(CMD(C,1,0));
 0);

# ---- THE TERMINAL SESSION WITH TOPS-10 (THE TRANSLATION OF THE SESSION CLASS OF THE PYTHON TOOLS/ORACLE.PY): A TELNET CONNECTION TO THE DC LINE OF THE SIMULATOR ---- #

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR GW(P,I) IS [P+(8*I)];

SUBR SW(P,I,V) IS ([P+(8*I)]:=V; 0);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

# A MESSAGE ON THE STANDARD ERROR, AND THE END WITH STATUS 1 #
SUBR DIE(M,A) IS (
 CCALL write(2,M,CCALL strlen(M)); A NE 0 => (CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A)));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

# OUTPUT ON THE STANDARD OUTPUT OF THE C LIBRARY #
SUBR OUTS(P) IS (CCALL printf(LOC('%s'),P); 0);
SUBR OUTC(C) IS (CCALL putchar(C); 0);

SUBR SCMP(A,B) IS (
 R ARE LOCAL;
 R:=(CCALL strcmp(A,B)) AND 4294967295; R>2147483647 => R:=R-4294967296;
 R);

SUBR SNCMP(A,B,L) IS (
 R ARE LOCAL;
 R:=(CCALL strncmp(A,B,L)) AND 4294967295; R>2147483647 => R:=R-4294967296;
 R);

# THE MILLISECONDS OF THE MONOTONIC CLOCK #
SUBR NOWMS(Z) IS (
 CCALL clock_gettime(1,TSP);
 (GW(TSP,0)*1000)+(GW(TSP,1)/1000000));

# A BUFFER THAT GROWS: B, ITS LENGTH, ITS ROOM: A GROWTH BY L BYTES, AND THE BYTES P (L OF THEM) ADDED #
SUBR BADD(BP,P,L) IS (
 CAP,LN,B ARE LOCAL;
 B:=GW(BP,0); LN:=GW(BP,1); CAP:=GW(BP,2);
 WHILE (LN+L+2)>CAP DO CAP:=CAP*2;
 B:=CCALL realloc(B,CAP);
 CCALL memcpy(B+LN,P,L); LN:=LN+L; PUTB(B,LN,0);
 SW(BP,0,B); SW(BP,1,LN); SW(BP,2,CAP);
 0);

# A NEW BUFFER (THREE WORDS: THE BYTES, THE LENGTH, THE ROOM) #
SUBR BNEW(Z) IS (
 BP ARE LOCAL;
 BP:=CCALL calloc(3,8); SW(BP,0,CCALL calloc(4096,1)); SW(BP,1,0); SW(BP,2,4096);
 BP);

SUBR BCLR(BP) IS (SW(BP,1,0); PUTB(GW(BP,0),0,0); 0);

# WHOLE BUFFER SENT: ALL P (L BYTES) #
SUBR SENDALL(P,L) IS (
 K,R ARE LOCAL;
 K:=0;
 WHILE K<L DO (
    R:=CCALL send(SFD,P+K,L-K,16384);
    R<1 => DIE(LOC('cannot send to the oracle'),0);
    K:=K+R);
 0);

# THE TERMINAL LINE DROPS CHARACTERS SENT IN A BURST: ONE AT A TIME, 30 MS APART #
SUBR SEND(S) IS (
 K,L ARE LOCAL;
 L:=CCALL strlen(S); K:=0;
 WHILE K<L DO (SENDALL(S+K,1); CCALL usleep(30000); K:=K+1);
 0);

SUBR RAW(S) IS (SENDALL(S,CCALL strlen(S)); 0);

SUBR SEND3(A,B,C) IS (
 PUTB(TMP3,0,A); PUTB(TMP3,1,B); PUTB(TMP3,2,C); SENDALL(TMP3,3); 0);

# WHAT ARRIVES WITHIN WAITMS MILLISECONDS OF THE LAST DATA, THE TELNET NEGOTIATION ANSWERED AND TAKEN OUT, THE HIGH BIT AND THE CR (AND, HERE, NUL) LEFT OUT: IN THE BUFFER RD #
SUBR TLREAD(WAITMS) IS (
 R,NB,I,C,V,J,L,RP,REPLY,K ARE LOCAL;
 BCLR(RAWB); BCLR(RD);
 L1: PUTB(PFD,0,SFD AND 255); PUTB(PFD,1,(SFD RS 8) AND 255); PUTB(PFD,2,0); PUTB(PFD,3,0); PUTB(PFD,4,1); PUTB(PFD,5,0); PUTB(PFD,6,0); PUTB(PFD,7,0);
 R:=(CCALL poll(PFD,1,WAITMS)) AND 4294967295;
 R=0 => GO TO L2;
 R>2147483647 => GO TO L2;
 NB:=CCALL recv(SFD,RBUF,4096,0);
 NB<1 => GO TO L2;
 BADD(RAWB,RBUF,NB);
 GO TO L1;
 L2: RP:=GW(RAWB,0); L:=GW(RAWB,1); I:=0;
 WHILE I<L DO (
    C:=GETB(RP,I);
    ((C=255) AND ((I+1)<L)) => (
       V:=GETB(RP,I+1);
       (((V>250) AND (V<255)) AND ((I+2)<L)) => (
          REPLY:=0;
          V=253 => REPLY:=252;
          V=251 => REPLY:=254;
          REPLY NE 0 => SEND3(255,REPLY,GETB(RP,I+2));
          I:=I+3; GO TO L3);
       V=250 => (
          J:=I; K:=0-1;
          WHILE J<(L-1) DO (((GETB(RP,J)=255) AND (GETB(RP,J+1)=240)) => (K:=J; J:=L) ELSE J:=J+1);
          K<0 => I:=L ELSE I:=K+2;
          GO TO L3);
       I:=I+2; GO TO L3);
    C:=C AND 127;
    C NE 13 => (C NE 0 => (PUTB(TMP3,4,C); BADD(RD,TMP3+4,1)));
    I:=I+1;
    L3: 0);
 0);

# DOES THE TEXT OF THE SESSION HAVE WHAT KIND SAYS: 1 A LINE THAT STARTS WITH A POINT, 2 WITH AN ASTERISK, 3 PASSWORD: OR ALREADY OR A QUESTION MARK, 4 CONFIRM: #
SUBR MATCH(KIND) IS (
 I,C,G,L ARE LOCAL;
 G:=GW(GOTB,0); L:=GW(GOTB,1);
 KIND=3 => (
    CCALL strstr(G,LOC('Password:')) NE 0 => RETURN 1;
    CCALL strstr(G,LOC('already')) NE 0 => RETURN 1;
    CCALL strstr(G,LOC('Already')) NE 0 => RETURN 1;
    CCALL strchr(G,63) NE 0 => RETURN 1;
    RETURN 0);
 KIND=4 => (CCALL strstr(G,LOC('Confirm:')) NE 0 => RETURN 1 ELSE RETURN 0);
 C:=46; KIND=2 => C:=42;
 I:=0;
 WHILE I<L DO (
    GETB(G,I)=C => (I=0 => RETURN 1; GETB(G,I-1)=10 => RETURN 1);
    I:=I+1);
 0);

# THE TEXT OF THE SESSION UP TO WHAT KIND SAYS (IN GOTB: 1 IF IT CAME WITHIN TOSEC SECONDS (0: THE TIMEOUT OF THE SESSION), 0 IF NOT #
SUBR EXPECT(KIND,TOSEC) IS (
 E ARE LOCAL;
 BCLR(GOTB);
 E:=NOWMS(0);
 TOSEC=0 => E:=E+(STO*1000) ELSE E:=E+(TOSEC*1000);
 WHILE NOWMS(0)<E DO (
    TLREAD(300);
    GW(RD,1)>0 => BADD(GOTB,GW(RD,0),GW(RD,1));
    MATCH(KIND) NE 0 => RETURN 1);
 0);

# THE SAME, A TIMEOUT BEING THE END OF THE PROGRAM (AN UNCAUGHT TIMEOUTERROR OF THE PYTHON) AFTER THE SESSION IS CLOSED #
SUBR EXPECTX(KIND,TOSEC) IS (
 EXPECT(KIND,TOSEC)=0 => (CLOSE(0); DIE(LOC('timed out waiting for the oracle: '),TAILOF(0)));
 GW(GOTB,0));

# THE LAST 300 BYTES OF THE TEXT #
SUBR TAILOF(Z) IS (
 L ARE LOCAL;
 L:=GW(GOTB,1);
 L>300 => (GW(GOTB,0)+(L-300)) ELSE GW(GOTB,0));

# ONE CHARACTER TYPED #
SUBR SEND1(C) IS (
 PUTB(TMP3,8,C); SENDALL(TMP3+8,1); CCALL usleep(30000); 0);

# A LINE TYPED, AND THE RETURN #
SUBR SENDLN(S) IS (SEND(S); SEND1(13); 0);

# ONE OR TWO CHARACTERS SENT AT ONCE (NOT TYPED), LIKE ^C #
SUBR RAWC(A,B,N) IS (
 PUTB(TMP3,12,A); PUTB(TMP3,13,B); SENDALL(TMP3+12,N); 0);

# A COMMAND LINE: TYPED, AND THE ANSWER UP TO THE NEXT PROMPT OF THE MONITOR #
SUBR CMD(LINE,KIND,TOSEC) IS (
 SENDLN(LINE);
 EXPECTX(KIND,TOSEC));

# THE CONNECTION: 1 IF IT IS MADE #
SUBR CONNECT(PORT) IS (
 A,R ARE LOCAL;
 SFD:=CCALL socket(2,1,0);
 SFD<0 => RETURN 0;
 A:=CCALL calloc(16,1);
 PUTB(A,0,2); PUTB(A,1,0); PUTB(A,2,(PORT RS 8) AND 255); PUTB(A,3,PORT AND 255);
 PUTB(A,4,127); PUTB(A,5,0); PUTB(A,6,0); PUTB(A,7,1);
 R:=(CCALL connect(SFD,A,16)) AND 4294967295;
 R NE 0 => (CCALL close(SFD); RETURN 0);
 1);

# THE LOGIN: 1 IF IT WORKED #
SUBR LOGIN(Z) IS (
 B ARE LOCAL;
 TLREAD(3000);                                            # THE BANNER #
 RAWC(3,3,2);                                           # WHATEVER A LOST SESSION LEFT RUNNING #
 TLREAD(2000);
 RAWC(13,0,1);
 EXPECT(1,20)=0 => RETURN 0;
 B:=CCALL calloc(CCALL strlen(USER)+16,1); CCALL sprintf(B,LOC('login %s'),USER);
 SENDLN(B);
 EXPECT(3,20)=0 => RETURN 0;
 CCALL strstr(GW(GOTB,0),LOC('Password:')) NE 0 => (
    SENDLN(PASS);
    EXPECT(1,60)=0 => RETURN 0);
 1);

# THE SESSION, WITH A TIMEOUT OF TO SECONDS FOR WHAT IS EXPECTED: UP TO 8 TRIES, 5 SECONDS APART (A LINE JUST HUNG UP MAY NOT BE FREE YET) #
SUBR SESSION(PORT,TMO) IS (
 K,OK ARE LOCAL;
 STO:=TMO;
 USER:=CCALL getenv(LOC('ORACLE_USER')); USER=0 => USER:=LOC('100,100');
 PASS:=CCALL getenv(LOC('ORACLE_PASS')); PASS=0 => PASS:=LOC('demo1');
 TSP:=CCALL calloc(2,8); TMP3:=CCALL calloc(32,1); PFD:=CCALL calloc(8,1); RBUF:=CCALL calloc(4100,1);
 GOTB:=BNEW(0); RD:=BNEW(0); RAWB:=BNEW(0);
 K:=0;
 WHILE K<8 DO (
    OK:=0;
    CONNECT(PORT) NE 0 => (LOGIN(0) NE 0 => OK:=1 ELSE CCALL close(SFD));
    OK NE 0 => RETURN 0;
    CCALL sleep(5);
    K:=K+1);
 DIE(LOC('could not log in to TOPS-10'),0));

# LOG OUT (^C OUT OF WHATEVER RUNS, KJOB WITH THE F OPTION), THEN HANG UP #
SUBR CLOSE(Z) IS (
 RAWC(3,3,2);
 TLREAD(1000);
 SENDLN(LOC('KJOB'));
 EXPECT(4,15) NE 0 => (SENDLN(LOC('F')); TLREAD(3000));
 CCALL close(SFD);
 0)

%%
