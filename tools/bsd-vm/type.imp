#TYPE.IMP -- TYPES LINES ON THE VIDEO CONSOLE OF A VIRTUAL MACHINE THROUGH THE QEMU MONITOR: THE MONITOR COMMANDS (SENDKEY) ON THE STANDARD OUTPUT, ONE KEY AT A TIME, WITH THE PAUSES THE MONITOR NEEDS.
THE COMPILER BUILDS IT (TOOLS/IMPTOOL.SH ... TYPE: SEE TOOLS/BSD-VM/BSD-VM.SH).  THE TOOL RUNS ON THE HOST AND NEVER TOUCHES THE SOCKET: THE SOCKET OF THE MONITOR IS MADE BY QEMU INSIDE THE CONTAINER (ROOT'S, AND OF A LIBC, MUSL, THAT A PROGRAM BUILT HERE DOES NOT RUN WITH),
SO BSD-VM.SH PIPES THIS OUTPUT INTO  DOCKER EXEC -I CTR SOCAT - UNIX-CONNECT:/VM/MON.SOCK.

    TYPE [-N] LINE...    FOR EACH LINE: EVERY CHARACTER AS "SENDKEY KEY", THEN "SENDKEY RET".  -N: NO PAUSES (A DRY RUN: WHAT WOULD BE SENT, FOR THE EYE OR FOR A COMPARISON).

AN OPENBSD IMAGE OF THE CROSS-PLATFORM-ACTIONS PROJECT HAS NO LOGIN ON ITS SERIAL PORT AND ITS NETWORK CARD COMES UP WITHOUT A CARRIER: A ROOT LOGIN ON THE CONSOLE (THE PASSWORD RUNNER) IS THE WAY TO BRING IT UP.
EVERY COMMAND ENDS IN CR LF, AS A TERMINAL SENDS THEM; THE FIRST IS AN EMPTY ONE.  IT REPLACES TOOLS/BSD-VM/TYPE.PY.#

WORD,NA,PAUSE,I,J,C,CMD ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
CMD:=CCALL calloc(64,1);
PAUSE:=1; I:=1;
NA>1 => (CCALL strcmp(ARG(1),LOC('-n'))=0 => (PAUSE:=0; I:=2));
MON(CMD,40000);                  # (THE EMPTY COMMAND: CMD IS ZEROES) #
WHILE I<NA DO (
   J:=0;
   L0: C:=GETB(ARG(I),J);
       C=0 => GO TO L1;
       SENDKEY(C);
       J:=J+1; GO TO L0;
   L1: MON(LOC('sendkey ret'),500000);
   I:=I+1);
CCALL fflush(IMPSTDOUT(0));
CCALL exit(0);

SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

# ONE MONITOR COMMAND, SENT AT ONCE, AND THE PAUSE AFTER IT (MICROSECONDS) #
SUBR MON(S,US) IS (
 CCALL fputs(S,IMPSTDOUT(0)); CCALL fputc(13,IMPSTDOUT(0)); CCALL fputc(10,IMPSTDOUT(0));
 CCALL fflush(IMPSTDOUT(0));
 PAUSE NE 0 => CCALL usleep(US);
 0);

SUBR SENDKEY(C) IS (
 K ARE LOCAL;
 K:=KEY(C);
 CCALL snprintf(CMD,60,LOC('sendkey %s'),K);
 MON(CMD,40000));

# THE NAME OF THE KEY OF A CHARACTER, A STRING #
SUBR KEY(C) IS (
 C=126 => RETURN LOC('shift-grave_accent');
 C=33 => RETURN LOC('shift-1');
 C=64 => RETURN LOC('shift-2');
 C=35 => RETURN LOC('shift-3');
 C=36 => RETURN LOC('shift-4');
 C=37 => RETURN LOC('shift-5');
 C=94 => RETURN LOC('shift-6');
 C=38 => RETURN LOC('shift-7');
 C=42 => RETURN LOC('shift-8');
 C=40 => RETURN LOC('shift-9');
 C=41 => RETURN LOC('shift-0');
 C=95 => RETURN LOC('shift-minus');
 C=43 => RETURN LOC('shift-equal');
 C=123 => RETURN LOC('shift-bracket_left');
 C=125 => RETURN LOC('shift-bracket_right');
 C=124 => RETURN LOC('shift-backslash');
 C=58 => RETURN LOC('shift-semicolon');
 C=34 => RETURN LOC('shift-apostrophe');
 C=60 => RETURN LOC('shift-comma');
 C=62 => RETURN LOC('shift-dot');
 C=63 => RETURN LOC('shift-slash');
 C=32 => RETURN LOC('spc');
 C=45 => RETURN LOC('minus');
 C=61 => RETURN LOC('equal');
 C=91 => RETURN LOC('bracket_left');
 C=93 => RETURN LOC('bracket_right');
 C=92 => RETURN LOC('backslash');
 C=59 => RETURN LOC('semicolon');
 C=39 => RETURN LOC('apostrophe');
 C=44 => RETURN LOC('comma');
 C=46 => RETURN LOC('dot');
 C=47 => RETURN LOC('slash');
 C=96 => RETURN LOC('grave_accent');
 C=9 => RETURN LOC('tab');
 # AN UPPER CASE LETTER IS SHIFT- AND THE LETTER; ANYTHING ELSE IS ITS OWN NAME #
 CCALL memset(CMD+32,0,16);
 ((C>64) AND (C<91)) => (CCALL snprintf(CMD+32,15,LOC('shift-%c'),C+32)) ELSE CCALL snprintf(CMD+32,15,LOC('%c'),C);
 CMD+32)
%%
