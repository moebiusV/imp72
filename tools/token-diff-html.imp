#TOKEN-DIFF-HTML.IMP -- THE FOURTH FILE OF TOOLS/TOKEN-DIFF.IMP: THE HTML.  A PAGE IS PRE BLOCKS OF THE SOURCE, THE TOKENS THAT ARE NOT IN THE OTHER FILE IN DEL (OLD, RED) AND INS (NEW, GREEN), AND A LONG RUN OF TOKENS THAT ARE THE SAME FOLDED IN A DETAILS
BLOCK.  DRY NE 0 WRITES NOTHING (A FIRST PASS OVER THE SAME CALLS COUNTS, FOR THE HEAD OF THE PAGE).  THE WHITE SPACE IS THE FILE'S OWN: OF THE NEW FILE FOR A TOKEN THE FILES SHARE; CARRIAGE RETURNS ARE LEFT OUT.#

LET FTT=0, FTP=1, FTL=2, FTD=3, FLS=4, FLC=5, FLH=6;
EXTERNAL SIZE fwrite(PTR, SIZE, SIZE, PTR);
EXTERNAL INT fputc(INT, PTR);
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL SIZE strlen(PTR);
FO,DRY,CUR,FIRSTB,NBUF,CTX ARE COMMON;

SUBR OUTC(C) IS (DRY=0 => CCALL fputc(C,FO); 0);

SUBR OUTS(S) IS (DRY=0 => CCALL fwrite(S,1,CCALL strlen(S),FO); 0);

SUBR OUTN(N) IS (DRY=0 => (CCALL snprintf(NBUF,32,LOC('%lld'),N); OUTS(NBUF)); 0);

# A TEXT OF THE SOURCE, WITH & < AND > AS HTML HAS THEM #
SUBR ESC(S) IS (
 I,C ARE LOCAL;
 I:=0;
 WHILE (C:=GETB(S,I)) NE 0 DO (
    C=38 => OUTS(LOC('&amp;'))
    ELSE (C=60 => OUTS(LOC('&lt;'))
    ELSE (C=62 => OUTS(LOC('&gt;')) ELSE OUTC(C)));
    I:=I+1);
 0);

# THE WHITE SPACE BEFORE A TOKEN; AT THE START OF A BLOCK ONLY WHAT FOLLOWS ITS LAST NEWLINE (A BLOCK DOES NOT START WITH A BLANK LINE) #
SUBR EMITPRE(PRE) IS (
 I,N,L,C ARE LOCAL;
 N:=CCALL strlen(PRE); L:=0; I:=0;
 FIRSTB NE 0 => (WHILE I<N DO (GETB(PRE,I)=10 => L:=I+1; I:=I+1); FIRSTB:=0);
 I:=L;
 WHILE I<N DO (C:=GETB(PRE,I); C=13 => 0 ELSE OUTC(C); I:=I+1);
 0);

SUBR OPENSPAN(ST) IS (
 ST=1 => OUTS(LOC('<del>'));
 ST=2 => OUTS(LOC('<ins>'));
 CUR:=ST; 0);

SUBR CLOSESPAN(Z) IS (
 CUR=1 => OUTS(LOC('</del>'));
 CUR=2 => OUTS(LOC('</ins>'));
 CUR:=0; 0);

# THE TOKEN TI OF THE FILE FS, AS PART OF THE SAME (ST=0), DELETED (1) OR INSERTED (2) TOKENS #
SUBR EMITTOK(FS,TI,ST) IS (
 PRE,TX ARE LOCAL;
 PRE:=L_GET(RD(FS,FTP),TI); TX:=L_GET(RD(FS,FTT),TI);
 ST NE CUR => (CLOSESPAN(0); EMITPRE(PRE); OPENSPAN(ST)) ELSE EMITPRE(PRE);
 ESC(TX); 0);

SUBR BLOCKOPEN(Z) IS (OUTS(LOC('<pre>')); FIRSTB:=1; CUR:=0; 0);

SUBR BLOCKCLOSE(Z) IS (CLOSESPAN(0); OUTS(LOC('</pre>')); OUTC(10); 0);

# THE FIRST TOKEN OF LINE L OF THE FILE FS (OF ITS LINES WITH TOKENS), OR THE NUMBER OF TOKENS FOR THE LINE AFTER THE LAST #
SUBR TOKRANGE(FS,L) IS (
 L<L_LEN(RD(FS,FLS)) => RETURN L_GET(RD(FS,FLS),L);
 L_LEN(RD(FS,FTT)));

# THE TOKENS OF THE LINES L0 TO L1 (NOT THE LAST) #
SUBR EMITLINES(FS,L0,L1,ST) IS (
 T,E ARE LOCAL;
 T:=TOKRANGE(FS,L0); E:=TOKRANGE(FS,L1);
 WHILE T<E DO (EMITTOK(FS,T,ST); T:=T+1);
 0);

# A RUN OF LINES THAT ARE THE SAME: ALL OF THEM, OR THE FIRST AND LAST CTX LINES AND THE REST FOLDED (NOT AT THE START AND END OF THE FILE, WHERE THERE IS NO CHANGE TO GIVE CONTEXT FOR) #
SUBR EQSEG(FN,J0,J1,FIRST,LAST) IS (
 N,H,T,A,B ARE LOCAL;
 N:=J1-J0; H:=0; T:=0;
 FIRST=0 => H:=CTX;
 LAST=0 => T:=CTX;
 N LE ((H+T)+2) => (EMITLINES(FN,J0,J1,0); RETURN 0);
 EMITLINES(FN,J0,J0+H,0);
 BLOCKCLOSE(0);
 A:=L_GET(RD(FN,FTL),TOKRANGE(FN,J0+H));
 B:=L_GET(RD(FN,FTL),TOKRANGE(FN,J1-T)-1);
 OUTS(LOC('<details><summary>unchanged: lines ')); OUTN(A); OUTS(LOC(' to ')); OUTN(B);
 OUTS(LOC('</summary>')); BLOCKOPEN(0);
 EMITLINES(FN,J0+H,J1-T,0);
 BLOCKCLOSE(0); OUTS(LOC('</details>')); OUTC(10);
 BLOCKOPEN(0);
 EMITLINES(FN,J1-T,J1,0);
 0);

# THE HEAD OF A PAGE, TO THE OPENING OF ITS FIRST BLOCK: TITLE AND THE NAMES OF THE FILES #
SUBR PAGEHEAD(TITLE) IS (
 OUTS(LOC('<!doctype html>')); OUTC(10);
 OUTS(LOC('<html lang="en"><head><meta charset="utf-8">'));
 OUTS(LOC('<meta name="viewport" content="width=device-width, initial-scale=1">')); OUTC(10);
 OUTS(LOC('<title>')); ESC(TITLE); OUTS(LOC('</title><style>')); OUTC(10);
 OUTS(LOC(':root{--bg:#fff;--fg:#1f2328;--mut:#59636e;--bd:#d1d9e0;--pre:#f6f8fa;'));
 OUTS(LOC('--del:#ffc1c0;--delfg:#82071e;--ins:#aceebb;--insfg:#0f5323}')); OUTC(10);
 OUTS(LOC('@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--mut:#9198a1;--bd:#3d444d;--pre:#151b23;'));
 OUTS(LOC('--del:#6b1a1f;--delfg:#ffdcd7;--ins:#1a4727;--insfg:#d2fedb}}')); OUTC(10);
 OUTS(LOC('body{margin:0 auto;max-width:1100px;padding:16px;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,sans-serif}')); OUTC(10);
 OUTS(LOC('h1{font-size:1.35rem;margin:.2em 0}a{color:inherit}.mut{color:var(--mut)}')); OUTC(10);
 OUTS(LOC('pre{background:var(--pre);border:1px solid var(--bd);border-radius:6px;padding:10px 14px;margin:6px 0;'));
 OUTS(LOC('overflow-x:auto;font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;tab-size:4}pre:empty{display:none}')); OUTC(10);
 OUTS(LOC('del{background:var(--del);color:var(--delfg);text-decoration:none;border-radius:2px}')); OUTC(10);
 OUTS(LOC('ins{background:var(--ins);color:var(--insfg);text-decoration:none;border-radius:2px}')); OUTC(10);
 OUTS(LOC('details{margin:6px 0}summary{cursor:pointer;color:var(--mut);font-size:13px;padding:2px 0}')); OUTC(10);
 OUTS(LOC('table{border-collapse:collapse;width:100%}th,td{text-align:right;padding:4px 10px;border-bottom:1px solid var(--bd)}')); OUTC(10);
 OUTS(LOC('th:first-child,td:first-child{text-align:left}th{font-size:13px;color:var(--mut);font-weight:600}')); OUTC(10);
 OUTS(LOC('@media (max-width:600px){body{padding:10px}th,td{padding:4px 6px}}')); OUTC(10);
 OUTS(LOC('</style></head><body>')); OUTC(10);
 0);

SUBR PAGEFOOT(Z) IS (OUTS(LOC('</body></html>')); OUTC(10); 0)
%%
