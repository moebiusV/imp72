#PDP10TAP.IMP -- FILES OF 36 BIT WORDS TO SIMH .TAP TAPES FOR THE ORACLE (THE ORIGINAL COMPILER ON THE SIMULATED TOPS-10; DOCS/ORACLE.MD).  RUN BY TOOLS/IMPTOOL.SH.

    PDP10TAP PUT OUT.TAP FILE...    ONE TAPE FILE (RECORDS, THEN A TAPE MARK) PER FILE

THE WORDS OF THE ARCHIVE'S BINARIES (DECUS/*.SHR, *.LOW, *.LIB) ARE STORED 5 BYTES TO A WORD AS ASCII PACKS THEM: 7 BITS OF EACH BYTE IN BITS 35..1, BIT 0 FROM THE TOP BIT OF THE LAST BYTE.  A FILE
NAMED *.WORDS HAS THE FRAMES OF THE TAPE: 5 BYTES TO A WORD, BITS 35-28, 27-20, 19-12, 11-4, THEN BITS 3-0 IN THE LOW NIBBLE.  A TEXT FILE (.IMP .IMC .TXT .MAC .CMD) IS WHAT TOPS-10 HOLDS: CR LF LINE ENDS,
FIVE 7 BIT CHARACTERS TO A WORD (BIT 0 CLEAR), PADDED WITH NULS.  A FILE IS WRITTEN AS RECORDS OF 128 WORDS (THE DRIVE READS WHOLE BLOCKS), A RECORD BEING ITS LENGTH, THE FRAMES, THE LENGTH.  THE TAPE IS
PADDED WITH TAPE MARKS TO 8 MIB: THE SIMULATOR TAKES THE SIZE OF THE TAPE FROM THE FILE WHEN IT IS ATTACHED, SO A TAPE REWRITTEN LATER MUST HAVE BEEN THAT LONG FROM THE START.  AN EXISTING TAPE FILE IS
OVERWRITTEN FROM THE START AND NOT TRUNCATED, AS THE TAPE OF THE ORACLE MAY BE ATTACHED.  PUT WITH NO FILE IS AN EMPTY TAPE.#

BUF,N,WORD,NA,I,TAPE,TP,SIZE,FIN,WA ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL impargc(0);
NA<3 => USAGE(0);
CCALL strcmp(ARG(1),LOC('put')) NE 0 => USAGE(0);
SIZE:=8388608; I:=3;
WHILE I<NA DO (SIZE:=SIZE+(2*FSIZE(ARG(I)))+2048; I:=I+1);   # (THE ROOM FOR THE FILES) #
TP:=0;
TAPE:=CCALL calloc(SIZE,1);
I:=3;
WHILE I<NA DO (DOFILE(ARG(I)); I:=I+1);
OUTW(0);                                  # THE END OF THE TAPE: ONE MORE TAPE MARK #
FIN:=(TP>8388608 => TP ELSE 8388608);
WRITETAP(ARG(2));
CCALL exit(0);

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR ARG(I) IS (
 IMPARGET(LOC(WORD),impargvp(0),I);
 WORD);

SUBR DIE(M,A) IS (
 CCALL write(2,M,CCALL strlen(M)); CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A));
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

SUBR USAGE(Z) IS (
 CCALL write(2,LOC('usage: pdp10tap put OUT.tap FILE...'),35);
 PUTB(LOC(WORD),0,10); CCALL write(2,LOC(WORD),1); CCALL exit(1));

# THE FILE INTO BUF, N BYTES (AND ZEROS AFTER THEM) #
SUBR SLURP(PATH) IS (
 F ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); N:=CCALL ftell(F); CCALL fseek(F,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => CCALL fread(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH);
 CCALL fclose(F);
 0);

# THE TAPE, FROM THE START, WITHOUT TRUNCATING A FILE THERE IS #
SUBR WRITETAP(PATH) IS (
 F ARE LOCAL;
 CCALL access(PATH,0)=0 => F:=CCALL fopen(PATH,LOC('r+b')) ELSE F:=CCALL fopen(PATH,LOC('wb'));
 F=0 => DIE(LOC('cannot write'),PATH);
 CCALL fwrite(TAPE,1,FIN,F) NE FIN => DIE(LOC('cannot write'),PATH);
 CCALL fclose(F);
 0);

# A 32 BIT NUMBER LITTLE ENDIAN ONTO THE TAPE #
SUBR OUTW(V) IS (
 PUTB(TAPE,TP,V AND 255); PUTB(TAPE,TP+1,(V RS 8) AND 255); PUTB(TAPE,TP+2,(V RS 16) AND 255); PUTB(TAPE,TP+3,(V RS 24) AND 255);
 TP:=TP+4; 0);

# DOES THE NAME PATH END IN THE TEXT S #
SUBR ENDS(PATH,S) IS (
 L,M ARE LOCAL;
 L:=CCALL strlen(PATH); M:=CCALL strlen(S);
 L<M => RETURN 0;
 (CCALL strcmp(PATH+(L-M),S)=0 => 1 ELSE 0));

# THE WORDS OF THE FILE IN BUF: AS A TEXT, AS FRAMES, OR AS THE ARCHIVE; THE NUMBER OF WORDS, THE WORDS AT WA #
SUBR WORDS(PATH) IS (
 NW,J,K,C,X,T,L ARE LOCAL;
 ENDS(PATH,LOC('.words')) NE 0 => (
    NW:=N/5; WA:=CCALL calloc(NW+130,8); J:=0;
    WHILE J<NW DO (
       X:=GETB(BUF,5*J); X:=(X LS 8) OR GETB(BUF,(5*J)+1); X:=(X LS 8) OR GETB(BUF,(5*J)+2); X:=(X LS 8) OR GETB(BUF,(5*J)+3);
       X:=(X LS 4) OR (GETB(BUF,(5*J)+4) AND 15); [WA+(8*J)]:=X; J:=J+1);
    RETURN NW);
 ((ENDS(PATH,LOC('.imp')) NE 0) OR (ENDS(PATH,LOC('.imc')) NE 0) OR (ENDS(PATH,LOC('.txt')) NE 0) OR (ENDS(PATH,LOC('.mac')) NE 0) OR (ENDS(PATH,LOC('.cmd')) NE 0)) => (
    T:=CCALL calloc((2*N)+16,1); L:=0; J:=0;
    WHILE J<N DO (
        C:=GETB(BUF,J);
        ((C=13) AND ((J+1)<N)) => (GETB(BUF,J+1)=10 => (J:=J+1; GO TO TX));   # CR LF: THE LF MAKES IT AGAIN #
        C=10 => (PUTB(T,L,13); L:=L+1);
        PUTB(T,L,C); L:=L+1; J:=J+1;
        TX: 0);
    NW:=(L+4)/5; WA:=CCALL calloc(NW+130,8); J:=0;
    WHILE J<NW DO (
       X:=0; K:=0;
       WHILE K<5 DO (X:=(X LS 7) OR (GETB(T,(5*J)+K) AND 127); K:=K+1);
       [WA+(8*J)]:=(X LS 1); J:=J+1);
    RETURN NW);
 NW:=N/5; WA:=CCALL calloc(NW+130,8); J:=0;
 WHILE J<NW DO (
    X:=0; K:=0;
    WHILE K<5 DO (X:=(X LS 7) OR (GETB(BUF,(5*J)+K) AND 127); K:=K+1);
    [WA+(8*J)]:=((X LS 1) OR (GETB(BUF,(5*J)+4) RS 7)); J:=J+1);
 NW);

# THE SIZE OF THE FILE #
SUBR FSIZE(PATH) IS (
 F,Z ARE LOCAL;
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); Z:=CCALL ftell(F); CCALL fclose(F);
 Z);

# THE FILE AS RECORDS OF 128 WORDS, AND A TAPE MARK #
SUBR DOFILE(PATH) IS (
 NW,J,R,X ARE LOCAL;
 SLURP(PATH);
 NW:=WORDS(PATH);
 NW:=((NW+127)/128)*128;                  # (THE WORDS PAST THE FILE ARE ZERO: CALLOC) #
 R:=0;
 WHILE R<NW DO (
    OUTW(640); J:=0;
    WHILE J<128 DO (
       X:=[WA+(8*(R+J))];
       PUTB(TAPE,TP,(X RS 28) AND 255); PUTB(TAPE,TP+1,(X RS 20) AND 255); PUTB(TAPE,TP+2,(X RS 12) AND 255);
       PUTB(TAPE,TP+3,(X RS 4) AND 255); PUTB(TAPE,TP+4,X AND 15); TP:=TP+5; J:=J+1);
    OUTW(640); R:=R+128);
 OUTW(0);
 0)
%%
