#IMP-ASSIGN.IMP -- IMP72 WRITES AN ASSIGNMENT :=, WHERE THE TAPE WROTE _ (WHICH IS NOW A LETTER OF NAMES, SO THAT A NAME IS A VALID C NAME).  THIS CHANGES THE TEXT OF A PROGRAM FROM ONE TO THE OTHER.
THE COMPILER BUILDS IT (TOOLS/TAPE.SH): THE TEXT IS IMP'S TO TRANSFORM.

    IMP-ASSIGN FILE...       REWRITES EACH FILE IN PLACE: EVERY _ THAT IS CODE BECOMES :=
    IMP-ASSIGN -T FILE...    WRITES THE TAPE'S TEXT OF EACH FILE TO THE STANDARD OUTPUT (:= BACK TO _), FOR THE ORIGINAL COMPILER, WHICH ONLY HAS _; NOTHING IS CHANGED

A FILE IS READ STATEMENT BY STATEMENT.  A STATEMENT OF SYNTAX, <CLASS> ::= SYNTAX PART ::= SEMANTIC PART, HAS ITS SYNTAX PART AND ITS SEMANTIC STRINGS ("...") TREATED APART: THE SEMANTIC STRINGS ARE CODE,
WHICH THE COMPILER PARSES WITH THE GRAMMAR, SO THE _ IN THEM IS :=; IN THE SYNTAX PART A TOKEN THAT IS NOT A NAME IS QUOTED, SO THE ELEMENT IS WRITTEN ':=' (THE LEXER READS := AS ONE TOKEN).  LEFT ALONE
EVERYWHERE: COMMENTS (BETWEEN NUMBER SIGNS), TEXT CONSTANTS ('...', A QUOTE DOUBLED INSIDE), !SPECIAL IDENTIFIERS! OUTSIDE THE STRINGS, AND THE QUOTED CHARACTERS '"' AND '_' OF A SYNTAX PART.  THE -T DIRECTION IS NOT STATEMENT
AT A TIME: EVERY := THAT IS NOT IN A COMMENT, A TEXT CONSTANT OR A !NAME! BECOMES _ (A FILE OF SYNTAX IS NOT SENT TO THE ORIGINAL THIS WAY).#

BUF,N,OUT,K,TAPE,ST,DQ,WORD,NA,I ARE COMMON;

# THE MAIN PROGRAM #
NA:=CCALL IMPARGC(0);
NA<2 => (CCALL WRITE(2,LOC('usage: imp-assign [-t] FILE...'),30); PUTB(LOC(WORD),0,10); CCALL WRITE(2,LOC(WORD),1); CCALL EXIT(2));
TAPE:=0; I:=1;
CCALL STRCMP(ARG(1),LOC('-t'))=0 => (TAPE:=1; I:=2);
WHILE I<NA DO (DOFILE(ARG(I)); I:=I+1);
CCALL EXIT(0);

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

SUBR ARG(I) IS (
 CCALL IMPARGET(LOC(WORD),CCALL IMPARGVP(0),I);
 WORD);

SUBR DIE(M,A) IS (
 CCALL WRITE(2,M,CCALL STRLEN(M)); CCALL WRITE(2,LOC(': '),2); CCALL WRITE(2,A,CCALL STRLEN(A));
 PUTB(LOC(WORD),0,10); CCALL WRITE(2,LOC(WORD),1); CCALL EXIT(1));

# THE FILE INTO BUF, N BYTES (AND A ZERO AFTER THEM) #
SUBR SLURP(PATH) IS (
 F ARE LOCAL;
 F:=CCALL FOPEN(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL FSEEK(F,0,2); N:=CCALL FTELL(F); CCALL FSEEK(F,0,0);
 BUF:=CCALL CALLOC(N+16,1);
 N>0 => CCALL FREAD(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH);
 CCALL FCLOSE(F);
 0);

# THE OUTPUT: A BYTE, AND THE BYTES A TO B OF THE INPUT #
SUBR PUTO(V) IS (PUTB(OUT,K,V); K:=K+1; 0);

SUBR EMIT(A,B) IS (
 X ARE LOCAL;                  # (A IS THE CALLER'S VARIABLE: PARAMETERS ARE BY REFERENCE) #
 X:=A;
 WHILE X<B DO (PUTO(GETB(BUF,X)); X:=X+1);
 0);

# THE END (EXCLUSIVE) OF THE CONSTRUCT THAT OPENS AT I AND CLOSES WITH THE CHARACTER CL, A DOUBLED APOSTROPHE BEING INSIDE IT; N IF IT NEVER CLOSES #
SUBR COPYUNTIL(I,CL) IS (
 J ARE LOCAL;
 J:=I+1;
 L0: J<N => (
        GETB(BUF,J)=CL => (
            CL=39 => (J+1<N => (GETB(BUF,J+1)=39 => (J:=J+2; GO TO L0)));
            RETURN J+1);
        J:=J+1; GO TO L0);
 N);

SUBR ISSP(C) IS ((C=32) OR ((C>8) AND (C<14)));

SUBR ISCL(C) IS (((C>47) AND (C<58)) OR ((C>64) AND (C<91)));

# DOES A SYNTAX STATEMENT START AT I: <CLASS> OR <CLASS,X>, BLANKS, ::= #
SUBR CLASS(I) IS (
 P ARE LOCAL;
 P:=I;
 GETB(BUF,P) NE 60 => RETURN 0;
 P:=P+1;
 ISCL(GETB(BUF,P))=0 => RETURN 0;
 WHILE ISCL(GETB(BUF,P)) DO P:=P+1;
 GETB(BUF,P)=44 => (P:=P+1; ISCL(GETB(BUF,P))=0 => RETURN 0;
                    WHILE ISCL(GETB(BUF,P)) DO P:=P+1);
 GETB(BUF,P) NE 62 => RETURN 0;
 P:=P+1;
 WHILE ISSP(GETB(BUF,P)) DO P:=P+1;
 GETB(BUF,P)=58 => (GETB(BUF,P+1)=58 => (GETB(BUF,P+2)=61 => RETURN 1));
 0);

# THE TEXT OF THE FILE AS IMP72 READS IT: EVERY _ THAT IS CODE IS := #
SUBR CONVERT(Z) IS (
 I,C,J ARE LOCAL;
 I:=0; ST:=0; DQ:=0;           # ST: 0 START OF A STATEMENT, 1 CODE, 2 THE CLASS OF A SYNTAX STATEMENT, 3 ITS SYNTAX PART, 4 ITS SEMANTIC PART #
 T0: I<N => (
    C:=GETB(BUF,I);
    DQ=0 => (C=35 => (J:=COPYUNTIL(I,35); EMIT(I,J); I:=J; GO TO T0));
    ST=0 => (ISSP(C)=0 => (CLASS(I) NE 0 => ST:=2 ELSE ST:=1));
    C=39 => (
        ((GETB(BUF,I+1)=34) OR (GETB(BUF,I+1)=95)) => (GETB(BUF,I+2)=39 => (EMIT(I,I+3); I:=I+3; GO TO T0));
        J:=COPYUNTIL(I,39); EMIT(I,J); I:=J; GO TO T0);
    DQ=0 => (C=33 => (((ST=1) OR (ST=4)) => (J:=COPYUNTIL(I,33); EMIT(I,J); I:=J; GO TO T0)));
    C=58 => (((ST=2) OR (ST=3)) => (GETB(BUF,I+1)=58 => (GETB(BUF,I+2)=61 => (ST:=(ST=2 => 3 ELSE 4); EMIT(I,I+3); I:=I+3; GO TO T0))));
    ((ST=4) AND (C=34)) => (DQ:=1-DQ; PUTO(C); I:=I+1; GO TO T0);
    ((C=59) AND (DQ=0)) => ST:=0;
    C=95 => (
        ST=3 => (PUTO(39); PUTO(58); PUTO(61); PUTO(39)) ELSE (PUTO(58); PUTO(61));
        I:=I+1; GO TO T0);
    PUTO(C); I:=I+1; GO TO T0);
 0);

# THE TAPE'S TEXT: EVERY := THAT IS CODE IS _ #
SUBR TOTAPE(Z) IS (
 I,C,J ARE LOCAL;
 I:=0;
 T1: I<N => (
    C:=GETB(BUF,I);
    C=35 => (J:=COPYUNTIL(I,35); EMIT(I,J); I:=J; GO TO T1);
    C=39 => (J:=COPYUNTIL(I,39); EMIT(I,J); I:=J; GO TO T1);
    C=33 => (J:=COPYUNTIL(I,33); EMIT(I,J); I:=J; GO TO T1);
    C=58 => (GETB(BUF,I+1)=61 => (PUTO(95); I:=I+2; GO TO T1));
    PUTO(C); I:=I+1; GO TO T1);
 0);

SUBR DOFILE(PATH) IS (
 F,SAME,I ARE LOCAL;
 SLURP(PATH);
 OUT:=CCALL CALLOC(6*N+16,1); K:=0;
 TAPE NE 0 => TOTAPE(0) ELSE CONVERT(0);
 TAPE NE 0 => (CCALL FWRITE(OUT,1,K,CCALL IMPSTDOUT(0)); RETURN 0);
 SAME:=0;
 K=N => (CCALL MEMCMP(OUT,BUF,N)=0 => SAME:=1);
 SAME NE 0 => RETURN 0;
 F:=CCALL FOPEN(PATH,LOC('wb'));
 F=0 => DIE(LOC('cannot write'),PATH);
 CCALL FWRITE(OUT,1,K,F) NE K => DIE(LOC('cannot write'),PATH);
 CCALL FCLOSE(F);
 0)
%%
