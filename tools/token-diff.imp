#TOKEN-DIFF.IMP -- THE DIFFERENCES OF TWO VERSIONS OF A PROGRAM IN IMP, TOKEN BY TOKEN, AS HTML: WHAT THE ORIGINAL (THE DECUS TAPE) HAS AND THE PORT HAS NOT IS RED, WHAT THE PORT HAS ADDED IS GREEN.  THE COMPILER OF THE TREE BUILDS IT (SH TOOLS/IMPTOOL.SH TOKEN-DIFF ARGS; TOOLS/TOKEN-DIFF.SH
IS THE COMMAND FOR THE TWO TREES).
    TOKEN-DIFF [-N NOTE] OUTDIR OLD NEW [OLD NEW ...]
WRITES OUTDIR/NAME.HTML FOR EACH PAIR OF FILES (NAME IS THE NAME OF NEW, OR OF OLD WHERE NEW IS -) AND OUTDIR/INDEX.HTML; A FILE NAMED - IS NOT THERE (EVERYTHING OF THE OTHER IS THEN NEW, OR OLD).  OLD IS READ AS THE ORIGINAL'S IMP (THE UNDERSCORE IS A TOKEN OF ITS
OWN), NEW AS THE PORT'S (THE UNDERSCORE IS A LETTER); TOKENS ARE THOSE OF TOOLS/TOKEN-DIFF-LEX.IMP.  THE LINES ARE COMPARED FIRST (A LINE IS THE SEQUENCE OF ITS TOKENS, SO THE WHITE SPACE IS NOT A DIFFERENCE), AND THE TOKENS OF A RUN OF LINES THAT DIFFER ARE COMPARED
THEN (TOOLS/TOKEN-DIFF-MYERS.IMP): A TOKEN THAT MOVED TO ANOTHER LINE IS A DELETION AND AN INSERTION, AS IN ANY LINE DIFFERENCE.  THE ORIGINAL'S ASSIGNMENT _ AND THE PORT'S := ARE DIFFERENT TOKENS AND SHOW AS ONE REPLACING THE OTHER, NOTHING MORE.#

LET FTT=0, FTP=1, FTL=2, FTD=3, FLS=4, FLC=5, FLH=6;
LET RNAME=0, RHREF=1, ROLDT=2, RNEWT=3, RHUNK=4, RDEL=5, RINS=6, RKIND=7, RCOARSE=8;
EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL PTR fopen(PTR, PTR);
EXTERNAL INT fclose(PTR);
EXTERNAL INT fseek(PTR, LONG, INT);
EXTERNAL LONG ftell(PTR);
EXTERNAL SIZE fread(PTR, SIZE, SIZE, PTR);
EXTERNAL SIZE strlen(PTR);
EXTERNAL INT strcmp(PTR, PTR);
EXTERNAL PTR strrchr(PTR, INT);
EXTERNAL INT snprintf(PTR, SIZE, PTR, ...);
EXTERNAL LONG write(INT, PTR, SIZE);
EXTERNAL VOID exit(INT);
FO,CUR,FIRSTB,NBUF,CTX,TOP,OSTAT,NSTAT,DLIM,DCOARSE,FLEN,NHUNK,NDEL,NINS,OUTDIR,ROWS,NOTE ARE COMMON;
NARGS,MI,AI ARE COMMON;

NARGS:=CCALL impargc(0);
AI:=1; NOTE:=0;
NARGS>2 => (CCALL strcmp(ARG(1),LOC('-n'))=0 => (NOTE:=ARG(2); AI:=3));
(((NARGS-AI)<3) OR (((NARGS-AI) AND 1) = 0)) => DIE(LOC('usage: token-diff [-n NOTE] OUTDIR OLD NEW [OLD NEW ...]'),LOC('(a file that is not there is -)'));
NBUF:=CCALL calloc(64,1); CTX:=3; DLIM:=2500; DCOARSE:=0; TOP:=0;
TABINIT(0);
OUTDIR:=ARG(AI); ROWS:=L_NEW(0);
MI:=AI+1;
WHILE MI<NARGS DO (L_ADD(ROWS,DIFFPAIR(ARG(MI),ARG(MI+1))); MI:=MI+2);
INDEXPAGE(0);
CCALL exit(0);

# THE BYTE I OF THE MEMORY AT P, AND STORING ONE #
SUBR GETB(P,I) IS (
 Q ARE LOCAL;
 I<0 => DIE(LOC('GETB: a read before the start of a string at index '),LOC('-'));
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>);

SUBR PUTB(P,I,V) IS (
 Q ARE LOCAL;
 Q:=BYTEP [P]<7,36>; Q:=Q+I; <+Q>:=V; 0);

# THE WORD I OF THE BLOCK AT P, AND STORING ONE #
SUBR RD(P,I) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]);

SUBR WR(P,I,V) IS (
 Q ARE LOCAL;
 Q:=P+(8*I); [Q]:=V; 0);

SUBR DIE(M,A) IS (
 NL ARE LOCAL;
 CCALL write(2,M,CCALL strlen(M)); CCALL write(2,LOC(': '),2); CCALL write(2,A,CCALL strlen(A));
 NL:=CCALL calloc(16,1); PUTB(NL,0,10); CCALL write(2,NL,1); CCALL exit(1));

# A LIST OF WORDS: [COUNT, CAPACITY, ITEMS] #
SUBR L_NEW(Z) IS (
 B ARE LOCAL;
 B:=CCALL calloc(3,8); WR(B,1,8); WR(B,2,CCALL calloc(8,8)); B);

SUBR L_ADD(B,V) IS (
 N,CAP,P,NP ARE LOCAL;
 N:=RD(B,0); CAP:=RD(B,1); P:=RD(B,2);
 N=CAP => (NP:=CCALL calloc(CAP*2,8); CCALL memcpy(NP,P,CAP*8); WR(B,1,CAP*2); WR(B,2,NP); P:=NP);
 WR(P,N,V); WR(B,0,N+1); 0);

SUBR L_GET(B,I) IS (
 P ARE LOCAL;
 P:=RD(B,2); RD(P,I));

SUBR L_SET(B,I,V) IS (
 P ARE LOCAL;
 P:=RD(B,2); WR(P,I,V));

SUBR L_LEN(B) IS RD(B,0);

# THE ARGUMENT I OF THE COMMAND LINE #
SUBR ARG(I) IS (
 W ARE LOCAL;
 IMPARGET(LOC(W),impargvp(0),I); W);

# THE FILE AT PATH, FLEN BYTES AND ZEROS AFTER THEM; - IS A FILE OF NO BYTES #
SUBR READFILE(PATH) IS (
 F,N,BUF ARE LOCAL;
 CCALL strcmp(PATH,LOC('-'))=0 => (FLEN:=0; RETURN CCALL calloc(16,1));
 F:=CCALL fopen(PATH,LOC('rb'));
 F=0 => DIE(LOC('cannot read'),PATH);
 CCALL fseek(F,0,2); N:=CCALL ftell(F); CCALL fseek(F,0,0);
 BUF:=CCALL calloc(N+16,1);
 N>0 => (CCALL fread(BUF,1,N,F) NE N => DIE(LOC('cannot read'),PATH));
 CCALL fclose(F);
 FLEN:=N; BUF);

# THE TOKENS OF THE FILE AT PATH, AND ITS LINES (THOSE WITH TOKENS: THE FIRST TOKEN, THE NUMBER OF TOKENS, AND A NUMBER THAT IS THE SAME FOR THE SAME TOKENS IN THE SAME ORDER): A BLOCK OF SEVEN LISTS #
SUBR BUILDSIDE(PATH,PORT) IS (
 FS,BUF,TL,TD,LS,LC,LH,N,I,LN,PREV,Q ARE LOCAL;
 BUF:=READFILE(PATH);
 FS:=CCALL calloc(8,8);
 WR(FS,FTT,L_NEW(0)); WR(FS,FTP,L_NEW(0)); WR(FS,FTL,L_NEW(0)); WR(FS,FTD,L_NEW(0));
 WR(FS,FLS,L_NEW(0)); WR(FS,FLC,L_NEW(0)); WR(FS,FLH,L_NEW(0));
 TOKENIZE(BUF,FLEN,PORT,RD(FS,FTT),RD(FS,FTP),RD(FS,FTL),RD(FS,FTD));
 TL:=RD(FS,FTL); TD:=RD(FS,FTD); LS:=RD(FS,FLS); LC:=RD(FS,FLC); LH:=RD(FS,FLH);
 N:=L_LEN(TL); I:=0; PREV:=0;
 WHILE I<N DO (
    LN:=L_GET(TL,I);
    LN NE PREV => (L_ADD(LS,I); L_ADD(LC,1); L_ADD(LH,L_GET(TD,I)); PREV:=LN)
    ELSE (Q:=L_LEN(LS)-1; L_SET(LC,Q,L_GET(LC,Q)+1); L_SET(LH,Q,(L_GET(LH,Q)*1000003)+L_GET(TD,I)));
    I:=I+1);
 FS);

# THE LINES I0 TO I1 OF THE OLD FILE AND J0 TO J1 OF THE NEW ONE DIFFER: THEIR TOKENS ARE COMPARED, AND THE ONES THAT ARE IN ONE FILE ONLY ARE MARKED (OSTAT, NSTAT) AND COUNTED #
SUBR MARKHUNK(FO0,FN,I0,I1,J0,J1) IS (
 T0,T1,U0,U1,HA,HB,OPS,P,N,OP,TI,UJ ARE LOCAL;
 T0:=TOKRANGE(FO0,I0); T1:=TOKRANGE(FO0,I1); U0:=TOKRANGE(FN,J0); U1:=TOKRANGE(FN,J1);
 HA:=RD(RD(FO0,FTD),2)+(8*T0); HB:=RD(RD(FN,FTD),2)+(8*U0);
 OPS:=L_NEW(0);
 MYERS(HA,T1-T0,HB,U1-U0,OPS);
 NHUNK:=NHUNK+1;
 P:=0; N:=L_LEN(OPS); TI:=T0; UJ:=U0;
 WHILE P<N DO (
    OP:=L_GET(OPS,P);
    OP=0 => (TI:=TI+1; UJ:=UJ+1)
    ELSE (OP=1 => (WR(OSTAT,TI,1); TI:=TI+1; NDEL:=NDEL+1)
    ELSE (WR(NSTAT,UJ,2); UJ:=UJ+1; NINS:=NINS+1));
    P:=P+1);
 0);

# THE LINES THAT ARE THE SAME AND THE LINES THAT DIFFER, IN ORDER (OPS: THE STEPS OF THE LINE DIFFERENCE): MODE 0 MARKS THE TOKENS OF THE LINES THAT DIFFER, MODE 1 WRITES THE ROWS #
SUBR WALK(FO0,FN,OPS,MODE) IS (
 P,NO,IO,JN,OP,Q,F,ND,NI ARE LOCAL;
 P:=0; NO:=L_LEN(OPS); IO:=0; JN:=0;
 WHILE P<NO DO (
    OP:=L_GET(OPS,P);
    OP=0 => (
       Q:=P; F:=1;
       WHILE F NE 0 DO (Q<NO => (L_GET(OPS,Q)=0 => Q:=Q+1 ELSE F:=0) ELSE F:=0);
       MODE=1 => EQSEG(FO0,FN,IO,JN,Q-P,(P=0),(Q=NO));
       IO:=IO+(Q-P); JN:=JN+(Q-P); P:=Q)
    ELSE (
       Q:=P; ND:=0; NI:=0; F:=1;
       WHILE F NE 0 DO (
          Q<NO => (L_GET(OPS,Q)=0 => F:=0 ELSE (L_GET(OPS,Q)=1 => ND:=ND+1 ELSE NI:=NI+1; Q:=Q+1)) ELSE F:=0);
       MODE=0 => MARKHUNK(FO0,FN,IO,IO+ND,JN,JN+NI) ELSE HUNKROWS(FO0,FN,IO,IO+ND,JN,JN+NI);
       IO:=IO+ND; JN:=JN+NI; P:=Q));
 TABLEEND(0);
 0);

# THE NAME OF A FILE WITHOUT ITS DIRECTORY #
SUBR BASENAME(PATH) IS (
 R ARE LOCAL;
 R:=CCALL strrchr(PATH,47);
 R=0 => RETURN PATH;
 R+1);

# THE PAGE FOR THE FILES OP AND NP: A ROW FOR THE INDEX #
SUBR DIFFPAIR(OP,NP) IS (
 FO0,FN,LOPS,ROW,NAME,HREF,PATH,TITLE,KIND,J ARE LOCAL;
 CCALL strcmp(NP,LOC('-'))=0 => NAME:=BASENAME(OP) ELSE NAME:=BASENAME(NP);
 J:=0; WHILE J<L_LEN(ROWS) DO (CCALL strcmp(RD(L_GET(ROWS,J),RNAME),NAME)=0 => DIE(LOC('two pairs of files make the page of the same name'),NAME); J:=J+1);
 FO0:=BUILDSIDE(OP,0); FN:=BUILDSIDE(NP,1);
 LOPS:=L_NEW(0);
 DCOARSE:=0;
 MYERS(RD(RD(FO0,FLH),2),L_LEN(RD(FO0,FLS)),RD(RD(FN,FLH),2),L_LEN(RD(FN,FLS)),LOPS);
 OSTAT:=CCALL calloc(L_LEN(RD(FO0,FTT))+1,8); NSTAT:=CCALL calloc(L_LEN(RD(FN,FTT))+1,8);
 NHUNK:=0; NDEL:=0; NINS:=0;
 WALK(FO0,FN,LOPS,0);
 HREF:=CCALL calloc(CCALL strlen(NAME)+16,1);
 CCALL snprintf(HREF,CCALL strlen(NAME)+16,LOC('%s.html'),NAME);
 PATH:=CCALL calloc(CCALL strlen(OUTDIR)+CCALL strlen(HREF)+4,1);
 CCALL snprintf(PATH,CCALL strlen(OUTDIR)+CCALL strlen(HREF)+4,LOC('%s/%s'),OUTDIR,HREF);
 FO:=CCALL fopen(PATH,LOC('wb'));
 FO=0 => DIE(LOC('cannot write'),PATH);
 CUR:=0; TOP:=0;
 TITLE:=CCALL calloc(CCALL strlen(NAME)+64,1);
 CCALL snprintf(TITLE,CCALL strlen(NAME)+64,LOC('%s: the tape and the port, token by token'),NAME);
 PAGEHEAD(TITLE);
 OUTS(LOC('<p class="mut"><a href="index.html">all modules</a></p><h1>')); ESC(NAME); OUTS(LOC('</h1>')); OUTC(10);
 OUTS(LOC('<p class="mut">left, old (the tape): ')); ESC(OP); OUTS(LOC('<br>right, new (the port): ')); ESC(NP); OUTS(LOC('</p>')); OUTC(10);
 OUTS(LOC('<p><del>deleted</del> is in the old file only, <ins>inserted</ins> in the new one only; ')); OUTN(NHUNK);
 OUTS(LOC(' changed places, ')); OUTN(NDEL); OUTS(LOC(' tokens deleted, ')); OUTN(NINS); OUTS(LOC(' inserted.</p>')); OUTC(10);
 DCOARSE NE 0 => (OUTS(LOC('<p class="mut">Parts of this file differ so much that the token comparison there is not guaranteed to be the shortest (it is cut where the two files have gone furthest together).</p>')); OUTC(10));
 WALK(FO0,FN,LOPS,1);
 PAGEFOOT(0);
 CCALL fclose(FO);
 ROW:=CCALL calloc(10,8);
 WR(ROW,RNAME,NAME); WR(ROW,RHREF,HREF); WR(ROW,ROLDT,L_LEN(RD(FO0,FTT))); WR(ROW,RNEWT,L_LEN(RD(FN,FTT)));
 WR(ROW,RHUNK,NHUNK); WR(ROW,RDEL,NDEL); WR(ROW,RINS,NINS); WR(ROW,RCOARSE,DCOARSE);
 CCALL strcmp(NP,LOC('-'))=0 => KIND:=1 ELSE (CCALL strcmp(OP,LOC('-'))=0 => KIND:=2 ELSE KIND:=0);
 WR(ROW,RKIND,KIND);
 ROW);

# INDEX.HTML: A ROW FOR EACH PAIR #
SUBR INDEXPAGE(Z) IS (
 PATH,N,I,R,TD,TI,TH,TN ARE LOCAL;
 PATH:=CCALL calloc(CCALL strlen(OUTDIR)+16,1);
 CCALL snprintf(PATH,CCALL strlen(OUTDIR)+16,LOC('%s/index.html'),OUTDIR);
 FO:=CCALL fopen(PATH,LOC('wb'));
 FO=0 => DIE(LOC('cannot write'),PATH);
 CUR:=0; TOP:=0;
 PAGEHEAD(LOC('IMP: the tape and the port, token by token'));
 OUTS(LOC('<h1>IMP: the tape and the port, token by token</h1>')); OUTC(10);
 OUTS(LOC('<p><del>Red</del> is what the original (the DECUS tape) has and the port has not, <ins>green</ins> what the port has added.')); OUTC(10);
 OUTS(LOC('Where the original has the assignment as an underscore the port has :=, and that shows as one replacing the other.</p>')); OUTC(10);
 NOTE NE 0 => (OUTS(LOC('<p class="mut">')); ESC(NOTE); OUTS(LOC('</p>')); OUTC(10));
 OUTS(LOC('<table class="idx"><tr><th>module</th><th>tokens, old</th><th>tokens, new</th><th>changed places</th><th>deleted</th><th>inserted</th></tr>')); OUTC(10);
 N:=L_LEN(ROWS); I:=0; TD:=0; TI:=0; TH:=0; TN:=0;
 WHILE I<N DO (
    R:=L_GET(ROWS,I);
    OUTS(LOC('<tr><td><a href="')); ESC(RD(R,RHREF)); OUTS(LOC('">')); ESC(RD(R,RNAME)); OUTS(LOC('</a>'));
    RD(R,RKIND)=1 => OUTS(LOC(' <span class="mut">(old only)</span>'));
    RD(R,RKIND)=2 => OUTS(LOC(' <span class="mut">(new only)</span>'));
    RD(R,RCOARSE) NE 0 => OUTS(LOC(' <span class="mut">(not minimal in part)</span>'));
    OUTS(LOC('</td><td>')); OUTN(RD(R,ROLDT)); OUTS(LOC('</td><td>')); OUTN(RD(R,RNEWT));
    OUTS(LOC('</td><td>')); OUTN(RD(R,RHUNK));
    OUTS(LOC('</td><td><del>')); OUTN(RD(R,RDEL)); OUTS(LOC('</del></td><td><ins>')); OUTN(RD(R,RINS)); OUTS(LOC('</ins></td></tr>')); OUTC(10);
    TH:=TH+RD(R,RHUNK); TD:=TD+RD(R,RDEL); TI:=TI+RD(R,RINS);
    I:=I+1);
 OUTS(LOC('<tr><td><b>all</b></td><td></td><td></td><td>')); OUTN(TH); OUTS(LOC('</td><td><del>')); OUTN(TD);
 OUTS(LOC('</del></td><td><ins>')); OUTN(TI); OUTS(LOC('</ins></td></tr></table>')); OUTC(10);
 PAGEFOOT(0);
 CCALL fclose(FO);
 0)
%%
