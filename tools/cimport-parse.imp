#CIMPORT-PARSE.IMP -- THE THIRD FILE OF TOOLS/CIMPORT.IMP: THE DECLARATIONS OF THE TOKENS.  A TYPE IS A NUMBER: 1 TO 15 THE TYPES OF IMP72 (T_CHAR ... T_VOID, THE WORDS OF TYN), T_SBASE+N THE STRUCTURE N, T_BBASE+N A TYPE THAT IMP72 CANNOT
EXPRESS, WHOSE REASON IS ITEM N OF BADL.  A DECLARATION IS THE TOKENS UP TO ITS SEMICOLON (OR UP TO THE BODY OF A FUNCTION, WHICH IS SKIPPED); SPEC READS ITS SPECIFIERS (THE TYPE) AND DECLR ONE DECLARATOR (NAME, STARS, PARAMETERS, ARRAY).  A DECLARATOR IS
NEVER PARSED WITHIN ITSELF: THE ONLY NESTING THAT MATTERS, A POINTER TO A FUNCTION, IS A POINTER, AND ITS PARAMETERS ARE SKIPPED.  RESULTS ARE LEFT IN THE COMMON VARIABLES (SP_TYPE, DNAME, ...).#

LET CH_LF=10, CH_SP=32, CH_QUOTE=34, CH_APOS=39, CH_LP=40, CH_RP=41, CH_STAR=42, CH_COMMA=44, CH_SLASH=47, CH_SEMI=59, CH_EQ=61, CH_LB=91, CH_RB=93, CH_LC=123, CH_RC=125;
LET T_CHAR=1, T_UCHAR=2, T_SHORT=3, T_USHORT=4, T_INT=5, T_UINT=6, T_LONG=7, T_ULONG=8, T_LLONG=9, T_ULLONG=10, T_SIZE=11, T_PTR=12, T_DOUBLE=13, T_FLOAT=14, T_VOID=15, T_SBASE=100, T_BBASE=100000;
TK,NT,TKP,EMPTYS,TDN,TDT,STNAME,STTAG,STSTATE,STBODY,STWHY,STDEPS,STNEED,STEMIT,ALN,ALI,BADL,FNN,FNT,FNW,CNN,CNV,CNK,CNW ARE COMMON;
SELN,SELP,MACD,INCD,HDR,OUTP,INP,NSEL,TYN,RW,OUT,MACV,MACW,INLEN,DEFORD ARE COMMON;
SP_TYPE,SP_END,SP_TD,DNAME,DKIND,DSTARS,DGRP,DPS,DPE,DARRN,DBIT,DEND,DOK,EV_OK,EV_VAL,INBODY,CURB,CURDEPS,CURBAD,CURFIRST,ASKIP,AEND,NUMOK,NUMV,TDIR,TFC,TFX ARE COMMON;
NA,ARGW,TEXT ARE COMMON;

# THE TABLES, EMPTY, AND THE NAMES OF THE TYPES #
SUBR INIT_TYPES(Z) IS (
 TYN:=L_NEW(0);
 L_ADD(TYN,S_E(0)); L_ADD(TYN,S_DUP(LOC('CHAR'))); L_ADD(TYN,S_DUP(LOC('UCHAR'))); L_ADD(TYN,S_DUP(LOC('SHORT'))); L_ADD(TYN,S_DUP(LOC('USHORT')));
 L_ADD(TYN,S_DUP(LOC('INT'))); L_ADD(TYN,S_DUP(LOC('UINT'))); L_ADD(TYN,S_DUP(LOC('LONG'))); L_ADD(TYN,S_DUP(LOC('ULONG')));
 L_ADD(TYN,S_DUP(LOC('LLONG'))); L_ADD(TYN,S_DUP(LOC('ULLONG'))); L_ADD(TYN,S_DUP(LOC('SIZE'))); L_ADD(TYN,S_DUP(LOC('PTR')));
 L_ADD(TYN,S_DUP(LOC('DOUBLE'))); L_ADD(TYN,S_DUP(LOC('FLOAT'))); L_ADD(TYN,S_DUP(LOC('VOID')));
 TDN:=L_NEW(0); TDT:=L_NEW(0);
 STNAME:=L_NEW(0); STTAG:=L_NEW(0); STSTATE:=L_NEW(0); STBODY:=L_NEW(0); STWHY:=L_NEW(0); STDEPS:=L_NEW(0); STNEED:=L_NEW(0); STEMIT:=L_NEW(0);
 ALN:=L_NEW(0); ALI:=L_NEW(0); BADL:=L_NEW(0);
 FNN:=L_NEW(0); FNT:=L_NEW(0); FNW:=L_NEW(0);
 CNN:=L_NEW(0); CNV:=L_NEW(0); CNK:=L_NEW(0); CNW:=L_NEW(0);
 INBODY:=0; DEFORD:=L_NEW(0); PENDI:=L_NEW(0); PENDS:=L_NEW(0); PENDE:=L_NEW(0); 0);

# A TYPE THAT IMP72 CANNOT EXPRESS, WITH ITS REASON (THE TEXT S); THE TYPE #
SUBR BADREASON(S) IS (
 N ARE LOCAL;
 N:=L_ADD(BADL,S_DUP(S)); T_BBASE+N);

# THE KIND OF A BASE WORD OF A TYPE: 1 VOID 2 CHAR 3 SHORT 4 INT 5 LONG 6 FLOAT 7 DOUBLE 8 SIGNED 9 UNSIGNED 10 BOOL 11 COMPLEX 12 128-BIT INTEGER, ELSE 0 #
SUBR BASEWORD(S) IS (
 C ARE LOCAL;
 C:=GETB(S,0);
 C=118 => (S_EQ(S,LOC('void')) => RETURN 1; RETURN 0);
 C=99 => (S_EQ(S,LOC('char')) => RETURN 2; RETURN 0);
 C=115 => (S_EQ(S,LOC('short')) => RETURN 3; S_EQ(S,LOC('signed')) => RETURN 8; RETURN 0);
 C=105 => (S_EQ(S,LOC('int')) => RETURN 4; RETURN 0);
 C=108 => (S_EQ(S,LOC('long')) => RETURN 5; RETURN 0);
 C=102 => (S_EQ(S,LOC('float')) => RETURN 6; RETURN 0);
 C=100 => (S_EQ(S,LOC('double')) => RETURN 7; RETURN 0);
 C=117 => (S_EQ(S,LOC('unsigned')) => RETURN 9; RETURN 0);
 C=95 => (
    S_EQ(S,LOC('_Bool')) => RETURN 10;
    S_EQ(S,LOC('_Complex')) => RETURN 11;
    S_EQ(S,LOC('__complex__')) => RETURN 11;
    S_EQ(S,LOC('__int128')) => RETURN 12;
    S_EQ(S,LOC('__int128_t')) => RETURN 12;
    S_EQ(S,LOC('__uint128_t')) => RETURN 12;
    RETURN 0);
 0);

# THE INDEX OF THE STRUCTURE WITH THE TAG S, MADE (INCOMPLETE) IF THERE IS NONE; THE INDEX OF A NEW ONE IF S IS EMPTY #
SUBR STRUCT_REF(S) IS (
 I,N ARE LOCAL;
 N:=L_LEN(STTAG); I:=0;
 GETB(S,0) NE 0 => (
    WHILE I<N DO (S_EQ(L_GET(STTAG,I),S) => RETURN I; I:=I+1));
 L_ADD(STTAG,S_DUP(S));
 GETB(S,0) NE 0 => L_ADD(STNAME,S_DUP(S)) ELSE L_ADD(STNAME,0);
 L_ADD(STSTATE,0); L_ADD(STBODY,0); L_ADD(STWHY,0); L_ADD(STDEPS,L_NEW(0)); L_ADD(STNEED,0); L_ADD(STEMIT,0);
 N);

# THE FIRST REASON OF A STRUCTURE'S BODY THAT IT CANNOT BE EXPRESSED #
SUBR BADSET(S) IS (
 CURBAD=0 => CURBAD:=S_DUP(S);
 0);

SUBR BADOF(T) IS (L_GET(BADL,T-T_BBASE));

# A FIELD OF THE STRUCTURE UNDER DEFINITION: THE TOKENS A TO F (A DECLARATION WITHOUT ITS SEMICOLON) #
SUBR FIELD_DECL(A,F) IS (
 TY,P,T,X,N,W ARE LOCAL;
 A GE F => RETURN 0;
 SPEC(A,F); TY:=SP_TYPE; P:=SP_END;
 TY=0 => (BADSET(LOC('a member whose type is not understood')); RETURN 0);
 TY GE T_BBASE => (BADSET(BADOF(TY)); RETURN 0);
 P GE F => (BADSET(LOC('an anonymous member')); RETURN 0);
 FDL: DECLR(P,F,2);
 DOK=0 => (BADSET(LOC('a member declaration that is not understood')); RETURN 0);
 DBIT NE 0 => (BADSET(LOC('a bit field')); RETURN 0);
 DNAME=0 => (BADSET(LOC('an unnamed member')); RETURN 0);
 S_EQ(DNAME,LOC('_')) => (BADSET(LOC('a member named _, which IMP72 reads as an operator')); RETURN 0);
 ((DKIND=1) AND (DGRP=0)) => (BADSET(LOC('a member that is a function')); RETURN 0);
 ((DSTARS>0) OR (DGRP NE 0)) => T:=T_PTR ELSE T:=TY;
 T=T_VOID => (BADSET(LOC('a member of type void')); RETURN 0);
 ((T GE T_SBASE) AND (T<T_BBASE)) => (
    X:=T-T_SBASE;
    L_GET(STSTATE,X) NE 1 => (BADSET(LOC('a member whose structure is incomplete or cannot be expressed')); RETURN 0);
    L_GET(STNAME,X)=0 => (BADSET(LOC('a member of an unnamed structure type')); RETURN 0);
    L_ADD(CURDEPS,X);
    W:=QN(L_GET(STNAME,X)))
 ELSE W:=L_GET(TYN,T);
 N:=0;
 ((DKIND=2) AND (DGRP=0)) => (
    DARRN<0 => (DARRN=0-1 => BADSET(LOC('a flexible array member')) ELSE BADSET(LOC('an array whose length is not a number, a sum or a product of numbers')); RETURN 0);
    N:=DARRN);
 CURFIRST=0 => B_STR(CURB,LOC(', '));
 CURFIRST:=0;
 B_STR(CURB,W); B_CH(CURB,32); B_STR(CURB,QN(DNAME));
 N>0 => (B_CH(CURB,91); B_NUM(CURB,N); B_CH(CURB,93));
 P:=DEND;
 TCH(P)=44 => (P:=P+1; GO TO FDL);
 0);

# THE STRUCTURE WITH THE TAG TAG AND A BODY IN THE TOKENS BS TO BE (EXCLUSIVE): ITS INDEX, AND THE BODY IS PARSED LATER (RUN_PEND), BECAUSE ITS MEMBERS' SPECIFIERS ARE READ BY THE ROUTINE THAT READ THE STRUCTURE'S #
SUBR STRUCT_DEF(TAG,BS,BE) IS (
 IDX ARE LOCAL;
 IDX:=STRUCT_REF(TAG);
 L_GET(STSTATE,IDX) NE 0 => RETURN IDX;
 L_FIND_I(PENDI,IDX) GE 0 => RETURN IDX;
 L_ADD(PENDI,IDX); L_ADD(PENDS,BS); L_ADD(PENDE,BE); IDX);

SUBR L_FIND_I(L,V) IS (
 I,N ARE LOCAL;
 N:=RD(L,0); I:=0;
 WHILE I<N DO (L_GET(L,I)=V => RETURN I; I:=I+1);
 0-1);

# THE BODIES OF THE STRUCTURES THAT THE LAST SPECIFIERS DEFINED #
SUBR RUN_PEND(Z) IS (
 K,N,IDX,J,F,D,BS,BE ARE LOCAL;
 K:=0;
 RPL: K<L_LEN(PENDI) => (
    IDX:=L_GET(PENDI,K); BS:=L_GET(PENDS,K); BE:=L_GET(PENDE,K); K:=K+1;
    CURB:=B_NEW(0); CURDEPS:=L_NEW(0); CURBAD:=0; CURFIRST:=1; INBODY:=1;
    PACKFLAG NE 0 => BADSET(LOC('a packed or aligned attribute'));
    J:=BS;
    SDL: J<BE => (
       F:=J;
       SDS: F<BE => (
          TCH(F)=59 => GO TO SDE;
          D:=TCH(F);
          ((D=40) OR (D=91) OR (D=123)) => F:=MATCH(F)+1 ELSE F:=F+1;
          GO TO SDS);
       SDE: FIELD_DECL(J,F);
       J:=F+1; GO TO SDL);
    INBODY:=0;
    ((CURFIRST NE 0) AND (CURBAD=0)) => BADSET(LOC('a structure without members'));
    L_ADD(DEFORD,IDX);
    CURBAD NE 0 => (L_SET(STSTATE,IDX,2); L_SET(STWHY,IDX,CURBAD))
     ELSE (L_SET(STSTATE,IDX,1); L_SET(STBODY,IDX,B_GET(CURB)); L_SET(STDEPS,IDX,CURDEPS));
    GO TO RPL);
 PENDI:=L_NEW(0); PENDS:=L_NEW(0); PENDE:=L_NEW(0); 0);

# DOES THE TEXT S, A WORD OF AN ENUMERATOR'S VALUE, NAME A NUMBER: ITS VALUE IN NUMV AND NUMOK=1 #
SUBR NUMVAL(S) IS (
 I,N,C,B,D,V,C1 ARE LOCAL;
 NUMOK:=0; NUMV:=0;
 N:=CCALL strlen(S); I:=0; B:=10; V:=0;
 C:=GETB(S,0);
 ((C>47) AND (C<58)) => 0 ELSE RETURN 0;
 C=48 => (
    C1:=GETB(S,1);
    ((C1=120) OR (C1=88)) => (B:=16; I:=2)
     ELSE (((C1=98) OR (C1=66)) => (B:=2; I:=2) ELSE (N>1 => (B:=8; I:=1))));
 NVL: I<N => (
    C:=GETB(S,I);
    ((C>47) AND (C<58)) => D:=C-48
     ELSE (((C>96) AND (C<103)) => D:=(C-97)+10 ELSE (((C>64) AND (C<71)) => D:=(C-65)+10 ELSE D:=99));
    D<B => (V:=(V*B)+D; I:=I+1; GO TO NVL);
    # THE REST MUST BE THE SUFFIX U, L #
    NVS: I<N => (
       C:=GETB(S,I);
       ((C=117) OR (C=85) OR (C=108) OR (C=76)) => (I:=I+1; GO TO NVS);
       RETURN 0));
 NUMOK:=1; NUMV:=V; 1);

# THE VALUE OF THE TOKEN I WHEN IT IS A NUMBER OR AN ENUMERATOR WITH A VALUE: EV_OK, EV_VAL #
SUBR ATOMVAL(I) IS (
 K ARE LOCAL;
 EV_OK:=0; EV_VAL:=0;
 TNUM(I) NE 0 => (NUMVAL(TOK(I)); NUMOK=0 => RETURN 0; EV_OK:=1; EV_VAL:=NUMV; RETURN 1);
 TID(I)=0 => RETURN 0;
 K:=L_FIND(CNN,TOK(I));
 K<0 => RETURN 0;
 L_GET(CNK,K)=0 => RETURN 0;
 EV_OK:=1; EV_VAL:=L_GET(CNV,K); 1);

# THE PRECEDENCE OF AN OPERATOR: 1 TO 4 ARE THE UNARY - + ~ !, 5 IS THE PARENTHESIS, THE BINARY ARE THEIR CHARACTERS (76 IS <<, 82 IS >>) #
SUBR PREC(O) IS (
 O<5 => RETURN 100;
 O=5 => RETURN 0;
 ((O=42) OR (O=47) OR (O=37)) => RETURN 10;
 ((O=43) OR (O=45)) => RETURN 9;
 ((O=76) OR (O=82)) => RETURN 8;
 O=38 => RETURN 5;
 O=94 => RETURN 4;
 O=124 => RETURN 3;
 0);

# APPLY THE OPERATOR O TO THE TOP OF THE STACK OF VALUES VST; 0 IF IT CANNOT BE #
SUBR APPLYOP(O) IS (
 N,A,B,R ARE LOCAL;
 N:=RD(VST,0);
 O<5 => (
    N<1 => RETURN 0;
    A:=L_GET(VST,N-1);
    O=1 => R:=0-A;
    O=2 => R:=A;
    O=3 => R:=A XOR (0-1);
    O=4 => (A=0 => R:=1 ELSE R:=0);
    L_SET(VST,N-1,R); RETURN 1);
 N<2 => RETURN 0;
 B:=L_GET(VST,N-1); A:=L_GET(VST,N-2); WR(VST,0,N-1);
 O=42 => R:=A*B;
 O=43 => R:=A+B;
 O=45 => R:=A-B;
 O=47 => (B=0 => RETURN 0; R:=A/B);
 O=37 => (B=0 => RETURN 0; R:=A-((A/B)*B));
 O=38 => R:=A AND B;
 O=94 => R:=A XOR B;
 O=124 => R:=A OR B;
 ((O=76) OR (O=82)) => (
    ((B<0) OR (B>62)) => RETURN 0;
    R:=A;
    WHILE B>0 DO (O=76 => R:=R+R ELSE R:=R/2; B:=B-1));
 L_SET(VST,N-2,R); 1);

# EVAL WITHOUT THE CLEARING OF THE RESULT ON FAILURE.  THE VALUE OF THE EXPRESSION OF THE TOKENS A TO B (EXCLUSIVE): NUMBERS AND ENUMERATORS WITH PARENTHESES, UNARY - + ~ ! AND THE BINARY * / % + - << >> & ^ | WITH THEIR PRECEDENCE; EV_OK AND EV_VAL #
SUBR EVAL0(A,B) IS (
 K,Y,D,EXPECT,O,T,N,C2,P ARE LOCAL;
 EV_OK:=0; EV_VAL:=0;
 VST:=L_NEW(0); OST:=L_NEW(0);
 K:=A; Y:=B; EXPECT:=1;
 EVL: K<Y => (
    D:=TCH(K);
    EXPECT NE 0 => (
       D=40 => (L_ADD(OST,5); K:=K+1; GO TO EVL);
       D=45 => (L_ADD(OST,1); K:=K+1; GO TO EVL);
       D=43 => (L_ADD(OST,2); K:=K+1; GO TO EVL);
       D=126 => (L_ADD(OST,3); K:=K+1; GO TO EVL);
       D=33 => (L_ADD(OST,4); K:=K+1; GO TO EVL);
       ATOMVAL(K)=0 => RETURN 0;
       L_ADD(VST,EV_VAL); EXPECT:=0; K:=K+1; GO TO EVL);
    D=41 => (
       EVC: N:=RD(OST,0);
       N=0 => RETURN 0;
       O:=L_GET(OST,N-1); WR(OST,0,N-1);
       O=5 => (K:=K+1; GO TO EVL);
       APPLYOP(O)=0 => RETURN 0;
       GO TO EVC);
    C2:=0;
    ((D=42) OR (D=47) OR (D=37) OR (D=43) OR (D=45) OR (D=38) OR (D=94) OR (D=124)) => (C2:=D; P:=K+1);
    ((D=60) AND (TCH(K+1)=60)) => (C2:=76; P:=K+2);
    ((D=62) AND (TCH(K+1)=62)) => (C2:=82; P:=K+2);
    C2=0 => RETURN 0;
    EVP: N:=RD(OST,0);
    N>0 => (
       O:=L_GET(OST,N-1);
       PREC(O) GE PREC(C2) => (WR(OST,0,N-1); APPLYOP(O)=0 => RETURN 0; GO TO EVP));
    L_ADD(OST,C2); EXPECT:=1; K:=P; GO TO EVL);
 EXPECT NE 0 => RETURN 0;
 EVF: N:=RD(OST,0);
 N>0 => (
    O:=L_GET(OST,N-1); WR(OST,0,N-1);
    O=5 => RETURN 0;
    APPLYOP(O)=0 => RETURN 0;
    GO TO EVF);
 RD(VST,0) NE 1 => RETURN 0;
 EV_OK:=1; EV_VAL:=L_GET(VST,0); 1);

# THE VALUE OF THE EXPRESSION OF THE TOKENS A TO B (EXCLUSIVE): EV_OK=1 AND EV_VAL, OR EV_OK=0 #
SUBR EVAL(A,B) IS (
 R ARE LOCAL;
 R:=EVAL0(A,B); EV_OK:=R;
 R=0 => EV_VAL:=0;
 R);

# AN ENUMERATOR NAME WITH ITS VALUE (KNOWN NE 0) OR WITHOUT #
SUBR ADDCONST(S,V,KNOWN,WHY) IS (
 L_FIND(CNN,S) GE 0 => RETURN 0;
 L_ADD(CNN,S_DUP(S)); L_ADD(CNV,V); L_ADD(CNK,KNOWN); L_ADD(CNW,WHY); 0);

# THE ENUMERATORS OF THE BODY IN THE TOKENS BS TO BE (EXCLUSIVE) #
SUBR ENUM_DEF(BS,BE) IS (
 J,NM,F,NEXTV,KNOWN ARE LOCAL;
 J:=BS; NEXTV:=0; KNOWN:=1;
 EL: J<BE => (
    TID(J)=0 => (J:=J+1; GO TO EL);
    NM:=TOK(J); J:=J+1;
    TCH(J)=61 => (
       F:=J+1;
       EFL: ((F<BE) AND (TCH(F) NE 44)) => (((TCH(F)=40) OR (TCH(F)=91)) => F:=MATCH(F)+1 ELSE F:=F+1; GO TO EFL);
       EVAL(J+1,F);
       EV_OK NE 0 => (NEXTV:=EV_VAL; KNOWN:=1) ELSE KNOWN:=0;
       J:=F);
    KNOWN NE 0 => ADDCONST(NM,NEXTV,1,0) ELSE ADDCONST(NM,0,0,LOC('its value is not a simple number'));
    NEXTV:=NEXTV+1;
    TCH(J)=44 => J:=J+1;
    GO TO EL);
 0);

# THE SPECIFIERS OF A DECLARATION AT THE TOKENS P TO E (EXCLUSIVE): THE TYPE IN SP_TYPE (0 IF THERE IS NONE), SP_TD NE 0 IF TYPEDEF IS ONE OF THEM, SP_END THE FIRST TOKEN THAT IS NOT A SPECIFIER #
SUBR SPEC(P,E) IS (
 I,NM,TY,WORDS,SH,CH,IN,LO,FL,DB,SG,UN,BO,CX,WIDE,K,J,BE,TAG,X,ISU ARE LOCAL;
 I:=P; TY:=0; WORDS:=0; SH:=0; CH:=0; IN:=0; LO:=0; FL:=0; DB:=0; SG:=0; UN:=0; BO:=0; CX:=0; WIDE:=0; SP_TD:=0;
 SL: I<E => (
    TID(I)=0 => GO TO SDONE;
    NM:=TOK(I);
    S_EQ(NM,LOC('typedef')) => (SP_TD:=1; I:=I+1; GO TO SL);
    K:=BASEWORD(NM);
    K NE 0 => (
       K=1 => TY:=T_VOID;
       K=2 => CH:=1;
       K=3 => SH:=1;
       K=4 => IN:=1;
       K=5 => LO:=LO+1;
       K=6 => FL:=1;
       K=7 => DB:=1;
       K=8 => SG:=1;
       K=9 => UN:=1;
       K=10 => BO:=1;
       K=11 => CX:=1;
       K=12 => WIDE:=1;
       WORDS:=WORDS+1; I:=I+1; GO TO SL);
    ((S_EQ(NM,LOC('struct'))) OR (S_EQ(NM,LOC('union')))) => (
       ISU:=S_EQ(NM,LOC('union'));
       TAG:=EMPTYS; J:=I+1;
       TID(J) NE 0 => (TAG:=TOK(J); J:=J+1);
       TCH(J)=123 => (
          BE:=MATCH(J);
          ISU NE 0 => TY:=BADREASON(LOC('a union'))
           ELSE (INBODY NE 0 => TY:=BADREASON(LOC('a structure defined inside a structure'))
                  ELSE TY:=T_SBASE+STRUCT_DEF(TAG,J+1,BE));
          I:=BE+1)
        ELSE (ISU NE 0 => TY:=BADREASON(LOC('a union')) ELSE TY:=T_SBASE+STRUCT_REF(TAG); I:=J);
       WORDS:=WORDS+1; GO TO SL);
    S_EQ(NM,LOC('enum')) => (
       J:=I+1;
       TID(J) NE 0 => J:=J+1;
       TCH(J)=123 => (BE:=MATCH(J); ENUM_DEF(J+1,BE); I:=BE+1) ELSE I:=J;
       TY:=T_INT; WORDS:=WORDS+1; GO TO SL);
    WORDS=0 => (
       X:=L_FIND(TDN,NM);
       X GE 0 => (TY:=L_GET(TDT,X); WORDS:=1; I:=I+1; GO TO SL);
       S_EQ(NM,LOC('__builtin_va_list')) => (TY:=BADREASON(LOC('a va_list')); WORDS:=1; I:=I+1; GO TO SL);
       S_PRE(NM,LOC('_Float')) => (TY:=BADREASON(LOC('an extended floating type')); WORDS:=1; I:=I+1; GO TO SL);
       S_PRE(NM,LOC('__bf16')) => (TY:=BADREASON(LOC('an extended floating type')); WORDS:=1; I:=I+1; GO TO SL);
       ((TID(I+1) NE 0) OR (TCH(I+1)=42)) => (
          TY:=BADREASON(S_CAT(LOC('the unknown type name '),NM)); WORDS:=1; I:=I+1; GO TO SL));
    GO TO SDONE);
 SDONE: TY NE 0 => GO TO SFIN;
 CX NE 0 => (TY:=BADREASON(LOC('a complex type')); GO TO SFIN);
 WIDE NE 0 => (TY:=BADREASON(LOC('a 128-bit integer')); GO TO SFIN);
 DB NE 0 => (LO>0 => TY:=BADREASON(LOC('long double')) ELSE TY:=T_DOUBLE; GO TO SFIN);
 FL NE 0 => (TY:=T_FLOAT; GO TO SFIN);
 BO NE 0 => (TY:=T_UCHAR; GO TO SFIN);
 CH NE 0 => (UN NE 0 => TY:=T_UCHAR ELSE TY:=T_CHAR; GO TO SFIN);
 SH NE 0 => (UN NE 0 => TY:=T_USHORT ELSE TY:=T_SHORT; GO TO SFIN);
 LO=1 => (UN NE 0 => TY:=T_ULONG ELSE TY:=T_LONG; GO TO SFIN);
 LO>1 => (UN NE 0 => TY:=T_ULLONG ELSE TY:=T_LLONG; GO TO SFIN);
 ((IN NE 0) OR (SG NE 0) OR (UN NE 0)) => (UN NE 0 => TY:=T_UINT ELSE TY:=T_INT);
 SFIN: SP_TYPE:=TY; SP_END:=I; TY);

# ONE DECLARATOR AT THE TOKENS P TO E (EXCLUSIVE); CTX 0 A DECLARATION, 1 A PARAMETER, 2 A MEMBER.  DNAME THE NAME (0 IF THERE IS NONE), DSTARS THE STARS BEFORE IT, DKIND 0 AN OBJECT, 1 A FUNCTION (DPS AND DPE THE TOKENS AFTER
  AND OF THE PARENTHESES OF ITS PARAMETERS), 2 AN ARRAY (DARRN ITS NUMBER OF ELEMENTS: -1 NONE GIVEN, -2 NOT A NUMBER), DGRP NE 0 FOR A NAME IN PARENTHESES AFTER A STAR (A POINTER TO A FUNCTION OR AN ARRAY, OR A FUNCTION THAT RETURNS ONE),
  DBIT NE 0 FOR A BIT FIELD, DEND THE COMMA THAT ENDS IT OR E, DOK=0 IF THE TOKENS ARE NOT A DECLARATOR #
SUBR DECLR(P,E,CTX) IS (
 I,J,GC,K,V,D ARE LOCAL;
 DNAME:=0; DKIND:=0; DSTARS:=0; DGRP:=0; DPS:=0; DPE:=0; DARRN:=1; DBIT:=0; DOK:=1;
 I:=P;
 WHILE ((I<E) AND (TCH(I)=42)) DO (DSTARS:=DSTARS+1; I:=I+1);
 ((I<E) AND (TCH(I)=40) AND (TCH(I+1)=42)) => (
    GC:=MATCH(I); J:=I+1;
    WHILE TCH(J)=42 DO J:=J+1;
    TID(J) NE 0 => (DNAME:=TOK(J); J:=J+1);
    DGRP:=1;
    TCH(J)=40 => (DKIND:=1; DPS:=J+1; DPE:=MATCH(J));
    I:=GC+1;
    WHILE ((I<E) AND ((TCH(I)=40) OR (TCH(I)=91))) DO I:=MATCH(I)+1;
    GO TO DEN);
 ((I<E) AND (TID(I) NE 0)) => (DNAME:=TOK(I); I:=I+1);
 DSL: I<E => (
    TCH(I)=40 => (
       DKIND=0 => (DKIND:=1; DPS:=I+1; DPE:=MATCH(I));
       I:=MATCH(I)+1; GO TO DSL);
    TCH(I)=91 => (
       K:=MATCH(I);
       K=(I+1) => V:=0-1 ELSE (EVAL(I+1,K); EV_OK NE 0 => (EV_VAL<0 => V:=0-2 ELSE V:=EV_VAL) ELSE V:=0-2);
       V=0 => V:=0-1;
       V<0 => (DARRN>0 => DARRN:=V ELSE (DARRN=(0-1) => 0 ELSE DARRN:=V))
        ELSE (DARRN>0 => DARRN:=DARRN*V);
       DKIND=0 => DKIND:=2;
       I:=K+1; GO TO DSL);
    GO TO DEN);
 DEN: I<E => (
    TCH(I)=58 => DBIT:=1;
    ((TCH(I) NE 44) AND (TCH(I) NE 61) AND (TCH(I) NE 58)) => DOK:=0);
 J:=I;
 DEL: ((J<E) AND (TCH(J) NE 44)) => (
    D:=TCH(J);
    ((D=40) OR (D=91) OR (D=123)) => J:=MATCH(J)+1 ELSE J:=J+1;
    GO TO DEL);
 J>E => J:=E;
 DEND:=J; 1);

# THE TYPE OF THE OBJECT OF THE LAST DECLARATOR WHEN THE SPECIFIERS ARE OF TYPE TY: A POINTER IF IT HAS STARS OR IS A POINTER TO A FUNCTION #
SUBR OBJTYPE(TY) IS (
 ((DSTARS>0) OR (DGRP NE 0)) => RETURN T_PTR;
 TY);

# THE PARAMETERS OF A FUNCTION, THE TOKENS PS TO PE (EXCLUSIVE): THE LIST OF THEIR TYPES IN PB, PWHY=0 OR WHY THEY CANNOT BE EXPRESSED #
SUBR PARAMS(PS,PE) IS (
 A,B,TY,P,T,D,NP,VOIDONLY,PEE ARE LOCAL;
 PB:=B_NEW(0); PWHY:=0; NP:=0; VOIDONLY:=0; PEE:=PE;
 PS GE PEE => (B_STR(PB,LOC('...')); RETURN 1);
 A:=PS;
 PLP: A<PEE => (
    B:=A;
    PLS: ((B<PEE) AND (TCH(B) NE 44)) => (
       D:=TCH(B);
       ((D=40) OR (D=91) OR (D=123)) => B:=MATCH(B)+1 ELSE B:=B+1;
       GO TO PLS);
    B>PEE => B:=PEE;
    TIS(A,LOC('...')) => (
       NP>0 => B_STR(PB,LOC(', '));
       B_STR(PB,LOC('...')); A:=B+1; GO TO PLP);
    SPEC(A,B); TY:=SP_TYPE; P:=SP_END;
    TY=0 => (PWHY:=LOC('a parameter without a type'); RETURN 0);
    P GE B => (DSTARS:=0; DKIND:=0; DGRP:=0)
     ELSE (DECLR(P,B,1); DOK=0 => (PWHY:=LOC('a parameter that is not understood'); RETURN 0));
    ((DSTARS>0) OR (DKIND NE 0) OR (DGRP NE 0)) => T:=T_PTR ELSE T:=TY;
    T GE T_BBASE => (PWHY:=BADOF(T); RETURN 0);
    ((T GE T_SBASE) AND (T<T_BBASE)) => (PWHY:=LOC('a structure passed by value'); RETURN 0);
    T=T_VOID => (
       VOIDONLY:=1;
       ((NP=0) AND (B=PEE)) => (B_STR(PB,LOC('VOID')); NP:=NP+1; A:=B+1; GO TO PLP);
       PWHY:=LOC('a parameter of type void'); RETURN 0);
    NP>0 => B_STR(PB,LOC(', '));
    B_STR(PB,L_GET(TYN,T)); NP:=NP+1;
    A:=B+1; GO TO PLP);
 NP>16 => (PWHY:=LOC('more than 16 parameters'); RETURN 0);
 1);

# THE FUNCTION DNAME WITH THE SPECIFIERS' TYPE TY: ITS DECLARATION INTO THE TABLE OF FUNCTIONS, OR WHY IT CANNOT BE EXPRESSED #
SUBR ADDFUNC(TY) IS (
 R,B,W,NM,FS,FE ARE LOCAL;
 L_FIND(FNN,DNAME) GE 0 => RETURN 0;
 W:=0; B:=0; NM:=DNAME; FS:=DPS; FE:=DPE;
 R:=OBJTYPE(TY);
 S_EQ(NM,LOC('_')) => W:=S_DUP(LOC('a name that IMP72 reads as an operator'))
  ELSE (R GE T_BBASE => W:=BADOF(R)
  ELSE (((R GE T_SBASE) AND (R<T_BBASE)) => W:=S_DUP(LOC('a structure result')) ELSE (
    PARAMS(FS,FE)=0 => W:=PWHY
     ELSE (
       B:=B_NEW(0); B_STR(B,LOC('EXTERNAL ')); B_STR(B,L_GET(TYN,R)); B_CH(B,32); B_STR(B,QN(NM)); B_CH(B,40);
       B_STR(B,B_GET(PB)); B_STR(B,LOC(');')); B:=B_GET(B)))));
 L_ADD(FNN,S_DUP(NM)); L_ADD(FNT,B); L_ADD(FNW,W); 0);

# THE TYPEDEF DNAME OF THE SPECIFIERS' TYPE TY #
SUBR BINDTYPEDEF(TY) IS (
 T,X ARE LOCAL;
 ((DKIND=1) AND (DGRP=0)) => T:=BADREASON(LOC('a function type'))
  ELSE (((DKIND=2) AND (DGRP=0) AND (DSTARS=0)) => T:=BADREASON(LOC('an array type'))
  ELSE T:=OBJTYPE(TY));
 S_EQ(DNAME,LOC('size_t')) => (T=T_ULONG => T:=T_SIZE);
 ((T GE T_SBASE) AND (T<T_BBASE)) => (
    X:=T-T_SBASE;
    L_GET(STNAME,X)=0 => L_SET(STNAME,X,S_DUP(DNAME))
     ELSE (S_EQ(L_GET(STNAME,X),DNAME)=0 => (L_ADD(ALN,S_DUP(DNAME)); L_ADD(ALI,X))));
 L_ADD(TDN,S_DUP(DNAME)); L_ADD(TDT,T); 0);

# THE DECLARATION AT THE TOKENS S TO E (EXCLUSIVE) #
SUBR DECL(S,E) IS (
 TY,TD,P,NX ARE LOCAL;
 S GE E => RETURN 0;
 PACKFLAG:=0;
 P:=S;
 DPK: P<E => (TIS(P,LOC('@')) => PACKFLAG:=1; P:=P+1; GO TO DPK);
 SPEC(S,E); TY:=SP_TYPE; TD:=SP_TD; P:=SP_END;
 RUN_PEND(0);
 PACKFLAG:=0;
 P GE E => RETURN 0;
 TY=0 => RETURN 0;
 DL: DECLR(P,E,0);
 DOK=0 => RETURN 0;
 NX:=DEND;
 DNAME NE 0 => (
    TD NE 0 => BINDTYPEDEF(TY)
     ELSE (DKIND=1 => ADDFUNC(TY)));
 RUN_PEND(0);
 P:=NX;
 TCH(P)=44 => (P:=P+1; GO TO DL);
 0);

# ALL THE DECLARATIONS OF THE TOKENS #
SUBR PARSE_ALL(Z) IS (
 P,J,C,E,NX ARE LOCAL;
 P:=0;
 PL: P<NT => (
    J:=P;
    SC: J<NT => (
       C:=TCH(J);
       C=59 => (E:=J; NX:=J+1; GO TO GOT);
       C=123 => (
          TCH(J-1)=41 => (E:=0-1; NX:=MATCH(J)+1; GO TO GOT);
          J:=MATCH(J)+1; GO TO SC);
       ((C=40) OR (C=91)) => (J:=MATCH(J)+1; GO TO SC);
       C=125 => (E:=0-1; NX:=J+1; GO TO GOT);
       J:=J+1; GO TO SC);
    E:=NT; NX:=NT;
    GOT: E GE 0 => DECL(P,E);
    P:=NX; GO TO PL);
 0)
%%
