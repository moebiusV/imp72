#TOKEN-DIFF-MYERS.IMP -- THE THIRD FILE OF TOOLS/TOKEN-DIFF.IMP: THE SHORTEST EDIT SCRIPT BETWEEN TWO SEQUENCES OF INTEGERS (MYERS, AN O(ND) DIFFERENCE ALGORITHM).
MYERS(HA,NA,HB,NB,OPS) APPENDS TO THE LIST OPS ONE WORD FOR EACH STEP, IN ORDER: 0 THE NEXT ITEM OF BOTH, 1 THE NEXT ITEM OF A IS DELETED, 2 THE NEXT ITEM OF B IS INSERTED.  HA AND HB ARE ADDRESSES OF WORDS.  THE ITEMS THE SEQUENCES
HAVE AT BOTH ENDS ARE TAKEN OFF FIRST.  THE ALGORITHM KEEPS A COPY OF ITS FRONTIER FOR EACH STEP OF THE EDIT DISTANCE D, THAT IS D*D WORDS, SO IT GOES NO FURTHER THAN DLIM STEPS AT A TIME.  WHEN THE SEQUENCES ARE TOO DIFFERENT FOR THAT IT DOES WHAT GNU
DIFF DOES: THE POINT THE PATH HAS REACHED FURTHEST (THE MOST ITEMS OF A AND B PASSED) IS TAKEN AS A PLACE THE SCRIPT GOES THROUGH, THE SCRIPT TO IT IS EXACT, AND THE REST IS COMPARED FROM THERE; THE RESULT IS A SCRIPT THAT IS NOT QUITE THE SHORTEST,
AND DCOARSE COUNTS THE CUTS.#

EXTERNAL PTR calloc(SIZE, SIZE);
EXTERNAL VOID free(PTR);
DLIM,DCOARSE,CONA,CONB ARE COMMON;

# ONE RUN TO THE END, OR TO A CUT AFTER DLIM STEPS: 1 IF IT REACHED THE END; ELSE 0, AND CONA ITEMS OF A AND CONB OF B ARE DONE.  THE FRONTIER OF STEP D IS V OF THE STEP BEFORE, SAVED AT TRA[D] AS THE DIAGONALS K=-D-1 TO D+1 (INDEX K+D+1) #
SUBR MYSTEP(HA,NA,HB,NB,OPS) IS (
 MAXD,OFF,V,TRA,D,K,X,Y,F,FOUND,LIM,S,I,DD,PK,PX,PY,V0,REV,Q,SZ,BS,BX,BY,DONE ARE LOCAL;
 NA=0 => (I:=0; WHILE I<NB DO (L_ADD(OPS,2); I:=I+1); CONA:=0; CONB:=NB; RETURN 1);
 NB=0 => (I:=0; WHILE I<NA DO (L_ADD(OPS,1); I:=I+1); CONA:=NA; CONB:=0; RETURN 1);
 MAXD:=NA+NB; LIM:=MAXD; LIM>DLIM => LIM:=DLIM;
 OFF:=MAXD+2;
 V:=CCALL calloc((2*OFF)+2,8); TRA:=CCALL calloc(LIM+2,8);
 WR(V,OFF+1,0);
 D:=0; FOUND:=0;
 WHILE FOUND=0 DO (
    D>LIM => FOUND:=-1
    ELSE (
       SZ:=(2*D)+3;
       S:=CCALL calloc(SZ,8);
       I:=0; WHILE I<SZ DO (WR(S,I,RD(V,OFF+((I-D)-1))); I:=I+1);
       WR(TRA,D,S);
       K:=0-D;
       WHILE K LE D DO (
          FOUND NE 0 => K:=D+2
          ELSE (
             K=(0-D) => X:=RD(V,OFF+(K+1))
             ELSE (K=D => X:=RD(V,OFF+(K-1))+1
             ELSE (RD(V,OFF+(K-1))<RD(V,OFF+(K+1)) => X:=RD(V,OFF+(K+1)) ELSE X:=RD(V,OFF+(K-1))+1));
             Y:=X-K; F:=1;
             WHILE F NE 0 DO (
                X<NA => (Y<NB => (RD(HA,X)=RD(HB,Y) => (X:=X+1; Y:=Y+1) ELSE F:=0) ELSE F:=0) ELSE F:=0);
             WR(V,OFF+K,X);
             X GE NA => (Y GE NB => FOUND:=1);
             K:=K+2));
       FOUND=0 => D:=D+1));
 FOUND<0 => (
    # TOO FAR: THE END OF THE PATH THAT HAS PASSED THE MOST ITEMS IS WHERE THE SCRIPT IS CUT; STEP LIM HAS BEEN DONE #
    D:=LIM; BS:=-1; BX:=0; BY:=0; K:=0-LIM;
    WHILE K LE LIM DO (
       X:=RD(V,OFF+K); Y:=X-K;
       X LE NA => (Y GE 0 => (Y LE NB => ((X+Y)>BS => (BS:=X+Y; BX:=X; BY:=Y))));
       K:=K+2);
    X:=BX; Y:=BY; DONE:=0; DCOARSE:=DCOARSE+1)
 ELSE (X:=NA; Y:=NB; DONE:=1);
 CONA:=X; CONB:=Y;
 REV:=L_NEW(0); DD:=D;
 WHILE DD GE 0 DO (
    V0:=RD(TRA,DD);
    K:=X-Y;
    K=(0-DD) => PK:=K+1
    ELSE (K=DD => PK:=K-1
    ELSE (RD(V0,(K-1)+(DD+1))<RD(V0,(K+1)+(DD+1)) => PK:=K+1 ELSE PK:=K-1));
    PX:=RD(V0,PK+(DD+1)); PY:=PX-PK;
    F:=1;
    WHILE F NE 0 DO (X>PX => (Y>PY => (L_ADD(REV,0); X:=X-1; Y:=Y-1) ELSE F:=0) ELSE F:=0);
    DD>0 => (X=PX => L_ADD(REV,2) ELSE L_ADD(REV,1));
    X:=PX; Y:=PY; DD:=DD-1);
 Q:=L_LEN(REV);
 I:=Q-1; WHILE I GE 0 DO (L_ADD(OPS,L_GET(REV,I)); I:=I-1);
 I:=0; WHILE I<D+1 DO (CCALL free(RD(TRA,I)); I:=I+1);
 CCALL free(TRA); CCALL free(V);
 DONE);

# A RUN OF STEPS TO THE END OF BOTH SEQUENCES, AS MANY CUTS AS IT TAKES #
SUBR MYCORE(HA,NA,HB,NB,OPS) IS (
 A,B,PA,PB,R ARE LOCAL;
 A:=HA; B:=HB; PA:=NA; PB:=NB;
 WHILE (PA+PB)>0 DO (
    R:=MYSTEP(A,PA,B,PB,OPS);
    R=0 => (A:=A+(8*CONA); PA:=PA-CONA; B:=B+(8*CONB); PB:=PB-CONB) ELSE (PA:=0; PB:=0));
 0);

SUBR MYERS(HA,NA,HB,NB,OPS) IS (
 PF,SF,F,I,NA2,NB2 ARE LOCAL;
 PF:=0; F:=1;
 WHILE F NE 0 DO (PF<NA => (PF<NB => (RD(HA,PF)=RD(HB,PF) => PF:=PF+1 ELSE F:=0) ELSE F:=0) ELSE F:=0);
 SF:=0; F:=1;
 WHILE F NE 0 DO (
    (SF+PF)<NA => ((SF+PF)<NB => (RD(HA,(NA-SF)-1)=RD(HB,(NB-SF)-1) => SF:=SF+1 ELSE F:=0) ELSE F:=0) ELSE F:=0);
 I:=0; WHILE I<PF DO (L_ADD(OPS,0); I:=I+1);
 NA2:=(NA-PF)-SF; NB2:=(NB-PF)-SF;
 MYCORE(HA+(8*PF),NA2,HB+(8*PF),NB2,OPS);
 I:=0; WHILE I<SF DO (L_ADD(OPS,0); I:=I+1);
 0)
%%
