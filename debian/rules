#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk

# The LLVM and lld libraries are found through the dynamic linker's paths,
# so the executables get no run path.
export LLVM_NO_RPATH = 1

# The Makefile takes its flags on the command line.
MAKE_FLAGS = CFLAGS="$(CFLAGS) $(CPPFLAGS)" LDFLAGS="$(LDFLAGS)"

%:
	dh $@

override_dh_auto_clean:
	$(MAKE) distclean

override_dh_auto_build:
	$(MAKE) $(MAKE_FLAGS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) $(MAKE_FLAGS) check
endif

override_dh_auto_install:
	$(MAKE) $(MAKE_FLAGS) install DESTDIR=$(CURDIR)/debian/imp72 PREFIX=/usr
