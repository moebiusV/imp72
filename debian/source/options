# Build products, scratch directories and the binaries of the original
# compiler stay out of the source package.
tar-ignore = "build"
tar-ignore = "tmp"
tar-ignore = "work"
tar-ignore = "*.o"
tar-ignore = "*.a"
tar-ignore = "imp.low"
tar-ignore = "imp.shr"
tar-ignore = "implib.lib"
tar-ignore = "imps0"
tar-ignore = ".git"
tar-ignore = ".gitmodules"
tar-ignore = "*~"
tar-ignore = ".*.swp"
